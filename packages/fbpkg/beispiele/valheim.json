{
  "format": "FBPKG_v1",
  "identity": {
    "slug": "valheim",
    "name": "Valheim",
    "version": "1.0.8",
    "author": "firenetworks",
    "category": "survival",
    "description": {
      "de": "Überleben und Erkunden in einem prozedural erzeugten Fegefeuer nach Wikinger-Art, für 1–10 Spieler.",
      "en": "A brutal exploration and survival game for 1-10 players, set in a procedurally-generated purgatory inspired by viking culture."
    },
    "origin": {
      "type": "egg-import",
      "source": "https://raw.githubusercontent.com/pelican-eggs/games-steamcmd/main/valheim/egg-valheim.json",
      "imported_at": "2026-08-15"
    }
  },
  "image": {
    "ref": "registry.firenetworks.de/fb/steamcmd",
    "tag": "2026.09",
    "digest": "sha256:c6d2fda4f695062d4cf9535358a1fce0bc2e87d51b568c00684f46cd02130364",
    "pinned_at": "2026-09-06",
    "platform": "linux",
    "arch": [
      "amd64"
    ]
  },
  "ports": [
    {
      "purpose": "game",
      "protocol": "udp",
      "assign": "pool",
      "required": true,
      "variable": "SERVER_PORT",
      "description": {
        "de": "Spielport",
        "en": "Game port"
      }
    },
    {
      "purpose": "query",
      "protocol": "udp",
      "assign": "game+1",
      "required": true,
      "description": {
        "de": "Abfrageport — bei Valheim zwingend Spielport+1, keine freie Wahl.",
        "en": "Query port — Valheim requires game port + 1, not a free choice."
      }
    }
  ],
  "install": {
    "steps": [
      {
        "type": "steamcmd",
        "app": 896660,
        "login": false,
        "validate": true,
        "branch": "{{SRCDS_BETAID}}",
        "description": {
          "de": "Serverdateien über SteamCMD laden (anonym)."
        }
      }
    ],
    "cache": {
      "steam_depot": true
    }
  },
  "start": {
    "program": "./valheim_server.x86_64",
    "workdir": ".",
    "args": [
      {
        "key": "nographics",
        "form": "-nographics",
        "from": "fixed"
      },
      {
        "key": "batchmode",
        "form": "-batchmode",
        "from": "fixed"
      },
      {
        "key": "name",
        "form": [
          "-name",
          "{{value}}"
        ],
        "from": "setting:name"
      },
      {
        "key": "port",
        "form": [
          "-port",
          "{{value}}"
        ],
        "from": "port:game"
      },
      {
        "key": "world",
        "form": [
          "-world",
          "{{value}}"
        ],
        "from": "setting:world_name"
      },
      {
        "key": "password",
        "form": [
          "-password",
          "{{value}}"
        ],
        "from": "setting:password",
        "when": "not_empty"
      },
      {
        "key": "public",
        "form": [
          "-public",
          "{{value}}"
        ],
        "from": "setting:public_listing"
      },
      {
        "key": "saveinterval",
        "form": [
          "-saveinterval",
          "{{value}}"
        ],
        "from": "setting:autosave_seconds"
      },
      {
        "key": "backups",
        "form": [
          "-backups",
          "{{value}}"
        ],
        "from": "setting:backup_count"
      },
      {
        "key": "backupshort",
        "form": [
          "-backupshort",
          "{{value}}"
        ],
        "from": "setting:backup_short_seconds"
      },
      {
        "key": "backuplong",
        "form": [
          "-backuplong",
          "{{value}}"
        ],
        "from": "setting:backup_long_seconds"
      },
      {
        "key": "crossplay",
        "form": "-crossplay",
        "from": "setting:crossplay",
        "when": "true"
      },
      {
        "key": "preset",
        "form": [
          "-preset",
          "{{value}}"
        ],
        "from": "setting:world_preset",
        "when": "not_empty"
      },
      {
        "key": "mod_combat",
        "form": [
          "-modifier",
          "combat",
          "{{value}}"
        ],
        "from": "setting:mod_combat",
        "when": "not_empty"
      },
      {
        "key": "mod_deathpenalty",
        "form": [
          "-modifier",
          "deathpenalty",
          "{{value}}"
        ],
        "from": "setting:mod_deathpenalty",
        "when": "not_empty"
      },
      {
        "key": "mod_resources",
        "form": [
          "-modifier",
          "resources",
          "{{value}}"
        ],
        "from": "setting:mod_resources",
        "when": "not_empty"
      },
      {
        "key": "mod_raids",
        "form": [
          "-modifier",
          "raids",
          "{{value}}"
        ],
        "from": "setting:mod_raids",
        "when": "not_empty"
      },
      {
        "key": "mod_portals",
        "form": [
          "-modifier",
          "portals",
          "{{value}}"
        ],
        "from": "setting:mod_portals",
        "when": "not_empty"
      }
    ],
    "extra_args": {
      "min_role": "expert",
      "log": true
    },
    "ready_when": {
      "port": "query",
      "log_line": "ready",
      "query": true,
      "timeout_sec": 900
    },
    "stop": {
      "sequence": [
        {
          "step": "sigint",
          "timeout_sec": 60,
          "terminates": true
        },
        {
          "step": "sigterm",
          "timeout_sec": 30,
          "terminates": true
        },
        {
          "step": "sigkill",
          "timeout_sec": 10,
          "terminates": true
        }
      ]
    }
  },
  "env": {
    "LD_LIBRARY_PATH": "./linux64"
  },
  "settings": [
    {
      "key": "name",
      "group": "identity",
      "name": {
        "de": "Servername",
        "en": "Server name"
      },
      "description": {
        "de": "So heißt der Server in der Serverliste.",
        "en": "How the server appears in the server browser."
      },
      "type": "text",
      "default": "My Server",
      "apply": [
        {
          "target": "arg"
        }
      ],
      "takes_effect": "restart",
      "risk": "none",
      "role": "player"
    },
    {
      "key": "password",
      "group": "access",
      "name": {
        "de": "Beitrittskennwort",
        "en": "Join password"
      },
      "description": {
        "de": "Ohne dieses Kennwort kommt niemand auf den Server. Mindestens fuenf Zeichen, und es darf nicht im Servernamen vorkommen. Fuer einen OEFFENTLICH sichtbaren Server verlangt Valheim eines — gemessen am 2026-08-23 und vom Betreiber in der Spieldokumentation bestaetigt: ohne Kennwort meldet der Server „Error bad password: The password is too short“ und startet nicht. Ein versteckter Server darf ohne auskommen.",
        "en": "Nobody joins without this password. At least five characters, and it must not appear in the server name. Valheim refuses to start WITHOUT one — measured 2026-08-23: \"Error bad password: The password is too short\", world generation then aborts."
      },
      "type": "password",
      "default": "secret",
      "apply": [
        {
          "target": "arg"
        }
      ],
      "takes_effect": "restart",
      "risk": "none",
      "role": "player",
      "min_length": 5,
      "required_when": "public_listing=1"
    },
    {
      "key": "world_name",
      "group": "world",
      "name": {
        "de": "Weltname",
        "en": "World name"
      },
      "description": {
        "de": "Welche Welt geladen wird. Ein neuer Name erzeugt eine NEUE, leere Welt — die alte bleibt erhalten und ist über ihren Namen wieder erreichbar.",
        "en": "Which world to load. A new name creates a NEW, empty world — the old one is kept and can be reached again by its name."
      },
      "type": "text",
      "default": "Dedicated",
      "apply": [
        {
          "target": "arg"
        }
      ],
      "takes_effect": "new_world",
      "risk": "progress",
      "role": "player"
    },
    {
