<%
/**
 * Mitmachen (P9) — was Zuschauer aus dem Chat heraus auslösen können.
 *
 * **Alle vier Punkte sind gebaut, und die Seite sagt das selbst.** Clip und
 * Umfrage gehören Twitch: Wir lösen aus und lesen den Stand, gespeichert wird
 * nichts. Die **Verlosung** gehört einem anderen Plugin — angelegt wird sie
 * dort, hier steht nur, was davon im Chat ankommt; ein zweiter Ort zum
 * Einstellen wäre eine zweite Wahrheit.
 *
 * Der **Musikwunsch** kam am 2026-09-07 dazu und ist der Grund, warum diese
 * Zeile umgeschrieben wurde: Er hat einen **eigenen Menüpunkt**, weil er mehr
 * ist als eine Karte (OBS-Adresse, Warteschlange, Endlosmodus, Zustand der
 * Browserquelle). Seine Karte bleibt hier und verweist dorthin — die Reihe
 * "was der Chat auslösen kann" wäre sonst unvollständig, und wer nur die
 * Sidebar liest, fände ihn nicht als Mitmach-Weg wieder.
 *
 * Was jeder Punkt kostet und warum, steht bei ihm auf der Seite und nicht in
 * einer Fußnote.
 *
 * Erwartet: bericht, ZUSTAND, STAND, vorWieLange, meldung, fehler
 */
const darfAendern = typeof hasPermission === 'function' && hasPermission('STREAMING.CHAT.MANAGE');

const WER = {
  alle: tr('streaming:COMMON.WER_ALLE'), abonnent: tr('streaming:COMMON.WER_ABONNENT'),
  moderator: tr('streaming:COMMON.WER_MODERATOR'), inhaber: tr('streaming:COMMON.WER_INHABER')
};

const fehlerTexte = {
  frage:      tr('streaming:MITMACHEN.F_FRAGE'),
  antworten:  tr('streaming:MITMACHEN.F_ANTWORTEN'),
  kein_kanal: tr('streaming:MITMACHEN.F_KEIN_KANAL'),
  technisch:  tr('streaming:MITMACHEN.F_TECHNISCH')
};
const meldungen = {
  gestartet: tr('streaming:MITMACHEN.OK_GESTARTET'),
  beendet:   tr('streaming:MITMACHEN.OK_BEENDET'),
  verborgen: tr('streaming:MITMACHEN.OK_VERBORGEN')
};

/**
 * Was eine Karte sagt, wenn ihr Inhalt nicht kommen konnte.
 *
 * @param {string} zustand Einer aus ZUSTAND
 * @returns {string|null} Hinweis, oder null wenn alles ging
 */
const hinweis = (zustand) => ({
  [ZUSTAND.ABGELEHNT]:  tr('streaming:MITMACHEN.Z_ABGELEHNT'),
  [ZUSTAND.FEHLER]:     tr('streaming:MITMACHEN.Z_FEHLER'),
  [ZUSTAND.KEIN_KANAL]: tr('streaming:MITMACHEN.Z_KEIN_KANAL')
}[zustand] || null);

/**
 * Die Zeile über einen der beiden Befehle.
 *
 * @param {Object|null} zeile Aus `streaming_commands`, oder null
 * @returns {string} Satz
 */
const befehlSatz = (zeile) => {
  if (!zeile) return tr('streaming:MITMACHEN.NICHT_EINGERICHTET');
  if (!zeile.aktiv) return tr('streaming:MITMACHEN.ABGESCHALTET');
  // **Keine Abkühlung ist eine Aussage, keine Null.** `!los` steht bewusst auf
  // 0, weil die Abkühlung je Befehl gilt und nicht je Zuschauer — „Abkühlung
  // 0 s“ läse sich wie ein vergessenes Feld.
  const wer = WER[zeile.wer] || zeile.wer;
  return Number(zeile.abkuehlung_s) > 0
    ? tr('streaming:MITMACHEN.AN_MIT', { wer, s: zeile.abkuehlung_s })
    : tr('streaming:MITMACHEN.AN_OHNE', { wer });
};

const anteil = (a, gesamt) => (gesamt > 0 ? Math.round((a.stimmen / gesamt) * 100) : 0);
const verbindungen = `/guild/${guildId}/profile/verbindungen`;
const befehlsseite = `/guild/${guildId}/plugins/streaming/befehle`;
%>

<%- include('partials/streaming-kopf', {
  guildId, tr,
  icon: 'fa-solid fa-hand-sparkles',
  titel: tr('streaming:MITMACHEN.TITLE'),
  beschreibung: tr('streaming:MITMACHEN.SUBTITLE')
}) %>

<% if (meldung && meldungen[meldung]) { %>
  <div class="alert alert-success"><%= meldungen[meldung] %></div>
<% } %>
<% if (fehler) { %>
  <div class="alert alert-danger"><%= fehlerTexte[fehler] || fehler %></div>
<% } %>

<div class="row row-cards">

  <%# ── Clip ──────────────────────────────────────────────────────────────── %>
  <div class="col-12 col-lg-6">
    <div class="card h-100">
      <div class="card-header">
        <div class="kartenkopf">
          <span class="kartensymbol"><i class="fa-solid fa-scissors"></i></span>
          <div class="kartenkopf__text">
            <h3 class="kartenkopf__titel">Clip</h3>
            <div class="kartenkopf__satz">
              <%- tr('streaming:MITMACHEN.CLIP_TEXT') %>
            </div>
          </div>
        </div>
      </div>
      <div class="card-body">
        <div class="zeilen">
          <div class="zeile">
            <div class="zeile__bez"><%= tr('streaming:MITMACHEN.ERLAUBNIS') %></div>
            <div>
              <% if (bericht.zusagen.clip.zustand === STAND.JA) { %>
                <span class="chip"><%= tr('streaming:MITMACHEN.ERTEILT') %></span>
              <% } else if (bericht.zusagen.clip.zustand === STAND.UNBEKANNT) { %>
                <span class="chip"><%= tr('streaming:MITMACHEN.NICHT_LESBAR') %></span>
                <div class="zeile__hilfe"><%= bericht.zusagen.clip.grund %></div>
              <% } else { %>
                <a href="<%= verbindungen %>" class="btn btn-warning btn-sm">
                  <i class="fa-solid fa-key me-1"></i> <%= tr('streaming:MITMACHEN.CLIPS_ERLAUBEN') %>
                </a>
              <% } %>
            </div>
          </div>
          <div class="zeile">
            <div class="zeile__bez"><%= tr('streaming:MITMACHEN.BEFEHL') %></div>
            <div>
              <%= befehlSatz(bericht.befehle.clip) %>
              <div class="zeile__hilfe">
                <%= tr('streaming:MITMACHEN.EINGERICHTET_AUF') %> <a href="<%= befehlsseite %>"><%= tr('streaming:NAV.COMMANDS') %></a><%= tr('streaming:MITMACHEN.EINGERICHTET_NACH') %>
              </div>
            </div>
          </div>
        </div>

        <div class="text-secondary small mt-2">
          <i class="fa-solid fa-circle-info me-1"></i>
          <%- tr('streaming:MITMACHEN.CLIP_HINWEIS') %>
        </div>
      </div>
    </div>
  </div>

  <%# ── Umfrage: Zustand und laufende ─────────────────────────────────────── %>
  <div class="col-12 col-lg-6">
    <div class="card h-100">
      <div class="card-header">
        <div class="kartenkopf">
          <span class="kartensymbol"><i class="fa-solid fa-square-poll-vertical"></i></span>
          <div class="kartenkopf__text">
            <h3 class="kartenkopf__titel"><%= tr('streaming:MITMACHEN.UMFRAGE') %></h3>
            <div class="kartenkopf__satz">
              <%- tr('streaming:MITMACHEN.UMFRAGE_TEXT') %>
            </div>
          </div>
        </div>
      </div>
      <div class="card-body">
        <div class="zeilen">
          <div class="zeile">
            <div class="zeile__bez"><%= tr('streaming:MITMACHEN.ERLAUBNIS') %></div>
            <div>
              <% if (bericht.zusagen.umfragen.zustand === STAND.JA) { %>
                <span class="chip"><%= tr('streaming:MITMACHEN.ERTEILT') %></span>
              <% } else if (bericht.zusagen.umfragen.zustand === STAND.UNBEKANNT) { %>
                <span class="chip"><%= tr('streaming:MITMACHEN.NICHT_LESBAR') %></span>
                <div class="zeile__hilfe"><%= bericht.zusagen.umfragen.grund %></div>
              <% } else { %>
                <a href="<%= verbindungen %>" class="btn btn-warning btn-sm">
                  <i class="fa-solid fa-key me-1"></i> <%= tr('streaming:MITMACHEN.UMFRAGEN_ERLAUBEN') %>
                </a>
              <% } %>
            </div>
          </div>
          <div class="zeile">
            <div class="zeile__bez"><%= tr('streaming:MITMACHEN.BEFEHL') %></div>
            <div><%= befehlSatz(bericht.befehle.umfrage) %></div>
          </div>
        </div>

        <%# **Die Voraussetzung, die nicht bei uns liegt — und wir sehen nach,
            statt sie dir zu merken zu geben.** Hier stand bis zum 2026-09-06 ein
            allgemeiner Merksatz, den jeder erst auf sich selbst anwenden musste.
            `broadcaster_type` ist öffentlich; jetzt steht da eine Aussage über
            DEINEN Kanal, und sobald du Affiliate wirst, verschwindet sie. %>
        <div class="zeilen">
          <div class="zeile">
            <div class="zeile__bez"><%= tr('streaming:MITMACHEN.KANAL_TWITCH') %></div>
            <div>
              <% if (bericht.kanalArt === 'partner') { %>
                <span class="chip">Partner</span>
              <% } else if (bericht.kanalArt === 'affiliate') { %>
                <span class="chip">Affiliate</span>
              <% } else if (bericht.kanalArt === 'normal') { %>
                <span class="chip"><%= tr('streaming:MITMACHEN.GEWOEHNLICH') %></span>
              <% } else { %>
                <span class="chip"><%= tr('streaming:MITMACHEN.NICHT_FESTSTELLBAR') %></span>
              <% } %>
            </div>
          </div>
        </div>

        <div class="text-secondary small mt-2">
          <% if (bericht.kanalArt === 'normal') { %>
            <i class="fa-solid fa-triangle-exclamation me-1"></i>
            <%- tr('streaming:MITMACHEN.AB_AFFILIATE') %>
          <% } else if (bericht.kanalArt) { %>
            <i class="fa-solid fa-circle-check me-1"></i>
            <%= tr('streaming:MITMACHEN.FREIGESCHALTET') %>
          <% } else { %>
            <i class="fa-solid fa-circle-info me-1"></i>
            <%- tr('streaming:MITMACHEN.NICHT_NACHGESEHEN') %>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <%# ── Die laufende Umfrage ──────────────────────────────────────────────── %>
  <% if (hinweis(bericht.umfragen.zustand)) { %>
    <div class="col-12">
      <div class="card"><div class="card-body">
        <div class="alert alert-warning mb-0"><%= hinweis(bericht.umfragen.zustand) %></div>
      </div></div>
    </div>
  <% } else { %>

    <% if (bericht.umfragen.laufend) { const u = bericht.umfragen.laufend; %>
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <div class="kartenkopf">
              <span class="kartensymbol"><i class="fa-solid fa-play"></i></span>
              <div class="kartenkopf__text">
                <h3 class="kartenkopf__titel"><%= tr('streaming:MITMACHEN.LAEUFT', { frage: u.frage }) %></h3>
                <div class="kartenkopf__satz">
                  <%= tr('streaming:MITMACHEN.STIMMEN', { n: u.gesamt }) %><% if (u.punkteAbstimmung) { %> ·
                  <%= tr('streaming:MITMACHEN.PUNKTE', { n: u.punkteProStimme }) %><% } %>
                </div>
              </div>
            </div>
          </div>
          <div class="card-body">
            <div class="zeilen">
              <% u.antworten.forEach(a => { %>
                <div class="zeile">
                  <div class="zeile__bez"><%= a.titel %></div>
                  <div>
                    <span class="chip mono"><%= a.stimmen %></span>
                    <small><%= anteil(a, u.gesamt) %>&nbsp;%</small>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
          <% if (darfAendern) { %>
            <div class="card-footer d-flex gap-2 justify-content-end">
              <form method="POST" action="/guild/<%= guildId %>/plugins/streaming/mitmachen/umfrage/beenden">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <input type="hidden" name="umfrage_id" value="<%= u.id %>">
                <%# **Zwei Knöpfe, weil Twitch zwei Arten kennt.** Beenden zeigt
                    das Ergebnis, Abbrechen nimmt es aus der Oberfläche — wer
                    sich vertippt hat, will das Zweite. %>
                <button class="btn btn-outline-secondary" type="submit" name="verbergen" value="1">
                  <%= tr('streaming:COMMON.CANCEL') %>
                </button>
                <button class="btn btn-primary ms-2" type="submit" name="verbergen" value="0">
                  <%= tr('streaming:MITMACHEN.BEENDEN_ZEIGEN') %>
                </button>
              </form>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>

    <%# ── Eine neue Umfrage ─────────────────────────────────────────────── %>
    <%# **Kein Formular, das sicher abgewiesen würde.** Ein gewöhnlicher Kanal
        bekäme auf „Umfrage starten" nur Twitchs Absage — und ein Formular, das
        nicht speichern kann, ist eine Attrappe. Bei `null` (nicht feststellbar)
        steht es dagegen da: Dann ist die Absage eine Vermutung, kein Wissen. %>
    <% if (darfAendern && !bericht.umfragen.laufend
           && bericht.zusagen.umfragen.zustand === STAND.JA
           && bericht.kanalArt !== 'normal') { %>
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <div class="kartenkopf">
              <span class="kartensymbol"><i class="fa-solid fa-plus"></i></span>
              <div class="kartenkopf__text">
                <h3 class="kartenkopf__titel"><%= tr('streaming:MITMACHEN.NEUE_UMFRAGE') %></h3>
                <div class="kartenkopf__satz"><%= tr('streaming:MITMACHEN.NEUE_UMFRAGE_TEXT') %></div>
              </div>
            </div>
          </div>
          <form method="POST" action="/guild/<%= guildId %>/plugins/streaming/mitmachen/umfrage">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <div class="card-body">
              <div class="mb-3">
                <label class="form-label"><%= tr('streaming:MITMACHEN.FRAGE') %></label>
                <%# 60 Zeichen ist Twitchs Grenze, nicht unsere Wahl. Ein Feld,
                    das mehr annimmt, ließe den Streamer zweimal tippen. %>
                <input type="text" class="form-control" name="frage" maxlength="60" required
                       placeholder="<%= tr('streaming:MITMACHEN.FRAGE_BEISPIEL') %>">
              </div>

              <label class="form-label"><%= tr('streaming:MITMACHEN.ANTWORTEN') %> <small><%= tr('streaming:MITMACHEN.ANTWORTEN_HILFE') %></small></label>
              <% [0,1,2,3,4].forEach(i => { %>
                <input type="text" class="form-control mb-2" name="antworten[]" maxlength="25"
                       placeholder="<%= tr(i < 2 ? 'streaming:MITMACHEN.ANTWORT_N' : 'streaming:MITMACHEN.ANTWORT_OPTIONAL', { n: i + 1 }) %>"
                       <%= i < 2 ? 'required' : '' %>>
              <% }); %>

              <div class="row g-2 mt-1">
                <div class="col-12 col-md-6">
                  <label class="form-label"><%= tr('streaming:MITMACHEN.DAUER') %></label>
                  <select class="form-select" name="dauer_s">
                    <option value="30">30 <%= tr('streaming:MITMACHEN.SEKUNDEN') %></option>
                    <option value="60" selected>1 <%= tr('streaming:MITMACHEN.MINUTE') %></option>
                    <option value="120">2 <%= tr('streaming:MITMACHEN.MINUTEN') %></option>
                    <option value="300">5 <%= tr('streaming:MITMACHEN.MINUTEN') %></option>
                    <option value="600">10 <%= tr('streaming:MITMACHEN.MINUTEN') %></option>
                    <option value="1800">30 <%= tr('streaming:MITMACHEN.MINUTEN') %></option>
                  </select>
                </div>
                <div class="col-12 col-md-6">
                  <label class="form-label"><%= tr('streaming:MITMACHEN.PUNKTE_FELD') %></label>
                  <input type="number" class="form-control" name="punkteProStimme"
                         min="0" max="1000000" value="0">
                  <div class="zeile__hilfe"><%= tr('streaming:MITMACHEN.PUNKTE_NULL') %></div>
                </div>
              </div>
            </div>
            <div class="card-footer text-end">
              <button type="submit" class="btn btn-primary"><%= tr('streaming:MITMACHEN.STARTEN') %></button>
            </div>
          </form>
        </div>
      </div>
    <% } %>

    <%# ── Die letzten ───────────────────────────────────────────────────── %>
    <% if (bericht.umfragen.frueher.length) { %>
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <div class="kartenkopf">
              <span class="kartensymbol"><i class="fa-solid fa-clock-rotate-left"></i></span>
              <div class="kartenkopf__text">
                <h3 class="kartenkopf__titel"><%= tr('streaming:CHATBOT.ZULETZT') %></h3>
                <div class="kartenkopf__satz">
                  <%= tr('streaming:MITMACHEN.ZULETZT_TEXT') %>
                </div>
              </div>
            </div>
          </div>
          <div class="card-body">
            <div class="zeilen">
              <% bericht.umfragen.frueher.forEach(u => { %>
                <div class="zeile">
                  <div class="zeile__bez">
                    <%= u.frage %>
                    <small><%= u.beendet_am ? vorWieLange(u.beendet_am) : '' %></small>
                  </div>
                  <div>
                    <% u.antworten.forEach(a => { %>
                      <span class="chip"><%= a.titel %>: <%= a.stimmen %></span>
                    <% }); %>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        </div>
      </div>
    <% } %>
  <% } %>

  <%# ── Verlosung ─────────────────────────────────────────────────────────
      Gebaut am 2026-09-07. Angelegt wird sie weiter im Verlosungs-Plugin;
      diese Karte zeigt nur, was daraus im Chat ankommt — ein zweiter Ort zum
      Einstellen wäre eine zweite Wahrheit. %>
  <div class="col-12 col-lg-6">
    <div class="card h-100">
      <div class="card-header">
        <div class="kartenkopf">
          <span class="kartensymbol"><i class="fa-solid fa-gift"></i></span>
          <div class="kartenkopf__text">
            <h3 class="kartenkopf__titel"><%= tr('streaming:MITMACHEN.VERLOSUNG') %></h3>
            <div class="kartenkopf__satz">
              <%- tr('streaming:MITMACHEN.VERLOSUNG_TEXT') %>
            </div>
          </div>
        </div>
      </div>
      <div class="card-body">
        <% if (!bericht.verlosung.moeglich) { %>
          <div class="zeilen">
            <div class="zeile">
              <div class="zeile__bez"><%= tr('streaming:MITMACHEN.VERLOSUNGEN') %></div>
              <div>
                <span class="chip"><%= tr('streaming:MITMACHEN.NICHT_EINGERICHTET_MARKE') %></span>
                <div class="zeile__hilfe">
                  <%- tr('streaming:MITMACHEN.PLUGIN_NOETIG') %>
                </div>
              </div>
            </div>
          </div>
          <div class="mt-2">
            <a href="/guild/<%= guildId %>/plugins" class="btn btn-outline-primary btn-sm">
              <i class="fa-solid fa-plug me-1"></i> <%= tr('streaming:COMMON.PLUGINS_OEFFNEN') %>
            </a>
          </div>
        <% } else { %>
          <div class="zeilen">
            <div class="zeile">
              <div class="zeile__bez"><%= tr('streaming:MITMACHEN.OFFEN') %></div>
              <div>
                <% if (bericht.verlosung.offen) { %>
                  <b><%= bericht.verlosung.offen.preis %></b>
                  <span class="chip ms-1"><%= tr(bericht.verlosung.lose === 1 ? 'streaming:MITMACHEN.LOS_EINS' : 'streaming:MITMACHEN.LOS_VIELE', { n: bericht.verlosung.lose }) %></span>
                  <% if ((bericht.verlosung.offen.bedingungen || []).length) { %>
                    <div class="zeile__hilfe">
                      <%= tr('streaming:MITMACHEN.MIT_BEDINGUNG') %>
                    </div>
                  <% } %>
                <% } else { %>
                  <span class="chip"><%= tr('streaming:MITMACHEN.KEINE') %></span>
                  <div class="zeile__hilfe">
                    <%- tr('streaming:MITMACHEN.KEINE_VERLOSUNG') %>
                  </div>
                <% } %>
              </div>
            </div>
            <div class="zeile">
              <div class="zeile__bez"><%= tr('streaming:MITMACHEN.BEFEHL') %></div>
              <div>
                <%= befehlSatz(bericht.befehle.los) %>
                <div class="zeile__hilfe">
                  <%= tr('streaming:MITMACHEN.EINGERICHTET_AUF') %> <a href="<%= befehlsseite %>"><%= tr('streaming:NAV.COMMANDS') %></a>.
                </div>
              </div>
            </div>
          </div>

          <div class="mt-2">
            <a href="/guild/<%= guildId %>/plugins/giveaway" class="btn btn-outline-primary btn-sm">
              <i class="fa-solid fa-gift me-1"></i> <%= tr('streaming:MITMACHEN.VERLOSUNGEN_OEFFNEN') %>
            </a>
          </div>
        <% } %>

        <div class="text-secondary small mt-2">
          <i class="fa-solid fa-circle-info me-1"></i>
          <%- tr('streaming:MITMACHEN.LOS_HINWEIS') %>
        </div>
      </div>
    </div>
  </div>

  <%# ── Musikwunsch: gebaut am 2026-09-07 ─────────────────────────────────
      **Umetikettiert, nicht gelöscht.** Die Karte stand hier als „letzter
      offener Punkt"; ihre Begründung war eine Frage, die niemand beantwortet
      hatte (privater Sprachkanal vs. Publikum). Sie ist beantwortet — die
      Grenze liegt an der Quelle.

      **Diese Vorgeschichte stand bis zum 2026-09-07 auf der Seite selbst.**
      Der Betreiber hat sie gestrichen: „das ist für zuschauer und nutzer
      uninteressant." Er hat recht — warum wir etwas früher nicht konnten, ist
      Projektgeschichte und gehört in die Commit-Nachricht, nicht vor jemanden,
      der gerade seinen Stream einrichtet. Was bleibt, ist die Regel, die für
      ihn gilt: nur eigene, freigegebene Dateien.

      Der Musikwunsch hat einen **eigenen Menüpunkt**, weil er mehr ist als
      eine Karte: OBS-Adresse, Warteschlange, Endlosmodus, Zustand der
      Browserquelle. Hier bleibt der Verweis, damit die Reihe „was der Chat
      auslösen kann" vollständig bleibt. %>
  <div class="col-12 col-lg-6">
    <div class="card h-100">
      <div class="card-header">
        <div class="kartenkopf">
          <span class="kartensymbol"><i class="fa-solid fa-music"></i></span>
          <div class="kartenkopf__text">
            <h3 class="kartenkopf__titel"><%= tr('streaming:MUSIK.TITLE') %></h3>
            <div class="kartenkopf__satz"><%= tr('streaming:MITMACHEN.MUSIK_TEXT') %></div>
          </div>
        </div>
      </div>
      <div class="card-body d-flex flex-column">
        <p class="text-secondary mb-2">
          <%- tr('streaming:MITMACHEN.MUSIK_1') %>
        </p>
        <p class="text-secondary mb-3">
          <%= tr('streaming:MITMACHEN.MUSIK_2') %>
        </p>
        <a class="btn btn-outline-primary mt-auto align-self-start"
           href="/guild/<%= guildId %>/plugins/streaming/musik">
          <i class="fa-solid fa-arrow-right me-1"></i><%= tr('streaming:MITMACHEN.ZUR_MUSIK') %>
