<%- include('partials/streaming-kopf', {
  guildId, tr,
  icon: 'fa-solid fa-comments',
  titel: 'Chatbot',
  beschreibung: 'Der Twitch-Chat der Kanäle, die diesen Server als Heim gewählt haben.'
}) %>

<%
  /*
   * **Diese Seite verspricht noch nichts, sie misst.** Sie zeigt, was
   * angeschlossen ist und ob die Leitung trägt - Befehle, Ansagen und Filter
   * kommen mit Stufe 15.
   *
   * Das ist Absicht und kein Versehen: Die Heim-Guild ist die Entscheidung,
   * WO das später bedient wird. Sie hat einen sichtbaren Ausgang (diesen
   * Menüpunkt gibt es hier und sonst nirgends), und mehr behauptet sie nicht.
   * Karten mit Schaltern für Fähigkeiten, die es nicht gibt, wären genau das
   * leere Versprechen, gegen das dieses Plugin geschrieben ist.
   *
   * Was hier an Zahlen steht, kommt aus dem letzten Abgleich und aus dem
   * Zähler der Leitung - nichts davon ist geschätzt.
   */
  const basis = `/guild/${guildId}/plugins/streaming`;
  const darf  = hasPermission('STREAMING.CHAT.MANAGE');

  const meldungen = {
    abgeglichen: 'Der Chat-Anschluss wurde abgeglichen.',
    gespeichert: 'Übernommen.',
    probe:       'Die Probe ist unterwegs. Steht sie nicht im Chat, sagt es die Karte gleich.'
  };
  const fehlerTexte = {
    kein_heim:   'Dieser Server ist für keinen Kanal das Heim.',
    abgebrochen: 'Es wurde nichts abgeglichen — der Grund steht in der Karte unten.',
    kanal:       'Zu diesem Kanal fehlte die Kennung — es wurde nichts geändert.',
    aus:         'Die Live-Ansage ist ausgeschaltet — es wurde nichts gesendet.',
    zu_lang:     'Der Text ist zu lang. Twitch nimmt höchstens 500 Zeichen.',
    platzhalter: 'Darin steht ein Platzhalter, den es nicht gibt. Er würde wörtlich im Chat stehen.',
    nur_discord: '{rolle} und {dauer} gibt es nur in der Discord-Ankündigung — im Twitch-Chat wären sie nur Zeichen.',
    technisch:   'Das hat technisch nicht geklappt. Der Grund steht im Protokoll.'
  };

  /**
   * Ein Abzeichen für einen dreiwertigen Zustand.
   */
  const abzeichen = (wert, gut, schlecht) =>
      wert === gut      ? `<span class="badge bg-green-lt">${wert}</span>`
    : wert === schlecht ? `<span class="badge bg-yellow-lt">${wert}</span>`
                        : `<span class="badge bg-secondary-lt">${wert}</span>`;
%>

<% if (meldung && meldungen[meldung]) { %>
  <div class="alert alert-success"><%= meldungen[meldung] %></div>
<% } %>
<% if (fehler && fehlerTexte[fehler]) { %>
  <div class="alert alert-warning"><%= fehlerTexte[fehler] %></div>
<% } %>

<% if (!kanaele || kanaele.length === 0) { %>
  <div class="card mb-3">
    <div class="card-body">
      <%- include('shared/leerzustand', {
            icon:  'fa-solid fa-comments',
            titel: 'Kein Kanal hat diesen Server als Heim gewählt',
            text:  'Der Chatbot eines Kanals wird an genau einem Discord verwaltet. '
                 + 'Diese Wahl trifft der Kanalinhaber selbst, im Profil unter „Verbundene Konten“.'
          }) %>
    </div>
  </div>
<% } else { %>

  <%- include('shared/funktionskarte', {
        titel:        'Warum hier',
        icon:         'fa-solid fa-circle-info',
        koerper:      '<p class="mb-0">Der Chatbot eines Twitch-Kanals wird an <strong>genau einem</strong> '
                    + 'Discord verwaltet — an dem, den der Kanalinhaber gewählt hat. '
                    + 'Andere Server können seinen Stream verfolgen und ankündigen, aber nicht '
                    + 'seinen Chat einstellen. So kann niemand an fremden Chat-Einstellungen drehen, '
                    + 'nur weil er hier Rechte hat.</p>'
  }) %>

  <% kanaele.forEach(k => { %>
    <%
      const a = k.anschluss;
      const modZustand = a ? a.zustand : 'unbekannt';

      /*
       * **Zwei Zeilen, und die zweite hängt an der ersten.** Der Mod-Status
       * ist die Tür, das Abo ist der Durchgang. Ohne Mod-Status ein „Abo
       * fehlt" zu zeigen wäre eine Beschwerde über eine Folge statt über die
       * Ursache — und der Streamer suchte an der falschen Stelle.
       */
      let leitungZeile;
      if (modZustand !== 'ja') {
        leitungZeile = '<div class="text-secondary small">Der Chat wird erst abonniert, wenn der Bot '
                     + 'Moderator ist.</div>';
      } else if (k.abo && k.abo.fehler) {
        leitungZeile = `<div><span class="badge bg-red-lt">abgelehnt</span></div>
                        <div class="text-secondary small mt-1">Twitch sagt: ${k.abo.fehler}</div>`;
      } else if (k.abo) {
        const empfangen = k.empfangen
          ? `${k.empfangen.anzahl} Nachricht${k.empfangen.anzahl === 1 ? '' : 'en'} seit dem Verbinden`
          : 'noch nichts empfangen — der Kanal ist vermutlich still';
        leitungZeile = `<div>${abzeichen(k.abo.zustand || 'unbekannt', 'bestaetigt', 'fehler')}</div>
                        <div class="text-secondary small mt-1">${empfangen}</div>`;
      } else {
        leitungZeile = '<div><span class="badge bg-secondary-lt">nicht abonniert</span></div>'
                     + '<div class="text-secondary small mt-1">Der nächste Abgleich holt das nach.</div>';
      }

      const koerper = `
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="fw-medium">Bot im Chat</span>
          ${abzeichen(modZustand, 'ja', 'nein')}
        </div>
        ${a && a.text    ? `<div class="text-secondary small">${a.text}</div>` : ''}
        ${a && a.hinweis ? `<div class="text-secondary small">${a.hinweis}</div>` : ''}
        ${a && a.tat     ? `<div class="small mt-2">Zu tun: <code>${a.tat}</code></div>` : ''}
        <hr class="my-3">
        <div class="fw-medium mb-2">Chat-Leitung</div>
        ${leitungZeile}`;
    %>
    <%- include('shared/funktionskarte', {
          titel:        (k.anzeigename || k.login),
          beschreibung: 'twitch.tv/' + k.login,
          icon:         'fa-brands fa-twitch',
          koerper:      koerper
    }) %>

    <%
      /*
       * **Die Live-Ansage (Stufe 13c) — die erste Sache, die der Bot sagt.**
       *
       * Sie steht in einer eigenen Karte unter der Anschlusskarte darüber,
       * weil sie etwas anderes ist: Die Karte oben misst, diese hier
       * entscheidet. Und sie entscheidet über etwas, das unter dem Namen des
       * Streamers erscheint — deshalb steht genau das als erster Satz im
       * Kasten und nicht in einer Fußnote (14-Rechte-neu-denken.md, 17.5).
       */
      const name = k.anzeigename || k.login;
      const darfSchreiben = k.darf_schreiben || { zustand: 'unbekannt', grund: null };
      const an = Number(k.chat_ansage_an) === 1;

      let hinweisBlock = `<strong>Der Chatbot schreibt unter dem Namen ${name}</strong> —
        nicht unter einem Botnamen. Wer die Ansage liest, sieht sie so, als hätte
        ${name} sie selbst getippt.`;

      if (darfSchreiben.zustand === 'nein') {
        hinweisBlock += `<hr class="my-2"><strong>Erlaubt ist das noch nicht.</strong>
          Eingeschaltet passiert deshalb nichts: Nur ${name} selbst kann es erlauben,
          im eigenen Profil unter <em>Verbundene Konten → Berechtigungen</em>.
          ${darfSchreiben.grund ? darfSchreiben.grund : ''}`;
      } else if (darfSchreiben.zustand === 'unbekannt') {
        hinweisBlock += `<hr class="my-2">Ob es erlaubt ist, lässt sich gerade nicht
          feststellen. ${darfSchreiben.grund || ''}`;
      }

      /*
       * **Was beim letzten Mal herauskam.** Ohne diese Zeilen wäre der
       * Schalter eine Zusicherung: Twitch antwortet auch dann mit „in
       * Ordnung“, wenn die Nachricht am AutoMod hängenbleibt und nie im Chat
       * steht. Erst der Ausgang sagt, ob sie wirklich gesagt wurde.
       */
      const l = k.letzte_ansage;
      let ausgang = '';
      if (l) {
        const wann = vorWieLange(l.erledigt_am || l.faellig_ab) || 'gerade eben';
        if (l.zustand === 'fertig') {
          ausgang = `<div><span class="badge bg-green-lt">gesendet</span>
                     <span class="text-secondary small ms-1">${wann}${l.fehlertext ? ' — ' + l.fehlertext : ''}</span></div>`;
        } else if (l.zustand === 'aufgegeben') {
          ausgang = `<div class="alert alert-warning mb-0"><strong>Die letzte Ansage kam nicht an.</strong><br>
                     ${l.fehlertext || 'Ohne Angabe eines Grundes.'}
                     <div class="small mt-1">${wann}. Es wird nicht noch einmal versucht —
                     eine Chatnachricht lässt sich nicht zurückholen, und fünf gleiche
                     wären schlimmer als keine.</div></div>`;
        } else {
          /*
           * **„laeuft" bleibt nach einem Absturz stehen — mit Absicht.** Der
           * Auftrag darf dann nicht noch einmal laufen, weil die Zeile sehr
           * wohl im Chat stehen könnte. Nach ein paar Minuten heißt das aber
           * nicht mehr „unterwegs", sondern „wir wissen es nicht" — und genau
           * das muss dann dastehen.
           */
          const alterMin = (Date.now() - new Date(l.faellig_ab).getTime()) / 60000;
          ausgang = (l.zustand === 'laeuft' && alterMin > 5)
            ? `<div><span class="badge bg-secondary-lt">ungewiss</span>
               <span class="text-secondary small ms-1">${wann} begonnen — ob sie ankam,
               lässt sich nicht mehr feststellen. Es wird nichts nachgeholt.</span></div>`
            : `<div><span class="badge bg-secondary-lt">unterwegs</span>
               <span class="text-secondary small ms-1">${wann} vorgemerkt</span></div>`;
        }
      } else {
        ausgang = '<div class="text-secondary small">Noch nichts gesendet.</div>';
      }

      const ansageKoerper = `
        <input type="hidden" name="streamer_id" value="${k.id}">
        <div class="mb-3">
          <label class="form-label" for="ansage-${k.id}">Was im Chat stehen soll</label>
          <textarea class="form-control" id="ansage-${k.id}" name="ansage_text"
                    rows="2" maxlength="${chatMax}"
                    placeholder="${vorgabeAnsage}"
                    ${darf ? '' : 'disabled'}>${k.chat_ansage_text || ''}</textarea>
          <div class="form-hint">
            Leer heißt: <code>${vorgabeAnsage}</code>.
            Höchstens ${chatMax} Zeichen — mehr nimmt Twitch nicht an.
            Platzhalter: ${platzhalter.map(p => '<code>' + p.name + '</code>').join(' ')}.
          </div>
        </div>
        <div class="fw-medium mb-1">Zuletzt</div>
        ${ausgang}`;
    %>

    <%#
      Das Probe-Formular steht NEBEN der Karte, nicht darin: Ein Formular im
      Formular ist ungültiges HTML, und der Browser wirft das innere still
      weg. Der Knopf im Fuß hängt per form="…" daran — dasselbe Mittel, mit
      dem der Kopfschalter am Speichern-Formular hängt.
    %>
    <form id="chatprobe-<%= k.id %>" method="POST" data-toast data-toast-neuladen
          action="<%= basis %>/chatbot/probe" class="d-none">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <input type="hidden" name="streamer_id" value="<%= k.id %>">
    </form>

    <%- include('shared/funktionskarte', {
          titel:        'Live-Ansage im Chat',
          beschreibung: 'Wenn der Stream startet, sagt der Bot es im Twitch-Chat.',
          icon:         'fa-solid fa-bullhorn',
          id:           'chatansage-' + k.id,
          aktion:       basis + '/chatbot/ansage',
          csrfToken:    typeof csrfToken !== 'undefined' ? csrfToken : '',
          darf:         darf,
          schalter:     { name: 'ansage_an', an: an },
          hinweis:      hinweisBlock,
          koerper:      ansageKoerper,
          fuss:         (darf && an)
                          ? `<button type="submit" form="chatprobe-${k.id}"
                               class="btn btn-outline-secondary">Probe in den Chat</button>
                             <span class="text-secondary small">steht wirklich im Chat</span>`
                          : ''
    }) %>
  <% }); %>

  <%
    /*
     * **Der Knopf und der Bericht stehen in derselben Karte.** Wer abgleicht,
     * will wissen, was dabei herauskam; ein Knopf ohne Ausgang wäre wieder
     * die Attrappe.
     */
    const b = bericht;
    let berichtKoerper;
    if (!b) {
      berichtKoerper = '<p class="text-secondary mb-0">Noch kein Abgleich gelaufen. '
                     + 'Der Tageslauf holt das nach — oder du stößt ihn hier an.</p>';
    } else {
      const wann = vorWieLange(b.gelaufen_am) || 'gerade eben';
      const zeilen = [];
      if (b.abgebrochen) {
        zeilen.push(`<div class="alert alert-warning mb-2">Abgebrochen: ${b.abgebrochen}.
                     Es wurde nichts bestellt und nichts abbestellt.</div>`);
      } else {
        zeilen.push(`<div>${b.gewuenscht} Kanal-Chat(s) sollen anliegen, `
                  + `${b.vorhanden} Abo(s) stehen bei Twitch.</div>`);
        if (b.bestellt.length)   zeilen.push(`<div class="small text-secondary">neu angeschlossen: ${b.bestellt.join(', ')}</div>`);
        if (b.abbestellt.length) zeilen.push(`<div class="small text-secondary">abgemeldet: ${b.abbestellt.join(', ')}</div>`);
      }
      if (b.fehler && b.fehler.length) {
        zeilen.push(`<div class="alert alert-danger mt-2 mb-0"><strong>Abgelehnt:</strong><br>`
                  + b.fehler.map(f => String(f)).join('<br>') + '</div>');
      }
      zeilen.push(`<div class="text-secondary small mt-2">Letzter Lauf: ${wann}.</div>`);
      berichtKoerper = zeilen.join('\n');
    }

    /*
     * Die Leitung selbst: Sie liegt im Dashboard und gilt für alle Kanäle
     * zusammen. Steht sie nicht, ist jede Zeile darüber ohne Bedeutung —
     * deshalb steht sie hier und nicht bei einem einzelnen Kanal.
     */
    const l = leitung;
    berichtKoerper += `
      <hr class="my-3">
      <div class="d-flex align-items-center gap-2">
        <span class="fw-medium">Leitung zu Twitch</span>
        ${l && l.verbunden
          ? '<span class="badge bg-green-lt">verbunden</span>'
          : '<span class="badge bg-red-lt">getrennt</span>'}
      </div>
      ${l && l.fehler ? `<div class="text-secondary small mt-1">${l.fehler}</div>` : ''}
      ${l && !l.conduitId ? '<div class="text-secondary small mt-1">Ohne Conduit kann kein Chat abonniert werden.</div>' : ''}`;
  %>

  <%- include('shared/funktionskarte', {
        titel:        'Anschluss abgleichen',
        icon:         'fa-solid fa-rotate',
        beschreibung: 'Wer gerade /mod getippt hat, muss nicht bis zum nächsten Tageslauf warten.',
        id:           'chat-abgleich',
        aktion:       basis + '/chatbot/abgleich',
        csrfToken:    typeof csrfToken !== 'undefined' ? csrfToken : '',
        darf:         darf,
        speichern:    'Jetzt abgleichen',
        koerper:      berichtKoerper
  }) %>

  <div class="card">
    <div class="card-body text-secondary small">
      <strong>Befehle und Chat-Filter kommen mit Stufe 15.</strong>
      Heute liest der Bot mit, zählt — und sagt beim Streamstart Bescheid, wenn
      das eingeschaltet ist. Was im Chat ankommt, wird dabei
      <strong>nicht gespeichert</strong>: kein Text, kein Absender. Ob, wie lange
      und wofür das zulässig wäre, gehört zur ausstehenden Rechtsprüfung und
      wird nicht nebenbei in einem Zähler entschieden.
    </div>
  </div>
<% } %>
