<%- include('partials/streaming-kopf', {
  guildId, tr,
  icon: 'fa-solid fa-comments',
  titel: tr('streaming:CHATBOT.TITLE'),
  beschreibung: tr('streaming:CHATBOT.SUBTITLE')
}) %>

<%
  /*
   * **Diese Seite verspricht nichts, sie misst.** Sie zeigt, was
   * angeschlossen ist und ob die Leitung trägt. Befehle, Ansagen und
   * Mitmachen haben seit Stufe 15 eigene Seiten, der Chat-Schutz ist ein
   * Entwurf; was davon im Chat bleibt, sagt die Fußnote (CHATBOT.FUSSNOTE,
   * nachgemessen 2026-11-07, Kassensturz K322).
   *
   * Das ist Absicht und kein Versehen: Die Heim-Guild ist die Entscheidung,
   * WO das später bedient wird. Sie hat einen sichtbaren Ausgang (diesen
   * Menüpunkt gibt es hier und sonst nirgends), und mehr behauptet sie nicht.
   * Karten mit Schaltern für Fähigkeiten, die es nicht gibt, wären genau das
   * leere Versprechen, gegen das dieses Plugin geschrieben ist.
   *
   * Was hier an Zahlen steht, kommt aus dem letzten Abgleich und aus dem
   * Zähler der Leitung - nichts davon ist geschätzt.
   */
  const basis = `/guild/${guildId}/plugins/streaming`;
  const darf  = hasPermission('STREAMING.CHAT.MANAGE');

  const meldungen = {
    abgeglichen: tr('streaming:CHATBOT.OK_ABGEGLICHEN'),
    gespeichert: tr('streaming:CHATBOT.OK_GESPEICHERT'),
    probe:       tr('streaming:CHATBOT.OK_PROBE')
  };
  const fehlerTexte = {
    kein_heim:   tr('streaming:CHATBOT.F_KEIN_HEIM'),
    abgebrochen: tr('streaming:CHATBOT.F_ABGEBROCHEN'),
    kanal:       tr('streaming:CHATBOT.F_KANAL'),
    aus:         tr('streaming:CHATBOT.F_AUS'),
    zu_lang:     tr('streaming:CHATBOT.F_ZU_LANG'),
    platzhalter: tr('streaming:CHATBOT.F_PLATZHALTER'),
    nur_discord: tr('streaming:CHATBOT.F_NUR_DISCORD'),
    technisch:   tr('streaming:CHATBOT.F_TECHNISCH')
  };

  /**
   * Ein Abzeichen für einen dreiwertigen Zustand.
   */
  const abzeichen = (wert, gut, schlecht) =>
      wert === gut      ? `<span class="badge bg-green-lt">${wert}</span>`
    : wert === schlecht ? `<span class="badge bg-yellow-lt">${wert}</span>`
                        : `<span class="badge bg-secondary-lt">${wert}</span>`;
%>

<% if (meldung && meldungen[meldung]) { %>
  <div class="alert alert-success"><%= meldungen[meldung] %></div>
<% } %>
<% if (fehler && fehlerTexte[fehler]) { %>
  <div class="alert alert-warning"><%= fehlerTexte[fehler] %></div>
<% } %>

<% if (!kanaele || kanaele.length === 0) { %>
  <div class="card mb-3">
    <div class="card-body">
      <%- include('shared/leerzustand', {
            icon:  'fa-solid fa-comments',
            titel: tr('streaming:CHATBOT.LEER_TITEL'),
            text:  tr('streaming:CHATBOT.LEER_TEXT')
          }) %>
    </div>
  </div>
<% } else { %>

  <%- include('shared/funktionskarte', {
        titel:        tr('streaming:CHATBOT.WARUM_TITEL'),
        icon:         'fa-solid fa-circle-info',
        koerper:      '<p class="mb-0">' + tr('streaming:CHATBOT.WARUM_TEXT') + '</p>'
  }) %>

  <% kanaele.forEach(k => { %>
    <%
      const a = k.anschluss;
      const modZustand = a ? a.zustand : 'unbekannt';

      /*
       * **Zwei Zeilen, und die zweite hängt an der ersten.** Der Mod-Status
       * ist die Tür, das Abo ist der Durchgang. Ohne Mod-Status ein „Abo
       * fehlt" zu zeigen wäre eine Beschwerde über eine Folge statt über die
       * Ursache — und der Streamer suchte an der falschen Stelle.
       */
      let leitungZeile;
      if (modZustand !== 'ja') {
        leitungZeile = '<div class="text-secondary small">' + tr('streaming:CHATBOT.MOD_ZUERST') + '</div>';
      } else if (k.abo && k.abo.fehler) {
        leitungZeile = `<div><span class="badge bg-red-lt">${tr('streaming:CHATBOT.ABGELEHNT')}</span></div>
                        <div class="text-secondary small mt-1">${tr('streaming:CHATBOT.TWITCH_SAGT', { grund: k.abo.fehler })}</div>`;
      } else if (k.abo) {
        const empfangen = k.empfangen
          ? tr(k.empfangen.anzahl === 1 ? 'streaming:CHATBOT.EMPFANGEN_EINE' : 'streaming:CHATBOT.EMPFANGEN_VIELE', { n: k.empfangen.anzahl })
          : tr('streaming:CHATBOT.NICHTS_EMPFANGEN');
        leitungZeile = `<div>${abzeichen(k.abo.zustand || 'unbekannt', 'bestaetigt', 'fehler')}</div>
                        <div class="text-secondary small mt-1">${empfangen}</div>`;
      } else {
        leitungZeile = '<div><span class="badge bg-secondary-lt">' + tr('streaming:CHATBOT.NICHT_ABONNIERT') + '</span></div>'
                     + '<div class="text-secondary small mt-1">' + tr('streaming:CHATBOT.NAECHSTER_ABGLEICH') + '</div>';
      }

      const koerper = `
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="fw-medium">${tr('streaming:CHATBOT.BOT_IM_CHAT')}</span>
          ${abzeichen(modZustand, 'ja', 'nein')}
        </div>
        ${a && a.text    ? `<div class="text-secondary small">${a.text}</div>` : ''}
        ${a && a.hinweis ? `<div class="text-secondary small">${a.hinweis}</div>` : ''}
        ${a && a.tat     ? `<div class="small mt-2">${tr('streaming:CHATBOT.ZU_TUN')} <code>${a.tat}</code></div>` : ''}
        <hr class="my-3">
        <div class="fw-medium mb-2">${tr('streaming:CHATBOT.LEITUNG')}</div>
        ${leitungZeile}`;
    %>
    <%- include('shared/funktionskarte', {
          titel:        (k.anzeigename || k.login),
          beschreibung: 'twitch.tv/' + k.login,
          icon:         'fa-brands fa-twitch',
          koerper:      koerper
    }) %>

    <%
      /*
       * **Die Live-Ansage (Stufe 13c) — die erste Sache, die der Bot sagt.**
       *
       * Sie steht in einer eigenen Karte unter der Anschlusskarte darüber,
       * weil sie etwas anderes ist: Die Karte oben misst, diese hier
       * entscheidet. Und sie entscheidet über etwas, das unter dem Namen des
       * Streamers erscheint — deshalb steht genau das als erster Satz im
       * Kasten und nicht in einer Fußnote (14-Rechte-neu-denken.md, 17.5).
       */
      const name = k.anzeigename || k.login;
      const darfSchreiben = k.darf_schreiben || { zustand: 'unbekannt', grund: null };
      const an = Number(k.chat_ansage_an) === 1;

      let hinweisBlock = `${tr('streaming:CHATBOT.SCHREIBT_ALS', { name })}`;

      if (darfSchreiben.zustand === 'nein') {
        hinweisBlock += `<hr class="my-2">${tr('streaming:CHATBOT.NOCH_NICHT_ERLAUBT', { name })}
          ${darfSchreiben.grund ? darfSchreiben.grund : ''}`;
      } else if (darfSchreiben.zustand === 'unbekannt') {
        hinweisBlock += `<hr class="my-2">${tr('streaming:CHATBOT.ERLAUBT_UNKLAR')} ${darfSchreiben.grund || ''}`;
      }

      /*
       * **Was beim letzten Mal herauskam.** Ohne diese Zeilen wäre der
       * Schalter eine Zusicherung: Twitch antwortet auch dann mit „in
       * Ordnung“, wenn die Nachricht am AutoMod hängenbleibt und nie im Chat
       * steht. Erst der Ausgang sagt, ob sie wirklich gesagt wurde.
       */
      const l = k.letzte_ansage;
      let ausgang = '';
      if (l) {
        const wann = vorWieLange(l.erledigt_am || l.faellig_ab) || tr('streaming:CHATBOT.GERADE_EBEN');
        if (l.zustand === 'fertig') {
          ausgang = `<div><span class="badge bg-green-lt">${tr('streaming:CHATBOT.GESENDET')}</span>
                     <span class="text-secondary small ms-1">${wann}${l.fehlertext ? ' — ' + l.fehlertext : ''}</span></div>`;
        } else if (l.zustand === 'aufgegeben') {
          ausgang = `<div class="alert alert-warning mb-0">${tr('streaming:CHATBOT.NICHT_ANGEKOMMEN')}<br>
                     ${l.fehlertext || tr('streaming:CHATBOT.OHNE_GRUND')}
                     <div class="small mt-1">${tr('streaming:CHATBOT.NICHT_NOCHMAL', { wann })}</div></div>`;
        } else {
          /*
           * **„laeuft" bleibt nach einem Absturz stehen — mit Absicht.** Der
           * Auftrag darf dann nicht noch einmal laufen, weil die Zeile sehr
           * wohl im Chat stehen könnte. Nach ein paar Minuten heißt das aber
           * nicht mehr „unterwegs", sondern „wir wissen es nicht" — und genau
           * das muss dann dastehen.
           */
          const alterMin = (Date.now() - new Date(l.faellig_ab).getTime()) / 60000;
          ausgang = (l.zustand === 'laeuft' && alterMin > 5)
            ? `<div><span class="badge bg-secondary-lt">${tr('streaming:CHATBOT.UNGEWISS')}</span>
               <span class="text-secondary small ms-1">${tr('streaming:CHATBOT.UNGEWISS_TEXT', { wann })}</span></div>`
            : `<div><span class="badge bg-secondary-lt">${tr('streaming:CHATBOT.UNTERWEGS')}</span>
               <span class="text-secondary small ms-1">${tr('streaming:CHATBOT.VORGEMERKT', { wann })}</span></div>`;
        }
      } else {
        ausgang = '<div class="text-secondary small">' + tr('streaming:CHATBOT.NOCH_NICHTS') + '</div>';
      }

      const ansageKoerper = `
        <input type="hidden" name="streamer_id" value="${k.id}">
        <div class="mb-3">
          <label class="form-label" for="ansage-${k.id}">${tr('streaming:CHATBOT.WAS_IM_CHAT')}</label>
          <textarea class="form-control" id="ansage-${k.id}" name="ansage_text"
                    rows="2" maxlength="${chatMax}"
                    placeholder="${vorgabeAnsage}"
                    ${darf ? '' : 'disabled'}>${k.chat_ansage_text || ''}</textarea>
          <div class="form-hint">
            ${tr('streaming:CHATBOT.LEER_HEISST')} <code>${vorgabeAnsage}</code>.
            ${tr('streaming:CHATBOT.HOECHSTENS', { n: chatMax })}
            ${tr('streaming:CHATBOT.PLATZHALTER')} ${platzhalter.map(p => '<code>' + p.name + '</code>').join(' ')}.
          </div>
        </div>
        <div class="fw-medium mb-1">${tr('streaming:CHATBOT.ZULETZT')}</div>
        ${ausgang}`;
    %>

    <%#
      Das Probe-Formular steht NEBEN der Karte, nicht darin: Ein Formular im
      Formular ist ungültiges HTML, und der Browser wirft das innere still
      weg. Der Knopf im Fuß hängt per form="…" daran — dasselbe Mittel, mit
      dem der Kopfschalter am Speichern-Formular hängt.
    %>
    <form id="chatprobe-<%= k.id %>" method="POST" data-toast data-toast-neuladen
          action="<%= basis %>/chatbot/probe" class="d-none">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <input type="hidden" name="streamer_id" value="<%= k.id %>">
    </form>

    <%- include('shared/funktionskarte', {
          titel:        tr('streaming:CHATBOT.ANSAGE_TITEL'),
          beschreibung: tr('streaming:CHATBOT.ANSAGE_TEXT'),
          icon:         'fa-solid fa-bullhorn',
          id:           'chatansage-' + k.id,
          aktion:       basis + '/chatbot/ansage',
          csrfToken:    typeof csrfToken !== 'undefined' ? csrfToken : '',
          darf:         darf,
          schalter:     { name: 'ansage_an', an: an },
          hinweis:      hinweisBlock,
          koerper:      ansageKoerper,
          fuss:         (darf && an)
                          ? `<button type="submit" form="chatprobe-${k.id}"
                               class="btn btn-outline-secondary">${tr('streaming:CHATBOT.PROBE')}</button>
                             <span class="text-secondary small">${tr('streaming:CHATBOT.PROBE_HINWEIS')}</span>`
                          : ''
    }) %>
  <% }); %>

  <%
    /*
     * **Der Knopf und der Bericht stehen in derselben Karte.** Wer abgleicht,
     * will wissen, was dabei herauskam; ein Knopf ohne Ausgang wäre wieder
     * die Attrappe.
     */
    const b = bericht;
    let berichtKoerper;
    if (!b) {
      berichtKoerper = '<p class="text-secondary mb-0">' + tr('streaming:CHATBOT.KEIN_ABGLEICH') + '</p>';
    } else {
      const wann = vorWieLange(b.gelaufen_am) || tr('streaming:CHATBOT.GERADE_EBEN');
      const zeilen = [];
      if (b.abgebrochen) {
        zeilen.push(`<div class="alert alert-warning mb-2">${tr('streaming:CHATBOT.ABGEBROCHEN', { grund: b.abgebrochen })}</div>`);
      } else {
        zeilen.push(`<div>${tr('streaming:CHATBOT.SOLL_IST', { soll: b.gewuenscht, ist: b.vorhanden })}</div>`);
        if (b.bestellt.length)   zeilen.push(`<div class="small text-secondary">${tr('streaming:CHATBOT.NEU', { liste: b.bestellt.join(', ') })}</div>`);
        if (b.abbestellt.length) zeilen.push(`<div class="small text-secondary">${tr('streaming:CHATBOT.AB', { liste: b.abbestellt.join(', ') })}</div>`);
      }
      if (b.fehler && b.fehler.length) {
        zeilen.push(`<div class="alert alert-danger mt-2 mb-0"><strong>${tr('streaming:CHATBOT.ABGELEHNT_TITEL')}</strong><br>`
                  + b.fehler.map(f => String(f)).join('<br>') + '</div>');
      }
      zeilen.push(`<div class="text-secondary small mt-2">${tr('streaming:CHATBOT.LETZTER_LAUF', { wann })}</div>`);
      berichtKoerper = zeilen.join('\n');
    }

    /*
     * Die Leitung selbst: Sie liegt im Dashboard und gilt für alle Kanäle
     * zusammen. Steht sie nicht, ist jede Zeile darüber ohne Bedeutung —
     * deshalb steht sie hier und nicht bei einem einzelnen Kanal.
     */
    const l = leitung;
    berichtKoerper += `
      <hr class="my-3">
      <div class="d-flex align-items-center gap-2">
        <span class="fw-medium">${tr('streaming:CHATBOT.LEITUNG_TWITCH')}</span>
        ${l && l.verbunden
          ? '<span class="badge bg-green-lt">' + tr('streaming:CHATBOT.VERBUNDEN') + '</span>'
          : '<span class="badge bg-red-lt">' + tr('streaming:CHATBOT.GETRENNT') + '</span>'}
      </div>
      ${l && l.fehler ? `<div class="text-secondary small mt-1">${l.fehler}</div>` : ''}
      ${l && !l.conduitId ? '<div class="text-secondary small mt-1">' + tr('streaming:CHATBOT.OHNE_CONDUIT') + '</div>' : ''}`;
  %>

  <%- include('shared/funktionskarte', {
        titel:        tr('streaming:CHATBOT.ABGLEICH_TITEL'),
        icon:         'fa-solid fa-rotate',
        beschreibung: tr('streaming:CHATBOT.ABGLEICH_TEXT'),
        id:           'chat-abgleich',
        aktion:       basis + '/chatbot/abgleich',
        csrfToken:    typeof csrfToken !== 'undefined' ? csrfToken : '',
        darf:         darf,
        speichern:    tr('streaming:CHATBOT.ABGLEICH_KNOPF'),
        koerper:      berichtKoerper
  }) %>

  <div class="card">
    <div class="card-body text-secondary small">
      <%- tr('streaming:CHATBOT.FUSSNOTE') %>
    </div>
  </div>
<% } %>
