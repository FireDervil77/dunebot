<%
/**
 * Meine Befehle (Stufe 15) — nach dem Entwurf.
 *
 * Zwei Karten, wie gezeichnet: erst die fertigen (anschalten reicht), dann die
 * eigenen (Wort, Antwort, wer darf).
 *
 * **`!discord` steht nicht bei den fertigen**, obwohl der Entwurf ihn dort
 * zeigt. Die Anlage kennt die Einladungsadresse einer Guild nicht, und sie zu
 * erfinden wäre schlimmer als sie wegzulassen. Er ist als Vorschlag im
 * Anlegen-Formular hinterlegt — der Streamer setzt seinen Link ein.
 *
 * Erwartet: eigene, fertigZeilen, FERTIG, PRAEFIX, kanaele, vorWieLange
 */
const darfAendern = typeof hasPermission === 'function' && hasPermission('STREAMING.CHAT.MANAGE');
const anFertig = new Set((fertigZeilen || []).filter(z => z.aktiv).map(z => z.wort));
const zahlFertig = new Map((fertigZeilen || []).map(z => [z.wort, z.benutzt_anzahl]));

// **Der eingestellte Rang, nicht der vorgeschlagene.** `FERTIG[wort].wer` ist
// nur der Anfangswert; steht schon eine Zeile in der Tabelle, gilt sie.
const werFertig = new Map((fertigZeilen || []).map(z => [z.wort, z.wer]));

const WER = [
    ['alle',      tr('streaming:COMMON.WER_ALLE')],
  ['abonnent',  tr('streaming:COMMON.WER_ABONNENT')],
  ['moderator', tr('streaming:COMMON.WER_MODERATOR')],
  ['inhaber',   tr('streaming:COMMON.WER_INHABER')]
];

const fehlerTexte = {
  wort:      tr('streaming:BEFEHLE.F_WORT'),
  antwort:   tr('streaming:BEFEHLE.F_ANTWORT'),
  doppelt:   tr('streaming:BEFEHLE.F_DOPPELT'),
  belegt:    tr('streaming:BEFEHLE.F_BELEGT'),
  weg:       tr('streaming:BEFEHLE.F_WEG'),
  technisch: tr('streaming:BEFEHLE.F_TECHNISCH')
};
const meldungen = {
  neu:         tr('streaming:BEFEHLE.OK_NEU'),
  baustein:    tr('streaming:BEFEHLE.OK_BAUSTEIN'),
  gespeichert: tr('streaming:BEFEHLE.OK_GESPEICHERT'),
  entfernt:    tr('streaming:BEFEHLE.OK_ENTFERNT')
};

// Bausteinfehler tragen ein `b_`, weil beide Formulare auf dieser Seite landen
// und `doppelt` sonst den falschen Satz zeigte.
Object.assign(fehlerTexte, {
  b_name:    tr('streaming:BEFEHLE.F_B_NAME'),
  b_belegt:  tr('streaming:BEFEHLE.F_B_BELEGT'),
  b_wert:    tr('streaming:BEFEHLE.F_B_WERT'),
  b_zu_lang: tr('streaming:BEFEHLE.F_B_ZU_LANG'),
  b_doppelt: tr('streaming:BEFEHLE.F_B_DOPPELT'),
  b_zahl:    tr('streaming:BEFEHLE.F_B_ZAHL'),
  b_weg:     tr('streaming:BEFEHLE.F_B_WEG')
});
%>

<%- include('partials/streaming-kopf', {
  guildId, tr,
  icon: 'fa-solid fa-terminal',
  titel: tr('streaming:BEFEHLE.TITLE'),
  beschreibung: tr('streaming:BEFEHLE.SUBTITLE'),
  aktion: darfAendern
    ? '<button class="btn btn-primary" type="button" data-bs-toggle="collapse" '
      + 'data-bs-target="#befehl-anlegen">' + tr('streaming:BEFEHLE.ANLEGEN_KNOPF') + '</button>'
    : ''
}) %>

<% if (meldung && meldungen[meldung]) { %>
  <div class="alert alert-success"><%= meldungen[meldung] %></div>
<% } %>
<% if (fehler) { %>
  <div class="alert alert-danger"><%= fehlerTexte[fehler] || fehlerTexte.technisch %></div>
<% } %>

<style>
  /* Die Umschaltung Text/Zähler im Anlegeformular. Zwei Regeln statt einer
     eigenen JS-Datei — mehr passiert hier nicht. */
  form:not(.ist-zaehler) .nur-zaehler { display: none; }
  form.ist-zaehler      .nur-text     { display: none; }
</style>

<div class="row row-cards">

  <%# ── Anlegen: ein Knopf, kein Dauerformular ─────────────────────────── %>
  <div class="col-12 collapse <%= (eigene || []).length ? '' : 'show' %>" id="befehl-anlegen">
    <div class="card">
      <div class="card-header">
        <div class="kartenkopf">
          <span class="kartensymbol"><i class="fa-solid fa-plus"></i></span>
          <div class="kartenkopf__text">
            <h3 class="kartenkopf__titel"><%= tr('streaming:BEFEHLE.EIGEN_TITEL') %></h3>
            <div class="kartenkopf__satz">
              <%- tr('streaming:BEFEHLE.EIGEN_TEXT', { p: PRAEFIX }) %>
            </div>
          </div>
        </div>
      </div>
      <form method="POST" action="/guild/<%= guildId %>/plugins/streaming/befehle">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <div class="card-body">
          <div class="zeilen">
            <div class="zeile">
              <div class="zeile__bez">
                <%= tr('streaming:BEFEHLE.WORT') %>
                <small><%= tr('streaming:BEFEHLE.WORT_HILFE', { p: PRAEFIX }) %></small>
              </div>
              <div>
                <div class="input-group">
                  <span class="input-group-text"><%= PRAEFIX %></span>
                  <input type="text" class="form-control" name="wort" required
                         maxlength="32" pattern="[A-Za-z0-9_-]{1,32}"
                         placeholder="<%= tr('streaming:BEFEHLE.WORT_BEISPIEL') %>" autocomplete="off">
                </div>
                <div class="zeile__hilfe">
                  <%- tr('streaming:BEFEHLE.HAEUFIG', { p: PRAEFIX }) %>
                </div>
              </div>
            </div>

            <div class="zeile">
              <div class="zeile__bez"><%= tr('streaming:BEFEHLE.ANTWORT') %></div>
              <div>
                <textarea class="form-control" name="antwort" rows="2" required
                          maxlength="500" placeholder="<%= tr('streaming:BEFEHLE.ANTWORT_BEISPIEL') %>"></textarea>
                <%# **Aus der Liste des Moduls, nicht danebengeschrieben.**
                    `PLATZHALTER` ist der Vertrag; eine Kopie hier waere beim
                    naechsten neuen Baustein still veraltet, und man saehe es
                    erst im Chat. %>
                <div class="chips mt-2">
                  <% PLATZHALTER.forEach(p => { %>
                    <span class="chip mono" title="<%= tr('streaming:PLATZHALTER.' + p.name.replace(/[{}]/g, ''), { defaultValue: p.bedeutung }) %>"><%= p.name %></span>
                  <% }); %>
                  <%# Die eigenen dahinter, damit sichtbar ist, was zur Verfügung
                      steht — sonst müsste man sie sich merken. %>
                  <% (bausteine || []).forEach(b => { %>
                    <span class="chip mono" title="<%= tr('streaming:BEFEHLE.EIGENER_BAUSTEIN', { wert: b.wert }) %>">{<%= b.name %>}</span>
                  <% }); %>
                </div>
                <% const nurLive = PLATZHALTER.filter(p => p.nurLive); %>
                <% if (nurLive.length) { %>
                  <div class="text-secondary small mt-1">
                    <i class="fa-solid fa-circle-info me-1"></i>
                    <%= nurLive.map(p => p.name).join(', ') %>
                    <%- tr(nurLive.length === 1 ? 'streaming:BEFEHLE.LIVE_EINS' : 'streaming:BEFEHLE.LIVE_VIELE') %>
                  </div>
                <% } %>
              </div>
            </div>

            <%# Nur zeigen, wenn es überhaupt Zähler gibt — ein leeres Auswahlfeld
                wäre eine Frage ohne Antwortmöglichkeit. %>
            <% const zaehler = (bausteine || []).filter(b => b.art === 'zaehler'); %>
            <% if (zaehler.length) { %>
              <div class="zeile">
                <div class="zeile__bez">
                  <%= tr('streaming:BEFEHLE.ZAEHLT') %>
                  <small><%= tr('streaming:BEFEHLE.ZAEHLT_HILFE') %></small>
                </div>
                <div>
                  <select class="form-select" name="zaehler_name" style="max-width:14rem">
                    <option value=""><%= tr('streaming:BEFEHLE.NICHTS') %></option>
                    <% zaehler.forEach(z => { %>
                      <option value="<%= z.name %>">{<%= z.name %>} <%= tr('streaming:BEFEHLE.STEHT_BEI', { n: z.zahl }) %></option>
                    <% }); %>
                  </select>

                  <%# **Das Muster, das man sonst nicht findet.** Hochzählen und
                      Anzeigen sind zwei Befehle, weil sie zwei verschiedene
                      Rechte und zwei verschiedene Abkühlungen brauchen. Das
                      geht seit jeher — es stand nur nirgends. %>
                  <div class="zeile__hilfe mt-2">
                    <%- tr('streaming:BEFEHLE.ZAEHLEN_MUSTER') %>
                  </div>
                </div>
              </div>
            <% } %>

            <div class="zeile">
              <div class="zeile__bez"><%= tr('streaming:BEFEHLE.WER_DARF') %></div>
              <div>
                <select class="form-select" name="wer">
                  <% WER.forEach(w => { %><option value="<%= w[0] %>"><%= w[1] %></option><% }); %>
                </select>
              </div>
            </div>

            <div class="zeile">
              <div class="zeile__bez">
                <%= tr('streaming:BEFEHLE.ABKUEHLUNG') %>
                <small><%= tr('streaming:BEFEHLE.ABKUEHLUNG_HILFE') %></small>
              </div>
              <div>
                <input type="number" class="form-control" style="max-width:8rem"
                       name="abkuehlung_s" min="0" max="3600" step="1" value="5">
                <div class="zeile__hilfe">
                  <%= tr('streaming:BEFEHLE.ABKUEHLUNG_TEXT') %>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="card-footer text-end">
          <button type="submit" class="btn btn-primary"><%= tr('streaming:ANSAGEN.ANLEGEN') %></button>
        </div>
      </form>
    </div>
  </div>

  <%# ── Fertige Befehle ──────────────────────────────────────────────────── %>
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <div class="kartenkopf">
          <span class="kartensymbol"><i class="fa-solid fa-bolt"></i></span>
          <div class="kartenkopf__text">
            <h3 class="kartenkopf__titel"><%= tr('streaming:BEFEHLE.FERTIG_TITEL') %></h3>
            <div class="kartenkopf__satz"><%= tr('streaming:BEFEHLE.FERTIG_TEXT') %></div>
          </div>
        </div>
      </div>
      <form method="POST" action="/guild/<%= guildId %>/plugins/streaming/befehle/fertig">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <div class="card-body">
          <div class="zeilen">
            <% Object.keys(FERTIG).forEach(wort => { %>
              <div class="zeile">
                <div class="zeile__bez">
                  <code><%= PRAEFIX %><%= wort %></code>
                  <small><%= tr('streaming:BEFEHLE.FERTIG.' + wort, { defaultValue: FERTIG[wort].beschreibung }) %></small>
                  <%# Ein Befehl, der etwas bewirkt, braucht eine Erlaubnis —
                      und der Streamer soll das hier sehen, nicht erst wenn
                      Twitch ablehnt. Wo sie erteilt wird, sagt „Mitmachen". %>
                  <% if (FERTIG[wort].zusage) { %>
                    <div class="zeile__hilfe">
                      <i class="fa-solid fa-key me-1"></i>
                      <%- tr('streaming:BEFEHLE.BRAUCHT_ERLAUBNIS') %>
                    </div>
                  <% } %>
                  <%# Ein Befehl, der ein anderes Plugin braucht, sagt das hier —
                      und der Schalter bleibt aus, solange es fehlt. Der Knopf
                      führt dorthin, statt den Streamer suchen zu lassen. %>
                  <% if (!(verfuegbar[wort] || {}).ok) { %>
                    <div class="zeile__hilfe text-warning">
                      <i class="fa-solid fa-plug-circle-xmark me-1"></i>
                      <%= verfuegbar[wort].grund %>
                      <% if (verfuegbar[wort].braucht) { %>
                        <a href="/guild/<%= guildId %>/plugins"
                           class="ms-1"><%= tr('streaming:COMMON.PLUGINS_OEFFNEN') %></a>
                      <% } %>
                    </div>
                  <% } %>
                </div>
                <div class="d-flex flex-wrap align-items-center justify-content-end gap-2">
                  <%# **Wer darf** — seit P9 eine echte Frage: `!clip` schneidet
                      wirklich einen Clip. Der Rang gehört dem Streamer, die
                      Abkühlung nicht (sie hängt daran, was der Befehl auslöst). %>
                  <select class="form-select form-select-sm" style="max-width:11rem"
                          name="wer[<%= wort %>]" <%= darfAendern ? '' : 'disabled' %>>
                    <% WER.forEach(w => { %>
                      <option value="<%= w[0] %>"
                        <%= (werFertig.get(wort) || FERTIG[wort].wer || 'alle') === w[0] ? 'selected' : '' %>>
                        <%= w[1] %>
                      </option>
                    <% }); %>
                  </select>

                  <label class="form-check form-switch mb-0">
                    <input type="checkbox" class="form-check-input" name="fertig" value="<%= wort %>"
                           <%= anFertig.has(wort) ? 'checked' : '' %>
                           <%= (darfAendern && (verfuegbar[wort] || {}).ok) ? '' : 'disabled' %>>
                    <span class="form-check-label"><%= tr('streaming:ANSAGEN.AN') %></span>
                  </label>

                  <% if (zahlFertig.get(wort)) { %>
                    <div class="zeile__hilfe"><%= tr('streaming:BEFEHLE.BENUTZT', { n: zahlFertig.get(wort) }) %></div>
                  <% } %>
                </div>
              </div>
            <% }); %>
          </div>

          <div class="text-secondary small mt-2">
            <i class="fa-solid fa-circle-info me-1"></i>
            <%- tr('streaming:BEFEHLE.FERTIG_ABKUEHLUNG', { p: PRAEFIX }) %>
          </div>
        </div>
        <% if (darfAendern) { %>
          <div class="card-footer text-end">
            <button type="submit" class="btn btn-primary"><%= tr('streaming:COMMON.SAVE') %></button>
          </div>
        <% } %>
      </form>
    </div>
  </div>

  <%# ── Eigene Befehle ───────────────────────────────────────────────────── %>
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <div class="kartenkopf">
          <span class="kartensymbol"><i class="fa-solid fa-pen"></i></span>
          <div class="kartenkopf__text">
            <h3 class="kartenkopf__titel"><%= tr('streaming:BEFEHLE.EIGENE_TITEL') %></h3>
            <div class="kartenkopf__satz"><%= tr('streaming:BEFEHLE.EIGENE_TEXT') %></div>
          </div>
        </div>
      </div>

      <% if (!(eigene || []).length) { %>
        <div class="card-body">
          <%- include('shared/leerzustand', {
                icon:  'fa-solid fa-terminal',
                titel: tr('streaming:BEFEHLE.LEER_TITEL'),
                text:  tr('streaming:BEFEHLE.LEER_TEXT', { p: PRAEFIX })
              }) %>
        </div>
      <% } else { %>
        <div class="card-body">
          <div class="zeilen">
            <% eigene.forEach(b => { %>
              <%# Ein Formular JE BEFEHL. Ein gemeinsames haette beim Speichern
                  des einen die Felder der anderen mitgeschickt — und wer eine
                  Antwort leert, haette alle geleert. %>
              <form method="POST" action="/guild/<%= guildId %>/plugins/streaming/befehle/<%= b.id %>"
                    class="zeile">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <div class="zeile__bez">
                  <code><%= PRAEFIX %><%= b.wort %></code>
                  <small>
                    <%= tr('streaming:BEFEHLE.BENUTZT', { n: b.benutzt_anzahl }) %><%
                      %><% if (b.benutzt_am) { %><%= tr('streaming:ANSAGEN.ZULETZT', { wann: vorWieLange(b.benutzt_am) }) %><% } %>
                  </small>
                </div>
                <div>
                  <textarea class="form-control" name="antwort" rows="2" maxlength="500"
                            <%= darfAendern ? '' : 'disabled' %>><%= b.antwort || '' %></textarea>

                  <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                    <select class="form-select form-select-sm" style="max-width:11rem" name="wer"
                            <%= darfAendern ? '' : 'disabled' %>>
                      <% WER.forEach(w => { %>
                        <option value="<%= w[0] %>" <%= b.wer === w[0] ? 'selected' : '' %>><%= w[1] %></option>
                      <% }); %>
                    </select>

                    <% const zaehlerListe = (bausteine || []).filter(v => v.art === 'zaehler'); %>
                    <% if (zaehlerListe.length || b.zaehler_name) { %>
                      <select class="form-select form-select-sm" style="max-width:13rem"
                              name="zaehler_name" title="<%= tr('streaming:BEFEHLE.ZAEHLER_TITEL') %>"
                              <%= darfAendern ? '' : 'disabled' %>>
                        <option value=""><%= tr('streaming:BEFEHLE.ZAEHLT_NICHTS') %></option>
                        <%# Ein Zähler, den es nicht mehr gibt, bleibt trotzdem
                            in der Liste: Sonst verlöre das Speichern ihn still. %>
                        <% const namen = [...new Set([...zaehlerListe.map(v => v.name),
                             ...(b.zaehler_name ? [b.zaehler_name] : [])])]; %>
                        <% namen.forEach(n => { %>
                          <option value="<%= n %>" <%= b.zaehler_name === n ? 'selected' : '' %>>{<%= n %>} <%= tr('streaming:BEFEHLE.ZAEHLT_DIES') %></option>
                        <% }); %>
                      </select>
                    <% } %>

                    <div class="input-group input-group-sm" style="max-width:9rem">
                      <input type="number" class="form-control" name="abkuehlung_s"
                             min="0" max="3600" step="1" value="<%= b.abkuehlung_s %>"
                             <%= darfAendern ? '' : 'disabled' %>>
                      <span class="input-group-text">s</span>
                    </div>

                    <label class="form-check form-switch mb-0">
                      <input type="checkbox" class="form-check-input" name="aktiv" value="1"
                             <%= b.aktiv ? 'checked' : '' %> <%= darfAendern ? '' : 'disabled' %>>
                      <span class="form-check-label"><%= tr('streaming:ANSAGEN.AN') %></span>
                    </label>

                    <% if (darfAendern) { %>
                      <button type="submit" class="btn btn-sm btn-primary ms-auto"><%= tr('streaming:COMMON.SAVE') %></button>
                    <% } %>
                  </div>
                </div>
              </form>

              <% if (darfAendern) { %>
                <%# Das Entfernen steht in einem EIGENEN Formular — verschachtelt
                    ginge es nicht, und im selben Formular waere ein zweiter
                    Absendeknopf neben "Speichern" eine Falle. %>
                <form method="POST" class="text-end"
                      action="/guild/<%= guildId %>/plugins/streaming/befehle/<%= b.id %>/entfernen"
                      onsubmit="return confirm(<%= JSON.stringify(tr('streaming:BEFEHLE.ENTFERNEN_FRAGE', { name: PRAEFIX + b.wort })) %>);">
                  <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                  <button type="submit" class="btn btn-sm btn-ghost-danger"><%= tr('streaming:COMMON.DELETE') %></button>
                </form>
              <% } %>
            <% }); %>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <%# ── Eigene Textbausteine ──────────────────────────────────────────────
      Sie gelten auch für Ansagen, stehen aber hier: dort, wo man den Text
      schreibt, in dem sie vorkommen. Ein eigener Menüpunkt für eine Handvoll
      Name-Wert-Paare wäre mehr Gliederung als Inhalt. %>
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <div class="kartenkopf">
          <span class="kartensymbol"><i class="fa-solid fa-puzzle-piece"></i></span>
          <div class="kartenkopf__text">
            <h3 class="kartenkopf__titel"><%= tr('streaming:BEFEHLE.BAUSTEINE_TITEL') %></h3>
            <div class="kartenkopf__satz">
              <%- tr('streaming:BEFEHLE.BAUSTEINE_TEXT') %>
            </div>
          </div>
        </div>
      </div>

      <div class="card-body">
        <% if (!(bausteine || []).length) { %>
          <%- include('shared/leerzustand', {
                icon:  'fa-solid fa-puzzle-piece',
                titel: tr('streaming:BEFEHLE.BAUSTEIN_LEER'),
                text:  tr('streaming:BEFEHLE.BAUSTEIN_LEER_TEXT')
              }) %>
        <% } else { %>
          <div class="zeilen">
            <% bausteine.forEach(b => { %>
              <form method="POST" action="/guild/<%= guildId %>/plugins/streaming/bausteine/<%= b.id %>"
                    class="zeile">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <div class="zeile__bez">
                  <code>{<%= b.name %>}</code>
                  <% if (b.art === 'zaehler') { %><small><%= tr('streaming:BEFEHLE.ZAEHLER') %></small><% } %>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                  <% if (b.art === 'zaehler') { %>
                    <%# Der Stand ist bearbeitbar — „zurücksetzen" ist hier
                        einfach eine 0, und das braucht keinen eigenen Knopf. %>
                    <input type="number" class="form-control" name="zahl"
                           style="max-width:10rem" min="0" step="1" value="<%= b.zahl %>"
                           <%= darfAendern ? '' : 'disabled' %>>
                  <% } else { %>
                    <input type="text" class="form-control" name="wert" maxlength="500"
                           style="min-width:16rem" value="<%= b.wert %>"
                           <%= darfAendern ? '' : 'disabled' %>>
                  <% } %>
                  <% if (darfAendern) { %>
                    <button type="submit" class="btn btn-sm btn-primary"><%= tr('streaming:COMMON.SAVE') %></button>
                  <% } %>
                </div>
              </form>
              <% if (darfAendern) { %>
                <form method="POST" class="text-end"
                      action="/guild/<%= guildId %>/plugins/streaming/bausteine/<%= b.id %>/entfernen"
                      onsubmit="return confirm(<%= JSON.stringify(tr('streaming:BEFEHLE.BAUSTEIN_FRAGE', { name: b.name })) %>);">
                  <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                  <button type="submit" class="btn btn-sm btn-ghost-danger"><%= tr('streaming:COMMON.DELETE') %></button>
                </form>
              <% } %>
            <% }); %>
          </div>
        <% } %>
      </div>

      <% if (darfAendern) { %>
        <form method="POST" action="/guild/<%= guildId %>/plugins/streaming/bausteine">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <div class="card-footer">
            <div class="d-flex flex-wrap align-items-end gap-2">
              <div>
                <label class="form-label"><%= tr('streaming:BEFEHLE.NAME') %></label>
                <div class="input-group" style="max-width:14rem">
                  <span class="input-group-text">{</span>
                  <input type="text" class="form-control" name="name" required
                         maxlength="32" pattern="\{?[A-Za-z0-9_-]{1,32}\}?" placeholder="discord">
                  <span class="input-group-text">}</span>
                </div>
              </div>
              <div>
                <label class="form-label"><%= tr('streaming:BEFEHLE.ART') %></label>
                <select class="form-select" name="art" style="max-width:11rem"
                        onchange="this.closest('form').classList.toggle('ist-zaehler', this.value === 'zaehler')">
                  <option value="text"><%= tr('streaming:ANSAGEN.TEXT') %></option>
                  <option value="zaehler"><%= tr('streaming:BEFEHLE.ZAEHLER') %></option>
                </select>
              </div>
              <div class="flex-fill nur-text" style="min-width:14rem">
                <label class="form-label"><%= tr('streaming:BEFEHLE.WERT') %></label>
                <input type="text" class="form-control" name="wert"
                       maxlength="500" placeholder="https://discord.gg/…">
              </div>
              <div class="nur-zaehler">
                <label class="form-label"><%= tr('streaming:BEFEHLE.STARTWERT') %></label>
                <input type="number" class="form-control" name="zahl"
                       style="max-width:9rem" min="0" step="1" value="0">
              </div>
              <button type="submit" class="btn btn-primary"><%= tr('streaming:ANSAGEN.ANLEGEN') %></button>
            </div>
            <%# Der häufigste Fehlversuch: einen eingebauten Namen überschreiben.
                Er wird abgewiesen — hier steht warum, bevor es passiert. %>
            <div class="text-secondary small mt-2">
              <%- tr('streaming:BEFEHLE.EINGEBAUT') %>
            </div>
          </div>
        </form>
      <% } %>
    </div>
  </div>
</div>
