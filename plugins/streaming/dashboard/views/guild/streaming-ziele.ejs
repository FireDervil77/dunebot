<%
  /*
   * **Drei Seiten, eine Ansicht.**
   *
   * Bis zum 2026-08-29 stand hier alles: Ankuendigung, Filter, Aufraeumen,
   * Meldungen und Rollen, je Ziel in einem Formular mit neunzehn Feldern.
   * Seit `b204406` sind es Karten; seit heute sind die Karten auf drei Seiten
   * verteilt, weil sie drei verschiedene Fragen beantworten.
   *
   * **Warum nicht drei Ansichtsdateien.** Sie haetten dasselbe Geruest
   * dreimal getragen - Meldungsband, Leerzustand, Zielschleife, Entfernen -
   * und waeren auseinandergelaufen wie die sieben Seitenkoepfe vor `296db60`.
   * `seite` entscheidet, welche Karten erscheinen; alles andere ist geteilt.
   *
   * **Was ein Teil NICHT erbt.** Ein eingebundener Teil sieht die `locals` der
   * Route, aber KEINE hier mit `const` erklaerten Namen. `kanalName` und
   * `darfAendern` muessen ausdruecklich mitgegeben werden - sonst sind sie im
   * Teil undefiniert, und das faellt erst beim Rendern auf.
   */

  const SEITEN = {
    ankuendigung: {
      icon: 'fa-solid fa-bullhorn',
      titel: 'Ankündigung',
      beschreibung: 'Wohin gemeldet wird, wenn ein Stream startet — und wann nicht.'
    },
    meldungen: {
      icon: 'fa-solid fa-bell',
      titel: 'Meldungen',
      beschreibung: 'Raid, Bits, Follower und Abonnenten, je Kanal einzeln anhakbar.'
    },
    rollen: {
      icon: 'fa-solid fa-user-tag',
      titel: 'Rollen und Kanäle',
      beschreibung: 'Was ein laufender Stream an diesem Discord verändert.'
    }
  };
  const _s = SEITEN[seite] || SEITEN.ankuendigung;
%>

<%- include('partials/streaming-kopf', {
  guildId, tr,
  icon: _s.icon,
  titel: _s.titel,
  beschreibung: _s.beschreibung
}) %>

<%
  // Ob jemand aendern darf, weiss der Theme-Helfer. Das ist Hoeflichkeit:
  // Die Sperre, die zaehlt, steht in der Route.
  const darfAendern    = typeof hasPermission === 'function' && hasPermission('STREAMING.TARGETS.MANAGE');
  const darfProben     = typeof hasPermission === 'function' && hasPermission('STREAMING.TEST');
  const darfEinstellen = typeof hasPermission === 'function' && hasPermission('STREAMING.SETTINGS.EDIT');
  const darfVorlagen   = typeof hasPermission === 'function' && hasPermission('STREAMING.TEMPLATES.EDIT');

  const basis = `/guild/${guildId}/plugins/streaming`;
  const marke = typeof csrfToken !== 'undefined' ? csrfToken : '';

  const meldungen = {
    gespeichert: 'Gespeichert. Ab der nächsten Ankündigung gilt die neue Einstellung.',
    entfernt:         'Ziel entfernt. Der Kanal wird weiter beobachtet, wenn noch ein anderes Ziel darauf zeigt.',
    rolle_gewechselt: 'Live-Rolle gewechselt. Die alte Rolle wird allen entzogen, denen sie das Plugin gegeben haben könnte.',
    rolle_aus:        'Live-Rolle abgeschaltet und allen entzogen.',
    zurueckgesetzt:   'Eigener Text entfernt — für dieses Ziel gilt wieder der Standard.',
    probe:            'Probe ist unterwegs — sie steht in wenigen Sekunden im Kanal. Sie wird nicht veröffentlicht und hinterlässt keine Spur; aufräumen musst du sie selbst.'
  };
  const fehlerTexte = {
    ziel_fehlt: 'Bitte einen Kanal für die Ankündigung wählen.',
    bild:       'Das eigene Vorschaubild muss eine vollständige Adresse mit https:// sein.',
    weg:        'Dieses Ziel gibt es nicht mehr.',
    rolle:      'Das war keine gültige Rollen-Auswahl.',
    zone:       'Das war keine gültige Zeitzone.',
    zu_lang:     'Der Text ist zu lang. Discord nimmt 2000 Zeichen; wir lassen 1000 zu, weil Platzhalter beim Füllen wachsen.',
    platzhalter: 'Da steht ein Platzhalter, den es nicht gibt. Er würde wörtlich in der Ankündigung landen — die Liste unten zeigt alle gültigen.',
    technisch:  'Das hat technisch nicht geklappt. Der Grund steht im Protokoll.'
  };

  // Wir speichern IDs, keine Namen. Findet sich eine ID nicht mehr, ist der
  // Kanal geloescht worden - das soll dastehen und nicht als nackte Zahl
  // erscheinen, mit der niemand etwas anfangen kann.
  const kanalName = (id, liste) => {
    if (!id) return null;
    const k = (liste || []).find(x => String(x.id) === String(id));
    return k ? k.name : null;
  };

  const liveRolleName = (rollen || []).find(r => String(r.id) === String(liveRolleId));
%>

<% if (meldung && meldungen[meldung]) { %>
  <div class="alert alert-success"><%= meldungen[meldung] %></div>
<% } %>
<% if (fehler && fehlerTexte[fehler]) { %>
  <div class="alert alert-danger"><%= fehlerTexte[fehler] %></div>
<% } %>

<% if (!ziele || ziele.length === 0) { %>
  <div class="card mb-3">
    <div class="card-body">
      <%# Der Hinweistext bleibt Prosa und wandert nicht in `text`: Er enthaelt
          einen Verweis, und `text` wird bewusst maskiert ausgegeben. %>
      <%- include('shared/leerzustand', {
            icon:   _s.icon,
            titel:  tr('streaming:TARGETS.EMPTY'),
            aktion: `<a class="btn btn-primary" href="${basis}/streamer">`
                  + `<i class="fa-solid fa-video me-2"></i>Kanal eintragen</a>`
          }) %>
      <p class="text-secondary small text-center mt-3 mb-0">
        Soll derselbe Streamer in einen <strong>zweiten</strong> Discord-Kanal melden,
        trage ihn dort noch einmal ein und wähle den anderen Kanal.
      </p>
    </div>
  </div>
<% } %>

<%# ---- Vorgaben der Guild: je Seite die, die dorthin gehoert ---- %>

<% if (seite === 'ankuendigung') { %>
  <%- include('shared/funktionskarte', {
        titel:        'Zeitzone dieses Servers',
        beschreibung: 'Bezugspunkt für alle Ruhezeiten weiter unten.',
        icon:         'fa-solid fa-clock',
        id:           'zeitzone-karte',
        aktion:       `${basis}/ziele/zeitzone`,
        csrfToken:    marke,
        darf:         darfEinstellen,
        koerper:      include('teile/vorgaben-zeitzone', { darfEinstellen })
  }) %>
<% } %>

<% if (seite === 'ankuendigung') { %>
  <%# **Die Standardtexte** — seit dem 2026-08-29 hier statt unter einem
      eigenen Menuepunkt "Vorlagen". Der Text gehoert zu der Sache, deren Text
      er ist; vorher stand die Ankuendigung unter "Ziele" und ihr Wortlaut
      woanders. %>
  <%- include('shared/funktionskarte', {
        titel:        'Text der Ankündigung',
        beschreibung: 'Gilt für alle Ziele dieser Guild, solange ein Ziel nichts Eigenes sagt.',
        icon:         'fa-solid fa-comment-dots',
        id:           'vorlagen-standard',
        aktion:       `${basis}/vorlagen`,
        csrfToken:    marke,
        darf:         darfVorlagen,
        koerper:      include('teile/vorlagen-standard', {
                          darfVorlagen, vorlagen, vorgabeLive, vorgabeRueckschau,
                          platzhalter
                      })
  }) %>
<% } %>

<% if (seite === 'rollen') { %>
  <%- include('shared/funktionskarte', {
        titel:        'Live-Rolle dieses Servers',
        beschreibung: 'Wer gerade sendet, bekommt diese Rolle — und verliert sie, wenn der Stream endet.',
        icon:         'fa-solid fa-tower-broadcast',
        id:           'live-rolle-karte',
        aktion:       `${basis}/ziele/live-rolle`,
        csrfToken:    marke,
        darf:         darfEinstellen,
        koerper:      include('teile/vorgaben-rolle', {
                          darfEinstellen, liveRolleName,
                          fremdeTraeger: (typeof fremdeTraeger !== 'undefined' ? fremdeTraeger : 0)
                      })
  }) %>
<% } %>

<%# ---- Die Kanäle dieser Guild -----------------------------------------

    **Seit P4 steht hier eine Tabelle statt fuenf Karten je Ziel.**

    Bis zum 2026-09-03 rendete diese Schleife je Ziel bis zu fuenf
    Funktionskarten — auf `/ankuendigung` ergaben vier Ziele 23 Karten
    untereinander, jede mit eigenem Speichern-Knopf. Dieselben Karten standen
    nochmal unter `/meldungen` und `/rollen`.

    Sie stehen jetzt auf `/streamer/:id`, wo sie einen Kanal betreffen und
    nicht alle. Was hier bleibt, ist die Frage, die diese Seite wirklich
    beantwortet: **Was gilt fuer die ganze Guild** — und wer weicht davon ab.
%>

<% if ((ziele || []).length) { %>
  <div class="card">
    <div class="card-header">
      <div class="kartenkopf">
        <span class="kartensymbol"><i class="fa-solid fa-video"></i></span>
        <div class="kartenkopf__text">
          <h3 class="kartenkopf__titel">Kanäle dieser Guild</h3>
          <div class="kartenkopf__satz">Eingestellt wird beim Kanal — hier steht, was schon eingestellt ist.</div>
        </div>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table card-table table-vcenter">
        <thead>
          <tr>
            <th>Kanal</th>
            <th>Geht nach</th>
            <th><%= seite === 'meldungen' ? 'Gemeldet wird' : (seite === 'rollen' ? 'Abo-Rolle' : 'Eigener Text') %></th>
            <th class="w-1"></th>
          </tr>
        </thead>
        <tbody>
          <% ziele.forEach(z => {
               const kName = kanalName(z.channel_id, zielkanaele);
               const rolle = (rollen || []).find(r => String(r.id) === String(z.abo_rolle_id));
               const arten = String(z.melder_arten || '').split(',').filter(Boolean);
          %>
            <tr class="<%= z.aktiv ? '' : 'opacity-50' %>">
              <td>
                <span class="fw-bold"><%= z.anzeigename || z.login %></span>
                <% if (!z.aktiv) { %>
                  <span class="zustandsmarke zustandsmarke--entwurf ms-2">aus</span>
                <% } %>
              </td>
              <td>
                <% if (kName) { %>
                  <span class="chip">#<%= kName %></span>
                <% } else { %>
                  <span class="text-danger small">⚠ Kanal gelöscht</span>
                <% } %>
              </td>
              <td>
                <% if (seite === 'meldungen') { %>
                  <% if (arten.length) { %>
                    <span class="text-secondary small"><%= arten.length %> von <%= (melderArten || []).length %></span>
                  <% } else { %>
                    <span class="text-secondary small">nichts</span>
                  <% } %>
                <% } else if (seite === 'rollen') { %>
                  <span class="text-secondary small"><%= rolle ? '@' + rolle.name : '—' %></span>
                <% } else { %>
                  <span class="text-secondary small"><%= z.vorlage ? 'weicht ab' : 'Standard' %></span>
                <% } %>
              </td>
              <td class="text-nowrap">
                <a class="btn btn-sm" href="<%= basis %>/streamer/<%= z.streamer_id %>">Einrichten</a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<% if (seite === 'ankuendigung') { %>
  <%- include('shared/funktionskarte', {
        titel:   'Platzhalter und Aufbau',
        icon:    'fa-solid fa-list',
        koerper: include('teile/vorlagen-platzhalter', { platzhalter })
  }) %>

  <script>
  // Vorschau im Browser, mit Beispielwerten. Bewusst kein Testversand: Wer eine
  // Vorschau sehen will, soll dafuer niemandem eine Nachricht schicken.
  //
  // Die Werte sind erkennbar Beispiele. Erfundene Zahlen, die wie gemessene
  // aussehen, waeren schlimmer als keine.
  (function () {
    var BEISPIEL = {
      '{streamer}':  'BeispielKanal',
      '{titel}':     'Erster Versuch, zweiter Anlauf',
      '{kategorie}': 'Just Chatting',
      '{url}':       'https://twitch.tv/beispielkanal',
      '{zuschauer}': '42',
      '{rolle}':     '@Stream-Ping',
      '{plattform}': 'Twitch',
      '{dauer}':     '2 h 14 min'
    };

    function fuellen(text, streamerName) {
      var werte = Object.assign({}, BEISPIEL);
      if (streamerName) werte['{streamer}'] = streamerName;

      return String(text || '').replace(/\{[a-z_]+\}/gi, function (treffer) {
        var schluessel = treffer.toLowerCase();
        // Unbekannter Platzhalter: stehen lassen und markieren. Genau so
        // erschiene er auch im Discord.
        return Object.prototype.hasOwnProperty.call(werte, schluessel)
          ? werte[schluessel]
          : treffer;
      }).trim();
    }

    function zeichnen(feld) {
      var ziel = document.getElementById(feld.dataset.vorschau);
      if (!ziel) return;
      var text = feld.value.trim();
      if (!text) {
        ziel.innerHTML = '<em class="text-secondary">— es gilt der Standard —</em>';
        return;
      }
      ziel.textContent = fuellen(text, feld.dataset.streamer);
    }

    document.querySelectorAll('.vorlage-feld').forEach(function (feld) {
      zeichnen(feld);
      feld.addEventListener('input', function () { zeichnen(feld); });
    });
  })();
  </script>
<% } %>
