<%- include('partials/streaming-kopf', {
  guildId, tr,
  icon: 'fa-solid fa-bullseye',
  titel: tr('streaming:TARGETS.TITLE'),
  beschreibung: tr('streaming:TARGETS.SUBTITLE')
}) %>

<%- include('partials/streaming-stufe', {
  text: 'Stufe 1: Diese Seite zeigt die eingerichteten Ziele. Bearbeiten kommt mit Stufe 5.'
}) %>

<%
  // Die Kanalnamen kommen frisch vom Bot - wir speichern nur IDs. Findet sich
  // eine ID nicht mehr, ist der Kanal geloescht worden. Das soll dastehen und
  // nicht als nackte Zahl erscheinen, mit der niemand etwas anfangen kann.
  const kanalName = (id, liste) => {
    if (!id) return null;
    const k = (liste || []).find(x => String(x.id) === String(id));
    return k ? k.name : null;
  };
  const rollenName = (id) => {
    const r = (rollen || []).find(x => String(x.id) === String(id));
    return r ? r.name : id;
  };
%>

<div class="row row-cards">
  <div class="col-12">
    <div class="card">
      <% if (!ziele || ziele.length === 0) { %>
        <div class="card-body">
          <p class="text-secondary mb-0"><%= tr('streaming:TARGETS.EMPTY') %></p>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table card-table table-vcenter">
            <thead>
              <tr>
                <th><%= tr('streaming:STREAMERS.CHANNEL') %></th>
                <th><%= tr('streaming:TARGETS.CHANNEL') %></th>
                <th><%= tr('streaming:TARGETS.ROLE') %></th>
                <th><%= tr('streaming:TARGETS.ONAIR') %></th>
                <th><%= tr('streaming:TARGETS.CLEANUP') %></th>
                <th><%= tr('streaming:TARGETS.ACTIVE') %></th>
              </tr>
            </thead>
            <tbody>
              <% ziele.forEach(z => { %>
                <tr>
                  <td class="fw-bold"><%= z.anzeigename || z.login %></td>
                  <td>
                    <% const kName = kanalName(z.channel_id, zielkanaele); %>
                    <% if (kName) { %># <%= kName %><% } else { %>
                      <span class="text-danger" title="ID <%= z.channel_id %>">
                        ⚠ Kanal geloescht
                      </span>
                    <% } %>
                  </td>
                  <td>
                    <% if (z.rolle_id) { %>@<%= rollenName(z.rolle_id) %><% } else { %>
                      <span class="text-secondary">—</span>
                    <% } %>
                  </td>
                  <td>
                    <% const oName = kanalName(z.onair_channel, sprachkanaele); %>
                    <% if (oName) { %>🔊 <%= oName %>
                    <% } else if (z.onair_channel) { %>
                      <span class="text-danger" title="ID <%= z.onair_channel %>">⚠ geloescht</span>
                    <% } else { %>
                      <span class="text-secondary">—</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (z.aufraeumen === 'loeschen') { %><%= tr('streaming:TARGETS.CLEANUP_DELETE') %>
                    <% } else if (z.aufraeumen === 'stehenlassen') { %><%= tr('streaming:TARGETS.CLEANUP_KEEP') %>
                    <% } else { %><%= tr('streaming:TARGETS.CLEANUP_EDIT') %><% } %>
                  </td>
                  <td>
                    <% if (z.aktiv) { %><span class="badge bg-green-lt">✓</span>
                    <% } else { %><span class="badge bg-secondary-lt">—</span><% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>
