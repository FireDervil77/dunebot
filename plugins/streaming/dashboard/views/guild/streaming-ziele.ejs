<%- include('partials/streaming-kopf', {
  guildId, tr,
  icon: 'fa-solid fa-bullseye',
  titel: tr('streaming:TARGETS.TITLE'),
  beschreibung: tr('streaming:TARGETS.SUBTITLE')
}) %>

<%
  /*
   * **Eine Karte je Funktion, statt eines Formulars mit neunzehn Feldern.**
   *
   * Bis zum 2026-08-29 stand hier je Ziel EIN Formular mit EINEM
   * Speichern-Knopf. Wer die Follower-Meldungen anhakte, schickte die
   * Ruhezeiten, die Filter und die Rollenzuordnung mit ab - und ein Fehler in
   * einem Feld nahm die anderen vier Funktionen mit.
   *
   * Die Felder selbst stehen jetzt in `teile/ziel-*.ejs`, der Rahmen kommt aus
   * `shared/funktionskarte`. Jede Karte spricht ihre eigene Route an und
   * schreibt ueber `zielTeilSpeichern` nur ihre eigenen Spalten. Das ist keine
   * Bequemlichkeit, sondern die Bedingung: Die abgeloeste `zielSpeichern`
   * schrieb alle siebzehn Spalten bedingungslos, und ein Teilformular haette
   * die anderen zwoelf still auf NULL gesetzt. Sie ist deshalb geloescht und
   * nicht nur ungenutzt liegengeblieben - ungenutztes Geraet versagt beim
   * ersten Einsatz lautlos.
   *
   * **Was ein Teil NICHT erbt.** Ein eingebundener Teil sieht die `locals` der
   * Route, aber KEINE hier mit `const` erklaerten Namen. `kanalName` und
   * `darfAendern` muessen deshalb ausdruecklich mitgegeben werden - sonst sind
   * sie im Teil undefiniert, und das faellt erst beim Rendern auf.
   */

  // Ob jemand aendern darf, weiss der Theme-Helfer. Das ist Hoeflichkeit:
  // Die Sperre, die zaehlt, steht in der Route.
  const darfAendern   = typeof hasPermission === 'function' && hasPermission('STREAMING.TARGETS.MANAGE');
  const darfProben    = typeof hasPermission === 'function' && hasPermission('STREAMING.TEST');
  const darfEinstellen = typeof hasPermission === 'function' && hasPermission('STREAMING.SETTINGS.EDIT');

  const basis = `/guild/${guildId}/plugins/streaming`;
  const marke = typeof csrfToken !== 'undefined' ? csrfToken : '';

  const meldungen = {
    gespeichert: 'Gespeichert. Ab der nächsten Ankündigung gilt die neue Einstellung.',
    entfernt:         'Ziel entfernt. Der Kanal wird weiter beobachtet, wenn noch ein anderes Ziel darauf zeigt.',
    rolle_gewechselt: 'Live-Rolle gewechselt. Die alte Rolle wird allen entzogen, denen sie das Plugin gegeben haben könnte.',
    rolle_aus:        'Live-Rolle abgeschaltet und allen entzogen.',
    probe:            'Probe ist unterwegs — sie steht in wenigen Sekunden im Kanal. Sie wird nicht veröffentlicht und hinterlässt keine Spur; aufräumen musst du sie selbst.'
  };
  const fehlerTexte = {
    ziel_fehlt: 'Bitte einen Kanal für die Ankündigung wählen.',
    bild:       'Das eigene Vorschaubild muss eine vollständige Adresse mit https:// sein.',
    weg:        'Dieses Ziel gibt es nicht mehr.',
    rolle:      'Das war keine gültige Rollen-Auswahl.',
    technisch:  'Das hat technisch nicht geklappt. Der Grund steht im Protokoll.'
  };

  // Wir speichern IDs, keine Namen. Findet sich eine ID nicht mehr, ist der
  // Kanal geloescht worden - das soll dastehen und nicht als nackte Zahl
  // erscheinen, mit der niemand etwas anfangen kann.
  const kanalName = (id, liste) => {
    if (!id) return null;
    const k = (liste || []).find(x => String(x.id) === String(id));
    return k ? k.name : null;
  };

  const liveRolleName = (rollen || []).find(r => String(r.id) === String(liveRolleId));
%>

<% if (meldung && meldungen[meldung]) { %>
  <div class="alert alert-success"><%= meldungen[meldung] %></div>
<% } %>
<% if (fehler && fehlerTexte[fehler]) { %>
  <div class="alert alert-danger"><%= fehlerTexte[fehler] %></div>
<% } %>

<% if (!ziele || ziele.length === 0) { %>
  <div class="card mb-3">
    <div class="card-body">
      <%# Der Hinweistext bleibt Prosa und wandert nicht in `text`: Er enthaelt
          einen Verweis, und `text` wird bewusst maskiert ausgegeben. %>
      <%- include('shared/leerzustand', {
            icon:   'fa-solid fa-bullseye',
            titel:  tr('streaming:TARGETS.EMPTY'),
            aktion: `<a class="btn btn-primary" href="${basis}/streamer">`
                  + `<i class="fa-solid fa-video me-2"></i>Kanal eintragen</a>`
          }) %>
      <p class="text-secondary small text-center mt-3 mb-0">
        Soll derselbe Streamer in einen <strong>zweiten</strong> Discord-Kanal melden,
        trage ihn dort noch einmal ein und wähle den anderen Kanal.
      </p>
    </div>
  </div>
<% } %>

<%- include('shared/funktionskarte', {
      titel:        'Vorgaben dieses Servers',
      beschreibung: 'Gilt für alle Ziele dieser Guild.',
      icon:         'fa-solid fa-sliders',
      id:           'vorgaben',
      aktion:       `${basis}/ziele/live-rolle`,
      csrfToken:    marke,
      darf:         darfEinstellen,
      koerper:      include('teile/vorgaben', {
                        darfEinstellen, liveRolleName, fremdeTraeger:
                          (typeof fremdeTraeger !== 'undefined' ? fremdeTraeger : 0)
                    })
}) %>

<% (ziele || []).forEach(z => { %>
  <%
    const kName = kanalName(z.channel_id, zielkanaele);
    const uebergabe = { z, kanalName, darfAendern };
  %>
  <div id="ziel-<%= z.id %>" class="mb-4">

    <%- include('shared/funktionskarte', {
          titel:        (z.anzeigename || z.login) + ' → ' + (kName ? '#' + kName : '⚠ Kanal gelöscht'),
          beschreibung: 'Aus heisst: Der Kanal wird weiter beobachtet, aber in diesem Discord passiert nichts — keine Ankündigung, keine Meldung, keine Rolle. Das Twitch-Abo bleibt bestehen.',
          icon:         'fa-solid fa-satellite-dish',
          id:           `ziel-schalter-${z.id}`,
          aktion:       `${basis}/ziele/${z.id}/schalter`,
          csrfToken:    marke,
          darf:         darfAendern,
          schalter:     { name: 'aktiv', an: !!z.aktiv },
          speichern:    'Schalter übernehmen',
          koerper:      include('teile/ziel-kopf', Object.assign({ basis, darfProben, marke }, uebergabe))
    }) %>

    <% if (darfProben) { %>
      <%# Traegt nur die Adresse und die Marke; die Bedienelemente stehen in
          der Karte darueber und haengen per form="…" hieran. Es steht NEBEN
          der Karte, weil ein Formular im Formular ungueltiges HTML ist - der
          Browser verwuerfe das innere, und der Probe-Knopf taete nichts. %>
      <form id="probe-<%= z.id %>" method="POST" data-toast
            action="<%= basis %>/ziele/<%= z.id %>/probe" hidden>
        <input type="hidden" name="_csrf" value="<%= marke %>">
      </form>
    <% } %>

    <%- include('shared/funktionskarte', {
          titel: 'Ankündigung', icon: 'fa-solid fa-bullhorn',
          beschreibung: 'Wohin gemeldet wird, wenn der Stream startet.',
          id: `ank-${z.id}`, aktion: `${basis}/ziele/${z.id}/ankuendigung`,
          csrfToken: marke, darf: darfAendern,
          koerper: include('teile/ziel-ankuendigung', uebergabe)
    }) %>

    <%- include('shared/funktionskarte', {
          titel: 'Meldungen', icon: 'fa-solid fa-bell',
          beschreibung: 'Raid, Bits, Follower, Abonnenten — einzeln anhakbar.',
          id: `mld-${z.id}`, aktion: `${basis}/ziele/${z.id}/meldungen`,
          csrfToken: marke, darf: darfAendern,
          koerper: include('teile/ziel-meldungen', uebergabe)
    }) %>

    <%- include('shared/funktionskarte', {
          titel: 'Filter und Ruhezeit', icon: 'fa-solid fa-filter',
          beschreibung: 'Wann trotz laufendem Stream NICHT angekündigt wird.',
          id: `flt-${z.id}`, aktion: `${basis}/ziele/${z.id}/filter`,
          csrfToken: marke, darf: darfAendern,
          koerper: include('teile/ziel-filter', uebergabe)
    }) %>

    <%- include('shared/funktionskarte', {
          titel: 'Aufräumen', icon: 'fa-solid fa-broom',
          beschreibung: 'Was mit der Ankündigung geschieht, wenn der Stream endet.',
          id: `auf-${z.id}`, aktion: `${basis}/ziele/${z.id}/aufraeumen`,
          csrfToken: marke, darf: darfAendern,
          koerper: include('teile/ziel-aufraeumen', uebergabe)
    }) %>

    <%- include('shared/funktionskarte', {
          titel: 'Rollen und Kanäle', icon: 'fa-solid fa-user-tag',
          beschreibung: 'Was ein laufender Stream am Discord verändert.',
          id: `rol-${z.id}`, aktion: `${basis}/ziele/${z.id}/rollen`,
          csrfToken: marke, darf: darfAendern,
          koerper: include('teile/ziel-rollen', uebergabe)
    }) %>

    <% if (darfAendern) { %>
      <%#
        Getrennte Zone fuer das Zerstoerende: eigene Karte, rechtsbuendig, weit
        weg von allem, was man im Alltag drueckt. Sie steht am Ende des Ziels
        und nicht in einer der Funktionskarten - dort waere sie neben einem
        Speichern-Knopf gelandet.
      %>
      <div class="card">
        <div class="card-footer text-end">
          <form method="POST" action="<%= basis %>/ziele/<%= z.id %>/entfernen"
                onsubmit="return confirm('Dieses Ziel wirklich entfernen?\n\nIst es das letzte Ziel für diesen Kanal, werden auch die Twitch-Abos abbestellt — der Kanal wird dann gar nicht mehr beobachtet.');">
            <input type="hidden" name="_csrf" value="<%= marke %>">
            <button type="submit" class="btn btn-sm btn-ghost-danger">Dieses Ziel entfernen</button>
          </form>
        </div>
      </div>
    <% } %>
  </div>
<% }); %>
