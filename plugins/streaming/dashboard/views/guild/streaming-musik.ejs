<%
/**
 * Musikwunsch — die Seite fuer den Streamer.
 *
 * Vier Karten, in der Reihenfolge, in der man sie braucht: erst die Adresse
 * fuer OBS (ohne die passiert nichts), dann der Zustand, dann die
 * Warteschlange, dann die Befehle als Nachschlagewerk.
 *
 * **Die Ablage-Zahl steht ganz oben im Hinweis** und nicht unten bei den
 * Befehlen: Eine leere Warteschlange sieht genauso aus wie eine leere Ablage,
 * und wer den Freigabeschalter nicht gesetzt hat, sucht sonst am Player.
 */
%>
<%- include('partials/streaming-kopf', {
  guildId, tr,
  icon: 'fa-solid fa-music',
  titel: tr('streaming:MUSIK.TITLE'),
  beschreibung: tr('streaming:MUSIK.SUBTITLE')
}) %>

<% if (meldung) { %>
  <div class="alert alert-success"><%= meldung %></div>
<% } %>
<% if (fehler) { %>
  <div class="alert alert-danger"><%= fehler %></div>
<% } %>

<% if (!hatAblage) { %>
  <div class="alert alert-warning">
    <%- tr('streaming:MUSIK.KEINE_ABLAGE') %>
  </div>
<% } else if (freigegeben === 0) { %>
  <div class="alert alert-warning">
    <%- tr('streaming:MUSIK.NICHT_FREI') %>
  </div>
<% } %>

<div class="row row-cards">

  <%# ---- 1. Die Adresse für OBS ---- %>
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><i class="fa-solid fa-satellite-dish me-2"></i><%= tr('streaming:MUSIK.OBS_TITEL') %></h3>
      </div>
      <div class="card-body">
        <p class="text-secondary">
          <%- tr('streaming:MUSIK.OBS_TEXT') %>
        </p>

        <%#
          Diese drei Häkchen stehen hier und nicht in einer Doku: Sie
          entscheiden, ob überhaupt etwas zu hören ist, und man sieht ihnen
          das nicht an. Ohne das erste läuft der Ton am Mixer vorbei; mit den
          anderen beiden bricht die Wiedergabe bei jedem Szenenwechsel ab.
        %>
        <div class="mb-3">
          <div class="fw-bold mb-1"><%= tr('streaming:MUSIK.HAEKCHEN') %></div>
          <ul class="mb-1">
            <li>
              <%- tr('streaming:MUSIK.HAKEN_1') %>
            </li>
            <li>
              <%- tr('streaming:MUSIK.HAKEN_2') %>
            </li>
            <li>
              <%- tr('streaming:MUSIK.HAKEN_3') %>
            </li>
          </ul>
          <div class="text-secondary">
            <%= tr('streaming:MUSIK.LAUTSTAERKE') %>
          </div>
        </div>

        <div class="input-group mb-2">
          <input type="text" class="form-control font-monospace" id="musik-adresse"
                 value="<%= adresse %>" data-basis="<%= adresse %>" readonly>
          <button class="btn" type="button" id="musik-kopieren">
            <i class="fa-regular fa-copy me-1"></i><%= tr('streaming:MUSIK.KOPIEREN') %>
          </button>
        </div>

        <%#
          Kein Serverzustand: Die Anzeige hängt an der Adresse, nicht an einer
          Einstellung. Wer zwei Quellen will — eine nur mit Ton, eine mit Titel
          im Bild — nimmt zweimal dieselbe Seite mit unterschiedlichem Anhang.
          Eine gespeicherte Einstellung könnte das nicht.
        %>
        <label class="form-check form-switch mb-3">
          <input class="form-check-input" type="checkbox" id="musik-titel-zeigen">
          <span class="form-check-label">
            <%= tr('streaming:MUSIK.TITEL_ZEIGEN') %>
            <span class="text-secondary">
              <%= tr('streaming:MUSIK.NUR_TON') %>
            </span>
          </span>
        </label>

        <div class="alert alert-info mb-0">
          <%- tr('streaming:MUSIK.ADRESSE_GEHEIM') %>
          <form method="post" action="/guild/<%= guildId %>/plugins/streaming/musik/schluessel"
                class="mt-2"
                onsubmit="return confirm(<%= JSON.stringify(tr('streaming:MUSIK.ADRESSE_FRAGE')) %>);">
            <button class="btn btn-sm btn-outline-danger" type="submit">
              <%= tr('streaming:MUSIK.ADRESSE_NEU') %>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <%# ---- 2. Zustand ---- %>
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><i class="fa-solid fa-heart-pulse me-2"></i><%= tr('streaming:NAV.STATE') %></h3>
      </div>
      <div class="card-body">
        <div class="mb-3">
          <span class="badge <%= player.verbunden ? 'bg-success' : 'bg-secondary' %> me-2">
            <%= tr(player.verbunden ? 'streaming:MUSIK.QUELLE_DA' : 'streaming:MUSIK.QUELLE_WEG') %>
          </span>
          <% if (player.sekunden !== null && !player.verbunden) { %>
            <span class="text-secondary"><%= tr('streaming:MUSIK.ZULETZT_VOR', { n: player.sekunden }) %></span>
          <% } else if (player.sekunden === null) { %>
            <span class="text-secondary"><%= tr('streaming:MUSIK.NOCH_NIE') %></span>
          <% } %>
        </div>

        <div class="mb-3">
          <% if (laeuft) { %>
            <div><strong><%= tr('streaming:MUSIK.LAEUFT') %></strong> <%= laeuft.titel %></div>
            <% if (laeuft.gewuenscht_von) { %>
              <div class="text-secondary"><%= tr('streaming:MUSIK.GEWUENSCHT_VON', { name: laeuft.gewuenscht_von }) %></div>
            <% } %>
          <% } else { %>
            <div class="text-secondary"><%= tr('streaming:MUSIK.NICHTS_LAEUFT') %></div>
          <% } %>
        </div>

        <form method="post" action="/guild/<%= guildId %>/plugins/streaming/musik/abspielen"
              class="mb-3">
          <input type="hidden" name="an" value="<%= aktiv ? '0' : '1' %>">
          <button class="btn <%= aktiv ? 'btn-outline-secondary' : 'btn-primary' %>" type="submit">
            <i class="fa-solid <%= aktiv ? 'fa-pause' : 'fa-play' %> me-1"></i>
            <%= tr(aktiv ? 'streaming:MUSIK.ANHALTEN' : 'streaming:MUSIK.WEITER') %>
          </button>
          <span class="text-secondary ms-2">
            <%= tr(aktiv ? 'streaming:MUSIK.IST_AN' : 'streaming:MUSIK.IST_AUS') %>
          </span>
        </form>

        <%# Derselbe Unterschied wie zwischen !pause und !stop im Chat. %>
        <form method="post" action="/guild/<%= guildId %>/plugins/streaming/musik/beenden"
              class="mb-3">
          <button class="btn btn-sm btn-outline-danger" type="submit">
            <i class="fa-solid fa-stop me-1"></i><%= tr('streaming:MUSIK.BEENDEN') %>

          </button>
          <span class="text-secondary ms-2">
            <%- tr('streaming:MUSIK.BEENDEN_TEXT') %>
          </span>
        </form>

        <%#
          An/Aus, also ein Schalter und kein Kästchen — Hausregel.
          Er schickt sich selbst ab: Ein Schalter, neben dem noch ein
          Speichern-Knopf steht, lässt offen, ob er schon gilt.

          **`requestSubmit()` und nicht `submit()`.** Hier stand `submit()`,
          und der Schalter lief in „ungültiger CSRF-Token": `form.submit()`
          löst **kein** `submit`-Ereignis aus — und genau daran hängt
          `csrf-helper.js`, der das `_csrf`-Feld einsetzt. Das Formular ging
          also ohne Token los. `requestSubmit()` verhält sich wie ein echter
          Klick und feuert das Ereignis.

          Kein eigenes `_csrf`-Feld hier: Das wäre ein zweiter Weg neben dem
          Helfer, und einer von beiden liefe irgendwann anders.
        %>
        <form method="post" action="/guild/<%= guildId %>/plugins/streaming/musik/endlos"
              id="endlos-form">
          <input type="hidden" name="an" value="<%= endlos ? '0' : '1' %>">
          <label class="form-check form-switch mb-1">
            <input class="form-check-input" type="checkbox" <%= endlos ? 'checked' : '' %>
                   onchange="document.getElementById('endlos-form').requestSubmit();">
            <span class="form-check-label"><%= tr('streaming:MUSIK.ENDLOS') %></span>
          </label>
          <div class="form-hint">
            <% if (endlos) { %>
              <%= tr('streaming:MUSIK.ENDLOS_AN') %>
            <% } else { %>
              <%- tr('streaming:MUSIK.ENDLOS_AUS') %>
            <% } %>
          </div>
        </form>

        <%#
          Musik am Streamende (Baustelle 128). Ein Formular für Schalter und
          Nachlauf: Der Schalter schickt sich selbst ab wie „Endlos", der Knopf
          übernimmt den Nachlauf — beide senden beide Felder.
        %>
        <hr class="my-3">
        <form method="post" action="/guild/<%= guildId %>/plugins/streaming/musik/streamende"
              id="streamende-form">
          <label class="form-check form-switch mb-1">
            <input class="form-check-input" type="checkbox" name="an" value="1" <%= streamende.an ? 'checked' : '' %>
                   onchange="document.getElementById('streamende-form').requestSubmit();">
            <span class="form-check-label"><%= tr('streaming:MUSIK.NACH_STREAM') %></span>
          </label>
          <div class="input-group input-group-sm mt-2" style="max-width: 18rem;">
            <span class="input-group-text"><%= tr('streaming:MUSIK.NACHLAUF') %></span>
            <input type="number" class="form-control" name="nachlauf_min"
                   min="<%= nachlaufGrenzen.min %>" max="<%= nachlaufGrenzen.max %>"
                   value="<%= streamende.nachlaufMin %>" aria-label="<%= tr('streaming:MUSIK.NACHLAUF_ARIA') %>">
            <span class="input-group-text"><%= tr('streaming:ANSAGEN.MIN') %></span>
            <button class="btn btn-outline-primary" type="submit"><%= tr('streaming:MUSIK.UEBERNEHMEN') %></button>
          </div>
          <div class="form-hint">
            <% if (streamende.an) { %>
              <%= tr('streaming:MUSIK.ENDE_AN', { n: streamende.nachlaufMin }) %>
            <% } else { %>
              <%= tr('streaming:MUSIK.ENDE_AUS') %>
            <% } %>
          </div>
          <% if (streamendeZuletzt) { %>
            <div class="text-secondary small mt-1"><%= tr('streaming:MUSIK.ZULETZT', { was: streamendeZuletzt }) %></div>
          <% } %>
        </form>
      </div>
    </div>
  </div>

  <%# ---- 3. Warteschlange ---- %>
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fa-solid fa-list-ol me-2"></i><%= tr('streaming:MUSIK.NAECHSTES') %>

          <span class="badge bg-secondary-lt ms-2"><%= offen.length %></span>
        </h3>
      </div>
      <div class="card-body">
        <%#
          Der Einreihen-Knopf steht in BEIDEN Zweigen, oben wie unten: Bei
          leerer Liste ist er die Antwort auf "und jetzt?", bei voller das
          Nachlegen. Ihn nur beim leeren Fall zu zeigen hiesse, dass man die
          Liste nicht verlängern kann, ohne sie vorher leerzuräumen.
        %>
        <form method="post" action="/guild/<%= guildId %>/plugins/streaming/musik/einreihen"
              class="mb-3">
          <button class="btn btn-primary" type="submit"
                  <%= (freigegeben === 0 || !hatAblage) ? 'disabled' : '' %>>
            <i class="fa-solid fa-shuffle me-1"></i>
            <%= tr('streaming:MUSIK.EINREIHEN') %><% if (freigegeben) { %> (<%= freigegeben %>)<% } %>
          </button>
          <div class="form-hint mt-1">
            <%= tr('streaming:MUSIK.EINREIHEN_TEXT') %>
          </div>
        </form>

        <% if (!offen.length) { %>
          <div class="text-secondary"><%= tr('streaming:MUSIK.LEER') %></div>
        <% } else { %>
          <ol class="mb-3 ps-3">
            <% offen.forEach(z => { %>
              <li>
                <%= z.titel %>
                <% if (z.gewuenscht_von) { %>
                  <span class="text-secondary">— <%= z.gewuenscht_von %></span>
                <% } %>
              </li>
            <% }) %>
          </ol>
          <form method="post" action="/guild/<%= guildId %>/plugins/streaming/musik/leeren"
                onsubmit="return confirm(<%= JSON.stringify(tr('streaming:MUSIK.LEEREN_FRAGE')) %>);">
            <button class="btn btn-sm btn-outline-danger" type="submit"><%= tr('streaming:MUSIK.LEEREN') %></button>
          </form>
        <% } %>
      </div>
    </div>
  </div>

  <%# ---- 4. Die Befehle ---- %>
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><i class="fa-solid fa-terminal me-2"></i><%= tr('streaming:MUSIK.BEFEHLE') %></h3>
      </div>
      <div class="card-body">
        <p class="text-secondary">
          <%- tr('streaming:MUSIK.BEFEHLE_TEXT') %>
        </p>
        <div class="table-responsive">
          <table class="table table-sm">
            <thead><tr><th><%= tr('streaming:MUSIK.SP_BEFEHL') %></th><th><%= tr('streaming:MUSIK.SP_TUT') %></th><th><%= tr('streaming:MUSIK.SP_VORGABE') %></th></tr></thead>
            <tbody>
              <tr><td><code>!request &lt;<%= tr('streaming:STATISTIK.TITEL') %>&gt;</code></td><td><%= tr('streaming:MUSIK.T_REQUEST') %></td><td><%= tr('streaming:COMMON.WER_ALLE') %></td></tr>
              <tr><td><code>!song</code></td><td><%= tr('streaming:MUSIK.T_SONG') %></td><td><%= tr('streaming:COMMON.WER_ALLE') %></td></tr>
              <tr><td><code>!playlist</code></td><td><%= tr('streaming:MUSIK.T_PLAYLIST') %></td><td><%= tr('streaming:COMMON.WER_ALLE') %></td></tr>
              <tr><td><code>!vote</code></td><td><%= tr('streaming:MUSIK.T_VOTE', { n: noetigeStimmen }) %></td><td><%= tr('streaming:COMMON.WER_ALLE') %></td></tr>
              <tr><td><code>!skip</code></td><td><%= tr('streaming:MUSIK.T_SKIP') %></td><td><%= tr('streaming:MUSIK.MODERATOR') %></td></tr>
              <tr><td><code>!prev</code></td><td><%= tr('streaming:MUSIK.T_PREV') %></td><td><%= tr('streaming:MUSIK.MODERATOR') %></td></tr>
              <tr><td><code>!pause</code> / <code>!play</code></td><td><%- tr('streaming:MUSIK.T_PAUSE') %></td><td><%= tr('streaming:MUSIK.MODERATOR') %></td></tr>
              <tr><td><code>!stop</code></td><td><%= tr('streaming:MUSIK.T_STOP') %></td><td><%= tr('streaming:MUSIK.MODERATOR') %></td></tr>
              <tr><td><code>!clear</code></td><td><%= tr('streaming:MUSIK.T_CLEAR') %></td><td><%= tr('streaming:MUSIK.MODERATOR') %></td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

</div>

<script>
(function () {
    var knopf = document.getElementById('musik-kopieren');
    var feld = document.getElementById('musik-adresse');
    if (!knopf || !feld) return;

    // Der Schalter ändert nur die angezeigte Adresse. Nichts wird gespeichert:
    // Was die Quelle zeigt, entscheidet die Adresse, die in OBS steht.
    var titelSchalter = document.getElementById('musik-titel-zeigen');
    if (titelSchalter) {
        titelSchalter.addEventListener('change', function () {
            var basis = feld.dataset.basis;
            feld.value = titelSchalter.checked ? basis + '?titel=1' : basis;
        });
    }

    knopf.addEventListener('click', function () {
        // `select()` zuerst: Scheitert die Zwischenablage (kein https, oder
        // der Browser fragt), ist die Adresse wenigstens markiert und mit
        // Strg+C zu holen. Ein Knopf, der nichts tut und nichts sagt, wäre
        // schlimmer als keiner.
        feld.select();
        feld.setSelectionRange(0, 99999);

        var fertig = function (text) {
            knopf.innerHTML = text;
            setTimeout(function () {
                knopf.innerHTML = '<i class="fa-regular fa-copy me-1"></i>' + <%- JSON.stringify(tr('streaming:MUSIK.KOPIEREN')) %>;
            }, 2000);
        };

        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(feld.value)
                .then(function () { fertig(<%- JSON.stringify(tr('streaming:MUSIK.KOPIERT')) %>); })
                .catch(function () { fertig(<%- JSON.stringify(tr('streaming:MUSIK.MARKIERT')) %>); });
        } else {
            fertig(<%- JSON.stringify(tr('streaming:MUSIK.MARKIERT')) %>);
        }
    });
})();
</script>
