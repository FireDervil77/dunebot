<%
/**
 * Die Zeitzone dieser Guild.
 *
 * Sie regelt die Ruhezeiten und sonst nichts - deshalb steht sie auf der
 * Ankuendigungsseite und nicht bei den Rollen.
 *
 * **Bauform seit dem 2026-09-03:** Einstellungszeile statt Formularraster.
 * Beschriftung links, Bedienelement rechts, Hilfssatz darunter. Vorher stand
 * die Erklaerung als eigener Absatz in einer zweiten Spalte — sie las sich wie
 * ein Text ueber die Einstellung, nicht wie eine Hilfe zu ihr.
 */
%>
<div class="zeilen">
  <div class="zeile">
    <div class="zeile__bez">
      Zeitzone
      <small>für Ruhezeiten und Zeitangaben</small>
    </div>
    <div>
      <select class="form-select" id="zeitzone" name="zeitzone" <%= darfEinstellen ? '' : 'disabled' %>>
        <% (zonen || []).forEach(zo => { %>
          <option value="<%= zo %>" <%= zo === zeitzone ? 'selected' : '' %>><%= zo %></option>
        <% }); %>
      </select>
      <div class="zeile__hilfe">
        Es ist dort gerade
        <strong><%= new Date().toLocaleTimeString('de-DE', { timeZone: zeitzone, hour: '2-digit', minute: '2-digit' }) %> Uhr</strong>.
        Ohne diese Angabe gälte die Zeitzone des Servers — und die kennt niemand,
        der „23:00 bis 08:00“ in ein Feld tippt.
      </div>
    </div>
  </div>
</div>
