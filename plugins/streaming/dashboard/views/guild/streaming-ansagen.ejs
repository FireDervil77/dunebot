<%
/**
 * Meine Ansagen (P6) — was der Bot von sich aus in den Chat schreibt.
 *
 * **Die Seite hat zwei Teile, und der erste ist keine Attrappe.** Die
 * Live-Ansage steht schon und wird woanders bedient („Mein Kanal"); hier steht
 * nur der Verweis darauf. Was auf dieser Seite gebaut wird, sind die
 * Timer-Ansagen — die Sorte, die während des Streams wiederkehrt.
 *
 * Erwartet: ansagen, kanaele, GRENZEN, PLATZHALTER, vorWieLange, meldung, fehler
 */
const darfAendern = typeof hasPermission === 'function' && hasPermission('STREAMING.CHAT.MANAGE');

const fehlerTexte = {
  text:        tr('streaming:ANSAGEN.F_TEXT'),
  zu_lang:     tr('streaming:ANSAGEN.F_ZU_LANG'),
  platzhalter: tr('streaming:ANSAGEN.F_PLATZHALTER'),
  nur_discord: tr('streaming:ANSAGEN.F_NUR_DISCORD'),
  intervall:   tr('streaming:ANSAGEN.F_INTERVALL', { min: GRENZEN.intervallMin, max: GRENZEN.intervallMax }),
  zeilen:      tr('streaming:ANSAGEN.F_ZEILEN', { max: GRENZEN.zeilenMax }),
  kanal:       tr('streaming:ANSAGEN.F_KANAL'),
  weg:         tr('streaming:ANSAGEN.F_WEG'),
  technisch:   tr('streaming:ANSAGEN.F_TECHNISCH')
};
const meldungen = {
  neu:         tr('streaming:ANSAGEN.OK_NEU'),
  gespeichert: tr('streaming:ANSAGEN.OK_GESPEICHERT'),
  entfernt:    tr('streaming:ANSAGEN.OK_ENTFERNT')
};
%>

<%- include('partials/streaming-kopf', {
  guildId, tr,
  icon: 'fa-solid fa-clock',
  titel: tr('streaming:ANSAGEN.TITLE'),
  beschreibung: tr('streaming:ANSAGEN.SUBTITLE'),
  aktion: darfAendern
    ? '<button class="btn btn-primary" type="button" data-bs-toggle="collapse" '
      + 'data-bs-target="#ansage-anlegen">' + tr('streaming:ANSAGEN.ANLEGEN_TITEL') + '</button>'
    : ''
}) %>

<% if (meldung && meldungen[meldung]) { %>
  <div class="alert alert-success"><%= meldungen[meldung] %></div>
<% } %>
<% if (fehler) { %>
  <div class="alert alert-danger"><%= fehlerTexte[fehler] || fehlerTexte.technisch %></div>
<% } %>

<div class="row row-cards">

  <%# ── Wann eine Ansage wirklich hinausgeht ──────────────────────────────
      Steht oben, weil es die häufigste Rückfrage beantwortet: „Warum kommt
      nichts?" Vier Bedingungen, und drei davon kann der Streamer sehen. %>
  <div class="col-12">
    <div class="erklaerkarte">
      <h3><%= tr('streaming:ANSAGEN.WANN_TITEL') %></h3>
      <p>
        <%- tr('streaming:ANSAGEN.WANN_1') %>
      </p>
      <p>
        <%- tr('streaming:ANSAGEN.WANN_2') %>
      </p>
    </div>
  </div>

  <%# ── Die Live-Ansage: steht schon, wird woanders bedient ─────────────── %>
  <div class="col-12">
    <div class="card">
      <div class="card-body d-flex flex-wrap align-items-center gap-3">
        <span class="kartensymbol kartensymbol--steht"><i class="fa-solid fa-tower-broadcast"></i></span>
        <div class="flex-fill">
          <strong><%= tr('streaming:ANSAGEN.LIVE_TITEL') %></strong>
          <div class="text-secondary">
            <%= tr('streaming:ANSAGEN.LIVE_TEXT') %>
          </div>
        </div>
        <a class="btn btn-sm" href="/guild/<%= guildId %>/plugins/streaming/chatbot"><%= tr('streaming:NAV.CHATBOT') %></a>
      </div>
    </div>
  </div>

  <%# ── Anlegen ──────────────────────────────────────────────────────────── %>
  <% if (darfAendern) { %>
    <div class="col-12 collapse <%= (ansagen || []).length ? '' : 'show' %>" id="ansage-anlegen">
      <div class="card">
        <div class="card-header">
          <div class="kartenkopf">
            <span class="kartensymbol"><i class="fa-solid fa-plus"></i></span>
            <div class="kartenkopf__text">
              <h3 class="kartenkopf__titel"><%= tr('streaming:ANSAGEN.ANLEGEN_TITEL') %></h3>
              <div class="kartenkopf__satz">
                <%= tr('streaming:ANSAGEN.ANLEGEN_TEXT') %>
              </div>
            </div>
          </div>
        </div>
        <form method="POST" action="/guild/<%= guildId %>/plugins/streaming/ansagen">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <div class="card-body">
            <div class="zeilen">

              <div class="zeile">
                <div class="zeile__bez"><%= tr('streaming:ANSAGEN.TEXT') %></div>
                <div>
                  <textarea class="form-control" name="text" rows="2" required maxlength="500"
                            placeholder="<%= tr('streaming:ANSAGEN.PLATZHALTER_BEISPIEL') %>"></textarea>
                  <%# Aus `PLATZHALTER_CHAT` von `shared/vorlagen.js` — dieselbe
                      Liste, die auch die Live-Ansage prüft. Eine Kopie hier wäre
                      beim nächsten neuen Platzhalter still veraltet. %>
                  <div class="chips mt-2">
                    <% PLATZHALTER.forEach(p => { %>
                      <span class="chip mono" title="<%= tr('streaming:PLATZHALTER.' + p.name.replace(/[{}]/g, ''), { defaultValue: p.bedeutung }) %>"><%= p.name %></span>
                    <% }); %>
                    <%# Die eigenen Bausteine gelten hier genauso wie in Befehlen —
                        also stehen sie auch hier, statt dass man sie sich merkt. %>
                    <% (bausteine || []).forEach(b => { %>
                      <span class="chip mono" title="<%= tr('streaming:BEFEHLE.EIGENER_BAUSTEIN', { wert: b.wert }) %>">{<%= b.name %>}</span>
                    <% }); %>
                  </div>
                  <div class="text-secondary small mt-1">
                    <i class="fa-solid fa-circle-info me-1"></i>
                    <%- tr('streaming:ANSAGEN.EINE_ZEILE') %>
                    <% if (!(bausteine || []).length) { %>
                      <%= tr('streaming:ANSAGEN.BAUSTEINE_VOR') %> <code>{discord}</code> <%= tr('streaming:ANSAGEN.BAUSTEINE_MITTE') %>
                      <a href="/guild/<%= guildId %>/plugins/streaming/befehle"><%= tr('streaming:NAV.COMMANDS') %></a><%= tr('streaming:ANSAGEN.BAUSTEINE_NACH') %>
                    <% } %>
                  </div>
                </div>
              </div>

              <div class="zeile">
                <div class="zeile__bez"><%= tr('streaming:ANSAGEN.ABSTAND') %></div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                  <div class="input-group" style="max-width:10rem">
                    <input type="number" class="form-control" name="intervall_min"
                           min="<%= GRENZEN.intervallMin %>" max="<%= GRENZEN.intervallMax %>"
                           step="1" value="25" required>
                    <span class="input-group-text"><%= tr('streaming:ANSAGEN.MIN') %></span>
                  </div>
                  <span class="text-secondary small">
                    <%= tr('streaming:ANSAGEN.ABSTAND_HILFE', { min: GRENZEN.intervallMin }) %>
                  </span>
                </div>
              </div>

              <div class="zeile">
                <div class="zeile__bez"><%= tr('streaming:ANSAGEN.NUR_WENN') %></div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                  <div class="input-group" style="max-width:10rem">
                    <input type="number" class="form-control" name="mindest_zeilen"
                           min="0" max="<%= GRENZEN.zeilenMax %>" step="1" value="0" required>
                    <span class="input-group-text"><%= tr('streaming:ANSAGEN.ZEILEN') %></span>
                  </div>
                  <span class="text-secondary small">
                    <%- tr('streaming:ANSAGEN.NUR_WENN_HILFE') %>
                  </span>
                </div>
              </div>

            </div>
          </div>
          <div class="card-footer text-end">
            <button type="submit" class="btn btn-primary"><%= tr('streaming:ANSAGEN.ANLEGEN') %></button>
          </div>
        </form>
      </div>
    </div>
  <% } %>

  <%# ── Die Liste ────────────────────────────────────────────────────────── %>
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <div class="kartenkopf">
          <span class="kartensymbol"><i class="fa-solid fa-repeat"></i></span>
          <div class="kartenkopf__text">
            <h3 class="kartenkopf__titel"><%= tr('streaming:ANSAGEN.LISTE_TITEL') %></h3>
            <div class="kartenkopf__satz"><%= tr('streaming:ANSAGEN.LISTE_TEXT') %></div>
          </div>
        </div>
      </div>

      <% if (!(ansagen || []).length) { %>
        <div class="card-body">
          <%- include('shared/leerzustand', {
                icon:  'fa-solid fa-clock',
                titel: tr('streaming:ANSAGEN.LEER_TITEL'),
                text:  tr('streaming:ANSAGEN.LEER_TEXT')
              }) %>
        </div>
      <% } else { %>
        <div class="card-body">
          <div class="zeilen">
            <% ansagen.forEach(a => { %>
              <%# Ein Formular JE ANSAGE — dieselbe Begründung wie bei den
                  Befehlen: Ein gemeinsames schickte beim Speichern der einen
                  die Felder der anderen mit. %>
              <form method="POST" action="/guild/<%= guildId %>/plugins/streaming/ansagen/<%= a.id %>"
                    class="zeile">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <div class="zeile__bez">
                  <span class="chip mono"><%= a.intervall_min %> <%= tr('streaming:ANSAGEN.MIN') %></span>
                  <small>
                    <%= tr('streaming:ANSAGEN.GESENDET', { n: a.gesendet_anzahl }) %><%
                      %><% if (a.zuletzt_am) { %><%= tr('streaming:ANSAGEN.ZULETZT', { wann: vorWieLange(a.zuletzt_am) }) %><% } %>
                  </small>
                </div>
                <div>
                  <textarea class="form-control" name="text" rows="2" maxlength="500"
                            <%= darfAendern ? '' : 'disabled' %>><%= a.text || '' %></textarea>

                  <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                    <div class="input-group input-group-sm" style="max-width:9rem">
                      <input type="number" class="form-control" name="intervall_min"
                             min="<%= GRENZEN.intervallMin %>" max="<%= GRENZEN.intervallMax %>"
                             step="1" value="<%= a.intervall_min %>"
                             <%= darfAendern ? '' : 'disabled' %>>
                      <span class="input-group-text"><%= tr('streaming:ANSAGEN.MIN') %></span>
                    </div>

                    <div class="input-group input-group-sm" style="max-width:10rem">
                      <input type="number" class="form-control" name="mindest_zeilen"
                             min="0" max="<%= GRENZEN.zeilenMax %>" step="1"
                             value="<%= a.mindest_zeilen %>"
                             <%= darfAendern ? '' : 'disabled' %>>
                      <span class="input-group-text"><%= tr('streaming:ANSAGEN.ZEILEN') %></span>
                    </div>

                    <label class="form-check form-switch mb-0">
                      <input type="checkbox" class="form-check-input" name="aktiv" value="1"
                             <%= a.aktiv ? 'checked' : '' %> <%= darfAendern ? '' : 'disabled' %>>
                      <span class="form-check-label"><%= tr('streaming:ANSAGEN.AN') %></span>
                    </label>

                    <% if (darfAendern) { %>
                      <button type="submit" class="btn btn-sm btn-primary ms-auto"><%= tr('streaming:COMMON.SAVE') %></button>
                    <% } %>
                  </div>
                </div>
              </form>

              <% if (darfAendern) { %>
                <form method="POST" class="text-end"
                      action="/guild/<%= guildId %>/plugins/streaming/ansagen/<%= a.id %>/entfernen"
                      onsubmit="return confirm(<%= JSON.stringify(tr('streaming:ANSAGEN.ENTFERNEN_FRAGE')) %>);">
                  <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                  <button type="submit" class="btn btn-sm btn-ghost-danger"><%= tr('streaming:COMMON.DELETE') %></button>
                </form>
              <% } %>
            <% }); %>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>
