<%
/**
 * Gemeinsamer Seitenkopf der Streaming-Seiten.
 *
 * Erwartet: guildId, tr, titel, beschreibung, icon
 * Optional: aktion (HTML rechts im Kopf)
 */
%>
<div class="page-header d-print-none mb-3" data-streaming-basis="/guild/<%= guildId %>/plugins/streaming">
  <div class="row align-items-center">
    <div class="col">
      <div class="page-pretitle"><%= tr('streaming:TITLE') %></div>
      <h2 class="page-title">
        <i class="<%= icon %> me-2"></i>
        <%= titel %>
      </h2>
      <% if (beschreibung) { %>
        <div class="text-secondary mt-1"><%= beschreibung %></div>
      <% } %>
    </div>
    <% if (typeof aktion !== 'undefined' && aktion) { %>
      <div class="col-auto ms-auto d-print-none"><%- aktion %></div>
    <% } %>
  </div>
</div>
