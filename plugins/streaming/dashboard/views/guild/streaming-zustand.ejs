<%- include('partials/streaming-kopf', {
  guildId, tr,
  icon: 'fa-solid fa-heart-pulse',
  titel: tr('streaming:STATE.TITLE'),
  beschreibung: tr('streaming:STATE.SUBTITLE')
}) %>

<%
  const farbe = ampel === 'rot' ? 'red' : (ampel === 'gelb' ? 'yellow' : 'green');
  const text  = ampel === 'rot' ? tr('streaming:STATE.BROKEN')
              : (ampel === 'gelb' ? tr('streaming:STATE.DELAYED') : tr('streaming:STATE.OK'));
  const gehoert = vorWieLange(zustand.letzteMeldungAm);
%>

<div class="row row-cards" id="streaming-zustand"
     data-strom="<%= `/guild/${guildId}/plugins/streaming/zustand/strom` %>"
     data-daten="<%= `/guild/${guildId}/plugins/streaming/zustand/daten` %>">

  <!-- Ampel in einem Satz -->
  <div class="col-12">
    <div class="card">
      <div class="card-body d-flex align-items-center">
        <span class="status-dot status-dot-animated bg-<%= farbe %> me-3" data-feld="ampel"></span>
        <div class="flex-fill">
          <div class="fw-bold" data-feld="ampeltext"><%= text %></div>
          <div class="text-secondary">
            <span data-feld="ueberwacht"><%= zustand.ueberwacht %></span> <%= tr('streaming:STATE.WATCHED') %> ·
            <span data-feld="live"><%= zustand.live %></span> live ·
            <%= tr('streaming:STATE.LAST_EVENT') %>:
            <span data-feld="letzteMeldung"><%= gehoert || tr('streaming:STATE.NEVER') %></span>
          </div>
        </div>

        <!--
          Sagt, ob die Zahlen daneben noch nachgeliefert werden.

          Ohne diese Anzeige ist eine abgerissene Verbindung nicht von
          "es passiert gerade nichts" zu unterscheiden - und genau das war
          der alte Zustand der Seite: Sie stand still und sah dabei aus wie
          frisch geladen.
        -->
        <span class="badge bg-secondary-lt ms-3" data-feld="verbindung"
              title="<%= tr('streaming:STATE.LIVEFEED_HINT') %>">
          <span class="spinner-border spinner-border-sm me-1" role="status"></span><%= tr('streaming:STATE.LIVEFEED_CONNECTING') %>
        </span>
      </div>
    </div>
  </div>

  <!-- Je Streamer eine Zeile -->
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><%= tr('streaming:STREAMERS.TITLE') %></h3>
      </div>
      <% if (!streamer || streamer.length === 0) { %>
        <div class="card-body text-secondary"><%= tr('streaming:STREAMERS.EMPTY') %></div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table card-table table-vcenter">
            <thead>
              <tr>
                <th><%= tr('streaming:STREAMERS.CHANNEL') %></th>
                <th><%= tr('streaming:STREAMERS.STATE') %></th>
                <th><%= tr('streaming:STREAMERS.LAST_HEARD') %></th>
              </tr>
            </thead>
            <tbody>
              <% streamer.forEach(s => { %>
                <tr data-streamer="<%= s.id %>">
                  <td><%= s.anzeigename || s.login %></td>
                  <td data-feld="streamerZustand">
                    <% if (s.abo_zustand === 'widerrufen' || s.abo_zustand === 'fehler') { %>
                      <span class="badge bg-red-lt">⚠ Abo <%= s.abo_zustand %></span>
                    <% } else if (s.ist_live) { %>
                      <span class="badge bg-red">● <%= tr('streaming:STREAMERS.LIVE') %></span>
                    <% } else { %>
                      <span class="text-secondary">○ <%= tr('streaming:STREAMERS.OFFLINE') %></span>
                    <% } %>
                  </td>
                  <td class="text-secondary" data-feld="letztGehoert">
                    <%= vorWieLange(s.letzte_meldung_am) || tr('streaming:STATE.NEVER') %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Was klemmt -->
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><%= tr('streaming:STATE.PROBLEMS') %></h3>
      </div>
      <div class="card-body" data-feld="problemeKasten">
        <% if (!probleme || probleme.length === 0) { %>
          <span class="text-secondary"><%= tr('streaming:STATE.NO_PROBLEMS') %></span>
        <% } else { %>
          <ul class="mb-0">
            <% probleme.forEach(p => { %>
              <li>
                <%= p.text %>
                <div class="text-secondary small">Abhilfe: <%= p.abhilfe %></div>
              </li>
            <% }); %>
          </ul>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script>
/**
 * Die Zustandsseite am Strom halten.
 *
 * Der Server schickt nur ein Klopfen ("etwas hat sich geaendert"), nie Daten.
 * Geholt wird ueber `/zustand/daten` - dieselbe Rechtepruefung wie beim
 * Seitenaufruf. Deshalb steht hier auch kein Markup fuer die Problemliste:
 * Der Server liefert Text und Abhilfe, dieses Skript setzt nur zwei
 * Textknoten. Sonst stuende dasselbe HTML an zwei Stellen und man aendert es
 * beim naechsten Mal nur an einer.
 */
(function () {
    'use strict';

    var wurzel = document.getElementById('streaming-zustand');
    if (!wurzel || typeof EventSource === 'undefined') return;

    var anzeige = wurzel.querySelector('[data-feld="verbindung"]');
    var LEERZEICHEN = ' ';
    var holenLaeuft = false;
    var nochmal = false;

    var TEXTE = {
        live:    <%- JSON.stringify(tr('streaming:STATE.LIVEFEED_ON')) %>,
        weg:     <%- JSON.stringify(tr('streaming:STATE.LIVEFEED_OFF')) %>,
        keine:   <%- JSON.stringify(tr('streaming:STATE.NO_PROBLEMS')) %>,
        istLive: <%- JSON.stringify(tr('streaming:STREAMERS.LIVE')) %>,
        offline: <%- JSON.stringify(tr('streaming:STREAMERS.OFFLINE')) %>
    };

    /**
     * @param {string} art 'an' | 'weg'
     */
    function verbindungZeigen(art) {
        if (!anzeige) return;
        anzeige.className = art === 'an' ? 'badge bg-green-lt ms-3' : 'badge bg-red-lt ms-3';
        anzeige.textContent = art === 'an' ? TEXTE.live : TEXTE.weg;
    }

    /**
     * @param {string} feld Feldname
     * @param {string} wert Text
     */
    function setzen(feld, wert) {
        var knoten = wurzel.querySelector('[data-feld="' + feld + '"]');
        if (knoten && wert !== undefined && wert !== null) knoten.textContent = String(wert);
    }

    /**
     * Den Zustand einer Streamerzeile neu zeichnen.
     *
     * Die Reihenfolge der Zeilen bleibt, wie sie beim Laden war - der Server
     * sortiert Live nach oben, aber eine Zeile unter den Fuessen des Lesers
     * wegzuziehen waere schlimmer als eine Zeile an alter Stelle. Beim
     * naechsten Aufruf sitzt sie richtig.
     *
     * @param {Object} s Streamerangabe
     */
    function zeileSetzen(s) {
        var zeile = wurzel.querySelector('tr[data-streamer="' + s.id + '"]');
        if (!zeile) return;

        var zelle = zeile.querySelector('[data-feld="streamerZustand"]');
        if (zelle) {
            var marke = document.createElement('span');
            if (s.zustand === 'abo_kaputt') {
                marke.className = 'badge bg-red-lt';
                marke.textContent = '⚠ Abo ' + (s.aboZustand || '');
            } else if (s.zustand === 'live') {
                marke.className = 'badge bg-red';
                marke.textContent = '● ' + TEXTE.istLive;
            } else {
                marke.className = 'text-secondary';
                marke.textContent = '○ ' + TEXTE.offline;
            }
            zelle.replaceChildren(marke);
        }

        var wann = zeile.querySelector('[data-feld="letztGehoert"]');
        if (wann) wann.textContent = s.letztGehoert;
    }

    /**
     * @param {Array} liste Probleme
     */
    function problemeSetzen(liste) {
        var kasten = wurzel.querySelector('[data-feld="problemeKasten"]');
        if (!kasten) return;

        if (!liste || liste.length === 0) {
            var ruhig = document.createElement('span');
            ruhig.className = 'text-secondary';
            ruhig.textContent = TEXTE.keine;
            kasten.replaceChildren(ruhig);
            return;
        }

        var ul = document.createElement('ul');
        ul.className = 'mb-0';

        liste.forEach(function (p) {
            var li = document.createElement('li');
            li.appendChild(document.createTextNode(p.text));

            var hilfe = document.createElement('div');
            hilfe.className = 'text-secondary small';
            hilfe.textContent = 'Abhilfe: ' + p.abhilfe;
            li.appendChild(hilfe);

            ul.appendChild(li);
        });

        kasten.replaceChildren(ul);
    }

    /**
     * Stand holen und einsetzen.
     *
     * Laeuft schon einer, wird nur vorgemerkt statt ein zweiter gestartet -
     * sonst ueberholen sich bei einem Schwall zwei Abrufe und der aeltere
     * schreibt zuletzt.
     */
    function holen() {
        if (holenLaeuft) { nochmal = true; return; }
        holenLaeuft = true;

        fetch(wurzel.dataset.daten, { credentials: 'same-origin' })
            .then(function (a) { return a.ok ? a.json() : null; })
            .then(function (d) {
                if (!d || !d.success) return;

                var ampel = wurzel.querySelector('[data-feld="ampel"]');
                if (ampel) {
                    ampel.className = 'status-dot status-dot-animated me-3 bg-' +
                        (d.ampel === 'rot' ? 'red' : (d.ampel === 'gelb' ? 'yellow' : 'green'));
                }

                setzen('ampeltext', d.ampelText);
                setzen('ueberwacht', d.ueberwacht);
                setzen('live', d.live);
                setzen('letzteMeldung', d.letzteMeldung);

                (d.streamer || []).forEach(zeileSetzen);
                problemeSetzen(d.probleme);
            })
            .catch(function () { /* ein verlorener Abruf ist kein Fehler - der naechste Anstupser holt nach */ })
            .then(function () {
                holenLaeuft = false;
                if (nochmal) { nochmal = false; holen(); }
            });
    }

    var strom = new EventSource(wurzel.dataset.strom);

    strom.addEventListener('connected', function () { verbindungZeigen('an'); });
    strom.addEventListener('streaming', function () { holen(); });

    // EventSource verbindet von sich aus neu. Angezeigt wird trotzdem, dass
    // es gerade klemmt - eine Seite, die stillschweigend veraltet, ist
    // schlimmer als eine, die es zugibt.
    strom.onerror = function () { verbindungZeigen('weg'); };
    strom.onopen = function () { verbindungZeigen('an'); holen(); };

    window.addEventListener('beforeunload', function () { strom.close(); });
}());
</script>
