<%
/**
 * Statistik (P7) — Twitchs eigene Listen, bei jedem Aufruf frisch geholt.
 *
 * **Jede Karte trägt ihren eigenen Zustand.** Drei Abfragen, drei Zusagen,
 * drei Arten zu scheitern — ein gemeinsames „hat nicht geklappt" wäre die
 * halbe Auskunft: Der Streamer sähe nicht, dass seine Follower da sind und nur
 * die Bits fehlen.
 *
 * Erwartet: bericht, ZUSTAND, vorWieLange
 */
const zustandsTexte = {
  [ZUSTAND.ABGELEHNT]:  tr('streaming:STATISTIK.F_ABGELEHNT'),
  [ZUSTAND.FEHLER]:     tr('streaming:STATISTIK.F_FEHLER'),
  [ZUSTAND.KEIN_KANAL]: tr('streaming:STATISTIK.F_KEIN_KANAL')
};

/**
 * Eine Karte, deren Inhalt scheitern kann.
 *
 * @param {Object} teil Ein Abschnitt des Berichts
 * @returns {string|null} Der Hinweis, oder null wenn alles ging
 */
const hinweis = (teil) => teil.zustand === ZUSTAND.OK ? null
  : (zustandsTexte[teil.zustand] || zustandsTexte[ZUSTAND.FEHLER]);

const dauer = (von, bis) => {
  if (!von) return null;
  const ms = (bis ? new Date(bis) : new Date()) - new Date(von);
  const min = Math.max(0, Math.floor(ms / 60000));
  const std = Math.floor(min / 60);
  return std ? `${std} h ${min % 60} min` : `${min} min`;
};
%>

<%- include('partials/streaming-kopf', {
  guildId, tr,
  icon: 'fa-solid fa-chart-line',
  titel: tr('streaming:STATISTIK.TITLE'),
  beschreibung: tr('streaming:STATISTIK.SUBTITLE')
}) %>

<div class="row row-cards">

  <%# ── Woher die Zahlen kommen ───────────────────────────────────────────
      Steht oben, weil es die Frage beantwortet, die diese Seite aufwirft:
      „Was wisst ihr über meine Zuschauer?" Antwort: nichts, was wir nicht in
      diesem Augenblick bei Twitch geholt haben. %>
  <div class="col-12">
    <div class="erklaerkarte">
      <h3><%= tr('streaming:STATISTIK.SPEICHERT_TITEL') %></h3>
      <p>
        <%- tr('streaming:STATISTIK.SPEICHERT_1') %>
      </p>
      <p>
        <%- tr('streaming:STATISTIK.SPEICHERT_2') %>
      </p>
    </div>
  </div>

  <%# ── Der letzte Stream ─────────────────────────────────────────────────── %>
  <% if (bericht.letzterStream) { %>
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <div class="kartenkopf">
            <span class="kartensymbol"><i class="fa-solid fa-stopwatch"></i></span>
            <div class="kartenkopf__text">
              <h3 class="kartenkopf__titel">
                <%= tr(bericht.letzterStream.ist_live ? 'streaming:STATISTIK.LAEUFT' : 'streaming:STATISTIK.LETZTER') %>
              </h3>
              <div class="kartenkopf__satz"><%= tr('streaming:STATISTIK.EIGENE_ZEILE') %></div>
            </div>
          </div>
        </div>
        <div class="card-body">
          <div class="zeilen">
            <div class="zeile">
              <div class="zeile__bez"><%= tr('streaming:STATISTIK.TITEL') %></div>
              <div><%= bericht.letzterStream.titel || tr('streaming:STATISTIK.NICHT_GESETZT') %></div>
            </div>
            <div class="zeile">
              <div class="zeile__bez"><%= tr('streaming:STATISTIK.KATEGORIE') %></div>
              <div><%= bericht.letzterStream.kategorie || tr('streaming:STATISTIK.NICHT_GESETZT') %></div>
            </div>
            <div class="zeile">
              <div class="zeile__bez"><%= tr('streaming:STATISTIK.BEGONNEN') %></div>
              <div>
                <% if (bericht.letzterStream.begonnen_am) { %>
                  <%= vorWieLange(bericht.letzterStream.begonnen_am) %>
                  <% const d = dauer(bericht.letzterStream.begonnen_am, bericht.letzterStream.beendet_am); %>
                  <% if (d) { %><small>— <%= d %></small><% } %>
                <% } else { %>—<% } %>
              </div>
            </div>
            <div class="zeile">
              <div class="zeile__bez">
                <%= tr('streaming:STATISTIK.ZUSCHAUER') %>
                <small><%= tr('streaming:STATISTIK.ZUSCHAUER_HILFE') %></small>
              </div>
              <div><%= bericht.letzterStream.zuschauer ?? '—' %></div>
            </div>
          </div>
          <%# Die ehrliche Grenze, an der Stelle wo sie auffällt. %>
          <div class="text-secondary small mt-2">
            <i class="fa-solid fa-circle-info me-1"></i>
            <%- tr('streaming:STATISTIK.EIN_STREAM') %>
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <%# ── Follower ──────────────────────────────────────────────────────────── %>
  <div class="col-12 col-lg-6">
    <div class="card h-100">
      <div class="card-header">
        <div class="kartenkopf">
          <span class="kartensymbol"><i class="fa-solid fa-user-plus"></i></span>
          <div class="kartenkopf__text">
            <h3 class="kartenkopf__titel">
              <%= tr('streaming:STATISTIK.FOLLOWER') %>
              <% if (bericht.folger.zustand === ZUSTAND.OK) { %>
                <span class="chip mono"><%= bericht.folger.gesamt %></span>
              <% } %>
            </h3>
            <div class="kartenkopf__satz"><%= tr('streaming:STATISTIK.FOLLOWER_TEXT') %></div>
          </div>
        </div>
      </div>
      <div class="card-body">
        <% if (hinweis(bericht.folger)) { %>
          <div class="alert alert-warning mb-0"><%= hinweis(bericht.folger) %></div>
        <% } else if (!bericht.folger.liste.length) { %>
          <%- include('shared/leerzustand', {
                icon: 'fa-solid fa-user-plus', titel: tr('streaming:STATISTIK.FOLLOWER_LEER'),
                text: tr('streaming:STATISTIK.FOLLOWER_LEER_TEXT') }) %>
        <% } else { %>
          <div class="zeilen">
            <% bericht.folger.liste.forEach(f => { %>
              <div class="zeile">
                <div class="zeile__bez"><%= f.name %></div>
                <div><%= f.seit ? vorWieLange(f.seit) : '' %></div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <%# ── Abonnenten ────────────────────────────────────────────────────────── %>
  <div class="col-12 col-lg-6">
    <div class="card h-100">
      <div class="card-header">
        <div class="kartenkopf">
          <span class="kartensymbol"><i class="fa-solid fa-star"></i></span>
          <div class="kartenkopf__text">
            <h3 class="kartenkopf__titel">
              <%= tr('streaming:STATISTIK.ABOS') %>
              <% if (bericht.abos.zustand === ZUSTAND.OK) { %>
                <span class="chip mono"><%= bericht.abos.gesamt %></span>
              <% } %>
            </h3>
            <div class="kartenkopf__satz"><%= tr('streaming:STATISTIK.ABOS_TEXT') %></div>
          </div>
        </div>
      </div>
      <div class="card-body">
        <% if (hinweis(bericht.abos)) { %>
          <div class="alert alert-warning mb-0"><%= hinweis(bericht.abos) %></div>
        <% } else if (!bericht.abos.liste.length) { %>
          <%- include('shared/leerzustand', {
                icon: 'fa-solid fa-star', titel: tr('streaming:STATISTIK.ABOS_LEER'),
                text: tr('streaming:STATISTIK.ABOS_LEER_TEXT') }) %>
        <% } else { %>
          <div class="zeilen">
            <% bericht.abos.liste.forEach(a => { %>
              <div class="zeile">
                <div class="zeile__bez"><%= a.kontoName || a.kontoId %></div>
                <div>
                  <% if (a.stufe) { %><span class="chip"><%= tr('streaming:STATISTIK.STUFE', { n: String(a.stufe).replace('000','') }) %></span><% } %>
                  <% if (a.geschenkt) { %><span class="chip"><%= tr('streaming:STATISTIK.GESCHENKT') %></span><% } %>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <%# ── Bits-Rangliste ────────────────────────────────────────────────────── %>
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <div class="kartenkopf">
          <span class="kartensymbol"><i class="fa-solid fa-ranking-star"></i></span>
          <div class="kartenkopf__text">
            <h3 class="kartenkopf__titel"><%= tr('streaming:STATISTIK.BITS_TITEL') %></h3>
            <div class="kartenkopf__satz">
              <%= tr('streaming:STATISTIK.BITS_TEXT') %>
            </div>
          </div>
        </div>
      </div>
      <div class="card-body">
        <% if (hinweis(bericht.bits)) { %>
          <div class="alert alert-warning mb-0"><%= hinweis(bericht.bits) %></div>
        <% } else if (!bericht.bits.plaetze.length) { %>
          <%- include('shared/leerzustand', {
                icon: 'fa-solid fa-ranking-star', titel: tr('streaming:STATISTIK.BITS_LEER'),
                text: tr('streaming:STATISTIK.BITS_LEER_TEXT') }) %>
        <% } else { %>
          <div class="zeilen">
            <% bericht.bits.plaetze.forEach(b => { %>
              <div class="zeile">
                <div class="zeile__bez">
                  <span class="chip mono"><%= b.platz %></span>
                  <%= b.name %>
                </div>
                <div><%= b.punkte.toLocaleString(locals.locale || 'de-DE') %> Bits</div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <%# ── Was hier (noch) nicht steht ───────────────────────────────────────── %>
  <div class="col-12">
    <div class="card">
      <div class="card-body">
        <div class="text-secondary small">
          <%- tr('streaming:STATISTIK.NOCH_NICHT') %>
          <span class="ms-2"><%= tr('streaming:STATISTIK.GEHOLT', { wann: vorWieLange(bericht.geholt_am) }) %></span>
        </div>
      </div>
    </div>
  </div>

</div>
