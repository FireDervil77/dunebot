<%
/**
 * Die Kanalliste — nach dem Entwurf (2026-09-03).
 *
 * ## Was sich gegenueber der alten Fassung geaendert hat
 *
 * **Der Kartenkopf ist weg.** Er trug denselben Titel wie der Seitenkopf drei
 * Zeilen darueber. Zwei Ueberschriften fuer eine Tabelle.
 *
 * **Die Spalte "Ziele" zeigte eine falsche Zahl.** Ein Kanal mit einem Ziel
 * stand dort als "10" — nachgemessen an der laufenden Anlage. Die Ursache lag
 * in `models.js` und ist dort erklaert. Sie ist jetzt berichtigt, aber die
 * Spalte zeigt trotzdem nicht mehr die Zahl, sondern die **Namen** der
 * Discord-Kanaele: "wie viele" beantwortet keine Frage, die jemand vor dieser
 * Liste hat, "wohin" schon.
 *
 * **"Entfernen" steht nicht mehr in der Liste.** Es steht auf der Seite des
 * Kanals, den es entfernt (`streaming-kanal.ejs`) — einen Klick weiter, dafuer
 * an einem Ort, wo man sieht, was man wegwirft. Eine Loeschtaste in jeder
 * Zeile einer Liste ist ein Fehlgriff, der auf Wiederholung wartet.
 *
 * **Keine "steht"-Marke.** Der Entwurf traegt an jeder Seite eine, aber das
 * ist die Legende der ZEICHNUNG — sie sagt dem Betrachter, was davon schon
 * gebaut ist. Im laufenden Panel ist alles Sichtbare gebaut; die Marke haette
 * dort keinen Gegenstand. Die Entwurfsseiten tragen weiter ihre.
 *
 * Erwartet: streamer, anzahl, grenze, zielkanaele, rollen, vorWieLange
 */

/* Anfangsbuchstaben als Ersatzbild — zwei Zeichen, weil drei in 30 Pixeln
   nicht mehr lesbar sind.

   Zusammengesetzte Namen geben ihre Anfaenge her, einfache die ersten zwei
   Buchstaben: "FireDervil" -> FD, "Kaffeepause" -> KA. Bloss `slice(0,2)`
   haette "FI" ergeben, und damit saehen alle Kanaele eines Streamers, dessen
   Name so anfaengt, gleich aus. */
const anfang = (name) => {
  const roh   = String(name || '?').trim();
  const teile = roh.split(/[\s_.·-]+|(?=[A-Z][a-z])/).filter(Boolean);
  const kurz  = teile.length > 1
      ? teile.slice(0, 2).map(t => t[0]).join('')
      : roh.replace(/[^\p{L}\p{N}]/gu, '').slice(0, 2);
  return (kurz || '?').toUpperCase();
};

/* Kanal-IDs -> Namen. `ziel_kanaele` kommt als Liste aus der Abfrage; ein Ziel
   kann auf einen Discord-Kanal zeigen, den es nicht mehr gibt — dann steht da
   die nackte ID, und genau das soll man sehen. */
const kanalNamen = new Map((zielkanaele || []).map(k => [String(k.id), k.name]));
const zieleVon = (zeile) => String(zeile.ziel_kanaele || '')
      .split(',').map(s => s.trim()).filter(Boolean);
%>

<%- include('partials/streaming-kopf', {
  guildId, tr,
  icon: 'fa-solid fa-video',
  titel: tr('streaming:STREAMERS.TITLE'),
  beschreibung: tr('streaming:STREAMERS.SUBTITLE'),
  // **Das Eintragen ist ein Knopf, kein Dauerformular** (2026-09-03).
  //
  // Es stand aufgeklappt ueber der Liste und nahm die halbe Seite: drei
  // Felder, ein Schalter und vier Absaetze Erklaerung — jedes Mal, auch wenn
  // man nur nachsehen wollte, was eingetragen ist. Die Liste ist der Inhalt
  // dieser Seite; das Eintragen ist eine Handlung, die man selten braucht.
  aktion: '<button class="btn btn-primary" type="button" data-bs-toggle="collapse" '
        + 'data-bs-target="#kanal-eintragen">Kanal eintragen</button>'
}) %>

<%
  const meldungen = {
    neu:      'Kanal eingetragen. Sobald er live geht, kommt die Ankündigung.',
    geteilt:  'Kanal eingetragen. Er wird bereits überwacht — dein Ziel kam dazu, ein zweites Abonnement war nicht nötig.',
    entfernt: 'Kanal entfernt.'
  };
  const fehlerTexte = {
    kanal_fehlt: 'Bitte einen Kanalnamen eingeben.',
    ziel_fehlt:  'Bitte einen Kanal für die Ankündigung wählen.',
    unbekannt:   'Diesen Kanal gibt es bei Twitch nicht.',
    grenze:      'Die Obergrenze dieses Servers ist erreicht.',
    abo:         'Eingetragen, aber das Abonnement bei Twitch wurde abgelehnt — Einzelheiten unter Zustand.',
    technisch:   'Das hat technisch nicht geklappt. Der Grund steht im Protokoll.'
  };
%>

<% if (meldung && meldungen[meldung]) { %>
  <div class="alert alert-success"><%= meldungen[meldung] %></div>
<% } %>
<% if (fehler && fehlerTexte[fehler]) { %>
  <div class="alert alert-danger"><%= fehlerTexte[fehler] %></div>
<% } %>

<div class="row row-cards">
  <%# Zugeklappt, solange schon Kanaele da sind: Wer noch keinen hat, soll das
      Formular sehen, ohne es zu suchen. %>
  <div class="col-12 collapse <%= (streamer || []).length ? '' : 'show' %>" id="kanal-eintragen">
    <div class="card">
      <div class="card-header">
        <div class="kartenkopf">
          <span class="kartensymbol"><i class="fa-solid fa-plus"></i></span>
          <div class="kartenkopf__text">
            <h3 class="kartenkopf__titel"><%= tr('streaming:STREAMERS.ADD') %></h3>
          </div>
        </div>
      </div>
      <form method="POST" action="/guild/<%= guildId %>/plugins/streaming/streamer">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <div class="card-body">
          <div class="row g-3">
            <div class="col-md-4">
              <label for="kanal" class="form-label">Twitch-Kanal</label>
              <input type="text" class="form-control" id="kanal" name="kanal"
                     placeholder="ninja  oder  twitch.tv/ninja" autocomplete="off" required
                     <%= anzahl >= grenze ? 'disabled' : '' %>>
              <div class="form-hint">
                Der Name aus der <strong>Adresszeile</strong>, nicht der Anzeigename
                aus dem Profil.
              </div>
            </div>
            <div class="col-md-4">
              <label for="channel_id" class="form-label"><%= tr('streaming:TARGETS.CHANNEL') %></label>
              <select class="form-select" id="channel_id" name="channel_id" required
                      <%= anzahl >= grenze ? 'disabled' : '' %>>
                <option value="">—</option>
                <%
                  const ankuendigung = (zielkanaele || []).filter(k => k.istAnkuendigung);
                  const normal = (zielkanaele || []).filter(k => !k.istAnkuendigung);
                %>
                <% if (ankuendigung.length) { %>
                  <optgroup label="Ankündigungskanäle">
                    <% ankuendigung.forEach(k => { %>
                      <option value="<%= k.id %>" data-ankuendigung="1">📢 <%= k.name %></option>
                    <% }); %>
                  </optgroup>
                <% } %>
                <optgroup label="Textkanäle">
                  <% normal.forEach(k => { %>
                    <option value="<%= k.id %>"># <%= k.name %></option>
                  <% }); %>
                </optgroup>
              </select>
            </div>
            <div class="col-md-4">
              <label for="rolle_id" class="form-label"><%= tr('streaming:TARGETS.ROLE') %></label>
              <select class="form-select" id="rolle_id" name="rolle_id"
                      <%= anzahl >= grenze ? 'disabled' : '' %>>
                <option value="">— keine —</option>
                <% (rollen || []).forEach(r => { %>
                  <option value="<%= r.id %>">@<%= r.name %></option>
                <% }); %>
              </select>
              <div class="form-hint">
                Alle mit dieser Rolle bekommen eine Benachrichtigung. Ohne
                Auswahl kommt die Ankündigung ohne Ping.
              </div>
            </div>
          </div>
          <div class="mt-3">
            <label class="form-check form-switch">
              <input type="checkbox" class="form-check-input" name="veroeffentlichen" value="1"
                     <%= anzahl >= grenze ? 'disabled' : '' %>>
              <span class="form-check-label"><%= tr('streaming:TARGETS.PUBLISH') %></span>
            </label>
            <div class="form-hint">
              Wirkt nur in <strong>Ankündigungskanälen</strong> (📢): Die Nachricht
              erscheint dann auch auf Servern, die diesem Kanal folgen.
            </div>
          </div>

          <% if (anzahl >= grenze) { %>
            <div class="text-secondary small mt-3">
              Obergrenze erreicht (<%= grenze %>). Gezählt werden eigene Kanäle —
              ein Kanal, den andere Server schon beobachten, zählt trotzdem einmal
              für diesen Server.
            </div>
          <% } %>
        </div>
        <div class="card-footer text-end">
          <button type="submit" class="btn btn-primary" <%= anzahl >= grenze ? 'disabled' : '' %>>
            <%= tr('streaming:STREAMERS.ADD') %>
          </button>
        </div>
      </form>
    </div>
  </div>

  <div class="col-12">
    <div class="card">
      <% if (!streamer || streamer.length === 0) { %>
        <div class="card-body">
          <%- include('shared/leerzustand', {
                icon:  'fa-solid fa-video',
                titel: tr('streaming:STREAMERS.EMPTY'),
                text:  tr('streaming:STREAMERS.EMPTY_HINT')
              }) %>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table card-table table-vcenter">
            <thead>
              <tr>
                <th><%= tr('streaming:STREAMERS.CHANNEL') %></th>
                <th><%= tr('streaming:STREAMERS.STATE') %></th>
                <th><%= tr('streaming:STREAMERS.TARGETS') %></th>
                <th><%= tr('streaming:STREAMERS.LAST_HEARD') %></th>
                <th class="w-1"></th>
              </tr>
            </thead>
            <tbody>
              <% streamer.forEach(s => { %>
                <tr>
                  <td>
                    <div class="kanalzeile">
                      <% if (s.avatar_url) { %>
                        <img class="kanalzeile__av" src="<%= s.avatar_url %>" alt="" width="30" height="30">
                      <% } else { %>
                        <span class="kanalzeile__av"><%= anfang(s.anzeigename || s.login) %></span>
                      <% } %>
                      <div>
                        <div class="kanalzeile__name"><%= s.anzeigename || s.login %></div>
                        <div class="kanalzeile__login"><%= s.login %></div>
                      </div>
                    </div>
                  </td>
                  <td>
                    <%# Eine Stoerung am Abo bleibt eine Plakette — sie ist kein
                        Zustand, der sich von selbst wieder aendert, und muss in
                        einer Liste aus zwanzig Zeilen auffallen. %>
                    <% if (s.abo_zustand === 'widerrufen' || s.abo_zustand === 'fehler') { %>
                      <span class="zustandsmarke zustandsmarke--stoerung">Abo <%= s.abo_zustand %></span>
                    <% } else if (s.ist_live) { %>
                      <span class="livemarke"><%= tr('streaming:STREAMERS.LIVE') %></span>
                    <% } else if (s.ist_live === 0) { %>
                      <span class="stillmarke"><%= tr('streaming:STREAMERS.OFFLINE') %></span>
                    <% } else { %>
                      <span class="stillmarke">—</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="chips">
                      <% zieleVon(s).forEach(id => { %>
                        <% if (kanalNamen.has(id)) { %>
                          <span class="chip">#<%= kanalNamen.get(id) %></span>
                        <% } else { %>
                          <%# Der Discord-Kanal ist weg oder der Bot darf ihn nicht
                              mehr sehen. Die ID stehenzulassen ist die ehrlichere
                              Auskunft als ein stiller Leerplatz. %>
                          <span class="chip chip--still" title="Dieser Discord-Kanal ist nicht mehr erreichbar">
                            unbekannt
                          </span>
                        <% } %>
                      <% }); %>
                    </div>
                  </td>
                  <td>
                    <span class="zeitangabe">
                      <%= vorWieLange(s.letzte_meldung_am) || tr('streaming:STATE.NEVER') %>
                    </span>
                  </td>
                  <td class="text-end">
                    <%# **Fuehrt seit P4 auf die Seite DIESES Kanals**, nicht
                        mehr auf `/ankuendigung#ziel-…`. Der Sprunganker war der
                        Notbehelf, solange alle Kanaele untereinander auf einer
                        Seite standen: Er landete mitten in einer Liste, in der
                        auch alle anderen Ziele stehen. %>
                    <a class="btn btn-sm"
                       href="/guild/<%= guildId %>/plugins/streaming/streamer/<%= s.id %>"
                       title="Ankündigung, Ereignisse, Rollen und Aufräumart dieses Kanals">
                      Einrichten
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <%# Die Mengengrenze steht unten und leise. Sie ist eine Schranke, kein
            Inhalt — aber wer sie erreicht, soll nicht raten muessen, warum das
            Formular nichts mehr annimmt. %>
        <div class="card-footer text-secondary small">
          <%= anzahl %> von <%= grenze %> Kanälen
        </div>
      <% } %>
    </div>
  </div>
</div>
