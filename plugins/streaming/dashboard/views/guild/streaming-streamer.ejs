<%- include('partials/streaming-kopf', {
  guildId, tr,
  icon: 'fa-solid fa-video',
  titel: tr('streaming:STREAMERS.TITLE'),
  beschreibung: tr('streaming:STREAMERS.SUBTITLE')
}) %>

<%
  const meldungen = {
    neu:      'Kanal eingetragen. Sobald er live geht, kommt die Ankuendigung.',
    geteilt:  'Kanal eingetragen. Er wird bereits ueberwacht — dein Ziel kam dazu, ein zweites Abonnement war nicht noetig.',
    entfernt: 'Kanal entfernt.'
  };
  const fehlerTexte = {
    kanal_fehlt: 'Bitte einen Kanalnamen eingeben.',
    ziel_fehlt:  'Bitte einen Kanal fuer die Ankuendigung waehlen.',
    unbekannt:   'Diesen Kanal gibt es bei Twitch nicht.',
    grenze:      'Die Obergrenze dieses Servers ist erreicht.',
    abo:         'Eingetragen, aber das Abonnement bei Twitch wurde abgelehnt — Einzelheiten unter Zustand.',
    technisch:   'Das hat technisch nicht geklappt. Der Grund steht im Protokoll.'
  };
%>

<% if (meldung && meldungen[meldung]) { %>
  <div class="alert alert-success"><%= meldungen[meldung] %></div>
<% } %>
<% if (fehler && fehlerTexte[fehler]) { %>
  <div class="alert alert-danger"><%= fehlerTexte[fehler] %></div>
<% } %>

<div class="row row-cards">
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><%= tr('streaming:STREAMERS.ADD') %></h3>
      </div>
      <form method="POST" action="/guild/<%= guildId %>/plugins/streaming/streamer">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <div class="card-body">
          <div class="row g-3">
            <div class="col-md-4">
              <label for="kanal" class="form-label">Twitch-Kanal</label>
              <input type="text" class="form-control" id="kanal" name="kanal"
                     placeholder="z. B. ninja" autocomplete="off" required
                     <%= anzahl >= grenze ? 'disabled' : '' %>>
              <div class="form-hint">Name oder Adresse. Der Streamer erfaehrt davon nichts.</div>
            </div>
            <div class="col-md-4">
              <label for="channel_id" class="form-label"><%= tr('streaming:TARGETS.CHANNEL') %></label>
              <select class="form-select" id="channel_id" name="channel_id" required
                      <%= anzahl >= grenze ? 'disabled' : '' %>>
                <option value="">—</option>
                <% (textkanaele || []).forEach(k => { %>
                  <option value="<%= k.id %>"># <%= k.name %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-4">
              <label for="rolle_id" class="form-label"><%= tr('streaming:TARGETS.ROLE') %></label>
              <select class="form-select" id="rolle_id" name="rolle_id"
                      <%= anzahl >= grenze ? 'disabled' : '' %>>
                <option value="">— keine —</option>
                <% (rollen || []).forEach(r => { %>
                  <option value="<%= r.id %>">@<%= r.name %></option>
                <% }); %>
              </select>
            </div>
          </div>
          <% if (anzahl >= grenze) { %>
            <div class="text-secondary small mt-3">
              Obergrenze erreicht (<%= grenze %>). Gezaehlt werden eigene Kanaele —
              ein Kanal, den andere Server schon beobachten, zaehlt trotzdem einmal
              fuer diesen Server.
            </div>
          <% } %>
        </div>
        <div class="card-footer text-end">
          <button type="submit" class="btn btn-primary" <%= anzahl >= grenze ? 'disabled' : '' %>>
            <%= tr('streaming:STREAMERS.ADD') %>
          </button>
        </div>
      </form>
    </div>
  </div>

  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><%= tr('streaming:STREAMERS.TITLE') %></h3>
        <div class="card-actions text-secondary">
          <%= anzahl %> / <%= grenze %>
        </div>
      </div>

      <% if (!streamer || streamer.length === 0) { %>
        <div class="card-body">
          <p class="text-secondary mb-1"><%= tr('streaming:STREAMERS.EMPTY') %></p>
          <p class="text-secondary small mb-0"><%= tr('streaming:STREAMERS.EMPTY_HINT') %></p>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table card-table table-vcenter">
            <thead>
              <tr>
                <th><%= tr('streaming:STREAMERS.CHANNEL') %></th>
                <th><%= tr('streaming:STREAMERS.PLATFORM') %></th>
                <th><%= tr('streaming:STREAMERS.STATE') %></th>
                <th><%= tr('streaming:STREAMERS.TARGETS') %></th>
                <th><%= tr('streaming:STREAMERS.LAST_HEARD') %></th>
                <th class="w-1"></th>
              </tr>
            </thead>
            <tbody>
              <% streamer.forEach(s => { %>
                <tr>
                  <td>
                    <span class="fw-bold"><%= s.anzeigename || s.login %></span>
                    <% if (s.titel) { %>
                      <div class="text-secondary small"><%= s.titel %></div>
                    <% } %>
                  </td>
                  <td><%= s.plattform %></td>
                  <td>
                    <% if (s.abo_zustand === 'widerrufen' || s.abo_zustand === 'fehler') { %>
                      <span class="badge bg-red-lt">Abo <%= s.abo_zustand %></span>
                    <% } else if (s.ist_live) { %>
                      <span class="badge bg-red">● <%= tr('streaming:STREAMERS.LIVE') %></span>
                    <% } else if (s.ist_live === 0) { %>
                      <span class="badge bg-secondary-lt"><%= tr('streaming:STREAMERS.OFFLINE') %></span>
                    <% } else { %>
                      <span class="text-secondary">—</span>
                    <% } %>
                  </td>
                  <td><%= s.ziele %></td>
                  <td class="text-secondary">
                    <%= vorWieLange(s.letzte_meldung_am) || tr('streaming:STATE.NEVER') %>
                  </td>
                  <td>
                    <form method="POST"
                          action="/guild/<%= guildId %>/plugins/streaming/streamer/<%= s.id %>/entfernen"
                          onsubmit="return confirm('<%= (s.anzeigename || s.login) %> nicht mehr beobachten?');">
                      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                      <button type="submit" class="btn btn-sm btn-ghost-danger">
                        <%= tr('streaming:COMMON.DELETE') %>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>
