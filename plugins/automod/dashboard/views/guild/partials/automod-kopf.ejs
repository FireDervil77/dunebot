<%
/**
 * Seitenkopf der automod-Seiten.
 *
 * **Nur noch eine Weiche.** Das Markup steht seit dem 2026-08-29 einmal im
 * Kern (`views/shared/seitenkopf.ejs`, Baustelle 83) — vorher trug jedes
 * Plugin seine eigene Kopie, und die sieben waren bereits
 * auseinandergelaufen.
 *
 * **Die Meldungstexte bleiben hier.** Sie gehoeren diesem Plugin; im Kern
 * waeren sie der Anfang eines Sammelbeckens.
 *
 * Erwartet: guildId, tr, titel, beschreibung, icon
 * Optional:  bedingungen (Bedingungstypen der Kombinations-Regeln)
 */
const jsTexte = {
  FEHLER:                    tr('automod:JS.FEHLER'),
  AUSWAHL_FEHLT:             tr('automod:JS.AUSWAHL_FEHLT'),
  AUSNAHME_ANGELEGT:         tr('automod:JS.AUSNAHME_ANGELEGT'),
  AUSNAHME_ENTFERNT:         tr('automod:JS.AUSNAHME_ENTFERNT'),
  AUSNAHME_LOESCHEN:         tr('automod:JS.AUSNAHME_LOESCHEN'),
  REGEX_UNVOLLSTAENDIG:      tr('automod:JS.REGEX_UNVOLLSTAENDIG'),
  REGEL_ANGELEGT:            tr('automod:JS.REGEL_ANGELEGT'),
  REGEL_AKTIV:               tr('automod:JS.REGEL_AKTIV'),
  REGEL_INAKTIV:             tr('automod:JS.REGEL_INAKTIV'),
  REGEL_LOESCHEN:            tr('automod:JS.REGEL_LOESCHEN'),
  REGEL_GELOESCHT:           tr('automod:JS.REGEL_GELOESCHT'),
  SCHWELLE_UNGUELTIG:        tr('automod:JS.SCHWELLE_UNGUELTIG'),
  STUFE_ANGELEGT:            tr('automod:JS.STUFE_ANGELEGT'),
  STUFE_LOESCHEN:            tr('automod:JS.STUFE_LOESCHEN'),
  STUFE_GELOESCHT:           tr('automod:JS.STUFE_GELOESCHT'),
  STANDARD_ESKALATION:       tr('automod:JS.STANDARD_ESKALATION'),
  STANDARD_ANGELEGT:         tr('automod:JS.STANDARD_ANGELEGT'),
  KOMBI_UNVOLLSTAENDIG:      tr('automod:JS.KOMBI_UNVOLLSTAENDIG'),
  KOMBI_LOESCHEN:            tr('automod:JS.KOMBI_LOESCHEN'),
  STRIKES_ZURUECKSETZEN_FRAGE: tr('automod:JS.STRIKES_ZURUECKSETZEN_FRAGE'),
  STRIKES_ZURUECKGESETZT:    tr('automod:JS.STRIKES_ZURUECKGESETZT'),
  AUFRAEUMEN_FRAGE:          tr('automod:JS.AUFRAEUMEN_FRAGE'),
  AUFGERAEUMT:               tr('automod:JS.AUFGERAEUMT')
};
%>
<%- include('shared/seitenkopf', {
      plugin:       'automod',
      vortitel:     tr('automod:TITLE'),
      titel:        titel,
      beschreibung: (typeof beschreibung !== 'undefined' ? beschreibung : null),
      icon:         icon,
      guildId:      guildId,
      texte:        jsTexte,
      daten:        (typeof bedingungen !== 'undefined' && bedingungen)
                      ? { bedingungen } : {}
}) %>
