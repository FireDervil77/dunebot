<%- include('partials/automod-kopf', {
  guildId, tr,
  icon: 'fa-solid fa-user-check',
  titel: tr('automod:NAV.EXEMPTIONS'),
  beschreibung: tr('automod:EXEMPTIONS.SUBTITLE')
}) %>

<%
  const rollenAusnahmen  = (exemptions || []).filter(e => e.type === 'role');
  const channelAusnahmen = (exemptions || []).filter(e => e.type === 'channel');

  //
  // Seit dem 2026-08-09 stehen hier nicht mehr nur Textkanaele: der Chat eines
  // Sprachkanals wird von AutoMod ebenso moderiert und muss sich ausnehmen
  // lassen. Ein Sprachkanal mit Raute davor waere aber irrefuehrend, deshalb
  // bekommt jeder Typ sein eigenes Zeichen.
  //
  const kanalZeichen = {
    text:         '#',
    voice:        '🔊',
    announcement: '📢',
    stage:        '🎤',
    forum:        '💬',
    media:        '🖼'
  };
  const zeichen = (kanal) => kanalZeichen[kanal.typeName] || '#';

%>

<div class="row row-cards">
  <!-- Ausgenommene Rollen -->
  <div class="col-lg-6">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fa-solid fa-user-shield me-2"></i>
          <%= tr('automod:EXEMPTIONS.ROLES_TITLE') %>
        </h3>
      </div>
      <div class="card-body">
        <p class="text-secondary"><%= tr('automod:EXEMPTIONS.ROLES_DESC') %></p>

        <div id="exemptions-roles-list" class="mb-3">
          <% if (rollenAusnahmen.length === 0) { %>
            <p class="text-secondary small mb-0" id="no-role-exemptions">
              <%= tr('automod:EXEMPTIONS.ROLES_EMPTY') %>
            </p>
          <% } else { %>
            <% rollenAusnahmen.forEach(ausnahme => {
                 const rolle = (guildRoles || []).find(r => String(r.id) === String(ausnahme.target_id));
            %>
              <span class="badge bg-secondary-lt me-1 mb-1" data-exemption-id="<%= ausnahme.id %>">
                <i class="fa-solid fa-user-tag me-1"></i>
                <%= rolle ? rolle.name : ausnahme.target_id %>
                <button type="button" class="btn-close ms-2"
                        style="font-size: .6rem;"
                        aria-label="<%= tr('automod:RULES.DELETE') %>"
                        onclick="deleteExemption(<%= ausnahme.id %>)"></button>
              </span>
            <% }); %>
          <% } %>
        </div>

        <div class="input-group">
          <select class="form-select" id="add-role-exemption">
            <option value=""><%= tr('automod:EXEMPTIONS.PICK_ROLE') %></option>
            <% (guildRoles || []).forEach(rolle => { %>
              <option value="<%= rolle.id %>"><%= rolle.name %></option>
            <% }); %>
          </select>
          <button type="button" class="btn btn-success"
                  onclick="addExemption('role', document.getElementById('add-role-exemption').value)">
            <i class="fa-solid fa-plus"></i>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Ausgenommene Channels -->
  <div class="col-lg-6">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fa-solid fa-hashtag me-2"></i>
          <%= tr('automod:EXEMPTIONS.CHANNELS_TITLE') %>
        </h3>
      </div>
      <div class="card-body">
        <p class="text-secondary"><%= tr('automod:EXEMPTIONS.CHANNELS_DESC') %></p>

        <div id="exemptions-channels-list" class="mb-3">
          <% if (channelAusnahmen.length === 0) { %>
            <p class="text-secondary small mb-0" id="no-channel-exemptions">
              <%= tr('automod:EXEMPTIONS.CHANNELS_EMPTY') %>
            </p>
          <% } else { %>
            <% channelAusnahmen.forEach(ausnahme => {
                 const channel = (guildChannels || []).find(c => String(c.id) === String(ausnahme.target_id));
            %>
              <span class="badge bg-blue-lt me-1 mb-1" data-exemption-id="<%= ausnahme.id %>">
                <i class="fa-solid fa-hashtag me-1"></i>
                <%= channel ? channel.name : ausnahme.target_id %>
                <button type="button" class="btn-close ms-2"
                        style="font-size: .6rem;"
                        aria-label="<%= tr('automod:RULES.DELETE') %>"
                        onclick="deleteExemption(<%= ausnahme.id %>)"></button>
              </span>
            <% }); %>
          <% } %>
        </div>

        <div class="input-group">
          <select class="form-select" id="add-channel-exemption">
            <option value=""><%= tr('automod:EXEMPTIONS.PICK_CHANNEL') %></option>
            <% (guildChannels || []).forEach(channel => { %>
              <option value="<%= channel.id %>"><%= zeichen(channel) %> <%= channel.name %></option>
            <% }); %>
          </select>
          <button type="button" class="btn btn-success"
                  onclick="addExemption('channel', document.getElementById('add-channel-exemption').value)">
            <i class="fa-solid fa-plus"></i>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<%#
  Hier stand bis zum 2026-08-09 eine zweite Karte: die "Whitelist der Channels"
  aus `automod_settings.whitelisted_channels`. Sie tat fuer Kanaele exakt
  dasselbe wie die Ausnahmen darueber - zwei Wege auf derselben Seite, ohne
  einen Hinweis, welcher der richtige ist.

  Der Inhalt ist in `automod_exemptions` uebernommen, die Spalte ist weg.
  Kanalausnahmen stehen jetzt an genau einer Stelle: oben.
%>
