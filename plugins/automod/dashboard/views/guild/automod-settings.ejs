<%- include('partials/automod-kopf', {
  guildId, tr,
  icon: 'fa-solid fa-shield-halved',
  titel: tr('automod:SETTINGS.PAGE_TITLE'),
  beschreibung: tr('automod:SETTINGS.SUBTITLE')
}) %>

<% const basis = `/guild/${guildId}/plugins/automod`; %>

<form class="guild-ajax-form"
      data-automod-form
      data-form-type="automod-settings"
      data-method="PUT"
      action="<%= basis %>/settings"
      method="POST">

  <div class="row row-cards">
    <div class="col-lg-7">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">
            <i class="fa-solid fa-gear me-2"></i>
            <%= tr('automod:TABS.BASIC.TITLE') %>
          </h3>
        </div>
        <div class="card-body">
          <!-- Protokoll-Kanal -->
          <div class="mb-3">
            <label for="log_channel" class="form-label"><%= tr('automod:SETTINGS.LOG_CHANNEL.LABEL') %></label>
            <% if (guildChannels && guildChannels.length > 0) { %>
              <select class="form-select" id="log_channel" name="log_channel">
                <option value=""><%= tr('automod:SETTINGS.LOG_CHANNEL.NO_SELECTION') %></option>
                <%
                  let kategorie = null;
                  const gewaehlt = String(settings.log_channel || '');
                  guildChannels.forEach(channel => {
                    if (channel.parentName && channel.parentName !== kategorie) {
                      kategorie = channel.parentName;
                %>
                  <option disabled>── <%= kategorie %> ──</option>
                <%  } %>
                  <option value="<%= channel.id %>" <%= gewaehlt === String(channel.id) ? 'selected' : '' %>>
                    <%= channel.parentName ? '   ' : '' %>#<%= channel.name %>
                  </option>
                <% }); %>
              </select>
            <% } else { %>
              <input type="text" class="form-control" id="log_channel" name="log_channel"
                     value="<%= settings.log_channel || '' %>"
                     placeholder="<%= tr('automod:SETTINGS.LOG_CHANNEL.ID_PLACEHOLDER') %>">
            <% } %>
            <div class="form-hint"><%= tr('automod:SETTINGS.LOG_CHANNEL.HELP') %></div>
          </div>

          <!-- Strikes bis zur Aktion -->
          <div class="mb-3">
            <label for="max_strikes" class="form-label"><%= tr('automod:SETTINGS.MAX_STRIKES.LABEL') %></label>
            <input type="number" class="form-control" id="max_strikes" name="max_strikes"
                   value="<%= settings.max_strikes || 10 %>" min="1" max="100" required>
            <div class="form-hint"><%= tr('automod:SETTINGS.MAX_STRIKES.HELP') %></div>
          </div>

          <!-- Aktion -->
          <div class="mb-3">
            <label for="action" class="form-label"><%= tr('automod:SETTINGS.ACTION.LABEL') %></label>
            <select class="form-select" id="action" name="action" required>
              <option value="TIMEOUT" <%= settings.action === 'TIMEOUT' ? 'selected' : '' %>>
                <%= tr('automod:SETTINGS.ACTION.TIMEOUT') %>
              </option>
              <option value="KICK" <%= settings.action === 'KICK' ? 'selected' : '' %>>
                <%= tr('automod:SETTINGS.ACTION.KICK') %>
              </option>
              <option value="BAN" <%= settings.action === 'BAN' ? 'selected' : '' %>>
                <%= tr('automod:SETTINGS.ACTION.BAN') %>
              </option>
            </select>
            <div class="form-hint"><%= tr('automod:SETTINGS.ACTION.HELP') %></div>
          </div>

          <!-- Nachricht an das Mitglied -->
          <div class="mb-3">
            <label for="dm_message" class="form-label"><%= tr('automod:SETTINGS.DM_MESSAGE.LABEL') %></label>
            <textarea class="form-control" id="dm_message" name="dm_message" rows="3"
                      placeholder="<%= tr('automod:SETTINGS.DM_MESSAGE.PLACEHOLDER') %>"><%= settings.dm_message || '' %></textarea>
            <div class="form-hint">
              <%= tr('automod:SETTINGS.DM_MESSAGE.HELP') %><br>
              <%= tr('automod:SETTINGS.DM_MESSAGE.VARIABLES') %>:
              <code>{member:name}</code>
              <code>{guild:name}</code>
              <code>{strikes}</code>
              <code>{total_strikes}</code>
              <code>{max_strikes}</code>
            </div>
          </div>

          <!-- Fehlersuche -->
          <label class="form-check form-switch mb-1">
            <input class="form-check-input" type="checkbox" id="debug_mode" name="debug_mode" value="1"
                   <%= settings.debug_mode ? 'checked' : '' %>>
            <span class="form-check-label"><%= tr('automod:SETTINGS.DEBUG_MODE.LABEL') %></span>
          </label>
          <div class="text-secondary small mb-0"><%= tr('automod:SETTINGS.DEBUG_MODE.HELP') %></div>
        </div>
        <div class="card-footer">
          <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-floppy-disk me-2"></i>
            <%= tr('automod:SETTINGS.SAVE_BUTTON') %>
          </button>
        </div>
      </div>
    </div>

    <!-- Wegweiser in den eigenen Bereich -->
    <div class="col-lg-5">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title"><%= tr('automod:SETTINGS.MORE_TITLE') %></h3>
        </div>
        <div class="card-body">
          <p class="text-secondary"><%= tr('automod:SETTINGS.MORE_DESC') %></p>
        </div>
        <div class="list-group list-group-flush">
          <%
            const bereiche = [
              ['/filter',     'fa-solid fa-filter',        'automod:NAV.FILTER',     'automod:FILTER.SUBTITLE'],
              ['/regeln',     'fa-solid fa-code',          'automod:NAV.RULES',      'automod:RULES.SUBTITLE'],
              ['/eskalation', 'fa-solid fa-stairs',        'automod:NAV.ESCALATION', 'automod:ESCALATION.SUBTITLE'],
              ['/ausnahmen',  'fa-solid fa-user-check',    'automod:NAV.EXEMPTIONS', 'automod:EXEMPTIONS.SUBTITLE'],
              ['/raid',       'fa-solid fa-shield-virus',  'automod:NAV.RAID',       'automod:TABS.RAID.SUBTITLE'],
              ['/protokoll',  'fa-solid fa-file-lines',    'automod:NAV.LOGS',       'automod:LOGS.SUBTITLE']
            ];
          %>
          <% bereiche.forEach(([pfad, icon, titel, hinweis]) => { %>
            <a href="<%= basis %><%= pfad %>" class="list-group-item list-group-item-action">
              <div class="d-flex align-items-center">
                <i class="<%= icon %> me-3 text-secondary"></i>
                <div>
                  <div><%= tr(titel) %></div>
                  <div class="text-secondary small"><%= tr(hinweis) %></div>
                </div>
              </div>
            </a>
          <% }); %>
        </div>
      </div>
    </div>
  </div>
</form>
