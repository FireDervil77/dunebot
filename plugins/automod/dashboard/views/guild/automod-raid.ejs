<%- include('partials/automod-kopf', {
  guildId, tr,
  icon: 'fa-solid fa-shield-virus',
  titel: tr('automod:NAV.RAID'),
  beschreibung: tr('automod:TABS.RAID.SUBTITLE')
}) %>

<% if (settings.raid_lockdown_active) { %>
  <div class="alert alert-danger" role="alert">
    <div class="d-flex align-items-center">
      <i class="fa-solid fa-lock fs-2 me-3"></i>
      <div>
        <h4 class="alert-title mb-1"><%= tr('automod:TABS.RAID.LOCKDOWN_ACTIVE') %></h4>
        <div class="text-secondary"><%= tr('automod:RAID.LOCKDOWN_HINT') %></div>
      </div>
    </div>
  </div>
<% } %>

<form class="guild-ajax-form"
      data-automod-form
      data-form-type="automod-raid"
      data-method="PUT"
      action="/guild/<%= guildId %>/plugins/automod/settings"
      method="POST">

  <div class="row row-cards">
    <!-- Erkennung -->
    <div class="col-lg-6">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">
            <i class="fa-solid fa-users me-2"></i>
            <%= tr('automod:RAID.DETECTION_TITLE') %>
          </h3>
        </div>
        <div class="card-body">
          <label class="form-check form-switch mb-1">
            <input class="form-check-input" type="checkbox" name="raid_protection_enabled" value="1"
                   <%= settings.raid_protection_enabled ? 'checked' : '' %>>
            <span class="form-check-label fw-bold"><%= tr('automod:TABS.RAID.ENABLE') %></span>
          </label>
          <div class="text-secondary small mb-3"><%= tr('automod:RAID.ENABLE_HELP') %></div>

          <div class="row">
            <div class="col-sm-6 mb-3">
              <label for="raid_join_threshold" class="form-label"><%= tr('automod:TABS.RAID.JOIN_THRESHOLD') %></label>
              <input type="number" class="form-control" id="raid_join_threshold" name="raid_join_threshold"
                     value="<%= settings.raid_join_threshold || 5 %>" min="2" max="50">
              <div class="form-hint"><%= tr('automod:RAID.JOIN_THRESHOLD_HELP') %></div>
            </div>
            <div class="col-sm-6 mb-3">
              <label for="raid_join_timespan" class="form-label"><%= tr('automod:TABS.RAID.JOIN_TIMESPAN') %></label>
              <input type="number" class="form-control" id="raid_join_timespan" name="raid_join_timespan"
                     value="<%= settings.raid_join_timespan || 10 %>" min="5" max="60">
              <div class="form-hint"><%= tr('automod:RAID.JOIN_TIMESPAN_HELP') %></div>
            </div>
          </div>

          <div class="mb-0">
            <label for="raid_min_account_age_days" class="form-label"><%= tr('automod:TABS.RAID.MIN_ACCOUNT_AGE') %></label>
            <input type="number" class="form-control" id="raid_min_account_age_days" name="raid_min_account_age_days"
                   value="<%= settings.raid_min_account_age_days || 0 %>" min="0" max="365">
            <div class="form-hint"><%= tr('automod:RAID.MIN_ACCOUNT_AGE_HELP') %></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Reaktion -->
    <div class="col-lg-6">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">
            <i class="fa-solid fa-gavel me-2"></i>
            <%= tr('automod:RAID.ACTION_TITLE') %>
          </h3>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <label for="raid_action" class="form-label"><%= tr('automod:TABS.RAID.ACTION') %></label>
            <select class="form-select" id="raid_action" name="raid_action">
              <option value="KICK" <%= settings.raid_action === 'KICK' ? 'selected' : '' %>>
                <%= tr('automod:SETTINGS.ACTION.KICK') %>
              </option>
              <option value="BAN" <%= settings.raid_action === 'BAN' ? 'selected' : '' %>>
                <%= tr('automod:SETTINGS.ACTION.BAN') %>
              </option>
            </select>
            <div class="form-hint"><%= tr('automod:RAID.ACTION_HELP') %></div>
          </div>

          <label class="form-check form-switch mb-1">
            <input class="form-check-input" type="checkbox" name="raid_lockdown_enabled" value="1"
                   <%= settings.raid_lockdown_enabled ? 'checked' : '' %>>
            <span class="form-check-label fw-bold"><%= tr('automod:TABS.RAID.LOCKDOWN') %></span>
          </label>
          <div class="text-secondary small mb-3"><%= tr('automod:RAID.LOCKDOWN_HELP') %></div>

          <div class="mb-3">
            <label for="raid_alert_channel" class="form-label"><%= tr('automod:TABS.RAID.ALERT_CHANNEL') %></label>
            <% if (guildChannels && guildChannels.length > 0) { %>
              <select class="form-select" id="raid_alert_channel" name="raid_alert_channel">
                <option value=""><%= tr('automod:SETTINGS.LOG_CHANNEL.NO_SELECTION') %></option>
                <%
                  let kategorie = null;
                  const gewaehlterKanal = String(settings.raid_alert_channel || '');
                  guildChannels.forEach(channel => {
                    if (channel.parentName && channel.parentName !== kategorie) {
                      kategorie = channel.parentName;
                %>
                  <option disabled>── <%= kategorie %> ──</option>
                <%  } %>
                  <option value="<%= channel.id %>" <%= gewaehlterKanal === String(channel.id) ? 'selected' : '' %>>
                    <%= channel.parentName ? '   ' : '' %>#<%= channel.name %>
                  </option>
                <% }); %>
              </select>
            <% } else { %>
              <input type="text" class="form-control" id="raid_alert_channel" name="raid_alert_channel"
                     value="<%= settings.raid_alert_channel || '' %>"
                     placeholder="<%= tr('automod:SETTINGS.LOG_CHANNEL.ID_PLACEHOLDER') %>">
            <% } %>
            <div class="form-hint"><%= tr('automod:RAID.ALERT_CHANNEL_HELP') %></div>
          </div>

          <label class="form-check form-switch mb-1">
            <input class="form-check-input" type="checkbox" name="raid_alert_mention_mods" value="1"
                   <%= settings.raid_alert_mention_mods ? 'checked' : '' %>>
            <span class="form-check-label"><%= tr('automod:TABS.RAID.ALERT_MENTION_MODS') %></span>
          </label>
          <div class="text-secondary small mb-0"><%= tr('automod:RAID.ALERT_MENTION_MODS_HELP') %></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Vertrauenswuerdige Einladungen -->
  <div class="card mt-3">
    <div class="card-header">
      <h3 class="card-title">
        <i class="fa-solid fa-user-check me-2"></i>
        <%= tr('automod:TABS.RAID.TRUSTED_INVITES') %>
      </h3>
    </div>
    <div class="card-body">
      <textarea class="form-control font-monospace" id="raid_trusted_invites" name="raid_trusted_invites" rows="4"
                placeholder="ABC123&#10;XYZ789"><%= (settings.raid_trusted_invites || []).join('\n') %></textarea>
      <div class="form-hint"><%= tr('automod:RAID.TRUSTED_INVITES_HELP') %></div>
    </div>
  </div>

  <div class="mt-3">
    <button type="submit" class="btn btn-primary">
      <i class="fa-solid fa-floppy-disk me-2"></i>
      <%= tr('automod:SETTINGS.SAVE_BUTTON') %>
    </button>
  </div>
</form>

<!-- Was der Raid-Schutz zuletzt gemeldet hat -->
<div class="card mt-3">
  <div class="card-header">
    <h3 class="card-title">
      <i class="fa-solid fa-clock-rotate-left me-2"></i>
      <%= tr('automod:RAID.EVENTS_TITLE') %>
    </h3>
  </div>
  <% if (raidEreignisse && raidEreignisse.length > 0) { %>
    <div class="table-responsive">
      <table class="table card-table table-vcenter">
        <thead>
          <tr>
            <th><%= tr('automod:RAID.EVENT_TYPE') %></th>
            <th><%= tr('automod:RAID.EVENT_DETAILS') %></th>
            <th class="text-end"><%= tr('automod:LOGS.WHEN') %></th>
          </tr>
        </thead>
        <tbody>
          <% raidEreignisse.forEach(ereignis => { %>
            <tr>
              <td><span class="badge bg-orange-lt"><%= ereignis.event_type %></span></td>
              <td class="text-secondary small font-monospace">
                <%= ereignis.metadata ? JSON.stringify(ereignis.metadata) : '—' %>
              </td>
              <td class="text-end text-secondary">
                <%= ereignis.created_at ? new Date(ereignis.created_at).toLocaleString('de-DE') : '' %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="card-body">
      <div class="empty">
        <div class="empty-icon"><i class="fa-solid fa-shield-halved fs-1 text-secondary"></i></div>
        <p class="empty-title"><%= tr('automod:RAID.EVENTS_EMPTY') %></p>
      </div>
    </div>
  <% } %>
</div>
