{
    "name": "automod",
    "displayName": "AutoMod",
    "description": "The Auto-Moderation Plugin for FireBot",
    "version": "1.8.0",
    "author": "FireBot Team",
    "license": "none",
    "type": "commonjs",
    "peerDependencies": {
        "discord.js": "^14.19.0",
        "express": "^5.1.0",
        "dunebot-core": "*",
        "dunebot-sdk": "*"
    },
    "guildInhalte": {
        "loeschen": [
            "automod_compound_rules",
            "automod_escalation_config",
            "automod_exemptions",
            "automod_keyword_lists",
            "automod_logs",
            "automod_raid_events",
            "automod_regex_rules",
            "automod_settings",
            "automod_strikes"
        ]
    },
    "ereignisse": {
        "sendet": [
            "automod.verstoss",
            "automod.raid"
        ],
        "hoert": []
    },
    "mitgliedInhalte": {
        "automod_logs": {
            "member_id": {
                "weg": "frist",
                "grund": "Automod-Treffer mit Nachrichtentext. Moderations- und Sicherheitsfall: bleibt bis zum Ende seiner Frist (G-05), die Auskunft nennt ihn (F-G2 A)"
            }
        },
        "automod_raid_events": {
            "user_id": {
                "weg": "frist",
                "grund": "Raid-Erkennung. Moderations- und Sicherheitsfall: bleibt bis zum Ende seiner Frist (G-05), die Auskunft nennt ihn (F-G2 A)"
            }
        },
        "automod_strikes": {
            "member_id": {
                "weg": "frist",
                "grund": "Verwarnstand. Moderations- und Sicherheitsfall: bleibt bis zum Ende seiner Frist (G-05), die Auskunft nennt ihn (F-G2 A)"
            }
        },
        "automod_exemptions": {
            "target_id": {
                "weg": "ausgenommen",
                "grund": "type ist ENUM(role, channel), nie ein Mitglied"
            }
        }
    }
}
