{
    "name": "automod",
    "displayName": "AutoMod",
    "description": "The Auto-Moderation Plugin for FireBot",
    "version": "1.8.0",
    "author": "FireBot Team",
    "license": "none",
    "type": "commonjs",
    "peerDependencies": {
        "discord.js": "^14.28.1",
        "express": "^5.1.0",
        "dunebot-core": "*",
        "dunebot-sdk": "*"
    },
    "guildInhalte": {
        "loeschen": [
            "automod_compound_rules",
            "automod_escalation_config",
            "automod_exemptions",
            "automod_keyword_lists",
            "automod_logs",
            "automod_raid_events",
            "automod_regex_rules",
            "automod_settings",
            "automod_strikes"
        ]
    },
    "ereignisse": {
        "sendet": [
            "automod.verstoss",
            "automod.raid"
        ],
        "hoert": []
    },
    "mitgliedInhalte": {
        "automod_logs": {
            "member_id": {
                "weg": "frist",
                "grund": "Automod-Treffer mit Nachrichtentext, Sicherheitsfall der Guild"
            }
        },
        "automod_raid_events": {
            "user_id": {
                "weg": "frist",
                "grund": "Raid-Erkennung, Sicherheitsfall der Guild"
            }
        },
        "automod_strikes": {
            "member_id": {
                "weg": "frist",
                "grund": "Verwarnstand bei Automod, Sicherheitsfall der Guild"
            }
        },
        "automod_exemptions": {
            "target_id": {
                "weg": "ausgenommen",
                "grund": "type ist ENUM(role, channel), nie ein Mitglied"
            }
        }
    },
    "aufbewahrung": [
        {
            "name": "treffer",
            "tabelle": "automod_logs",
            "zeitspalte": "logged_at",
            "vorgabe_tage": 90,
            "hoechstens_tage": 365,
            "guild": true,
            "recht": "AUTOMOD.SETTINGS.EDIT",
            "titel": "automod:AUFBEWAHRUNG.TREFFER"
        },
        {
            "name": "raid",
            "tabelle": "automod_raid_events",
            "zeitspalte": "created_at",
            "vorgabe_tage": 90,
            "hoechstens_tage": 365,
            "guild": true,
            "recht": "AUTOMOD.SETTINGS.EDIT",
            "titel": "automod:AUFBEWAHRUNG.RAID"
        },
        {
            "name": "verwarnstand",
            "tabelle": "automod_strikes",
            "zeitspalte": "updated_at",
            "vorgabe_tage": 90,
            "hoechstens_tage": 365,
            "guild": true,
            "recht": "AUTOMOD.SETTINGS.EDIT",
            "titel": "automod:AUFBEWAHRUNG.VERWARNSTAND"
        }
    ]
}
