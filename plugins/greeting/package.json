{
  "name": "greeting",
  "displayName": "Greeting",
  "description": "FireBot Greetings Plugin",
  "version": "1.9.0",
  "author": "FireBot Team",
  "license": "MIT",
  "main": "index.js",
  "bot": "bot/index.js",
  "dashboard": "dashboard/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/firedervil77/dunebot-plugins"
  },
  "keywords": [
    "dunebot",
    "firebot",
    "discord",
    "plugin",
    "greeting"
  ],
  "dependencies": {
    "dunebot-sdk": "*"
  },
  "peerDependencies": {
    "discord.js": "^14.28.1",
    "express": "^5.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "commonjs",
  "guildInhalte": {
    "loeschen": [
      "greeting_invite_mappings",
      "greeting_settings"
    ]
  },
  "mitgliedInhalte": {},
  "vorlagen": {
    "recht": "GREETING.SETTINGS.EDIT",
    "platzhalter": [
      {
        "name": "inviter:name",
        "bedeutung": "greeting:VORLAGEN.PH_INVITER_NAME",
        "beispiel": "Einladender"
      },
      {
        "name": "inviter:tag",
        "bedeutung": "greeting:VORLAGEN.PH_INVITER_TAG",
        "beispiel": "einladender"
      },
      {
        "name": "invites",
        "bedeutung": "greeting:VORLAGEN.PH_INVITES",
        "beispiel": "5"
      }
    ],
    "anlaesse": {
      "willkommen": {
        "titel": "greeting:TAB_WELCOME",
        "kern": [
          "member",
          "guild",
          "gestaltung"
        ],
        "platzhalter": [
          "inviter:name",
          "inviter:tag",
          "invites"
        ]
      },
      "direktnachricht": {
        "titel": "greeting:TAB_DM_WELCOME",
        "kern": [
          "member",
          "guild",
          "gestaltung"
        ],
        "platzhalter": [
          "inviter:name",
          "inviter:tag",
          "invites"
        ]
      },
      "abschied": {
        "titel": "greeting:TAB_FAREWELL",
        "kern": [
          "member",
          "guild",
          "gestaltung"
        ],
        "platzhalter": [
          "inviter:name",
          "inviter:tag",
          "invites"
        ]
      },
      "boost": {
        "titel": "greeting:TAB_BOOST",
        "kern": [
          "member",
          "guild",
          "gestaltung"
        ],
        "platzhalter": []
      },
      "verifiziert": {
        "titel": "greeting:VERIFICATION.SUCCESS_MESSAGE",
        "kern": ["member", "guild", "gestaltung"],
        "platzhalter": []
      },
      "verifizierung_panel": {
        "titel": "greeting:VERIFICATION.MESSAGE",
        "kern": ["guild", "gestaltung"],
        "platzhalter": []
      }
    }
  }
}
