<%#
  Herausgeloest aus greeting-settings.ejs beim Umbau am 2026-08-07.
  Erwartet: tr, guildId, settings, channels, roles, inviteMappings, reactionPanels
%>
<h4><i class="fa-solid fa-icons text-primary me-2"></i><%= tr('greeting:REACTION_ROLES.TITLE') %></h4>
<p class="text-secondary mb-4"><%= tr('greeting:REACTION_ROLES.DESC') %></p>

<!-- Create New Panel -->
<div class="card">
    <div class="card-status-top bg-primary"></div>
  <div class="card-header">
    <h3 class="card-title"><i class="fa-solid fa-plus me-1"></i> <%= tr('greeting:REACTION_ROLES.CREATE_TITLE') %></h3>
  </div>
  <div class="card-body">
    <div class="row">
      <div class="col-md-6">
        <div class="mb-3">
          <label><%= tr('greeting:REACTION_ROLES.PANEL_TITLE') %></label>
          <input type="text" id="rrPanelTitle" class="form-control" maxlength="255" placeholder="<%= tr('greeting:REACTION_ROLES.PANEL_TITLE_PH') %>">
        </div>
      </div>
      <div class="col-md-3">
        <div class="mb-3">
          <label><%= tr('greeting:REACTION_ROLES.PANEL_COLOR') %></label>
          <input type="color" id="rrPanelColor" class="form-control" value="#5865f2">
        </div>
      </div>
      <div class="col-md-3">
        <div class="mb-3">
          <label><%= tr('greeting:REACTION_ROLES.PANEL_CHANNEL') %></label>
          <select id="rrPanelChannel" class="form-control">
            <option value=""><%= tr('greeting:CHANNEL_SELECT') %></option>
            <% channels.forEach(ch => { %>
              <option value="<%= ch.id %>">#<%= ch.name %></option>
            <% }); %>
          </select>
        </div>
      </div>
    </div>
    <div class="mb-3">
      <label><%= tr('greeting:REACTION_ROLES.PANEL_DESC') %></label>
      <textarea id="rrPanelDesc" class="form-control" rows="2" placeholder="<%= tr('greeting:REACTION_ROLES.PANEL_DESC_PH') %>"></textarea>
    </div>

    <!-- Emoji-Role Mappings Builder -->
    <hr>
    <h6><i class="fa-solid fa-list me-1"></i> <%= tr('greeting:REACTION_ROLES.ADD_MAPPING') %></h6>
    <div id="rrMappingsList"></div>
    <div class="row mt-2">
      <div class="col-md-2">
        <input type="text" id="rrNewEmoji" class="form-control" maxlength="50" placeholder="<%= tr('greeting:REACTION_ROLES.EMOJI_PH') %>">
      </div>
      <div class="col-md-4">
        <select id="rrNewRole" class="form-control">
          <option value="">— <%= tr('greeting:REACTION_ROLES.ROLE') %> —</option>
          <% roles.forEach(r => { %>
            <option value="<%= r.id %>"><%= r.name %></option>
          <% }); %>
        </select>
      </div>
      <div class="col-md-4">
        <input type="text" id="rrNewDesc" class="form-control" maxlength="255" placeholder="<%= tr('greeting:REACTION_ROLES.MAPPING_DESC_PH') %>">
      </div>
      <div class="col-md-2">
        <button type="button" class="btn btn-info w-100" onclick="addRRMapping()">
          <i class="fa-solid fa-plus me-1"></i> <%= tr('greeting:REACTION_ROLES.BTN_ADD_MAPPING') %>
        </button>
      </div>
    </div>

    <div class="mt-3 text-end">
      <button type="button" class="btn btn-primary" onclick="createReactionPanel()">
        <i class="fa-solid fa-plus-circle me-1"></i> <%= tr('greeting:REACTION_ROLES.BTN_CREATE_PANEL') %>
      </button>
    </div>
  </div>
</div>

<!-- Existing Panels -->
<div class="card">
  <div class="card-header">
    <h3 class="card-title"><i class="fa-solid fa-list me-1"></i> <%= tr('greeting:REACTION_ROLES.EXISTING_PANELS') %></h3>
  </div>
  <div class="card-body">
    <% if (reactionPanels && reactionPanels.length > 0) { %>
      <% reactionPanels.forEach(panel => { %>
        <div class="card mb-3" id="rr-panel-<%= panel.id %>">
          <div class="card-status-top bg-<%= panel.message_id ? 'success' : 'warning' %>"></div>
          <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
              <% if (panel.message_id) { %>
                <span class="badge bg-success-lt me-2"><%= tr('greeting:REACTION_ROLES.STATUS_SENT') %></span>
              <% } else { %>
                <span class="badge bg-warning-lt me-2"><%= tr('greeting:REACTION_ROLES.STATUS_DRAFT') %></span>
              <% } %>
              <%= panel.title || 'Reaction Roles' %>
            </h5>
            <div>
              <% if (!panel.message_id) { %>
                <button class="btn btn-sm btn-success" onclick="sendReactionPanel(<%= panel.id %>)">
                  <i class="fa-solid fa-paper-plane me-1"></i> <%= tr('greeting:REACTION_ROLES.BTN_SEND_PANEL') %>
                </button>
              <% } %>
              <button class="btn btn-sm btn-outline-danger" onclick="deleteReactionPanel(<%= panel.id %>)">
                <i class="fa-solid fa-trash"></i>
              </button>
            </div>
          </div>
          <div class="card-body py-2">
            <% if (panel.description) { %>
              <p class="text-secondary small mb-2"><%= panel.description %></p>
            <% } %>
            <% if (panel.mappings && panel.mappings.length > 0) { %>
              <div class="d-flex flex-wrap" style="gap: 8px;">
                <% panel.mappings.forEach(m => { %>
                  <span class="badge bg-light-lt border p-2" style="font-size: 0.9em;">
                    <%= m.emoji %> → <strong><%= m.role_name || m.role_id %></strong>
                    <% if (m.description) { %><small class="text-secondary ms-1">(<%= m.description %>)</small><% } %>
                  </span>
                <% }); %>
              </div>
            <% } else { %>
              <p class="text-secondary small mb-0">Keine Zuordnungen</p>
            <% } %>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <p class="text-secondary text-center mb-0"><%= tr('greeting:REACTION_ROLES.EMPTY') %></p>
    <% } %>
  </div>
</div>

<!-- Info -->
<div class="alert alert-info small">
  <i class="fa-solid fa-info-circle me-1"></i> <%= tr('greeting:REACTION_ROLES.INFO') %>
</div>

<!-- ==================== INVITE TRACKING TAB ==================== -->
