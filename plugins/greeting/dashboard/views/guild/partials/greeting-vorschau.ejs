<%#
  Herausgeloest aus greeting-settings.ejs beim Umbau am 2026-08-07.
  Erwartet: tr, guildId, settings, channels, roles, inviteMappings
%>
<div class="col-lg-4">
  <!-- Help Card -->
  <div class="card">
      <div class="card-status-top bg-info"></div>
    <div class="card-header">
      <h3 class="card-title"><i class="fa-solid fa-circle-info me-2"></i><%= tr('greeting:HELP.TITLE') %></h3>
    </div>
    <div class="card-body">
      <div class="mb-3">
        <h6><i class="fa-solid fa-hand-wave text-primary me-1"></i> <%= tr('greeting:HELP.WELCOME_TITLE') %></h6>
        <p class="text-secondary small mb-2"><%= tr('greeting:HELP.WELCOME_TEXT') %></p>
      </div>
      <div class="mb-3">
        <h6><i class="fa-solid fa-door-open text-warning me-1"></i> <%= tr('greeting:HELP.FAREWELL_TITLE') %></h6>
        <p class="text-secondary small mb-2"><%= tr('greeting:HELP.FAREWELL_TEXT') %></p>
      </div>
      <div class="mb-3">
        <h6><i class="fa-solid fa-envelope text-info me-1"></i> <%= tr('greeting:HELP.DM_TITLE') %></h6>
        <p class="text-secondary small mb-2"><%= tr('greeting:HELP.DM_TEXT') %></p>
      </div>
      <div class="mb-3">
        <h6><i class="fa-solid fa-user-shield text-success me-1"></i> <%= tr('greeting:HELP.AUTOROLE_TITLE') %></h6>
        <p class="text-secondary small mb-2"><%= tr('greeting:HELP.AUTOROLE_TEXT') %></p>
      </div>
      <div class="mb-3">
        <h6><i class="fa-solid fa-rocket text-danger me-1"></i> <%= tr('greeting:HELP.BOOST_TITLE') %></h6>
        <p class="text-secondary small mb-2"><%= tr('greeting:HELP.BOOST_TEXT') %></p>
      </div>
      <div class="mb-3">
        <h6><i class="fa-solid fa-image text-secondary me-1"></i> <%= tr('greeting:HELP.IMAGE_TITLE') %></h6>
        <p class="text-secondary small mb-2"><%= tr('greeting:HELP.IMAGE_TEXT') %></p>
      </div>
      <div class="mb-3">
        <h6><i class="fa-solid fa-shield-check text-success me-1"></i> <%= tr('greeting:HELP.VERIFICATION_TITLE') %></h6>
        <p class="text-secondary small mb-2"><%= tr('greeting:HELP.VERIFICATION_TEXT') %></p>
      </div>
      <div class="mb-3">
        <h6><i class="fa-solid fa-link text-info me-1"></i> <%= tr('greeting:HELP.INVITE_TRACKING_TITLE') %></h6>
        <p class="text-secondary small mb-2"><%= tr('greeting:HELP.INVITE_TRACKING_TEXT') %></p>
      </div>
      <hr>
      <h6><i class="fa-solid fa-code me-2"></i><%= tr('greeting:HELP.PLACEHOLDERS_TITLE') %></h6>

      <p class="text-secondary small mb-1"><i class="fa-solid fa-user me-1"></i> <strong>Member</strong></p>
      <div class="d-flex flex-wrap mb-2" style="gap: 4px;">
        <code class="badge bg-light-lt border" style="cursor:pointer; font-size: 0.8em; color: #000;" onclick="copyPH(this)">{member:name}</code>
        <code class="badge bg-light-lt border" style="cursor:pointer; font-size: 0.8em; color: #000;" onclick="copyPH(this)">{member:nick}</code>
        <code class="badge bg-light-lt border" style="cursor:pointer; font-size: 0.8em; color: #000;" onclick="copyPH(this)">{member:mention}</code>
        <code class="badge bg-light-lt border" style="cursor:pointer; font-size: 0.8em; color: #000;" onclick="copyPH(this)">{member:tag}</code>
        <code class="badge bg-light-lt border" style="cursor:pointer; font-size: 0.8em; color: #000;" onclick="copyPH(this)">{member:avatar}</code>
        <code class="badge bg-light-lt border" style="cursor:pointer; font-size: 0.8em; color: #000;" onclick="copyPH(this)">{member:id}</code>
        <code class="badge bg-light-lt border" style="cursor:pointer; font-size: 0.8em; color: #000;" onclick="copyPH(this)">{member:joinedAt}</code>
        <code class="badge bg-light-lt border" style="cursor:pointer; font-size: 0.8em; color: #000;" onclick="copyPH(this)">{member:createdAt}</code>
      </div>

      <p class="text-secondary small mb-1"><i class="fa-solid fa-server me-1"></i> <strong>Server</strong></p>
      <div class="d-flex flex-wrap mb-2" style="gap: 4px;">
        <code class="badge bg-light-lt border" style="cursor:pointer; font-size: 0.8em; color: #000;" onclick="copyPH(this)">{guild:name}</code>
        <code class="badge bg-light-lt border" style="cursor:pointer; font-size: 0.8em; color: #000;" onclick="copyPH(this)">{server}</code>
        <code class="badge bg-light-lt border" style="cursor:pointer; font-size: 0.8em; color: #000;" onclick="copyPH(this)">{guild:memberCount}</code>
        <code class="badge bg-light-lt border" style="cursor:pointer; font-size: 0.8em; color: #000;" onclick="copyPH(this)">{count}</code>
        <code class="badge bg-light-lt border" style="cursor:pointer; font-size: 0.8em; color: #000;" onclick="copyPH(this)">{guild:id}</code>
        <code class="badge bg-light-lt border" style="cursor:pointer; font-size: 0.8em; color: #000;" onclick="copyPH(this)">{guild:icon}</code>
        <code class="badge bg-light-lt border" style="cursor:pointer; font-size: 0.8em; color: #000;" onclick="copyPH(this)">{guild:boostCount}</code>
        <code class="badge bg-light-lt border" style="cursor:pointer; font-size: 0.8em; color: #000;" onclick="copyPH(this)">{guild:boostLevel}</code>
      </div>

      <p class="text-secondary small mb-1"><i class="fa-solid fa-envelope me-1"></i> <strong>Inviter</strong> <span class="text-secondary">(nur Welcome)</span></p>
      <div class="d-flex flex-wrap" style="gap: 4px;">
        <code class="badge bg-light-lt border" style="cursor:pointer; font-size: 0.8em; color: #000;" onclick="copyPH(this)">{inviter:name}</code>
        <code class="badge bg-light-lt border" style="cursor:pointer; font-size: 0.8em; color: #000;" onclick="copyPH(this)">{inviter:tag}</code>
        <code class="badge bg-light-lt border" style="cursor:pointer; font-size: 0.8em; color: #000;" onclick="copyPH(this)">{invites}</code>
      </div>
      <small class="text-secondary d-block mt-1">Klicke zum Kopieren</small>
    </div>
  </div>

  <!-- Live Preview Card -->
  <div class="card mt-3" id="previewCard">
    <div class="card-status-top bg-dark"></div>
    <div class="card-header">
      <h3 class="card-title"><i class="fa-solid fa-eye me-2"></i><%= tr('greeting:PREVIEW.TITLE') %></h3>
    </div>
    <div class="card-body p-0">
      <div id="livePreview" style="background: #36393f; padding: 12px; border-radius: 0 0 4px 4px; min-height: 80px;">
        <div style="display: flex; gap: 12px;">
          <div style="width: 40px; height: 40px; border-radius: 50%; background: #5865f2; display: flex; align-items: center; justify-content: center;">
            <span style="color: #fff; font-weight: 700; font-size: 1rem;">D</span>
          </div>
          <div style="flex: 1;">
            <div style="display: flex; align-items: baseline; gap: 6px; margin-bottom: 2px;">
              <span style="color: #fff; font-weight: 600;">FireBot</span>
              <span style="background: #5865f2; color: #fff; font-size: 0.55rem; padding: 1px 4px; border-radius: 3px;">BOT</span>
              <span style="color: #72767d; font-size: 0.7rem;">Heute um 12:00</span>
            </div>
            <div id="previewContent" style="color: #dcddde; font-size: 0.9rem; white-space: pre-wrap;"></div>
            <div id="previewEmbed" style="margin-top: 4px;"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
