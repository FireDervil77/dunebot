<%- include('partials/greeting-kopf', {
  guildId, tr,
  icon: 'fa-solid fa-hand-wave',
  titel: tr('greeting:SETTINGS.PAGE_TITLE'),
  beschreibung: tr('greeting:SETTINGS.PAGE_DESC')
}) %>

<%
  const basis = `/guild/${guildId}/plugins/greeting`;

  /** Wegweiser in die Unterseiten, mit dem jeweiligen Zustand. */
  const bereiche = [
    ['NAV.MESSAGES',      '/nachrichten',   'fa-solid fa-comment-dots',
      settings.welcome.enabled || settings.farewell.enabled || settings.dm_welcome.enabled, 'MESSAGES.SUBTITLE'],
    ['NAV.ROLES',         '/rollen',        'fa-solid fa-user-tag',
      settings.autorole_ids.length > 0 || (reactionPanels || []).length > 0, 'ROLES.SUBTITLE'],
    ['NAV.VERIFICATION',  '/verifizierung', 'fa-solid fa-shield-halved',
      settings.verification.enabled, 'VERIFICATION.DESC'],
    ['NAV.BOOST',         '/boost',         'fa-solid fa-rocket',
      settings.boost.enabled, 'BOOST.SUBTITLE'],
    ['NAV.INVITES',       '/einladungen',   'fa-solid fa-link',
      (inviteMappings || []).length > 0, 'INVITES.SUBTITLE']
  ];
%>

<div class="row row-cards">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><%= tr('greeting:SETTINGS.AREAS_TITLE') %></h3>
      </div>
      <div class="card-body">
        <p class="text-secondary"><%= tr('greeting:SETTINGS.AREAS_DESC') %></p>
      </div>
      <div class="list-group list-group-flush">
        <% bereiche.forEach(([titel, pfad, icon, an, hinweis]) => { %>
          <a href="<%= basis %><%= pfad %>" class="list-group-item list-group-item-action">
            <div class="d-flex align-items-center">
              <i class="<%= icon %> me-3 text-secondary"></i>
              <div class="flex-grow-1">
                <div><%= tr('greeting:' + titel) %></div>
                <div class="text-secondary small"><%= tr('greeting:' + hinweis) %></div>
              </div>
              <span class="badge <%= an ? 'bg-success' : 'bg-secondary' %>">
                <%= an ? tr('greeting:DASHBOARD.ON') : tr('greeting:DASHBOARD.OFF') %>
              </span>
            </div>
          </a>
        <% }); %>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><i class="fa-solid fa-circle-info me-2"></i><%= tr('greeting:HELP.TITLE') %></h3>
      </div>
      <div class="card-body">
        <p class="text-secondary"><%= tr('greeting:SETTINGS.HELP_TEXT') %></p>
        <a href="<%= basis %>/dashboard" class="btn btn-primary w-100">
          <i class="fa-solid fa-gauge-high me-2"></i><%= tr('greeting:NAV.DASHBOARD') %>
        </a>
      </div>
    </div>
  </div>
</div>
