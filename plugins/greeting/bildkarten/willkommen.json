    { "art": "text", "x": 512, "y": 340, "text": "Member #{guild:memberCount}", "groesse": 18, "farbe": "{akzent}", "ausrichtung": "mitte", "grundlinie": "mitte" },
    { "art": "text", "x": 512, "y": 30, "text": "{guild:name}", "groesse": 16, "farbe": "rgba(255, 255, 255, 0.4)", "ausrichtung": "mitte", "grundlinie": "mitte", "max_breite": 960 }
  ]
