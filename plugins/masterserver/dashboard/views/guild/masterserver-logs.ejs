<!-- Masterserver Daemon Logs -->
<%# Seit 2026-11-03 je Maschine wählbar; Export und Löschen gehen an echte Routen
    (guild.router.js, Route 5) und nehmen dieselbe Auswahl wie die Liste. %>
<%
  const rechte = (locals.userPermissions && userPermissions.permissions) || {};
  const darfLoeschen = Boolean((locals.userPermissions && userPermissions.is_owner) || rechte['MASTERSERVER.DAEMON.MANAGE']);
  const gewaehlteMaschine = maschinen.find(m => m.daemon_id === gewaehlt) || null;
  const mehrere = maschinen.length > 1;
%>
<div class="container-fluid">
  <div class="row">
    <!-- Page Header -->
    <div class="col-12 mb-3">
      <h2>
        <i class="fa-solid fa-file-lines text-primary me-2"></i>
        <%= tr('masterserver:LOGS.TITLE') %>
      </h2>
      <p class="text-secondary">Daemon-Logs zur Fehlersuche und Monitoring</p>
    </div>
  </div>

  <!-- Filter & Actions Row -->
  <div class="row mb-3">
    <div class="col-md-8">
      <div class="card">
        <div class="card-body p-2">
          <form method="GET" action="/guild/<%= guildId %>/plugins/masterserver/logs" class="form-inline">
            <div class="mb-3 me-3">
              <label class="me-2">Maschine:</label>
              <select name="daemon" class="form-control form-control-sm" onchange="this.form.submit()">
                <option value="">Alle (<%= maschinen.length %>)</option>
                <% maschinen.forEach(function (m) { %>
                  <option value="<%= m.daemon_id %>" <%= gewaehlt === m.daemon_id ? 'selected' : '' %>><%= m.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="mb-3 me-3">
              <label class="me-2">Level:</label>
              <select name="level" class="form-control form-control-sm" onchange="this.form.submit()">
                <option value="">Alle</option>
                <option value="debug" <%= level === 'debug' ? 'selected' : '' %>>Debug</option>
                <option value="info" <%= level === 'info' ? 'selected' : '' %>>Info</option>
                <option value="warn" <%= level === 'warn' ? 'selected' : '' %>>Warning</option>
                <option value="error" <%= level === 'error' ? 'selected' : '' %>>Error</option>
              </select>
            </div>
            <div class="mb-3 me-3">
              <label class="me-2">Limit:</label>
              <select name="limit" class="form-control form-control-sm" onchange="this.form.submit()">
                <option value="50" <%= limit === 50 ? 'selected' : '' %>>50</option>
                <option value="100" <%= limit === 100 ? 'selected' : '' %>>100</option>
                <option value="200" <%= limit === 200 ? 'selected' : '' %>>200</option>
                <option value="500" <%= limit === 500 ? 'selected' : '' %>>500</option>
              </select>
            </div>
            <button type="submit" class="btn btn-sm btn-primary">
              <i class="fa-solid fa-filter me-1"></i> Filtern
            </button>
            <a href="/guild/<%= guildId %>/plugins/masterserver/logs" class="btn btn-sm btn-secondary ms-2">
              <i class="fa-solid fa-refresh me-1"></i> Zurücksetzen
            </a>
          </form>
        </div>
      </div>
    </div>
    <div class="col-md-4 text-end">
      <button type="button" class="btn btn-success" onclick="window.location.reload()">
        <i class="fa-solid fa-refresh me-1"></i> Aktualisieren
      </button>
      <a class="btn btn-warning" download
         href="/guild/<%= guildId %>/plugins/masterserver/logs/export?daemon=<%= encodeURIComponent(gewaehlt) %>&level=<%= encodeURIComponent(level || '') %>">
        <i class="fa-solid fa-download me-1"></i> Exportieren
      </a>
      <% if (darfLoeschen) { %>
        <button type="button" class="btn btn-danger" id="logsLoeschenOeffnen">
          <i class="fa-solid fa-trash me-1"></i> Löschen
        </button>
      <% } %>
    </div>
  </div>

  <!-- Stats Row -->
  <div class="row row-cards row-deck mb-3">
    <div class="col-sm-6 col-lg-3">
      <div class="card card-sm">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-auto">
              <span class="bg-info text-white avatar"><i class="fa-solid fa-file-lines"></i></span>
            </div>
            <div class="col">
              <div class="h2 fw-medium mb-0"><%= stats.total %></div>
              <div class="text-secondary">Gesamt Logs</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card card-sm">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-auto">
              <span class="bg-danger text-white avatar"><i class="fa-solid fa-circle-exclamation"></i></span>
            </div>
            <div class="col">
              <div class="h2 fw-medium mb-0"><%= stats.errors %></div>
              <div class="text-secondary">Errors</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card card-sm">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-auto">
              <span class="bg-warning text-white avatar"><i class="fa-solid fa-triangle-exclamation"></i></span>
            </div>
            <div class="col">
              <div class="h2 fw-medium mb-0"><%= stats.warnings %></div>
              <div class="text-secondary">Warnings</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card card-sm">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-auto">
              <span class="bg-success text-white avatar"><i class="fa-solid fa-circle-info"></i></span>
            </div>
            <div class="col">
              <div class="h2 fw-medium mb-0"><%= stats.info %></div>
              <div class="text-secondary">Info</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Logs Table Card -->
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">
            <i class="fa-solid fa-list me-2"></i>
            Log-Einträge 
            <% if (level) { %>
              <span class="badge bg-info-lt"><%= level.toUpperCase() %></span>
            <% } %>
            (Zeige <%= logs.length %> von <%= stats.total %>)
          </h3>
        </div>
        <div class="card-body p-0">
          <% if (logs.length > 0) { %>
            <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
              <table class="table table-sm table-striped table-hover mb-0" style="font-size: 13px;">
                <thead style="position: sticky; top: 0; background: #fff; z-index: 1;">
                  <tr>
                    <th width="5%">Level</th>
                    <th width="15%">Timestamp</th>
                    <% if (mehrere && !gewaehlt) { %><th width="12%">Maschine</th><% } %>
                    <th width="15%">Source</th>
                    <th width="<%= mehrere && !gewaehlt ? 38 : 50 %>%">Message</th>
                    <th width="15%">Details</th>
                  </tr>
                </thead>
                <tbody>
                  <% logs.forEach((log, index) => { 
                    const levelColors = {
                      'debug': 'secondary',
                      'info': 'info',
                      'warn': 'warning',
                      'error': 'danger'
                    };
                    const levelColor = levelColors[log.level] || 'secondary';
                    const levelIcons = {
                      'debug': 'fa-bug',
                      'info': 'fa-circle-info',
                      'warn': 'fa-triangle-exclamation',
                      'error': 'fa-circle-exclamation'
                    };
                    const levelIcon = levelIcons[log.level] || 'fa-circle';
                  %>
                    <tr class="log-row" data-log-index="<%= index %>">
                      <td>
                        <span class="badge bg-<%= levelColor %>-lt">
                          <i class="fa-solid <%= levelIcon %>"></i>
                          <%= log.level.toUpperCase() %>
                        </span>
                      </td>
                      <td>
                        <small><%= new Date(log.timestamp).toLocaleString('de-DE', {
                          year: 'numeric',
                          month: '2-digit',
                          day: '2-digit',
                          hour: '2-digit',
                          minute: '2-digit',
                          second: '2-digit'
                        }) %></small>
                      </td>
                      <% if (mehrere && !gewaehlt) { %><td><%= log.maschine %></td><% } %>
                      <%# Gattung und rohes Wort - vorher stand hier fest
                          "daemon", weil `log.source` nie existierte. %>
                      <td>
                        <code><%= log.source %></code>
                        <% if (log.aktion && log.aktion !== log.source) { %>
                          <div class="text-secondary" style="font-size:11px"><%= log.aktion %></div>
                        <% } %>
                      </td>
                      <td>
                        <%= log.message %>
                        <% if (log.metadata && Object.keys(log.metadata).length > 0) { %>
                          <br><small class="text-secondary">
                            <% Object.entries(log.metadata).slice(0, 2).forEach(([key, value]) => { %>
                              <strong><%= key %>:</strong> <%= typeof value === 'object' ? JSON.stringify(value).substring(0, 50) + '...' : value %> 
                            <% }); %>
                          </small>
                        <% } %>
                      </td>
                      <td class="text-center">
                        <% if (log.metadata && Object.keys(log.metadata).length > 0) { %>
                          <button type="button" class="btn btn-sm btn-info" onclick="showLogDetails(<%= index %>)">
                            <i class="fa-solid fa-info-circle"></i> Details
                          </button>
                        <% } else { %>
                          <span class="text-secondary">-</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="p-5 text-center text-secondary">
              <i class="fa-solid fa-file-circle-question fa-4x mb-3"></i>
              <h5>Keine Logs gefunden</h5>
              <% if (level) { %>
                <p>Es gibt keine Logs mit Level: <strong><%= level %></strong></p>
                <a href="/guild/<%= guildId %>/plugins/masterserver/logs" class="btn btn-primary">Filter zurücksetzen</a>
              <% } else { %>
                <p><%= gewaehlteMaschine ? gewaehlteMaschine.name + ' hat' : 'Die Daemons haben' %> noch keine Logs geschrieben.</p>
              <% } %>
            </div>
          <% } %>
        </div>
        <% if (logs.length > 0) { %>
          <div class="card-footer text-center">
            <small class="text-secondary">
              Zeige die letzten <%= logs.length %> Einträge
              <% if (level) { %>
                (gefiltert nach <%= level %>)
              <% } %>
              • Auto-Cleanup nach <%= retentionDays %> Tagen
            </small>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<% if (darfLoeschen) { %>
<%# Zerstörende Rückfrage nach Vorlage #paketEntfernenModal: rot, fett, Name eintippen. %>
<div class="modal modal-blur fade" id="logsLoeschenModal" tabindex="-1" aria-labelledby="logsLoeschenTitel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content border border-danger border-2">
      <div class="modal-status bg-danger"></div>
      <div class="modal-header bg-danger-lt">
        <h5 class="modal-title text-danger fw-bold" id="logsLoeschenTitel">
          <i class="fa-solid fa-triangle-exclamation me-2"></i>Daemon-Logs ENDGÜLTIG löschen
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
      </div>
      <div class="modal-body">
        <p class="text-danger fw-bold fs-3 mb-2">
          <% if (gewaehlteMaschine) { %>Alle Logs von „<%= gewaehlteMaschine.name %>" werden gelöscht.<% } else { %>Die Logs ALLER <%= maschinen.length %> Maschinen werden gelöscht.<% } %>
        </p>
        <p class="text-danger fw-bold mb-3">Das lässt sich nicht zurücknehmen.</p>
        <p class="mb-3">Es gehen <%= stats.total %> Einträge, unabhängig vom Level-Filter. Wer gelöscht hat, steht danach als erste Zeile im Log. Vorher exportieren, wenn du sie aufheben willst.</p>
        <label class="form-label fw-bold" for="logsLoeschenEingabe">
          Zum Bestätigen eintippen: <span class="font-monospace text-danger" id="logsLoeschenSoll"><%= gewaehlteMaschine ? gewaehlteMaschine.name : 'ALLE' %></span>
        </label>
        <input type="text" class="form-control font-monospace" id="logsLoeschenEingabe" autocomplete="off" spellcheck="false">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-link link-secondary me-auto" data-bs-dismiss="modal">Abbrechen</button>
        <button type="button" class="btn btn-danger fw-bold" id="logsLoeschenKnopf" disabled>
          <i class="fa-solid fa-trash me-1"></i>Endgültig löschen
        </button>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- Log Details Modal -->
<div class="modal fade" id="logDetailsModal" tabindex="-1" role="dialog">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header bg-info">
        <h5 class="modal-title">
          <i class="fa-solid fa-info-circle me-2"></i>
          Log-Details
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
      </div>
      <div class="modal-body">
        <div id="logDetailsContent">
          <p class="text-center"><i class="fa-solid fa-spinner fa-spin"></i> Lädt...</p>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Schließen</button>
      </div>
    </div>
  </div>
</div>

<!-- Scripts -->
<script>
/**
 * Ein Fenster ansprechen — Bootstrap-5-Schnittstelle.
 * jQuery ist unter Tabler geladen, dessen Fenster-Methode aber nicht: Der
 * Aufruf warf, und alles danach im selben Block lief nicht mehr.
 */
// fenster() kommt aus guild.js — dort ist es die einzige Definition im Projekt.
// Eine Kopie an dieser Stelle ueberschrieb sie je nach Ladereihenfolge.

// `<` als \u003c: Eine Meldung mit `</script>` beendete sonst diesen Block.
const logsData = <%- JSON.stringify(logs).replace(/</g, '\\u003c') %>;

/** Text für innerHTML: Meldungen und Metadaten kommen vom Daemon und von außen. */
function esc(wert) {
  return String(wert === undefined || wert === null ? '' : wert)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

function showLogDetails(index) {
  const log = logsData[index];
  
  if (!log) {
    GuildAjaxHandler.showToast('error', 'Log nicht gefunden');
    return;
  }
  
  const levelColors = {
    'debug': 'secondary',
    'info': 'info',
    'warn': 'warning',
    'error': 'danger'
  };
  const levelColor = levelColors[log.level] || 'secondary';
  
  const content = `
    <table class="table table-sm">
      <tbody>
        <tr>
          <th width="30%">Log-ID:</th>
          <td><code>${esc(log.log_id)}</code></td>
        </tr>
        <tr>
          <th>Level:</th>
          <td><span class="badge bg-${levelColor}-lt">${esc(String(log.level).toUpperCase())}</span></td>
        </tr>
        <tr>
          <th>Timestamp:</th>
          <td>${new Date(log.timestamp).toLocaleString('de-DE')}</td>
        </tr>
        <tr>
          <th>Source:</th>
          <td><code>${esc(log.source || 'daemon')}</code></td>
        </tr>
        <tr>
          <th>Message:</th>
          <td>${esc(log.message)}</td>
        </tr>
        <tr>
          <th>Maschine:</th>
          <td>${esc(log.maschine)}</td>
        </tr>
      </tbody>
    </table>
    
    ${log.metadata && Object.keys(log.metadata).length > 0 ? `
      <h6 class="mt-3">Metadata:</h6>
      <pre class="bg-dark text-white p-3 rounded" style="max-height: 300px; overflow-y: auto;"><code>${esc(JSON.stringify(log.metadata, null, 2))}</code></pre>
    ` : ''}
  `;
  
  document.getElementById('logDetailsContent').innerHTML = content;
  fenster('logDetailsModal')?.show();
}

// Löschen: Knopf bleibt gesperrt, bis der Name genau dasteht; der Server prüft ihn noch einmal.
(function () {
  const oeffnen = document.getElementById('logsLoeschenOeffnen');
  const modalEl = document.getElementById('logsLoeschenModal');
  if (!oeffnen || !modalEl) return;
  const eingabe = document.getElementById('logsLoeschenEingabe');
  const knopf = document.getElementById('logsLoeschenKnopf');
  const soll = document.getElementById('logsLoeschenSoll').textContent;

  oeffnen.addEventListener('click', function () {
    eingabe.value = '';
    knopf.disabled = true;
    bootstrap.Modal.getOrCreateInstance(modalEl).show();
  });
  eingabe.addEventListener('input', function () {
    knopf.disabled = eingabe.value.trim() !== soll;
  });
  knopf.addEventListener('click', async function () {
    knopf.disabled = true;
    try {
      const r = await fetch('/guild/<%= guildId %>/plugins/masterserver/logs', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ daemon: <%- JSON.stringify(gewaehlt) %>, bestaetigung: eingabe.value.trim() })
      });
      const d = await r.json();
      if (!r.ok || !d.success) throw new Error(d.message || 'Nicht gelöscht.');
      bootstrap.Modal.getOrCreateInstance(modalEl).hide();
      GuildAjaxHandler.showToast('success', d.message);
      setTimeout(function () { window.location.reload(); }, 1200);
    } catch (e) {
      knopf.disabled = eingabe.value.trim() !== soll;
      GuildAjaxHandler.showToast('error', e.message);
    }
  });
})();

// Highlight log rows on hover
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.log-row').forEach(row => {
    row.addEventListener('mouseenter', function() {
      this.style.backgroundColor = '#f8f9fa';
    });
    row.addEventListener('mouseleave', function() {
      this.style.backgroundColor = '';
    });
  });
});
</script>
