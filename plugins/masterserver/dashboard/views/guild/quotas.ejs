<%
/**
 * Ressourcen-Management (Pterodactyl-Style)
 * Zeigt Ressourcen-Auslastung pro RootServer-Node mit Overallocation-Steuerung
 */
%>


<!-- Main Content -->

        <% if (!nodes || nodes.length === 0) { %>
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>
            Kein RootServer konfiguriert. <a href="/guild/<%= guildId %>/plugins/masterserver/rootservers/create">RootServer einrichten</a>.
        </div>
        <% } %>

        <% nodes.forEach(function(node) {
            const isOnline = node.daemon_status === 'online';
            const l = node.limits;
            const u = node.usage;
            const ramBarClass  = u.ramPct  >= 90 ? 'danger' : u.ramPct  >= 75 ? 'warning' : 'success';
            const diskBarClass = u.diskPct >= 90 ? 'danger' : u.diskPct >= 75 ? 'warning' : 'success';
            const cpuBarClass  = u.cpuPct  >= 90 ? 'danger' : u.cpuPct  >= 75 ? 'warning' : 'success';
        %>

        <div class="card mb-4">
            <div class="card-status-top bg-<%= isOnline ? 'success' : 'secondary' %>"></div>

            <!-- Card Header -->
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-server me-2"></i>
                    <strong><%= node.name %></strong>
                    <% if (isOnline) { %>
                        <span class="badge bg-success-lt ms-2">
                            <i class="fas fa-circle" style="font-size:.6em;"></i> Online
                        </span>
                    <% } else { %>
                        <span class="badge bg-secondary-lt ms-2">
                            <i class="fas fa-circle" style="font-size:.6em;"></i> Offline
                        </span>
                    <% } %>
                </h3>
                <div class="card-actions">
                    <small class="text-secondary">
                        <i class="fas fa-microchip me-1"></i><%= node.cpu_cores || '?' %> Kerne &nbsp;·&nbsp;
                        <i class="fas fa-memory me-1"></i><%= node.ram_total_gb ? parseFloat(node.ram_total_gb).toFixed(1) : '?' %> GB RAM &nbsp;·&nbsp;
                        <i class="fas fa-hdd me-1"></i><%= node.disk_total_gb ? parseFloat(node.disk_total_gb).toFixed(1) : '?' %> GB Disk
                    </small>
                </div>
            </div>

            <div class="card-body">

                <%#
                    Woher die Kapazität stammt. Der Normalfall ist "erkannt": Der
                    Daemon meldet seine Hardware, das Dashboard rechnet damit, und
                    niemand muss Zahlen eintragen. "Eingestellt" erscheint nur,
                    wenn jemand bewusst abweichend festgelegt hat.
                %>
                <% const herkunft = [node.quota?.ram_herkunft, node.quota?.cpu_herkunft, node.quota?.disk_herkunft];
                   const alleErkannt = herkunft.every(h => h === 'erkannt');
                   const etwasGesetzt = herkunft.some(h => h === 'eingestellt');
                   const nurProfil = herkunft.every(h => h === 'profil'); %>

                <div class="mb-3">
                    <% if (alleErkannt) { %>
                        <small class="text-success">
                            <i class="fas fa-wand-magic-sparkles me-1"></i>
                            Kapazität automatisch vom Daemon erkannt<% if (node.quota?.hardware_stand) { %>
                            <span class="text-secondary">(Stand: <%= new Date(node.quota.hardware_stand).toLocaleString('de-DE') %>)</span>
                            <% } %>
                        </small>
                    <% } else if (nurProfil) { %>
                        <small class="text-warning">
                            <i class="fas fa-triangle-exclamation me-1"></i>
                            Noch keine Hardware erkannt — es gilt das Profil
                            <strong><%= node.quota?.profile_display_name || node.quota?.profile_name || 'Standard' %></strong>.
                            Sobald der Daemon verbunden war, stimmen die Werte von selbst.
                        </small>
                    <% } else if (etwasGesetzt) { %>
                        <small class="text-info">
                            <i class="fas fa-sliders me-1"></i>
                            Teilweise von Hand festgelegt:
                            <%= [
                                node.quota?.ram_herkunft  === 'eingestellt' ? 'RAM'  : null,
                                node.quota?.cpu_herkunft  === 'eingestellt' ? 'CPU'  : null,
                                node.quota?.disk_herkunft === 'eingestellt' ? 'Disk' : null
                            ].filter(Boolean).join(', ') %>.
                            Der Rest folgt der erkannten Hardware.
                        </small>
                    <% } %>
                </div>

                <!-- ── Ressourcen-Balken ── -->
                <div class="row mb-3">

                    <!-- RAM -->
                    <div class="col-md-4 mb-3 mb-md-0">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-sm fw-bold">
                                <i class="fas fa-memory me-1 text-secondary"></i>Arbeitsspeicher
                            </span>
                            <span class="text-sm text-secondary">
                                <%= Math.round(node.allocated.allocated_ram_mb || 0).toLocaleString() %> MB
                                / <%= l.usableRamMB.toLocaleString() %> MB
                            </span>
                        </div>
                        <div class="progress" style="height:14px;">
                            <div class="progress-bar bg-<%= ramBarClass %>"
                                 style="width:<%= u.ramPct %>%"
                                 title="<%= u.ramPct %>%">
                                <% if (u.ramPct >= 15) { %><%= u.ramPct %>%<% } %>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between mt-1">
                            <small class="text-secondary">Reserviert: <%= l.reservedRamMB %> MB</small>
                            <small class="text-secondary">Gesamt: <%= l.totalRamMB.toLocaleString() %> MB</small>
                        </div>
                    </div>

                    <!-- Disk -->
                    <div class="col-md-4 mb-3 mb-md-0">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-sm fw-bold">
                                <i class="fas fa-hdd me-1 text-secondary"></i>Festplatte
                            </span>
                            <span class="text-sm text-secondary">
                                <%= Math.round(node.allocated.allocated_disk_gb || 0) %> GB
                                / <%= l.usableDiskGB %> GB
                            </span>
                        </div>
                        <div class="progress" style="height:14px;">
                            <div class="progress-bar bg-<%= diskBarClass %>"
                                 style="width:<%= u.diskPct %>%"
                                 title="<%= u.diskPct %>%">
                                <% if (u.diskPct >= 15) { %><%= u.diskPct %>%<% } %>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between mt-1">
                            <small class="text-secondary">Reserviert: <%= l.reservedDiskGB %> GB</small>
                            <small class="text-secondary">Gesamt: <%= l.totalDiskGB %> GB</small>
                        </div>
                    </div>

                    <!-- CPU -->
                    <div class="col-md-4">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-sm fw-bold">
                                <i class="fas fa-microchip me-1 text-secondary"></i>CPU-Kerne
                            </span>
                            <span class="text-sm text-secondary">
                                <%= node.allocated.allocated_cpu_cores || 0 %> / <%= l.totalCpuCores %>
                            </span>
                        </div>
                        <div class="progress" style="height:14px;">
                            <div class="progress-bar bg-<%= cpuBarClass %>"
                                 style="width:<%= u.cpuPct %>%"
                                 title="<%= u.cpuPct %>%">
                                <% if (u.cpuPct >= 15) { %><%= u.cpuPct %>%<% } %>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between mt-1">
                            <small class="text-secondary">Server: <%= node.allocated.server_count || 0 %></small>
                            <small class="text-secondary">Kerne: <%= l.totalCpuCores %></small>
                        </div>
                    </div>

                </div>

                <hr class="mt-2 mb-3">

                <!-- ── Verwaltungszeilen ── -->
                <div class="row">

                    <!-- Überallokation -->
                    <div class="col-md-6 mb-3 mb-md-0">
                        <h6 class="text-sm fw-bold mb-2">
                            <i class="fas fa-expand-arrows-alt me-1 text-secondary"></i>Überallokation
                            <small class="text-secondary fw-normal ms-1">(0 – 300 %)</small>
                        </h6>
                        <form class="form-overallocation" data-rs-id="<%= node.id %>">
                            <div class="input-group input-group-sm mb-2">
                                <span class="input-group-text" style="min-width:80px;">RAM %</span>
                                <input type="number" class="form-control" name="overallocateRam"
                                       min="0" max="300" value="<%= l.overRam %>"
                                       placeholder="0">
                                <span class="input-group-text">%</span>
                            </div>
                            <div class="input-group input-group-sm mb-2">
                                <span class="input-group-text" style="min-width:80px;">Disk %</span>
                                <input type="number" class="form-control" name="overallocateDisk"
                                       min="0" max="300" value="<%= l.overDisk %>"
                                       placeholder="0">
                                <span class="input-group-text">%</span>
                            </div>
                            <button type="submit" class="btn btn-sm btn-primary">
                                <i class="fas fa-save me-1"></i>Speichern
                            </button>
                        </form>
                    </div>

                    <!-- OS-Reservierung -->
                    <div class="col-md-6">
                        <h6 class="text-sm fw-bold mb-2">
                            <i class="fas fa-lock me-1 text-secondary"></i>OS-Reservierung
                            <small class="text-secondary fw-normal ms-1">(Betriebssystem)</small>
                        </h6>
                        <form class="form-reserved" data-rs-id="<%= node.id %>">
                            <div class="input-group input-group-sm mb-2">
                                <span class="input-group-text" style="min-width:80px;">RAM</span>
                                <input type="number" class="form-control" name="reservedRamMB"
                                       min="0" value="<%= l.reservedRamMB %>"
                                       placeholder="1024">
                                <span class="input-group-text">MB</span>
                            </div>
                            <div class="input-group input-group-sm mb-2">
                                <span class="input-group-text" style="min-width:80px;">Disk</span>
                                <input type="number" class="form-control" name="reservedDiskGB"
                                       min="0" value="<%= l.reservedDiskGB %>"
                                       placeholder="10">
                                <span class="input-group-text">GB</span>
                            </div>
                            <button type="submit" class="btn btn-sm btn-primary">
                                <i class="fas fa-save me-1"></i>Speichern
                            </button>
                        </form>
                    </div>

                </div>

                <!-- ── Gameserver-Tabelle ── -->
                <% if (node.gameservers && node.gameservers.length > 0) { %>
                <hr class="mt-3 mb-3">
                <h6 class="text-sm fw-bold mb-2">
                    <i class="fas fa-th-list me-1 text-secondary"></i>
                    Gameserver (<%= node.gameservers.length %>)
                </h6>
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead>
                            <tr class="text-secondary" style="font-size:.8rem;">
                                <th>Name</th>
                                <th>Typ</th>
                                <th class="text-end">RAM</th>
                                <th class="text-end">CPU</th>
                                <th class="text-end">Disk</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                        <% node.gameservers.forEach(function(gs) { %>
                            <tr>
                                <td>
                                    <a href="/guild/<%= guildId %>/plugins/gameserver/servers/<%= gs.server_id %>"
                                       class="text-dark">
                                        <%= gs.server_name || gs.server_id %>
                                    </a>
                                </td>
                                <td><small class="text-secondary"><%= gs.server_type || '–' %></small></td>
                                <td class="text-end">
                                    <span class="<%= (gs.allocated_ram_mb || 0) > 0 ? '' : 'text-secondary' %>">
                                        <%= gs.allocated_ram_mb ? gs.allocated_ram_mb.toLocaleString() + ' MB' : 'kein Limit' %>
                                    </span>
                                </td>
                                <td class="text-end">
                                    <span class="<%= (gs.allocated_cpu_percent || 0) > 0 ? '' : 'text-secondary' %>">
                                        <%= gs.allocated_cpu_percent ? gs.allocated_cpu_percent + ' %' : 'kein Limit' %>
                                    </span>
                                </td>
                                <td class="text-end">
                                    <span class="<%= (gs.allocated_disk_gb || 0) > 0 ? '' : 'text-secondary' %>">
                                        <%= gs.allocated_disk_gb ? gs.allocated_disk_gb + ' GB' : 'kein Limit' %>
                                    </span>
                                </td>
                                <td class="text-center">
                                    <%# Statuswerte laut ENUM in gameservers: installing, installed,
                                        starting, online, stopping, offline, error, updating.
                                        Hier standen vorher 'running'/'stopped' — Werte, die die
                                        Spalte nie annimmt; jede Zeile fiel in den Sonst-Zweig. %>
                                    <% if (gs.status === 'online') { %>
                                        <span class="badge bg-success-lt">online</span>
                                    <% } else if (gs.status === 'offline') { %>
                                        <span class="badge bg-secondary-lt">offline</span>
                                    <% } else if (gs.status === 'starting' || gs.status === 'stopping') { %>
                                        <span class="badge bg-warning-lt"><%= gs.status %></span>
                                    <% } else if (gs.status === 'error') { %>
                                        <span class="badge bg-danger-lt">Fehler</span>
                                    <% } else { %>
                                        <span class="badge bg-light-lt"><%= gs.status || 'unbekannt' %></span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                        </tbody>
                    </table>
                </div>
                <% } else { %>
                <hr class="mt-3 mb-2">
                <p class="text-secondary text-sm mb-0">
                    <i class="fas fa-info-circle me-1"></i>
                    Keine Gameserver auf diesem Node.
                </p>
                <% } %>

            </div><!-- /.card-body -->
        </div><!-- /.card -->

        <% }); %>


<!-- ── JavaScript ── -->
<script>
(function () {
    'use strict';

    const guildId = '<%= guildId %>';

    // ── Überallokation speichern ──────────────────────────────────────────────
    document.querySelectorAll('.form-overallocation').forEach(function (form) {
        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            const rsId = form.dataset.rsId;
            const data = Object.fromEntries(new FormData(form));
            try {
                const r = await fetch(`/guild/${guildId}/plugins/masterserver/quotas/rootserver/${rsId}/overallocation`, {
                    method:  'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body:    JSON.stringify({ overallocateRam: data.overallocateRam, overallocateDisk: data.overallocateDisk })
                });
                const json = await r.json();
                if (json.success) {
                    showToast('Überallokation gespeichert.', 'success');
                    setTimeout(function () { location.reload(); }, 800);
                } else {
                    showToast('Fehler: ' + (json.message || 'Unbekannt'), 'error');
                }
            } catch (err) {
                showToast('Netzwerk-Fehler', 'error');
            }
        });
    });

    // ── OS-Reservierung speichern ─────────────────────────────────────────────
    document.querySelectorAll('.form-reserved').forEach(function (form) {
        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            const rsId = form.dataset.rsId;
            const data = Object.fromEntries(new FormData(form));
            try {
                const r = await fetch(`/guild/${guildId}/plugins/masterserver/quotas/rootserver/${rsId}/reserved`, {
                    method:  'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body:    JSON.stringify({ reservedRamMB: data.reservedRamMB, reservedDiskGB: data.reservedDiskGB })
                });
                const json = await r.json();
                if (json.success) {
                    showToast('Reservierung gespeichert.', 'success');
                    setTimeout(function () { location.reload(); }, 800);
                } else {
                    showToast('Fehler: ' + (json.message || 'Unbekannt'), 'error');
                }
            } catch (err) {
                showToast('Netzwerk-Fehler', 'error');
            }
        });
    });

    // ── Toast Helper ──────────────────────────────────────────────────────────
    function showToast(msg, type) {
        if (window.toastr) {
            if (type === 'success') toastr.success(msg);
            else toastr.error(msg);
        } else {
            alert(msg);
        }
    }
})();
</script>
