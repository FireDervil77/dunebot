<!-- Masterserver Dashboard - Übersicht -->
<div class="container-fluid">
  <div class="row">
    <!-- Page Header -->
    <div class="col-12 mb-3">
      <h2>
        <i class="fa-solid fa-server text-primary me-2"></i>
        <%= tr('masterserver:DASHBOARD.TITLE') %>
      </h2>
      <p class="text-secondary">Übersicht über deinen Masterserver-Daemon und registrierte Server</p>
    </div>
  </div>

  <!-- Status Cards Row -->
  <div class="row">
    <!-- Daemon Status Card -->
    <div class="col-lg-3 col-md-6">
      <div class="card card-sm">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-auto">
              <span class="<%= isOnline ? 'bg-success' : 'bg-danger' %> text-white avatar"><i class="fa-solid <%= isOnline ? 'fa-circle-check' : 'fa-circle-xmark' %>"></i></span>
            </div>
            <div class="col">
              <div class="h2 fw-medium mb-0"><%= isOnline ? 'Online' : 'Offline' %></div>
              <div class="text-secondary"><%= tr('masterserver:DASHBOARD.STATS.DAEMON_STATUS') %></div>
            </div>
          </div>
        </div>
        <div class="card-footer">
          <a href="/guild/<%= guildId %>/plugins/masterserver/rootservers" class="text-reset">Daemon verwalten <i class="fas fa-arrow-circle-right"></i></a>
        </div>
      </div>
    </div>

    <!-- Total Servers Card -->
    <div class="col-lg-3 col-md-6">
      <div class="card card-sm">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-auto">
              <span class="bg-info text-white avatar"><i class="fa-solid fa-server"></i></span>
            </div>
            <div class="col">
              <div class="h2 fw-medium mb-0"><%= serverStats.total %></div>
              <div class="text-secondary"><%= tr('masterserver:DASHBOARD.STATS.TOTAL_SERVERS') %></div>
            </div>
          </div>
        </div>
        <div class="card-footer">
          <a href="/guild/<%= guildId %>/plugins/masterserver/rootservers" class="text-reset">Zur Server-Liste <i class="fas fa-arrow-circle-right"></i></a>
        </div>
      </div>
    </div>

    <!-- Active Servers Card -->
    <div class="col-lg-3 col-md-6">
      <div class="card card-sm">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-auto">
              <span class="bg-success text-white avatar"><i class="fa-solid fa-circle-check"></i></span>
            </div>
            <div class="col">
              <div class="h2 fw-medium mb-0"><%= serverStats.active %></div>
              <div class="text-secondary">Aktive Server</div>
            </div>
          </div>
        </div>
        <div class="card-footer">
          <a href="/guild/<%= guildId %>/plugins/masterserver/rootservers" class="text-reset">Details anzeigen <i class="fas fa-arrow-circle-right"></i></a>
        </div>
      </div>
    </div>

    <!-- Total Gameservers Card -->
    <div class="col-lg-3 col-md-6">
      <div class="card card-sm">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-auto">
              <span class="bg-warning text-white avatar"><i class="fa-solid fa-gamepad"></i></span>
            </div>
            <div class="col">
              <div class="h2 fw-medium mb-0"><%= serverStats.totalGameservers %></div>
              <div class="text-secondary">Gameserver gesamt</div>
            </div>
          </div>
        </div>
        <div class="card-footer">
          <a href="/guild/<%= guildId %>/plugins/masterserver/rootservers" class="text-reset">Server-Details <i class="fas fa-arrow-circle-right"></i></a>
        </div>
      </div>
    </div>
  </div>

  <!-- Spacer -->
  <div class="row mb-3"></div>

  <!-- Quick Links -->
  <div class="row">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">
            <i class="fa-solid fa-bolt me-2"></i>
            Schnellzugriff
          </h3>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-3 col-sm-6 mb-2">
              <a href="/guild/<%= guildId %>/plugins/masterserver/rootservers" class="btn btn-outline-primary w-100">
                <i class="fa-solid fa-cog me-2"></i> Daemon-Setup
              </a>
            </div>
            <div class="col-md-3 col-sm-6 mb-2">
              <a href="/guild/<%= guildId %>/plugins/masterserver/rootservers" class="btn btn-outline-secondary w-100">
                <i class="fa-solid fa-server me-2"></i> RootServer
              </a>
            </div>
            <div class="col-md-3 col-sm-6 mb-2">
              <a href="/guild/<%= guildId %>/plugins/masterserver/rootservers" class="btn btn-outline-info w-100">
                <i class="fa-solid fa-list me-2"></i> Server-Registry
              </a>
            </div>
            <div class="col-md-3 col-sm-6 mb-2">
              <a href="/guild/<%= guildId %>/plugins/masterserver/logs" class="btn btn-outline-warning w-100">
                <i class="fa-solid fa-file-lines me-2"></i> Daemon-Logs
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Spacer -->
  <div class="row mb-3"></div>

  <div class="row">
    <!-- Daemon Info Card -->
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">
            <i class="fa-solid fa-cog me-2"></i>
            Daemon-Informationen
          </h3>
        </div>
        <div class="card-body">
          <% if (daemon) { %>
            <table class="table table-sm">
              <tbody>
                <tr>
                  <th width="40%">Daemon-ID:</th>
                  <td><code><%= daemon.daemon_id %></code></td>
                </tr>
                <tr>
                  <th>Anzeigename:</th>
                  <td><%= daemon.display_name %></td>
                </tr>
                <tr>
                  <th>Status:</th>
                  <td>
                    <span class="badge badge-<%= isOnline ? 'success' : 'danger' %>">
                      <%= isOnline ? 'Online' : 'Offline' %>
                    </span>
                  </td>
                </tr>
                <tr>
                  <th>Version:</th>
                  <td><%= daemon.version || 'Unbekannt' %></td>
                </tr>
                <tr>
                  <th>Erstellt am:</th>
                  <td>
                    <% if (daemon.registered_at) { %>
                      <%= new Date(daemon.registered_at).toLocaleString('de-DE') %>
                    <% } else { %>
                      <span class="text-secondary">Nicht verfügbar</span>
                    <% } %>
                  </td>
                </tr>
                <tr>
                  <th>Zuletzt gesehen:</th>
                  <td>
                    <% if (daemon.last_heartbeat) { %>
                      <%= new Date(daemon.last_heartbeat).toLocaleString('de-DE') %>
                    <% } else { %>
                      <span class="text-secondary">Noch kein Heartbeat</span>
                    <% } %>
                  </td>
                </tr>
              </tbody>
            </table>
            <div class="mt-3">
              <a href="/guild/<%= guildId %>/plugins/masterserver/rootservers" class="btn btn-primary btn-sm">
                <i class="fa-solid fa-cog me-1"></i> Daemon konfigurieren
              </a>
              <a href="/guild/<%= guildId %>/plugins/masterserver/logs" class="btn btn-info btn-sm">
                <i class="fa-solid fa-file-lines me-1"></i> Logs anzeigen
              </a>
            </div>
          <% } else { %>
            <div class="alert alert-warning">
              <i class="fa-solid fa-triangle-exclamation me-2"></i>
              Kein Daemon konfiguriert. Starte den Setup-Wizard um loszulegen!
            </div>
            <a href="/guild/<%= guildId %>/plugins/masterserver/rootservers" class="btn btn-success">
              <i class="fa-solid fa-plus me-1"></i> Daemon erstellen
            </a>
          <% } %>
        </div>
      </div>
    </div>
  </div>

</div>
