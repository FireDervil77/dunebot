<!-- RootServer erstellen – Wizard -->


        <div class="row mb-3">
            <div class="col-12">
                <a href="/guild/<%= guildId %>/plugins/masterserver/rootservers" class="btn btn-secondary">
                    <i class="fa-solid fa-arrow-left me-2"></i>Zurück
                </a>
            </div>
        </div>

        <!-- Info-Banner -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="alert alert-info">
                    <h5><i class="fa-solid fa-circle-info me-2"></i>Was ist ein RootServer?</h5>
                    <p class="mb-0">
                        Ein RootServer repräsentiert eine physische oder virtuelle Maschine, auf der der 
                        <strong>FireBot-Daemon</strong> läuft. Auf einem RootServer können mehrere Gameserver 
                        betrieben werden. Nach dem Erstellen bekommst du einen <strong>API-Key</strong>, 
                        den du in der <code>daemon.yaml</code> auf deinem Server einträgst.
                    </p>
                </div>
            </div>
        </div>

        <form class="guild-ajax-form"
              data-form-type="rootserver-create"
              data-method="POST"
              action="/guild/<%= guildId %>/plugins/masterserver/rootservers"
              method="POST"
              data-loading-text="RootServer wird erstellt..."
              data-loading-toast="true"
              data-loading-toast-message="⚙️ RootServer wird angelegt...">

            <!-- Basis-Informationen -->
            <div class="card">
                <div class="card-status-top bg-primary"></div>
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fa-solid fa-tag me-2"></i>Basis-Informationen
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="name">Name <span class="text-danger">*</span></label>
                                <input type="text"
                                       class="form-control"
                                       id="name"
                                       name="name"
                                       placeholder="z.B. Hetzner-Node-1"
                                       minlength="3" maxlength="100"
                                       required>
                                <small class="form-text text-secondary">Eindeutiger Name für diesen RootServer</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="fqdn">Domainname (optional)</label>
                                <input type="text"
                                       class="form-control"
                                       id="fqdn"
                                       name="fqdn"
                                       placeholder="z.B. node1.firenetworks.de">
                                <small class="form-text text-secondary">
                                    Wird beim Verbinden des Daemons geprüft: Zeigt er auf DIESE Maschine,
                                    erscheint er als Adresse — sonst bleibt es bei der IP.
                                </small>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="fastdlEnabled">FastDL</label>
                                <div class="form-check form-switch mt-2">
                                    <input type="checkbox" class="form-check-input" id="fastdlEnabled" name="fastdlEnabled" value="true">
                                    <label class="form-check-label" for="fastdlEnabled">FastDL aktivieren</label>
                                </div>
                                <small class="form-text text-secondary">
                                    Schnellere Kartendownloads für Source-Spiele. Ob es geht, meldet die
                                    Maschine — sie braucht dafür nginx oder apache. Eine Domain ist nicht nötig.
                                </small>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="dbGewuenscht">Datenbanken</label>
                                <div class="form-check form-switch mt-2">
                                    <input type="checkbox" class="form-check-input" id="dbGewuenscht" name="dbGewuenscht" value="true">
                                    <label class="form-check-label" for="dbGewuenscht">Spieldatenbanken anbieten</label>
                                </div>
                                <small class="form-text text-secondary">
                                    Ohne Häkchen rührt der Daemon MySQL auf dieser Maschine nicht an.
                                </small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="dbJeServer">Datenbanken je Gameserver</label>
                                <input type="number" class="form-control" id="dbJeServer" name="dbJeServer"
                                       min="0" max="20" step="1" value="0">
                                <small class="form-text text-secondary">
                                    Eine Grenze wie RAM oder Platte. 0 = keine.
                                </small>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="description">Beschreibung (optional)</label>
                        <textarea class="form-control" id="description" name="description" rows="2"
                                  placeholder="z.B. Hetzner AX41, Frankfurt, 64 GB RAM"></textarea>
                    </div>
                </div>
            </div>

            <!-- Netzwerk -->
            <div class="card mt-3">
                <div class="card-status-top bg-primary"></div>
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fa-solid fa-network-wired me-2"></i>Netzwerk
                    </h3>
                </div>
                <div class="card-body">
                    <% if (daemonHardware && daemonHardware.network && daemonHardware.network.interfaces) { %>
                        <!-- Server-Typ Auswahl (nur wenn bereits ein Daemon online ist) -->
                        <div class="mb-3">
                            <label>Server-Typ <span class="text-danger">*</span></label>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input type="radio" id="serverTypeExisting" name="serverType" value="existing" 
                                               class="form-check-input" checked>
                                        <label class="form-check-label" for="serverTypeExisting">
                                            <strong>Virtueller RootServer</strong><br>
                                            <small class="text-secondary">Auf bestehendem Daemon (shared Host)</small>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input type="radio" id="serverTypeNew" name="serverType" value="new" 
                                               class="form-check-input">
                                        <label class="form-check-label" for="serverTypeNew">
                                            <strong>Neuer physischer RootServer</strong><br>
                                            <small class="text-secondary">Eigener Daemon (dedizierter Host)</small>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>

                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label for="host">IP-Adresse / Host <span class="text-danger">*</span></label>
                                
                                <% if (daemonHardware && daemonHardware.network && daemonHardware.network.interfaces) { %>
                                    <!-- Dropdown für bestehenden Daemon (default) -->
                                    <select class="form-control" id="hostDropdown" name="host" style="display: block;">
                                        <option value="">Automatisch (erste verfügbare)</option>
                                        <% daemonHardware.network.interfaces.forEach(iface => { %>
                                            <% if (!iface.is_loopback && iface.addresses) { %>
                                                <% iface.addresses.forEach(addr => { %>
                                                    <% if (addr.indexOf(':') === -1 && addr !== '127.0.0.1') { %>
                                                        <option value="<%= addr %>"><%= iface.name %>: <%= addr %></option>
                                                    <% } %>
                                                <% }); %>
                                            <% } %>
                                        <% }); %>
                                    </select>
                                    
                                    <!-- Textfeld für neuen RootServer (initially hidden) -->
                                    <input type="text"
                                           class="form-control"
                                           id="hostInput"
                                           name="hostCustom"
                                           placeholder="z.B. 192.168.1.100 oder node2.example.com"
                                           style="display: none;">
                                    
                                    <small class="form-text text-secondary" id="hostHelpExisting">
                                        IP-Adresse des bestehenden Daemons
                                    </small>
                                    <small class="form-text text-secondary" id="hostHelpNew" style="display: none;">
                                        IP-Adresse oder Hostname des neuen Root-Servers
                                    </small>
                                <% } else { %>
                                    <!-- Fallback: Nur Textfeld wenn kein Daemon online -->
                                    <input type="text"
                                           class="form-control"
                                           id="host"
                                           name="host"
                                           placeholder="z.B. 192.168.1.100"
                                           required>
                                    <small class="form-text text-secondary">IP-Adresse, auf der der Daemon lauscht</small>
                                <% } %>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="daemonPort">Daemon-Port</label>
                                <input type="number"
                                       class="form-control"
                                       id="daemonPort"
                                       name="daemonPort"
                                       value="9340"
                                       min="1024" max="65535">
                                <small class="form-text text-secondary">Standard: 9340 (WebSocket)</small>
                            </div>
                        </div>
                    </div>
                    <!-- Port-Range entfernt: Wird über Port-Allocations verwaltet -->
                </div>
            </div>

            <!-- Hardware — nicht mehr gefragt, sondern gemessen (M-6, 2026-08-20) -->
            <div class="card mt-3">
                <div class="card-status-top bg-secondary"></div>
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fa-solid fa-microchip me-2"></i>Hardware
                    </h3>
                </div>
                <div class="card-body">
                    <p class="mb-1">
                        CPU-Kerne, RAM und Plattenplatz werden hier nicht mehr eingetragen.
                        Der Daemon misst sie beim ersten Verbinden — an der richtigen Stelle:
                        die Platte am Datenverzeichnis, nicht an der Wurzel.
                    </p>
                    <p class="text-secondary mb-0">
                        Die gemessenen Werte sind die Kapazität dieser Maschine. Eine niedrigere
                        Grenze lässt sich danach unter <strong>Ressourcen</strong> setzen — dann ist
                        das eine bewusste Entscheidung und keine Zahl, die jemand getippt hat.
                    </p>
                </div>
            </div>

            <!-- Standort (optional) -->
            <div class="card mt-3">
                <div class="card-status-top bg-primary"></div>
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fa-solid fa-location-dot me-2"></i>Standort (optional)
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="datacenter">Rechenzentrum</label>
                                <input type="text" class="form-control" id="datacenter" name="datacenter"
                                       placeholder="z.B. Hetzner Falkenstein">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="countryCode">Ländercode</label>
                                <input type="text" class="form-control" id="countryCode" name="countryCode"
                                       placeholder="z.B. DE" maxlength="2">
                                <small class="form-text text-secondary">2-stelliger ISO-Code</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Submit -->
            <div class="row mt-4 mb-4">
                <div class="col-12">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fa-solid fa-plus me-2"></i>RootServer erstellen
                    </button>
                    <a href="/guild/<%= guildId %>/plugins/masterserver/rootservers" class="btn btn-secondary btn-lg ms-2">
                        <i class="fa-solid fa-times me-2"></i>Abbrechen
                    </a>
                </div>
            </div>

        </form>

<!-- ============================================================
     SETUP-MODAL – wird nach erfolgreicher Erstellung befüllt
     (backdrop: static → User muss aktiv bestätigen)
     ============================================================ -->
<div class="modal fade" id="rootserverSetupModal" tabindex="-1" role="dialog" aria-labelledby="setupModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="setupModalLabel">
                    <i class="fa-solid fa-circle-check me-2"></i>
                    RootServer erstellt – jetzt Daemon einrichten
                </h5>
            </div>

            <div class="modal-body">

                <div class="alert alert-danger">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    <strong>WICHTIG:</strong> Der API-Key wird nur <strong>einmal</strong> angezeigt! 
                    Kopiere ihn jetzt in deine <code>daemon.yaml</code>.
                </div>

                <div class="alert alert-warning border border-warning" style="font-size:1.05rem;">
                    <h5 class="alert-heading">
                        <i class="fa-solid fa-window-restore me-2"></i>
                        <strong>⚠️ Dieses Fenster NICHT schließen!</strong>
                    </h5>
                    <hr>
                    <p class="mb-0">
                        Lass dieses Modal <strong>unbedingt geöffnet</strong>, bis du den Daemon vollständig 
                        eingerichtet und gestartet hast.<br>
                        Sobald du auf <em>"Zur RootServer-Übersicht"</em> klickst, ist der API-Key 
                        <strong>unwiderruflich verschwunden</strong> – er wird in der Datenbank nur als 
                        Hash gespeichert und kann nicht wiederhergestellt werden.<br><br>
                        <strong>Reihenfolge:</strong>
                        <ol class="mb-0 mt-1">
                            <li>Daemon-ID und API-Key kopieren</li>
                            <li><code>daemon.yaml</code> auf dem Server speichern</li>
                            <li>Daemon installieren &amp; starten</li>
                            <li>Warten bis der Status im Dashboard auf <span class="badge bg-success-lt">Online</span> wechselt</li>
                            <li><strong>Erst dann</strong> auf "Zur RootServer-Übersicht" klicken</li>
                        </ol>
                    </p>
                </div>

                <!-- Daemon-ID + API-Key -->
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label><i class="fa-solid fa-fingerprint me-1"></i>Daemon-ID</label>
                            <div class="input-group">
                                <input type="text" class="form-control font-monospace" id="setup-daemon-id" readonly>
                                <button class="btn btn-outline-secondary" type="button"
                                onclick="copyFieldValue('setup-daemon-id')">
                                <i class="fa-solid fa-copy"></i>
                                </button>
                            </div>
                            <small class="text-secondary">Zur Identifikation im Dashboard</small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label><i class="fa-solid fa-key me-1"></i>API-Key <span class="badge bg-danger-lt">Nur einmal sichtbar!</span></label>
                            <div class="input-group">
                                <input type="text" class="form-control font-monospace" id="setup-api-key" readonly>
                                <button class="btn btn-outline-secondary" type="button"
                                onclick="copyFieldValue('setup-api-key')">
                                <i class="fa-solid fa-copy"></i>
                                </button>
                            </div>
                            <small class="text-secondary">Trägt in <code>daemon.yaml</code> unter <code>daemon.token</code> ein</small>
                        </div>
                    </div>
                </div>

                <!-- daemon.yaml -->
                <div class="mb-3 mt-2">
                    <label>
                        <i class="fa-solid fa-file-code me-1"></i>
                        Fertige <code>daemon.yaml</code>
                        <button class="btn btn-sm btn-outline-secondary ms-2" type="button"
                                onclick="copyFieldValue('setup-daemon-yaml')">
                            <i class="fa-solid fa-copy me-1"></i>Kopieren
                        </button>
                    </label>
                    <textarea class="form-control font-monospace" id="setup-daemon-yaml" rows="18" readonly
                              style="font-size:0.82rem;"></textarea>
                </div>

                <!-- Installations-Anleitung -->
                <div class="alert alert-info mt-3">
                    <h6><i class="fa-solid fa-list-ol me-1"></i><strong>Kurzanleitung</strong></h6>
                    <ol class="mb-0 ps-3">
                        <li>Daemon auf deinem Server installieren:<br>
                            <pre class="bg-dark text-white p-2 rounded mt-1 mb-2" style="font-size:0.8rem;"><code>curl -fsSL <%= process.env.DASHBOARD_BASE_URL || '' %>/downloads/daemon/install.sh | sudo bash</code></pre>
                        </li>
                        <li>Config-Datei speichern unter <code>/opt/firebot-daemon/daemon.yaml</code> (Inhalt aus dem Feld oben kopieren)</li>
                        <li>Daemon starten:<br>
                            <pre class="bg-dark text-white p-2 rounded mt-1 mb-0" style="font-size:0.8rem;"><code>sudo systemctl start firebot-daemon
sudo systemctl enable firebot-daemon</code></pre>
                        </li>
                        <li>Im Dashboard erscheint der RootServer als <span class="badge bg-success-lt">Online</span>, sobald der Daemon verbunden ist.</li>
                    </ol>
                </div>

            </div>

            <div class="modal-footer">
                <span class="text-secondary me-auto">
                    <i class="fa-solid fa-circle-info me-1"></i>
                    API-Key ist in der Datenbank gehasht – nicht wiederherstellbar.
                </span>
                <button type="button" class="btn btn-success" id="setup-continue-btn"
                        onclick="window.location.href = this.getAttribute('data-redirect') || window.location.href.replace('/create','')">
                    <i class="fa-solid fa-arrow-right me-1"></i>
                    Zur RootServer-Übersicht
                </button>
            </div>

        </div>
    </div>
</div>

<script>
function copyFieldValue(id) {
    const el = document.getElementById(id);
    if (!el) return;
    el.select();
    document.execCommand('copy');
    window.getSelection && window.getSelection().removeAllRanges();
    // Kurzes visuelles Feedback
    const orig = el.style.borderColor;
    el.style.borderColor = '#28a745';
    setTimeout(() => { el.style.borderColor = orig; }, 800);
}

// Datenbanken-Schalter: die Anzahl je Gameserver ist nur sinnvoll, wenn
// Datenbanken überhaupt angeboten werden.
//
// (Das FastDL-URL-Feld stand hier bis zum 2026-08-20. Es ist entfallen: Die
// Adresse ergibt sich aus der Maschine — geprüfter Name oder IP —, sie ist
// nichts, was jemand tippt und niemand nachprüft.)
const dbSchalter = document.getElementById('dbGewuenscht');
const dbAnzahl   = document.getElementById('dbJeServer');
if (dbSchalter && dbAnzahl) {
    const nachfuehren = () => {
        dbAnzahl.disabled = !dbSchalter.checked;
        if (!dbSchalter.checked) dbAnzahl.value = 0;
        else if (Number(dbAnzahl.value) === 0) dbAnzahl.value = 1;
    };
    dbSchalter.addEventListener('change', nachfuehren);
    nachfuehren();
}

// ==========================================
// Server-Typ Toggle: Dropdown vs. Textfeld
// ==========================================
const serverTypeExisting = document.getElementById('serverTypeExisting');
const serverTypeNew = document.getElementById('serverTypeNew');

if (serverTypeExisting && serverTypeNew) {
    const hostDropdown = document.getElementById('hostDropdown');
    const hostInput = document.getElementById('hostInput');
    const hostHelpExisting = document.getElementById('hostHelpExisting');
    const hostHelpNew = document.getElementById('hostHelpNew');

    function toggleHostInput() {
        if (serverTypeNew.checked) {
            // Neuer physischer RootServer → Textfeld anzeigen
            hostDropdown.style.display = 'none';
            hostDropdown.removeAttribute('name'); // nicht submitten
            hostInput.style.display = 'block';
            hostInput.setAttribute('name', 'host'); // dieses Feld submitten
            hostInput.setAttribute('required', 'required');
            hostHelpExisting.style.display = 'none';
            hostHelpNew.style.display = 'block';
        } else {
            // Virtueller RootServer auf bestehendem Daemon → Dropdown
            hostDropdown.style.display = 'block';
            hostDropdown.setAttribute('name', 'host'); // dieses Feld submitten
            hostInput.style.display = 'none';
            hostInput.removeAttribute('name'); // nicht submitten
            hostInput.removeAttribute('required');
            hostHelpExisting.style.display = 'block';
            hostHelpNew.style.display = 'none';
        }
    }

    serverTypeExisting.addEventListener('change', toggleHostInput);
    serverTypeNew.addEventListener('change', toggleHostInput);

    // Initial state (default: existing)
    toggleHostInput();
}
</script>
