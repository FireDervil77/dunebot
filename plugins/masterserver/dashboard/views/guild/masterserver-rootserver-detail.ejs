                                    </div>
                                    <div class="col-md-2">
                                        <button class="btn btn-success w-100" onclick="addIP()">
                                            <i class="fa-solid fa-plus me-1"></i>Hinzufügen
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <%# Ein HTML-Kommentar geht mit an den Browser und steht im
                        Quelltext der Seite. Ein fremder Produktname hat dort
                        nichts verloren - als EJS-Kommentar bleibt die Notiz
                        hier (2026-09-08). %>
                    <%# Tab: Port-Verwaltung %>
