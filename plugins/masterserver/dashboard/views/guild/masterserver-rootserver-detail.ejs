<!-- RootServer Detail-Seite -->


        <div class="row mb-3">
            <div class="col-12">
                <a href="/guild/<%= guildId %>/plugins/masterserver/rootservers" class="btn btn-secondary btn-sm">
                    <i class="fa-solid fa-arrow-left me-1"></i>Zurück zur Übersicht
                </a>
            </div>
        </div>

        <!-- Live-Resource-Widgets -->
        <div class="row mb-3" id="resource-widgets">

            <!-- CPU Widget -->
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card h-100 mb-0">
                    <div class="card-status-top bg-<%= isOnline ? 'success' : 'secondary' %>"></div>
                    <div class="card-header py-2 px-3">
                        <h3 class="card-title text-sm mb-0">
                            <i class="fa-solid fa-microchip me-1"></i>CPU
                        </h3>
                        <div class="card-actions">
                            <% if (rootserver.cpu_model) { %>
                                <small class="text-secondary" title="<%= rootserver.cpu_model %>" style="font-size:.7rem;">
                                    <%= rootserver.cpu_model.length > 22 ? rootserver.cpu_model.substring(0,22)+'…' : rootserver.cpu_model %>
                                </small>
                            <% } %>
                        </div>
                    </div>
                    <div class="card-body text-center py-3">
                        <div class="position-relative d-inline-block mb-2" style="width:80px;height:80px;">
                            <svg viewBox="0 0 36 36" style="transform:rotate(-90deg);width:80px;height:80px;">
                                <circle cx="18" cy="18" r="15.9" fill="none" stroke="#e9ecef" stroke-width="3.2"/>
                                <circle cx="18" cy="18" r="15.9" fill="none" stroke="#28a745" stroke-width="3.2"
                                        stroke-dasharray="0 100" id="cpu-ring"
                                        style="transition:stroke-dasharray .5s ease,stroke .3s ease;"/>
                            </svg>
                            <div class="position-absolute d-flex align-items-center justify-content-center"
                                 style="top:0;left:0;right:0;bottom:0;">
                                <span id="cpu-pct" class="fw-bold" style="font-size:1.1rem;">
                                    <%= rootserver.cpu_usage_percent != null ? Math.round(rootserver.cpu_usage_percent)+'%' : '–' %>
                                </span>
                            </div>
                        </div>
                        <div class="text-sm text-secondary" style="font-size:.8rem;">
                            <%= rootserver.cpu_cores ? rootserver.cpu_cores + ' Kerne' : '' %><% if (rootserver.cpu_threads) { %> · <%= rootserver.cpu_threads %> Threads<% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RAM Widget -->
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card h-100 mb-0">
                    <div class="card-status-top bg-info"></div>
                    <div class="card-header py-2 px-3">
                        <h3 class="card-title text-sm mb-0"><i class="fa-solid fa-memory me-1"></i>RAM</h3>
                    </div>
                    <div class="card-body text-center py-3">
                        <div class="position-relative d-inline-block mb-2" style="width:80px;height:80px;">
                            <svg viewBox="0 0 36 36" style="transform:rotate(-90deg);width:80px;height:80px;">
                                <circle cx="18" cy="18" r="15.9" fill="none" stroke="#e9ecef" stroke-width="3.2"/>
                                <circle cx="18" cy="18" r="15.9" fill="none" stroke="#17a2b8" stroke-width="3.2"
                                        stroke-dasharray="0 100" id="ram-ring"
                                        style="transition:stroke-dasharray .5s ease,stroke .3s ease;"/>
                            </svg>
                            <div class="position-absolute d-flex align-items-center justify-content-center"
                                 style="top:0;left:0;right:0;bottom:0;">
                                <span id="ram-pct" class="fw-bold" style="font-size:1.1rem;">–</span>
                            </div>
                        </div>
                        <div class="text-secondary" id="ram-detail" style="font-size:.8rem;">
                            <%
                                const ramUsed = rootserver.ram_usage_gb != null ? parseFloat(rootserver.ram_usage_gb).toFixed(1) : null;
                                const ramTot  = rootserver.ram_total_gb != null ? parseFloat(rootserver.ram_total_gb).toFixed(1) : null;
                            %>
                            <% if (ramUsed && ramTot) { %><%= ramUsed %> / <%= ramTot %> GB<% } else if (ramTot) { %><%= ramTot %> GB<% } else { %>–<% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Disk Widget -->
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card h-100 mb-0">
                    <div class="card-status-top bg-warning"></div>
                    <div class="card-header py-2 px-3">
                        <h3 class="card-title text-sm mb-0"><i class="fa-solid fa-hard-drive me-1"></i>Disk</h3>
                    </div>
                    <div class="card-body text-center py-3">
                        <div class="position-relative d-inline-block mb-2" style="width:80px;height:80px;">
                            <svg viewBox="0 0 36 36" style="transform:rotate(-90deg);width:80px;height:80px;">
                                <circle cx="18" cy="18" r="15.9" fill="none" stroke="#e9ecef" stroke-width="3.2"/>
                                <circle cx="18" cy="18" r="15.9" fill="none" stroke="#fd7e14" stroke-width="3.2"
                                        stroke-dasharray="0 100" id="disk-ring"
                                        style="transition:stroke-dasharray .5s ease,stroke .3s ease;"/>
                            </svg>
                            <div class="position-absolute d-flex align-items-center justify-content-center"
                                 style="top:0;left:0;right:0;bottom:0;">
                                <span id="disk-pct" class="fw-bold" style="font-size:1.1rem;">–</span>
                            </div>
                        </div>
                        <div class="text-secondary" id="disk-detail" style="font-size:.8rem;">
                            <%
                                const diskUsed = rootserver.disk_usage_gb != null ? Math.round(rootserver.disk_usage_gb) : null;
                                const diskTot  = rootserver.disk_total_gb != null ? Math.round(rootserver.disk_total_gb) : null;
                            %>
                            <% if (diskUsed && diskTot) { %><%= diskUsed %> / <%= diskTot %> GB<% } else if (diskTot) { %><%= diskTot %> GB<% } else { %>–<% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Daemon/Gameserver-Widget -->
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card h-100 mb-0">
                    <div class="card-status-top bg-primary"></div>
                    <div class="card-header py-2 px-3">
                        <h3 class="card-title text-sm mb-0"><i class="fa-solid fa-plug me-1"></i>Daemon</h3>
                    </div>
                    <div class="card-body text-center py-3">
                        <div class="mb-2">
                            <span class="badge bg-<%= isOnline ? 'success' : 'secondary' %>-lt" style="font-size:.9rem;padding:.4em .8em;">
                                <i class="fa-solid fa-circle me-1" style="font-size:.6rem;"></i><%= isOnline ? 'Online' : 'Offline' %>
                            </span>
                            <% if (rootserver.daemon_version) { %>
                                <div class="text-secondary mt-1" style="font-size:.8rem;">v<%= rootserver.daemon_version %></div>
                            <% } %>
                        </div>
                        <hr class="my-2">
                        <div>
                            <strong><%= gameserverStats.total || 0 %></strong>
                            <div class="text-secondary" style="font-size:.75rem;">Gameserver</div>
                            <% if (gameserverStats.running > 0) { %>
                                <span class="badge bg-success-lt mt-1" style="font-size:.7rem;"><i class="fa-solid fa-play me-1"></i><%= gameserverStats.running %> laufend</span>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <%#
          Was diese Maschine kann — Absicht, Messung, Fähigkeit (M-1 bis M-6).

          Der Grund steht bewusst NEBEN jedem „nein". Ein blosses Kreuz schickt
          den Betreiber ins Dunkle; „Port 80 ist von einem fremden Dienst belegt"
          sagt ihm, wo er nachsehen muss. Genau daran ist der alte Bau
          gescheitert: Vier Felder versprachen etwas, und keines sagte je, warum
          es nicht eintrat.
        -%>
        <div class="card mb-3">
            <div class="card-status-top bg-azure"></div>
            <div class="card-header py-2 px-3">
                <h3 class="card-title text-sm mb-0">
                    <i class="fa-solid fa-clipboard-check me-1"></i>Was diese Maschine kann
                </h3>
                <div class="card-actions">
                    <span class="text-secondary" style="font-size:.75rem;">
                        <% if (rootserver.fqdn_geprueft_am) { %>
                            gemessen beim letzten Verbinden
                        <% } else { %>
                            noch nichts gemeldet — der Daemon war noch nicht verbunden
                        <% } %>
                    </span>
                </div>
            </div>
            <div class="card-body py-2 px-3">
                <div class="row g-3">

                    <%# ── Adresse ───────────────────────────────────────── %>
                    <div class="col-md-6">
                        <div class="text-secondary" style="font-size:.75rem;">Adresse</div>
                        <% if (rootserver.fqdn_gilt) { %>
                            <div><span class="badge bg-success-lt"><i class="fa-solid fa-check me-1"></i>Name gilt</span>
                                 <strong class="ms-1"><%= rootserver.fqdn %></strong></div>
                        <% } else { %>
                            <div><span class="badge bg-secondary-lt">es gilt die IP</span>
                                 <strong class="ms-1"><%= rootserver.host %></strong></div>
                        <% } %>
                        <% if (rootserver.fqdn_grund) { %>
                            <div class="text-secondary mt-1" style="font-size:.78rem;"><%= rootserver.fqdn_grund %></div>
                        <% } %>
                    </div>

                    <%# ── Webserver ─────────────────────────────────────── %>
                    <div class="col-md-6">
                        <div class="text-secondary" style="font-size:.75rem;">Webserver</div>
                        <div><strong><%= rootserver.webserver || 'unbekannt' %></strong></div>
                        <% if (rootserver.webserver_grund) { %>
                            <div class="text-secondary mt-1" style="font-size:.78rem;"><%= rootserver.webserver_grund %></div>
                        <% } %>
                    </div>

                    <%# ── FastDL ────────────────────────────────────────── %>
                    <div class="col-md-6">
                        <div class="text-secondary" style="font-size:.75rem;">FastDL</div>
                        <div>
                            <% if (!rootserver.fastdl_enabled) { %>
                                <span class="badge bg-secondary-lt">nicht angefordert</span>
                            <%# „Geht nicht" darf erst stehen, wenn jemand nachgesehen hat. Vorher
                                waere es dieselbe Sorte Behauptung, die dieses ganze Papier aufraeumt. -%>
                            <% } else if (!rootserver.fqdn_geprueft_am) { %>
                                <span class="badge bg-secondary-lt">noch nicht gemessen</span>
                            <% } else if (rootserver.fastdl_moeglich) { %>
                                <span class="badge bg-success-lt"><i class="fa-solid fa-check me-1"></i>möglich</span>
                            <% } else { %>
                                <span class="badge bg-warning-lt"><i class="fa-solid fa-triangle-exclamation me-1"></i>angefordert, geht nicht</span>
                            <% } %>
                        </div>
                        <% if (rootserver.fastdl_grund) { %>
                            <div class="text-secondary mt-1" style="font-size:.78rem;"><%= rootserver.fastdl_grund %></div>
                        <% } %>
                    </div>

                    <%# ── Datenbanken ───────────────────────────────────── %>
                    <div class="col-md-6">
                        <div class="text-secondary" style="font-size:.75rem;">Datenbanken</div>
                        <div>
                            <% if (!rootserver.db_gewuenscht) { %>
                                <span class="badge bg-secondary-lt">nicht angefordert</span>
                            <% } else if (!rootserver.fqdn_geprueft_am) { %>
                                <span class="badge bg-secondary-lt">noch nicht gemessen</span>
                            <% } else if (rootserver.db_moeglich) { %>
                                <span class="badge bg-success-lt"><i class="fa-solid fa-check me-1"></i>möglich</span>
                                <span class="text-secondary ms-1" style="font-size:.78rem;">
                                    max. <%= rootserver.db_je_server %> je Gameserver
                                </span>
                            <% } else { %>
                                <span class="badge bg-warning-lt"><i class="fa-solid fa-triangle-exclamation me-1"></i>angefordert, geht nicht</span>
                            <% } %>
                        </div>
                        <% if (rootserver.db_grund) { %>
                            <div class="text-secondary mt-1" style="font-size:.78rem;"><%= rootserver.db_grund %></div>
                        <% } %>
                        <%# Image-Stand (K318, Daemon ab 1.1.20). `dbBetroffen` mit typeof:
                            Die Ansicht gilt sofort, die Route erst nach dem Neustart. -%>
                        <% if (rootserver.db_image) { %>
                            <div class="text-secondary mt-1" style="font-size:.78rem;">Image <code><%= rootserver.db_image %></code></div>
                        <% } %>
                        <% if (rootserver.db_wechsel) { %>
                            <div class="text-danger mt-1" style="font-size:.78rem;"><i class="fa-solid fa-triangle-exclamation me-1"></i>Letzter Wechsel <%= rootserver.db_wechsel %></div>
                        <% } %>
                        <% if (rootserver.db_gewuenscht && rootserver.db_image_neu) { %>
                            <% const betroffen = (typeof dbBetroffen !== 'undefined' && Array.isArray(dbBetroffen)) ? dbBetroffen : []; %>
                            <div class="alert alert-info mt-2 mb-0 py-2" style="font-size:.8rem;" id="dbImageWechsel">
                                <div><i class="fa-solid fa-circle-arrow-up me-1"></i>Ein neueres Datenbank-Image liegt bereit:
                                    <code><%= rootserver.db_image || '?' %></code> → <code><%= rootserver.db_image_neu %></code></div>
                                <div class="mt-1">Beim Wechsel wird der Container ersetzt. Die Daten und das Kennwort bleiben,
                                    die Spiele mit Datenbank sind einige Sekunden ohne sie. Startet der neue nicht, kommt der alte zurück.</div>
                                <div class="mt-1">
                                    <% if (betroffen.length) { %>
                                        Laufen gerade und haben eine Datenbank:
                                        <% betroffen.forEach(function (g, i) { %><%= i ? ', ' : '' %><strong><%= g.name %></strong> (#<%= g.id %>)<% }) %>
                                    <% } else { %>
                                        Gerade läuft kein Server dieser Maschine mit Datenbank.
                                    <% } %>
                                </div>
                                <div class="mt-2 d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-primary" id="dbImageWechselKnopf">
                                        <i class="fa-solid fa-rotate me-1"></i>Jetzt wechseln
                                    </button>
                                    <button type="button" class="btn btn-sm btn-danger d-none" id="dbImageWechselJa">
                                        <i class="fa-solid fa-check me-1"></i>Ja, jetzt wechseln
                                    </button>
                                </div>
                            </div>
                        <% } %>
                    </div>

                    <%# ── SFTP für externe Programme (2026-10-27) ────────── %>
                    <div class="col-md-6">
                        <div class="text-secondary" style="font-size:.75rem;">SFTP (eigene Programme)</div>
                        <div>
                            <% if (!rootserver.sftp_gewuenscht && !rootserver.sftp_port) { %>
                                <span class="badge bg-secondary-lt">nicht angefordert</span>
                            <% } else if (rootserver.sftp_moeglich === null || rootserver.sftp_moeglich === undefined) { %>
                                <span class="badge bg-secondary-lt">noch nicht gemeldet</span>
                            <% } else if (rootserver.sftp_moeglich) { %>
                                <span class="badge bg-success-lt"><i class="fa-solid fa-check me-1"></i>möglich</span>
                            <% } else { %>
                                <span class="badge bg-warning-lt"><i class="fa-solid fa-triangle-exclamation me-1"></i><%= rootserver.sftp_gewuenscht ? 'angefordert, geht nicht' : 'läuft, nicht angefordert' %></span>
                            <% } %>
                        </div>
                        <% if (rootserver.sftp_grund) { %>
                            <div class="text-secondary mt-1" style="font-size:.78rem;"><%= rootserver.sftp_grund %></div>
                        <% } %>
                    </div>

                    <%#
                      Die Warnung, die alles andere entwertet, wenn sie zutrifft.
                      Auf einer containervirtualisierten Maschine zeigen
                      /proc/cpuinfo und /proc/meminfo den WIRT — eine
                      4-GB-Maschine meldet dann 128 GB. Und genau diese Zahlen
                      sind seit M-6 die Kapazität, mit der gerechnet wird.
                    -%>
                    <% const containerArten = ['lxc','lxc-libvirt','openvz','docker','podman','systemd-nspawn'];
                       if (rootserver.virtualisierung && containerArten.includes(String(rootserver.virtualisierung).toLowerCase())) { %>
                        <div class="col-12">
                            <div class="alert alert-warning mb-0 py-2">
                                <strong>Containervirtualisierung erkannt (<%= rootserver.virtualisierung %>).</strong>
                                Auf solchen Maschinen melden die Systemdateien die Werte des Wirts, nicht den
                                Mietanteil. Die angezeigte Kapazität kann weit danebenliegen — prüfe sie gegen
                                das, was du gebucht hast, und trage bei Bedarf unter <strong>Ressourcen</strong>
                                eine feste Grenze ein.
                            </div>
                        </div>
                    <% } else if (rootserver.virtualisierung) { %>
                        <div class="col-12">
                            <div class="text-secondary" style="font-size:.75rem;">
                                Virtualisierung: <%= rootserver.virtualisierung %> — die gemessenen Hardwarewerte
                                gelten für diese Maschine.
                            </div>
                        </div>
                    <% } %>

                </div>
            </div>
        </div>

        <!-- Tabs -->
        <div class="card">
            <div class="card-status-top bg-primary"></div>
            <div class="card-header p-0 pt-1">
                <ul class="nav nav-tabs" id="rootserverTabs">
                    <li class="nav-item">
                        <a class="nav-link active" data-bs-toggle="tab" href="#tab-overview">
                            <i class="fa-solid fa-chart-line me-1"></i>Übersicht
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#tab-settings">
                            <i class="fa-solid fa-sliders me-1"></i>Einstellungen
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#tab-daemon">
                            <i class="fa-solid fa-terminal me-1"></i>Daemon-Info
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#tab-network" id="tab-network-link">
                            <i class="fa-solid fa-network-wired me-1"></i>Netzwerk / IPs
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#tab-allocations" id="tab-allocations-link">
                            <i class="fa-solid fa-plug me-1"></i>Allocations
                            <span class="badge bg-secondary-lt ms-1" id="alloc-count-badge" style="font-size:.7rem;">0</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-danger" data-bs-toggle="tab" href="#tab-danger">
                            <i class="fa-solid fa-triangle-exclamation me-1"></i>Gefahrenzone
                        </a>
                    </li>
                </ul>
            </div>
            <div class="card-body">
                <div class="tab-content">

                    <!-- Tab: Übersicht -->
                    <div class="tab-pane fade show active" id="tab-overview">
                        <div class="row">
                            <div class="col-md-6">
                                <table class="table table-sm table-borderless">
                                    <tbody>
                                        <tr>
                                            <td class="text-secondary" width="40%">Name</td>
                                            <td><strong><%= rootserver.name %></strong></td>
                                        </tr>
                                        <% if (rootserver.description) { %>
                                        <tr>
                                            <td class="text-secondary">Beschreibung</td>
                                            <td><%= rootserver.description %></td>
                                        </tr>
                                        <% } %>
                                        <tr>
                                            <td class="text-secondary">Host / IP</td>
                                            <td><code><%= rootserver.host || '–' %></code></td>
                                        </tr>
                                        <tr>
                                            <td class="text-secondary">Hostname</td>
                                            <td><%= rootserver.hostname || '–' %></td>
                                        </tr>

                                        <tr>
                                            <td class="text-secondary">Standort</td>
                                            <td>
                                                <%= rootserver.datacenter || '–' %>
                                                <% if (rootserver.country_code) { %>
                                                    <span class="badge bg-light-lt ms-1"><%= rootserver.country_code %></span>
                                                <% } %>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-secondary">Disk</td>
                                            <td><%= rootserver.disk_total_gb ? rootserver.disk_total_gb + ' GB' : '–' %></td>
                                        </tr>
                                        <tr>
                                            <td class="text-secondary">Erstellt</td>
                                            <td><%= rootserver.created_at ? new Date(rootserver.created_at).toLocaleString('de-DE') : '–' %></td>
                                        </tr>
                                        <tr>
                                            <td class="text-secondary">Zuletzt gesehen</td>
                                            <td><%= rootserver.last_seen ? new Date(rootserver.last_seen).toLocaleString('de-DE') : 'Noch nie verbunden' %></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="col-md-6">
                                <% if (!isOnline) { %>
                                    <div class="alert alert-warning">
                                        <h6><i class="fa-solid fa-triangle-exclamation me-1"></i>Daemon offline</h6>
                                        <p class="mb-2">Der Daemon ist nicht verbunden. Prüfe ob der Service auf dem Server läuft:</p>
                                        <pre class="bg-dark text-white p-2 rounded" style="font-size:0.8rem;"><code>sudo systemctl status firebot-daemon
sudo journalctl -u firebot-daemon -n 50</code></pre>
                                    </div>
                                <% } else { %>
                                    <div class="alert alert-success">
                                        <h6><i class="fa-solid fa-circle-check me-1"></i>Daemon verbunden</h6>
                                        <p class="mb-0">Der Daemon ist online und bereit. Gameserver können erstellt werden.</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- Gameserver-Auslastung -->
                        <% if (typeof gameservers !== 'undefined' && gameservers.length > 0) { %>
                        <hr class="my-3">
                        <h5 class="mb-3"><i class="fa-solid fa-chart-bar me-2"></i>Gameserver-Auslastung</h5>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover" id="gs-metrics-table">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Server</th>
                                        <th>Status</th>
                                        <th style="width:25%">CPU</th>
                                        <th style="width:25%">RAM</th>
                                        <th>Spieler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% for (const gs of gameservers) { 
                                        const gsStatusColors = { online: 'success', offline: 'secondary', starting: 'warning', stopping: 'warning', error: 'danger' };
                                        const gsColor = gsStatusColors[gs.status] || 'secondary';
                                        const cpuPct = gs.cpu_percent != null ? parseFloat(gs.cpu_percent) : null;
                                        const ramUsed = gs.ram_used_mb != null ? parseInt(gs.ram_used_mb) : null;
                                        const ramTotal = gs.ram_total_mb != null ? parseInt(gs.ram_total_mb) : null;
                                        const ramPct = (ramUsed && ramTotal && ramTotal > 0) ? Math.round(ramUsed / ramTotal * 100) : null;
                                        const players = gs.current_players != null ? gs.current_players : 0;
                                        const maxPlayers = gs.max_players || '?';
                                    %>
                                    <tr data-gs-id="<%= gs.server_id %>">
                                        <td>
                                            <strong><%= gs.display_name || gs.server_name %></strong>
                                            <% if (gs.game_name) { %>
                                                <br><small class="text-secondary"><%= gs.game_name %></small>
                                            <% } %>
                                        </td>
                                        <td>
                                            <span class="badge bg-<%= gsColor %>-lt" data-gs-status>
                                                <%= gs.status %>
                                            </span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="progress flex-grow-1 me-2" style="height:16px;">
                                                    <div class="progress-bar bg-<%= cpuPct != null && cpuPct >= 80 ? 'danger' : cpuPct != null && cpuPct >= 60 ? 'warning' : 'success' %>"
                                                         role="progressbar"
                                                         style="width: <%= cpuPct != null ? cpuPct : 0 %>%"
                                                         data-gs-cpu-bar></div>
                                                </div>
                                                <small class="text-nowrap" data-gs-cpu-text><%= cpuPct != null ? cpuPct.toFixed(1) + '%' : '–' %></small>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="progress flex-grow-1 me-2" style="height:16px;">
                                                    <div class="progress-bar bg-<%= ramPct != null && ramPct >= 85 ? 'danger' : ramPct != null && ramPct >= 65 ? 'warning' : 'info' %>"
                                                         role="progressbar"
                                                         style="width: <%= ramPct != null ? ramPct : 0 %>%"
                                                         data-gs-ram-bar></div>
                                                </div>
                                                <small class="text-nowrap" data-gs-ram-text>
                                                    <% if (ramUsed != null && ramTotal != null) { %>
                                                        <%= (ramUsed / 1024).toFixed(1) %> / <%= (ramTotal / 1024).toFixed(1) %> GB
                                                    <% } else { %>
                                                        –
                                                    <% } %>
                                                </small>
                                            </div>
                                        </td>
                                        <td>
                                            <span data-gs-players><%= players %> / <%= maxPlayers %></span>
                                        </td>
                                    </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                        <% } else { %>
                        <hr class="my-3">
                        <div class="text-center text-secondary py-3">
                            <i class="fa-solid fa-server fa-2x mb-2 d-block"></i>
                            Noch keine Gameserver auf diesem RootServer.
                        </div>
                        <% } %>
                    </div>

                    <!-- Tab: Einstellungen -->
                    <div class="tab-pane fade" id="tab-settings">
                        <form class="guild-ajax-form"
                              data-form-type="update-rootserver"
                              data-method="PUT"
                              action="/guild/<%= guildId %>/plugins/masterserver/rootservers/<%= rootserver.id %>"
                              method="POST">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label>Name</label>
                                        <input type="text" class="form-control" name="name" value="<%= rootserver.name %>" required>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label>Hostname / FQDN</label>
                                        <input type="text" class="form-control" name="hostname" value="<%= rootserver.hostname || '' %>" placeholder="server01.example.com">
                                    </div>
                                </div>
                            </div>
