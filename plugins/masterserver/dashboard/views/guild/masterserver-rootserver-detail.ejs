                    </div>

                    <!-- Tab: Daemon-Info -->
                    <div class="tab-pane fade" id="tab-daemon">
                        <div class="row">
                            <div class="col-md-6">
                                <table class="table table-sm table-borderless">
                                    <tbody>
                                        <tr>
                                            <td class="text-secondary" width="40%">Daemon-ID</td>
                                            <td><code style="font-size:0.8rem;word-break:break-all;"><%= rootserver.daemon_id %></code></td>
                                        </tr>
                                        <tr>
                                            <td class="text-secondary">Version</td>
                                            <td><%= rootserver.daemon_version || '–' %></td>
                                        </tr>
                                        <tr>
                                            <td class="text-secondary">Install-Status</td>
                                            <td>
                                                <span class="badge bg-<%= rootserver.install_status === 'completed' ? 'success' : rootserver.install_status === 'pending' ? 'warning' : 'danger' %>-lt">
                                                    <%= rootserver.install_status || 'unknown' %>
                                                </span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <%# Rundlauf Daemon → Panel → Daemon, vom Daemon gemessen (K346); „–" solange keine Messung vorliegt (Fassung vor 1.1.24). %>
                                            <td class="text-secondary">Letzter Ping</td>
                                            <td id="rs-ping" title="Herzschlag bis zur Bestätigung des Panels, vom Daemon gemessen"><%= rootserver.last_ping_ms != null ? rootserver.last_ping_ms + ' ms' : '–' %></td>
                                        </tr>
                                        <tr>
                                            <td class="text-secondary">Verpasste Heartbeats</td>
                                            <td><%= rootserver.missed_heartbeats || 0 %></td>
                                        </tr>
                                        <%#
                                          Kein Rueckfall auf einen geratenen Pfad (Baustelle 143).
                                          Hier stand `|| '/opt/firebot-daemon'` — ein Pfad, den es
                                          WIRKLICH gibt, der aber das falsche Ding ist: dort liegt
                                          der Daemon selbst, nicht das Verzeichnis der Kundendaten.
                                          Ein nicht existierender Pfad faellt beim ersten `ls` auf;
                                          ein existierender mit anderer Bedeutung fuehrt jemanden
                                          bis in ein `rm` hinein. Gemeldet wird er vom Daemon seit
                                          1.0.75; solange nichts kam, sagt die Zeile das.
                                        %>
                                        <tr>
                                            <td class="text-secondary">Basis-Verzeichnis</td>
                                            <td>
                                                <% if (rootserver.base_directory) { %>
                                                    <code><%= rootserver.base_directory %></code>
                                                <% } else { %>
                                                    <span class="text-secondary">vom Daemon nicht gemeldet
                                                        <small>(ab Daemon 1.0.75)</small></span>
                                                <% } %>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-secondary">Betriebssystem</td>
                                            <td><%= rootserver.os_info || '–' %></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="col-md-6">
                                <div class="alert alert-info">
                                    <h6><i class="fa-solid fa-circle-info me-1"></i>Service-Befehle</h6>
                                    <pre class="bg-dark text-white p-2 rounded mb-0" style="font-size:0.8rem;"><code>sudo systemctl status firebot-daemon
sudo systemctl restart firebot-daemon
sudo journalctl -u firebot-daemon -f</code></pre>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tab: Netzwerk / IPs -->
                    <div class="tab-pane fade" id="tab-network">
                        <p class="text-secondary mb-3">
                            <i class="fa-solid fa-circle-info me-1"></i>
                            Alle IP-Adressen dieses Servers. Jede IP muss bereits auf dem Host konfiguriert sein (eth0, eth1, ...).
                            Bei der Gameserver-Erstellung kannst du dann wählen, auf welcher IP der Server lauscht.
                        </p>

                        <!-- Primäre IP (aus Host-Feld) -->
