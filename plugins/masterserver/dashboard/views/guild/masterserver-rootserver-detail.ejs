                                <label for="editSftpPort">SFTP-Port</label>
                                <input type="number" class="form-control" id="editSftpPort" name="sftp_port_wunsch" min="1024" max="65535" placeholder="2022" value="<%= rootserver.sftp_port_wunsch || '' %>">
                                <small class="form-text text-secondary">Leer = 2022. Ändern trennt die gespeicherten Profile aller Nutzer dieser Maschine.</small>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-save me-1"></i>Speichern
                            </button>
