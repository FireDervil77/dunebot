                            <h5><i class="fa-solid fa-triangle-exclamation me-2"></i>RootServer löschen</h5>
                            <p class="mb-3">Diese Aktion löscht den RootServer permanent und kann <strong>nicht rückgängig gemacht werden</strong>.</p>
                            <p class="text-secondary" style="font-size:.85rem;">Alle zugehörigen Gameserver müssen vorher entfernt werden.</p>
                            <button class="btn btn-danger" id="rootserverLoeschenOeffnen">
                                <i class="fa-solid fa-trash me-1"></i><%= rootserver.name %> löschen
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </div>


<%# Rückfrage nach Vorlage #logsLoeschenModal: Name eintippen. %>
<div class="modal modal-blur fade" id="tokenErneuernModal" tabindex="-1" aria-labelledby="tokenErneuernTitel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content border border-warning border-2">
      <div class="modal-status bg-warning"></div>
      <div class="modal-header">
        <h5 class="modal-title fw-bold" id="tokenErneuernTitel">
          <i class="fa-solid fa-key me-2"></i>Token von „<%= rootserver.name %>" erneuern
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
      </div>
      <div class="modal-body">
        <p class="mb-3">Der Daemon bekommt einen neuen Token und verbindet sich einmal neu. Der alte Token taugt danach zu nichts mehr, auch nicht für eine neue Einrichtung mit der alten daemon.yaml.</p>
        <label class="form-label fw-bold" for="tokenErneuernEingabe">
          Zum Bestätigen eintippen: <span class="font-monospace" id="tokenErneuernSoll"><%= rootserver.name %></span>
        </label>
        <input type="text" class="form-control font-monospace" id="tokenErneuernEingabe" autocomplete="off" spellcheck="false">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-link link-secondary me-auto" data-bs-dismiss="modal">Abbrechen</button>
        <button type="button" class="btn btn-warning fw-bold" id="tokenErneuernKnopf" disabled>
          <i class="fa-solid fa-key me-1"></i>Erneuern
        </button>
      </div>
    </div>
  </div>
</div>

<%# Zerstörende Rückfragen nach Vorlage #paketEntfernenModal: rot, fett, Name eintippen (K348). Bis 2026-11-12 fragten beide mit confirm(). %>
<%# Sperre (K375): Umzugsverlauf an der Maschine. Die Variable ist neu, deshalb mit typeof gelesen. Eingabe und Knopf werden immer gerendert und nur gesperrt. %>
<% const verlaufSperre = (typeof umzugsverlauf !== 'undefined' && Array.isArray(umzugsverlauf)) ? umzugsverlauf : []; %>
<div class="modal modal-blur fade" id="rootserverLoeschenModal" data-gesperrt="<%= verlaufSperre.length > 0 ? '1' : '0' %>" tabindex="-1" aria-labelledby="rootserverLoeschenTitel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content border border-danger border-2">
      <div class="modal-status bg-danger"></div>
      <div class="modal-header bg-danger-lt">
        <h5 class="modal-title text-danger fw-bold" id="rootserverLoeschenTitel">
          <i class="fa-solid fa-triangle-exclamation me-2"></i>RootServer ENDGÜLTIG löschen
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
      </div>
      <div class="modal-body">
        <p class="text-danger fw-bold fs-3 mb-2">„<%= rootserver.name %>" wird aus dem Panel entfernt.</p>
        <p class="text-danger fw-bold mb-3">Das lässt sich nicht zurücknehmen.</p>
        <div class="fw-bold mb-1">Es gehen mit:</div>
        <ul class="mb-3">
          <li>alle Zusatz-IPs, Portbuchungen und Kontingente dieser Maschine</li>
          <li>ihr Eintrag beim Daemon, wenn er gerade verbunden ist — die Maschine müsste danach neu eingerichtet werden</li>
        </ul>
        <p class="mb-3">Geht nur, solange kein Gameserver mehr auf der Maschine liegt.</p>
        <% if (verlaufSperre.length > 0) { %>
        <div class="alert alert-danger" id="rootserverLoeschenSperre" role="alert">
          <div class="fw-bold mb-1"><i class="fa-solid fa-lock me-2"></i>Gesperrt: An dieser Maschine hängt ein Umzugsverlauf.</div>
          <ul class="mb-2">
            <% verlaufSperre.forEach(function (v) { %>
            <li><%= v.name %> — <%= Number(v.umzuege) === 1 ? '1 Umzug' : Number(v.umzuege) + ' Umzüge' %> von oder zu dieser Maschine</li>
            <% }) %>
          </ul>
          <div>Solange es <%= verlaufSperre.length === 1 ? 'diesen Gameserver' : 'diese Gameserver' %> gibt, lässt sich die Maschine nicht löschen — auch wenn <%= verlaufSperre.length === 1 ? 'er' : 'sie' %> inzwischen woanders <%= verlaufSperre.length === 1 ? 'liegt' : 'liegen' %>.</div>
        </div>
        <% } %>
        <label class="form-label fw-bold" for="rootserverLoeschenEingabe">
          Zum Bestätigen den Namen eintippen: <span class="font-monospace text-danger" id="rootserverLoeschenSoll"><%= rootserver.name %></span>
        </label>
        <input type="text" class="form-control font-monospace" id="rootserverLoeschenEingabe" autocomplete="off" spellcheck="false"<%= verlaufSperre.length > 0 ? ' disabled' : '' %>>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-link link-secondary me-auto" data-bs-dismiss="modal">Abbrechen</button>
        <button type="button" class="btn btn-danger fw-bold" id="rootserverLoeschenKnopf" disabled>
          <i class="fa-solid fa-trash me-1"></i>Endgültig löschen
        </button>
      </div>
    </div>
  </div>
</div>

<div class="modal modal-blur fade" id="ipEntfernenModal" tabindex="-1" aria-labelledby="ipEntfernenTitel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content border border-danger border-2">
      <div class="modal-status bg-danger"></div>
      <div class="modal-header bg-danger-lt">
        <h5 class="modal-title text-danger fw-bold" id="ipEntfernenTitel">
          <i class="fa-solid fa-triangle-exclamation me-2"></i>Zusatz-IP ENDGÜLTIG entfernen
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
      </div>
      <div class="modal-body">
        <p class="text-danger fw-bold fs-3 mb-2">„<span id="ipEntfernenAdresse"></span>" wird von „<%= rootserver.name %>" entfernt.</p>
        <p class="text-danger fw-bold mb-3">Das lässt sich nicht zurücknehmen.</p>
        <p class="mb-3">Die Adresse und ihre Bezeichnung verschwinden aus dem Panel; neue Server können sie nicht mehr wählen. Solange ein Gameserver an ihr lauscht, lehnt das Panel das Entfernen ab.</p>
        <label class="form-label fw-bold" for="ipEntfernenEingabe">
          Zum Bestätigen die Adresse eintippen: <span class="font-monospace text-danger" id="ipEntfernenSoll"></span>
        </label>
