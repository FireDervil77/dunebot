<%- include('shared/seitenkopf', {
      plugin:       'leveling',
      vortitel:     tr('leveling:TITEL'),
      titel:        tr('leveling:NAV.NACHRICHTEN'),
      beschreibung: tr('leveling:NACHRICHTEN.BESCHREIBUNG'),
      icon:         'fa-solid fa-bullhorn',
      guildId:      guildId
}) %>

<%# Level-up-Nachricht (LV-1f, F-LV1). Nachricht und Vorschau: Kern-Teil shared/vorlage (G-08). Aussehen der Rangkarte nur unter Bildkarten (G-22). %>
<% if (!einstellungen) { %>
  <%- include('shared/leerzustand', {
        icon:  'fa-solid fa-ranking-star',
        titel: tr('leveling:UEBERSICHT.NICHT_EINGERICHTET'),
        text:  tr('leveling:UEBERSICHT.NICHT_EINGERICHTET_TEXT')
  }) %>
<% } else { %>
  <% if (kanalFehlt) { %>
    <div class="alert alert-warning" role="alert" id="levelingKanalHinweis">
      <i class="fa-solid fa-triangle-exclamation me-2"></i><%= tr('leveling:NACHRICHTEN.KANAL_FEHLT') %>
    </div>
  <% } %>
  <div class="card">
    <div class="card-status-top bg-primary"></div>
    <div class="card-body">
      <form id="levelingNachrichtenForm" onsubmit="return false;">
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label" for="levelingModus"><i class="fa-solid fa-signs-post me-1"></i> <%= tr('leveling:NACHRICHTEN.MODUS') %></label>
            <select class="form-select" id="levelingModus" name="ausgabe_modus">
              <% modi.forEach((m) => { %>
                <option value="<%= m %>" <%= einstellungen.ausgabe_modus === m ? 'selected' : '' %>><%= tr('leveling:NACHRICHTEN.MODUS_' + m.toUpperCase()) %></option>
              <% }); %>
            </select>
            <div class="form-hint" data-modus-hinweis><%= tr('leveling:NACHRICHTEN.MODUS_HINWEIS') %></div>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label" for="levelingKanal"><i class="fa-solid fa-hashtag me-1"></i> <%= tr('leveling:NACHRICHTEN.KANAL') %></label>
            <select class="form-select" id="levelingKanal" name="ausgabe_kanal">
              <option value=""><%= tr('leveling:NACHRICHTEN.KANAL_KEINER') %></option>
              <% let gefunden = false; kanaele.forEach((k) => { if (String(k.id) === String(einstellungen.ausgabe_kanal)) gefunden = true; %>
                <option value="<%= k.id %>" <%= String(k.id) === String(einstellungen.ausgabe_kanal) ? 'selected' : '' %>>#<%= k.name %></option>
              <% }); %>
              <% if (einstellungen.ausgabe_kanal && !gefunden) { %>
                <option value="<%= einstellungen.ausgabe_kanal %>" selected><%= tr('leveling:NACHRICHTEN.KANAL_UNBEKANNT', { id: einstellungen.ausgabe_kanal }) %></option>
              <% } %>
            </select>
            <div class="form-hint"><%= tr('leveling:NACHRICHTEN.KANAL_HINWEIS') %></div>
            <% if (kanaeleFehlen) { %>
              <div class="text-warning small mt-1"><%= tr('leveling:NACHRICHTEN.KANAELE_FEHLEN') %></div>
            <% } %>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <div class="form-check form-switch">
              <input type="checkbox" class="form-check-input" id="levelingNurMeilensteine" name="nur_meilensteine" <%= Number(einstellungen.nur_meilensteine) ? 'checked' : '' %>>
              <label class="form-check-label" for="levelingNurMeilensteine"><%= tr('leveling:NACHRICHTEN.NUR_MEILENSTEINE') %></label>
            </div>
            <input type="text" class="form-control mt-2" id="levelingMeilensteine" name="meilensteine" maxlength="500"
                   value="<%= meilensteine.join(', ') %>" placeholder="5, 10, 25, 50">
            <div class="form-hint"><%= tr('leveling:NACHRICHTEN.MEILENSTEINE_HINWEIS') %></div>
          </div>
          <div class="col-md-6 mb-3">
            <div class="form-check form-switch">
              <input type="checkbox" class="form-check-input" id="levelingRangkarte" name="rangkarte_anhaengen" <%= Number(einstellungen.rangkarte_anhaengen) ? 'checked' : '' %>>
              <label class="form-check-label" for="levelingRangkarte"><%= tr('leveling:NACHRICHTEN.RANGKARTE') %></label>
            </div>
            <div class="form-hint mb-2"><%= tr('leveling:NACHRICHTEN.RANGKARTE_HINWEIS') %></div>
            <a class="btn btn-outline-primary btn-sm" href="/guild/<%= guildId %>/bildkarten/einstellen/leveling/<%= encodeURIComponent('kern:rangkarte') %>">
              <i class="fa-solid fa-id-card me-1"></i> <%= tr('leveling:NACHRICHTEN.RANGKARTE_AUSSEHEN') %>
            </a>
          </div>
        </div>

        <hr>
        <%- include('shared/vorlage', { guildId, tr, teil }) %>

        <div class="d-flex justify-content-end mt-3">
          <button type="button" class="btn btn-primary" id="levelingNachrichtenSpeichern">
            <i class="fa-solid fa-save me-1"></i> <%= tr('leveling:NACHRICHTEN.SPEICHERN') %>
          </button>
        </div>
      </form>
    </div>
  </div>

  <%# Farben (G-09): Kern-Teil mit eigenem Speichern, außerhalb des Formulars. Gilt für /rank, /leaderboard und die Rangkarte. %>
  <div class="mt-3">
    <%- include('shared/plugin-farben', { guildId, tr, plugin: 'leveling' }) %>
  </div>

  <script>
  (function () {
    const knopf = document.getElementById('levelingNachrichtenSpeichern');
    if (!knopf) return;
    const adresse = '/guild/<%= guildId %>/plugins/leveling/nachrichten';
    const meldung = (art, text) => (window.showToast ? window.showToast(art, text) : console[art === 'error' ? 'error' : 'log']('[Leveling]', text));
    knopf.addEventListener('click', async () => {
      const form = document.getElementById('levelingNachrichtenForm');
      const daten = {
        ausgabe_modus: form.querySelector('[name="ausgabe_modus"]').value,
        ausgabe_kanal: form.querySelector('[name="ausgabe_kanal"]').value || null,
        nur_meilensteine: form.querySelector('[name="nur_meilensteine"]').checked,
        meilensteine: form.querySelector('[name="meilensteine"]').value,
        rangkarte_anhaengen: form.querySelector('[name="rangkarte_anhaengen"]').checked,
        vorlage: window.FBVorlage ? window.FBVorlage.lies('leveling:aufstieg') : null,
      };
      knopf.disabled = true;
      try {
        const antwort = await fetch(adresse, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(daten) });
        const e = await antwort.json().catch(() => ({}));
        if (!antwort.ok || !e.success) throw new Error(e.message || antwort.statusText);
        meldung('success', e.message);
        const hinweis = document.getElementById('levelingKanalHinweis');
        if (hinweis) hinweis.classList.toggle('d-none', !e.kanalFehlt);
      } catch (err) {
        meldung('error', err.message);
      } finally {
        knopf.disabled = false;
      }
    });
  })();
  </script>
<% } %>
