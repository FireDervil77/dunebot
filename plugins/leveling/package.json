{
    "name": "leveling",
    "displayName": "Leveling",
    "description": "Community-Level, XP und Ranglisten je Guild",
    "version": "0.1.0",
    "author": "FireBot Team",
    "license": "none",
    "type": "commonjs",
    "peerDependencies": {
        "discord.js": "^14.28.1",
        "express": "^5.1.0",
        "dunebot-core": "*",
        "dunebot-sdk": "*"
    },
    "guildInhalte": {
        "loeschen": [
            "level_einstellungen",
            "level_quellen",
            "level_regeln",
            "level_zaehler",
            "level_belohnungen",
            "level_boosts",
            "level_verlassen"
        ]
    },
    "ereignisse": {
        "sendet": [
            "leveling.level.erreicht",
            "leveling.xp.korrigiert",
            "leveling.belohnung.vergeben",
            "leveling.saison.gewechselt"
        ],
        "hoert": [
            "kern.mitglied.beigetreten",
            "kern.mitglied.verlassen",
            "kern.dashboard.geaendert",
            "kern.termin.anwesenheit",
            "moderation.fall.angelegt",
            "moderation.fall.zurueckgenommen",
            "automod.verstoss",
            "giveaway.teilnahme",
            "ticket.geschlossen",
            "gameserver.spieler.verbunden",
            "gameserver.spieler.getrennt"
        ]
    },
    "mitgliedInhalte": {
        "level_zaehler": {
            "mitglied_id": "loeschen"
        },
        "level_verlassen": {
            "mitglied_id": "loeschen"
        },
        "level_boosts": {
            "akteur": "anonymisieren"
        },
        "level_einstellungen": {
            "ausgabe_kanal": {
                "weg": "ausgenommen",
                "grund": "Level-Kanal der Guild, nie ein Mitglied"
            }
        },
        "level_regeln": {
            "ziel_id": {
                "weg": "ausgenommen",
                "grund": "art ist ENUM(kanal, rolle), nie ein Mitglied"
            }
        },
        "level_belohnungen": {
            "wert": {
                "weg": "ausgenommen",
                "grund": "Rollen-ID der Belohnung, nie ein Mitglied"
            }
        }
    },
    "rollen": [
        {
            "besitzer": "leveling:community",
            "titel": "leveling:ROLLEN.BELOHNUNG",
            "seite": "/plugins/leveling/belohnungen"
        }
    ],
    "vorlagen": {
        "recht": "LEVELING.CONFIGURE",
        "platzhalter": [
            {
                "name": "level",
                "bedeutung": "leveling:VORLAGEN.PH_LEVEL",
                "beispiel": "5"
            },
            {
                "name": "level:vorher",
                "bedeutung": "leveling:VORLAGEN.PH_LEVEL_VORHER",
                "beispiel": "4"
            },
            {
                "name": "level:name",
                "bedeutung": "leveling:VORLAGEN.PH_LEVEL_NAME",
                "beispiel": "5"
            },
            {
                "name": "xp",
                "bedeutung": "leveling:VORLAGEN.PH_XP",
                "beispiel": "1325"
            },
            {
                "name": "xp:fehlt",
                "bedeutung": "leveling:VORLAGEN.PH_XP_FEHLT",
                "beispiel": "230"
            },
            {
                "name": "rang",
                "bedeutung": "leveling:VORLAGEN.PH_RANG",
                "beispiel": "3"
            }
        ],
        "anlaesse": {
            "aufstieg": {
                "titel": "leveling:VORLAGEN.AUFSTIEG",
                "bildkarte": {
                    "karte": "kern:rangkarte",
                    "schalter": "rangkarte_anhaengen"
                },
                "kern": [
                    "member",
                    "guild",
                    "gestaltung"
                ],
                "platzhalter": [
                    "level",
                    "level:vorher",
                    "level:name",
                    "xp",
                    "xp:fehlt",
                    "rang"
                ]
            }
        }
    },
    "bildkarten": {
        "kern:rangkarte": {
            "wo": "leveling:BILDKARTEN.WO_RANGKARTE",
            "seite": "nachrichten",
            "stand": "shared/rangkarte.js",
            "schablonen": [
                "leveling:rang-hell",
                "leveling:rang-kompakt",
                "leveling:rang-neon"
            ]
        },
        "leveling:rangliste": {
            "titel": "leveling:BILDKARTEN.TITEL_RANGLISTE",
            "wo": "leveling:BILDKARTEN.WO_RANGLISTE",
            "seite": "nachrichten",
            "stand": "shared/rangliste.js"
        }
    },
    "farben": {
        "recht": "LEVELING.CONFIGURE",
        "seite": "/nachrichten",
        "rollen": {
            "akzent": "#3498db"
        }
    },
    "fortschritt": [
        {
            "kennung": "leveling:community",
            "titel": "leveling:FORTSCHRITT.COMMUNITY",
            "recht": "LEVELING.CONFIGURE",
            "schablone": "ansteigend"
        }
    ]
}
