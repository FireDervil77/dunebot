        return;
      }
      if (d.action === 'pruefung') {
        strom.close();
        window.location.reload();
        return;
      }
      if (d.action === 'konsole') {
        var unten = konsole.scrollTop + konsole.clientHeight >= konsole.scrollHeight - 4;
        var z = document.createElement('div');
        z.textContent = lesbar(d.line);
        konsole.appendChild(z);
        if (unten) konsole.scrollTop = konsole.scrollHeight;
      } else if (d.action === 'ports') {
