        // Ein Weg, den das Formular nicht anbietet (`api`), bleibt wählbar,
        // solange er schon dasteht.
        if (!Array.prototype.some.call(formB.via.options, function (o) { return o.value === c.via; })) {
          formB.via.add(new Option(c.via, c.via));
        }
        formB.via.value = c.via;
        formB.command.value = c.command || '';
        formB.parse.value = c.parse || '';
        formB.file.value = c.file || '';
        if (c.mode) formB.mode.value = c.mode;
        formB.value.value = c.value || '';
        formB.grund_de.value = (c.reason && c.reason.de) || '';
        formB.grund_en.value = (c.reason && c.reason.en) || '';
        befehlTitel.textContent = 'Befehl „' + d.key + '" bearbeiten';
        zeigeWeg();
        document.getElementById('befehlDetails').open = true;
        formB.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });
    document.querySelectorAll('[data-befehl-entfernen]').forEach(function (k) {
      k.addEventListener('click', async function () {
        if (!confirm('Befehl „' + k.dataset.befehlEntfernen + '" aus dem Entwurf entfernen?')) return;
        k.disabled = true;
        try { await schicke(hier + '/befehle/entfernen', { key: k.dataset.befehlEntfernen }); window.location.reload(); }
        catch (fehler) { k.disabled = false; melde('error', fehler.message); }
      });
    });
    formB.addEventListener('submit', async function (ev) {
      ev.preventDefault();
      var knopf = formB.querySelector('button[type=submit]');
      knopf.disabled = true;
      // Nur die sichtbaren Felder: Was zu einem anderen Weg gehört, käme sonst
      // als Rest eines früheren Eintrags mit.
      var nutzlast = { key: formB.key.value, via: formB.via.value };
      formB.querySelectorAll('[data-weg]').forEach(function (f) {
        if (f.hidden) return;
        f.querySelectorAll('input, textarea, select').forEach(function (e) { nutzlast[e.name] = e.value; });
      });
      try {
        await schicke(hier + '/befehle', nutzlast);
        window.location.reload();
      } catch (fehler) {
        knopf.disabled = false;
        melde('error', fehler.message);
      }
    });
  }

  // ── Einstellungen (Baukasten B1) ──────────────────────────────────────
  var formE = document.getElementById('formEinstellung');
  if (formE) {
    var zieleBox = document.getElementById('eZiele');
    var vorlageZiel = document.getElementById('vorlageZiel');
    var typE = formE.querySelector('[name=type]');

    function zeigeTypFelder() {
      formE.querySelectorAll('[data-nur-typ]').forEach(function (el) { el.hidden = el.dataset.nurTyp !== typE.value; });
      zieleBox.querySelectorAll('[data-nur-typ-ziel]').forEach(function (el) { el.hidden = el.dataset.nurTypZiel !== typE.value; });
    }
    function zeigeZielFelder(zeile) {
      var t = zeile.querySelector('[data-feld=target]').value;
      zeile.querySelectorAll('[data-nur-ziel]').forEach(function (el) { el.hidden = el.dataset.nurZiel !== t; });
    }
    function neuesZiel(z) {
      var zeile = vorlageZiel.content.firstElementChild.cloneNode(true);
      Object.keys(z || {}).forEach(function (k) {
        var f = zeile.querySelector('[data-feld="' + k + '"]');
        if (f) f.value = z[k];
      });
      zeile.querySelector('[data-feld=target]').addEventListener('change', function () { zeigeZielFelder(zeile); });
      zeile.querySelector('[data-ziel-weg]').addEventListener('click', function () { zeile.remove(); });
      zieleBox.appendChild(zeile);
      zeigeZielFelder(zeile);
      zeigeTypFelder();
    }
    function leeren() {
      formE.reset();
      formE.alt.value = '';
      zieleBox.innerHTML = '';
      neuesZiel({ target: 'file' });
      document.getElementById('einstellungUeberschrift').textContent = 'Neue Einstellung';
    }
    document.getElementById('knopfZielDazu').addEventListener('click', function () { neuesZiel({ target: 'file' }); });
    document.getElementById('knopfEinstellungNeu').addEventListener('click', leeren);
    typE.addEventListener('change', zeigeTypFelder);
    leeren();

    // Bearbeiten: das Formular mit der gespeicherten Einstellung füllen.
    document.querySelectorAll('[data-einstellung-bearbeiten]').forEach(function (k) {
      k.addEventListener('click', function () {
        var e = JSON.parse(k.dataset.einstellungBearbeiten);
        leeren();
        zieleBox.innerHTML = '';
        formE.alt.value = e.key;
        formE.key.value = e.key;
        formE.name_de.value = (e.name && e.name.de) || '';
        formE.name_en.value = (e.name && e.name.en) || '';
        formE.beschreibung_de.value = (e.description && e.description.de) || '';
        formE.beschreibung_en.value = (e.description && e.description.en) || '';
        formE.group.value = e.group || '';
        formE.type.value = e.type;
        formE['default'].value = e['default'] === undefined || e['default'] === null ? '' : (e.type === 'boolean' ? (e['default'] ? '1' : '0') : e['default']);
        formE.min.value = e.min === undefined ? '' : e.min;
        formE.max.value = e.max === undefined ? '' : e.max;
        formE.required.checked = !!e.required;
        formE.choices.value = (e.choices || []).map(function (c) { return c.value + (c.name && c.name.de ? '=' + c.name.de : ''); }).join('\n');
        formE.role.value = e.role;
        formE.takes_effect.value = e.takes_effect;
        formE.risk.value = e.risk || 'none';
        (e.apply || []).forEach(neuesZiel);
        document.getElementById('einstellungUeberschrift').textContent = 'Einstellung „' + e.key + '" bearbeiten';
        document.getElementById('einstellungDetails').open = true;
        formE.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    formE.addEventListener('submit', async function (ev) {
      ev.preventDefault();
      var nutzlast = Object.fromEntries(new FormData(formE));
      nutzlast.required = formE.required.checked;
      // Nur die Felder des gewählten Ziels — versteckte gehören nicht dazu.
      nutzlast.apply = Array.prototype.map.call(zieleBox.querySelectorAll('[data-ziel]'), function (zeile) {
        var z = {};
        zeile.querySelectorAll('[data-feld]').forEach(function (f) {
          // Jede Hülle zählt: Die Schreibweise liegt in zweien (Ziel UND Typ).
          var versteckt = false;
          for (var h = f.parentElement; h && h !== zeile; h = h.parentElement) if (h.hidden) versteckt = true;
          if (!versteckt) z[f.dataset.feld] = f.value;
        });
        return z;
      });
      var knopf = formE.querySelector('button[type=submit]');
      knopf.disabled = true;
      try {
        await schicke(hier + '/einstellungen', nutzlast);
        window.location.reload();
      } catch (fehler) {
        knopf.disabled = false;
        melde('error', fehler.message);
      }
    });
  }

  // ── Ports und Abfrage (2026-10-07) ────────────────────────────────────
  var formP = document.getElementById('formPort');
  if (formP) {
    var portTitel = document.getElementById('portUeberschrift');
    function zeigeKopplung() {
      formP.abstand.disabled = !formP.basis.value;
      // Ein Port kann nicht an sich selbst hängen.
      Array.prototype.forEach.call(formP.basis.options, function (o) { o.disabled = Boolean(o.value) && o.value === formP.zweck.value; });
    }
    function portLeeren() {
      formP.reset();
      formP.alt.value = '';
      formP.zweck.readOnly = false;
      portTitel.textContent = 'Mod-Port von Hand anlegen';
      zeigeKopplung();
    }
    formP.basis.addEventListener('change', zeigeKopplung);
    document.getElementById('knopfPortNeu').addEventListener('click', portLeeren);
    document.querySelectorAll('[data-port-bearbeiten]').forEach(function (k) {
      k.addEventListener('click', function () {
        var p = JSON.parse(k.dataset.portBearbeiten);
        var m = /^([a-z][a-z0-9_]*)\+([0-9]+)$/.exec(p.assign || '');
        portLeeren();
        formP.alt.value = p.purpose;
        formP.zweck.value = p.purpose;
        formP.zweck.readOnly = true;
        formP.protocol.value = p.protocol;
        formP.optional.checked = p.required === false;
        formP.basis.value = m ? m[1] : '';
        zeigeKopplung();
        formP.abstand.value = m ? m[2] : '1';
        formP.variable.value = p.variable || '';
        formP.beschreibung_de.value = (p.description && p.description.de) || '';
        formP.beschreibung_en.value = (p.description && p.description.en) || '';
        formP.needed_by.value = p.needed_by || '';
        portTitel.textContent = 'Port „' + p.purpose + '" bearbeiten';
        document.getElementById('portDetails').open = true;
        formP.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });
    formP.addEventListener('submit', async function (ev) {
      ev.preventDefault();
      var knopf = formP.querySelector('button[type=submit]');
      knopf.disabled = true;
      try {
        await schicke(hier + '/ports/speichern', Object.fromEntries(new FormData(formP)));
        window.location.reload();
      } catch (fehler) {
        knopf.disabled = false;
        melde('error', fehler.message);
      }
    });
  }

  var formA = document.getElementById('formAbfrage');
  if (formA) {
    var belegText = document.getElementById('abfrageBelegbar');
    function zeigeBelegbar() {
      var wert = formA.protocol.value.trim().toLowerCase();
      var eintrag = Array.prototype.find.call(document.getElementById('abfrageKennungen').options, function (o) { return o.value === wert; });
      if (!wert) belegText.textContent = '';
      else if (!eintrag) belegText.textContent = 'Diese Kennung steht nicht im Katalog — so lässt sie sich nicht speichern.';
      else if (eintrag.dataset.belegbar) belegText.textContent = 'Der Prüfdurchlauf kann diese Abfrage belegen — mit dem Schalter unten wartet er auf ihre Antwort.';
      else belegText.textContent = 'Dieses Protokoll fragt erst das Panel am laufenden Server. Der Prüfdurchlauf kann es nicht belegen; die Abfrage kommt mit diesem Vermerk ins Paket.';
    }
    formA.protocol.addEventListener('input', zeigeBelegbar);
    zeigeBelegbar();
    formA.addEventListener('submit', async function (ev) {
      ev.preventDefault();
      var knopf = formA.querySelector('button[type=submit]');
      knopf.disabled = true;
      try {
        await schicke(hier + '/abfrage', Object.fromEntries(new FormData(formA)));
        window.location.reload();
      } catch (fehler) {
        knopf.disabled = false;
        melde('error', fehler.message);
      }
    });
    var abfrageWeg = document.getElementById('knopfAbfrageWeg');
    if (abfrageWeg) abfrageWeg.addEventListener('click', async function () {
      if (!confirm('Abfrage aus dem Entwurf nehmen? Die Serverseite zeigt dann keine Spielerzahl mehr.')) return;
      abfrageWeg.disabled = true;
      try {
        await schicke(hier + '/abfrage/entfernen');
        window.location.reload();
      } catch (fehler) {
        abfrageWeg.disabled = false;
        melde('error', fehler.message);
      }
    });
  }

  // ── Hinweise für Betreiber (2026-10-06) ───────────────────────────────
  var formH = document.getElementById('formHinweis');
  if (formH) {
    function hinweisLeeren() {
      formH.reset();
      formH.alt.value = '';
      document.getElementById('hinweisUeberschrift').textContent = 'Neuer Hinweis';
    }
    document.getElementById('knopfHinweisNeu').addEventListener('click', hinweisLeeren);
    document.querySelectorAll('[data-hinweis-bearbeiten]').forEach(function (k) {
      k.addEventListener('click', function () {
        var h = JSON.parse(k.dataset.hinweisBearbeiten);
        hinweisLeeren();
        formH.alt.value = h.key;
        formH.key.value = h.key;
        formH.when.value = h.when;
        formH.text_de.value = (h.text && h.text.de) || '';
        formH.text_en.value = (h.text && h.text.en) || '';
        document.getElementById('hinweisUeberschrift').textContent = 'Hinweis „' + h.key + '" bearbeiten';
        document.getElementById('hinweisDetails').open = true;
        formH.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
    formH.addEventListener('submit', async function (ev) {
      ev.preventDefault();
      var knopf = formH.querySelector('button[type=submit]');
      knopf.disabled = true;
      try {
        await schicke(hier + '/hinweise', Object.fromEntries(new FormData(formH)));
        window.location.reload();
      } catch (fehler) {
        knopf.disabled = false;
        melde('error', fehler.message);
      }
    });
    document.querySelectorAll('[data-hinweis-entfernen]').forEach(function (k) {
      k.addEventListener('click', async function () {
        if (!confirm('Hinweis „' + k.dataset.hinweisEntfernen + '" aus dem Entwurf nehmen?')) return;
        k.disabled = true;
        try {
          await schicke(hier + '/hinweise/' + encodeURIComponent(k.dataset.hinweisEntfernen) + '/entfernen');
          window.location.reload();
        } catch (fehler) {
          k.disabled = false;
          melde('error', fehler.message);
        }
      });
    });
  }

  document.querySelectorAll('[data-einstellung-entfernen]').forEach(function (k) {
    k.addEventListener('click', async function () {
      if (!confirm('Einstellung „' + k.dataset.einstellungEntfernen + '" aus dem Entwurf nehmen?')) return;
      k.disabled = true;
      try {
        await schicke(hier + '/einstellungen/' + encodeURIComponent(k.dataset.einstellungEntfernen) + '/entfernen');
        window.location.reload();
      } catch (fehler) {
        k.disabled = false;
        melde('error', fehler.message);
      }
    });
  });

  // Rolle direkt in der Tabelle umstellen. Neu laden, weil „Bearbeiten" die
  // Einstellung samt alter Rolle im Knopf trägt und sie sonst zurückschriebe.
  document.querySelectorAll('[data-rolle]').forEach(function (feld) {
    var vorher = feld.value;
    feld.addEventListener('change', async function () {
      feld.disabled = true;
      try {
        await schicke(hier + '/einstellungen/' + encodeURIComponent(feld.dataset.rolle) + '/rolle', { rolle: feld.value });
        window.location.reload();
      } catch (fehler) {
        feld.value = vorher;
        feld.disabled = false;
        melde('error', fehler.message);
      }
    });
  });

  // ── Probewerte: ein Knopf für alle geänderten Zeilen (2026-10-08) ──────
  var knopfPW = document.getElementById('knopfProbewerte');
  if (knopfPW) {
    var felderPW = document.querySelectorAll('[data-probewert]');
    var textPW = document.getElementById('knopfProbewerteText');
    var anfangPW = {};
    Array.prototype.forEach.call(felderPW, function (f) { anfangPW[f.dataset.probewert] = f.value; });
    function geaendertePW() {
      var aus = {};
      Array.prototype.forEach.call(felderPW, function (f) {
        if (f.value !== anfangPW[f.dataset.probewert]) aus[f.dataset.probewert] = f.value;
      });
      return aus;
    }
    function zeigePW() {
      var n = Object.keys(geaendertePW()).length;
      knopfPW.disabled = n === 0;
      textPW.textContent = n === 0 ? 'Probewerte speichern' : (n === 1 ? 'Einen geänderten Probewert speichern' : n + ' geänderte Probewerte speichern');
      // Was noch nicht gespeichert ist, soll man der Zeile ansehen.
      Array.prototype.forEach.call(felderPW, function (f) {
        f.classList.toggle('border-primary', f.value !== anfangPW[f.dataset.probewert]);
      });
    }
    Array.prototype.forEach.call(felderPW, function (f) {
      f.addEventListener('input', zeigePW);
      f.addEventListener('change', zeigePW);
    });
    // Ein anderer Speicherweg auf der Seite lädt neu — ungespeicherte Probewerte
    // gingen dabei still verloren. Der Browser fragt dann nach.
    var speichertPW = false;
    window.addEventListener('beforeunload', function (ev) {
      if (speichertPW || Object.keys(geaendertePW()).length === 0) return;
      ev.preventDefault();
      ev.returnValue = '';
    });
    knopfPW.addEventListener('click', async function () {
      var werte = geaendertePW();
      if (!Object.keys(werte).length) return;
      knopfPW.disabled = true;
      try {
        await schicke(hier + '/einstellungen/probewerte', { werte: werte });
        speichertPW = true;
        // Neu laden: Hinweise in anderen Reitern hängen an den Probewerten
        // (etwa das Kennwort der Fernsteuerung). Reiter und Stelle bleiben.
        window.location.reload();
      } catch (fehler) {
        knopfPW.disabled = false;
        melde('error', fehler.message);
      }
    });
    zeigePW();
  }
})();
</script>
