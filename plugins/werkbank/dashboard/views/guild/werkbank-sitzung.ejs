        var d = daten.dateien || {};
        var leer = true;
        [['neu', 'bg-green-lt', 'neu'], ['geaendert', 'bg-yellow-lt', 'geändert'], ['weg', 'bg-red-lt', 'weg']].forEach(function (art) {
          var anzahl = d['anzahl_' + art[0]] || 0;
