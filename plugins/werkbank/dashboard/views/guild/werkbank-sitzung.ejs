<!--
    Werkbank: eine Sitzung (Stufe 1, 2026-09-24)

    Links die ausgefuehrten Schritte mit Status und Ausgabe, rechts der
    naechste Schritt und der Entwurf, wie er gerade steht.

    Ein Schritt laeuft SOFORT im Volume der Sitzung. Seine Ausgabe kommt live
    ueber SSE (Namensraum werkbank, gefiltert auf diese Sitzung). Ist er fertig,
    laedt die Seite neu — dann stehen Status und gespeicherte Ausgabe da.

    „Aus dem Entwurf nehmen" nimmt einen Schritt aus dem Rezept. Was er im
    Volume angelegt hat, bleibt dort; das steht beim Knopf dabei.

    Stufe 2: Probestart (Karte unten). Das Spiel laeuft im Volume der Sitzung,
    ohne freigegebene Ports; beobachtet wird von innen. Was beobachtet wurde
    (Ports, Konsolenzeilen), kommt erst per Knopf in den Entwurf.
-->
<%
  const basis = `/guild/${guildId}/plugins/werkbank`;
  const hier = `${basis}/${sitzung.kennung}`;
  const bildName = (sitzung.image.ref || '').replace(/^.*\//, '') + (sitzung.image.tag ? ':' + sitzung.image.tag : '');
  const laeuft = schritte.some(s => s.status === 'laeuft');
  const lauf = laeufe[0] || null;
  const spielLaeuft = Boolean(lauf && lauf.status !== 'beendet');
  const pruefung = pruefungen[0] || null;
  const pruefLaeuft = Boolean(pruefung && pruefung.status === 'laeuft');
  const beschaeftigt = laeuft || spielLaeuft || pruefLaeuft;
  const entwurfPorts = sitzung.entwurf.ports || [];

  // ── Reiter (2026-10-08): die Karten nach Arbeitsschritt ──────────────────
  // `marke`: [Farbe, Text, Erklärung] — was man wissen soll, ohne hineinzusehen.
  const _imEntwurf = schritte.filter(function (x) { return x.status === 'ok' || x.status === 'uebernommen'; }).length;
  const _wartend = schritte.filter(function (x) { return x.status === 'uebernommen'; }).length;
  const _fern = locals.fernsteuerung || { rcon: null, warnungen: [] };
  const _warnVerbindung = (_fern.warnungen || []).length + (locals.ungenutztePorts || []).length;
  const _einst = (locals.einstellungen || []).length;
  const _veraltet = Boolean(pruefung && pruefung.status === 'gruen' && locals.pruefHash !== locals.entwurfHash);
  const REITER = [
    { id: 'aufbauen', titel: 'Aufbauen', satz: 'Schritte der Installation', icon: 'fa-solid fa-list-check',
      marke: laeuft ? ['bg-blue-lt', 'läuft', 'Ein Schritt läuft']
           : _wartend ? ['bg-yellow-lt', _wartend + ' offen', 'Übernommene Schritte, die in dieser Sitzung noch nicht gelaufen sind']
           : _imEntwurf ? ['bg-secondary-lt', String(_imEntwurf), 'Schritte im Entwurf'] : null },
    { id: 'starten', titel: 'Starten', satz: 'Probestart, Konsole, Ports beobachten', icon: 'fa-solid fa-play',
      marke: spielLaeuft ? ['bg-blue-lt', 'läuft', 'Das Spiel läuft'] : null },
    { id: 'verbindung', titel: 'Verbindung', satz: 'Ports, Abfrage, Fernsteuerung', icon: 'fa-solid fa-network-wired',
      marke: _warnVerbindung ? ['bg-yellow-lt', '⚠ ' + _warnVerbindung, 'Hinweise in diesem Reiter']
           : entwurfPorts.length ? ['bg-secondary-lt', String(entwurfPorts.length), 'Ports im Entwurf'] : null },
    { id: 'einstellungen', titel: 'Einstellungen', satz: 'Einstellungen und Hinweise für Betreiber', icon: 'fa-solid fa-sliders',
      marke: _einst ? ['bg-secondary-lt', String(_einst), 'Einstellungen im Entwurf'] : null },
    { id: 'pruefen', titel: 'Prüfen & Veröffentlichen', satz: 'Durchlauf, Angaben, in test einliefern', icon: 'fa-solid fa-flask',
      marke: pruefLaeuft ? ['bg-blue-lt', 'läuft', 'Der Prüfdurchlauf läuft']
           : !pruefung ? null
           : _veraltet ? ['bg-yellow-lt', 'veraltet', 'Grün — aber der Entwurf ist seither geändert']
           : pruefung.status === 'gruen' ? ['bg-green-lt', 'grün', 'Der letzte Durchlauf ist grün']
           : ['bg-red-lt', 'rot', 'Der letzte Durchlauf ist rot'] },
  ];
  // Ohne `#…` in der Adresse: dorthin, wo gerade etwas läuft — sonst an den Anfang.
  const reiterStart = pruefLaeuft ? 'pruefen' : (spielLaeuft ? 'starten' : 'aufbauen');
  // Farb- und Steuerzeichen der Spiele (ANSI) — beim ANZEIGEN entfernt, die
  // Daten bleiben roh. Hytale färbt jede Zeile; kopiert landete `[m` in der
  // Anmeldeadresse, und Hytale wies den Code ab (2026-10-01).
  function lesbar(t) { return String(t || '').replace(/\x1b\[[0-?]*[ -\/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b[@-Z\\-_]/g, ''); }
  function groesse(n) {
    n = Number(n) || 0;
    if (n < 1024) return n + ' B';
    if (n < 1048576) return (n / 1024).toFixed(1) + ' KB';
    return (n / 1048576).toFixed(1) + ' MB';
  }
  const laufStatus = {
    startet: '<span class="badge bg-blue-lt">startet</span>',
    laeuft:  '<span class="badge bg-green-lt">läuft</span>',
    stoppt:  '<span class="badge bg-orange-lt">stoppt</span>',
    beendet: '<span class="badge bg-secondary-lt">beendet</span>'
  };

  const statusMarke = {
    laeuft:         '<span class="badge bg-blue-lt">läuft</span>',
    ok:             '<span class="badge bg-green-lt">im Entwurf</span>',
    fehler:         '<span class="badge bg-red-lt">gescheitert</span>',
    herausgenommen: '<span class="badge bg-secondary-lt">herausgenommen</span>',
    // Aus einem geöffneten Paket: gehört zum Entwurf, lief in DIESER Sitzung aber noch nicht.
    uebernommen:    '<span class="badge bg-azure-lt" title="Aus dem geöffneten Paket übernommen — im Volume dieser Sitzung noch nicht gelaufen.">übernommen</span>'
  };

  // Eine Zeile, die sagt, was der Schritt tut — ohne ihn aufzuklappen.
  function kurz(s) {
    switch (s.type) {
      case 'script':   return (s.script || '').split('\n').filter(z => z.trim() && !z.trim().startsWith('#'))[0] || '(leeres Skript)';
      case 'mkdir':    return s.path;
      case 'download': return s.url + ' → ' + s.target;
      case 'extract':  return s.archive + (s.target ? ' → ' + s.target : '') + (s.strip_components ? ' (strip ' + s.strip_components + ')' : '');
      case 'template': return s.file;
      case 'steamcmd': return 'App ' + s.app + (s.branch ? ' · ' + s.branch : '') + (s.platform === 'windows' ? ' · Windows-Build' : '');
      default:         return '';
    }
  }
%>

<%- include('shared/seitenkopf', {
    plugin:       'werkbank',
    vortitel:     tr('werkbank:TITLE'),
    titel:        sitzung.name,
    beschreibung: bildName + ' · ' + (maschine ? maschine.name : 'Maschine ' + sitzung.rootserver_id) + (maschine && !maschine.online ? ' (nicht erreichbar)' : ''),
    icon:         'fa-solid fa-screwdriver-wrench',
    guildId,
    aktion:       '<button class="btn btn-outline-danger" id="knopfVerwerfen"' + (beschaeftigt ? ' disabled' : '') + '><i class="fa-solid fa-trash me-1"></i>Sitzung verwerfen</button>'
}) %>

<div class="row row-cards" id="werkbankSitzung"
     data-werkbank-hier="<%= hier %>" data-werkbank-basis="<%= basis %>"
     data-werkbank-sitzung="<%= sitzung.kennung %>" data-werkbank-laeuft="<%= laeuft ? '1' : '0' %>"
     data-werkbank-spiel="<%= spielLaeuft ? '1' : '0' %>" data-werkbank-pruefung="<%= pruefLaeuft ? '1' : '0' %>"
     data-aktiv="<%= reiterStart %>">

  <%# ── Reiter (2026-10-08) ────────────────────────────────────────────────
      Die Seite war elf Karten lang, und es kommen noch welche. Betreiber: „Wir
      legen alles in Tabs? Das würde das Handling und die ganze UI
      verschlanken." Die Karten sind dieselben geblieben — sie liegen jetzt
      nach Arbeitsschritt in fünf Reitern.

      Drei Dinge, damit ein Reiter nichts versteckt:
        - Er steht in der Adresse (#starten). Nach dem Neuladen ist man wieder
          dort; die Stelle auf der Seite hält rollstand.js.
        - Jeder Reiter zeigt seinen Zustand (läuft, grün, rot, Warnung, Anzahl).
        - Läuft etwas, sagt es die Zeile über den Reitern — dann sind in ALLEN
          Reitern Knöpfe gesperrt, und man soll sehen, warum.

      Kein Bootstrap-Tab: Welcher Reiter offen ist, steht als `data-aktiv` am
      Rahmen, und das Skript direkt hinter der Leiste setzt es aus der Adresse,
      BEVOR die Karten gelesen werden — sonst sähe man kurz den falschen. %>
  <style>
    #werkbankSitzung > [data-reiter] { display: none; }
    <%- REITER.map(function (r) { return '#werkbankSitzung[data-aktiv="' + r.id + '"] > [data-reiter="' + r.id + '"]'; }).join(',\n    ') %> { display: block; }
  </style>
  <div class="col-12">
    <% if (beschaeftigt) { %>
      <div class="alert alert-info py-2 mb-2 d-flex flex-wrap align-items-center gap-2" id="reiterZustand">
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        <span style="flex:1 1 14rem">
          <strong><%= laeuft ? 'Ein Schritt läuft' : (spielLaeuft ? 'Das Spiel läuft (Probestart)' : 'Der Prüfdurchlauf läuft') %></strong>
          — solange sind in allen Reitern die Knöpfe gesperrt, die den Entwurf ändern.
        </span>
        <button class="btn btn-sm btn-outline-primary" type="button" data-reiter-sprung="<%= laeuft ? 'aufbauen' : (spielLaeuft ? 'starten' : 'pruefen') %>">Dorthin</button>
      </div>
    <% } %>
    <div class="reiter" role="tablist" id="reiterLeiste">
      <% REITER.forEach(function (r) { %>
        <button class="reiter__knopf <%= r.id === reiterStart ? 'active' : '' %>" type="button" role="tab" id="reiter-<%= r.id %>"
                data-reiter-knopf="<%= r.id %>" aria-selected="<%= r.id === reiterStart %>">
          <span class="reiter__symbol"><i class="<%= r.icon %>"></i></span>
          <span>
            <span class="reiter__titel"><%= r.titel %></span>
            <span class="reiter__satz"><%= r.satz %></span>
          </span>
          <% if (r.marke) { %><span class="reiter__marke badge <%= r.marke[0] %>" title="<%= r.marke[2] || '' %>"><%= r.marke[1] %></span><% } %>
        </button>
      <% }) %>
    </div>
  </div>
  <script>
  (function () {
    var rahmen = document.getElementById('werkbankSitzung');
    var knoepfe = document.querySelectorAll('[data-reiter-knopf]');
    var bekannt = Array.prototype.map.call(knoepfe, function (k) { return k.dataset.reiterKnopf; });
    // Kästen, die mit der Ausgabe mitlaufen: In einem verborgenen Reiter haben
    // sie keine Höhe — beim Öffnen ans Ende, wo das Neueste steht.
    var MITLAUFEND = ['liveAusgabe', 'laufKonsole', 'pruefProtokoll'];

    function zeige(id, merken) {
      if (bekannt.indexOf(id) < 0) return false;
      rahmen.dataset.aktiv = id;
      Array.prototype.forEach.call(knoepfe, function (k) {
        var an = k.dataset.reiterKnopf === id;
        k.classList.toggle('active', an);
        k.setAttribute('aria-selected', an ? 'true' : 'false');
      });
      if (merken) {
        // Ersetzen, nicht anhängen: „Zurück" soll die Seite verlassen, nicht
        // durch die Reiter blättern.
        history.replaceState(null, '', '#' + id);
        MITLAUFEND.forEach(function (kennung) {
          var kasten = document.getElementById(kennung);
          if (kasten) kasten.scrollTop = kasten.scrollHeight;
        });
        // Steht die Leiste oberhalb des Sichtbaren, zu ihr zurück — sonst
        // landete man mitten in einem kürzeren Reiter.
        var leiste = document.getElementById('reiterLeiste');
        if (leiste && leiste.getBoundingClientRect().top < 0) leiste.scrollIntoView({ block: 'start' });
      }
      return true;
    }
    // Aus der Adresse — vor den Karten, damit nichts aufblitzt.
    zeige(location.hash.slice(1), false);
    Array.prototype.forEach.call(knoepfe, function (k) {
      k.addEventListener('click', function () { zeige(k.dataset.reiterKnopf, true); });
    });
    window.addEventListener('hashchange', function () { zeige(location.hash.slice(1), false); });
    document.addEventListener('click', function (ev) {
      var sprung = ev.target.closest ? ev.target.closest('[data-reiter-sprung]') : null;
      if (sprung) zeige(sprung.dataset.reiterSprung, true);
    });
  })();
  </script>

  <div class="col-12" data-reiter="aufbauen" role="tabpanel" aria-labelledby="reiter-aufbauen"><div class="row row-cards">

  <div class="col-lg-7">
    <div class="card">
      <div class="card-header"><h3 class="card-title">Schritte</h3></div>
      <% if (!schritte.length) { %>
        <div class="card-body">
          <%- include('shared/leerzustand', {
              icon:  'fa-solid fa-list-check',
              titel: 'Noch kein Schritt',
              text:  'Rechts fügst du den ersten hinzu. Meist ist das ein download der Serverdateien oder ein steamcmd-Schritt.'
          }) %>
        </div>
      <% } else { %>
        <%# Übernommene Schritte, die hier noch nicht gelaufen sind (2026-10-08).
            Öffnen startet sie selbst; stehen trotzdem welche da (Maschine war weg,
            einer ist gescheitert, die Sitzung ist älter), holt der Knopf es nach.
            Ohne sie hat die Sitzung kein Volume mit dem Spiel darin. %>
        <% const wartend = schritte.filter(function (x) { return x.status === 'uebernommen'; }).length; %>
        <% if (wartend && !laeuft) { %>
          <div class="card-body border-bottom">
            <div class="alert alert-warning mb-0" id="hinweisUebernommene">
              <div class="d-flex flex-wrap align-items-center gap-2">
                <div style="flex:1 1 16rem">
                  <strong><%= wartend === 1 ? 'Ein übernommener Schritt ist' : wartend + ' übernommene Schritte sind' %> in dieser Sitzung noch nicht gelaufen.</strong>
                  Solange fehlt dem Volume das Spiel — Probestart, Beobachtung der Ports und der Blick in die Dateien brauchen es.
                </div>
                <button class="btn btn-warning" type="button" id="knopfUebernommene" <%= beschaeftigt ? 'disabled' : '' %>>
                  <i class="fa-solid fa-play me-1"></i>Übernommene Schritte ausführen
                </button>
              </div>
            </div>
          </div>
        <% } %>
        <div class="list-group list-group-flush">
          <% schritte.forEach(function (x) { %>
            <div class="list-group-item" data-schritt="<%= x.id %>">
              <div class="d-flex align-items-center gap-2">
                <span class="text-secondary" style="min-width:1.5rem">#<%= x.nr %></span>
                <span class="badge bg-azure-lt font-monospace"><%= x.schritt.type %></span>
                <span class="text-truncate font-monospace small" style="flex:1 1 auto" title="<%= kurz(x.schritt) %>"><%= kurz(x.schritt) %></span>
                <%- statusMarke[x.status] || '' %>
              </div>
              <% if (x.fehler) { %>
                <div class="text-danger small mt-2" style="white-space:pre-wrap"><%= x.fehler %></div>
              <% } %>
              <% if (x.ausgabe || x.status === 'laeuft') { %>
                <details class="mt-2" <%= x.status === 'laeuft' ? 'open' : '' %>>
                  <summary class="text-secondary small">Ausgabe</summary>
                  <pre class="mt-2 mb-0 p-2 small" style="max-height:24rem;overflow:auto;background:var(--tblr-bg-surface-secondary);color:var(--tblr-body-color)" <%= x.status === 'laeuft' ? 'id=liveAusgabe' : '' %>><%= lesbar(x.ausgabe) %></pre>
                </details>
              <% } %>
              <% if (x.dateien) { %>
                <details class="mt-2">
                  <summary class="text-secondary small">Dateien: <%= x.dateien.anzahl_neu || 0 %> neu · <%= x.dateien.anzahl_geaendert || 0 %> geändert · <%= x.dateien.anzahl_weg || 0 %> weg</summary>
                  <div class="small mt-2"><%- include('werkbank-dateien', { d: x.dateien, gruppiere, groesse }) %></div>
                </details>
              <% } %>
              <% if (x.status === 'ok' || x.status === 'fehler' || x.status === 'uebernommen') { %>
                <div class="mt-2">
                  <button class="btn btn-sm btn-ghost-secondary" data-herausnehmen="<%= x.id %>"
                          title="Nimmt den Schritt aus dem Rezept. Was er im Volume angelegt hat, bleibt dort.">
                    <i class="fa-solid fa-xmark me-1"></i>Aus dem Entwurf nehmen
                  </button>
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card">
      <div class="card-header"><h3 class="card-title">Nächster Schritt</h3></div>
      <div class="card-body">
        <% if (laeuft) { %>
          <p class="text-secondary mb-0">Ein Schritt läuft — der nächste kommt, wenn er fertig ist.</p>
        <% } else if (spielLaeuft) { %>
          <p class="text-secondary mb-0">Das Spiel läuft (Probestart unten) — Schritte gehen erst wieder, wenn es gestoppt ist.</p>
        <% } else if (pruefLaeuft) { %>
          <p class="text-secondary mb-0">Der Prüfdurchlauf läuft (unten) — Schritte gehen erst wieder nach seinem Urteil.</p>
        <% } else { %>
        <form id="formSchritt">
          <div class="mb-3">
            <label class="form-label" for="schrittTyp">Typ</label>
            <select class="form-select" id="schrittTyp" name="type">
              <% schritttypen.forEach(function (t) { %><option value="<%= t %>"><%= t %></option><% }) %>
            </select>
          </div>

          <fieldset data-typ="script">
            <div class="mb-3">
              <label class="form-label" for="fScript">Skript (bash, läuft in game/)</label>
              <textarea class="form-control font-monospace" id="fScript" name="script" rows="8" placeholder="set -euo pipefail&#10;ls -la"></textarea>
            </div>
            <div class="mb-3">
              <label class="form-label" for="fReason">Warum ein Skript?</label>
              <input class="form-control" id="fReason" name="reason" placeholder="Kommt ins Paket — ohne Begründung gibt es einen Befund">
            </div>
          </fieldset>

          <fieldset data-typ="mkdir" hidden>
            <div class="mb-3">
              <label class="form-label" for="fPath">Ordner in game/</label>
              <input class="form-control font-monospace" id="fPath" name="path" placeholder="mods">
            </div>
          </fieldset>

          <fieldset data-typ="download" hidden>
            <div class="mb-3">
              <label class="form-label" for="fUrl">Adresse (nur https)</label>
              <input class="form-control font-monospace" id="fUrl" name="url" placeholder="https://…">
            </div>
            <div class="mb-3">
              <label class="form-label" for="fTarget">Zieldatei in game/</label>
              <input class="form-control font-monospace" id="fTarget" name="target" placeholder="server.zip">
            </div>
            <div class="mb-3">
              <label class="form-label" for="fChecksum">Prüfsumme</label>
              <input class="form-control font-monospace" id="fChecksum" name="checksum" placeholder="sha256:… oder sha1:… — leer: wird beim Laden ausgerechnet">
              <div class="form-hint">Kennst du sie nicht, lass das Feld leer: Die Werkbank lädt die Datei, rechnet die Summe aus und trägt sie in den Schritt ein. Gibt der Hersteller eine an, nimm seine — dann ist geprüft, dass du seine Datei hast.</div>
              <div class="form-hint">Pflicht. Stimmt sie nicht, bricht der Schritt ab, und die Datei bleibt nicht liegen.</div>
            </div>
          </fieldset>

          <fieldset data-typ="extract" hidden>
            <div class="mb-3">
              <label class="form-label" for="fArchive">Archiv in game/</label>
              <input class="form-control font-monospace" id="fArchive" name="archive" placeholder="server.tar.xz">
            </div>
            <div class="mb-3">
              <label class="form-label" for="fExTarget">Zielordner in game/ (leer = game/)</label>
              <input class="form-control font-monospace" id="fExTarget" name="target">
            </div>
            <div class="mb-3">
              <label class="form-label" for="fStrip">Oberste Ordnerebenen weglassen</label>
              <input class="form-control" id="fStrip" name="strip_components" type="number" min="0" placeholder="0">
              <div class="form-hint">Liegt im Archiv alles in einem Ordner (etwa <code>factorio/</code>), ist es meist 1.</div>
            </div>
            <label class="form-check form-switch">
              <input class="form-check-input" type="checkbox" name="delete_archive" checked>
              <span class="form-check-label">Archiv danach löschen</span>
            </label>
          </fieldset>

          <fieldset data-typ="template" hidden>
            <div class="mb-3">
              <label class="form-label" for="fFile">Datei in game/</label>
              <input class="form-control font-monospace" id="fFile" name="file" placeholder="server.cfg">
            </div>
            <div class="mb-3">
              <label class="form-label" for="fContent">Inhalt</label>
              <textarea class="form-control font-monospace" id="fContent" name="content" rows="8"></textarea>
              <div class="form-hint"><code>{{port:zweck}}</code> bekommt die Nummer, die beim Probestart übernommen wurde. <code>{{setting:name}}</code> hat die Sitzung noch nicht.</div>
            </div>
            <label class="form-check form-switch">
              <input class="form-check-input" type="checkbox" name="only_if_missing" checked>
              <span class="form-check-label">Nur anlegen, wenn die Datei fehlt</span>
            </label>
          </fieldset>

          <fieldset data-typ="steamcmd" hidden>
            <div class="mb-3">
              <label class="form-label" for="fApp">Steam-App-ID</label>
              <input class="form-control" id="fApp" name="app" type="number" min="1">
            </div>
            <div class="mb-3">
              <label class="form-label" for="fBranch">Zweig (leer = public)</label>
              <input class="form-control font-monospace" id="fBranch" name="branch">
            </div>
            <label class="form-check form-switch">
              <input class="form-check-input" type="checkbox" name="validate" checked>
              <span class="form-check-label">Nach dem Laden prüfen (validate)</span>
            </label>
          </fieldset>

          <div class="mb-3 mt-3">
            <label class="form-label" for="fBeschreibung">Beschreibung (freiwillig)</label>
            <input class="form-control" id="fBeschreibung" name="beschreibung" placeholder="Was dieser Schritt tut">
          </div>
          <button class="btn btn-primary w-100" type="submit">
            <i class="fa-solid fa-play me-1"></i>Ausführen
          </button>
        </form>
        <% } %>
      </div>
    </div>

    <div class="card mt-3">
      <div class="card-header"><h3 class="card-title">Entwurf</h3></div>
      <div class="card-body">
        <p class="text-secondary small">So sähe das Paket gerade aus: die Schritte „im Entwurf", Startteil, übernommene Ports und Einstellungen. Veröffentlicht werden davon nur die Einstellungen, die ein Durchlauf belegt.</p>
        <pre class="small mb-0 p-2" style="max-height:24rem;overflow:auto;background:var(--tblr-bg-surface-secondary);color:var(--tblr-body-color)"><%= JSON.stringify(entwurf, null, 2) %></pre>
      </div>
    </div>
  </div>

  </div></div>

  <div class="col-12" data-reiter="starten" role="tabpanel" aria-labelledby="reiter-starten"><div class="row row-cards">

  <!-- ── Probestart (Stufe 2) ─────────────────────────────────────────── -->
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Probestart</h3>
        <div class="card-actions" id="laufStatus"><%- lauf ? (laufStatus[lauf.status] || '') : '<span class="text-secondary small">noch nie gestartet</span>' %></div>
      </div>
      <div class="card-body">
        <div class="row g-4">
          <div class="col-lg-5">
            <form id="formStart">
              <div class="mb-3">
                <label class="form-label" for="sProgram">Programm (relativ zu game/)</label>
                <input class="form-control font-monospace" id="sProgram" name="program" value="<%= startFormular.program %>" placeholder="./bin/x64/factorio">
              </div>
              <%
                // Startzeilen-Baukasten (S1, 2026-09-30): Form · Quelle · Bedingung je Zeile.
                var quellen = [{ wert: 'fest', text: 'fest' }]
                  .concat(entwurfPorts.map(function (p) { return { wert: 'port:' + p.purpose, text: 'Port: ' + p.purpose }; }))
                  .concat(einstellungen.map(function (e) {
                    var name = (e.label && (e.label.de || e.label.en || e.label)) || e.key;
                    return { wert: 'setting:' + e.key, text: 'Einstellung: ' + (typeof name === 'string' ? name : e.key) + ' (' + e.key + ')' };
                  }))
                  .concat([{ wert: 'text', text: 'Text mit Verweisen (ein Argument)' }]);
              %>
              <div class="mb-3" id="startBaukasten"
                   data-zeilen="<%= JSON.stringify(startFormular.zeilen || []) %>"
                   data-quellen="<%= JSON.stringify(quellen) %>">
                <label class="form-label">Startparameter</label>
                <div class="small text-secondary mb-1">So startet es mit den Probewerten (gerechnet vom Daemon, wie beim echten Start):</div>
                <pre class="small p-2 mb-1" id="startVorschau" style="white-space:pre-wrap;word-break:break-all;background:var(--tblr-bg-surface-secondary);color:var(--tblr-body-color)">…</pre>
                <div class="small text-warning mb-2" id="startFehlend" hidden></div>
                <div id="startZeilen"></div>
                <button class="btn btn-sm btn-outline-primary mt-1" type="button" id="knopfZeileNeu">+ Parameter</button>
                <div class="form-hint mt-1">
                  <strong>Form</strong> wie auf der Kommandozeile: <code>-port {{Wert}}</code>, <code>-Xmx{{Wert}}M</code>, <code>--start-server saves/welt.zip</code>.
                  Leerzeichen trennen Argumente, <code>"…"</code> hält eins mit Leerzeichen zusammen.
                  <code>{{Wert}}</code> ist der Wert der <strong>Quelle</strong> (Einstellung oder Port).
                  „Text mit Verweisen" ist genau <em>ein</em> Argument, z. B. <code>-QueryPort={{port:query}}</code>.
                  Die <strong>Bedingung</strong> prüft den Wert der Quelle: „wenn an" für Schalter, „wenn gesetzt" für ein Kennwort, <code>=forge,neoforge</code> für eine Auswahl.
                </div>
              </div>
              <div class="mb-3">
                <label class="form-label" for="sWorkdir">Arbeitsordner (leer = game/)</label>
                <input class="form-control font-monospace" id="sWorkdir" name="workdir" value="<%= startFormular.workdir %>">
              </div>
              <div class="mb-3">
                <label class="form-label" for="sStop">Stoppfolge — ein Schritt pro Zeile</label>
                <textarea class="form-control font-monospace" id="sStop" name="stop" rows="3" placeholder="command:/quit 30 beendet&#10;sigint 30&#10;sigkill 10"><%= startFormular.stop %></textarea>
                <div class="form-hint"><code>schritt [frist] [beendet|weiter]</code> — sigint, sigterm, sigkill, command:…, rcon:…. Die letzte Zeile muss <code>sigkill</code> sein.</div>
              </div>
              <% if (!startFormular.ready_port && !(startFormular.without_port && startFormular.log_line)) { %>
                <div class="alert alert-info py-2 small mb-2">
                  Noch keine Bereitschaft — dann ist es ein <strong>Erkundungsstart</strong>: Das Spiel läuft,
                  du siehst Konsole und Ports, übernimmst beides, und ab dem nächsten Start zählt es.
                  Ins Paket kommt die Erkundung nicht.
                </div>
              <% } %>
              <div class="row g-2 mb-3">
                <div class="col-sm-4">
                  <label class="form-label" for="sReadyPort">Bereit, wenn Port</label>
                  <select class="form-select" id="sReadyPort" name="ready_port">
                    <option value="">—</option>
                    <% entwurfPorts.forEach(function (p) { %><option value="<%= p.purpose %>" <%= startFormular.ready_port === p.purpose ? 'selected' : '' %>><%= p.purpose %></option><% }) %>
                  </select>
                </div>
                <div class="col-sm-5">
                  <label class="form-label" for="sLogLine" title="Mit Port ist die Zeile ein Zusatz und wird nicht geprüft. Ohne Port (Ausnahme unten) ist sie die Bedingung, und fb-init wartet auf sie.">Zeile</label>
                  <input class="form-control font-monospace" id="sLogLine" name="log_line" value="<%= startFormular.log_line %>" placeholder="Klick auf eine Konsolenzeile">
                </div>
                <div class="col-sm-3">
                  <label class="form-label" for="sTimeout">Frist (s)</label>
                  <input class="form-control" id="sTimeout" name="timeout_sec" type="number" min="1" value="<%= startFormular.timeout_sec %>" placeholder="300">
                </div>
              </div>
              <div class="mb-3">
                <label class="form-label" for="sOhnePort">Ohne Port, weil …</label>
                <input class="form-control" id="sOhnePort" name="without_port" maxlength="300" value="<%= startFormular.without_port %>" placeholder="leer lassen — nur für Spiele, die keinen prüfbaren Port öffnen">
                <div class="form-hint">Die Ausnahme von der Portpflicht. Dann ist die Zeile die Bedingung: Ändert das Spiel seine Meldung, wird der Server nicht mehr bereit. Hat das Spiel einen Abfrageport, nimm lieber den.</div>
              </div>
              <div class="row g-2 mb-3">
                <div class="col-6">
                  <label class="form-label" for="sMem">Arbeitsspeicher (MB)</label>
                  <input class="form-control" id="sMem" name="memory_mb" type="number" min="128" value="<%= werkbankTeil.memory_mb %>">
                </div>
                <div class="col-6">
                  <label class="form-label" for="sCpu">CPU (%, 100 = ein Kern)</label>
                  <input class="form-control" id="sCpu" name="cpu_prozent" type="number" min="10" value="<%= werkbankTeil.cpu_prozent %>">
                </div>
                <div class="col-12 form-hint">Nur für den Probestart — wird nicht auf der Maschine gebucht.</div>
              </div>
              <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary" type="button" id="knopfStartSpeichern" <%= spielLaeuft ? 'disabled' : '' %>>
                  <i class="fa-solid fa-floppy-disk me-1"></i>Speichern
                </button>
                <% if (spielLaeuft) { %>
                  <button class="btn btn-danger flex-fill" type="button" id="knopfStoppen" <%= lauf.status === 'stoppt' ? 'disabled' : '' %>>
                    <i class="fa-solid fa-stop me-1"></i><%= lauf.status === 'stoppt' ? 'Stoppt …' : 'Stoppen' %>
                  </button>
                <% } else { %>
                  <button class="btn btn-success flex-fill" type="submit" <%= (laeuft || pruefLaeuft) ? 'disabled' : '' %>>
                    <i class="fa-solid fa-play me-1"></i>Speichern und starten
                  </button>
                <% } %>
              </div>
            </form>
          </div>

          <div class="col-lg-7">
            <div class="mb-2 small" id="laufBereitschaft">
              <% if (lauf && lauf.bereitschaft) { %>
                <span class="text-secondary">Bereitschaft:</span>
                <span class="font-monospace"><%= lauf.bereitschaft.type %><%= lauf.bereitschaft.stage ? ' · ' + lauf.bereitschaft.stage : '' %></span>
                <%# fb-init erklärt sich in `hinweis` (Fehler/Fortschritt) oder in `note` (Stufe erreicht). %>
                <% const erklaerung = lauf.bereitschaft.hinweis || lauf.bereitschaft.note; %>
                <% if (erklaerung) { %><span class="text-secondary"> — <%= erklaerung %></span><% } %>
              <% } %>
            </div>
            <% if (lauf && lauf.status === 'beendet') { %>
              <div class="mb-2 small <%= lauf.exit_code === 0 || lauf.gestoppt ? 'text-secondary' : 'text-danger' %>">
                Beendet<%= lauf.exit_code !== null ? ' mit Code ' + lauf.exit_code : '' %><%= lauf.gestoppt ? ' (gestoppt)' : '' %><%= lauf.fehler ? ' — ' + lauf.fehler : '' %>
              </div>
            <% } %>
            <div id="laufLuecken">
              <% if (lauf && lauf.luecken && lauf.luecken.length) { %>
                <details class="mb-2 small">
                  <summary class="text-warning">Der Auftragsbau vermisste <%= lauf.luecken.length %> Angabe(n)</summary>
                  <ul class="mb-0 mt-1"><% lauf.luecken.forEach(function (l) { %><li><%= l %></li><% }) %></ul>
                </details>
              <% } %>
            </div>

            <div class="d-flex justify-content-between align-items-center">
              <span class="text-secondary small">Konsole — Klick auf eine Zeile übernimmt sie als Zusatz-Zeile (noch ungeprüft)</span>
            </div>
            <div id="laufKonsole" class="mt-1 p-2 small font-monospace"
                 style="height:22rem;overflow:auto;white-space:pre-wrap;background:var(--tblr-bg-surface-secondary);color:var(--tblr-body-color);cursor:pointer"><%
              lesbar(lauf && lauf.konsole).split('\n').filter(Boolean).forEach(function (z) { %><div><%= z %></div><% }) %></div>
            <form id="formEingabe" class="input-group mt-2">
              <input class="form-control font-monospace" name="zeile" placeholder="Befehl an das Spiel (Standardeingabe)" <%= spielLaeuft ? '' : 'disabled' %>>
              <button class="btn btn-outline-secondary" type="submit" <%= spielLaeuft ? '' : 'disabled' %>>Senden</button>
            </form>

            <%# ── Was lauscht da? (2026-10-08) ─────────────────────────────────
                Der Server ordnet ein (Sitzungen.portBild), der Browser zeichnet —
                beim Aufbau der Seite, bei jeder Meldung des Daemons und nach dem
                Übernehmen aus DEMSELBEN Bild. Vorher gab es die Liste zweimal
                (hier und im Skript), und sie zeigte nur Nummern.

                Diese Karte bleibt bedienbar, während das Spiel läuft: Übernehmen
                und Entfernen ändern, was der NÄCHSTE Start bekommt. Die Karte
                unter „Verbindung" ändert den Entwurf und bleibt dann gesperrt. %>
            <div class="row g-3 mt-2" id="laufPortBild"
                 data-bild="<%= JSON.stringify(locals.portBild || { laeuft: false, stand: 'leer', beobachtet: [], entwurf: [], ungenutzt: [] }) %>">
              <div class="col-md-7">
                <div class="text-secondary small mb-1" id="laufPortsTitel">Beobachtet (lauscht im Container)</div>
                <div id="laufPorts"></div>
              </div>
              <div class="col-md-5">
                <div class="text-secondary small mb-1">Im Entwurf</div>
                <div id="laufPortsEntwurf"></div>
              </div>
            </div>

            <!-- Dateien: game/ und data/ vor dem Start gegen jetzt bzw. nach dem Ende -->
            <div class="mt-3">
              <div class="d-flex align-items-center gap-2 mb-1">
                <span class="text-secondary small">Dateien seit dem Start (game/, data/)</span>
                <% if (spielLaeuft) { %>
                  <button class="btn btn-sm btn-outline-secondary ms-auto" type="button" id="knopfDateien">
                    <i class="fa-solid fa-magnifying-glass me-1"></i>Jetzt nachsehen
                  </button>
                <% } %>
              </div>
              <div id="laufDateien" class="small">
                <% const d = lauf && lauf.dateien; %>
                <% if (!d) { %>
                  <span class="text-secondary"><%= spielLaeuft ? 'Während des Laufs auf Knopfdruck, nach dem Ende von selbst.' : (lauf ? 'Dieser Lauf hat keinen Vergleich (Daemon vor 1.0.93).' : '—') %></span>
                <% } else { %>
                  <%- include('werkbank-dateien', { d, gruppiere, groesse }) %>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  </div></div>

  <div class="col-12" data-reiter="verbindung" role="tabpanel" aria-labelledby="reiter-verbindung"><div class="row row-cards">

  <!-- ── Ports und Abfrage (Karte, 2026-10-07) ─────────────────────────── -->
  <%
    // Ports entstehen aus der Beobachtung im Probestart; hier bekommen sie, was
    // ein Paket sonst noch an ihnen trägt. Die Abfrage sagt, womit und wo das
    // Panel Spielerzahl und Servername holt.
    const abfrageTeil = locals.abfrage || { query: null, bereit: false, belegbar: false, bekannt: false };
    const kennungenListe = locals.abfrageKennungen || [];
    const gesehenePorts = (sitzung.entwurf.werkbank && sitzung.entwurf.werkbank.beobachtet) || {};
    const bereitPort = (sitzung.entwurf.start && sitzung.entwurf.start.ready_when && sitzung.entwurf.start.ready_when.port) || '';
    function kopplung(p) { const m = /^([a-z][a-z0-9_]*)\+([0-9]+)$/.exec(p.assign || ''); return m ? { basis: m[1], abstand: Number(m[2]) } : null; }
  %>
  <div class="col-12">
    <div class="card" id="kartePorts">
      <div class="card-header">
        <h3 class="card-title">Ports und Abfrage</h3>
        <div class="card-actions"><span class="text-secondary small">
          <%= entwurfPorts.length %> Port<%= entwurfPorts.length === 1 ? '' : 's' %> ·
          Abfrage: <%= abfrageTeil.query ? abfrageTeil.query.protocol : 'keine' %>
        </span></div>
      </div>
      <div class="card-body">
        <div class="row g-4">
          <div class="col-lg-7">
            <%# Hilfstexte dieser Karte: ein Satz auf der Seite, der Rest hinter dem
                runden „?" (werkbank-hilfe.ejs, 2026-10-08). %>
            <style>.popover.werkbank-hilfe { --tblr-popover-max-width: 24rem; }</style>
            <p class="text-secondary small">
              Ports kommen aus der <strong>Beobachtung</strong> im Probestart — Nummern trägst du nicht ein.<%- include('werkbank-hilfe', { text:
                'Hier legst du fest, was das Paket sonst über einen Port sagt: ob er fest an einem anderen hängt, ob er Pflicht ist und wie das Spiel seine Nummer erfährt.' }) %>
            </p>
            <% if (!entwurfPorts.length) { %>
              <p class="text-secondary small mb-3">Noch kein Port im Entwurf. Starte das Spiel im Probestart und übernimm, was lauscht.</p>
            <% } else { %>
              <div class="table-responsive mb-3">
                <table class="table table-sm table-vcenter">
                  <thead><tr><th>Zweck</th><th>Nummer</th><th>Vergabe</th><th>Pflicht</th><th>Erfährt das Spiel über</th><th class="w-1"></th></tr></thead>
                  <tbody>
                    <% entwurfPorts.forEach(function (p) { const k = kopplung(p); const nr = werkbankTeil.portnummern[p.purpose]; %>
                      <tr>
                        <td class="text-nowrap">
                          <span class="font-monospace"><%= p.purpose %></span><% if (p.description && (p.description.de || p.description.en)) { %><%- include('werkbank-hilfe', { text: p.description.de || p.description.en }) %><% } %>
                        </td>
                        <td class="text-nowrap">
                          <span class="badge bg-green-lt font-monospace"><%= nr || '?' %>/<%= p.protocol %></span>
                          <div class="text-secondary small"><%= k ? 'gerechnet' : (gesehenePorts[p.purpose] ? 'beobachtet' : 'vorläufig') %></div>
                        </td>
                        <td class="text-nowrap"><% if (k) { %><span class="font-monospace"><%= k.basis %></span> + <%= k.abstand %><% } else { %>eigene Nummer<% } %></td>
                        <td>
                          <%= p.required === false ? 'optional' : 'Pflicht' %>
                          <% if (p.needed_by) { %><div class="text-secondary small">nur wenn <span class="font-monospace"><%= p.needed_by %></span> da ist</div><% } %>
                        </td>
                        <td>
                          <% if (p.variable) { %><span class="font-monospace"><%= p.variable %></span>
                          <% } else if (k) { %><span class="text-secondary small">leitet es selbst ab</span>
                          <% } else if (ungenutztePorts.includes(p.purpose)) { %><span class="text-warning small">nichts — es fehlt <code>{{port:<%= p.purpose %>}}</code></span>
                          <% } else { %><span class="text-secondary small">Startzeile, Umgebung oder Datei</span><% } %>
                        </td>
                        <td class="text-nowrap">
                          <button class="btn btn-sm btn-outline-secondary" type="button" data-port-bearbeiten="<%= JSON.stringify(p) %>" <%= beschaeftigt ? 'disabled' : '' %>>Bearbeiten</button>
                          <button class="btn btn-sm btn-outline-danger" type="button" data-port-entfernen="<%= p.purpose %>" <%= beschaeftigt ? 'disabled' : '' %>>Entfernen</button>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>

            <details id="portDetails">
              <summary class="mb-2"><span id="portUeberschrift">Mod-Port von Hand anlegen</span></summary>
              <form id="formPort" class="row g-2" autocomplete="off">
                <input type="hidden" name="alt" value="">
                <div class="col-md-4">
                  <label class="form-label" for="pZweck">Zweck</label>
                  <input class="form-control font-monospace" id="pZweck" name="zweck" placeholder="voice" required>
                </div>
                <div class="col-md-3">
                  <label class="form-label" for="pProtokoll">Protokoll</label>
                  <select class="form-select" id="pProtokoll" name="protocol">
                    <option value="udp">udp</option><option value="tcp">tcp</option><option value="both">beide (tcp + udp)</option>
                  </select>
                </div>
                <div class="col-md-5 d-flex align-items-end">
                  <label class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" name="optional">
                    <span class="form-check-label">Optional — der Server startet auch ohne ihn</span>
                  </label>
                </div>
                <div class="col-md-5">
                  <div class="form-label"><label for="pBasis">Vergabe</label><%- include('werkbank-hilfe', { text:
                    'Fest über einem anderen Port heißt: Das Spiel leitet die Nummer selbst ab (Valheims Abfrage ist immer Spielport + 1) — der Server bekommt dann zwei zusammenhängende Nummern, oder er wird nicht angelegt.' }) %></div>
                  <select class="form-select" id="pBasis" name="basis">
                    <option value="">eigene Nummer</option>
                    <% entwurfPorts.filter(function (p) { return !kopplung(p); }).forEach(function (p) { %>
                      <option value="<%= p.purpose %>">fest über „<%= p.purpose %>"</option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-md-3">
                  <label class="form-label" for="pAbstand">Abstand</label>
                  <input class="form-control" id="pAbstand" name="abstand" type="number" min="<%= PORT.abstand[0] %>" max="<%= PORT.abstand[1] %>" value="1" disabled>
                </div>
                <div class="col-md-4">
                  <div class="form-label"><label for="pVariable">Umgebungsvariable</label><%- include('werkbank-hilfe', { text:
                    'Nur nötig, wenn das Spiel die Nummer weder über die Startzeile noch über eine Datei erfährt.' }) %></div>
                  <input class="form-control font-monospace" id="pVariable" name="variable" placeholder="leer = keine">
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="pTextDe">Beschreibung (deutsch)</label>
                  <textarea class="form-control" id="pTextDe" name="beschreibung_de" rows="2" maxlength="<%= PORT.beschreibung %>"></textarea>
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="pTextEn">Beschreibung (englisch)</label>
                  <textarea class="form-control" id="pTextEn" name="beschreibung_en" rows="2" maxlength="<%= PORT.beschreibung %>"></textarea>
                </div>
                <div class="col-12">
                  <label class="form-label" for="pNurWenn">Nur wenn diese Datei da ist</label>
                  <input class="form-control font-monospace" id="pNurWenn" name="needed_by" placeholder="leer lassen — oder etwa game/mods/voicechat-*.jar">
                  <div class="form-hint">Für Ports, die erst ein Mod mitbringt.<%- include('werkbank-hilfe', { text:
                    'Geprüft wird vor jedem Start: Passt eine Datei, wird der Port gebucht, sonst freigegeben. Geht nur optional und mit eigener Nummer. Nur solche Ports lassen sich von Hand anlegen — ohne den Mod lauscht nichts, was sich beobachten ließe.' }) %></div>
                </div>
                <div class="col-12 d-flex gap-2">
                  <button class="btn btn-primary" type="submit" <%= beschaeftigt ? 'disabled' : '' %>><i class="fa-solid fa-floppy-disk me-1"></i>Port speichern</button>
                  <button class="btn btn-outline-secondary" type="button" id="knopfPortNeu">Leeren</button>
                </div>
              </form>
            </details>
          </div>

          <div class="col-lg-5">
            <p class="text-secondary small">
              Die <strong>Abfrage</strong> sagt dem Panel, womit und auf welchem Port es Spielerzahl und Servernamen holt.<%- include('werkbank-hilfe', { text:
                'Ohne sie zeigt die Serverseite nur „läuft".' }) %>
            </p>
            <form id="formAbfrage" class="row g-2" autocomplete="off">
              <div class="col-md-7">
                <label class="form-label" for="aProtokoll">Protokoll</label>
                <input class="form-control font-monospace" id="aProtokoll" name="protocol" list="abfrageKennungen" placeholder="tippen: valheim, minecraft, a2s …"
                       value="<%= abfrageTeil.query ? abfrageTeil.query.protocol : '' %>" required>
                <datalist id="abfrageKennungen">
                  <% kennungenListe.forEach(function (k) { %><option value="<%= k.kennung %>" data-belegbar="<%= k.belegbar ? '1' : '' %>"><%= k.name %></option><% }) %>
                </datalist>
              </div>
              <div class="col-md-5">
                <label class="form-label" for="aPort">Port</label>
                <select class="form-select" id="aPort" name="port" required>
                  <% entwurfPorts.forEach(function (p) { %><option value="<%= p.purpose %>" <%= abfrageTeil.query && abfrageTeil.query.port === p.purpose ? 'selected' : '' %>><%= p.purpose %></option><% }) %>
                </select>
              </div>
              <div class="col-12 form-hint" id="abfrageBelegbar"></div>
              <div class="col-12">
                <div class="d-flex align-items-center">
                  <label class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" name="bereit" <%= abfrageTeil.bereit ? 'checked' : '' %>>
                    <span class="form-check-label">Erst bereit, wenn die Abfrage antwortet</span>
                  </label><%- include('werkbank-hilfe', { text:
                    'Dann gilt ein Server erst als bereit, wenn das Spiel wirklich antwortet — nicht schon, wenn der Port offen ist. Der Prüfdurchlauf wird damit erst grün, wenn die Abfrage geantwortet hat.' }) %>
                </div>
                <%# Was hier zu TUN ist, bleibt auf der Seite — nur die Erklärung wandert hinter das „?". %>
                <% if (!bereitPort) { %><div class="form-hint">Braucht im Startteil „Bereit, wenn Port".</div><% } %>
              </div>
              <% if (abfrageTeil.query && !abfrageTeil.bekannt) { %>
                <div class="col-12"><div class="alert alert-warning py-2 small mb-0">„<%= abfrageTeil.query.protocol %>" steht nicht im Katalog — die Paketprüfung lehnt das beim Veröffentlichen ab.</div></div>
              <% } %>
              <div class="col-12 d-flex gap-2">
                <button class="btn btn-primary" type="submit" <%= (beschaeftigt || !entwurfPorts.length) ? 'disabled' : '' %>><i class="fa-solid fa-floppy-disk me-1"></i>Abfrage speichern</button>
                <% if (abfrageTeil.query) { %><button class="btn btn-outline-danger" type="button" id="knopfAbfrageWeg" <%= beschaeftigt ? 'disabled' : '' %>>Abfrage entfernen</button><% } %>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Fernsteuerung (Karte, 2026-10-08) ──────────────────────────────── -->
  <%
    // Die RCON-Verbindung des Pakets und seine Befehlsgruppen. Die Stoppfolge
    // (auch `rcon:…`) steht im Startteil. Belegt wird die Verbindung im
    // Prüfdurchlauf: anmelden, einen harmlosen Befehl senden, Antwort lesen.
    const fern = locals.fernsteuerung || { rcon: null, kandidaten: [], quelle: null, warnungen: [], eigener: '', pruefbefehl: '', vorschlag: '', abhaengige: [] };
    const befehlListe = Object.entries(locals.befehle || {});
    const RC = locals.RCON || { protokolle: [], gebaut: [], befehl: 200 };
    const BF = locals.BEFEHL || { gruppen: [], wege: [], arten: [], text: 300 };
    const bfName = locals.befehlNamen || {};
    const WEG = { rcon: ['bg-green-lt', 'Fernsteuerung'], console: ['bg-green-lt', 'Konsole'], file: ['bg-blue-lt', 'Datei'],
                  query: ['bg-green-lt', 'Abfrage'], unsupported: ['bg-secondary-lt', 'nicht möglich'] };
    const ART = { append_line: 'Zeile anhängen', remove_line: 'Zeile entfernen', rewrite: 'Datei neu schreiben' };
    const rconBeleg = (pruefung && pruefung.ergebnis && pruefung.ergebnis.rcon) || null;
    const tcpPorts = entwurfPorts.filter(function (p) { return p.protocol !== 'udp'; });
    const fernPorts = (fern.rcon && !tcpPorts.some(function (p) { return p.purpose === fern.rcon.port; }))
      ? tcpPorts.concat([{ purpose: fern.rcon.port, fehlt: true }]) : tcpPorts;
    const fernVariablen = fern.kandidaten.slice();
    if (fern.rcon && fern.rcon.password_variable && !fernVariablen.some(function (k) { return k.variable === fern.rcon.password_variable; })) {
      fernVariablen.push({ key: null, variable: fern.rcon.password_variable });
    }
    function befehlDetail(c) {
      if (c.via === 'file') return (c.file || '') + (c.mode ? ' · ' + (ART[c.mode] || c.mode) : '') + (c.value ? ' · ' + c.value : '');
      if (c.via === 'unsupported') return (c.reason && (c.reason.de || c.reason.en)) || '';
      return [c.command, c.parse ? 'Auswertung: ' + c.parse : ''].filter(Boolean).join(' · ');
    }
  %>
  <div class="col-12">
    <div class="card" id="karteFernsteuerung">
      <div class="card-header">
        <h3 class="card-title">Fernsteuerung</h3>
        <div class="card-actions"><span class="text-secondary small">
          RCON: <%= fern.rcon ? fern.rcon.protocol : 'keine' %> · <%= befehlListe.length %> Befehl<%= befehlListe.length === 1 ? '' : 'e' %>
        </span></div>
      </div>
      <div class="card-body">
        <div class="row g-4">

          <div class="col-lg-5">
            <p class="text-secondary small">
              Über die <strong>Fernsteuerung</strong> (RCON) spricht der Daemon mit dem laufenden Spiel.<%- include('werkbank-hilfe', { text:
                'Er braucht sie für Schritte wie „rcon:stop" in der Stoppfolge (die steht im Startteil), für Einstellungen mit Ziel rcon und für Befehle im Panel. Ohne sie endet ein Spiel, das nur über RCON speichert, beim Stopp hart.' }) %>
            </p>
            <% fern.warnungen.forEach(function (w) { %>
              <div class="alert alert-warning py-2 small"><%= w %></div>
            <% }) %>
            <% if (!fernPorts.length) { %>
              <p class="text-secondary small mb-0">Die Fernsteuerung braucht einen tcp-Port im Entwurf — im Probestart beobachten und unter „Ports" übernehmen.</p>
            <% } else if (!fernVariablen.length) { %>
              <p class="text-secondary small mb-0">Die Fernsteuerung braucht ein Kennwort: Lege unter „Einstellungen" eine Kennwort-Einstellung mit dem Ziel „Umgebungsvariable" an — dann lässt sie sich hier wählen.</p>
            <% } else { %>
              <form id="formFern" class="row g-2" autocomplete="off">
                <div class="col-md-6">
                  <label class="form-label" for="fProtokoll">Protokoll</label>
                  <select class="form-select" id="fProtokoll" name="protocol">
                    <% RC.protokolle.forEach(function (pr) { const gebaut = RC.gebaut.includes(pr); const gewaehlt = fern.rcon ? fern.rcon.protocol === pr : pr === 'source'; %>
                      <option value="<%= pr %>" <%= gewaehlt ? 'selected' : '' %> <%= (!gebaut && !gewaehlt) ? 'disabled' : '' %>><%= pr %><%= gebaut ? '' : ' — spricht der Daemon nicht' %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="fPort">Port</label>
                  <select class="form-select" id="fPort" name="port">
                    <% fernPorts.forEach(function (p) { %>
                      <option value="<%= p.purpose %>" <%= fern.rcon && fern.rcon.port === p.purpose ? 'selected' : '' %>><%= p.purpose %><%= p.fehlt ? ' — fehlt im Entwurf' : '' %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-12">
                  <div class="form-label"><label for="fVariable">Kennwort aus</label><%- include('werkbank-hilfe', { text:
                    'Das Kennwort steht nie im Paket. Eine Einstellung schreibt es in eine Umgebungsvariable, und von dort lesen es Spiel und Daemon. Hier wählst du, welche das ist.' }) %></div>
                  <select class="form-select" id="fVariable" name="password_variable">
                    <% fernVariablen.forEach(function (k) { %>
                      <option value="<%= k.variable %>" <%= fern.rcon && fern.rcon.password_variable === k.variable ? 'selected' : '' %>><%= k.key ? 'Einstellung „' + k.key + '" → ' + k.variable + (k.kennwort ? '' : ' (kein Kennwortfeld)') : k.variable + ' — keine Einstellung schreibt sie' %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-12">
                  <div class="form-label"><label for="fPruefbefehl">Prüfbefehl</label><%- include('werkbank-hilfe', { text:
                    'Der Prüfdurchlauf meldet sich über die Fernsteuerung an, sendet diesen Befehl und liest die Antwort — erst dann gilt sie als belegt. Nimm einen, der nur liest. Bei Factorio ist Text ohne Schrägstrich eine Chatnachricht. Der Befehl gehört der Sitzung und kommt nicht ins Paket.' }) %></div>
                  <input class="form-control font-monospace" id="fPruefbefehl" name="pruefbefehl" maxlength="<%= RC.befehl %>"
                         value="<%= fern.eigener %>" placeholder="<%= fern.vorschlag ? 'leer = ' + fern.vorschlag + ' (die Spielerliste)' : 'etwa list' %>">
                  <% if (!fern.pruefbefehl) { %>
                    <div class="form-hint text-warning">Ohne Prüfbefehl meldet sich der Durchlauf nicht an — die Fernsteuerung käme als „nicht belegt" ins Paket.</div>
                  <% } %>
                </div>
                <div class="col-12 d-flex gap-2">
                  <button class="btn btn-primary" type="submit" <%= beschaeftigt ? 'disabled' : '' %>><i class="fa-solid fa-floppy-disk me-1"></i>Fernsteuerung speichern</button>
                  <% if (fern.rcon) { %><button class="btn btn-outline-danger" type="button" id="knopfFernWeg" <%= beschaeftigt ? 'disabled' : '' %>>Entfernen</button><% } %>
                </div>
              </form>
            <% } %>
            <% if (fern.rcon) { %>
              <div class="small mt-3" id="fernBeleg">
                <% if (rconBeleg && rconBeleg.angemeldet) { %>
                  <span class="badge bg-green-lt">belegt</span>
                  Durchlauf #<%= pruefung.id %>: angemeldet nach <%= rconBeleg.nach_sek %> s, „<span class="font-monospace"><%= rconBeleg.befehl %></span>" beantwortet<%= pruefHash !== entwurfHash ? ' — der Entwurf ist seither geändert' : '' %>.
                  <% if (rconBeleg.antwort) { %><details class="mt-1"><summary class="text-secondary">Antwort des Spiels</summary><pre class="mt-1 mb-0 p-2 small" style="background:var(--tblr-bg-surface-secondary);color:var(--tblr-body-color);white-space:pre-wrap"><%= lesbar(rconBeleg.antwort) %></pre></details><% } %>
                <% } else if (rconBeleg) { %>
                  <span class="badge bg-red-lt">gescheitert</span>
                  Durchlauf #<%= pruefung.id %>, <%= rconBeleg.versuche %> Versuch<%= rconBeleg.versuche === 1 ? '' : 'e' %>: <%= rconBeleg.fehler %>
                <% } else if (pruefung && pruefung.ergebnis) { %>
                  <span class="badge bg-secondary-lt">nicht belegt</span>
                  Der letzte Durchlauf hat sich nicht angemeldet<%= fern.pruefbefehl ? ' — er lief vor dieser Karte oder auf einem älteren Daemon' : '' %>.
                <% } else { %>
                  <span class="badge bg-secondary-lt">noch kein Durchlauf</span>
                <% } %>
              </div>
              <% if (fern.abhaengige.length) { %>
                <div class="text-secondary small mt-2">Daran hängt: <%= fern.abhaengige.join(', ') %>.</div>
              <% } %>
            <% } %>
          </div>

          <div class="col-lg-7">
            <p class="text-secondary small">
              <strong>Befehle</strong> sagen, wie das Panel Spieler auflistet, entfernt, sperrt, die Welt speichert und Nachrichten sendet.<%- include('werkbank-hilfe', { text:
                'Je Gruppe ein Weg: über die Fernsteuerung, die Konsole, eine Datei, die Abfrage — oder „nicht möglich" mit Begründung. Stand heute zeigt die Serverseite diese Liste in der fachlichen Ansicht nur an; ausgeführt wird daraus noch nichts.' }) %>
            </p>
            <% if (!befehlListe.length) { %>
              <p class="text-secondary small mb-3">Noch kein Befehl im Entwurf.</p>
            <% } else { %>
              <div class="table-responsive mb-3">
                <table class="table table-sm table-vcenter">
                  <thead><tr><th>Gruppe</th><th>Weg</th><th>Was</th><th class="w-1"></th></tr></thead>
                  <tbody>
                    <% befehlListe.forEach(function (z) { const key = z[0], c = z[1] || {}; const w = WEG[c.via] || ['bg-secondary-lt', c.via || '?']; %>
                      <tr>
                        <td class="text-nowrap"><%= bfName[key] || key %><div class="text-secondary small font-monospace"><%= key %></div></td>
                        <td><span class="badge <%= w[0] %>"><%= w[1] %></span></td>
                        <td class="small<%= c.via === 'unsupported' ? ' text-secondary' : ' font-monospace' %>" style="word-break:break-word"><%= befehlDetail(c) %></td>
                        <td class="text-nowrap">
                          <button class="btn btn-sm btn-outline-secondary" type="button" data-befehl-bearbeiten="<%= JSON.stringify({ key: key, c: c }) %>" <%= beschaeftigt ? 'disabled' : '' %>>Bearbeiten</button>
                          <button class="btn btn-sm btn-outline-danger" type="button" data-befehl-entfernen="<%= key %>" <%= beschaeftigt ? 'disabled' : '' %>>Entfernen</button>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>

            <details id="befehlDetails">
              <summary class="mb-2"><span id="befehlUeberschrift">Befehl anlegen</span></summary>
              <form id="formBefehl" class="row g-2" autocomplete="off">
                <div class="col-md-6">
                  <label class="form-label" for="bKey">Gruppe</label>
                  <input class="form-control font-monospace" id="bKey" name="key" list="befehlGruppen" placeholder="players.list" required>
                  <datalist id="befehlGruppen">
                    <% BF.gruppen.forEach(function (g) { %><option value="<%= g %>"><%= bfName[g] || g %></option><% }) %>
                  </datalist>
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="bWeg">Weg</label>
                  <select class="form-select" id="bWeg" name="via">
                    <% BF.wege.forEach(function (v) { %><option value="<%= v %>" <%= (v === 'rcon' && !fern.rcon) ? 'disabled' : '' %>><%= (WEG[v] || ['', v])[1] %><%= (v === 'rcon' && !fern.rcon) ? ' — erst links anlegen' : '' %></option><% }) %>
                  </select>
                </div>
                <div class="col-12" data-weg="rcon console">
                  <div class="form-label"><label for="bBefehl">Befehl</label><%- include('werkbank-hilfe', { text:
                    'So, wie das Spiel ihn erwartet. Platzhalter, die das Panel einsetzt: {{player_id}}, {{reason}}, {{message}}.' }) %></div>
                  <input class="form-control font-monospace" id="bBefehl" name="command" maxlength="<%= BF.text %>" placeholder="kick {{player_id}} {{reason}}">
                </div>
                <div class="col-md-6" data-weg="file">
                  <label class="form-label" for="bDatei">Datei</label>
                  <input class="form-control font-monospace" id="bDatei" name="file" maxlength="<%= BF.text %>" placeholder="bannedlist.txt">
                </div>
                <div class="col-md-6" data-weg="file">
                  <label class="form-label" for="bArt">Art</label>
                  <select class="form-select" id="bArt" name="mode">
                    <% BF.arten.forEach(function (a) { %><option value="<%= a %>"><%= ART[a] || a %></option><% }) %>
                  </select>
                </div>
                <div class="col-12" data-weg="file">
                  <label class="form-label" for="bWert">Wert</label>
                  <input class="form-control font-monospace" id="bWert" name="value" maxlength="<%= BF.text %>" placeholder="{{player_id}}">
                </div>
                <div class="col-12" data-weg="rcon console query">
                  <div class="form-label"><label for="bLesen">Auswertung</label><%- include('werkbank-hilfe', { text:
                    'Wie die Antwort gelesen wird — etwa minecraft:list oder table:name,ping. Leer lassen, wenn die Antwort nicht ausgewertet wird.' }) %></div>
                  <input class="form-control font-monospace" id="bLesen" name="parse" maxlength="<%= BF.text %>" placeholder="leer = nicht auswerten">
                </div>
                <div class="col-md-6" data-weg="unsupported">
                  <label class="form-label" for="bGrundDe">Begründung (deutsch)</label>
                  <textarea class="form-control" id="bGrundDe" name="grund_de" rows="2" maxlength="600"></textarea>
                </div>
                <div class="col-md-6" data-weg="unsupported">
                  <label class="form-label" for="bGrundEn">Begründung (englisch)</label>
                  <textarea class="form-control" id="bGrundEn" name="grund_en" rows="2" maxlength="600"></textarea>
                </div>
                <div class="col-12 d-flex gap-2">
                  <button class="btn btn-primary" type="submit" <%= beschaeftigt ? 'disabled' : '' %>><i class="fa-solid fa-floppy-disk me-1"></i>Befehl speichern</button>
                  <button class="btn btn-outline-secondary" type="button" id="knopfBefehlNeu">Leeren</button>
                </div>
              </form>
            </details>
          </div>

        </div>
      </div>
    </div>
  </div>

  </div></div>

  <div class="col-12" data-reiter="einstellungen" role="tabpanel" aria-labelledby="reiter-einstellungen"><div class="row row-cards">

  <!-- ── Einstellungen (Baukasten B1, 2026-09-26) ───────────────────────── -->
  <%
    const nachweise = (pruefung && pruefung.ergebnis && Array.isArray(pruefung.ergebnis.einstellungen)) ? pruefung.ergebnis.einstellungen : null;
    const nachweisVeraltet = pruefung && pruefHash !== entwurfHash;
    // Kurzform für die Auswahl in der Tabelle — dieselbe Zuordnung wie HOEHE in Serverseite.js.
    const ROLLE_KURZ = { player: 'einfache Ansicht + Anlegen', owner: 'fachlich (Betreiber)', expert: 'fachlich (Experte)' };
    const ROLLE = { player: 'beim Anlegen gefragt', owner: 'nur fachliche Ansicht (Betreiber)', expert: 'nur fachliche Ansicht (Experte)' };
    const ZUSTAND = {
      angekommen:       ['bg-green-lt',     'angekommen'],
      nicht_gefunden:   ['bg-red-lt',       'Datei kennt den Schlüssel nicht'],
      fehlgeschlagen:   ['bg-red-lt',       'Schreiben gescheitert'],
      keine_meldung:    ['bg-orange-lt',    'keine Meldung'],
      nicht_verdrahtet: ['bg-orange-lt',    'nichts holt den Wert'],
      nicht_pruefbar:   ['bg-secondary-lt', 'im Durchlauf nicht prüfbar']
    };
    function zielText(z, e) {
      if (z.target === 'file') {
        // Bei einem Schalter gehört die Schreibweise dazu — sonst sieht man nicht, was in der Datei landet.
        var als = e && e.type === 'boolean'
          ? ' · An/Aus als ' + (z.as ? (z.as === 'one_zero' ? '1/0' : z.as.replace('_', '/')) : '1/0 — nicht gewählt')
          : '';
        return z.file + ' → ' + z.path + ' (' + z.parser + ')' + als;
      }
      if (z.target === 'env')  return 'Umgebung ' + z.variable;
      if (z.target === 'arg')  return 'Startzeile ({{setting:…}})';
      if (z.target === 'rcon') return 'RCON: ' + z.command;
      return z.target;
    }
    function nachweisFuer(s, z) {
      if (!nachweise) return null;
      return nachweise.find(function (n) {
        return n.key === s.key && n.ziel === z.target
          && (z.target !== 'file' || n.wo === z.file + ': ' + z.path)
          && (z.target !== 'env' || n.wo === z.variable);
      }) || null;
    }
  %>
  <div class="col-12">
    <div class="card" id="karteEinstellungen">
      <div class="card-header">
        <h3 class="card-title">Einstellungen</h3>
        <div class="card-actions"><span class="text-secondary small"><%= einstellungen.length %> im Entwurf</span></div>
      </div>
      <div class="card-body">
        <p class="text-secondary small">
          Was ein Server dieses Spiels einstellbar machen soll. <strong>Rolle</strong> entscheidet, wer sie sieht:
          „beim Anlegen gefragt" steht im Anlegeformular und in der einfachen Ansicht, die anderen nur in der fachlichen.
          Was sich nur mit einer Neuinstallation ändern lässt (Wirkung „Neuinstallation"), wird immer beim Anlegen gefragt.
          Ins Paket kommt nur, was der letzte grüne Prüfdurchlauf als <em>angekommen</em> belegt — Probestart und Durchlauf laufen mit dem Probewert, leer heißt: mit der Vorgabe.
        </p>
        <% if (einstellungen.some(function (e) { return (e.apply || []).some(function (z) { return z.target === 'arg'; }); })) { %>
          <div class="alert alert-info py-2 small">Ziel „Startzeile": Der Wert kommt nur an, wenn eine Zeile im Startteil <code>{{setting:schlüssel}}</code> enthält, etwa <code>--name={{setting:name}}</code>.
            Für „Umgebung" schreibt die Werkbank die Zeile selbst ins Paket.</div>
        <% } %>

        <% if (einstellungen.length) { %>
          <div class="table-responsive mb-3">
            <table class="table table-sm table-vcenter mb-0">
              <thead><tr><th>Einstellung</th><th>Rolle · Wirkung</th><th>Ziele<%= nachweise ? (nachweisVeraltet ? ' (Nachweis veraltet)' : ' · Nachweis #' + pruefung.id) : '' %></th><th style="width:14rem">Probewert</th><th></th></tr></thead>
              <tbody>
                <% einstellungen.forEach(function (e) { %>
                  <tr>
                    <td>
                      <div><%= (e.name && (e.name.de || e.name.en)) || e.key %><% if (e.required) { %> <span class="badge bg-secondary-lt">Pflicht</span><% } %></div>
                      <div class="text-secondary small font-monospace"><%= e.key %> · <%= e.type %><%= e.group ? ' · ' + ((anzeige.GRUPPE[e.group]) || e.group) : '' %></div>
                    </td>
                    <td class="small">
                      <select class="form-select form-select-sm mb-1" data-rolle="<%= e.key %>" title="Wo die Einstellung später steht" <%= beschaeftigt ? 'disabled' : '' %>>
                        <% EINSTELLUNG.rollen.forEach(function (r) { %><option value="<%= r %>" <%= (e.role || 'expert') === r ? 'selected' : '' %>><%= ROLLE_KURZ[r] || r %></option><% }) %>
                      </select>
                      <div class="text-secondary"><%= (anzeige.WIRKUNG[e.takes_effect] && anzeige.WIRKUNG[e.takes_effect].text) || e.takes_effect %><%= anzeige.RISIKO[e.risk] ? ' · ' + anzeige.RISIKO[e.risk] : '' %></div>
                    </td>
                    <td class="small">
                      <% (e.apply || []).forEach(function (z) { const n = nachweisFuer(e, z); const zst = n ? (ZUSTAND[n.zustand] || ['bg-secondary-lt', n.zustand]) : null; %>
                        <div>
                          <span class="font-monospace"><%= zielText(z, e) %></span>
                          <% if (zst) { %><span class="badge <%= nachweisVeraltet ? 'bg-secondary-lt' : zst[0] %>" <% if (n.hinweis) { %>title="<%= n.hinweis %>"<% } %>><%= zst[1] %></span><% } %>
                        </div>
                      <% }) %>
                    </td>
                    <td>
                      <%# Kein Knopf je Zeile mehr: Unter der Tabelle speichert EINER alle
                          geänderten Werte (2026-10-08). %>
                      <div class="input-group input-group-sm">
                        <% if (e.type === 'boolean') { %>
                          <select class="form-select" data-probewert="<%= e.key %>">
                            <option value="" <%= !(e.key in probewerte) ? 'selected' : '' %>>Vorgabe (<%= e.default ? 'an' : 'aus' %>)</option>
                            <option value="1" <%= probewerte[e.key] === '1' ? 'selected' : '' %>>an</option>
                            <option value="0" <%= probewerte[e.key] === '0' ? 'selected' : '' %>>aus</option>
                          </select>
                        <% } else if (e.type === 'choice') { %>
                          <select class="form-select" data-probewert="<%= e.key %>">
                            <option value="" <%= !(e.key in probewerte) ? 'selected' : '' %>>Vorgabe<%= e.default !== undefined ? ' (' + e.default + ')' : '' %></option>
                            <% (e.choices || []).forEach(function (c) { %><option value="<%= c.value %>" <%= probewerte[e.key] === String(c.value) ? 'selected' : '' %>><%= (c.name && c.name.de) || c.value %></option><% }) %>
                          </select>
                        <% } else { %>
                          <input class="form-control" data-probewert="<%= e.key %>" type="<%= e.type === 'password' ? 'password' : 'text' %>"
                                 value="<%= e.key in probewerte ? probewerte[e.key] : '' %>" placeholder="<%= e.default !== undefined && e.type !== 'password' ? 'Vorgabe: ' + e.default : 'Vorgabe' %>" autocomplete="off">
                        <% } %>
                      </div>
                    </td>
                    <td class="text-end text-nowrap">
                      <button class="btn btn-sm btn-outline-secondary" type="button" data-einstellung-bearbeiten='<%= JSON.stringify(e) %>' <%= beschaeftigt ? 'disabled' : '' %>>Bearbeiten</button>
                      <button class="btn btn-sm btn-outline-danger" type="button" data-einstellung-entfernen="<%= e.key %>" <%= beschaeftigt ? 'disabled' : '' %>>Entfernen</button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <%# Ein Knopf für alle Probewerte. Er ist NICHT gesperrt, wenn etwas läuft:
              Probewerte gehören der Sitzung und gelten ab dem nächsten Start. %>
          <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <button class="btn btn-primary" type="button" id="knopfProbewerte" disabled>
              <i class="fa-solid fa-floppy-disk me-1"></i><span id="knopfProbewerteText">Probewerte speichern</span>
            </button>
            <span class="text-secondary small">
              Probewerte gelten ab dem nächsten Probestart oder Prüfdurchlauf<%= beschaeftigt ? ' — was gerade läuft, behält seine' : '' %>. Leer heißt: die Vorgabe.
            </span>
          </div>
        <% } %>
        <% if (belegt && belegt.weg.length && !nachweisVeraltet) { %>
          <div class="alert alert-warning py-2 small">
            <div class="mb-1">Diese Einstellungen kämen beim Veröffentlichen <strong>nicht</strong> ins Paket:</div>
            <ul class="mb-0"><% belegt.weg.forEach(function (w) { %><li><span class="font-monospace"><%= w.key %></span> — <%= w.grund %></li><% }) %></ul>
          </div>
        <% } %>

        <!-- Vorschläge aus einer Datei (B2-1, 2026-09-29): der Daemon liest wie sein Schreiber -->
        <details id="vorschlagDetails" class="mb-3">
          <summary class="mb-2">Vorschläge aus einer Datei</summary>
          <p class="text-secondary small">
            Nach einem Probestart liegen die Dateien, die das Spiel angelegt hat, im Volume der Sitzung. Der Daemon liest eine davon
            und nennt jeden Schlüssel, den er beim Start auch wieder beschreiben kann. Angekreuztes wird als Einstellung angelegt:
            Rolle „Experte", Wirkung „Neustart", der Wert aus der Datei als Vorgabe (bei Kennwörtern nicht). Danach per „Bearbeiten" anpassen.
            Nur Dateien unter <code>game/</code> — dorthin schreibt der Start.
          </p>
          <form id="formSchluessel" class="row g-2 align-items-end">
            <div class="col-md-6">
              <label class="form-label" for="sDatei">Datei (relativ zu game/)</label>
              <input class="form-control font-monospace" id="sDatei" name="datei" list="sDateiListe" autocomplete="off"
                     placeholder="<%= vorschlagsDateien.length ? vorschlagsDateien[0].datei : 'server-settings.json' %>" required>
              <datalist id="sDateiListe">
                <% vorschlagsDateien.forEach(function (v) { %><option value="<%= v.datei %>" data-format="<%= v.format %>"><% }) %>
              </datalist>
              <div class="form-hint"><%= vorschlagsDateien.length ? vorschlagsDateien.length + ' Datei(en) aus Installation und Probestarts zur Auswahl — andere lassen sich tippen.' : 'Noch keine passende Datei aus Installation oder Probestart — der Pfad lässt sich auch tippen.' %></div>
            </div>
            <div class="col-md-3">
              <label class="form-label" for="sParser">Format</label>
              <select class="form-select" id="sParser" name="parser">
                <% ['json', 'ini', 'yaml', 'properties', 'xml'].forEach(function (x) { %><option value="<%= x %>"><%= x %></option><% }) %>
              </select>
            </div>
            <div class="col-md-3">
              <button class="btn btn-outline-primary w-100" type="submit" id="knopfSchluessel"><i class="fa-solid fa-magnifying-glass me-1"></i>Schlüssel lesen</button>
            </div>
          </form>
          <div id="schluesselErgebnis" class="mt-3"></div>
        </details>

        <details id="einstellungDetails" <%= einstellungen.length ? '' : 'open' %>>
          <summary class="mb-2"><span id="einstellungUeberschrift">Neue Einstellung</span></summary>
          <form id="formEinstellung" class="row g-3">
            <input type="hidden" name="alt" value="">
            <div class="col-md-3">
              <label class="form-label" for="eKey">Schlüssel</label>
              <input class="form-control font-monospace" id="eKey" name="key" placeholder="max_players" required>
            </div>
            <div class="col-md-3">
              <label class="form-label" for="eNameDe">Name (deutsch)</label>
              <input class="form-control" id="eNameDe" name="name_de" placeholder="Maximale Spieler" required>
            </div>
            <div class="col-md-3">
              <label class="form-label" for="eNameEn">Name (englisch)</label>
              <input class="form-control" id="eNameEn" name="name_en">
            </div>
            <div class="col-md-3">
              <label class="form-label" for="eGruppe">Gruppe</label>
              <select class="form-select" id="eGruppe" name="group">
                <option value="">—</option>
                <% Object.keys(anzeige.GRUPPE).forEach(function (g) { %><option value="<%= g %>"><%= anzeige.GRUPPE[g] %></option><% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="eBeschrDe">Beschreibung (deutsch)</label>
              <input class="form-control" id="eBeschrDe" name="beschreibung_de" placeholder="Ein Satz: was sich im Spiel ändert">
            </div>
            <div class="col-md-6">
              <label class="form-label" for="eBeschrEn">Beschreibung (englisch)</label>
              <input class="form-control" id="eBeschrEn" name="beschreibung_en">
            </div>
            <div class="col-md-3">
              <label class="form-label" for="eTyp">Typ</label>
              <select class="form-select" id="eTyp" name="type">
                <option value="text">Text</option><option value="number">Zahl</option><option value="boolean">An/Aus</option>
                <option value="choice">Auswahl</option><option value="password">Passwort</option>
              </select>
            </div>
            <div class="col-md-3">
              <label class="form-label" for="eVorgabe">Vorgabe</label>
              <input class="form-control" id="eVorgabe" name="default" placeholder="leer = keine">
              <div class="form-hint" data-nur-typ="boolean">1 = an, 0 = aus. Wie es in der Datei steht, wählst du unten am Ziel.</div>
            </div>
            <div class="col-md-3" data-nur-typ="number">
              <label class="form-label">Grenzen</label>
              <div class="input-group"><input class="form-control" name="min" placeholder="min"><input class="form-control" name="max" placeholder="max"></div>
            </div>
            <div class="col-md-3 d-flex align-items-end">
              <label class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox" name="required">
                <span class="form-check-label">Pflicht — ohne Wert startet das Spiel nicht</span>
              </label>
            </div>
            <div class="col-12" data-nur-typ="choice">
              <label class="form-label" for="eAuswahl">Möglichkeiten</label>
              <textarea class="form-control font-monospace" id="eAuswahl" name="choices" rows="3" placeholder="normal=Normal&#10;hard=Schwer"></textarea>
              <div class="form-hint">Je Zeile „wert" oder „wert=Anzeigename".</div>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="eRolle">Rolle</label>
              <select class="form-select" id="eRolle" name="role">
                <option value="player">beim Anlegen gefragt (einfache Ansicht)</option>
                <option value="owner" selected>nur fachliche Ansicht (Betreiber)</option>
                <option value="expert">nur fachliche Ansicht (Experte)</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="eWirkung">Wirkung</label>
              <select class="form-select" id="eWirkung" name="takes_effect">
                <% EINSTELLUNG.wirkung.forEach(function (w) { %><option value="<%= w %>" <%= w === 'restart' ? 'selected' : '' %>><%= (anzeige.WIRKUNG[w] && anzeige.WIRKUNG[w].text) || w %></option><% }) %>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="eRisiko">Risiko</label>
              <select class="form-select" id="eRisiko" name="risk">
                <option value="none">keins</option>
                <option value="progress"><%= anzeige.RISIKO.progress %></option>
                <option value="world_reset"><%= anzeige.RISIKO.world_reset %></option>
              </select>
            </div>
            <div class="col-12">
              <label class="form-label">Wohin der Wert geht</label>
              <div id="eZiele"></div>
              <button class="btn btn-sm btn-outline-secondary mt-2" type="button" id="knopfZielDazu"><i class="fa-solid fa-plus me-1"></i>Ziel</button>
            </div>
            <div class="col-12 d-flex gap-2">
              <button class="btn btn-primary" type="submit" <%= beschaeftigt ? 'disabled' : '' %>><i class="fa-solid fa-floppy-disk me-1"></i>Einstellung speichern</button>
              <button class="btn btn-outline-secondary" type="button" id="knopfEinstellungNeu">Leeren</button>
            </div>
          </form>
          <template id="vorlageZiel">
            <div class="row g-2 align-items-end mb-2" data-ziel>
              <div class="col-md-2">
                <select class="form-select form-select-sm" data-feld="target">
                  <option value="file">Datei</option><option value="env">Umgebung</option><option value="arg">Startzeile</option><option value="rcon">RCON</option>
                </select>
              </div>
              <div class="col-md-3" data-nur-ziel="file"><input class="form-control form-control-sm font-monospace" data-feld="file" placeholder="Datei relativ zu game/, etwa server-settings.json"></div>
              <div class="col-md-2" data-nur-ziel="file">
                <select class="form-select form-select-sm" data-feld="parser">
                  <% EINSTELLUNG.parser.forEach(function (x) { %><option value="<%= x %>"><%= x %></option><% }) %>
                </select>
              </div>
              <div class="col-md-2" data-nur-ziel="file"><input class="form-control form-control-sm font-monospace" data-feld="path" placeholder="Schlüssel, etwa max_players"></div>
              <div class="col-md-3" data-nur-ziel="env"><input class="form-control form-control-sm font-monospace" data-feld="variable" placeholder="SERVER_NAME"></div>
              <div class="col-md-5" data-nur-ziel="rcon"><input class="form-control form-control-sm font-monospace" data-feld="command" placeholder="/config set name {{value}}"></div>
              <div class="col-md-5 small text-secondary" data-nur-ziel="arg">im Startteil <code>{{setting:schlüssel}}</code> verwenden</div>
              <%# Nur Schalter → Datei: Dort übersetzt der Daemon, und jedes Spiel will es anders. Gewählt, nie still vorbelegt. %>
              <div class="col-md-2" data-nur-ziel="file">
                <div data-nur-typ-ziel="boolean">
                  <label class="form-label small mb-1">An/Aus schreiben als</label>
                  <select class="form-select form-select-sm" data-feld="as" title="Wie An/Aus in dieser Datei steht — jedes Spiel will es anders">
                    <option value="">— wählen —</option>
                    <% EINSTELLUNG.als.forEach(function (x) { %><option value="<%= x %>"><%= x === 'one_zero' ? '1 / 0' : x.replace('_', ' / ') %></option><% }) %>
                  </select>
                </div>
              </div>
              <div class="col-auto"><button class="btn btn-sm btn-outline-danger" type="button" data-ziel-weg title="Ziel entfernen"><i class="fa-solid fa-xmark"></i></button></div>
            </div>
          </template>
        </details>
      </div>
    </div>
  </div>

  <!-- ── Hinweise für Betreiber (2026-10-06) ───────────────────────────── -->
  <%
    // Was sich nicht einstellen lässt und was man trotzdem wissen muss. Fester
    // Text aus dem Paket, nie aus der Spielausgabe abgeleitet.
    const WANN = { create: 'beim Anlegen', install: 'während der Installation', run: 'auf der Serverseite' };
  %>
  <div class="col-12">
    <div class="card" id="karteHinweise">
      <div class="card-header">
        <h3 class="card-title">Hinweise für Betreiber</h3>
        <div class="card-actions"><span class="text-secondary small"><%= hinweise.length %> im Entwurf</span></div>
      </div>
      <div class="card-body">
        <p class="text-secondary small">
          Was jemand wissen muss, der einen Server dieses Spiels betreibt, und was sich nicht einstellen lässt — etwa
          „beim ersten Start neue Welt, danach auf Laden umstellen" oder „beitreten nur über die IP".
          Der <strong>Zeitpunkt</strong> entscheidet, wo der Text steht: im Anlegen-Assistenten, auf der Serverseite während der
          Installation oder auf der Serverseite danach. Hinweise gehören nicht zum Geprüften — du kannst sie nach einem grünen
          Durchlauf ändern, ohne neu zu prüfen; ins Paket kommen sie beim nächsten Veröffentlichen.
        </p>

        <% if (hinweise.length) { %>
          <div class="table-responsive mb-3">
            <table class="table table-sm table-vcenter">
              <thead><tr><th>Schlüssel</th><th>Zeitpunkt</th><th>Text</th><th class="w-1"></th></tr></thead>
              <tbody>
                <% hinweise.forEach(function (h) { %>
                  <tr>
                    <td class="font-monospace"><%= h.key %></td>
                    <td class="text-nowrap"><%= WANN[h.when] || h.when %></td>
                    <td>
                      <div><%= (h.text && (h.text.de || h.text.en)) || '' %></div>
                      <% if (h.text && h.text.de && h.text.en) { %><div class="text-secondary small"><%= h.text.en %></div><% } %>
                      <% if (h.text && !h.text.en) { %><div class="text-secondary small">kein englischer Text — gezeigt wird der deutsche</div><% } %>
                    </td>
                    <td class="text-nowrap">
                      <button class="btn btn-sm btn-outline-secondary" type="button" data-hinweis-bearbeiten="<%= JSON.stringify(h) %>">Bearbeiten</button>
                      <button class="btn btn-sm btn-outline-danger" type="button" data-hinweis-entfernen="<%= h.key %>">Entfernen</button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>

        <details id="hinweisDetails" <%= hinweise.length ? '' : 'open' %>>
          <summary class="mb-2"><span id="hinweisUeberschrift">Neuer Hinweis</span></summary>
          <form id="formHinweis" class="row g-2" autocomplete="off">
            <input type="hidden" name="alt" value="">
            <div class="col-md-4">
              <label class="form-label" for="hKey">Schlüssel</label>
              <input class="form-control font-monospace" id="hKey" name="key" placeholder="erste_einrichtung" required>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="hWann">Zeitpunkt</label>
              <select class="form-select" id="hWann" name="when">
                <% HINWEIS.wann.forEach(function (w) { %><option value="<%= w %>" <%= w === 'run' ? 'selected' : '' %>><%= WANN[w] || w %></option><% }) %>
              </select>
            </div>
            <div class="col-12">
              <label class="form-label" for="hTextDe">Text (deutsch)</label>
              <textarea class="form-control" id="hTextDe" name="text_de" rows="3" maxlength="<%= HINWEIS.max %>" placeholder="Ein Absatz, in der Du-Form: was zu tun ist und warum."></textarea>
            </div>
            <div class="col-12">
              <label class="form-label" for="hTextEn">Text (englisch)</label>
              <textarea class="form-control" id="hTextEn" name="text_en" rows="3" maxlength="<%= HINWEIS.max %>"></textarea>
              <div class="form-hint">Höchstens <%= HINWEIS.max %> Zeichen je Sprache. Fehlt eine Sprache, wird die andere gezeigt.</div>
            </div>
            <div class="col-12 d-flex gap-2">
              <button class="btn btn-primary" type="submit"><i class="fa-solid fa-floppy-disk me-1"></i>Hinweis speichern</button>
              <button class="btn btn-outline-secondary" type="button" id="knopfHinweisNeu">Leeren</button>
            </div>
          </form>
        </details>
      </div>
    </div>
  </div>

  </div></div>

  <div class="col-12" data-reiter="pruefen" role="tabpanel" aria-labelledby="reiter-pruefen"><div class="row row-cards">

  <!-- ── Prüfdurchlauf (Stufe 3) ────────────────────────────────────────── -->
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Prüfdurchlauf</h3>
        <div class="card-actions" id="pruefStatus">
          <% if (!pruefung) { %><span class="text-secondary small">noch keiner</span>
          <% } else if (pruefLaeuft) { %><span class="badge bg-blue-lt">läuft</span>
          <% } else if (pruefung.status === 'gruen') { %><span class="badge bg-green">grün</span>
          <% } else { %><span class="badge bg-red">rot</span><% } %>
        </div>
      </div>
      <div class="card-body">
        <p class="text-secondary small">
          Der ganze Entwurf auf einem <strong>leeren</strong> Volume — installieren wie beim Kunden, starten, auf den Port warten,
          mit deiner Stoppfolge anhalten. Grün heißt: alles lief, bereit über den Port, und das Spiel endete, bevor sigkill nötig war.
          Das Prüf-Volume wird danach gelöscht.
        </p>
        <% if (pruefung && !pruefLaeuft && pruefHash !== entwurfHash) { %>
          <div class="alert alert-warning py-2 small">Der technische Teil (Image, Ports, Schritte, Start, Einstellungen) hat sich seit diesem Durchlauf geändert — das Urteil gilt für den alten Stand. Name, Beschreibung und Bild zählen nicht mit.</div>
        <% } %>
        <% if (durchlaufMaengel.length && !pruefLaeuft) { %>
          <div class="alert alert-info py-2 small mb-2">
            <div class="mb-1">Vor einem Durchlauf fehlt noch:</div>
            <ul class="mb-0"><% durchlaufMaengel.forEach(function (m) { %><li><%= m %></li><% }) %></ul>
          </div>
        <% } %>
        <div class="d-flex gap-2 mb-3">
          <% if (pruefLaeuft) { %>
            <button class="btn btn-outline-danger" type="button" id="knopfPruefAbbrechen"
                    title="Nur wenn er hängt — etwa nach einem Neustart von Daemon oder Dashboard. Setzt den Eintrag hier rot; der Daemon wird dadurch NICHT angehalten. Läuft der Durchlauf dort noch, endet er von selbst, und bis dahin weist er einen neuen ab.">
              Als abgebrochen markieren
            </button>
          <% } else { %>
            <button class="btn btn-primary" type="button" id="knopfPruefen" <%= (durchlaufMaengel.length || beschaeftigt) ? 'disabled' : '' %>>
              <i class="fa-solid fa-flask me-1"></i>Prüfdurchlauf starten
            </button>
          <% } %>
        </div>

        <% if (pruefung && pruefung.ergebnis) { const e = pruefung.ergebnis; %>
          <% if (e.gruende && e.gruende.length) { %>
            <ul class="text-danger small mb-2"><% e.gruende.forEach(function (g) { %><li><%= g %></li><% }) %></ul>
            <%# Der Daemon sagt nur „läuft bereits": Wer vorher „als abgebrochen markiert" hat, weiss nicht, dass DER gemeint ist (2026-10-05). %>
            <% if (e.gruende.some(function (g) { return /läuft bereits eine Installation/.test(g); })) { %>
              <div class="alert alert-info py-2 small mb-2">Auf dem Daemon lief noch ein früherer Durchlauf dieser Sitzung — etwa einer, der hier als abgebrochen markiert wurde. Er endet von selbst und räumt sein Prüf-Volume ab; danach geht ein neuer Durchlauf. Über das Paket sagt dieses Urteil nichts.</div>
            <% } %>
          <% } %>
          <div class="small text-secondary mb-2">
            Installation <%= e.installation || '—' %><%= e.install_sek ? ' (' + e.install_sek + ' s)' : '' %>
            · bereit <%= e.bereitschaft ? 'über ' + e.bereitschaft + ' nach ' + e.bereit_nach_sek + ' s' : 'nie' %>
            · Ende Code <%= e.exit_code !== undefined ? e.exit_code : '—' %><%= e.stopp_sek !== undefined && e.bereitschaft ? ', Stopp ' + e.stopp_sek + ' s' : '' %>
            <% if (e.rcon) { %>· Fernsteuerung <%= e.rcon.angemeldet ? 'angemeldet nach ' + e.rcon.nach_sek + ' s' : 'nicht erreicht' %><% } %>
          </div>
        <% } %>
        <details <%= pruefLaeuft ? 'open' : '' %>>
          <summary class="text-secondary small">Protokoll</summary>
          <pre id="pruefProtokoll" class="mt-2 mb-0 p-2 small" style="max-height:24rem;overflow:auto;background:var(--tblr-bg-surface-secondary);color:var(--tblr-body-color)"><%= lesbar(pruefung && pruefung.protokoll) %></pre>
        </details>
      </div>
    </div>
  </div>

  <!-- ── Veröffentlichen (Stufe 4) ──────────────────────────────────────── -->
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Angaben &amp; Veröffentlichen</h3>
        <div class="card-actions">
          <% if (veroeffentlichung.darf) { %><span class="badge bg-green-lt">bereit für test</span>
          <% } else { %><span class="badge bg-secondary-lt">noch nicht</span><% } %>
        </div>
      </div>
      <div class="card-body">
        <form id="formAngaben" class="row g-3">
          <div class="col-md-4">
            <label class="form-label" for="aSlug">Slug</label>
            <input class="form-control font-monospace" id="aSlug" name="slug" value="<%= angaben.slug %>" placeholder="factorio">
            <div class="form-hint">Gibt es ihn schon, wird es eine neue Fassung dieses Pakets<%= veroeffentlichung.neueste ? ' (bisher bis ' + veroeffentlichung.neueste + ')' : '' %>.</div>
          </div>
          <div class="col-md-5">
            <label class="form-label" for="aName">Name</label>
            <input class="form-control" id="aName" name="name" value="<%= angaben.name %>">
          </div>
          <div class="col-md-3">
            <label class="form-label" for="aVersion">Fassung</label>
            <input class="form-control font-monospace" id="aVersion" name="version" value="<%= angaben.version %>" placeholder="1.0.0">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="aDe">Beschreibung (deutsch)</label>
            <textarea class="form-control" id="aDe" name="beschreibung_de" rows="2"><%= angaben.beschreibung_de %></textarea>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="aEn">Beschreibung (englisch)</label>
            <textarea class="form-control" id="aEn" name="beschreibung_en" rows="2"><%= angaben.beschreibung_en %></textarea>
          </div>
          <%# Tags statt Kategorie (Betreiber, 2026-10-08): Ein Spiel gehört in
              mehrere Gruppen, und die feste Liste zwang jedes in eine — fünf von
              acht standen auf „sandbox". Die Tags gehören dem Spiel im Panel und
              gehen beim Veröffentlichen dorthin, wie Symbol und Banner. %>
          <div class="col-md-4">
            <div class="form-label"><label for="aTags">Tags</label><%- include('werkbank-hilfe', { text:
              'Woran man das Spiel findet und was es mit anderen gemeinsam hat — etwa Survival, CO-OP, SCI-FI. Vorhandene Tags werden beim Tippen vorgeschlagen. Sie gehen beim Veröffentlichen an das Spiel im Panel, nicht ins Paket.' }) %></div>
            <%- include('shared/tagfeld', { id: 'aTags', tags: locals.angabenTags || [], alle: locals.alleTags || [], fehler: locals.tagsFehler || null, hinweis: '' }) %>
          </div>
          <div class="col-md-4">
            <label class="form-label" for="aIcon">Symbol</label>
            <div class="d-flex align-items-center gap-2">
              <div data-medienwahl-vorschau="aIcon" style="width:48px;height:48px;border:1px dashed var(--tblr-border-color);border-radius:6px;display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0"></div>
              <div class="input-group">
                <input class="form-control" id="aIcon" name="icon_url" value="<%= angaben.icon_url %>" placeholder="aus den Medien oder https://…">
                <button class="btn btn-outline-secondary" type="button" data-medienwahl="aIcon" title="Aus den Medien wählen"><i class="fa-solid fa-photo-film"></i></button>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <label class="form-label" for="aBanner">Banner</label>
            <div class="input-group">
              <input class="form-control" id="aBanner" name="banner_url" value="<%= angaben.banner_url %>" placeholder="aus den Medien oder https://…">
              <button class="btn btn-outline-secondary" type="button" data-medienwahl="aBanner" title="Aus den Medien wählen"><i class="fa-solid fa-photo-film"></i></button>
            </div>
            <div data-medienwahl-vorschau="aBanner" class="mt-2" style="height:64px;border:1px dashed var(--tblr-border-color);border-radius:6px;display:flex;align-items:center;justify-content:center;overflow:hidden"></div>
          </div>
          <div class="col-12 d-flex flex-wrap gap-2 align-items-center">
            <button class="btn btn-outline-secondary" type="submit"><i class="fa-solid fa-floppy-disk me-1"></i>Angaben speichern</button>
            <button class="btn btn-success" type="button" id="knopfVeroeffentlichen" <%= veroeffentlichung.darf ? '' : 'disabled' %>>
              <i class="fa-solid fa-cloud-arrow-up me-1"></i>In test veröffentlichen
            </button>
            <span class="text-secondary small">Angaben und Bild ändern nichts am Prüfurteil.</span>
          </div>
        </form>
        <% if (!veroeffentlichung.darf) { %>
          <ul class="text-secondary small mt-3 mb-0"><% veroeffentlichung.gruende.forEach(function (g) { %><li><%= g %></li><% }) %></ul>
        <% } %>
        <% if (veroeffentlicht.length) { %>
          <div class="mt-3 small">
            <div class="text-secondary mb-1">Aus dieser Sitzung veröffentlicht:</div>
            <ul class="mb-0">
              <% veroeffentlicht.slice().reverse().forEach(function (v) { %>
                <li><span class="font-monospace"><%= v.slug %> <%= v.version %></span> · Kanal test · <%= new Date(v.am).toLocaleString('de-DE') %> · Durchlauf #<%= v.pruef_id %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- ── Unverändert übernommen (Durchreichen, 2026-10-07) ─────────────── -->
  <%
    // Teile eines geöffneten Pakets, für die die Werkbank noch keine Karte hat.
    // Sie reisen unverändert mit und stehen hier, damit man sieht, WAS mitreist.
    const TEIL_NAME = {
      management:   'Spielstände, Umleitungen, Aktualisieren',
      content:      'Mod-Verwaltung',
      commands:     'Befehle im Panel (Spieler listen, kicken, bannen, speichern, Durchsage)',
      files:        'Sperrliste im Dateimanager',
      config:       'feste Zeilen in Dateien',
      console:      'Konsolenfilter',
      requirements: 'Systempakete',
      install:      'Zusätze zur Installation (Zwischenspeicher, Aufräumen)'
    };
    const mitgereist = locals.durchgereicht || [];
    const offenAus = locals.geoeffnet || null;
  %>
  <% if (mitgereist.length || offenAus) { %>
  <div class="col-12">
    <div class="card" id="karteDurchgereicht">
      <div class="card-header">
        <h3 class="card-title">Unverändert übernommen</h3>
        <div class="card-actions"><span class="text-secondary small">
          <% if (offenAus) { %>geöffnet aus <span class="font-monospace"><%= offenAus.slug %> <%= offenAus.version %></span><% } %>
        </span></div>
      </div>
      <div class="card-body">
        <% if (!mitgereist.length) { %>
          <p class="text-secondary small mb-0">Dieses Paket trägt nichts, wofür der Werkbank eine Karte fehlt.</p>
        <% } else { %>
          <p class="text-secondary small">
            Diese Teile hat das geöffnete Paket, und die Werkbank kann sie noch nicht bearbeiten. Sie stehen <strong>unverändert</strong>
            im Entwurf, laufen im Prüfdurchlauf mit und kommen beim Veröffentlichen wieder ins Paket — im Paket steht dann dazu, dass sie
            nicht einzeln geprüft sind. Ändern lassen sie sich hier erst, wenn ihr Teil eine Karte bekommt.
          </p>
          <% mitgereist.forEach(function (t) { %>
            <details class="mb-2">
              <summary><span class="font-monospace"><%= t.teil %></span> <span class="text-secondary">— <%= TEIL_NAME[t.teil] || 'ohne Beschreibung' %></span></summary>
              <pre class="mt-2 mb-0 p-2 small" style="max-height:20rem;overflow:auto;background:var(--tblr-bg-surface-secondary);color:var(--tblr-body-color)"><%= JSON.stringify(t.inhalt, null, 2) %></pre>
            </details>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>
  <% } %>

  </div></div>
</div>

<%- include('shared/medienwahl', { guildId }) %>

<script>
(function () {
  var wurzel = document.getElementById('werkbankSitzung');
  if (!wurzel) return;
  var hier = wurzel.dataset.werkbankHier;
  var basis = wurzel.dataset.werkbankBasis;
  var kennung = wurzel.dataset.werkbankSitzung;

  function melde(art, text) { if (window.showToast) window.showToast(art, text); }
  // Dieselbe Regel wie `lesbar` oben im Server-Teil — für die Live-Zeilen.
  function lesbar(t) { return String(t == null ? '' : t).replace(/\x1b\[[0-?]*[ -\/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b[@-Z\\-_]/g, ''); }

  async function schicke(pfad, nutzlast) {
    var antwort = await fetch(pfad, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(nutzlast || {})
    });
    var daten = {};
    try { daten = await antwort.json(); } catch (e) { /* kein JSON */ }
    if (!antwort.ok || !daten.success) throw new Error(daten.message || ('HTTP ' + antwort.status));
    return daten;
  }

  // ── Felder je Typ ──────────────────────────────────────────────────────
  var typ = document.getElementById('schrittTyp');
  function zeigeTyp() {
    document.querySelectorAll('#formSchritt fieldset[data-typ]').forEach(function (f) {
      f.hidden = f.dataset.typ !== typ.value;
    });
  }
  if (typ) { typ.addEventListener('change', zeigeTyp); zeigeTyp(); }

  // ── Schritt ausführen ─────────────────────────────────────────────────
  var form = document.getElementById('formSchritt');
  if (form) {
    form.addEventListener('submit', async function (ev) {
      ev.preventDefault();
      var knopf = form.querySelector('button[type=submit]');
      knopf.disabled = true;
      // Nur die Felder des gewählten Typs — die versteckten gehören nicht dazu.
      var nutzlast = { type: typ.value, beschreibung: form.beschreibung.value };
      var feld = form.querySelector('fieldset[data-typ="' + typ.value + '"]');
      feld.querySelectorAll('input, textarea, select').forEach(function (e) {
        nutzlast[e.name] = e.type === 'checkbox' ? e.checked : e.value;
      });
      try {
        var daten = await schicke(hier + '/schritte', nutzlast);
        if (daten.angenommen) { window.location.reload(); return; }
        melde('error', 'Der Daemon hat den Schritt abgewiesen: ' + (daten.fehler || ''));
        window.location.reload();
      } catch (fehler) {
        knopf.disabled = false;
        melde('error', 'Schritt nicht ausgeführt: ' + fehler.message);
      }
    });
  }

  // ── Übernommene Schritte ausführen ────────────────────────────────────
  // Startet den ersten, der noch nicht gelaufen ist; die übrigen folgen von
  // selbst, jeder nach dem Ende seines Vorgängers.
  var knopfUebernommene = document.getElementById('knopfUebernommene');
  if (knopfUebernommene) {
    knopfUebernommene.addEventListener('click', async function () {
      knopfUebernommene.disabled = true;
      try {
        var daten = await schicke(hier + '/schritte/uebernommene');
        if (!daten.angenommen) melde('error', 'Der Daemon hat den Schritt abgewiesen: ' + (daten.fehler || ''));
        window.location.reload();
      } catch (fehler) {
        knopfUebernommene.disabled = false;
        melde('error', 'Nicht gestartet: ' + fehler.message);
      }
    });
  }

  // ── Aus dem Entwurf nehmen ────────────────────────────────────────────
  document.querySelectorAll('[data-herausnehmen]').forEach(function (k) {
    k.addEventListener('click', async function () {
      k.disabled = true;
      try {
        await schicke(hier + '/schritte/' + k.dataset.herausnehmen + '/herausnehmen');
        window.location.reload();
      } catch (fehler) {
        k.disabled = false;
        melde('error', fehler.message);
      }
    });
  });

  // ── Verwerfen ─────────────────────────────────────────────────────────
  var verwerfen = document.getElementById('knopfVerwerfen');
  if (verwerfen) {
    verwerfen.addEventListener('click', async function () {
      if (!confirm('Sitzung verwerfen? Das Volume auf der Maschine wird gelöscht, der Entwurf ist weg.')) return;
      verwerfen.disabled = true;
      try {
        await schicke(hier + '/verwerfen');
        window.location.href = basis;
      } catch (fehler) {
        verwerfen.disabled = false;
        melde('error', 'Nicht verworfen: ' + fehler.message);
      }
    });
  }

  // ── Probestart ────────────────────────────────────────────────────────
  var formStart = document.getElementById('formStart');

  // ── Startzeilen-Baukasten (S1, 2026-09-30) ────────────────────────────
  // Je Zeile Form · Quelle · Bedingung. Übersetzt ins Paket wird auf dem
  // Server (helpers/Startzeile.js), die Vorschau rechnet der Daemon — hier
  // wird nur gezeichnet und eingesammelt.
  var baukasten = document.getElementById('startBaukasten');
  var zeilenKasten = document.getElementById('startZeilen');
  var QUELLEN = baukasten ? JSON.parse(baukasten.dataset.quellen || '[]') : [];
  var BEDINGUNGEN = [
    ['', 'immer'], ['true', 'wenn an'], ['false', 'wenn aus'],
    ['not_empty', 'wenn gesetzt'], ['empty', 'wenn leer'], ['=', 'gleich …'], ['!=', 'ungleich …'],
  ];
  function option(wert, text, gewaehlt) {
    var o = document.createElement('option');
    o.value = wert; o.textContent = text; o.selected = gewaehlt;
    return o;
  }
  function zeileZeichnen(z) {
    z = z || { form: '', quelle: 'fest', bedingung: '' };
    var zeile = document.createElement('div');
    zeile.className = 'border rounded p-2 mb-2';
    if (z.key) zeile.dataset.key = z.key;
    if (z.roh) {
      // Unveränderlich übernommen — wird genau so wieder abgelegt.
      zeile.dataset.roh = z.roh;
      var code = document.createElement('code');
      code.className = 'small'; code.textContent = z.roh;
      var hinweis = document.createElement('div');
      hinweis.className = 'small text-secondary';
      hinweis.textContent = 'Übernommen, hier nicht bearbeitbar (Form, die der Baukasten nicht ausdrücken kann).';
      zeile.append(code, hinweis);
    } else {
      var form = document.createElement('input');
      form.className = 'form-control form-control-sm font-monospace mb-1';
      form.placeholder = '-port {{Wert}}'; form.value = z.form || ''; form.dataset.teil = 'form';
      var reihe = document.createElement('div');
      reihe.className = 'd-flex gap-1 flex-wrap';
      var quelle = document.createElement('select');
      quelle.className = 'form-select form-select-sm w-auto'; quelle.dataset.teil = 'quelle';
      var bekannt = QUELLEN.some(function (q) { return q.wert === z.quelle; });
      QUELLEN.forEach(function (q) { quelle.append(option(q.wert, q.text, q.wert === z.quelle)); });
      if (!bekannt && z.quelle) quelle.append(option(z.quelle, z.quelle + ' (nicht im Entwurf)', true));
      var art = /^!?=/.test(z.bedingung || '') ? z.bedingung.replace(/^(!?=).*$/, '$1') : (z.bedingung || '');
      var bedingung = document.createElement('select');
      bedingung.className = 'form-select form-select-sm w-auto'; bedingung.dataset.teil = 'bedingung';
      BEDINGUNGEN.forEach(function (b) { bedingung.append(option(b[0], b[1], b[0] === art)); });
      var vergleich = document.createElement('input');
      vergleich.className = 'form-control form-control-sm w-auto font-monospace'; vergleich.dataset.teil = 'vergleich';
      vergleich.placeholder = 'forge,neoforge';
      vergleich.value = /^!?=/.test(z.bedingung || '') ? z.bedingung.replace(/^!?=/, '') : '';
      vergleich.hidden = !/^!?=$/.test(art);
      bedingung.addEventListener('change', function () { vergleich.hidden = !/^!?=$/.test(bedingung.value); });
      reihe.append(quelle, bedingung, vergleich);
      zeile.append(form, reihe);
    }
    var knoepfe = document.createElement('div');
    knoepfe.className = 'd-flex gap-1 mt-1';
    [['↑', 'hoch'], ['↓', 'runter'], ['✕', 'weg']].forEach(function (k) {
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'btn btn-sm btn-ghost-secondary px-2'; b.textContent = k[0]; b.dataset.aktion = k[1];
      knoepfe.append(b);
    });
    zeile.append(knoepfe);
    zeilenKasten.append(zeile);
  }
  function zeilenEinsammeln() {
    return Array.prototype.map.call(zeilenKasten.children, function (zeile) {
      if (zeile.dataset.roh) return { roh: zeile.dataset.roh };
      var teil = function (n) { return zeile.querySelector('[data-teil="' + n + '"]'); };
      var b = teil('bedingung').value;
      return {
        key: zeile.dataset.key || undefined,
        form: teil('form').value,
        quelle: teil('quelle').value,
        bedingung: /^!?=$/.test(b) ? b + teil('vergleich').value.trim() : b,
      };
    });
  }
  var vorschauUhr = null, vorschauNr = 0;
  function zeigeArg(a) { return a === '' || /\s/.test(a) ? '"' + a + '"' : a; }
  async function vorschau() {
    var nr = ++vorschauNr;
    var ausgabe = document.getElementById('startVorschau');
    var fehlend = document.getElementById('startFehlend');
    try {
      var r = await schicke(hier + '/startzeile', { program: formStart.program.value, zeilen: zeilenEinsammeln() });
      if (nr !== vorschauNr) return; // eine neuere Anfrage ist unterwegs
      ausgabe.textContent = [r.programm || '(kein Programm)'].concat((r.argumente || []).map(zeigeArg)).join(' ');
      fehlend.hidden = !(r.fehlend || []).length;
      fehlend.textContent = (r.fehlend || []).length ? 'Entfällt beim Start: ' + r.fehlend.join(' · ') : '';
    } catch (fehler) {
      if (nr !== vorschauNr) return;
      ausgabe.textContent = '— ' + fehler.message;
      fehlend.hidden = true;
    }
  }
  function vorschauBald() { clearTimeout(vorschauUhr); vorschauUhr = setTimeout(vorschau, 400); }
  if (baukasten) {
    JSON.parse(baukasten.dataset.zeilen || '[]').forEach(zeileZeichnen);
    document.getElementById('knopfZeileNeu').addEventListener('click', function () {
      zeileZeichnen(); zeilenKasten.lastElementChild.querySelector('input').focus();
    });
    zeilenKasten.addEventListener('click', function (ev) {
      var knopf = ev.target.closest('button[data-aktion]');
      if (!knopf) return;
      var zeile = knopf.closest('#startZeilen > div');
      if (knopf.dataset.aktion === 'weg') zeile.remove();
      if (knopf.dataset.aktion === 'hoch' && zeile.previousElementSibling) zeile.parentNode.insertBefore(zeile, zeile.previousElementSibling);
      if (knopf.dataset.aktion === 'runter' && zeile.nextElementSibling) zeile.parentNode.insertBefore(zeile.nextElementSibling, zeile);
      vorschauBald();
    });
    zeilenKasten.addEventListener('input', vorschauBald);
    zeilenKasten.addEventListener('change', vorschauBald);
    formStart.program.addEventListener('input', vorschauBald);
    vorschau();
  }

  function startNutzlast() {
    var n = {};
    // Nur benannte Felder: Die Baukasten-Zeilen haben keinen Namen, sie kommen
    // gesammelt als `zeilen`.
    formStart.querySelectorAll('input[name], textarea[name], select[name]').forEach(function (e) { n[e.name] = e.value; });
    n.zeilen = baukasten ? zeilenEinsammeln() : [];
    return n;
  }
  if (formStart) {
    document.getElementById('knopfStartSpeichern').addEventListener('click', async function () {
      try { await schicke(hier + '/start', startNutzlast()); window.location.reload(); }
      catch (fehler) { melde('error', fehler.message); }
    });
    formStart.addEventListener('submit', async function (ev) {
      ev.preventDefault();
      var knopf = formStart.querySelector('button[type=submit]');
      knopf.disabled = true;
      try { await schicke(hier + '/starten', startNutzlast()); window.location.reload(); }
      catch (fehler) { knopf.disabled = false; melde('error', fehler.message); }
    });
  }
  var knopfStoppen = document.getElementById('knopfStoppen');
  if (knopfStoppen) {
    knopfStoppen.addEventListener('click', async function () {
      knopfStoppen.disabled = true;
      try { await schicke(hier + '/stoppen'); knopfStoppen.textContent = 'Stoppt …'; }
      catch (fehler) { knopfStoppen.disabled = false; melde('error', fehler.message); }
    });
  }
  var formEingabe = document.getElementById('formEingabe');
  formEingabe.addEventListener('submit', async function (ev) {
    ev.preventDefault();
    var feld = formEingabe.zeile;
    try { await schicke(hier + '/eingabe', { zeile: feld.value }); feld.value = ''; }
    catch (fehler) { melde('error', fehler.message); }
  });

  // Ports übernehmen / entfernen — Formulare entstehen auch per SSE neu,
  // deshalb am Container horchen.
  // ── Ports im Probestart: ein Bild, eine Zeichnung (2026-10-08) ─────────
  // Das Bild rechnet der Server (Sitzungen.portBild); gezeichnet wird es hier —
  // beim Aufbau, bei jeder Meldung des Daemons und nach Übernehmen/Entfernen.
  var portRahmen = document.getElementById('laufPortBild');
  var portsKasten = document.getElementById('laufPorts');
  var portsEntwurf = document.getElementById('laufPortsEntwurf');
  var portsTitel = document.getElementById('laufPortsTitel');
  var portBild = { laeuft: false, stand: 'leer', beobachtet: [], entwurf: [], ungenutzt: [] };
  try { portBild = JSON.parse(portRahmen.dataset.bild || '{}'); } catch (e) { /* leer */ }

  function el(art, klasse, text) {
    var e = document.createElement(art);
    if (klasse) e.className = klasse;
    if (text !== undefined) e.textContent = text;   // nie innerHTML: Konsolenzeilen kommen vom Spiel
    return e;
  }
  function protText(p) { return p === 'both' ? 'tcp+udp' : p; }

  function zeichnePortBild(bild) {
    portBild = bild || portBild;
    var b = portBild;
    portsTitel.textContent = b.stand === 'gesehen' ? 'Beim letzten Start gesehen' : 'Beobachtet (lauscht im Container)';
    portsKasten.textContent = '';
    if (!(b.beobachtet || []).length) {
      portsKasten.appendChild(el('span', 'text-secondary small', b.laeuft
        ? 'Gerade lauscht nichts.'
        : 'Noch keiner. Öffnet das Spiel einen Port, erscheint er hier mit Nummer — dann Zweck eintragen (game, query, rcon …) und übernehmen.'));
    }
    (b.beobachtet || []).forEach(function (p) {
      var block = el('div', 'mb-2');
      var marke = el('span', 'badge font-monospace flex-shrink-0 align-self-center ' + (p.zweck ? 'bg-green-lt' : (p.zufall ? 'bg-secondary-lt' : 'bg-azure-lt')), p.port + '/' + protText(p.protocol));
      if (p.zweck) {
        var zeile = el('div', 'd-flex flex-wrap gap-2 align-items-center');
        zeile.appendChild(marke);
        zeile.appendChild(el('span', 'text-secondary small', 'im Entwurf als ' + p.zweck));
        if ((p.fehlt || []).length) {
          // Lauscht auf einem Protokoll, das der Entwurf für diesen Port noch nicht nennt.
          zeile.appendChild(el('span', 'text-warning small', 'lauscht auch auf ' + p.fehlt.join(' und ')));
          var dazu = el('button', 'btn btn-sm btn-outline-primary', p.fehlt[0] + ' dazunehmen');
          dazu.type = 'button';
          dazu.dataset.portDazu = p.zweck; dazu.dataset.port = p.port; dazu.dataset.protocol = p.fehlt[0];
          zeile.appendChild(dazu);
        }
        block.appendChild(zeile);
      } else {
        var f = el('form', 'd-flex flex-wrap gap-1');
        f.setAttribute('data-port-uebernehmen', '');
        f.dataset.port = p.port; f.dataset.protocol = p.protocol;
        var eingabe = el('input', 'form-control form-control-sm font-monospace');
        eingabe.name = 'zweck'; eingabe.placeholder = 'Zweck (game)'; eingabe.style.maxWidth = '9rem'; eingabe.style.minWidth = '0';
        eingabe.setAttribute('aria-label', 'Zweck für Port ' + p.port);
        f.append(marke, eingabe);
        if (p.vorschlag) {
          // Wenige Nummern über einem Port des Entwurfs: vermutlich an ihn gekoppelt.
          var wahl = el('select', 'form-select form-select-sm');
          wahl.name = 'vergabe'; wahl.style.maxWidth = '12rem';
          wahl.title = 'Fest über einem anderen Port heißt: Das Spiel leitet die Nummer selbst ab — der Server bekommt dann zusammenhängende Nummern.';
          wahl.add(new Option('fest: ' + p.vorschlag.basis + ' + ' + p.vorschlag.abstand, p.vorschlag.basis + '|' + p.vorschlag.abstand, true, true));
