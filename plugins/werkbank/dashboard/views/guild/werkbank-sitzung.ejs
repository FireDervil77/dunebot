    }
    formB.via.addEventListener('change', zeigeWeg);
    document.getElementById('knopfBefehlNeu').addEventListener('click', befehlLeeren);
    befehlLeeren();
    document.querySelectorAll('[data-befehl-bearbeiten]').forEach(function (k) {
      k.addEventListener('click', function () {
