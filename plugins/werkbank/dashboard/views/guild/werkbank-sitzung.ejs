  var formB = document.getElementById('formBefehl');
  if (formB) {
    var befehlTitel = document.getElementById('befehlUeberschrift');
    // Je Weg nur seine Felder — und nur die gehen mit (siehe Absenden).
    function zeigeWeg() {
      formB.querySelectorAll('[data-weg]').forEach(function (f) {
        f.hidden = f.dataset.weg.split(' ').indexOf(formB.via.value) < 0;
      });
    }
    function befehlLeeren() {
      formB.reset();
      formB.key.readOnly = false;
      // Der erste Weg, der wählbar ist — „Fernsteuerung" ist ohne RCON gesperrt.
      var frei = Array.prototype.find.call(formB.via.options, function (o) { return !o.disabled; });
      if (frei) formB.via.value = frei.value;
      befehlTitel.textContent = 'Befehl anlegen';
