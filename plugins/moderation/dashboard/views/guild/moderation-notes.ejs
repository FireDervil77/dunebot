<%- include('partials/moderation-kopf', {
  guildId, tr,
  icon: 'fa-solid fa-note-sticky',
  titel: tr('moderation:NAV.NOTES'),
  beschreibung: tr('moderation:NOTES.DESC')
}) %>

<% const zeitpunkt = (w) => w ? new Date(w).toLocaleString('de-DE') : '—'; %>

<div class="row row-cards">
  <!-- Neue Notiz -->
  <div class="col-lg-4">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fa-solid fa-plus me-2"></i>
          <%= tr('moderation:NOTES.ADD_TITLE') %>
        </h3>
      </div>
      <div class="card-body">
        <div class="mb-3">
          <label for="noteUserId" class="form-label"><%= tr('moderation:NOTES.USER_ID') %></label>
          <input type="text" id="noteUserId" class="form-control font-monospace"
                 placeholder="<%= tr('moderation:NOTES.USER_ID_PLACEHOLDER') %>"
                 pattern="[0-9]+" maxlength="20">
        </div>
        <div class="mb-3">
          <label for="noteText" class="form-label"><%= tr('moderation:NOTES.NOTE_TEXT') %></label>
          <textarea id="noteText" class="form-control" rows="3" maxlength="1000"
                    placeholder="<%= tr('moderation:NOTES.NOTE_PLACEHOLDER') %>"></textarea>
        </div>
        <button type="button" class="btn btn-success w-100" onclick="addNote()">
          <i class="fa-solid fa-plus me-2"></i><%= tr('moderation:NOTES.BTN_ADD') %>
        </button>
      </div>
    </div>
  </div>

  <!-- Vorhandene Notizen -->
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <%= tr('moderation:NOTES.LIST_TITLE') %>
          <span class="badge bg-secondary-lt ms-2"><%= (notizen || []).length %></span>
        </h3>
        <div class="card-actions">
          <div class="input-group input-group-sm">
            <input type="text" id="noteSearchUserId" class="form-control font-monospace"
                   placeholder="<%= tr('moderation:NOTES.SEARCH_PLACEHOLDER') %>"
                   pattern="[0-9]+" maxlength="20" oninput="filterNotes()">
            <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
          </div>
        </div>
      </div>

      <% if (notizen && notizen.length > 0) { %>
        <div class="table-responsive">
          <table class="table card-table table-vcenter">
            <thead>
              <tr>
                <th><%= tr('moderation:NOTES.USER_ID') %></th>
                <th><%= tr('moderation:NOTES.NOTE_TEXT') %></th>
                <th><%= tr('moderation:NOTES.AUTHOR') %></th>
                <th class="text-end"><%= tr('moderation:LOGS.COL_DATE') %></th>
                <th style="width: 3rem;"></th>
              </tr>
            </thead>
            <tbody>
              <% notizen.forEach(notiz => { %>
                <tr id="note-<%= notiz.id %>" data-note-user="<%= notiz.user_id %>">
                  <td class="font-monospace text-secondary"><%= notiz.user_id %></td>
                  <td><%= notiz.note %></td>
                  <td class="font-monospace text-secondary small"><%= notiz.author_id || '—' %></td>
                  <td class="text-end text-secondary"><%= zeitpunkt(notiz.created_at) %></td>
                  <td class="text-end">
                    <button type="button" class="btn btn-sm btn-outline-danger"
                            onclick="deleteNote(<%= notiz.id %>)"
                            title="<%= tr('moderation:NOTES.BTN_DELETE') %>">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="card-body">
          <div class="empty">
            <div class="empty-icon"><i class="fa-solid fa-note-sticky fs-1 text-secondary"></i></div>
            <p class="empty-title"><%= tr('moderation:NOTES.EMPTY') %></p>
            <p class="empty-subtitle text-secondary"><%= tr('moderation:NOTES.HINT') %></p>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>
