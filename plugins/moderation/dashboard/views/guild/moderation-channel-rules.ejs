<%
  //
  // Seit dem 2026-08-09 stehen hier nicht mehr nur Textkanaele. Kanalregeln
  // sind eine Auswahl - sie gelten fuer alles, worin Nachrichten entstehen,
  // also auch fuer den Chat eines Sprachkanals. Eine Raute vor einem
  // Sprachkanal waere irrefuehrend, deshalb bekommt jeder Typ sein Symbol.
  //
  const kanalSymbol = {
    text:         'fa-hashtag',
    voice:        'fa-volume-high',
    announcement: 'fa-bullhorn',
    stage:        'fa-microphone',
    forum:        'fa-comments',
    media:        'fa-image'
  };
  const symbol  = (k) => kanalSymbol[k && k.typeName] || 'fa-hashtag';
  const zeichen = (k) => ({ text: '#', voice: '\u{1F50A}', announcement: '\u{1F4E2}', stage: '\u{1F3A4}', forum: '\u{1F4AC}', media: '\u{1F5BC}' })[k.typeName] || '#';
%>
<%- include('partials/moderation-kopf', {
  guildId, tr,
  icon: 'fa-solid fa-hashtag',
  titel: tr('moderation:NAV.CHANNEL_RULES'),
  beschreibung: tr('moderation:CHANNEL_RULES.DESC')
}) %>

<div class="row row-cards">
  <!-- Neue Regel -->
  <div class="col-lg-4">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fa-solid fa-plus me-2"></i>
          <%= tr('moderation:CHANNEL_RULES.ADD_TITLE') %>
        </h3>
      </div>
      <div class="card-body">
        <div class="mb-3">
          <label for="crChannelSelect" class="form-label"><%= tr('moderation:CHANNEL_RULES.CHANNEL') %></label>
          <select id="crChannelSelect" class="form-select">
            <option value=""><%= tr('moderation:CHANNEL_SELECT') %></option>
            <% (channels || []).forEach(kanal => { %>
              <option value="<%= kanal.id %>"><%= zeichen(kanal) %> <%= kanal.name %></option>
            <% }); %>
          </select>
        </div>

        <div class="row">
          <div class="col-6 mb-3">
            <label for="crWarnLimit" class="form-label"><%= tr('moderation:CHANNEL_RULES.WARN_LIMIT') %></label>
            <input type="number" id="crWarnLimit" class="form-control" min="0" max="100" placeholder="—">
          </div>
          <div class="col-6 mb-3">
            <label for="crWarnAction" class="form-label"><%= tr('moderation:CHANNEL_RULES.WARN_ACTION') %></label>
            <select id="crWarnAction" class="form-select">
              <option value="">—</option>
              <% ['TIMEOUT', 'KICK', 'BAN'].forEach(a => { %>
                <option value="<%= a %>"><%= a %></option>
              <% }); %>
            </select>
          </div>
        </div>

        <%#
          Hier stand bis zum 2026-08-09 ein Schalter "AutoMod: ausgenommen".
          Er hat nie gewirkt: kein Bot-Prozess hat `moderation_channel_rules`
          je gelesen. Wer die Ausnahme hier setzte, bekam nichts - ohne jede
          Rueckmeldung.

          Kanalausnahmen stehen jetzt an genau einer Stelle, auf der
          Ausnahmeseite von AutoMod. Vorhandene Eintraege sind dorthin
          uebernommen worden und wirken damit zum ersten Mal.
        %>
        <div class="alert alert-info" role="alert">
          <i class="fa-solid fa-circle-info me-2"></i>
          <%= tr('moderation:CHANNEL_RULES.AUTOMOD_HINT') %>
        </div>

        <div class="mb-3">
          <label for="crNotes" class="form-label"><%= tr('moderation:CHANNEL_RULES.NOTES') %></label>
          <input type="text" id="crNotes" class="form-control" maxlength="500"
                 placeholder="<%= tr('moderation:CHANNEL_RULES.NOTES_PLACEHOLDER') %>">
        </div>

        <button type="button" class="btn btn-success w-100" onclick="addChannelRule()">
          <i class="fa-solid fa-plus me-2"></i><%= tr('moderation:CHANNEL_RULES.BTN_ADD') %>
        </button>
      </div>
    </div>
  </div>

  <!-- Vorhandene Regeln -->
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <%= tr('moderation:CHANNEL_RULES.LIST_TITLE') %>
          <span class="badge bg-secondary-lt ms-2"><%= (kanalregeln || []).length %></span>
        </h3>
      </div>

      <% if (kanalregeln && kanalregeln.length > 0) { %>
        <div class="list-group list-group-flush" id="channelRulesList">
          <% kanalregeln.forEach(regel => {
               const kanal = (channels || []).find(c => String(c.id) === String(regel.channel_id));
          %>
            <div class="list-group-item" id="channel-rule-<%= regel.id %>">
              <div class="d-flex align-items-start justify-content-between">
                <div class="flex-grow-1">
                  <div class="mb-1">
                    <strong><i class="fa-solid <%= symbol(kanal) %> me-1 text-secondary"></i><%= kanal ? kanal.name : regel.channel_id %></strong>
                    <% if (regel.max_warn_limit !== null && regel.max_warn_limit !== undefined) { %>
                      <span class="badge bg-orange-lt ms-2">
                        <%= tr('moderation:CHANNEL_RULES.BADGE_LIMIT', {
                              limit: regel.max_warn_limit,
                              aktion: regel.max_warn_action || tr('moderation:CHANNEL_RULES.DEFAULT_ACTION')
                            }) %>
                      </span>
                    <% } %>
                  </div>
                  <% if (regel.notes) { %>
                    <div class="text-secondary small"><%= regel.notes %></div>
                  <% } %>
                </div>
                <button type="button" class="btn btn-sm btn-outline-danger ms-2"
                        onclick="removeChannelRule(<%= regel.id %>)"
                        title="<%= tr('moderation:CHANNEL_RULES.BTN_DELETE') %>">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="card-body">
          <div class="empty">
            <div class="empty-icon"><i class="fa-solid fa-hashtag fs-1 text-secondary"></i></div>
            <p class="empty-title"><%= tr('moderation:CHANNEL_RULES.EMPTY') %></p>
            <p class="empty-subtitle text-secondary"><%= tr('moderation:CHANNEL_RULES.EMPTY_HINT') %></p>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>
