<%- include('partials/moderation-kopf', {
  guildId, tr,
  icon: 'fa-solid fa-user-shield',
  titel: tr('moderation:NAV.PROTECTED'),
  beschreibung: tr('moderation:PROTECTED.DESC')
}) %>

<%
  const zeitpunkt = (w) => w ? new Date(w).toLocaleDateString('de-DE') : '—';
  const geschuetzteIds = (geschuetzteRollen || []).map(g => String(g.role_id));
  const waehlbar = (roles || []).filter(r => !geschuetzteIds.includes(String(r.id)));
%>

<div class="row row-cards">
  <!-- Rolle aufnehmen -->
  <div class="col-lg-4">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <i class="fa-solid fa-plus me-2"></i>
          <%= tr('moderation:PROTECTED.ADD_TITLE') %>
        </h3>
      </div>
      <div class="card-body">
        <div class="mb-3">
          <label for="protectedRoleSelect" class="form-label"><%= tr('moderation:PROTECTED.SELECT_ROLE') %></label>
          <select id="protectedRoleSelect" class="form-select">
            <option value=""><%= tr('moderation:PROTECTED.SELECT_ROLE') %></option>
            <% waehlbar.forEach(rolle => { %>
              <option value="<%= rolle.id %>"><%= rolle.name %></option>
            <% }); %>
          </select>
          <% if (waehlbar.length === 0 && (roles || []).length > 0) { %>
            <div class="form-hint"><%= tr('moderation:PROTECTED.ALL_ADDED') %></div>
          <% } %>
        </div>
        <button type="button" class="btn btn-success w-100" onclick="addProtectedRole()">
          <i class="fa-solid fa-plus me-2"></i><%= tr('moderation:PROTECTED.BTN_ADD') %>
        </button>
      </div>
      <div class="card-footer text-secondary">
        <i class="fa-solid fa-circle-info me-2"></i><%= tr('moderation:PROTECTED.HINT') %>
      </div>
    </div>
  </div>

  <!-- Geschuetzte Rollen -->
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <%= tr('moderation:PROTECTED.TITLE') %>
          <span class="badge bg-secondary-lt ms-2"><%= (geschuetzteRollen || []).length %></span>
        </h3>
      </div>

      <% if (geschuetzteRollen && geschuetzteRollen.length > 0) { %>
        <div class="list-group list-group-flush" id="protectedRolesList">
          <% geschuetzteRollen.forEach(eintrag => {
               const rolle = (roles || []).find(r => String(r.id) === String(eintrag.role_id));
          %>
            <div class="list-group-item d-flex align-items-center justify-content-between"
                 id="protected-role-<%= eintrag.role_id %>">
              <div>
                <i class="fa-solid fa-shield-halved me-2 text-secondary"></i>
                <strong><%= rolle ? rolle.name : eintrag.role_id %></strong>
                <span class="text-secondary small ms-2"><%= zeitpunkt(eintrag.created_at) %></span>
              </div>
              <button type="button" class="btn btn-sm btn-outline-danger"
                      onclick="removeProtectedRole('<%= eintrag.role_id %>')"
                      title="<%= tr('moderation:PROTECTED.BTN_REMOVE') %>">
                <i class="fa-solid fa-trash"></i>
              </button>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="card-body">
          <div class="empty">
            <div class="empty-icon"><i class="fa-solid fa-user-shield fs-1 text-secondary"></i></div>
            <p class="empty-title"><%= tr('moderation:PROTECTED.EMPTY') %></p>
            <p class="empty-subtitle text-secondary"><%= tr('moderation:PROTECTED.EMPTY_HINT') %></p>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>
