<%
/**
 * Seitenkopf der moderation-Seiten.
 *
 * **Nur noch eine Weiche.** Das Markup steht seit dem 2026-08-29 einmal im
 * Kern (`views/shared/seitenkopf.ejs`, Baustelle 83) — vorher trug jedes
 * Plugin seine eigene Kopie, und die sieben waren bereits
 * auseinandergelaufen.
 *
 * **Die Meldungstexte bleiben hier.** Sie gehoeren diesem Plugin; im Kern
 * waeren sie der Anfang eines Sammelbeckens.
 *
 * Erwartet: guildId, tr, titel, beschreibung, icon
 */
const jsTexte = {
  FEHLER:               tr('moderation:JS.FEHLER'),
  AUSWAHL_FEHLT:        tr('moderation:JS.AUSWAHL_FEHLT'),
  ROLLE_ENTFERNEN:      tr('moderation:JS.ROLLE_ENTFERNEN'),
  ROLLE_ENTFERNT:       tr('moderation:JS.ROLLE_ENTFERNT'),
  KANAL_FEHLT:          tr('moderation:JS.KANAL_FEHLT'),
  REGEL_LOESCHEN:       tr('moderation:JS.REGEL_LOESCHEN'),
  REGEL_GELOESCHT:      tr('moderation:JS.REGEL_GELOESCHT'),
  NOTIZ_UNVOLLSTAENDIG: tr('moderation:JS.NOTIZ_UNVOLLSTAENDIG'),
  NOTIZ_LOESCHEN:       tr('moderation:JS.NOTIZ_LOESCHEN'),
  NOTIZ_GELOESCHT:      tr('moderation:JS.NOTIZ_GELOESCHT')
};
%>
<%- include('shared/seitenkopf', {
      plugin:       'moderation',
      vortitel:     tr('moderation:TITLE'),
      titel:        titel,
      beschreibung: (typeof beschreibung !== 'undefined' ? beschreibung : null),
      icon:         icon,
      guildId:      guildId,
      texte:        jsTexte
}) %>
