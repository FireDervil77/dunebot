{
    "name": "moderation",
    "displayName": "Moderation",
    "description": "The Moderation Plugin for FireBot",
    "version": "1.8.2",
    "author": "FireBot Team",
    "license": "none",
    "type": "commonjs",
    "peerDependencies": {
        "discord.js": "^14.19.0",
        "express": "^5.1.0",
        "dunebot-core": "*",
        "dunebot-sdk": "*"
    },
    "guildInhalte": {
        "loeschen": [
            "moderation_channel_rules",
            "moderation_logs",
            "moderation_notes",
            "moderation_protected_roles",
            "moderation_settings"
        ]
    },
    "ereignisse": {
        "sendet": [
            "moderation.fall.angelegt",
            "moderation.fall.zurueckgenommen"
        ],
        "hoert": []
    },
    "mitgliedInhalte": {
        "moderation_logs": {
            "member_id": {
                "weg": "frist",
                "grund": "Moderationsfall (Verwarnung, Timeout, Kick, Bann), Sicherheitsfall der Guild"
            },
            "admin_id": {
                "weg": "anonymisieren",
                "mit": [
                    "admin_tag"
                ]
            }
        },
        "moderation_notes": {
            "user_id": {
                "weg": "frist",
                "grund": "Notiz der Moderation zu einem Mitglied, Sicherheitsfall der Guild"
            },
            "author_id": "anonymisieren"
        }
    },
    "aufbewahrung": [
        {
            "name": "faelle",
            "tabelle": "moderation_logs",
            "zeitspalte": "created_at",
            "vorgabe_tage": 365,
            "hoechstens_tage": 730,
            "guild": true,
            "recht": "MODERATION.SETTINGS.EDIT",
            "titel": "moderation:AUFBEWAHRUNG.FAELLE"
        },
        {
            "name": "notizen",
            "tabelle": "moderation_notes",
            "zeitspalte": "created_at",
            "vorgabe_tage": 365,
            "hoechstens_tage": 730,
            "guild": true,
            "recht": "MODERATION.SETTINGS.EDIT",
            "titel": "moderation:AUFBEWAHRUNG.NOTIZEN"
        }
    ]
}
