{
    "name": "moderation",
    "displayName": "Moderation",
    "description": "The Moderation Plugin for FireBot",
    "version": "1.8.2",
    "author": "FireBot Team",
    "license": "none",
    "type": "commonjs",
    "peerDependencies": {
        "discord.js": "^14.19.0",
        "express": "^5.1.0",
        "dunebot-core": "*",
        "dunebot-sdk": "*"
    },
    "guildInhalte": {
        "loeschen": [
            "moderation_channel_rules",
            "moderation_logs",
            "moderation_notes",
            "moderation_protected_roles",
            "moderation_settings"
        ]
    },
    "ereignisse": {
        "sendet": [
            "moderation.fall.angelegt",
            "moderation.fall.zurueckgenommen"
        ],
        "hoert": []
    },
    "mitgliedInhalte": {
        "moderation_logs": {
            "member_id": {
                "weg": "frist",
                "grund": "Moderations- und Sicherheitsfall: bleibt bis zum Ende seiner Frist (G-05), die Auskunft nennt ihn (F-G2 A)"
            },
            "admin_id": {
                "weg": "anonymisieren",
                "mit": [
                    "admin_tag"
                ]
            }
        },
        "moderation_notes": {
            "user_id": {
                "weg": "frist",
                "grund": "Notiz zu einem Mitglied. Moderations- und Sicherheitsfall: bleibt bis zum Ende seiner Frist (G-05), die Auskunft nennt ihn (F-G2 A)"
            },
            "author_id": "anonymisieren"
        }
    }
}
