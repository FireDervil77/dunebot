<!--
    Discord-Plugin: Rollenmenues

    Angelegt am 2026-08-10 (Paket 2). Die Reaktionsrollen aus `greeting` sind
    hierher gezogen und um die drei fehlenden Modi sowie Knoepfe und
    Auswahllisten erweitert worden.

    Zwei Dinge, die die Seite bewusst sichtbar macht statt sie zu verstecken:

      - **Der Zustand einer Nachricht.** „Entwurf" oder „im Kanal" steht an
        jedem Menue. Wer das nicht sieht, sucht spaeter im Kanal nach einer
        Nachricht, die nie abgeschickt wurde.
      - **Was ein Modus tut.** Vier Modi mit je einem Satz Erklaerung direkt
        an der Auswahl. „Eindeutig" sagt niemandem etwas; „nur eine Rolle aus
        diesem Menue" schon.
-->
<%
  const basis = `/guild/${guildId}/plugins/discord/rollenmenues`;

  /** Was jeder Modus tut — steht als Erklaerung an der Auswahl. */
  const modusErklaerung = {
    normal:    tr('discord:ROLEMENUS.MODE_NORMAL_DESC'),
    einmalig:  tr('discord:ROLEMENUS.MODE_ONCE_DESC'),
    eindeutig: tr('discord:ROLEMENUS.MODE_UNIQUE_DESC'),
    umgekehrt: tr('discord:ROLEMENUS.MODE_REVERSE_DESC')
  };

  const darstellungName = {
    reaktion: tr('discord:ROLEMENUS.STYLE_REACTION'),
    knopf:    tr('discord:ROLEMENUS.STYLE_BUTTON'),
    auswahl:  tr('discord:ROLEMENUS.STYLE_SELECT')
  };
%>

<div class="page-header d-print-none mb-3">
  <div class="row align-items-center">
    <div class="col">
      <h2 class="page-title">
        <i class="fa-solid fa-hand-pointer me-2"></i><%= tr('discord:ROLEMENUS.TITLE') %>
      </h2>
      <div class="text-secondary mt-1"><%= tr('discord:ROLEMENUS.SUBTITLE') %></div>
    </div>
    <div class="col-auto">
      <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#menueAnlegen">
        <i class="fa-solid fa-plus me-1"></i><%= tr('discord:ROLEMENUS.NEW') %>
      </button>
    </div>
  </div>
</div>

<div class="row row-cards">
  <div class="col-lg-8">

    <% if (!menus || menus.length === 0) { %>
      <div class="card">
        <div class="card-body">
          <div class="empty">
            <div class="empty-icon"><i class="fa-solid fa-hand-pointer fs-1 text-secondary"></i></div>
            <p class="empty-title"><%= tr('discord:ROLEMENUS.EMPTY') %></p>
            <p class="empty-subtitle text-secondary"><%= tr('discord:ROLEMENUS.EMPTY_HINT') %></p>
          </div>
        </div>
      </div>
    <% } %>

    <% (menus || []).forEach(menu => { %>
      <div class="card mb-3" id="menue-<%= menu.id %>">
        <div class="card-status-start" style="background: <%= menu.color || '#5865F2' %>"></div>
        <div class="card-header">
          <div>
            <h3 class="card-title mb-0"><%= menu.title %></h3>
            <div class="text-secondary small">
              <%= darstellungName[menu.darstellung] || menu.darstellung %>
              · <%= tr('discord:ROLEMENUS.MODE') %>: <%= tr('discord:ROLEMENUS.MODE_' + menu.modus.toUpperCase()) %>
              · <%= tr('discord:ROLEMENUS.ENTRY_COUNT', { count: menu.option_count }) %>
            </div>
          </div>
          <div class="card-actions">
            <% if (menu.message_id) { %>
              <span class="badge bg-green-lt me-2"><%= tr('discord:ROLEMENUS.STATUS_SENT') %></span>
            <% } else { %>
              <span class="badge bg-orange-lt me-2"><%= tr('discord:ROLEMENUS.STATUS_DRAFT') %></span>
            <% } %>
            <a href="<%= basis %>/<%= menu.id %>/bearbeiten" class="btn btn-sm btn-outline-primary">
              <i class="fa-solid fa-pen me-1"></i><%= tr('discord:ROLEMENUS.EDIT') %>
            </a>
            <button class="btn btn-sm btn-outline-success" data-senden="<%= menu.id %>">
              <i class="fa-solid fa-paper-plane me-1"></i>
              <%= menu.message_id ? tr('discord:ROLEMENUS.UPDATE') : tr('discord:ROLEMENUS.SEND') %>
            </button>
            <button class="btn btn-sm btn-outline-danger"
                    data-loeschen="<%= menu.id %>" data-titel="<%= menu.title %>">
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
        </div>

        <div class="card-body">
          <% if (!menu.channel_id) { %>
            <div class="alert alert-warning mb-0">
              <i class="fa-solid fa-triangle-exclamation me-2"></i><%= tr('discord:ROLEMENUS.NO_CHANNEL') %>
            </div>
          <% } else if (menu.option_count === 0) { %>
            <div class="alert alert-warning mb-0">
              <i class="fa-solid fa-triangle-exclamation me-2"></i><%= tr('discord:ROLEMENUS.NO_ENTRIES') %>
            </div>
          <% } else { %>
            <div class="text-secondary small mb-0">
              <i class="fa-solid fa-hashtag me-1"></i>
              <%= (channels.find(c => String(c.id) === String(menu.channel_id)) || {}).name || menu.channel_id %>
            </div>
          <% } %>
        </div>
      </div>
    <% }); %>

  </div>

  <!-- Hilfe: die vier Modi, weil die Namen allein nichts sagen -->
  <div class="col-lg-4">
    <div class="card">
      <div class="card-status-top bg-info"></div>
      <div class="card-header">
        <h3 class="card-title"><i class="fa-solid fa-circle-info me-2"></i><%= tr('discord:ROLEMENUS.HELP_TITLE') %></h3>
      </div>
      <div class="card-body">
        <% Object.entries(modusErklaerung).forEach(([modus, text]) => { %>
          <div class="mb-3">
            <h6 class="mb-1"><%= tr('discord:ROLEMENUS.MODE_' + modus.toUpperCase()) %></h6>
            <p class="text-secondary small mb-0"><%= text %></p>
          </div>
        <% }); %>

        <hr>

        <h6 class="mb-1"><%= tr('discord:ROLEMENUS.HELP_HIERARCHY_TITLE') %></h6>
        <p class="text-secondary small mb-0"><%= tr('discord:ROLEMENUS.HELP_HIERARCHY_TEXT') %></p>
      </div>
    </div>
  </div>
</div>

<!-- Neues Menue -->
<div class="modal modal-blur fade" id="menueAnlegen" tabindex="-1">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><%= tr('discord:ROLEMENUS.NEW') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label required"><%= tr('discord:ROLEMENUS.FIELD_TITLE') %></label>
          <input type="text" id="neuTitel" class="form-control" maxlength="255"
                 placeholder="<%= tr('discord:ROLEMENUS.FIELD_TITLE_PH') %>">
        </div>

        <div class="mb-3">
          <label class="form-label"><%= tr('discord:ROLEMENUS.FIELD_DESC') %></label>
          <textarea id="neuBeschreibung" class="form-control" rows="2"></textarea>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label"><%= tr('discord:ROLEMENUS.FIELD_CHANNEL') %></label>
            <select id="neuKanal" class="form-select">
              <option value="">— <%= tr('discord:ROLEMENUS.FIELD_CHANNEL') %> —</option>
              <% (channels || []).forEach(kanal => { %>
                <option value="<%= kanal.id %>">#<%= kanal.name %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label"><%= tr('discord:ROLEMENUS.FIELD_COLOR') %></label>
            <div class="input-group">
              <input type="color" class="form-control form-control-color" value="#5865F2"
                     data-farbwahl-fuer="neuFarbe">
              <input type="text" id="neuFarbe" class="form-control" value="#5865F2" maxlength="7">
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label"><%= tr('discord:ROLEMENUS.FIELD_STYLE') %></label>
            <select id="neuDarstellung" class="form-select">
              <% (darstellungen || []).forEach(d => { %>
                <option value="<%= d %>" <%= d === 'knopf' ? 'selected' : '' %>><%= darstellungName[d] %></option>
              <% }); %>
            </select>
            <small class="form-hint"><%= tr('discord:ROLEMENUS.FIELD_STYLE_HINT') %></small>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label"><%= tr('discord:ROLEMENUS.MODE') %></label>
            <select id="neuModus" class="form-select" onchange="zeigeModusHinweis()">
              <% (modi || []).forEach(m => { %>
                <option value="<%= m %>"><%= tr('discord:ROLEMENUS.MODE_' + m.toUpperCase()) %></option>
              <% }); %>
            </select>
            <small class="form-hint" id="modusHinweis"><%= modusErklaerung.normal %></small>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-link link-secondary" data-bs-dismiss="modal"><%= tr('discord:CANCEL') %></button>
        <button class="btn btn-primary" onclick="legeMenueAn()"><%= tr('discord:ROLEMENUS.CREATE') %></button>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  'use strict';

  const BASIS = '<%= basis %>';

  const MODUS_TEXT = <%- JSON.stringify(modusErklaerung).replace(/</g, '\\u003c') %>;

  /**
   * Anfrage an die eigenen Routen, mit einheitlicher Fehlerbehandlung.
   *
   * Jede Route dieses Routers antwortet mit `{ success, message }` — dadurch
   * kann diese eine Stelle jede Fehlermeldung anzeigen, statt dass jeder
   * Aufrufer sein eigenes `alert` baut.
   */
  async function anfrage(pfad, optionen = {}) {
    const antwort = await fetch(BASIS + pfad, {
      headers: { 'Content-Type': 'application/json' },
      ...optionen
    });

    let daten = {};
    try { daten = await antwort.json(); } catch { /* kein JSON — dann eben nichts */ }

    if (!antwort.ok || !daten.success) {
      const text = daten.message || 'Das hat nicht geklappt (HTTP ' + antwort.status + ')';
      if (window.showToast) showToast(text, 'error'); else alert(text);
      return null;
    }
    return daten;
  }

  window.zeigeModusHinweis = function () {
    const modus = document.getElementById('neuModus').value;
    document.getElementById('modusHinweis').textContent = MODUS_TEXT[modus] || '';
  };

  window.legeMenueAn = async function () {
    const titel = document.getElementById('neuTitel').value.trim();
    if (!titel) {
      const t = '<%= tr('discord:ROLEMENUS.TITLE_REQUIRED') %>';
      if (window.showToast) showToast(t, 'error'); else alert(t);
      return;
    }

    const daten = await anfrage('', {
      method: 'POST',
      body: JSON.stringify({
        title: titel,
        description: document.getElementById('neuBeschreibung').value.trim(),
        channel_id: document.getElementById('neuKanal').value,
        color: document.getElementById('neuFarbe').value,
        darstellung: document.getElementById('neuDarstellung').value,
        modus: document.getElementById('neuModus').value
      })
    });

    if (daten) location.href = BASIS + '/' + daten.id + '/bearbeiten';
  };

  // Menü-ID und Titel stehen als `data-`-Attribute am Knopf, nicht in einem
  // `onclick`. Ein Titel ist freier Text: ein Zeilenumbruch oder ein
  // Rückwärtsschrägstrich darin zerreisst jeden noch so sorgfältig maskierten
  // Aufruf im Attribut. Als Attributwert kann er nichts anrichten.
  document.addEventListener('click', function (ereignis) {
    const senden = ereignis.target.closest('[data-senden]');
    if (senden) return sendeMenue(Number(senden.dataset.senden));

    const loeschen = ereignis.target.closest('[data-loeschen]');
    if (loeschen) return loescheMenue(Number(loeschen.dataset.loeschen), loeschen.dataset.titel);
  });

  async function sendeMenue(id) {
    const daten = await anfrage('/' + id + '/senden', { method: 'POST' });
    if (!daten) return;

    let text = daten.neu
      ? '<%= tr('discord:ROLEMENUS.SENT') %>'
      : '<%= tr('discord:ROLEMENUS.UPDATED') %>';

    // Nicht setzbare Emojis nennen statt verschweigen — sonst fehlt im Kanal
    // eine Reaktion und niemand weiss, warum.
    if (daten.uebersprungen && daten.uebersprungen.length > 0) {
      text += ' ' + daten.uebersprungen.length + ' Emoji(s) konnten nicht gesetzt werden: '
           + daten.uebersprungen.join(' ');
    }

    if (window.showToast) showToast(text, 'success'); else alert(text);
    setTimeout(() => location.reload(), 900);
  }

  async function loescheMenue(id, titel) {
    if (!confirm('„' + titel + '" wirklich löschen?\n\n<%= tr('discord:ROLEMENUS.DELETE_HINT') %>')) return;

    const daten = await anfrage('/' + id, { method: 'DELETE' });
    if (!daten) return;

    const karte = document.getElementById('menue-' + id);
    if (karte) karte.remove();
  }

  // Farbwahl und Textfeld verbinden — dieselbe Mechanik wie in automod:
  // abgeschickt wird das Textfeld, weil <input type="color"> kein „leer" kennt.
  document.querySelectorAll('[data-farbwahl-fuer]').forEach(function (wahl) {
    const text = document.getElementById(wahl.getAttribute('data-farbwahl-fuer'));
    if (!text) return;

    wahl.addEventListener('input', () => { text.value = wahl.value.toUpperCase(); });
    text.addEventListener('input', function () {
      const wert = text.value.trim();
      if (/^#?[0-9a-f]{6}$/i.test(wert)) {
        wahl.value = (wert.startsWith('#') ? wert : '#' + wert).toLowerCase();
      }
    });
  });
})();
</script>
