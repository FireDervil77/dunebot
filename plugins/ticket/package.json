{
    "name": "ticket",
    "displayName": "Tickets",
    "description": "The Ticket Plugin for FireBot",
    "version": "1.5.3",
    "author": "FireBot Team",
    "license": "none",
    "type": "commonjs",
    "peerDependencies": {
        "discord.js": "^14.28.1",
        "express": "^5.1.0",
        "dunebot-core": "*",
        "dunebot-sdk": "*"
    },
    "guildInhalte": {
        "loeschen": [
            "ticket_feedback",
            "ticket_transcripts",
            "tickets",
            "ticket_auto_responses",
            "ticket_categories",
            "ticket_tags",
            "ticket_settings"
        ]
    },
    "ereignisse": {
        "sendet": [
            "ticket.geoeffnet",
            "ticket.uebernommen",
            "ticket.geschlossen"
        ],
        "hoert": []
    },
    "mitgliedInhalte": {
        "tickets": {
            "created_by": "loeschen",
            "claimed_by": "anonymisieren",
            "closed_by": "anonymisieren",
            "reopened_by": "anonymisieren"
        },
        "ticket_feedback": {
            "user_id": "loeschen"
        },
        "ticket_tags": {
            "created_by": "anonymisieren"
        }
    },
    "vorlagen": {
        "recht": "TICKET.CATEGORIES.MANAGE",
        "platzhalter": [
            { "name": "ticket:category", "bedeutung": "ticket:VORLAGEN.PH_CATEGORY", "beispiel": "Support" },
            { "name": "ticket:number", "bedeutung": "ticket:VORLAGEN.PH_NUMBER", "beispiel": "7" },
            { "name": "ticket:id", "bedeutung": "ticket:VORLAGEN.PH_ID", "beispiel": "a1B2c3D4" }
        ],
        "anlaesse": {
            "eroeffnung": {
                "titel": "ticket:VORLAGEN.EROEFFNUNG",
                "je": "ticket:VORLAGEN.JE_KATEGORIE",
                "kern": ["member", "guild", "gestaltung"],
                "platzhalter": ["ticket:category", "ticket:number", "ticket:id"]
            }
        }
    }
}
