<%- include('partials/ticket-kopf', {
  guildId, tr,
  icon: 'fa-solid fa-ticket',
  titel: tr('ticket:SETTINGS_TITLE'),
  beschreibung: tr('ticket:DESCRIPTION')
}) %>

<% const basis = `/guild/${guildId}/plugins/ticket`; %>

<div class="row row-cards">
  <div class="col-lg-7">
    <form id="ticketSettingsForm">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title"><i class="fa-solid fa-gear me-2"></i><%= tr('ticket:SETTINGS_TITLE') %></h3>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <label for="log_channel" class="form-label"><%= tr('ticket:LOGS_TITLE') %></label>
            <select name="log_channel" id="log_channel" class="form-select">
              <option value=""><%= tr('ticket:SETTINGS.NO_LOG_CHANNEL') %></option>
              <% (channels || []).filter(c => c.type === 0).forEach(kanal => { %>
                <option value="<%= kanal.id %>" <%= String(settings.log_channel) === String(kanal.id) ? 'selected' : '' %>>
                  #<%= kanal.name %>
                </option>
              <% }); %>
            </select>
            <div class="form-hint"><%= tr('ticket:LOGS_DESC') %></div>
          </div>

          <div class="mb-3">
            <label for="ticket_limit" class="form-label"><%= tr('ticket:LIMIT_TITLE') %></label>
            <input type="number" name="ticket_limit" id="ticket_limit" class="form-control"
                   value="<%= settings.ticket_limit || 50 %>" min="5" max="500">
            <div class="form-hint"><%= tr('ticket:LIMIT_DESC') %></div>
          </div>

          <div class="row">
            <div class="col-sm-6 mb-3">
              <label for="embed_color_create" class="form-label"><%= tr('ticket:CREATE_EMBED_TITLE') %></label>
              <input type="color" name="embed_color_create" id="embed_color_create"
                     class="form-control form-control-color"
                     value="<%= settings.embed_color_create || '#068ADD' %>">
              <div class="form-hint"><%= tr('ticket:CREATE_EMBED_DESC') %></div>
            </div>
            <div class="col-sm-6 mb-3">
              <label for="embed_color_close" class="form-label"><%= tr('ticket:CLOSE_EMBED_TITLE') %></label>
              <input type="color" name="embed_color_close" id="embed_color_close"
                     class="form-control form-control-color"
                     value="<%= settings.embed_color_close || '#068ADD' %>">
              <div class="form-hint"><%= tr('ticket:CLOSE_EMBED_DESC') %></div>
            </div>
          </div>
        </div>
        <div class="card-footer">
          <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-floppy-disk me-2"></i><%= tr('ticket:SAVE_BTN') %>
          </button>
        </div>
      </div>
    </form>
  </div>

  <div class="col-lg-5">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><%= tr('ticket:SETTINGS.MORE_TITLE') %></h3>
      </div>
      <div class="list-group list-group-flush">
        <%
          const bereiche = [
            ['/tickets',    'fa-solid fa-inbox',        'ticket:NAV.TICKETS'],
            ['/kategorien', 'fa-solid fa-folder-tree',  'ticket:NAV.CATEGORIES'],
            ['/bausteine',  'fa-solid fa-comment-dots', 'ticket:NAV.TAGS']
          ];
        %>
        <% bereiche.forEach(([pfad, icon, titel]) => { %>
          <a href="<%= basis %><%= pfad %>" class="list-group-item list-group-item-action">
            <i class="<%= icon %> me-3 text-secondary"></i><%= tr(titel) %>
          </a>
        <% }); %>
      </div>
    </div>
  </div>
</div>
