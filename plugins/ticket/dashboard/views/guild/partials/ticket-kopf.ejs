<%
/**
 * Seitenkopf der ticket-Seiten.
 *
 * **Nur noch eine Weiche.** Das Markup steht seit dem 2026-08-29 einmal im
 * Kern (`views/shared/seitenkopf.ejs`, Baustelle 83) — vorher trug jedes
 * Plugin seine eigene Kopie, und die sieben waren bereits
 * auseinandergelaufen.
 *
 * **Die Meldungstexte bleiben hier.** Sie gehoeren diesem Plugin; im Kern
 * waeren sie der Anfang eines Sammelbeckens.
 *
 * Erwartet: guildId, tr, titel, beschreibung, icon
 * Optional:  aktion (HTML rechts im Kopf)
 */
const jsTexte = {
  FEHLER:            tr('ticket:JS.FEHLER'),
  KAT_LOESCHEN:      tr('ticket:JS.KAT_LOESCHEN'),
  KAT_GELOESCHT:     tr('ticket:JS.KAT_GELOESCHT'),
  KAT_UNVOLLSTAENDIG: tr('ticket:JS.KAT_UNVOLLSTAENDIG'),
  BAUSTEIN_LOESCHEN: tr('ticket:JS.BAUSTEIN_LOESCHEN'),
  BAUSTEIN_GELOESCHT: tr('ticket:JS.BAUSTEIN_GELOESCHT'),
  BAUSTEIN_UNVOLLSTAENDIG: tr('ticket:JS.BAUSTEIN_UNVOLLSTAENDIG'),
  GESPEICHERT:       tr('ticket:JS.GESPEICHERT'),
  KEIN_TRANSKRIPT:   tr('ticket:JS.KEIN_TRANSKRIPT')
};
%>
<%- include('shared/seitenkopf', {
      plugin:       'ticket',
      vortitel:     tr('ticket:TITLE'),
      titel:        titel,
      beschreibung: (typeof beschreibung !== 'undefined' ? beschreibung : null),
      icon:         icon,
      guildId:      guildId,
      texte:        jsTexte,
      aktion:       (typeof aktion !== 'undefined' ? aktion : null)
}) %>
