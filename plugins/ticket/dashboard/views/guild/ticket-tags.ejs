<%- include('partials/ticket-kopf', {
  guildId, tr,
  icon: 'fa-solid fa-comment-dots',
  titel: tr('ticket:NAV.TAGS'),
  beschreibung: tr('ticket:TAGS.SUBTITLE')
}) %>

<% const zeitpunkt = (w) => w ? new Date(w).toLocaleDateString('de-DE') : '—'; %>

<div class="row row-cards">
  <!-- Neuer Baustein -->
  <div class="col-lg-4">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><i class="fa-solid fa-plus me-2"></i><%= tr('ticket:TAGS.ADD_TITLE') %></h3>
      </div>
      <div class="card-body">
        <div class="mb-3">
          <label for="tagName" class="form-label"><%= tr('ticket:TAGS.NAME') %></label>
          <input type="text" id="tagName" class="form-control font-monospace"
                 placeholder="<%= tr('ticket:TAGS.NAME_PLACEHOLDER') %>" maxlength="64">
          <div class="form-hint"><%= tr('ticket:TAGS.NAME_HELP') %></div>
        </div>
        <div class="mb-3">
          <label for="tagContent" class="form-label"><%= tr('ticket:TAGS.CONTENT') %></label>
          <textarea id="tagContent" class="form-control" rows="5"
                    placeholder="<%= tr('ticket:TAGS.CONTENT_PLACEHOLDER') %>"></textarea>
        </div>
        <button type="button" class="btn btn-success w-100" onclick="addTag()">
          <i class="fa-solid fa-plus me-2"></i><%= tr('ticket:TAGS.ADD') %>
        </button>
      </div>
      <div class="card-footer text-secondary">
        <i class="fa-solid fa-circle-info me-2"></i><%= tr('ticket:TAGS.BOT_HINT') %>
      </div>
    </div>
  </div>

  <!-- Vorhandene Bausteine -->
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <%= tr('ticket:TAGS.LIST_TITLE') %>
          <span class="badge bg-secondary-lt ms-2"><%= (bausteine || []).length %></span>
        </h3>
      </div>

      <% if (bausteine && bausteine.length > 0) { %>
        <div class="list-group list-group-flush">
          <% bausteine.forEach(b => { %>
            <div class="list-group-item" id="tag-<%= b.id %>">
              <div class="d-flex align-items-start justify-content-between">
                <div class="flex-grow-1">
                  <div class="mb-1">
                    <code class="fw-bold"><%= b.name %></code>
                    <span class="text-secondary small ms-2"><%= zeitpunkt(b.created_at) %></span>
                  </div>
                  <div class="text-secondary" style="white-space: pre-wrap;"><%= b.content %></div>
                </div>
                <button type="button" class="btn btn-sm btn-outline-danger ms-2"
                        onclick="deleteTag(<%= b.id %>)"
                        title="<%= tr('ticket:TAGS.DELETE') %>">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="card-body">
          <div class="empty">
            <div class="empty-icon"><i class="fa-solid fa-comment-dots fs-1 text-secondary"></i></div>
            <p class="empty-title"><%= tr('ticket:TAGS.EMPTY') %></p>
            <p class="empty-subtitle text-secondary"><%= tr('ticket:TAGS.EMPTY_HINT') %></p>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>
