<!-- Gameserver Edit View -->


            <div class="row">
                <div class="col-lg-8 offset-lg-2">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fa-solid fa-cog"></i> 
                                <%= tr('gameserver:SERVER.SERVER_SETTINGS') %>
                            </h3>
                        </div>
                        <form class="guild-ajax-form"
                              data-form-type="gameserver-edit"
                              data-method="PUT"
                              action="/guild/<%= guildId %>/plugins/gameserver/servers/<%= server.id %>"
                              method="POST">
                            
                            <div class="card-body">
                                <!-- Server Name -->
                                <div class="mb-3">
                                    <label for="name">
                                        <%= tr('gameserver:SERVER.NAME') %> <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" 
                                           class="form-control" 
                                           id="name" 
                                           name="name" 
                                           value="<%= server.name %>"
                                           required
                                           maxlength="100">
                                    <small class="form-text text-secondary">
                                        <%= tr('gameserver:SERVER.NAME_DESC') %>
                                    </small>
                                </div>

                                <!-- Game & Template (read-only) -->
                                <div class="mb-3">
                                    <label><%= tr('gameserver:SERVER.GAME') %></label>
                                    <input type="text" 
                                           class="form-control" 
                                           value="<%= server.game_name %>" 
                                           disabled>
                                    <small class="form-text text-secondary">
                                        <%= tr('gameserver:SERVER.GAME_READONLY') %>
                                    </small>
                                </div>

                                <div class="mb-3">
                                    <label><%= tr('gameserver:SERVER.TEMPLATE') %></label>
                                    <input type="text" 
                                           class="form-control" 
                                           value="<%= server.template_name || '-' %>" 
                                           disabled>
                                </div>

                                <!-- Ressourcen: reservierter Platz auf dem RootServer -->
                                <div class="mb-3">
                                    <label class="mb-2">
                                        <i class="fa-solid fa-gauge-high me-1 text-secondary"></i>
                                        Reservierte Ressourcen
                                    </label>
                                    <%#
                                        Vor dem 2026-08-02 gab es diese Felder nur beim Anlegen und
                                        auch dort nur als "unbegrenzt"; Bestandsserver stehen deshalb
                                        auf NULL und laufen ohne Limit. Hier lassen sie sich nachziehen.
                                        Geprüft wird beim Speichern nur die Erhöhung gegen den freien
                                        Platz des RootServers.
                                    %>
                                    <div class="row">
                                        <div class="col-sm-4">
                                            <div class="input-group input-group-sm mb-2">
                                                <input type="number" class="form-control"
                                                       id="allocated_ram_mb" name="allocated_ram_mb"
                                                       min="512" step="512"
                                                       value="<%= server.allocated_ram_mb || '' %>"
                                                       placeholder="kein Limit">
                                                <span class="input-group-text">MiB</span>
                                            </div>
                                        </div>
                                        <div class="col-sm-4">
                                            <div class="input-group input-group-sm mb-2">
                                                <input type="number" class="form-control"
                                                       id="allocated_cpu_percent" name="allocated_cpu_percent"
                                                       min="10" max="1600" step="10"
                                                       value="<%= server.allocated_cpu_percent || '' %>"
                                                       placeholder="kein Limit">
                                                <span class="input-group-text">% CPU</span>
                                            </div>
                                        </div>
                                        <div class="col-sm-4">
                                            <div class="input-group input-group-sm mb-2">
                                                <input type="number" class="form-control"
                                                       id="allocated_disk_gb" name="allocated_disk_gb"
                                                       min="1" step="5"
                                                       value="<%= server.allocated_disk_gb || '' %>"
                                                       placeholder="kein Limit">
                                                <span class="input-group-text">GiB</span>
                                            </div>
                                        </div>
                                    </div>
                                    <small class="form-text text-secondary">
                                        100 % entspricht einem CPU-Kern. Die Werte buchen Platz auf dem
                                        RootServer und begrenzen den Server im Betrieb — sie greifen beim
                                        nächsten Start. Alle drei zusammen ausfüllen oder alle leer lassen.
                                    </small>

                                    <%#
                                      Die GiB-Angabe hat bis zum 2026-08-10 nur gebucht, nie begrenzt.
                                      Seit Daemon 1.0.26 setzt der Daemon eine Projekt-Quota auf das
                                      Serververzeichnis — das setzt aber voraus, dass das Dateisystem
                                      mit `prjquota` eingehaengt ist. Ob es geklappt hat, meldet der
                                      Daemon nach jedem Start zurueck; hier steht die Antwort, damit
                                      niemand mehr eine Grenze annimmt, die es nicht gibt.
                                    %>
                                    <% if (server.disk_quota_enforced === null || server.disk_quota_enforced === undefined) { %>
                                        <div class="alert alert-secondary py-2 mt-2 mb-0">
                                            <i class="fas fa-question-circle me-1"></i>
                                            <strong>Platzgrenze:</strong> noch nicht gemeldet.
                                            Der Daemon prüft das beim nächsten Start dieses Servers.
                                        </div>
                                    <% } else if (server.disk_quota_enforced) { %>
                                        <div class="alert alert-success py-2 mt-2 mb-0">
                                            <i class="fas fa-shield-halved me-1"></i>
                                            <strong>Platzgrenze wird durchgesetzt.</strong>
                                            Schreibversuche über die Grenze hinaus schlagen fehl.
                                        </div>
                                    <% } else { %>
                                        <div class="alert alert-warning py-2 mt-2 mb-0">
                                            <i class="fas fa-triangle-exclamation me-1"></i>
                                            <strong>Die Platzgrenze greift nicht.</strong>
                                            Die GiB-Angabe bucht Platz in der Rechnung, hindert den Server
                                            aber nicht daran, die Platte vollzuschreiben.
                                            <% if (server.disk_quota_note) { %>
                                                <br><small><%= server.disk_quota_note %></small>
                                            <% } %>
                                        </div>
                                    <% } %>
                                </div>

                                <%#
                                  Backup-Aufbewahrung. Sie hing zuerst am einzelnen Cronjob —
                                  wer den loescht, verlor auch die Aufbewahrung, und der alte
                                  Bestand blieb liegen. Deshalb steht sie hier am Server.
                                %>
                                <div class="mb-4">
                                    <label class="form-label">
                                        <i class="fas fa-clock-rotate-left me-1"></i>
                                        Backups aufräumen
                                    </label>
                                    <div class="row">
                                        <div class="col-sm-6">
                                            <div class="input-group input-group-sm mb-2">
                                                <span class="input-group-text">behalte</span>
                                                <input type="number" class="form-control"
                                                       id="backup_keep" name="backup_keep"
                                                       min="0" max="65535" step="1"
                                                       value="<%= server.backup_keep ?? 0 %>">
                                                <span class="input-group-text">Stück</span>
                                            </div>
                                        </div>
                                        <div class="col-sm-6">
                                            <div class="input-group input-group-sm mb-2">
                                                <span class="input-group-text">höchstens</span>
                                                <input type="number" class="form-control"
                                                       id="backup_keep_days" name="backup_keep_days"
                                                       min="0" max="65535" step="1"
                                                       value="<%= server.backup_keep_days ?? 0 %>">
                                                <span class="input-group-text">Tage alt</span>
                                            </div>
                                        </div>
                                    </div>
                                    <small class="form-text text-secondary">
                                        Gilt für <strong>automatische</strong> Backups dieses Servers —
                                        von Hand angelegte bleiben immer stehen, ebenso das jüngste
                                        Backup. <strong>0 heißt unbegrenzt.</strong> Aufgeräumt wird nach
                                        jedem neuen Backup und einmal täglich um 3:30 Uhr; ein einzelner
                                        Cronjob darf davon abweichen.
                                    </small>
                                </div>

                                <!-- Auto Restart -->
                                <div class="mb-3">
                                    <div class="form-check form-switch">
                                        <input type="checkbox"
                                               class="form-check-input"
                                               id="auto_restart"
                                               name="auto_restart"
                                               value="1"
                                               <%= server.auto_restart ? 'checked' : '' %>>
                                        <label class="form-check-label" for="auto_restart">
                                            <%= tr('gameserver:SERVER.AUTO_RESTART') %>
                                        </label>
                                    </div>
                                    <small class="form-text text-secondary">
                                        <%= tr('gameserver:SERVER.AUTO_RESTART_DESC') %>
                                    </small>
                                </div>

                                <!-- Auto Update -->
                                <div class="mb-3">
                                    <div class="form-check form-switch">
                                        <input type="checkbox" 
                                               class="form-check-input" 
                                               id="auto_update"
                                               name="auto_update"
                                               value="1"
                                               <%= server.auto_update ? 'checked' : '' %>>
                                        <label class="form-check-label" for="auto_update">
                                            <%= tr('gameserver:SERVER.AUTO_UPDATE') %>
                                        </label>
                                    </div>
                                    <small class="form-text text-secondary">
                                        <%= tr('gameserver:SERVER.AUTO_UPDATE_DESC') %>
                                    </small>
                                </div>

                                <!-- Max Players: abgeleitet, nicht eingebbar (Konzept 23.1) -->
                                <div class="mb-3">
                                    <label>
                                        <%= tr('gameserver:SERVER.MAX_PLAYERS') %>
                                    </label>
                                    <div class="form-control-plaintext">
                                        <% if (locals.slots) { %>
                                            <strong><%= slots %></strong>
                                            <% if (locals.slotVariable) { %>
                                                <span class="text-secondary">
                                                    &mdash; aus <code><%= slotVariable %></code>
                                                </span>
                                            <% } %>
                                        <% } else { %>
                                            <span class="text-secondary">&ndash; keine Slot-Variable gesetzt</span>
                                        <% } %>
                                    </div>
                                    <small class="form-text text-secondary">
                                        Die Slot-Anzahl steht in den Environment Variables weiter unten
                                        &ndash; nur die landet im Startbefehl des Spiels. Ein eigenes
                                        Feld gab es hier bis zum 01.08.2026; es schrieb in eine reine
                                        Anzeigespalte und änderte am Server nichts.
                                    </small>
                                </div>

                                <!-- Environment Variables (JSON Editor) -->
                                <div class="mb-3">
                                    <label for="env_variables">
                                        <%= tr('gameserver:SERVER.ENV_VARIABLES') %>
                                    </label>
                                    <textarea class="form-control" 
                                              id="env_variables" 
                                              name="env_variables" 
                                              rows="10"
                                              placeholder='{"KEY": "value"}'><%= JSON.stringify(server.env_variables, null, 2) %></textarea>
                                    <small class="form-text text-secondary">
                                        <%= tr('gameserver:SERVER.ENV_VARIABLES_DESC') %>
                                    </small>

                                    <%
                                        /*
                                         * Kennzeichnen statt verstecken (Konzept 23.2): Diese Variablen
                                         * kommen weder im Startbefehl noch im Installationsskript noch in
                                         * den Konfigurationsvorlagen des Addons vor. Sie bleiben trotzdem
                                         * im Editor stehen - man braucht sie vielleicht noch, und was man
                                         * nicht sieht, findet man nicht wieder.
                                         */
                                        const ungenutzt = locals.unbenutzteVariablen || [];
                                    %>
                                    <% if (ungenutzt.length) { %>
                                        <div class="alert alert-warning mt-2 mb-0 py-2">
                                            <div class="mb-1">
                                                <i class="fas fa-triangle-exclamation me-1"></i>
                                                <strong>Diese Variablen werden von der Addon-Vorlage nicht eingesetzt:</strong>
                                            </div>
                                            <div class="mb-1">
                                                <% ungenutzt.forEach(function (v) { %>
                                                    <code class="me-2"
                                                          title="<%= v.beschreibung || 'Keine Beschreibung im Addon' %>"><%= v.name %></code>
                                                <% }); %>
                                            </div>
                                            <div class="small text-secondary">
                                                Geprüft wurden Startbefehl, Stoppbefehl, Installationsskript und
                                                Konfigurationsvorlagen &ndash; in den drei Schreibweisen
                                                <code>{{NAME}}</code>, <code>${NAME}</code> und <code>$NAME</code>.
                                                Ein Wert hier bleibt also voraussichtlich wirkungslos. Gelöscht
                                                wird nichts: Falls das Container-Abbild die Variable selbst liest,
                                                sieht diese Prüfung das nicht.
                                            </div>
                                        </div>
                                    <% } %>
                                </div>

                                <!-- Server Status Info -->
                                <div class="alert alert-info">
                                    <h5><i class="icon fas fa-info"></i> <%= tr('gameserver:SERVER.CURRENT_STATUS') %></h5>
                                    <p>
                                        <strong><%= tr('gameserver:SERVER.STATUS') %>:</strong>
                                        <% if (server.status === 'online') { %>
                                            <span class="badge bg-success-lt">Online</span>
                                        <% } else if (server.status === 'offline') { %>
                                            <span class="badge bg-secondary-lt">Offline</span>
                                        <% } else if (server.status === 'installing') { %>
                                            <span class="badge bg-info-lt">Installing</span>
                                        <% } else { %>
                                            <span class="badge bg-warning-lt"><%= server.status %></span>
                                        <% } %>
                                    </p>
                                    <p class="mb-0">
                                        <small>
                                            <%= tr('gameserver:SERVER.RESTART_REQUIRED') %>
                                        </small>
                                    </p>
                                </div>
                            </div>

                            <div class="card-footer">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa-solid fa-save"></i> <%= tr('gameserver:SERVER.SAVE_CHANGES') %>
                                </button>
                                <a href="/guild/<%= guildId %>/plugins/gameserver/servers" class="btn btn-secondary">
                                    <i class="fa-solid fa-times"></i> <%= tr('gameserver:SERVER.CANCEL') %>
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

