<!-- Addon Marketplace -->


            <div class="row">
                <!-- Sidebar Filter -->
                <div class="col-lg-3">
                    <%# mb-3: Filter und Legende klebten ohne Abstand aneinander (Betreiber, 2026-10-07). %>
                    <div class="card mb-3">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fa-solid fa-filter"></i>
                                <%= tr('gameserver:MARKETPLACE.FILTER') %>
                            </h3>
                        </div>
                        <div class="card-body">
                            <form method="GET" action="/guild/<%= guildId %>/plugins/gameserver/addons">
                                <!-- Search -->
                                <div class="mb-3">
                                    <label><%= tr('gameserver:MARKETPLACE.SEARCH') %></label>
                                    <input type="text" 
                                           class="form-control" 
                                           name="search" 
                                           placeholder="<%= tr('gameserver:MARKETPLACE.SEARCH_PLACEHOLDER') %>"
                                           value="<%= filters.search %>">
                                </div>

                                <!-- Category -->
                                <div class="mb-3">
                                    <label><%= tr('gameserver:MARKETPLACE.CATEGORY') %></label>
                                    <select class="form-control" name="category">
                                        <option value="all" <%= filters.category === 'all' ? 'selected' : '' %>>
                                            <%= tr('gameserver:MARKETPLACE.ALL_CATEGORIES') %>
                                        </option>
                                        <% categories.forEach(cat => { %>
                                            <option value="<%= cat.category %>" <%= filters.category === cat.category ? 'selected' : '' %>>
                                                <%= cat.category.toUpperCase() %> (<%= cat.count %>)
                                            </option>
                                        <% }) %>
                                    </select>
                                </div>

                                <!-- Sort -->
                                <div class="mb-3">
                                    <label><%= tr('gameserver:MARKETPLACE.SORT_BY') %></label>
                                    <select class="form-control" name="sort">
                                        <option value="default" <%= filters.sort === 'default' ? 'selected' : '' %>>
                                            <%= tr('gameserver:MARKETPLACE.SORT_DEFAULT') %>
                                        </option>
                                        <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>
                                            <%= tr('gameserver:MARKETPLACE.SORT_NEWEST') %>
                                        </option>
                                        <option value="popular" <%= filters.sort === 'popular' ? 'selected' : '' %>>
                                            <%= tr('gameserver:MARKETPLACE.SORT_POPULAR') %>
                                        </option>
                                        <option value="rating" <%= filters.sort === 'rating' ? 'selected' : '' %>>
                                            <%= tr('gameserver:MARKETPLACE.SORT_RATING') %>
                                        </option>
                                    </select>
                                </div>

                                <button type="submit" class="btn btn-primary w-100 mb-2">
                                    <i class="fa-solid fa-search"></i> <%= tr('gameserver:MARKETPLACE.APPLY_FILTER') %>
                                </button>
                                <a href="/guild/<%= guildId %>/plugins/gameserver/addons" class="btn btn-secondary w-100">
                                    <i class="fa-solid fa-times"></i> <%= tr('gameserver:MARKETPLACE.RESET_FILTER') %>
                                </a>
                            </form>
                        </div>
                    </div>

                    <!-- Legend -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fa-solid fa-shield"></i>
                                <%= tr('gameserver:MARKETPLACE.TRUST_LEVELS') %>
                            </h3>
                        </div>
                        <div class="card-body">
                            <div class="mb-2">
                                <span class="badge bg-danger-lt">
                                    👑 OFFICIAL
                                </span>
                                <small class="d-block text-secondary">
                                    <%= tr('gameserver:MARKETPLACE.TRUST_OFFICIAL') %>
                                </small>
                            </div>
                            <div class="mb-2">
                                <span class="badge bg-success-lt">
                                    🛡️ TRUSTED
                                </span>
                                <small class="d-block text-secondary">
                                    <%= tr('gameserver:MARKETPLACE.TRUST_TRUSTED') %>
                                </small>
                            </div>
                            <div class="mb-2">
                                <span class="badge bg-primary-lt">
                                    ✓ VERIFIED
                                </span>
                                <small class="d-block text-secondary">
                                    <%= tr('gameserver:MARKETPLACE.TRUST_VERIFIED') %>
                                </small>
                            </div>
                            <div>
                                <span class="badge bg-secondary-lt">
                                    <i class="fa-solid fa-question-circle"></i> UNVERIFIED
                                </span>
                                <small class="d-block text-secondary">
                                    <%= tr('gameserver:MARKETPLACE.TRUST_UNVERIFIED') %>
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Addon Grid -->
                <div class="col-lg-9">
                    <!-- Results Count -->
                    <div class="mb-3">
                        <h5>
                            <%= addons.length %> <%= tr('gameserver:MARKETPLACE.RESULTS_FOUND') %>
                            <% if (filters.search) { %>
                                <%= tr('gameserver:MARKETPLACE.FOR') %> "<%= filters.search %>"
                            <% } %>
                        </h5>
                    </div>

                    <% if (addons && addons.length > 0) { %>
                        <div class="row">
                            <% addons.forEach(addon => { %>
                                <div class="col-lg-4 col-md-6 mb-4">
                                    <div class="card h-100">
                                        <%# Das Bild des Spiels (2026-10-07). Die Liste zeigte bis dahin KEINS —
                                            nicht mit Absicht: `icon_url`/`banner_url` wurden abgefragt und nie
                                            gezeichnet. Banner fuellt die Flaeche, ein Symbol wird eingepasst
                                            statt beschnitten. Hat ein Spiel kein Bild, steht keins da — kein
                                            Platzhalter (Betreiber, 2026-09-24). %>
                                        <% const bild = addon.banner_url || addon.icon_url; %>
                                        <% if (bild) { %>
                                            <a href="/guild/<%= guildId %>/plugins/gameserver/addons/<%= addon.slug %>" tabindex="-1" aria-hidden="true">
                                                <img src="<%= bild %>" alt="" loading="lazy" class="card-img-top"
                                                     style="height:140px;width:100%;object-fit:<%= addon.banner_url ? 'cover' : 'contain' %>;background:var(--tblr-bg-surface-secondary)">
                                            </a>
                                        <% } %>
                                        <!-- Featured Badge -->
                                        <% if (addon.featured) { %>
                                            <div class="ribbon-wrapper ribbon-lg">
                                                <div class="ribbon bg-warning">
                                                    <i class="fa-solid fa-star"></i> Featured
                                                </div>
                                            </div>
                                        <% } %>

                                        <div class="card-body">
                                            <!-- Trust Level Badge -->
                                            <div class="mb-2">
                                                <% if (addon.trust_level === 'official') { %>
                                                    <span class="badge bg-danger-lt">
                                                        👑 OFFICIAL
                                                    </span>
                                                <% } else if (addon.trust_level === 'trusted') { %>
                                                    <span class="badge bg-success-lt">
                                                        🛡️ TRUSTED
                                                    </span>
                                                <% } else if (addon.trust_level === 'verified') { %>
                                                    <span class="badge bg-primary-lt">
                                                        ✓ VERIFIED
                                                    </span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary-lt">
                                                        <i class="fa-solid fa-question-circle"></i> UNVERIFIED
                                                    </span>
                                                <% } %>

                                                <span class="badge bg-info-lt ms-1">
                                                    <%= addon.category.toUpperCase() %>
                                                </span>
                                            </div>

                                            <!-- Addon Name -->
                                            <h5 class="card-title">
                                                <a href="/guild/<%= guildId %>/plugins/gameserver/addons/<%= addon.slug %>">
                                                    <%= addon.name %>
                                                </a>
                                            </h5>

                                            <%# Eine fehlende Beschreibung darf die SEITE nicht mitnehmen.
                                                Am 2026-08-31 tat sie genau das: `addon.description` war
                                                NULL (marktplatz-bruecke.js fuellt die Spalte nicht), und
                                                `.substring` darauf warf 500 — fuer den ganzen Marktplatz,
                                                nicht nur fuer die eine Karte. Eine Zeile ohne Text ist
                                                unschoen; eine Seite, die deshalb gar nicht laedt, ist
                                                kaputt. %>
                                            <p class="card-text text-secondary small">
                                                <% const beschreibung = (addon.description || '').trim(); %>
                                                <% if (beschreibung) { %>
                                                    <%= beschreibung.substring(0, 100) %><%= beschreibung.length > 100 ? '…' : '' %>
                                                <% } else { %>
                                                    <span class="fst-italic">Keine Beschreibung hinterlegt.</span>
                                                <% } %>
                                            </p>

                                            <!-- Stats -->
                                            <div class="mb-3">
                                                <!-- Rating -->
                                                <% if (addon.rating_count > 0) { %>
                                                    <div class="d-inline-block me-3">
                                                        <i class="fa-solid fa-star text-warning"></i>
                                                        <%= addon.rating_avg ? addon.rating_avg.toFixed(1) : 0 %>
                                                        <small class="text-secondary">(<%= addon.rating_count %>)</small>
                                                    </div>
                                                <% } else { %>
                                                    <div class="d-inline-block me-3">
                                                        <i class="fa-regular fa-star text-secondary"></i>
                                                        <small class="text-secondary"><%= tr('gameserver:MARKETPLACE.NO_RATINGS') %></small>
                                                    </div>
                                                <% } %>

                                                <!-- Downloads -->
                                                <div class="d-inline-block">
                                                    <i class="fa-solid fa-download text-info"></i>
                                                    <%= addon.downloads || 0 %>
                                                </div>
                                            </div>

                                            <!-- Author -->
                                            <small class="text-secondary">
                                                <%= tr('gameserver:MARKETPLACE.BY') %> <%= addon.author_name || 'Unknown' %>
                                            </small>
                                        </div>

                                        <div class="card-footer">
                                            <a href="/guild/<%= guildId %>/plugins/gameserver/addons/<%= addon.slug %>" 
                                               class="btn btn-primary w-100">
                                                <i class="fa-solid fa-eye"></i> <%= tr('gameserver:MARKETPLACE.VIEW_DETAILS') %>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <!-- No Results -->
                        <div class="card">
                            <div class="card-body text-center p-5">
                                <i class="fa-solid fa-inbox fa-4x text-secondary mb-4"></i>
                                <h4><%= tr('gameserver:MARKETPLACE.NO_RESULTS') %></h4>
                                <p class="text-secondary">
                                    <%= tr('gameserver:MARKETPLACE.NO_RESULTS_DESC') %>
                                </p>
                                <a href="/guild/<%= guildId %>/plugins/gameserver/addons" class="btn btn-primary">
                                    <i class="fa-solid fa-refresh"></i> <%= tr('gameserver:MARKETPLACE.RESET_FILTER') %>
                                </a>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>


<style>
.ribbon-wrapper {
    width: 85px;
    height: 88px;
    overflow: hidden;
    position: absolute;
    top: -3px;
    right: -3px;
}

.ribbon-wrapper.ribbon-lg {
    width: 120px;
    height: 120px;
}

.ribbon {
    font-size: 0.8rem;
    font-weight: 800;
    color: #fff;
    text-align: center;
    padding: 7px 0;
    position: relative;
    top: 15px;
    right: -30px;
    width: 120px;
    transform: rotate(45deg);
    box-shadow: 0 0 3px rgba(0,0,0,.3);
}
</style>
