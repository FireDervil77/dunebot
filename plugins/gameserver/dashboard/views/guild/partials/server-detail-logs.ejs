<%# Logs: die Ausgabe des Spiels zum Nachlesen, anders als die Konsole nicht nur der
    laufende Rest. Spiele wie 7 Days schreiben keine Logdatei, alles steht hier. %>
<% if (!userPermissions.permissions['GAMESERVER.LOGS.VIEW']) { %>
  <div class="alert alert-warning mb-0">
    Du hast keine Berechtigung, Logs zu sehen (benötigt: <code>GAMESERVER.LOGS.VIEW</code>).
  </div>
<% } else { %>
  <div class="row g-2 align-items-end mb-2">
    <div class="col-12 col-md">
      <label class="form-label" for="log-filter">Filter</label>
      <input id="log-filter" class="form-control font-monospace" spellcheck="false" placeholder="z. B. [MODS] oder Exception">
    </div>
    <div class="col-6 col-md-auto">
      <label class="form-label" for="log-menge">Letzte Zeilen</label>
      <select id="log-menge" class="form-select">
        <option value="500">500</option>
        <option value="2000">2.000</option>
        <option value="5000" selected>5.000</option>
      </select>
    </div>
    <div class="col-6 col-md-auto d-flex gap-2">
      <button id="log-laden" type="button" class="btn btn-white"><i class="fa-solid fa-rotate me-1"></i>Neu laden</button>
      <button id="log-speichern" type="button" class="btn btn-white" disabled><i class="fa-solid fa-download me-1"></i>Herunterladen</button>
    </div>
  </div>
  <div id="log-stand" class="fb-muted mb-2" style="font-size:12px" role="status">Wird geladen …</div>
  <pre id="log-text" class="font-monospace mb-0" tabindex="0"
       style="font-size:12px;height:65vh;overflow:auto;white-space:pre-wrap;word-break:break-word;padding:12px;border:1px solid var(--fb-border);border-radius:6px"></pre>

  <script>
  (function () {
    const ADRESSE = '/guild/<%= guildId %>/plugins/gameserver/console/<%= server.id %>/logs';
    const SERVER = '<%= server.id %>';
    const feld = {
      filter: document.getElementById('log-filter'),
      menge: document.getElementById('log-menge'),
      laden: document.getElementById('log-laden'),
      speichern: document.getElementById('log-speichern'),
      stand: document.getElementById('log-stand'),
      text: document.getElementById('log-text'),
    };
    let zeilen = [];

    function zeigen() {
      const gesucht = feld.filter.value.trim().toLowerCase();
      const treffer = gesucht ? zeilen.filter(z => z.toLowerCase().includes(gesucht)) : zeilen;
      feld.text.textContent = treffer.join('\n');
      feld.stand.textContent = gesucht
        ? `${treffer.length.toLocaleString('de-DE')} von ${zeilen.length.toLocaleString('de-DE')} Zeilen`
        : `${zeilen.length.toLocaleString('de-DE')} Zeilen`;
      feld.speichern.disabled = zeilen.length === 0;
    }

    function laden() {
      feld.laden.disabled = true;
      feld.stand.textContent = 'Wird geladen …';
      fetch(`${ADRESSE}?lines=${encodeURIComponent(feld.menge.value)}`, { headers: { Accept: 'application/json' } })
        .then(async (a) => {
          const d = await a.json().catch(() => null);
          if (!a.ok || !d || !d.success) throw new Error((d && d.error) || `HTTP ${a.status}`);
          return d;
        })
        .then((d) => {
          zeilen = Array.isArray(d.lines) ? d.lines.map(String) : [];
          zeigen();
          if (!feld.filter.value.trim()) feld.text.scrollTop = feld.text.scrollHeight;
        })
        .catch((e) => {
          feld.stand.textContent = 'Das Log ließ sich nicht laden: ' + e.message;
          if (typeof showToast === 'function') showToast('error', 'Das Log ließ sich nicht laden: ' + e.message);
        })
        .finally(() => { feld.laden.disabled = false; });
    }

    function speichern() {
      const adresse = URL.createObjectURL(new Blob([zeilen.join('\n')], { type: 'text/plain;charset=utf-8' }));
      const verweis = document.createElement('a');
      verweis.href = adresse;
      verweis.download = `server-${SERVER}-log.txt`;
      verweis.click();
      URL.revokeObjectURL(adresse);
    }

    feld.filter.addEventListener('input', zeigen);
    feld.menge.addEventListener('change', laden);
    feld.laden.addEventListener('click', laden);
    feld.speichern.addEventListener('click', speichern);
    laden();
  })();
  </script>
<% } %>
