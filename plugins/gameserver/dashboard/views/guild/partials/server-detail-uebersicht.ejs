<%#
  Die neue Serverseite — Entwurf vom 2026-08-18, Artboard 2 und 3.

  ── Warum hier Inline-Stile stehen und nicht nur Tabler-Klassen ─────────────

  Der erste Anlauf benutzte Tabler-Vorgaben, weil im Entwurf Klassen wie `card`
  und `btn` vorkommen. Der Betreiber sah es sofort: „das sieht immer noch nach
  altem Layout aus". Zu Recht — der Entwurf trägt sein Aussehen in 132
  INLINE-Stilen: eigene Schriftgrössen (13 px Nebentext statt Tabler-14), eine
  zweispaltige Zustandskarte mit 268-px-Flanke, Wertefelder als umrandete
  Kästen, Pillen mit 100rem.

  Hier stehen deshalb dieselben Masse wie in der Vorlage. Wandert das später in
  eine Themedatei, ändert sich nichts am Aussehen — aber solange es EINE Seite
  ist, ist die Vorlage die Wahrheit und nicht meine Erinnerung an sie.
-%>
<% const u = locals.uebersicht; %>
<% if (u) { %>


<div class="fb-seite">

  <%# Die Kopfzeile steht im Rahmen (server-detail.ejs), nicht hier.
      Sie stand am 2026-08-19 an BEIDEN Stellen: Zuerst hier gebaut, dann beim
      Umbau des Rahmens dorthin gehoben — und hier vergessen. Ergebnis waren
      zwei Kopfzeilen samt zwei Hoehenumschaltern uebereinander. %>

  <%# ── Kein Paket auf diesem Kanal (Baustelle 172) ───────────────────────
      Der Server folgt „stable", und fuer sein Spiel ist nichts freigegeben.
      Dann startet er nicht — das steht hier oben, nicht erst in der
      Fehlermeldung nach dem Klick auf „Starten". %>
  <% if (u.kanal && u.kanal.ohneFassung) { %>
    <div class="fb-karte" style="border-color:var(--fb-warning)">
      <div class="fb-koerper" style="font-size:13px;display:flex;align-items:center;gap:12px;flex-wrap:wrap">
        <div style="flex:1 1 320px">
          <strong>Für dieses Spiel ist keine Fassung freigegeben.</strong>
          Der Server folgt dem Kanal „stable" und hat deshalb kein Paket — er lässt sich nicht starten, bis eine Fassung freigegeben ist.
        </div>
        <% if (u.kanal.waehlbar) { %>
          <button type="button" class="btn btn-white btn-sm" data-fb-kanal-setzen="test">Auf „test" stellen</button>
        <% } %>
      </div>
    </div>
  <% } %>

  <%# ── Hinweise des Pakets (2026-10-06) ──────────────────────────────────
      Fester Text aus dem Paket (`hints`): was sich nicht einstellen laesst und
      was man trotzdem wissen muss. Steht VOR der Zustandskarte, weil er vor dem
      ersten Klick auf „Starten" gelesen sein will (StarRupture: erst neue Welt,
      dann auf Laden umstellen). Zuklappbar; der Browser merkt es sich je Server
      — und klappt wieder auf, sobald sich an den Hinweisen etwas aendert. %>
  <% if (u.hinweise && u.hinweise.length) { %>
    <details class="fb-karte" open data-fb-hinweise="<%= server.id %>"
             data-fb-stand="<%= u.hinweise.map(function (h) { return h.key + ':' + h.text.length; }).join('|') %>">
      <summary class="fb-kopf" style="cursor:pointer;list-style:none">
        <span>Hinweise zu diesem Spiel</span>
        <span class="fb-muted" style="margin-left:auto;font-size:13px;font-weight:400" data-fb-hinweise-knopf>Zuklappen</span>
      </summary>
      <div class="fb-koerper" style="font-size:13px;display:flex;flex-direction:column;gap:10px">
        <% u.hinweise.forEach(function (h) { %>
          <div style="white-space:pre-line"><%= h.text %></div>
        <% }); %>
      </div>
    </details>
  <% } %>

  <%# ── Zustandskarte: zweispaltig, rechte Flanke 268 px ─────────────────── %>
  <div class="fb-karte" style="overflow:hidden">
    <div style="display:flex;align-items:stretch;flex-wrap:wrap">

      <div style="flex:1 1 340px;padding:24px 28px;display:flex;flex-direction:column;gap:14px">
        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
          <%# Der Punkt bekommt denselben Haken wie der Text daneben - sonst
              wechselt beim Starten die Beschriftung und die Farbe bleibt. %>
          <span class="fb-punkt" style="background:var(--fb-<%= u.zustand.ton === 'green' ? 'success' : u.zustand.ton === 'red' ? 'danger' : u.zustand.ton === 'yellow' ? 'warning' : 'text-muted' %>);<%=
            u.zustand.gut ? 'box-shadow:0 0 0 4px rgba(47,179,68,.16)' : '' %>"
                data-fb-live="status-punkt" data-fb-server="<%= server.id %>"></span>
          <div style="font-size:20px;font-weight:600;letter-spacing:-.01em"
               data-fb-live="status-text" data-fb-server="<%= server.id %>"><%= u.zustand.text %></div>
          <%# ── Die Bereitschaftspille (Baustelle 134, 2026-09-17) ───────────
              Vorher hing dieser ganze Block an
              `if (online || starting)` — und davor stand noch ein Zweig
              `if (u.zustand.stufe)`, den es nie gab: `baueZustand()` setzt
              `stufe` ausnahmslos auf `null`.

              Der Betreiber nach dem Rollout: *"das 'noch nichts gemeldet'
              erscheint leider auch nicht von alleine, nur nach Seite neu
              laden."* Genau daran lag es: Wer die Seite bei ausgeschaltetem
              Server oeffnet und dann auf Starten klickt, hatte die Pille gar
              nicht im DOM. Das Modul sucht sie, findet nichts, zeichnet nichts
              — lautlos, wie beim ersten Mal.

              Jetzt steht sie immer da. Sichtbarkeit, Text, Klasse und die
              Wartemarke kommen aus `u.pille` — gerechnet von
              `pillenZustand()` in `gameserver-live.js`, also von DERSELBEN
              Funktion, die sie danach weiterschaltet. %>
          <% const pz = (u && u.pille) || { sichtbar: false, text: '', klasse: 'fb-pille', titel: '', wartet: false }; %>
          <span class="<%= pz.klasse %>" data-fb-live="bereitschaft-pille"
                data-fb-server="<%= server.id %>"
                title="<%= pz.titel %>"<%= pz.sichtbar ? '' : ' hidden' %>>
            <%# Der drehende Ring sagt "es passiert gerade etwas" — ohne dass
                man die Konsole aufmachen muss. Er ist ein KIND der Pille,
                damit ihn das Neuschreiben des Textes nicht mit wegwirft. %>
            <span class="fb-warte" data-fb-pille="warte"<%= pz.wartet ? '' : ' hidden' %>></span><span data-fb-pille="text"><%= pz.text %></span>
          </span>
        </div>

<%# B93: Serverliste und Direktverbindung sind zwei verschiedene Adressen.
    Am 2026-08-31 gemessen: Bei Astro Colony schweigt der Spielport auf eine
    Steam-Abfrage, der Abfrageport antwortet. Eine Zeile fuer beides hat den
    Betreiber die Adresse weitergeben lassen, unter der Steam nichts findet. %>
        <div style="display:flex;flex-direction:column;gap:6px">
          <% if (u.adresse) { %>
            <%# Die Beschriftungsspalte auch dann, wenn nur die IP-Zeile eine traegt —
                sonst steht das Feld mit dem Namen links vom Feld mit der IP (Betreiber, 2026-10-06). %>
            <% const adresseMitSpalte = u.adresse.zeilen.length > 1 || u.adresse.zeilen.some(function (z) { return z.ip; }); %>
            <% u.adresse.zeilen.forEach(function (z) { %>
              <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                <% if (adresseMitSpalte) { %>
                  <span class="fb-muted" style="font-size:12px;min-width:112px"><%= z.label %></span>
                <% } %>
                <div class="fb-mono fb-chip"><%= z.text %></div>
                <button type="button" class="btn btn-white btn-sm" data-fb-kopieren="<%= z.text %>">Kopieren</button>
              </div>
              <%# Dieselbe Adresse als IP — manche Spiele nehmen im Beitreten-Feld keinen Namen an (StarRupture, 2026-10-06). %>
              <% if (z.ip) { %>
                <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                  <span class="fb-muted" style="font-size:12px;min-width:112px">als IP</span>
                  <div class="fb-mono fb-chip"><%= z.ip %></div>
                  <button type="button" class="btn btn-white btn-sm" data-fb-kopieren="<%= z.ip %>">Kopieren</button>
                </div>
              <% } %>
            <% }); %>
            <% if (u.adresse.zeilen.length > 1) { %>
              <div class="fb-muted" style="font-size:12px">
                In der Steam-Serverliste wird der Server unter der oberen Adresse gefunden.
              </div>
            <% } %>
            <% if (u.adresse.zeilen.some(function (z) { return z.ip; })) { %>
              <div class="fb-muted" style="font-size:12px">
                Findet ein Spiel den Server unter dem Namen nicht, nimm die IP — manche Spiele nehmen nur Adressen an.
              </div>
            <% } %>
          <% } else { %>
            <div class="fb-muted" style="font-size:13px">Adresse unbekannt — es ist kein Port belegt.</div>
          <% } %>
        </div>

        <div class="fb-muted" style="font-size:13px">
          <%= u.laufzeit ? u.laufzeit.text : 'Laufzeit wird erst ab dem nächsten Start gezählt.' %>
          <% if (u.kennzahlen) { %>
            &nbsp;·&nbsp;
            <% if (u.kennzahlen.cpu !== null) { %>CPU <span class="fb-mono"><%= u.kennzahlen.cpu.toFixed(1) %>&nbsp;%</span><% } %>
            <% if (u.kennzahlen.ram !== null) { %>&nbsp; RAM <span class="fb-mono"><%= Math.round(u.kennzahlen.ram) %><%= u.kennzahlen.ramMax ? '/' + Math.round(u.kennzahlen.ramMax) : '' %>&nbsp;MB</span><% } %>
          <% } %>
        </div>

        <%# ── Platz (Baustelle 101, weiche Grenze) ─────────────────────────────
            Die Zahlen rechnet `bauePlatz` im Server, hier wird nur gezeichnet.
            „noch nicht gemessen" steht ausdrücklich da: ein leerer Balken wäre
            eine Aussage, und zwar die falsche. %>
        <% if (u.platz && u.platz.text) { %>
          <div style="margin-top:10px">
            <div style="display:flex;align-items:baseline;justify-content:space-between;gap:12px">
              <div style="font-size:13px">
                Platz
                <span class="fb-mono" data-fb-live="platz-text" data-fb-server="<%= server.id %>"><%= u.platz.text %></span>
                <% if (u.platz.geschaetzt) { %>
                  <span class="fb-muted" style="font-size:12px" title="Seit der letzten Messung wurde ein Upload dazugerechnet.">(geschätzt)</span>
                <% } %>
              </div>
              <% if (u.platz.durchsetzung === 'weich') { %>
                <span class="fb-muted" style="font-size:12px"
                      title="<%= u.platz.grund || '' %>">weiche Grenze</span>
              <% } else if (u.platz.durchsetzung === 'hart') { %>
                <span class="fb-muted" style="font-size:12px" title="Projekt-Quota im Dateisystem">harte Grenze</span>
              <% } else if (u.platz.durchsetzung === 'keine') { %>
                <span class="fb-muted" style="font-size:12px">keine Grenze gebucht</span>
              <% } %>
            </div>
            <% if (u.platz.prozent !== null) { %>
              <div style="height:6px;border-radius:100rem;background:#f1f3f5;overflow:hidden;margin-top:6px">
                <%# Farbe aus `bauePlatz`, nicht hier entschieden — sonst stünde die
                    Schwelle zweimal da und der Balken sähe nach dem ersten
                    Nachladen anders aus. %>
                <div data-fb-live="platz-balken" data-fb-server="<%= server.id %>"
                     style="height:100%;width:<%= Math.min(100, u.platz.prozent) %>%;background:<%= u.platz.farbe %>"></div>
              </div>
            <% } %>
            <% if (u.platz.ueber) { %>
              <div style="font-size:12px;color:#d63939;margin-top:6px">
                Über der Grenze. Der Server startet nicht, und Uploads werden abgelehnt,
                bis Platz frei ist. Löschen geht weiter.
              </div>
            <% } %>
          </div>
        <% } %>
      </div>

      <div style="width:268px;flex:0 0 268px;padding:20px 24px;border-left:1px solid var(--fb-border);background:#fbfcfd">
        <div style="display:flex;align-items:baseline;gap:8px">
          <div class="fb-mono" style="font-size:24px;font-weight:600"
               data-fb-live="spieler" data-fb-server="<%= server.id %>"><%= u.spieler.jetzt !== null ? u.spieler.jetzt : '—' %></div>
          <div class="fb-muted" style="font-size:13px"><%= u.spieler.max ? 'von ' + u.spieler.max + ' Spielern' : 'Spieler' %></div>
        </div>
        <div style="margin-top:8px">
          <% if (u.spieler.liste && u.spieler.liste.length) { %>
            <% u.spieler.liste.forEach(function (s) { %>
              <div style="display:flex;align-items:center;gap:10px;padding:8px 0">
                <div style="width:26px;height:26px;border-radius:100rem;background:#f1f3f5;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;flex:0 0 auto<%=
                  s.avatar ? ';background-image:url(' + s.avatar + ');background-size:cover' : '' %>"><%= s.avatar ? '' : s.kuerzel %></div>
                <div style="flex:1 1 auto;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= s.name %></div>
                <% if (s.ping !== null) { %><span class="fb-muted fb-mono" style="font-size:12px"><%= s.ping %> ms</span><% } %>
              </div>
            <% }); %>
          <% } else if (u.spieler.liste) { %>
            <div class="fb-muted" style="font-size:13px">Gerade niemand auf dem Server.</div>
          <% } else { %>
            <%# Keine Abfrage heisst „wir wissen es nicht" — etwas anderes als
                „niemand da", und deshalb steht es auch anders da. %>
            <div class="fb-muted" style="font-size:13px">Spielerliste liegt gerade nicht vor.</div>
          <% } %>
        </div>
      </div>

    </div>
  </div>

  <%# ── Zweispaltig, wie im Entwurf: links das Tun, rechts das Nachsehen ── %>
  <div class="fb-raster">
  <div>

  <%# ── Einstellungen ────────────────────────────────────────────────────── %>
  <div class="fb-karte">
    <div class="fb-kopf">
      <span>Einstellungen</span>
      <span class="fb-muted" style="margin-left:auto;font-size:13px;font-weight:400">
        <%= u.hoehe === 'einfach' ? 'Einfache Höhe' : 'Alle ' + u.einstellungen.sichtbar.length %>
      </span>
    </div>
    <div style="padding:4px 20px 20px">
      <% if (u.einstellungen.ohnePaket) { %>
        <div class="fb-muted" style="padding:16px 0;font-size:13px">
          Dieser Server läuft noch über den alten Weg und hat kein Spielpaket.
        </div>
      <% } else if (!(u.einstellungen.gruppen || []).length && !u.einstellungen.verborgen) { %>
        <div class="fb-muted" style="padding:16px 0;font-size:13px">
          Das Spielpaket bietet keine Einstellungen an.
        </div>
      <% } else { %>
        <% (u.einstellungen.gruppen || []).forEach(function (g) { %>
          <% if (g.name) { %><div class="fb-abschnitt"><%= g.name %></div><% } %>
          <% g.eintraege.forEach(function (e) { %>
            <div class="fb-zeile">
              <div>
                <div style="font-weight:500"><%= e.name %></div>
                <% if (e.beschreibung) { %>
                  <div class="fb-muted" style="font-size:13px;margin-top:2px;text-wrap:pretty"><%= e.beschreibung %></div>
                  <%# Ein Hinweis, keine Sperre. Er erscheint nur, wenn die
                      Bedingung des Pakets zutrifft — und sagt, was passieren
                      WIRD, nicht was verboten ist. %>
                  <% if (e.warnung) { %>
                    <div style="font-size:12px;margin-top:4px;color:var(--fb-warning);text-wrap:pretty">
                      ⚠ <%= e.warnung %>
                    </div>
                  <% } %>
                <% } %>
                <div style="margin-top:6px;display:flex;flex-wrap:wrap;gap:6px">
                  <% if (e.wirkung) { %><span class="fb-pille"><%= e.wirkung.text %></span><% } %>
                  <% if (e.risiko) { %>
                    <span class="fb-pille" style="background:#fdf0e6;color:#b35309"><%= e.risiko %></span>
                  <% } %>
                  <% if (u.hoehe === 'fachlich') { %>
                    <span class="fb-pille" style="background:#fff;border:1px solid var(--fb-border)"><%= e.schluessel %></span>
                  <% } %>
                </div>
              </div>
              <div>
                <% if (!e.aenderbar) { %>
                  <%# Ohne Egg-Namen laesst sich der Wert anzeigen, aber nicht
                      speichern. Ein Feld, das sich bedienen laesst und nichts
                      bewirkt, waere schlimmer als ein festes. %>
                  <div class="fb-feld fb-feld-leer"><%= e.hatWert ? String(e.wert) : 'kein Wert hinterlegt' %></div>
                  <div class="fb-muted" style="font-size:12px;margin-top:4px">nur lesbar — das Paket kennt hier keine Zuordnung</div>
                <% } else if (e.typ === 'choice' && e.auswahl) { %>
                  <div style="display:flex;gap:6px;flex-wrap:wrap">
                    <% e.auswahl.forEach(function (c) { %>
                      <button type="button" class="fb-wahl<%= String(e.wert) === c.wert ? ' an' : '' %>"
                              data-fb-feld="<%= e.variable %>" data-fb-wert="<%= c.wert %>"><%= c.name %></button>
                    <% }); %>
                  </div>
                <% } else if (e.typ === 'boolean') { %>
                  <% const an = String(e.wert) === '1' || e.wert === true; %>
                  <div style="display:flex;gap:6px">
                    <button type="button" class="fb-wahl<%= an ? ' an' : '' %>"
                            data-fb-feld="<%= e.variable %>" data-fb-wert="1">An</button>
                    <button type="button" class="fb-wahl<%= an ? '' : ' an' %>"
                            data-fb-feld="<%= e.variable %>" data-fb-wert="0">Aus</button>
                  </div>
                <% } else { %>
                  <input class="fb-feld" style="width:100%"
                         <%# Siehe server-create-step3.ejs: Ohne das fuellt der
                             Browser hier den angemeldeten Nutzer und ein
                             gespeichertes Passwort ein. %>
                         autocomplete="<%= e.geheim ? 'new-password' : 'off' %>"
                         data-1p-ignore data-lpignore="true" data-bwignore
                         type="<%= e.geheim ? 'password' : (e.typ === 'number' ? 'number' : 'text') %>"
                         <% if (e.min !== null) { %>min="<%= e.min %>"<% } %>
                         <% if (e.max !== null) { %>max="<%= e.max %>"<% } %>
                         value="<%= e.hatWert ? String(e.wert) : '' %>"
                         placeholder="<%= e.hatWert ? '' : 'kein Wert hinterlegt' %>"
                         data-fb-feld="<%= e.variable %>"
                         data-fb-alt="<%= e.hatWert ? String(e.wert) : '' %>">
                <% } %>
                <% if (e.risiko) { %>
                  <div class="fb-muted" style="font-size:12px;margin-top:4px;color:#b35309"><%= e.risiko %></div>
                <% } %>
              </div>
            </div>
          <% }); %>
        <% }); %>

        <%# ── Fussleiste: erst zaehlen, dann speichern ────────────────────
            Der Zaehler nennt nicht nur die Zahl, sondern die FOLGE: „braucht
            einen Neustart" oder „erzeugt eine neue Welt". Wer speichert, soll
            vorher wissen, was danach passiert — nicht erst hinterher. %>
        <div class="fb-fuss" id="fb-fuss" hidden>
          <span class="fb-muted" id="fb-fuss-text"></span>
          <div style="margin-left:auto;display:flex;gap:8px">
            <button type="button" class="btn btn-white btn-sm" id="fb-verwerfen">Verwerfen</button>
            <button type="button" class="btn btn-primary btn-sm" id="fb-speichern">Speichern</button>
          </div>
        </div>

        <% if (u.einstellungen.verborgen > 0 && u.hoehe === 'einfach') { %>
          <div class="fb-muted" style="font-size:13px;margin-top:16px">
            <%= u.einstellungen.verborgen %> weitere Einstellungen liegen in der
            <a href="?ansicht=fachlich">fachlichen Höhe</a>.
          </div>
        <% } %>
      <% } %>
    </div>
  </div>

  <%# ── Befehle (fachliche Höhe) ─────────────────────────────────────────── %>
  <% if (u.hoehe === 'fachlich' && u.befehle.length) { %>
    <div class="fb-karte">
      <div class="fb-kopf"><span>Befehle</span></div>
      <div style="padding:4px 20px 20px">
        <% u.befehle.forEach(function (b) { %>
          <div class="fb-zeile">
            <div>
              <div style="font-weight:500;<%= b.geht ? '' : 'color:var(--fb-text-muted)' %>"><%= b.name %></div>
              <% if (b.grund) { %>
                <div class="fb-muted" style="font-size:13px;margin-top:2px;text-wrap:pretty"><%= b.grund %></div>
              <% } else if (b.detail) { %>
                <div class="fb-muted fb-mono" style="font-size:13px;margin-top:2px"><%= b.detail %></div>
              <% } %>
            </div>
            <div>
              <span class="fb-pille" style="<%= b.geht ? 'background:#e9f7ec;color:#1a7f37' : '' %>"><%= b.quelle.text %></span>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>

  </div>
  <div>

  <%# ── Bereitschaft ──────────────────────────────────────────────────────
       In BEIDEN Höhen, seit 2026-08-23 auf Ansage des Betreibers.

       Sie stand bis dahin nur in der fachlichen, nach der Regel „was ein
       Betreiber selten braucht, steht in der fachlichen Höhe". Die Regel passt
       hier nicht: Bereitschaft beantwortet die Frage, die ein Betreiber am
       HÄUFIGSTEN hat — kann jemand rein? „Läuft" beantwortet sie nicht.

       Damit ist sie eher das Gegenteil von fachlich: Wer die einfache Höhe
       wählt, will genau diese eine Auskunft und nicht die Portliste dahinter.
  -%>
  <% if (u.bereitschaft) { %>
    <div class="fb-karte">
      <div class="fb-kopf">
        <span>Bereitschaft</span>
        <% if (u.bereitschaft.bereit) { %>
          <span class="fb-pille fb-pille-gut" style="margin-left:auto">bereit</span>
        <% } else if (u.bereitschaft.gemessen) { %>
          <span class="fb-pille" style="margin-left:auto">Stufe <%= u.bereitschaft.stufe %></span>
        <% } else if (u.bereitschaft.veraltet) { %>
          <span class="fb-pille" style="margin-left:auto">Server ist aus</span>
        <% } else { %>
          <span class="fb-pille" style="margin-left:auto">noch nicht gemeldet</span>
        <% } %>
      </div>
      <div class="fb-koerper">
        <% u.bereitschaft.stufen.forEach(function (st) { %>
          <div style="display:flex;gap:10px;padding:8px 0;align-items:start">
            <%# Gefüllt nur, was der Daemon wirklich gemeldet hat. Drei geratene
                Haken wären die eine Zeile auf dieser Seite, die in die Irre
                führt — der Betreiber glaubte dann, ein Spieler kommt rein. %>
            <%# Drei Farben, drei Bedeutungen — keine Verzierung:
                  grün  = gemessen erreicht
                  gelb  = die Stufe, auf die gerade gewartet wird
                  grau  = verlangt, aber noch nicht dran
                  blass = das Paket verlangt sie gar nicht — oder fb-init
                          konnte sie nicht prüfen (B160): keine Messung
                Gelb gibt es nur, WENN gemessen wird. Ohne Meldung ist alles
                grau — eine wartende Stufe zu zeigen, wo niemand misst, wäre
                dieselbe Behauptung wie ein grüner Haken. %>
            <% const farbe = st.erreicht ? 'var(--fb-success)'
                 : (!st.verlangt || st.ungeprueft ? '#f1f3f5'
                 : (u.bereitschaft.gemessen && st.wartet ? 'var(--fb-warning)' : 'var(--fb-border)')); %>
            <span class="fb-punkt" style="margin-top:6px;background:<%= farbe %>"
                  data-fb-live="stufe-punkt" data-fb-server="<%= server.id %>"
                  data-fb-stufe="<%= st.schluessel %>"
                  data-fb-verlangt="<%= st.verlangt ? 'ja' : 'nein' %>"></span>
            <div>
              <div style="font-weight:500;<%= st.verlangt ? '' : 'color:var(--fb-text-muted)' %>">
                <%= st.name %><% if (st.erreicht) { %> ✓<% } %><% if (st.ungeprueft) { %> — nicht geprüft<% } %>
              </div>
              <div class="fb-muted" style="font-size:13px"><%= st.erklaerung %></div>
            </div>
          </div>
        <% }); %>
        <%# Der Erklärsatz von fb-init — der Teil, für den die Messung gebaut
            wurde: „Port 2457 lauscht nach 60 s noch nicht, der Prozess läuft
            aber. Bei einer neuen Welt ist das normal." %>
        <div style="font-size:13px;margin-top:8px;text-wrap:pretty<%= u.bereitschaft.grund ? '' : ';display:none' %>"
             data-fb-live="bereitschaft-grund" data-fb-server="<%= server.id %>"><%= u.bereitschaft.grund || '' %></div>
        <div class="fb-muted" style="font-size:13px;margin-top:8px">
          <% if (u.bereitschaft.veraltet) { %>
            Der Server ist aus — die letzte gemeldete Stufe sagt nichts über jetzt.
          <% } else if (!u.bereitschaft.gemessen) { %>
            Der Server hat noch keine Stufe gemeldet<%= u.bereitschaft.frist ? ' (Frist ' + u.bereitschaft.frist + ' s)' : '' %>.
          <% } else { %>
            Gemeldet von fb-init auf der Maschine<%= u.bereitschaft.frist ? ', Frist ' + u.bereitschaft.frist + ' s' : '' %>.
          <% } %>
        </div>
      </div>
    </div>
  <% } %>

  <%# ── Welt ───────────────────────────────────────────────────────────────

      Die letzten fuenf Sicherungen, nicht nur die letzte (Wunsch des
      Betreibers, 2026-09-07). Der Knopf bleibt - er fuehrt zum Anlegen,
      Zurueckspielen und Loeschen; die Karte zeigt nur, ob es etwas gibt.
  %>
  <div class="fb-karte">
    <div class="fb-kopf"><span>Welt</span></div>
    <div class="fb-koerper">
      <% if (!u.welt.liste || !u.welt.liste.length) { %>
        <div class="fb-muted" style="font-size:13px;margin-bottom:10px">
          Noch keine Sicherung vorhanden.
        </div>
      <% } else { %>
        <div class="fb-muted" style="font-size:13px;margin-bottom:8px">
          Zuletzt gesichert <%= u.welt.text %>
        </div>
        <% u.welt.liste.forEach(function (b, i) { %>
          <div style="display:flex;gap:10px;padding:5px 0;align-items:baseline;<%=
                i ? 'border-top:1px solid var(--fb-border)' : '' %>">
            <div class="fb-muted" style="flex:0 0 108px;font-size:12px"><%= b.text %></div>
            <div style="flex:1 1 auto;font-size:12px;word-break:break-all"><%= b.name || '—' %></div>
            <% if (b.groesse) { %>
              <div class="fb-mono fb-muted" style="font-size:12px"><%= b.groesse %></div>
            <% } %>
          </div>
        <% }); %>
        <div style="margin-top:10px"></div>
      <% } %>
      <a class="btn btn-white btn-sm" href="?ansicht=<%= u.hoehe %>&bereich=sicherungen">Sicherungen…</a>
    </div>
  </div>

  <%# ── Ports (fachlich) ─────────────────────────────────────────────────── %>
  <% if (u.hoehe === 'fachlich' && u.ports.length) { %>
    <div class="fb-karte">
      <div class="fb-kopf"><span>Ports</span></div>
      <div class="fb-koerper">
        <% u.ports.forEach(function (p) { %>
          <div style="display:flex;gap:10px;padding:8px 0;align-items:baseline">
            <div style="flex:1 1 auto"><%= p.zweck %></div>
            <div class="fb-mono"><%= p.nummer !== null ? p.nummer : '—' %></div>
            <% if (p.protokoll) { %><span class="fb-muted" style="font-size:12px"><%= p.protokoll %></span><% } %>
          </div>
          <% if (p.regel) { %>
            <div class="fb-muted fb-mono" style="font-size:12px;margin:-4px 0 4px">assign: <%= p.regel %></div>
          <% } %>
          <% if (p.bedarf) { %>
            <div class="fb-muted" style="font-size:12px;margin:-4px 0 4px">
              <% if (p.nummer !== null) { %>vergeben, weil <span class="fb-mono"><%= p.bedarf %></span> vorhanden ist<% } else { %>wird beim Start vergeben, sobald <span class="fb-mono"><%= p.bedarf %></span> vorhanden ist<% } %>
            </div>
          <% } %>
        <% }); %>
      </div>
    </div>
  <% } %>

  <%# ── Paket und Image (fachlich) ───────────────────────────────────────── %>
  <% if (u.hoehe === 'fachlich' && u.paket) { %>
    <div class="fb-karte">
      <div class="fb-kopf"><span>Paket und Image</span></div>
      <div class="fb-koerper" style="font-size:13px">
        <%# Der Kanal, dem der SERVER folgt — in der Guild des Betreibers umstellbar.
            Daneben, ob die Fassung, die er gerade bekommt, freigegeben ist. %>
        <% if (u.kanal) { %>
          <div style="display:flex;gap:10px;padding:5px 0;align-items:center">
            <div class="fb-muted" style="flex:0 0 74px">Kanal</div>
            <% if (u.kanal.waehlbar) { %>
              <select class="form-select form-select-sm" style="width:auto" data-fb-kanal-wahl
                      title="stable: die neueste freigegebene Fassung · test: die neueste überhaupt">
                <option value="stable" <%= u.kanal.kanal === 'stable' ? 'selected' : '' %>>stable — freigegebene Fassung</option>
                <option value="test" <%= u.kanal.kanal === 'test' ? 'selected' : '' %>>test — neueste Fassung</option>
              </select>
            <% } else { %>
              <div class="fb-mono"><%= u.kanal.kanal %></div>
            <% } %>
            <span class="fb-muted" style="font-size:12px" data-fb-kanal-meldung></span>
          </div>
        <% } %>
        <% [['Paket', (u.paket.slug || '') + ' ' + (u.paket.version || '')],
            ['Fassung', u.paket.kanal === 'stable' ? 'freigegeben' : (u.paket.kanal === 'test' ? 'Testfassung, nicht freigegeben' : null)],
            ['Image', u.paket.image],
            ['Digest', u.paket.digest],
            ['Quelle', u.paket.quelle]].forEach(function (z) { %>
          <% if (z[1]) { %>
            <div style="display:flex;gap:10px;padding:5px 0">
              <div class="fb-muted" style="flex:0 0 74px"><%= z[0] %></div>
              <div class="fb-mono" style="word-break:break-all"><%= z[1] %></div>
            </div>
          <% } %>
        <% }); %>
        <% if (u.paket.welten) { %>
          <div style="display:flex;gap:10px;padding:5px 0">
            <div class="fb-muted" style="flex:0 0 74px">Welten</div>
            <div class="fb-mono" style="word-break:break-all"><%= u.paket.welten.join(', ') %></div>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>

  </div>
  </div>

</div>

<script>
/* Hinweise des Pakets: zugeklappt merkt sich der Browser je Server — bis sich
 * an den Hinweisen etwas aendert. Ohne Speicher (privates Fenster) bleibt die
 * Karte einfach offen. */
(function () {
  var karte = document.querySelector('[data-fb-hinweise]');
  if (!karte) return;
  var knopf = karte.querySelector('[data-fb-hinweise-knopf]');
  var name = 'fb-hinweise:' + karte.dataset.fbHinweise;
  var stand = karte.dataset.fbStand || '';
  function beschrifte() { if (knopf) knopf.textContent = karte.open ? 'Zuklappen' : 'Aufklappen'; }
  try { if (window.localStorage.getItem(name) === stand) karte.open = false; } catch (e) { /* kein Speicher */ }
  beschrifte();
  karte.addEventListener('toggle', function () {
    beschrifte();
    try {
      if (karte.open) window.localStorage.removeItem(name);
      else window.localStorage.setItem(name, stand);
    } catch (e) { /* kein Speicher */ }
  });
})();
</script>

<script>
/*
 * Die Einstellungskarte — Entwurf vom 2026-08-18, Artboard 4.
 *
 * Gespeichert wird ueber PUT /servers/:id/variables, den es laengst gibt. Kein
 * zweiter Weg: Zwei Wege, die dasselbe Feld schreiben, driften auseinander, und
 * der zweite faellt beim ersten Umbau hinten runter.
 *
 * Die Karte kennt die FOLGE jeder Aenderung, weil das Paket sie nennt
 * (`takes_effect`). Der Zaehler sagt sie an, bevor gespeichert wird — nicht
 * danach. Und bei `risk` wird nachgefragt: Ein Weltname ist ein Wort wie jedes
 * andere, bis man versteht, dass ein neues Wort eine neue, leere Welt erzeugt.
 */
(function () {
  var karte = document.getElementById('fb-fuss');
  if (!karte) return;

  var wirkung = <%- JSON.stringify(
      (u.einstellungen.sichtbar || []).reduce(function (a, e) {
        if (e.variable) a[e.variable] = { name: e.name, wirkt: e.wirktBei, risiko: e.risiko };
        return a; }, {})) %>;

  var geaendert = {};

  function folge() {
    var n = Object.keys(geaendert).length;
    if (n === 0) return null;
    var welt = false, neustart = false;
    Object.keys(geaendert).forEach(function (k) {
      var w = wirkung[k] || {};
      if (w.wirkt === 'new_world') welt = true;
      else if (w.wirkt === 'restart') neustart = true;
    });
    return (n === 1 ? '1 Änderung' : n + ' Änderungen') +
      (welt ? ' — erzeugt eine neue Welt' : neustart ? ' — braucht einen Neustart' : ' — wirkt sofort');
  }

  function zeigen() {
    var t = folge();
    karte.hidden = !t;
    if (t) document.getElementById('fb-fuss-text').textContent = t;
  }

  function merken(feld, wert, alt) {
    if (String(wert) === String(alt)) delete geaendert[feld];
    else geaendert[feld] = String(wert);
    zeigen();
  }

  document.querySelectorAll('.fb-wahl').forEach(function (b) {
    var gruppe = b.getAttribute('data-fb-feld');
    if (!b.hasAttribute('data-fb-alt')) {
      b.setAttribute('data-fb-alt', b.classList.contains('an') ? b.getAttribute('data-fb-wert') : '');
    }
    b.addEventListener('click', function () {
      document.querySelectorAll('.fb-wahl[data-fb-feld="' + gruppe + '"]').forEach(function (x) {
        x.classList.remove('an');
      });
      b.classList.add('an');
      var ursprung = '';
      document.querySelectorAll('.fb-wahl[data-fb-feld="' + gruppe + '"]').forEach(function (x) {
        if (x.getAttribute('data-fb-alt')) ursprung = x.getAttribute('data-fb-alt');
      });
      merken(gruppe, b.getAttribute('data-fb-wert'), ursprung);
    });
  });

  document.querySelectorAll('input[data-fb-feld]').forEach(function (i) {
    i.addEventListener('input', function () {
      merken(i.getAttribute('data-fb-feld'), i.value, i.getAttribute('data-fb-alt'));
    });
  });

  document.getElementById('fb-verwerfen').addEventListener('click', function () {
    location.reload();
  });

  document.getElementById('fb-speichern').addEventListener('click', function () {
    var riskant = Object.keys(geaendert).filter(function (k) { return (wirkung[k] || {}).risiko; });
    if (riskant.length) {
      var t = riskant.map(function (k) { return '• ' + wirkung[k].name + ': ' + wirkung[k].risiko; }).join('\n');
      if (!confirm('Das hat Folgen:\n\n' + t + '\n\nWirklich speichern?')) return;
    }
    var knopf = this; knopf.disabled = true; knopf.textContent = 'Speichert…';
    fetch(location.pathname.replace(/\/$/, '') + '/variables', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(geaendert),
    }).then(function (r) { return r.json(); }).then(function (a) {
      if (a && a.success) { location.reload(); }
      else { knopf.disabled = false; knopf.textContent = 'Speichern';
             alert('Nicht gespeichert: ' + ((a && a.message) || 'unbekannter Grund')); }
    }).catch(function (e) {
      knopf.disabled = false; knopf.textContent = 'Speichern';
      alert('Nicht gespeichert: ' + e.message);
    });
  });
})();

/* Kanal des Servers umstellen (Baustelle 172). Danach neu laden: Mit dem Kanal
 * wechselt die Paketfassung, und von ihr haengt fast alles auf dieser Seite ab. */
(function () {
  var pfad = location.pathname.replace(/\/$/, '') + '/kanal';
  function sage(text, fehler) {
    var m = document.querySelector('[data-fb-kanal-meldung]');
    if (window.showToast) window.showToast(fehler ? 'error' : 'success', text);
    if (m) { m.textContent = text; m.style.color = fehler ? 'var(--fb-danger)' : ''; }
  }
  function setze(kanal, zurueck) {
    fetch(pfad, {
      method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ kanal: kanal }),
    }).then(function (r) { return r.json(); }).then(function (a) {
      if (a && a.success) { sage(a.message, false); setTimeout(function () { location.reload(); }, 1200); }
      else { if (zurueck) zurueck(); sage((a && a.message) || 'Nicht umgestellt', true); }
    }).catch(function (e) { if (zurueck) zurueck(); sage('Nicht umgestellt: ' + e.message, true); });
  }
  var wahl = document.querySelector('[data-fb-kanal-wahl]');
  if (wahl) {
    var vorher = wahl.value;
    wahl.addEventListener('change', function () {
      wahl.disabled = true;
      setze(wahl.value, function () { wahl.value = vorher; wahl.disabled = false; });
    });
  }
  document.querySelectorAll('[data-fb-kanal-setzen]').forEach(function (b) {
    b.addEventListener('click', function () {
      b.disabled = true;
      setze(b.getAttribute('data-fb-kanal-setzen'), function () { b.disabled = false; });
    });
  });
})();

document.querySelectorAll('[data-fb-kopieren]').forEach(function (b) {
    b.addEventListener('click', function () {
        navigator.clipboard.writeText(b.getAttribute('data-fb-kopieren')).then(function () {
            var alt = b.textContent; b.textContent = 'Kopiert';
            setTimeout(function () { b.textContent = alt; }, 1500);
        });
    });
});
</script>
<% } %>
