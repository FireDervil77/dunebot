<%#
 * Cronjob-Tab Partial
 * Geplante Aufgaben (Start, Stop, Restart, Backup, Command) mit Cron-Expressions
 * @author FireBot Team
%>

<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-clock me-2"></i>Geplante Aufgaben (Cronjobs)</h5>
        <div>
            <button class="btn btn-secondary btn-sm me-2" onclick="loadCronjobs()">
                <i class="fas fa-sync-alt me-1"></i> Aktualisieren
            </button>
            <% if (userPermissions.permissions['GAMESERVER.CRONJOBS.MANAGE']) { %>
                <button class="btn btn-primary btn-sm" onclick="openCronjobModal()">
                    <i class="fas fa-plus me-1"></i> Neuer Cronjob
                </button>
            <% } %>
        </div>
    </div>
</div>

<%#
  Die Erklaerung der Cron-Syntax stand hier als Dauer-Infobox. Seit es den
  Baukasten gibt, muss sie niemand mehr lesen — und wer sie doch braucht,
  findet sie beim Expertenfeld im Fenster.
%>

<% if (userPermissions.permissions['GAMESERVER.CRONJOBS.MANAGE']) { %>
<!-- Cronjob Modal (Erstellen / Bearbeiten) -->
<div class="modal fade" id="cronjobModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cronjobModalTitle"><i class="fas fa-clock me-2"></i>Cronjob erstellen</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="cronjobEditId" value="">

                <div class="mb-3">
                    <label for="cronjobName">Name <span class="text-danger">*</span></label>
                    <input type="text" id="cronjobName" class="form-control" placeholder="z.B. Nächtlicher Neustart" maxlength="128" required>
                </div>

                <%#
                  Baukasten statt Cron-Syntax. Der Wunsch war ausdruecklich, dass
                  auch Leute ohne Erfahrung damit einen Job anlegen koennen — ein
                  Auswahlfeld mit Vorlagen reicht dafuer nicht, sobald jemand
                  "taeglich um 3:30" will und die Vorlage nur 4:00 kennt.
                  Der nackte Ausdruck steht weiter zur Verfuegung, aber eingeklappt.
                %>
                <div class="mb-3">
                    <label for="cronjobTakt">Wie oft? <span class="text-danger">*</span></label>
                    <select id="cronjobTakt" class="form-control" onchange="taktGewechselt()">
                        <option value="taeglich">Täglich</option>
                        <option value="woechentlich">Wöchentlich</option>
                        <option value="monatlich">Monatlich</option>
                        <option value="stuendlich">Stündlich</option>
                        <option value="minuten">Alle paar Minuten</option>
                    </select>
                </div>

                <div class="row">
                    <div class="col-6 mb-3" id="feldWochentag" style="display:none;">
                        <label for="cronjobWochentag">Wochentag</label>
                        <select id="cronjobWochentag" class="form-control" onchange="planGeaendert()">
                            <option value="1">Montag</option>
                            <option value="2">Dienstag</option>
                            <option value="3">Mittwoch</option>
                            <option value="4">Donnerstag</option>
                            <option value="5">Freitag</option>
                            <option value="6">Samstag</option>
                            <option value="0">Sonntag</option>
                        </select>
                    </div>

                    <div class="col-6 mb-3" id="feldTag" style="display:none;">
                        <label for="cronjobTag">Tag im Monat</label>
                        <input type="number" id="cronjobTag" class="form-control" min="1" max="28" value="1"
                               oninput="planGeaendert()">
                        <small class="form-text text-secondary">Höchstens der 28. — sonst fällt der Lauf in kurzen Monaten aus.</small>
                    </div>

                    <div class="col-6 mb-3" id="feldUhrzeit">
                        <label for="cronjobUhrzeit">Uhrzeit</label>
                        <input type="time" id="cronjobUhrzeit" class="form-control" value="04:00"
                               oninput="planGeaendert()">
                    </div>

                    <div class="col-6 mb-3" id="feldMinute" style="display:none;">
                        <label for="cronjobMinute">Zur Minute</label>
                        <input type="number" id="cronjobMinute" class="form-control" min="0" max="59" value="0"
                               oninput="planGeaendert()">
                    </div>

                    <div class="col-6 mb-3" id="feldIntervall" style="display:none;">
                        <label for="cronjobIntervall">Alle … Minuten</label>
                        <input type="number" id="cronjobIntervall" class="form-control" min="5" max="59" value="30"
                               oninput="planGeaendert()">
                        <small class="form-text text-secondary">Mindestens 5 — häufiger läuft der Job in sich selbst hinein.</small>
                    </div>
                </div>

                <div class="alert alert-info py-2 mb-3" id="cronjobVorschau">
                    <i class="fas fa-calendar-check me-1"></i>
                    <span id="cronjobVorschauText">Läuft täglich um 04:00 Uhr.</span>
                </div>

                <div class="mb-3">
                    <a class="text-secondary small" data-bs-toggle="collapse" href="#cronjobExpertenfeld" role="button">
                        <i class="fas fa-code me-1"></i> Cron-Ausdruck selbst schreiben
                    </a>
                    <div class="collapse mt-2" id="cronjobExpertenfeld">
                        <input type="text" id="cronjobExpr" class="form-control" placeholder="0 4 * * *" maxlength="64"
                               oninput="ausdruckGeaendert()">
                        <small class="form-text" id="cronjobExprDesc">
                            Reihenfolge: Minute Stunde Tag Monat Wochentag.
                        </small>
                    </div>
                </div>

                <!-- Aufbewahrung: nur für Backup-Jobs sinnvoll (Baustellen 7.1) -->
                <div id="cronjobAufbewahrungGroup" style="display:none;">
                    <div class="alert alert-secondary py-2 mb-3">
                        <i class="fas fa-hdd me-1"></i>
                        Die Aufbewahrung steht in den <strong>Servereinstellungen</strong> und gilt
                        für alle automatischen Backups. Hier nur ausfüllen, wenn dieser eine Job
                        davon abweichen soll — <strong>leer heißt: Servereinstellung</strong>,
                        <strong>0 heißt ausdrücklich unbegrenzt</strong>.
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label for="cronjobKeep">Anzahl behalten</label>
                            <input type="number" id="cronjobKeep" class="form-control" min="0" max="65535" placeholder="Servereinstellung">
                            <small class="form-text text-secondary">Nur die neuesten so vielen bleiben.</small>
                        </div>
                        <div class="col-6 mb-3">
                            <label for="cronjobKeepDays">Höchstalter (Tage)</label>
                            <input type="number" id="cronjobKeepDays" class="form-control" min="0" max="65535" placeholder="Servereinstellung">
                            <small class="form-text text-secondary">Das jüngste Backup bleibt immer.</small>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="cronjobAction">Aktion <span class="text-danger">*</span></label>
                    <select id="cronjobAction" class="form-control" onchange="toggleCommandField()">
                        <option value="restart">Server neu starten</option>
                        <option value="start">Server starten</option>
                        <option value="stop">Server stoppen</option>
                        <option value="backup">Backup erstellen</option>
                        <option value="command">Konsolen-Befehl ausführen</option>
                    </select>
                </div>

                <div class="mb-3" id="cronjobCommandGroup" style="display:none;">
                    <label for="cronjobCommand">Befehl <span class="text-danger">*</span></label>
                    <input type="text" id="cronjobCommand" class="form-control" placeholder="say Server startet in 5 Minuten neu" maxlength="500">
                    <small class="form-text text-secondary">Wird direkt an die Konsole des Gameservers gesendet.</small>
                </div>

                <div class="form-check form-switch mt-2">
                    <input type="checkbox" class="form-check-input" id="cronjobRunOnce">
                    <label class="form-check-label" for="cronjobRunOnce">Einmalig ausführen</label>
                    <small class="form-text text-secondary">Job wird nach der ersten Ausführung automatisch deaktiviert.</small>
                </div>

                <div class="form-check form-switch mt-2" id="cronjobEnabledGroup">
                    <input type="checkbox" class="form-check-input" id="cronjobEnabled" checked>
                    <label class="form-check-label" for="cronjobEnabled">Cronjob aktiv</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Abbrechen</button>
                <button type="button" class="btn btn-primary" id="cronjobSaveBtn" onclick="saveCronjob()">
                    <i class="fas fa-save me-1"></i> Speichern
                </button>
            </div>
        </div>
    </div>
</div>
<% } %>

<!-- Cronjob-Tabelle -->
<div id="cronjobs-container">
    <div id="cronjobs-loading" class="text-center text-secondary py-5">
        <i class="fas fa-spinner fa-spin fa-2x mb-2"></i>
        <p>Cronjobs werden geladen...</p>
    </div>
    <div id="cronjobs-empty" class="text-center text-secondary py-5" style="display:none;">
        <i class="fas fa-clock fa-3x mb-3 text-secondary"></i>
        <p>Keine Cronjobs konfiguriert.</p>
        <% if (userPermissions.permissions['GAMESERVER.CRONJOBS.MANAGE']) { %>
            <button class="btn btn-primary" onclick="openCronjobModal()">
                <i class="fas fa-plus me-1"></i> Ersten Cronjob erstellen
            </button>
        <% } %>
    </div>
    <div id="cronjobs-table-wrapper" style="display:none;">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Cron-Expression</th>
                        <th>Aktion</th>
                        <th>Letzter Lauf</th>
                        <th>Status</th>
                        <th>Einmalig</th>
                        <th>Aktiv</th>
                        <% if (userPermissions.permissions['GAMESERVER.CRONJOBS.MANAGE']) { %>
                            <th>Aktionen</th>
                        <% } %>
                    </tr>
                </thead>
                <tbody id="cronjobs-tbody"></tbody>
            </table>
        </div>
    </div>
</div>

<script src="/assets/plugins/gameserver/js/cronPlan.js"></script>
<script>
/**
 * Ein Fenster ansprechen — Bootstrap-5-Schnittstelle.
 * jQuery ist unter Tabler geladen, dessen Fenster-Methode aber nicht: Der
 * Aufruf warf, und alles danach im selben Block lief nicht mehr.
 */
// fenster() kommt aus guild.js — dort ist es die einzige Definition im Projekt.
// Eine Kopie an dieser Stelle ueberschrieb sie je nach Ladereihenfolge.

(function() {
    const GUILD_ID  = '<%= guildId %>';
    const SERVER_ID = '<%= server.id %>';
    const BASE_URL  = `/guild/${GUILD_ID}/plugins/gameserver/servers/${SERVER_ID}/cronjobs`;
    const CAN_MANAGE = <%= userPermissions.permissions['GAMESERVER.CRONJOBS.MANAGE'] ? 'true' : 'false' %>;

    const ACTION_LABELS = {
        start:   '<span class="badge bg-success-lt"><i class="fas fa-play me-1"></i>Start</span>',
        stop:    '<span class="badge bg-secondary-lt"><i class="fas fa-stop me-1"></i>Stop</span>',
        restart: '<span class="badge bg-warning-lt"><i class="fas fa-redo me-1"></i>Neustart</span>',
        backup:  '<span class="badge bg-info-lt"><i class="fas fa-save me-1"></i>Backup</span>',
        command: '<span class="badge bg-dark-lt"><i class="fas fa-terminal me-1"></i>Befehl</span>',
    };

    const STATUS_LABELS = {
        pending: '<span class="badge bg-secondary-lt">Ausstehend</span>',
        success: '<span class="badge bg-success-lt"><i class="fas fa-check me-1"></i>Erfolg</span>',
        failed:  '<span class="badge bg-danger-lt"><i class="fas fa-times me-1"></i>Fehler</span>',
        // "Übersprungen" ist kein Fehler: der Job hat bewusst nichts getan,
        // weil der Server gestoppt oder der Daemon offline war. Vorher stand
        // dort ein rotes "Fehler", obwohl nichts kaputt war.
        skipped: '<span class="badge bg-warning-lt"><i class="fas fa-forward me-1"></i>Übersprungen</span>',
    };

    // Dieselbe Rechnung wie im CronWorker — die Datei liegt bei den Assets und
    // wird von beiden Seiten benutzt. Zwei Fassungen waeren zwei Wahrheiten.
    const Plan = window.CronPlan;

    const cronAlsText = (a) => Plan.beschreibe(a);

    const el = (id) => document.getElementById(id);

    /** Liest den Baukasten aus. */
    function planAusFeldern() {
        const takt = el('cronjobTakt').value;
        const [stunde, minute] = (el('cronjobUhrzeit').value || '04:00').split(':').map(Number);
        return {
            takt,
            stunde,
            minute: takt === 'stuendlich' ? Number(el('cronjobMinute').value) : minute,
            wochentag: Number(el('cronjobWochentag').value),
            tag: Number(el('cronjobTag').value),
            intervall: Number(el('cronjobIntervall').value),
        };
    }

    /** Zeigt nur die Felder, die der gewählte Takt braucht. */
    window.taktGewechselt = function() {
        const takt = el('cronjobTakt').value;
        el('feldWochentag').style.display = takt === 'woechentlich' ? '' : 'none';
        el('feldTag').style.display       = takt === 'monatlich'    ? '' : 'none';
        el('feldUhrzeit').style.display   = ['taeglich','woechentlich','monatlich'].includes(takt) ? '' : 'none';
        el('feldMinute').style.display    = takt === 'stuendlich'   ? '' : 'none';
        el('feldIntervall').style.display = takt === 'minuten'      ? '' : 'none';
        planGeaendert();
    };

    /** Baukasten → Ausdruck → Vorschau. */
    window.planGeaendert = function() {
        const ausdruck = Plan.baue(planAusFeldern());
        el('cronjobExpr').value = ausdruck;
        vorschauZeigen(ausdruck);
    };

    /**
     * Ausdruck → Baukasten. Wer selbst schreibt, soll die Felder mitwandern
     * sehen; passt die Form nicht in den Baukasten, bleibt der Ausdruck
     * trotzdem gültig und die Vorschau sagt das.
     */
    window.ausdruckGeaendert = function() {
        const ausdruck = el('cronjobExpr').value.trim();
        const plan = Plan.lies(ausdruck);
        if (plan) planInFelder(plan);
        vorschauZeigen(ausdruck);
    };

    function planInFelder(plan) {
        el('cronjobTakt').value = plan.takt;
        if (plan.takt === 'minuten')    el('cronjobIntervall').value = plan.intervall;
        if (plan.takt === 'stuendlich') el('cronjobMinute').value    = plan.minute;
        if (plan.stunde !== undefined) {
            el('cronjobUhrzeit').value =
                `${String(plan.stunde).padStart(2,'0')}:${String(plan.minute).padStart(2,'0')}`;
        }
        if (plan.takt === 'woechentlich') el('cronjobWochentag').value = String(plan.wochentag);
        if (plan.takt === 'monatlich')    el('cronjobTag').value       = plan.tag;

        const takt = plan.takt;
        el('feldWochentag').style.display = takt === 'woechentlich' ? '' : 'none';
        el('feldTag').style.display       = takt === 'monatlich'    ? '' : 'none';
        el('feldUhrzeit').style.display   = ['taeglich','woechentlich','monatlich'].includes(takt) ? '' : 'none';
        el('feldMinute').style.display    = takt === 'stuendlich'   ? '' : 'none';
        el('feldIntervall').style.display = takt === 'minuten'      ? '' : 'none';
    }

    function vorschauZeigen(ausdruck) {
        const kasten = el('cronjobVorschau');
        const text   = el('cronjobVorschauText');
        const felder = ausdruck.trim().split(/\s+/).length;

        if (!ausdruck.trim() || felder !== 5) {
            kasten.className = 'alert alert-danger py-2 mb-3';
            text.textContent = `${felder} Felder statt 5 — Reihenfolge: Minute Stunde Tag Monat Wochentag.`;
            return;
        }
        const satz = Plan.beschreibe(ausdruck);
        kasten.className = 'alert alert-info py-2 mb-3';
        text.textContent = satz
            ? `Läuft ${satz}.`
            : `Läuft nach dem Ausdruck ${ausdruck} — diese Form kann ich nicht in Worte fassen.`;
    }

    /** Aufbewahrungsfelder nur bei Backup-Jobs zeigen. */
    function aufbewahrungUmschalten() {
        const action = document.getElementById('cronjobAction').value;
        document.getElementById('cronjobAufbewahrungGroup').style.display =
            action === 'backup' ? '' : 'none';
    }

    function escHtml(s) {
        if (!s) return '';
        return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function fmtDate(d) {
        if (!d) return '—';
        return new Date(d).toLocaleString('de-DE', { dateStyle: 'short', timeStyle: 'short' });
    }

    window.toggleCommandField = function() {
        const action = document.getElementById('cronjobAction').value;
        document.getElementById('cronjobCommandGroup').style.display = action === 'command' ? '' : 'none';
        aufbewahrungUmschalten();
    };

    window.loadCronjobs = async function() {
        document.getElementById('cronjobs-loading').style.display = '';
        document.getElementById('cronjobs-empty').style.display = 'none';
        document.getElementById('cronjobs-table-wrapper').style.display = 'none';

        try {
            const resp = await fetch(BASE_URL);
            const data = await resp.json();
            if (!data.success) throw new Error(data.message);

            const jobs = data.cronjobs || [];
            document.getElementById('cronjobs-loading').style.display = 'none';

            if (jobs.length === 0) {
                document.getElementById('cronjobs-empty').style.display = '';
                return;
            }

            const tbody = document.getElementById('cronjobs-tbody');
            tbody.innerHTML = jobs.map(j => `
                <tr data-job-id="${j.id}">
                    <td>
                        <strong>${escHtml(j.name)}</strong>
                        ${j.action === 'command' ? `<br><small class="text-secondary"><code>${escHtml(j.command)}</code></small>` : ''}
                    </td>
                    <td>
                        <code>${escHtml(j.cron_expr)}</code>
                        ${cronAlsText(j.cron_expr) ? `<br><small class="text-secondary">${escHtml(cronAlsText(j.cron_expr))}</small>` : ''}
                        ${j.action === 'backup' ? `<br><small class="text-secondary"><i class="fas fa-hdd me-1"></i>${(j.backup_keep === null && j.backup_keep_days === null) ? 'Aufbewahrung wie im Server' : `abweichend: behält ${j.backup_keep ?? '∞'}${j.backup_keep_days ? `, max. ${j.backup_keep_days} Tage` : ''}`}</small>` : ''}
                    </td>
                    <td>${ACTION_LABELS[j.action] || j.action}</td>
                    <td><small>${fmtDate(j.last_run_at)}</small></td>
                    <td>
                        ${STATUS_LABELS[j.last_status] || j.last_status}
                        ${j.last_message ? `<br><small class="text-secondary">${escHtml(j.last_message)}</small>` : ''}
                    </td>
                    <td>${j.run_once ? '<span class="badge bg-info-lt" title="Wird nach Ausführung deaktiviert"><i class="fas fa-bolt me-1"></i>Einmalig</span>' : '—'}</td>
                    <td>
                        ${CAN_MANAGE ? `
                        <div class="form-check form-switch">
                            <input type="checkbox" class="form-check-input" id="jobEnabled_${j.id}"
                                   ${j.enabled ? 'checked' : ''}
                                   onchange="toggleCronjob(${j.id}, this.checked)">
                            <label class="form-check-label" for="jobEnabled_${j.id}"></label>
                        </div>` : (j.enabled
                            ? '<span class="badge bg-success-lt">Ja</span>'
                            : '<span class="badge bg-secondary-lt">Nein</span>')}
                    </td>
                    ${CAN_MANAGE ? `
                    <td>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-secondary btn-sm" onclick='editCronjob(${JSON.stringify(j)})' title="Bearbeiten">
                                <i class="fas fa-pencil-alt"></i>
                            </button>
                            <button class="btn btn-danger btn-sm" onclick="deleteCronjob(${j.id}, '${escHtml(j.name)}')" title="Löschen">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>` : ''}
                </tr>
            `).join('');

            document.getElementById('cronjobs-table-wrapper').style.display = '';
        } catch (err) {
            document.getElementById('cronjobs-loading').innerHTML =
                `<div class="text-center text-danger py-4"><i class="fas fa-exclamation-triangle me-1"></i> Fehler: ${escHtml(err.message)}</div>`;
        }
    };

    window.openCronjobModal = function() {
        if (!CAN_MANAGE) return;
        document.getElementById('cronjobEditId').value = '';
        document.getElementById('cronjobModalTitle').textContent = 'Cronjob erstellen';
        document.getElementById('cronjobName').value = '';
        document.getElementById('cronjobExpr').value = '';
        document.getElementById('cronjobAction').value = 'restart';
        document.getElementById('cronjobCommand').value = '';
        document.getElementById('cronjobRunOnce').checked = false;
        document.getElementById('cronjobEnabled').checked = true;
        // Baukasten auf die haeufigste Wahl stellen: taeglich um 4 Uhr.
        document.getElementById('cronjobTakt').value = 'taeglich';
        document.getElementById('cronjobUhrzeit').value = '04:00';
        document.getElementById('cronjobWochentag').value = '1';
        document.getElementById('cronjobTag').value = 1;
        document.getElementById('cronjobMinute').value = 0;
        document.getElementById('cronjobIntervall').value = 30;
        // Leer = erbt die Servereinstellung. Das ist die richtige Vorgabe,
        // seit die Aufbewahrung am Server haengt.
        document.getElementById('cronjobKeep').value = '';
        document.getElementById('cronjobKeepDays').value = '';
        toggleCommandField();
        taktGewechselt();
        fenster('cronjobModal')?.show();
    };

    window.editCronjob = function(job) {
        if (!CAN_MANAGE) return;
        document.getElementById('cronjobEditId').value = job.id;
        document.getElementById('cronjobModalTitle').textContent = 'Cronjob bearbeiten';
        document.getElementById('cronjobName').value = job.name || '';
        document.getElementById('cronjobExpr').value = job.cron_expr || '';
        document.getElementById('cronjobAction').value = job.action || 'restart';
        document.getElementById('cronjobCommand').value = job.command || '';
        document.getElementById('cronjobRunOnce').checked = !!job.run_once;
        document.getElementById('cronjobEnabled').checked = !!job.enabled;
        document.getElementById('cronjobKeep').value = job.backup_keep ?? '';
        document.getElementById('cronjobKeepDays').value = job.backup_keep_days ?? '';
        toggleCommandField();
        ausdruckGeaendert();
        fenster('cronjobModal')?.show();
    };

    window.saveCronjob = async function() {
        const btn = document.getElementById('cronjobSaveBtn');
        const editId = document.getElementById('cronjobEditId').value;
        const name = document.getElementById('cronjobName').value.trim();
        const cron_expr = document.getElementById('cronjobExpr').value.trim();
        const action = document.getElementById('cronjobAction').value;
        const command = document.getElementById('cronjobCommand').value.trim();
        const run_once = document.getElementById('cronjobRunOnce').checked;
        const enabled = document.getElementById('cronjobEnabled').checked;
        // Leeres Feld heisst "erbt vom Server" (null), nicht "unbegrenzt" (0).
        const grenzeAusFeld = (id) => {
            const roh = document.getElementById(id).value.trim();
            if (roh === '') return null;
            const n = parseInt(roh, 10);
            return Number.isFinite(n) && n >= 0 ? n : null;
        };
        const backup_keep = action === 'backup' ? grenzeAusFeld('cronjobKeep') : null;
        const backup_keep_days = action === 'backup' ? grenzeAusFeld('cronjobKeepDays') : null;

        if (!name || !cron_expr || !action) {
            alert('Bitte Name, Cron-Expression und Aktion ausfüllen.');
            return;
        }
        if (cron_expr.split(/\s+/).length !== 5) {
            alert('Cron-Expression muss genau 5 Felder haben (z.B. "0 4 * * *")');
            return;
        }
        if (action === 'command' && !command) {
            alert('Bitte einen Befehl angeben.');
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Speichere...';

        try {
            const url  = editId ? `${BASE_URL}/${editId}` : BASE_URL;
            const method = editId ? 'PUT' : 'POST';
            const resp = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, cron_expr, action, command, run_once, enabled, backup_keep, backup_keep_days })
            });
            const data = await resp.json();
            fenster('cronjobModal')?.hide();
            if (data.success) {
                if (typeof showToast === 'function') showToast('success', editId ? 'Cronjob aktualisiert' : 'Cronjob erstellt');
                loadCronjobs();
            } else {
                if (typeof showToast === 'function') showToast('error', data.message || 'Fehler');
            }
        } catch (err) {
            if (typeof showToast === 'function') showToast('error', 'Netzwerkfehler');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-save me-1"></i> Speichern';
        }
    };

    window.toggleCronjob = async function(jobId, enabled) {
        try {
            const resp = await fetch(`${BASE_URL}/${jobId}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ enabled })
            });
            const data = await resp.json();
            if (!data.success) {
                if (typeof showToast === 'function') showToast('error', data.message || 'Fehler');
                loadCronjobs();
            }
        } catch (err) {
            if (typeof showToast === 'function') showToast('error', 'Netzwerkfehler');
        }
    };

    window.deleteCronjob = async function(jobId, jobName) {
        if (!confirm(`Cronjob "${jobName}" wirklich löschen?`)) return;
        try {
            const resp = await fetch(`${BASE_URL}/${jobId}`, { method: 'DELETE' });
            const data = await resp.json();
            if (data.success) {
                if (typeof showToast === 'function') showToast('success', 'Cronjob gelöscht');
                loadCronjobs();
            } else {
                if (typeof showToast === 'function') showToast('error', data.message || 'Fehler');
            }
        } catch (err) {
            if (typeof showToast === 'function') showToast('error', 'Netzwerkfehler');
        }
    };

    // Beim Tab-Aktivieren automatisch laden
    const cronjobsTabLink = document.getElementById('cronjobs-tab') ||
                             document.querySelector('a[href="#cronjobs"]');
    if (cronjobsTabLink) cronjobsTabLink.addEventListener('shown.bs.tab', loadCronjobs);

    // Initiales Laden wenn Tab bereits aktiv
    if (document.querySelector('#cronjobs.active')) {
        loadCronjobs();
    } else {
        // Daten im Hintergrund vorladen damit der Tab sofort anzeigt
        setTimeout(loadCronjobs, 1200);
    }
})();
</script>
