<%
/**
 * Discord-Status-Panels eines Gameservers (E4)
 *
 * Ein Panel ist eine Nachricht in einem Discord-Kanal, die das Dashboard
 * aktuell hält. Angelegt wird sie hier – ohne Eintrag erfährt der Bot vom
 * Server nichts.
 */
%>
<div class="row">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title mb-0">
                    <i class="fab fa-discord me-2"></i>Status-Panels
                </h3>
            </div>
            <div class="card-body">
                <p class="text-secondary small mb-3">
                    Ein Panel zeigt den Status dieses Servers in einem Discord-Kanal und
                    aktualisiert sich selbst. Solange kein Panel besteht, taucht der Server
                    nirgends in Discord auf.
                </p>

                <div id="panels-list">
                    <div class="text-center text-secondary py-3">
                        <i class="fas fa-spinner fa-spin me-2"></i>Lade …
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title mb-0"><i class="fas fa-plus me-2"></i>Panel hinzufügen</h3>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label" for="panel-channel">Kanal</label>
                    <select class="form-select" id="panel-channel">
                        <option value="">– Kanal wählen –</option>
                    </select>
                    <div class="form-text" id="panel-channel-hint"></div>
                    <div class="alert alert-info small mt-2 mb-0">
                        <i class="fas fa-info-circle me-1"></i>
                        Der Bot braucht im gewählten Kanal die Rechte
                        <strong>Nachrichten senden</strong> und <strong>Links einbetten</strong> –
                        ohne Letzteres bleibt das Embed unsichtbar. Fehlt ein Recht, legt sich
                        das Panel selbst still und der Grund steht links in der Liste, statt
                        dass es im Minutentakt gegen die Wand läuft.
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="panel-interval">Mindestabstand (Sekunden)</label>
                    <input type="number" class="form-control" id="panel-interval" value="60" min="15" max="3600">
                    <div class="form-text">
                        Kleinster Abstand zwischen zwei Aktualisierungen der Nachricht.
                        Unter 60 s wird es bei vielen Panels eng mit Discords Limits.
                    </div>
                </div>

                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" id="panel-controls" checked>
                    <label class="form-check-label" for="panel-controls">
                        Buttons zum Starten und Stoppen
                    </label>
                </div>
                <div class="form-text mb-3">
                    Wer klickt, braucht <code>GAMESERVER.START</code> bzw. <code>GAMESERVER.STOP</code> –
                    geprüft wird mit demselben Rechtesystem wie im Dashboard. Sichtbar sind die
                    Buttons für jeden, der den Kanal sieht: Discord kann Buttons nicht pro Nutzer
                    ausblenden.
                </div>

                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" id="panel-refresh" checked>
                    <label class="form-check-label" for="panel-refresh">
                        „Neu laden"-Button
                    </label>
                </div>
                <div class="form-text mb-3">
                    Getrennt schaltbar, weil Aktualisieren nur liest. Für einen öffentlichen Kanal
                    ist das die übliche Kombination: Neu laden an, Starten und Stoppen aus.
                </div>

                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" id="panel-players">
                    <label class="form-check-label" for="panel-players">Spielernamen anzeigen</label>
                </div>
                <div class="form-text mb-3">
                    Aus gutem Grund standardmäßig aus: Namen sind personenbezogen, und ein
                    Discord-Kanal ist meist öffentlich und dauerhaft lesbar. Die Spielerzahl
                    steht ohnehin immer im Panel.
                </div>

                <button class="btn btn-primary w-100" id="panel-create">
                    <i class="fab fa-discord me-1"></i>Panel anlegen und posten
                </button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    const SERVER_ID = '<%= server.id %>';
    const BASE = '/guild/<%= guildId %>/plugins/gameserver/servers/' + SERVER_ID + '/panels';

    let channels = [];

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text == null ? '' : String(text);
        return div.innerHTML;
    }

    function channelName(id) {
        const found = channels.find(c => c.id === id);
        return found ? '#' + found.name : id;
    }

    function renderPanels(panels) {
        const list = document.getElementById('panels-list');

        if (!panels.length) {
            list.innerHTML = '<div class="alert alert-light border mb-0">'
                + 'Noch kein Panel. Rechts einen Kanal wählen und anlegen.</div>';
            return;
        }

        // Ein Schalter je Einstellung, direkt in der Zeile: Umlegen schreibt und
        // aktualisiert die Discord-Nachricht sofort. Vorher ging Ändern nur über
        // Löschen und Neuanlegen - und das postet eine neue Nachricht.
        function toggle(panel, field, label, extraClass) {
            const id = 'p' + panel.id + '-' + field;
            return '<div class="form-check form-switch form-check-inline me-3">'
                 +   '<input class="form-check-input" type="checkbox" id="' + id + '"'
                 +     ' data-panel="' + panel.id + '" data-field="' + field + '"'
                 +     (panel[field] ? ' checked' : '') + '>'
                 +   '<label class="form-check-label small ' + (extraClass || '') + '" for="' + id + '">'
                 +     label + '</label>'
                 + '</div>';
        }

        list.innerHTML = panels.map(p => {
            const pushed = p.last_pushed_at
                ? new Date(p.last_pushed_at).toLocaleString('de-DE')
                : 'noch nicht gepostet';

            const error = p.last_error
                ? '<div class="text-danger small mt-1"><i class="fas fa-exclamation-triangle me-1"></i>'
                  + escapeHtml(p.last_error) + '</div>'
                : '';

            const stillgelegt = p.enabled ? ''
                : ' <span class="badge bg-secondary">stillgelegt</span>';

            return '<div class="border rounded p-2 mb-2" data-panel-row="' + p.id + '">'
                 +   '<div class="d-flex justify-content-between align-items-start">'
                 +     '<div><strong>' + escapeHtml(channelName(p.channel_id)) + '</strong>' + stillgelegt
                 +       '<div class="text-secondary small">Stand: ' + pushed + '</div>'
                 +     '</div>'
                 +     '<button class="btn btn-sm btn-outline-danger" data-remove="' + p.id + '">'
                 +       '<i class="fas fa-trash"></i>'
                 +     '</button>'
                 +   '</div>'
                 +   '<div class="mt-2 d-flex flex-wrap align-items-center">'
                 +     toggle(p, 'show_controls', 'Start/Stop')
                 +     toggle(p, 'show_refresh', 'Neu laden')
                 +     toggle(p, 'show_players', 'Spielernamen', 'text-warning-emphasis')
                 +     '<div class="d-flex align-items-center">'
                 +       '<span class="small text-secondary me-1">alle</span>'
                 +       '<input type="number" class="form-control form-control-sm" style="width:5.5rem"'
                 +         ' min="30" max="3600" value="' + p.min_interval_s + '"'
                 +         ' data-panel="' + p.id + '" data-field="min_interval_s">'
                 +       '<span class="small text-secondary ms-1">s</span>'
                 +     '</div>'
                 +     '<span class="small text-secondary ms-2" data-save-state="' + p.id + '"></span>'
                 +   '</div>'
                 +   error
                 + '</div>';
        }).join('');

        list.querySelectorAll('[data-remove]').forEach(btn => {
            btn.addEventListener('click', () => removePanel(btn.dataset.remove));
        });

        // Schalter schreiben sofort, das Zahlenfeld erst beim Verlassen -
        // sonst löste jede getippte Ziffer einen Discord-Edit aus.
        list.querySelectorAll('input[type="checkbox"][data-field]').forEach(input => {
            input.addEventListener('change', () => savePanel(input, input.checked));
        });
        list.querySelectorAll('input[type="number"][data-field]').forEach(input => {
            input.addEventListener('change', () => savePanel(input, Number(input.value)));
        });
    }

    /**
     * Schreibt genau die eine geänderte Einstellung.
     * Alles andere bleibt unangetastet - wer die Buttons abschaltet, soll nicht
     * versehentlich die Spielernamen mit umlegen.
     */
    async function savePanel(input, value) {
        const panelId = input.dataset.panel;
        const state   = document.querySelector('[data-save-state="' + panelId + '"]');
        const body    = {};
        body[input.dataset.field] = value;

        input.disabled = true;
        if (state) state.textContent = 'speichere …';

        try {
            const res  = await fetch(BASE + '/' + panelId, {
                method:  'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify(body),
            });
            const data = await res.json();
            if (!data.success) throw new Error(data.error || 'Speichern fehlgeschlagen');

            if (state) state.textContent = '✓ gespeichert';
            setTimeout(() => load(), 800);
        } catch (err) {
            if (state) state.textContent = '';
            alert('Fehler: ' + err.message);
            await load();
        } finally {
            input.disabled = false;
        }
    }

    function renderChannels() {
        const select = document.getElementById('panel-channel');
        const hint   = document.getElementById('panel-channel-hint');

        if (!channels.length) {
            hint.textContent = 'Keine Kanäle geladen – läuft der Bot?';
            return;
        }
        hint.textContent = '';
        select.insertAdjacentHTML('beforeend', channels
            .map(c => '<option value="' + escapeHtml(c.id) + '">#' + escapeHtml(c.name) + '</option>')
            .join(''));
    }

    async function load() {
        try {
            const res  = await fetch(BASE);
            const data = await res.json();
            if (!data.success) throw new Error(data.error || 'Laden fehlgeschlagen');

            channels = data.channels || [];
            renderChannels();
            renderPanels(data.panels || []);
        } catch (err) {
            document.getElementById('panels-list').innerHTML =
                '<div class="alert alert-danger mb-0">' + escapeHtml(err.message) + '</div>';
        }
    }

    async function createPanel() {
        const button    = document.getElementById('panel-create');
        const channelId = document.getElementById('panel-channel').value;

        if (!channelId) {
            alert('Bitte einen Kanal wählen.');
            return;
        }

        button.disabled = true;
        button.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Poste …';

        try {
            const res = await fetch(BASE, {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify({
                    channel_id:     channelId,
                    show_players:   document.getElementById('panel-players').checked,
                    show_controls:  document.getElementById('panel-controls').checked,
                    show_refresh:   document.getElementById('panel-refresh').checked,
                    min_interval_s: Number(document.getElementById('panel-interval').value) || 60,
                }),
            });
            const data = await res.json();
            if (!data.success) throw new Error(data.error || 'Anlegen fehlgeschlagen');
            await load();
        } catch (err) {
            alert('Fehler: ' + err.message);
        } finally {
            button.disabled = false;
            button.innerHTML = '<i class="fab fa-discord me-1"></i>Panel anlegen und posten';
        }
    }

    async function removePanel(panelId) {
        if (!confirm('Panel entfernen? Die Nachricht in Discord wird gelöscht.')) return;

        try {
            const res  = await fetch(BASE + '/' + panelId, { method: 'DELETE' });
            const data = await res.json();
            if (!data.success) throw new Error(data.error || 'Entfernen fehlgeschlagen');
            await load();
        } catch (err) {
            alert('Fehler: ' + err.message);
        }
    }

    document.getElementById('panel-create').addEventListener('click', createPanel);
    load();
})();
</script>
