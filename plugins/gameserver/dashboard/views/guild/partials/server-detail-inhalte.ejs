<%#
  Mods und der Lader — Artboard 6 (docs/spielpakete/entwurf/Mods.dc.html).

  ── Was der Entwurf verlangt und was daraus folgt ──────────────────────────

  Der Lader steht ZUOBERST und sieht anders aus als ein Mod: „Ohne ihn laedt
  kein Mod. Wird vor allen anderen geladen." Er ist keine Zeile wie die
  anderen, auch wenn er in derselben Tabelle steht.

  Jeder Mod traegt seine FASSUNG. Das ist der Kern von B.12: Ein Mod-Update
  mitten in der Woche ist die haeufigste Ursache dafuer, dass ein Server nicht
  mehr startet.

  „Mitspieler brauchen ihn auch" steht am Mod UND unten noch einmal als Summe
  samt Liste zum Weitergeben. Doppelt mit Absicht: Die Marke am Eintrag
  beantwortet „welcher?", die Zeile unten „muss ich jetzt jemandem Bescheid
  sagen?".

  Entfernte Eintraege bleiben stehen (Betreiber, 2026-09-08: „dann ist das
  ganze ein lernender Prozess den man ueberblicken kann") — aber eingeklappt.
  Sie gehoeren nicht in dieselbe Liste wie das Laufende.
%>
<div id="inhalte-wurzel" data-server="<%= server.id %>" data-guild="<%= guildId %>">
  <div class="fb-muted" style="font-size:13px">Wird geladen …</div>
</div>

<script>
(function () {
  'use strict';

  // ── Rueckmeldung: dasselbe Toast-System wie der Rest der Serverseite ──────
  //
  // Bis zum 2026-09-13 meldete dieser Reiter ueber Browser-Dialoge — als
  // einziger auf der Seite. Eine Mod-Aenderung im laufenden Betrieb ist aber
  // genau die Sorte Handlung, die man bewusst trifft und bestaetigt sehen will;
  // und ein Entfernen, das ein paar Sekunden braucht, sah ohne Zwischenmeldung
  // aus, als passiere nichts (Betreiber, 2026-09-13).
  const melde = (typ, text, dauer) => {
    if (typeof showToast === 'function') showToast(typ, text, dauer ? { timeOut: dauer } : undefined);
  };

  // Mods laedt das Spiel beim Start. Die Route schickt mit, ob der Server gerade
  // laeuft — daran haengt, ob jetzt jemand handeln muss.
  const wirkungMelden = (d) => {
    if (!d || !d.neustartNoetig) return;
    if (d.laeuft) {
      melde('warning', 'Der Server läuft — die Änderung wirkt erst nach einem Neustart.', 12000);
    } else {
      melde('info', 'Wirkt beim nächsten Start des Servers.', 8000);
    }
  };

  // Installieren und Vorgemerktes-Holen liefern dieselbe Antwort. Ein
  // Teilerfolg wird als solcher gesagt — nicht als Erfolg und nicht als Fehler.
  const ergebnisMelden = (d) => {
    const fehl = d.fehlgeschlagen || [];
    const teile = [`${d.installiert.length} installiert`];
    if (fehl.length) teile.push(`${fehl.length} fehlgeschlagen`);
    melde(fehl.length ? 'warning' : 'success',
      teile.join(', ') + (fehl.length ? ': ' + fehl.map(f => `${f.kennung}: ${f.fehler}`).join('; ') : ''),
      fehl.length ? 12000 : undefined);
    // Der gewaehlte Lader wird nie herabgestuft — gesagt wird es trotzdem, sonst
    // wundert sich jemand, warum die verlangte Fassung nicht ankam.
    for (const b of d.beibehalten || []) {
      melde('info', `${b.kennung} ${b.fassung} bleibt — verlangt war ${b.verlangt}. `
            + 'Der Lader wird nie herabgestuft.', 10000);
    }
    if (d.installiert.length) wirkungMelden(d);
  };

  const wurzel   = document.getElementById('inhalte-wurzel');
  const SERVER   = wurzel.dataset.server;
  const GUILD    = wurzel.dataset.guild;
  const BASIS    = `/guild/${GUILD}/plugins/gameserver/servers/${SERVER}/inhalte`;
  const DARF     = <%= userPermissions.permissions['GAMESERVER.FILES.MANAGE'] ? 'true' : 'false' %>;

  // Was Thunderstore ueber neuere Fassungen sagt — auf Knopfdruck geholt, nicht
  // beim Laden: Das ist eine Abfrage JE MOD bei einem fremden Dienst.
  const NEUER = {};

  // ── Ladestand: was BepInEx beim letzten Start wirklich geladen hat ────────
  //
  // Betreiber, 2026-09-13: Die Angaben im Modbereich sind nicht verlaesslich —
  // der Server soll selbst sagen, welcher Mod laedt. Quelle ist die Logdatei
  // des Laders (Route /ladestand, helpers/BepInExLog.js).
  let LADESTAND = null;
  let ZULETZT = null;
  const LAUFTEXT = {
    fehler: 'lädt nicht',
    nicht_geladen: 'nicht geladen',
    uebersprungen: 'übersprungen',
    abgebrochen: 'Laden abgebrochen',
    nicht_gesehen: 'im Log nicht gefunden',
  };

  function ladestandKopf() {
    if (!LADESTAND) return '';
    if (!LADESTAND.verfuegbar) {
      return `<div class="fb-muted" style="font-size:12px;margin:4px 0 8px">Ladestand: ${escape(LADESTAND.grund || 'nicht verfügbar')}</div>`;
    }
    const wann = LADESTAND.stand
      ? new Date(LADESTAND.stand).toLocaleString('de-DE', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' })
      : '?';
    const fremd = (LADESTAND.fremd || []).map(p => p.name + (p.fassung ? ' ' + p.fassung : '')
      + (p.status && p.status !== 'geladen' ? ' (' + (LAUFTEXT[p.status] || p.status) + ')' : ''));
    return `
      <div class="fb-muted" style="font-size:12px;margin:4px 0 8px">
        Ladestand vom letzten Start (${escape(wann)})${LADESTAND.bepinex ? ' · BepInEx ' + escape(LADESTAND.bepinex) : ''}${LADESTAND.laeuft ? '' : ' · Server gestoppt'}
        ${LADESTAND.vollstaendig ? '' : ' · <span style="color:var(--fb-danger)">das Laden wurde nicht abgeschlossen</span>'}
        ${fremd.length ? `<br>Geladen, aber keinem Eintrag zugeordnet: ${escape(fremd.join(', '))}` : ''}
      </div>`;
  }

  const escape = (s) => String(s == null ? '' : s)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');

  function marke(text, ton) {
    const farbe = ton === 'warn' ? 'var(--fb-warning)' : 'var(--fb-text-muted)';
    return `<span class="fb-pille" style="font-size:11px;border-color:${farbe};color:${farbe}">${escape(text)}</span>`;
  }

  function zeile(e, nummer) {
    const istLader = e.art === 'loader';
    const marken = [];
    if (e.status === 'fehlgeschlagen') marken.push(marke('fehlgeschlagen', 'warn'));
    if (e.status === 'geplant')        marken.push(marke('wird noch geholt', 'warn'));
    if (e.client_side)                 marken.push(marke('Mitspieler brauchen ihn auch'));
    const neuere = NEUER[e.id];
    if (neuere && neuere.neuer)        marken.push(marke('neuer: ' + neuere.neueste, 'warn'));
    if (neuere && neuere.fehler)       marken.push(marke('Fassung nicht abfragbar'));
    // Was BepInEx beim letzten Start dazu gesagt hat.
    const lauf = LADESTAND && LADESTAND.zeilen ? LADESTAND.zeilen[e.id] : null;
    if (lauf) {
      if (lauf.trotzAus)                         marken.push(marke('ausgeschaltet — lädt trotzdem', 'warn'));
      else if (lauf.status === 'geladen')        marken.push(marke('geladen'));
      else if (lauf.status === 'neu_seit_start') marken.push(marke('seit dem letzten Start neu'));
      else                                       marken.push(marke(LAUFTEXT[lauf.status] || lauf.status, 'warn'));
    }

    return `
      <div style="display:flex;gap:12px;padding:12px 0;align-items:flex-start;border-top:1px solid var(--fb-border)">
        <div class="fb-mono fb-muted" style="flex:0 0 22px;font-size:12px;padding-top:2px">
          ${istLader ? '<i class="fa-solid fa-cube"></i>' : nummer}
        </div>
        <div style="flex:1 1 auto;min-width:0">
          <div style="display:flex;gap:8px;align-items:baseline;flex-wrap:wrap">
            <span style="font-weight:600">${escape(e.name || e.kennung)}</span>
            ${e.fassung ? `<span class="fb-mono fb-muted" style="font-size:12px">${escape(e.fassung)}</span>` : ''}
            ${e.url ? `<a href="${escape(e.url)}" target="_blank" rel="noopener noreferrer"
                          class="fb-muted" style="font-size:12px" title="Seite bei Thunderstore">
                         <i class="fa-solid fa-arrow-up-right-from-square"></i></a>` : ''}
            ${istLader ? marke('Lader') : ''}
          </div>
          <div class="fb-muted" style="font-size:12px;margin-top:2px">
            ${istLader
              ? 'Ohne ihn lädt kein Mod. Wird vor allen anderen geladen.'
              : escape(e.ablage || '')}
          </div>
          ${marken.length ? `<div style="display:flex;gap:6px;margin-top:6px;flex-wrap:wrap">${marken.join('')}</div>` : ''}
          ${e.fehler ? `<div class="fb-muted" style="font-size:12px;margin-top:4px;color:var(--fb-danger)">${escape(e.fehler)}</div>` : ''}
          ${lauf && lauf.grund && lauf.status !== 'geladen' ? `<div class="fb-muted" style="font-size:12px;margin-top:4px${['fehler', 'nicht_geladen', 'abgebrochen'].includes(lauf.status) ? ';color:var(--fb-danger)' : ''}">${escape(lauf.grund)}</div>` : ''}
          ${lauf && lauf.warnungen && lauf.warnungen.length ? `<div class="fb-muted" style="font-size:12px;margin-top:2px">${lauf.warnungen.map(escape).join('<br>')}</div>` : ''}
        </div>
        ${DARF ? `
          <div style="display:flex;gap:6px;align-items:center;flex:0 0 auto">
            ${neuere && neuere.neuer ? `
              <button class="btn btn-sm btn-outline-primary" title="Auf ${escape(neuere.neueste)} bringen"
                      onclick="inhaltAktualisieren(${e.id}, '${escape(e.name || e.kennung)}')">
                <i class="fa-solid fa-arrow-up"></i>
              </button>` : ''}
            <label class="form-check form-switch mb-0" title="${e.aktiv ? 'Aktiv' : 'Aus'}">
              <input class="form-check-input" type="checkbox" ${e.aktiv ? 'checked' : ''}
                     onchange="inhaltSchalten(${e.id}, this.checked)">
            </label>
            <button class="btn btn-sm btn-outline-danger" title="Entfernen"
                    onclick="inhaltEntfernen(${e.id}, '${escape(e.name || e.kennung)}')">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>` : ''}
      </div>`;
  }

  function zeichne(d) {
    if (!d.unterstuetzt) {
      // Der Leerzustand aus dem Entwurf: Er sagt, dass das PAKET nichts zu
      // Mods sagt — nicht, dass hier etwas fehlt.
      wurzel.innerHTML = `
        <div class="fb-muted" style="font-size:13px">
          Dieses Spiel nimmt laut seinem Paket keine Inhalte auf
          (<span class="fb-mono">content.supported</span> ist nicht gesetzt).
          Solange das so ist, gibt es hier nichts zu verwalten.
        </div>`;
      return;
    }

    const aktive = [d.lader, ...d.mods].filter(e => e && e.aktiv).length;
    // ── Der Lader gehoert in diese Liste ────────────────────────────────────
    //
    // Er trug die Marke „Mitspieler brauchen ihn auch" an seiner Zeile, stand
    // aber nicht in der Liste zum Weitergeben — ein Widerspruch in derselben
    // Karte (Betreiber, 2026-09-12). Fuer den Mitspieler ist er sogar das
    // ERSTE: Ohne ihn laedt bei ihm kein einziger Mod.
    const brauchen = [d.lader, ...d.mods].filter(e => e && e.aktiv && e.client_side);

    let html = `
      <div style="display:flex;gap:10px;align-items:baseline;flex-wrap:wrap;margin-bottom:6px">
        <span class="fb-muted" style="font-size:13px">
          ${aktive} aktiv${d.lader ? '' : ' · kein Lader installiert'}
          ${d.quellen && d.quellen.length ? ' · Quelle ' + d.quellen.map(escape).join(', ') : ''}
        </span>
        <span style="margin-left:auto"></span>
        ${d.mods.some(m => m.quelle === 'thunderstore') || (d.lader && d.lader.quelle === 'thunderstore')
          ? `<button class="btn btn-white btn-sm" onclick="inhaltAktualisierungen(this)">Auf Aktualisierungen prüfen</button>`
          : ''}
        ${DARF && (d.quellen || []).includes('thunderstore')
          ? `<button class="btn btn-primary btn-sm" onclick="inhaltSuche()">Aus Thunderstore</button>` : ''}
        ${DARF ? `<button class="btn btn-white btn-sm"
                    onclick="inhaltFormular()">Datei hochladen</button>` : ''}
      </div>
      ${ladestandKopf()}
      <div id="inhalte-suche" style="display:none"></div>
      <div id="inhalte-formular" style="display:none"></div>`;

    // Vorgemerktes, das noch nicht auf dem Server liegt. Normalerweise holt es
    // das Dashboard selbst, sobald die Installation fertig gemeldet ist — hier
    // steht der Knopf fuer den Fall, dass das schiefging.
    const geplant = [d.lader, ...d.mods].filter(e => e && e.status === 'geplant');
    if (geplant.length && DARF) {
      html += `
        <div style="font-size:13px;margin:8px 0;padding:10px;border:1px solid var(--fb-border);border-radius:6px">
          <strong>${geplant.length} ${geplant.length === 1 ? 'Mod ist' : 'Mods sind'} vorgemerkt und noch nicht geholt.</strong>
          <div class="fb-muted" style="font-size:12px;margin-top:2px">
            Beim Anlegen ausgewählt. Geholt werden sie, sobald die Installation fertig
            ist — hat das nicht geklappt, geht es hier von Hand.
          </div>
          <button class="btn btn-primary btn-sm" style="margin-top:8px"
                  onclick="inhaltGeplantHolen(this)">Jetzt holen</button>
        </div>`;
    }

    if (!d.lader && DARF) {
      html += `
        <div class="fb-muted" style="font-size:12px;margin:8px 0;padding:8px 10px;border:1px solid var(--fb-border);border-radius:6px">
          <strong>Zuerst der Lader.</strong> Ohne ihn lädt kein Mod
          (<span class="fb-mono">${escape(d.lader_key || 'BepInEx')}</span>).
          Über Thunderstore kommt er als Abhängigkeit von selbst mit — beim
          Hochladen wähle „Lader" als Art.
        </div>`;
    }

    if (d.lader) html += zeile(d.lader, 0);
    d.mods.forEach((m, i) => { html += zeile(m, i + 1); });

    if (!d.lader && !d.mods.length) {
      html += `<div class="fb-muted" style="font-size:13px;padding:12px 0">Noch nichts installiert.</div>`;
    }

    if (d.reihenfolgeZaehlt && d.mods.length > 1) {
      html += `<div class="fb-muted" style="font-size:12px;margin-top:10px">
                 Die <strong>Reihenfolge zählt</strong> bei diesem Lader.
               </div>`;
    }

    if (brauchen.length) {
      // Mit Adresse: Die Liste wird weitergegeben, und „EpicLoot 0.9.22" allein
      // schickt jeden Mitspieler erst einmal auf die Suche.
      const liste = brauchen.map(m => {
        const kopf = `${m.name || m.kennung}${m.fassung ? ' ' + m.fassung : ''}`
                   + (m.art === 'loader' ? '   ← zuerst installieren' : '');
        return m.url ? `${kopf}\n  ${m.url}` : `${kopf}\n  (hochgeladen — Datei vom Server nötig)`;
      }).join('\n');

      const lader = brauchen.find(m => m.art === 'loader');
      const modAnzahl = brauchen.filter(m => m.art !== 'loader').length;
      const satz = lader
        ? `Der Lader und ${modAnzahl} ${modAnzahl === 1 ? 'Mod' : 'Mods'} müssen auch bei deinen Mitspielern liegen.`
        : `${modAnzahl} ${modAnzahl === 1 ? 'Mod braucht' : 'Mods brauchen'} deine Mitspieler auch.`;
      html += `
        <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--fb-border)">
          <div style="font-size:13px">
            <strong>${satz}</strong> Wer sie nicht hat, kommt nicht auf den Server.
          </div>
          ${lader ? `
            <div class="fb-muted" style="font-size:12px;margin-top:4px">
              Zuerst der Lader
              ${lader.url ? `(<a href="${escape(lader.url)}" target="_blank" rel="noopener noreferrer">${escape(lader.name || lader.kennung)}</a>)`
                          : `(${escape(lader.name || lader.kennung)})`},
              danach die Mods in seinen Ordner. Auf der verlinkten Seite steht,
              wie er eingerichtet wird; die meisten Spieler nehmen dafür einen
              Mod-Manager wie <span class="fb-mono">r2modman</span>.
            </div>` : ''}
          <textarea id="inhalte-weitergeben" class="form-control fb-mono" rows="${Math.min(10, brauchen.length * 2 + 1)}"
                    style="margin-top:8px;font-size:12px" readonly>${escape(liste)}</textarea>
          <button class="btn btn-white btn-sm" style="margin-top:6px" onclick="inhaltKopieren()">
            Liste zum Weitergeben kopieren
          </button>
        </div>`;
    }

    if (d.entfernt && d.entfernt.length) {
      html += `
        <details style="margin-top:14px">
          <summary class="fb-muted" style="font-size:12px;cursor:pointer">
            ${d.entfernt.length} entfernt — Verlauf
          </summary>
          <div style="margin-top:6px">
            ${d.entfernt.map(e => `
              <div class="fb-muted" style="font-size:12px;padding:4px 0">
                ${escape(e.name || e.kennung)}${e.fassung ? ' ' + escape(e.fassung) : ''}
                · ${escape(String(e.created_at || '').slice(0, 10))}
              </div>`).join('')}
          </div>
        </details>`;
    }

    wurzel.innerHTML = html;
  }

  window.inhalteLaden = function () {
    fetch(BASIS, { headers: { Accept: 'application/json' } })
      .then(r => r.json())
      .then(d => {
        if (!d.success) throw new Error(d.message || 'Fehler');
        d.lader_key = d.lader_key || d.lader && d.lader.kennung;
        ZULETZT = d;
        zeichne(d);
        ladestandLaden();
      })
      .catch(e => {
        wurzel.innerHTML = `<div class="fb-muted" style="font-size:13px;color:var(--fb-danger)">
          Die Liste konnte nicht geladen werden: ${escape(e.message)}</div>`;
      });
  };

  // Nach der Liste, nicht vor ihr: Zwei Dateibefehle beim Daemon sollen die
  // Liste nicht aufhalten.
  function ladestandLaden() {
    fetch(`${BASIS}/ladestand`, { headers: { Accept: 'application/json' } })
      .then(async (a) => {
        const d = await a.json().catch(() => null);
        if (!a.ok || !d || !d.success) throw new Error((d && d.message) || `HTTP ${a.status}`);
        return d;
      })
      .then(d => { LADESTAND = d; })
      .catch(e => { LADESTAND = { verfuegbar: false, grund: 'nicht abrufbar — ' + e.message }; })
      .finally(() => {
        // Ein offenes Such- oder Hochladefeld nicht wegzeichnen; die Marken
        // kommen dann mit dem naechsten Laden der Liste.
        const offen = ['inhalte-suche', 'inhalte-formular']
          .some(id => { const f = document.getElementById(id); return f && f.style.display !== 'none'; });
        if (ZULETZT && !offen) zeichne(ZULETZT);
      });
  }

  window.inhaltFormular = function () {
    const feld = document.getElementById('inhalte-formular');
    if (!feld) return;
    if (feld.style.display !== 'none') { feld.style.display = 'none'; return; }

    feld.style.display = '';
    feld.innerHTML = `
      <div style="border:1px solid var(--fb-border);border-radius:6px;padding:12px;margin:8px 0">
        <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end">
          <div style="flex:0 0 150px">
            <label class="form-label" style="font-size:12px">Art</label>
            <select id="inhalt-art" class="form-select form-select-sm">
              <option value="mod">Mod</option>
              <option value="loader">Lader</option>
            </select>
          </div>
          <div style="flex:1 1 180px">
            <label class="form-label" style="font-size:12px">Name</label>
            <input id="inhalt-name" class="form-control form-control-sm" placeholder="wie im Spiel">
          </div>
          <div style="flex:0 0 120px">
            <label class="form-label" style="font-size:12px">Fassung</label>
            <input id="inhalt-fassung" class="form-control form-control-sm" placeholder="1.2.3">
          </div>
          <div style="flex:1 1 200px">
            <label class="form-label" style="font-size:12px">Datei (.dll oder .zip)</label>
            <input id="inhalt-datei" type="file" class="form-control form-control-sm">
          </div>
          <button class="btn btn-primary btn-sm" onclick="inhaltHochladen(this)">Hochladen</button>
        </div>
        <div class="fb-muted" style="font-size:12px;margin-top:8px">
          Eine <span class="fb-mono">.zip</span> wird entpackt. Trägst du keine Fassung ein,
          steht später „unbekannt“ — und beim nächsten Update weiß niemand, was vorher lief.
        </div>
        <div id="inhalt-meldung" style="font-size:12px;margin-top:6px"></div>
      </div>`;
  };

  window.inhaltHochladen = function (knopf) {
    const datei = document.getElementById('inhalt-datei').files[0];
    const meldung = document.getElementById('inhalt-meldung');
    if (!datei) { meldung.textContent = 'Bitte eine Datei wählen.'; return; }

    const daten = new FormData();
    daten.append('file', datei);
    daten.append('art', document.getElementById('inhalt-art').value);
    daten.append('name', document.getElementById('inhalt-name').value);
    daten.append('fassung', document.getElementById('inhalt-fassung').value);

    knopf.disabled = true;
    meldung.textContent = 'Wird hochgeladen …';

    fetch(BASIS, { method: 'POST', body: daten })
      .then(async (a) => {
        const d = await a.json().catch(() => null);
        if (!a.ok || !d || !d.success) {
          throw new Error((d && d.message) || `HTTP ${a.status}`);
        }
        return d;
      })
      .then(d => {
        window.inhalteLaden();
        meldung.textContent = '';
        melde('success', `${d.dateien} Datei(en) abgelegt.`);
        wirkungMelden(d);
      })
      .catch(e => {
        meldung.textContent = 'Fehlgeschlagen: ' + e.message;
        melde('error', 'Hochladen fehlgeschlagen: ' + e.message);
      })
      .finally(() => { knopf.disabled = false; });
  };

  // ── Thunderstore ──────────────────────────────────────────────────────────

  window.inhaltSuche = function () {
    const feld = document.getElementById('inhalte-suche');
    if (!feld) return;
    if (feld.style.display !== 'none') { feld.style.display = 'none'; return; }

    feld.style.display = '';
    feld.innerHTML = `
      <div style="border:1px solid var(--fb-border);border-radius:6px;padding:12px;margin:8px 0">
        <div style="display:flex;gap:8px;align-items:flex-end">
          <div style="flex:1 1 auto">
            <label class="form-label" style="font-size:12px">Mod suchen</label>
            <input id="ts-begriff" class="form-control form-control-sm"
                   placeholder="Name, z. B. Jotunn — leer lassen zum Stöbern"
                   onkeydown="if(event.key==='Enter')inhaltSuchen()">
          </div>
          <button class="btn btn-primary btn-sm" onclick="inhaltSuchen()">Suchen</button>
        </div>
        <div class="fb-muted" style="font-size:12px;margin-top:8px">
          Ohne Eingabe siehst du die beliebtesten — zum Schauen, was es für dieses
          Spiel überhaupt gibt. Was ein Mod zum Laufen braucht, kommt bei der
          Installation mit, der Lader meistens auch.
          <br>Nicht alles hier gehört auf einen Server: Mod-Manager wie
          <span class="fb-mono">r2modman</span> laufen beim Spieler.
        </div>
        <div id="ts-treffer" style="margin-top:8px"></div>
      </div>`;
    document.getElementById('ts-begriff').focus();
    // Gleich stöbern lassen: Ein leeres Feld mit einem Knopf daneben verrät
    // nicht, dass dahinter schon eine Liste liegt.
    window.inhaltSuchen();
  };

  window.inhaltSuchen = function (seite) {
    const begriff = (document.getElementById('ts-begriff') || {}).value || '';
    const raum = document.getElementById('ts-treffer');
    raum.innerHTML = '<div class="fb-muted" style="font-size:12px">Wird gesucht …</div>';

    fetch(`${BASIS}/suche?q=${encodeURIComponent(begriff)}&seite=${seite || 1}`,
          { headers: { Accept: 'application/json' } })
      .then(async (a) => {
        const d = await a.json().catch(() => null);
        if (!a.ok || !d || !d.success) throw new Error((d && d.message) || `HTTP ${a.status}`);
        return d;
      })
      .then(d => {
        if (!d.treffer.length) {
          raum.innerHTML = '<div class="fb-muted" style="font-size:12px">Nichts gefunden.</div>';
          return;
        }
        const umfang = `
          <div class="fb-muted" style="font-size:12px;padding-bottom:4px;display:flex;gap:8px;align-items:baseline;flex-wrap:wrap">
            <span>${d.gestoebert ? 'Beliebteste zuerst' : 'Treffer'} —
              Seite ${d.seite} von ${d.seiten}, ${Number(d.gesamt).toLocaleString('de-DE')}
              ${d.gestoebert ? 'Mods für dieses Spiel' : 'Treffer'}</span>
            ${d.verzeichnis ? `<a href="${escape(d.verzeichnis)}" target="_blank" rel="noopener noreferrer"
                                 style="margin-left:auto">alle bei Thunderstore ansehen</a>` : ''}
          </div>`;
        const blaettern = (d.zurueck || d.weiter) ? `
          <div style="display:flex;gap:8px;align-items:center;padding-top:8px;border-top:1px solid var(--fb-border)">
            <button class="btn btn-white btn-sm" ${d.zurueck ? '' : 'disabled'}
                    onclick="inhaltSuchen(${d.seite - 1})">← Zurück</button>
            <span class="fb-muted" style="font-size:12px">Seite ${d.seite} von ${d.seiten}</span>
            <button class="btn btn-white btn-sm" ${d.weiter ? '' : 'disabled'}
                    onclick="inhaltSuchen(${d.seite + 1})">Weiter →</button>
          </div>` : '';

        raum.innerHTML = umfang
          + d.treffer.map(t => `
          <div style="display:flex;gap:10px;padding:8px 0;border-top:1px solid var(--fb-border);align-items:flex-start">
            ${t.bild ? `<img src="${escape(t.bild)}" alt="" width="32" height="32" style="border-radius:4px;flex:0 0 auto">` : ''}
            <div style="flex:1 1 auto;min-width:0">
              <div style="font-weight:600;font-size:13px">${escape(t.name)}
                ${t.veraltet ? marke('veraltet', 'warn') : ''}</div>
              <div class="fb-muted" style="font-size:12px">${escape(t.beschreibung).slice(0, 160)}</div>
              <div class="fb-muted" style="font-size:11px;margin-top:2px">
                <span class="fb-mono">${escape(t.kennung)}</span> ·
                ${Number(t.downloads).toLocaleString('de-DE')} Downloads
                ${t.url ? `· <a href="${escape(t.url)}" target="_blank" rel="noopener noreferrer">ansehen</a>` : ''}</div>
            </div>
            ${DARF ? `<button class="btn btn-white btn-sm" style="flex:0 0 auto"
                        onclick="inhaltVorschau('${escape(t.kennung)}', this)">Ansehen</button>` : ''}
          </div>`).join('') + blaettern;
      })
      .catch(e => {
        raum.innerHTML = `<div style="font-size:12px;color:var(--fb-danger)">Suche fehlgeschlagen: ${escape(e.message)}</div>`;
      });
  };

  window.inhaltVorschau = function (kennung, knopf) {
    knopf.disabled = true;
    const raum = document.getElementById('ts-treffer');

    fetch(`${BASIS}/vorschau?kennung=${encodeURIComponent(kennung)}`, { headers: { Accept: 'application/json' } })
      .then(async (a) => {
        const d = await a.json().catch(() => null);
        if (!a.ok || !d || !d.success) throw new Error((d && d.message) || `HTTP ${a.status}`);
        return d;
      })
      .then(d => {
        const liste = d.pakete.map(p => `
          <div style="display:flex;gap:8px;font-size:12px;padding:3px 0">
            <span class="fb-mono" style="flex:1 1 auto">${escape(p.kennung)} ${escape(p.fassung)}</span>
            ${p.art === 'loader' ? marke('Lader') : ''}
            ${p.bleibt ? marke('bleibt ' + (p.schonFassung || '?')) : p.schonDa ? marke(p.schonFassung === p.fassung ? 'schon da' : 'ersetzt ' + escape(p.schonFassung || '?'), 'warn') : ''}
          </div>`).join('');

        raum.innerHTML = `
          <div style="border:1px solid var(--fb-border);border-radius:6px;padding:10px">
            <div style="font-size:13px;font-weight:600;margin-bottom:6px">
              Das wird installiert (${d.pakete.length}):</div>
            ${liste}
            ${d.fehlend && d.fehlend.length ? `
              <div style="font-size:12px;color:var(--fb-danger);margin-top:6px">
                Nicht auflösbar: ${escape(d.fehlend.join('; '))}</div>` : ''}
            <div style="display:flex;gap:8px;margin-top:10px">
              <button class="btn btn-primary btn-sm"
                      onclick="inhaltInstallieren('${escape(kennung)}', this)">Installieren</button>
              <button class="btn btn-white btn-sm" onclick="inhaltSuchen()">Zurück zur Liste</button>
            </div>
            <div id="ts-meldung" style="font-size:12px;margin-top:6px"></div>
          </div>`;
      })
      .catch(e => {
        raum.innerHTML = `<div style="font-size:12px;color:var(--fb-danger)">${escape(e.message)}</div>`;
      })
      .finally(() => { knopf.disabled = false; });
  };

  window.inhaltInstallieren = function (kennung, knopf) {
    const meldung = document.getElementById('ts-meldung');
    knopf.disabled = true;
    meldung.textContent = 'Wird geholt … das kann bei großen Mods dauern.';
    melde('info', `„${kennung}“ wird geholt …`);

    fetch(`${BASIS}/thunderstore`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ kennung })
    })
      .then(async (a) => {
        const d = await a.json().catch(() => null);
        if (!a.ok || !d || !d.success) throw new Error((d && d.message) || `HTTP ${a.status}`);
        return d;
      })
      .then(d => {
        window.inhalteLaden();
        meldung.textContent = '';
        ergebnisMelden(d);
      })
      .catch(e => {
        meldung.textContent = 'Fehlgeschlagen: ' + e.message;
        melde('error', 'Nicht installiert: ' + e.message);
      })
      .finally(() => { knopf.disabled = false; });
  };

  window.inhaltGeplantHolen = function (knopf) {
    knopf.disabled = true;
    knopf.textContent = 'Wird geholt …';
    melde('info', 'Vorgemerkte Mods werden geholt …');

    fetch(`${BASIS}/geplant-holen`, { method: 'POST' })
      .then(async (a) => {
        const d = await a.json().catch(() => null);
        if (!a.ok || !d || !d.success) throw new Error((d && d.message) || `HTTP ${a.status}`);
        return d;
      })
      .then(d => {
        window.inhalteLaden();
        if (d.nichts) { melde('info', d.message); return; }
        ergebnisMelden(d);
      })
      .catch(e => { melde('error', 'Nicht geholt: ' + e.message); window.inhalteLaden(); })
      .finally(() => { knopf.disabled = false; knopf.textContent = 'Jetzt holen'; });
  };

  window.inhaltAktualisierungen = function (knopf) {
    knopf.disabled = true;
    const alterText = knopf.textContent;
    knopf.textContent = 'Fragt nach …';

    fetch(`${BASIS}/aktualisierungen`, { headers: { Accept: 'application/json' } })
      .then(async (a) => {
        const d = await a.json().catch(() => null);
        if (!a.ok || !d || !d.success) throw new Error((d && d.message) || `HTTP ${a.status}`);
        return d;
      })
      .then(d => {
        for (const s of d.stand) NEUER[s.id] = s;
        window.inhalteLaden();
        const neue = d.stand.filter(s => s.neuer).length;
        melde(neue ? 'info' : 'success', neue
          ? `${neue} Aktualisierung(en) verfügbar — in der Liste markiert.`
          : 'Alles auf der neuesten Fassung.');
      })
      .catch(e => melde('error', 'Nicht abfragbar: ' + e.message))
      .finally(() => { knopf.disabled = false; knopf.textContent = alterText; });
  };

  window.inhaltAktualisieren = function (id, name) {
    if (!confirm(`"${name}" auf die neueste Fassung bringen?\n\n`
               + 'Die alten Dateien werden vorher entfernt. Wirksam beim nächsten Start.')) return;
    melde('info', `„${name}“ wird aktualisiert …`);

    fetch(`${BASIS}/${id}/aktualisieren`, { method: 'POST' })
      .then(async (a) => {
        const d = await a.json().catch(() => null);
        if (!a.ok || !d || !d.success) throw new Error((d && d.message) || `HTTP ${a.status}`);
        return d;
      })
      .then(d => {
        delete NEUER[id];
        window.inhalteLaden();
        if (!d.geaendert) { melde('info', d.message); return; }
        melde('success', `${name}: ${d.vorher} → ${d.nachher}`);
        if (d.alteDateienBlieben && d.alteDateienBlieben.length) {
          melde('warning', `${d.alteDateienBlieben.length} alte Datei(en) von ${name} blieben liegen.`, 12000);
        }
        if (d.ohneListe) {
          melde('warning', `Von der vorigen Fassung von ${name} war nicht festgehalten, welche `
                + 'Dateien dazugehörten — sie liegen noch da.', 12000);
        }
        wirkungMelden(d);
      })
      .catch(e => melde('error', 'Nicht aktualisiert: ' + e.message));
  };

  window.inhaltSchalten = function (id, aktiv) {
    // Dieselbe Deutung wie die Route: true oder '1' heisst an.
    const an = aktiv === true || aktiv === '1';
    fetch(`${BASIS}/${id}/schalten`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ aktiv })
    })
      .then(async (a) => {
        const d = await a.json().catch(() => null);
        if (!a.ok || !d || !d.success) throw new Error((d && d.message) || `HTTP ${a.status}`);
        return d;
      })
      .then(d => {
        melde('success', an ? 'Eingeschaltet.' : 'Abgeschaltet.');
        wirkungMelden(d);
      })
      // Bis zum 2026-09-13 lief ein Fehlschlag hier ohne jede Meldung durch.
      .catch(e => melde('error', 'Nicht geschaltet: ' + e.message))
      .finally(() => window.inhalteLaden());
  };

  window.inhaltEntfernen = function (id, name) {
    if (!confirm(`"${name}" entfernen?`)) return;
    // Entfernt wird Datei fuer Datei, das braucht ein paar Sekunden — ohne
    // diese Zeile sah es aus, als passiere nichts.
    melde('info', `„${name}“ wird entfernt …`);

    fetch(`${BASIS}/${id}`, { method: 'DELETE' })
      .then(async (a) => {
        const d = await a.json().catch(() => null);
        if (!a.ok || !d || !d.success) throw new Error((d && d.message) || `HTTP ${a.status}`);
        return d;
      })
      .then(d => {
        if (d.hinweis) melde('warning', d.hinweis, 12000);
        else melde('success', `„${name}“ entfernt` + (d.dateien ? ` — ${d.dateien} Datei(en) gelöscht.` : '.'));
        wirkungMelden(d);
      })
      // Bis zum 2026-09-13 ohne Fehlerzweig: Scheiterte das Entfernen, kam nichts.
      .catch(e => melde('error', 'Nicht entfernt: ' + e.message))
      .finally(() => window.inhalteLaden());
  };

  window.inhaltKopieren = function () {
    const feld = document.getElementById('inhalte-weitergeben');
    if (!feld) return;
    feld.select();
    // Erst markieren, dann die Zwischenablage versuchen: Scheitert sie (kein
    // https, oder der Browser fragt), steht wenigstens die Auswahl da.
    try { navigator.clipboard.writeText(feld.value); } catch (e) { /* markiert reicht */ }
  };

  window.inhalteLaden();
})();
</script>
