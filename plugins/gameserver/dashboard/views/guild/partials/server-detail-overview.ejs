<%# 
  * Server-Detail Overview-Tab
  * Zeigt allgemeine Informationen, Stats, Konfiguration
  %>

<div class="row">
    <!-- ========================================
         SERVER INFORMATION
         ======================================== -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-info-circle me-2"></i>
                    Server-Informationen
                </h3>
            </div>
            <div class="card-body">
                <table class="table table-sm">
                    <tbody>
                        <tr>
                            <th style="width: 40%">Server-ID:</th>
                            <td><code><%= server.id %></code></td>
                        </tr>
                        <tr>
                            <th>Name:</th>
                            <td><%= server.name %></td>
                        </tr>
                        <tr>
                            <th>Spiel:</th>
                            <td>
                                <%= server.game_name || 'Unbekannt' %>
                                <%
                                    // Die Spielversion kommt aus der Live-Abfrage, nicht aus dem Addon.
                                    // Das Badge zeigte bisher addon_version ("v1.0.0" = Version des
                                    // Addons im Marketplace) direkt neben dem Spielnamen – das las
                                    // sich wie die Spielversion und passte deshalb nie zum Installierten.
                                    const liveVersion = server.status_snapshot?.version || null;
                                %>
                                <% if (liveVersion) { %>
                                    <span class="badge bg-success ms-2" title="Vom laufenden Server gemeldet">
                                        <%= liveVersion %>
                                    </span>
                                <% } %>
                            </td>
                        </tr>
                        <tr>
                            <th>Addon-Version:</th>
                            <td>
                                <span class="badge bg-secondary"><%= server.addon_version || '–' %></span>
                                <small class="text-secondary ms-1">Version des Marketplace-Addons</small>
                            </td>
                        </tr>
                        <tr>
                            <th>Template:</th>
                            <td><%= server.template_name || 'Standard' %></td>
                        </tr>
                        <tr>
                            <th>Status:</th>
                            <td>
                                <% 
                                const statusColors = {
                                    online: 'success',
                                    offline: 'secondary',
                                    starting: 'warning',
                                    stopping: 'warning',
                                    error: 'danger',
                                    installing: 'info',
                                    installed: 'success'
                                };
                                const color = statusColors[server.status] || 'secondary';
                                %>
                                <span class="badge bg-<%= color %>" data-server-status>
                                    <span data-status-text><%= server.status %></span>
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <th>RootServer:</th>
                            <td>
                                <%= server.rootserver_name || 'N/A' %>
                                <% if (server.rootserver_hostname) { %>
                                    <small class="text-secondary">(<%= server.rootserver_hostname %>)</small>
                                <% } %>
                            </td>
                        </tr>
                        <tr>
                            <th>Erstellt am:</th>
                            <td><%= new Date(server.created_at).toLocaleString('de-DE') %></td>
                        </tr>
                        <tr>
                            <th>Letzte Änderung:</th>
                            <td><%= new Date(server.updated_at).toLocaleString('de-DE') %></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

<!-- ========================================
     CONNECTION & PORTS
     ======================================== -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-plug me-2"></i>
                    Verbindung & Ports
                </h3>
            </div>
            <div class="card-body">
                <table class="table table-sm">
                    <tbody>
                        <tr>
                            <th style="width: 40%">IP-Adresse:</th>
                            <td>
                                <code><%= server.ip_address || 'N/A' %></code>
                                <% if (server.ip_address) { %>
                                    <button class="btn btn-sm btn-outline-secondary ms-2" 
                                            onclick="copyToClipboard('<%= server.ip_address %>')"
                                            title="Kopieren">
                                        <i class="fas fa-copy"></i>
                                    </button>
                                <% } %>
                            </td>
                        </tr>
                        <tr>
                            <th>Game-Port:</th>
                            <td>
                                <code><%= server.port_game || 'N/A' %></code>
                                <% if (server.ip_address && server.port_game) { %>
                                    <button class="btn btn-sm btn-outline-secondary ms-2" 
                                            onclick="copyToClipboard('<%= server.ip_address %>:<%= server.port_game %>')"
                                            title="Verbindungsstring kopieren">
                                        <i class="fas fa-copy"></i>
                                    </button>
                                <% } %>
                            </td>
                        </tr>
                        <tr>
                            <th>Query-Port:</th>
                            <td>
                                <% if (server.port_query) { %>
                                    <code><%= server.port_query %></code>
                                    <button class="btn btn-sm btn-outline-secondary ms-2" 
                                            onclick="copyToClipboard('<%= server.port_query %>')"
                                            title="Port kopieren">
                                        <i class="fas fa-copy"></i>
                                    </button>
                                <% } else if (server.port_query_expected) { %>
                                    <span class="text-warning">Nicht allokiert</span>
                                    <small class="text-secondary d-block">
                                        <i class="fas fa-triangle-exclamation me-1"></i>
                                        Das Spiel erwartet <code><%= server.port_query_expected %></code>/UDP,
                                        der Port ist aber nicht angelegt – die Statusabfrage bleibt deshalb leer.
                                        Über „Ports bearbeiten“ hinzufügen und den Server neu starten.
                                    </small>
                                <% } else { %>
                                    <span class="text-secondary">Nicht konfiguriert</span>
                                    <small class="text-secondary d-block">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Query-Port ermöglicht Server-Status-Abfragen (z.B. für Discord-Bots)
                                    </small>
                                <% } %>
                            </td>
                        </tr>
                        <tr>
                            <th>RCON-Port:</th>
                            <td>
                                <% if (server.port_rcon) { %>
                                    <code><%= server.port_rcon %></code>
                                    <button class="btn btn-sm btn-outline-secondary ms-2" 
                                            onclick="copyToClipboard('<%= server.port_rcon %>')"
                                            title="Port kopieren">
                                        <i class="fas fa-copy"></i>
                                    </button>
                                <% } else { %>
                                    <span class="text-secondary">Nicht konfiguriert</span>
                                    <small class="text-secondary d-block">
                                        <i class="fas fa-info-circle me-1"></i>
                                        RCON ermöglicht Remote-Administration des Servers
                                    </small>
                                <% } %>
                            </td>
                        </tr>
                        <%
                            // Dynamisch alle zusätzlichen Ports anzeigen (beacon, etc.)
                            // Der Eintrag, der oben schon als Query-Port steht, gehört
                            // dazu – er heißt je nach Spiel anders als "query"
                            // (bei Valheim "game_plus_1") und erschiene sonst doppelt.
                            const knownPorts = ['game', 'query', 'rcon', 'main'];
                            if (server.port_query_key) knownPorts.push(server.port_query_key);
                            const extraPortEntries = server.ports_parsed
                                ? Object.entries(server.ports_parsed).filter(([k]) => !knownPorts.includes(k))
                                : [];
                        %>
                        <% extraPortEntries.forEach(([portType, portData]) => { %>
                            <tr>
                                <th><%= portType.charAt(0).toUpperCase() + portType.slice(1) %>-Port:</th>
                                <td>
                                    <% const epVal = portData.external || portData.internal; %>
                                    <% if (epVal) { %>
                                        <code><%= epVal %></code>
                                        <button class="btn btn-sm btn-outline-secondary ms-2" 
                                                onclick="copyToClipboard('<%= epVal %>')"
                                                title="Port kopieren">
                                            <i class="fas fa-copy"></i>
                                        </button>
                                    <% } else { %>
                                        <span class="text-secondary">Nicht konfiguriert</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                        <tr>
                            <th>Installationspfad:</th>
                            <td>
                                <small><code><%= server.install_path || 'N/A' %></code></small>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <% if (userPermissions.permissions['GAMESERVER.EDIT']) { %>
                <div class="mt-2">
                    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#portsEditModal">
                        <i class="fas fa-edit me-1"></i>Ports bearbeiten
                    </button>
                </div>
                <% } %>
            </div>
        </div>

<!-- Port-Edit-Modal -->
<div class="modal fade" id="portsEditModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-plug me-2"></i>Ports bearbeiten</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning alert-sm">
                    <i class="fas fa-exclamation-triangle me-1"></i>
                    Ports können nur geändert werden wenn der Server <strong>offline</strong> ist.
                    Stelle sicher, dass kein anderer Server diese Ports belegt.
                </div>
                <div id="ports-form">
                <%
                const portsObj = server.ports_parsed || {};
                const portTypeLabels = { game: 'Game-Port', query: 'Query-Port', rcon: 'RCON-Port' };
                const allPortKeys = Object.keys(portsObj).length ? Object.keys(portsObj) : ['game'];
                for (const pKey of allPortKeys) {
                    const pEntry = portsObj[pKey] || {};
                    const label = portTypeLabels[pKey] || pKey;
                    const extVal = pEntry.external || pEntry.internal || '';
                %>
                    <div class="mb-3">
                        <label><strong><%= label %></strong> <code class="text-secondary small"><%= pKey %></code></label>
                        <input type="number" class="form-control port-input" data-port-key="<%= pKey %>"
                               value="<%= extVal %>" min="1024" max="65535" placeholder="z.B. 27015">
                    </div>
                <% } %>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Abbrechen</button>
                <button type="button" class="btn btn-primary" id="ports-save-btn" onclick="savePorts()">
                    <i class="fas fa-save me-1"></i>Speichern
                </button>
            </div>
        </div>
    </div>
</div>

<script>
/**
 * Ein Fenster ansprechen — Bootstrap-5-Schnittstelle.
 * jQuery ist unter Tabler geladen, dessen Fenster-Methode aber nicht: Der
 * Aufruf warf, und alles danach im selben Block lief nicht mehr.
 */
function fenster(id) {
    const el = document.getElementById(id);
    return (el && window.bootstrap) ? bootstrap.Modal.getOrCreateInstance(el) : null;
}

async function savePorts() {
    const btn = document.getElementById('ports-save-btn');
    const inputs = document.querySelectorAll('.port-input');
    const ports = {};
    inputs.forEach(inp => {
        const key = inp.dataset.portKey;
        const val = parseInt(inp.value, 10);
        if (key && val >= 1024 && val <= 65535) ports[key] = val;
        else if (key) { toastr.error(`Ungültiger Port für ${key}: ${inp.value} (muss zwischen 1024 und 65535 liegen)`); return; }
    });
    if (!Object.keys(ports).length) return;
    btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Speichern...';
    try {
        const resp = await fetch(`/guild/<%= guildId %>/plugins/gameserver/servers/<%= server.id %>/ports`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify(ports)
        });
        const r = await resp.json();
        if (r.success) {
            toastr.success('Ports gespeichert – wird beim nächsten Start wirksam.');
            fenster('portsEditModal')?.hide();
            // Port-Anzeige aktualisieren ohne Reload
            Object.entries(ports).forEach(([k, v]) => {
                if (k === 'game') document.querySelector('[data-port-game]') && (document.querySelector('[data-port-game]').textContent = v);
            });
        } else { toastr.error(r.message || 'Fehler beim Speichern'); }
    } catch(e) { toastr.error('Netzwerkfehler'); }
    finally { btn.disabled = false; btn.innerHTML = '<i class="fas fa-save me-1"></i>Speichern'; }
}
</script>
    </div>
</div>

<!-- Zweite Row: Spieler, Ressourcen, Live-Query -->
<div class="row mt-3">
    <div class="col-md-6">
            <!-- ========================================
             PLAYER STATS (nur bei online)
             ======================================== -->
        <% if (server.status === 'online') { %>
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-users me-2"></i>
                        Spieler
                    </h3>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span>Aktuelle Spieler:</span>
                        <%
                            // NULL heißt "unbekannt" (Abfrage fehlgeschlagen), nicht "null Spieler".
                            // Eine erfundene 0 sah vorher aus wie eine gesicherte Aussage.
                            const playersKnown = server.current_players !== null && server.current_players !== undefined;
                        %>
                        <strong class="text-primary" data-current-players>
                            <%= playersKnown ? server.current_players : '–' %> / <%= server.max_players || '?' %>
                        </strong>
                        <% if (!playersKnown && server.status === 'online') { %>
                            <i class="fas fa-circle-question text-secondary ms-1"
                               title="Spielerzahl unbekannt – die Live-Abfrage erreicht den Server nicht"></i>
                        <% } %>
                    </div>
                    <div class="progress">
                        <%
                        const playerPercent = (playersKnown && server.max_players > 0)
                            ? (server.current_players / server.max_players) * 100
                            : 0;
                        %>
                        <div class="progress-bar bg-primary" 
                             role="progressbar" 
                             style="width: <%= playerPercent %>%"
                             data-players-bar>
                            <%= playerPercent.toFixed(0) %>%
                        </div>
                    </div>
                </div>
            </div>
        <% } %>

    </div>
    <div class="col-md-6">
        <!-- ========================================
             RESOURCE METRICS (CPU / RAM – immer bei online)
             ======================================== -->
        <% if (server.status === 'online') { %>
            <div class="card" id="metrics-card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-chart-bar me-2"></i>
                        Ressourcen
                    </h3>
                    <span class="badge bg-secondary float-end" id="metrics-live-badge" style="display:none">
                        <i class="fas fa-circle text-success me-1" style="font-size:0.6em"></i>Live
                        <small class="ms-1" id="metrics-last-update"></small>
                    </span>
                </div>
                <div class="card-body">
                    <!-- CPU -->
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span><i class="fas fa-microchip me-1"></i> CPU:</span>
                        <strong data-metric-cpu-text>
                            <%= server.cpu_percent != null ? server.cpu_percent.toFixed(1) + '%' : '–' %>
                        </strong>
                    </div>
                    <div class="progress mb-3" style="height: 20px;">
                        <% const cpuPct = server.cpu_percent || 0; %>
                        <div class="progress-bar <%= cpuPct > 80 ? 'bg-danger' : cpuPct > 50 ? 'bg-warning' : 'bg-success' %>" 
                             role="progressbar" 
                             style="width: <%= cpuPct %>%; transition: width 1s ease, background-color 1s ease;"
                             data-metric-cpu-bar>
                            <%= cpuPct.toFixed(1) %>%
                        </div>
                    </div>
                    <!-- RAM -->
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span><i class="fas fa-memory me-1"></i> RAM:</span>
                        <strong data-metric-ram-text>
                            <% if (server.ram_used_mb != null && server.ram_total_mb) { %>
                                <%= server.ram_used_mb %> / <%= server.ram_total_mb %> MB
                            <% } else { %>
                                –
                            <% } %>
                        </strong>
                    </div>
                    <div class="progress" style="height: 20px;">
                        <% const ramPct = (server.ram_total_mb > 0) ? (server.ram_used_mb / server.ram_total_mb) * 100 : 0; %>
                        <div class="progress-bar <%= ramPct > 80 ? 'bg-danger' : ramPct > 50 ? 'bg-warning' : 'bg-info' %>" 
                             role="progressbar" 
                             style="width: <%= ramPct %>%; transition: width 1s ease, background-color 1s ease;"
                             data-metric-ram-bar>
                            <%= ramPct.toFixed(1) %>%
                        </div>
                    </div>
                </div>
            </div>
        <% } %>

    </div>
</div>

<!-- Dritte Row: Live-Query full-width -->
<div class="row mt-3">
    <div class="col-12">
        <!-- ========================================
             LIVE-QUERY (GameDig – nur wenn Addon Query unterstützt)
             ======================================== -->
        <% if (server.status === 'online' && server.gamedig_type) { %>
            <div class="card mt-3" id="live-query-card">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-satellite-dish me-2"></i>
                        Live-Status
                        <span class="badge bg-secondary ms-2" id="query-ping-badge" style="display:none"></span>
                    </h3>
                    <div class="d-flex align-items-center gap-2">
                        <small class="text-secondary">
                            Stand: <span id="qry-last-update">–</span>
                        </small>
                        <button class="btn btn-sm btn-outline-primary" id="btn-refresh-query" onclick="refreshLiveQuery()">
                            <i class="fas fa-sync-alt me-1"></i>Aktualisieren
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div id="live-query-loading" class="text-center text-secondary py-3">
                        <i class="fas fa-spinner fa-spin me-2"></i>Lade Live-Status…
                    </div>
                    <div id="live-query-content" style="display:none">
                        <%
                            // Kacheln kommen aus dem Addon (game_data.status.display.fields),
                            // mit den Standardvorgaben als Rückfall. Vorher war jede Kachel
                            // fest verdrahtet und hatte ihre eigene Ein-/Ausblend-Logik im
                            // JavaScript – deshalb zeigte Palworld dauerhaft "Map: –" für
                            // einen Wert, den es dort prinzipiell nicht gibt.
                            const statusFields = server.status_display?.fields || [];
                        %>
                        <div class="row g-3 mb-3">
                            <div class="col-6 col-md-3 text-center">
                                <div class="fw-bold text-primary fs-4" id="qry-players">–</div>
                                <div class="small text-secondary">Spieler</div>
                            </div>
                            <% statusFields.forEach(field => { %>
                                <div class="col-6 col-md-3 text-center" id="qry-field-<%= field.key %>" style="display:none">
                                    <div class="fw-bold <%= field.format === 'code' ? 'fs-6' : 'fs-4' %>" data-field-value></div>
                                    <div class="small text-secondary"><%= field.label %></div>
                                </div>
                            <% }); %>
                        </div>
                        <!-- Spiel-spezifische Extras (Rust wipe, PVE etc.) -->
                        <div id="qry-extras" class="mb-3" style="display:none">
                            <div class="d-flex flex-wrap gap-2" id="qry-extras-badges"></div>
                        </div>
                        <div id="qry-player-list" class="mt-2" style="display:none">
                            <%
                                // Spalten kommen aus dem Addon (game_data.status.display.columns),
                                // mit eingebauten Vorgaben je Spiel als Rückfall. Vorher waren
                                // Spielername/Score/Spielzeit fest verdrahtet und der Header
                                // wurde per Sonderfall auf "Level" umgebogen.
                                const playerColumns = server.status_display?.columns || [];
                            %>
                            <table class="table table-sm table-striped mb-0">
                                <thead>
                                    <tr>
                                        <% playerColumns.forEach(col => { %>
                                            <th class="<%= col.align === 'end' ? 'text-end' : '' %>"><%= col.label %></th>
                                        <% }); %>
                                    </tr>
                                </thead>
                                <tbody id="qry-player-tbody"></tbody>
                            </table>
                        </div>
                    </div>
                    <div id="live-query-error" class="alert alert-warning mb-0" style="display:none">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <span id="live-query-error-msg"></span>
                    </div>
                </div>
            </div>

            <script>
            (function () {
                const QUERY_URL = '/guild/<%= server.guild_id %>/plugins/gameserver/servers/<%= server.id %>/query';
                // Spaltendefinition aus dem Addon – identisch zu der im Tabellenkopf
                const PLAYER_COLUMNS = <%- JSON.stringify(server.status_display?.columns || []) %>;
                // Kacheldefinition aus demselben Block
                const STATUS_FIELDS  = <%- JSON.stringify(server.status_display?.fields || []) %>;

                /**
                 * Wert über einen Punktpfad aus dem Abfrageergebnis holen.
                 * `source` darf eine Liste sein – der erste belegte Pfad gewinnt.
                 * Die Spielversion steht je nach Spiel in extra.gameVersion oder
                 * direkt in version.
                 */
                function fieldValue(data, source) {
                    for (const path of [].concat(source || [])) {
                        const value = String(path).split('.')
                            .reduce((acc, key) => (acc == null ? acc : acc[key]), data);
                        if (value != null && value !== '') return value;
                    }
                    return null;
                }

                /**
                 * Füllt die Statistik-Kacheln aus der Addon-Beschreibung.
                 *
                 * Eine Kachel ohne Wert wird ausgeblendet statt mit "–" gefüllt.
                 * Vorher war jede Kachel fest verdrahtet: Palworld zeigte dauerhaft
                 * "Map: –" und ein grünes offenes Schloss bei "Passwort" – letzteres
                 * behauptete sogar, der Server sei ohne Passwort, obwohl es dort
                 * schlicht keine Abfrage gibt, die das beantworten könnte.
                 */
                function renderStatusFields(data) {
                    STATUS_FIELDS.forEach(field => {
                        const col = document.getElementById('qry-field-' + field.key);
                        if (!col) return;
                        const target = col.querySelector('[data-field-value]');

                        let value = fieldValue(data, field.source || field.key);
                        let html  = null;

                        switch (field.format) {
                            case 'ms':
                                if (value != null && value !== '') html = value + ' ms';
                                break;
                            case 'lock':
                                // Nur zeigen, wenn die Quelle die Frage wirklich beantwortet hat
                                if (typeof value === 'boolean') {
                                    html = value
                                        ? '<i class="fas fa-lock text-warning"></i>'
                                        : '<i class="fas fa-lock-open text-success"></i>';
                                }
                                break;
                            case 'onoff':
                                if (value != null) {
                                    html = value
                                        ? '<i class="fas fa-shield-alt text-success"></i> An'
                                        : '<i class="fas fa-shield-alt text-secondary"></i> Aus';
                                }
                                break;
                            case 'code':
                                if (value) html = '<code class="user-select-all">' + value + '</code>';
                                break;
                            default:
                                if (value != null && value !== '') html = String(value);
                        }

                        if (html !== null && field.hide_when === 'zero' && Number(value) === 0) {
                            html = null;
                        }

                        if (html === null) {
                            col.style.display = 'none';
                        } else {
                            target.innerHTML = html;
                            col.style.display = '';
                        }
                    });
                }

                /**
                 * Rendert die Spielerliste anhand der Addon-Spalten.
                 * Global, damit auch der SSE-Handler der Detailseite sie aktualisieren
                 * kann – ohne dafür eine neue Abfrage auszulösen.
                 */
                window.renderQueryPlayers = function (players) {
                    const list = document.getElementById('qry-player-list');
                    if (!list) return;

                    if (!players || players.length === 0) {
                        list.style.display = 'none';
                        return;
                    }

                    document.getElementById('qry-player-tbody').innerHTML = players.map((p, i) => {
                        const cells = PLAYER_COLUMNS.map(col => {
                            // "player.name" → p.name, "player.raw.id" → p.raw.id
                            const path = String(col.source || '').replace(/^player\./, '');
                            let value = path.split('.').reduce((acc, k) => (acc == null ? acc : acc[k]), p);

                            if (col.key === 'name') {
                                value = value || ('Spieler ' + (i + 1));
                                if (p.avatar) {
                                    value = `<img src="${p.avatar}" width="20" height="20" class="rounded me-2" alt="">` + value;
                                }
                            } else if (col.format === 'duration') {
                                value = secondsToHMS(value);
                            } else if (col.format === 'ms') {
                                value = (value == null || value === '') ? '–' : (value + ' ms');
                            } else if (col.format === 'platform') {
                                // Palworld liefert die Plattform als Präfix der userId
                                // ("steam_7656…", "gdk_2533…" für Xbox). Die ID selbst
                                // gehört nicht in die Anzeige – der Präfix genügt.
                                const raw = String(value || '');
                                const prefix = raw.split('_')[0].toLowerCase();
                                value = { steam: 'Steam', gdk: 'Xbox', xbl: 'Xbox', psn: 'PlayStation' }[prefix]
                                        || (prefix ? prefix.charAt(0).toUpperCase() + prefix.slice(1) : '–');
                            } else if (value == null || value === '') {
                                value = '–';
                            }

                            return `<td class="${col.align === 'end' ? 'text-end' : ''}">${value}</td>`;
                        }).join('');
                        return `<tr>${cells}</tr>`;
                    }).join('');

                    list.style.display = '';
                };

                function secondsToHMS(s) {
                    if (!s && s !== 0) return '–';
                    const h = Math.floor(s / 3600);
                    const m = Math.floor((s % 3600) / 60);
                    const sec = Math.floor(s % 60);
                    return [h>0?h+'h':null, m+'m', sec+'s'].filter(Boolean).join(' ');
                }

                window.refreshLiveQuery = async function () {
                    document.getElementById('live-query-loading').style.display = '';
                    document.getElementById('live-query-content').style.display = 'none';
                    document.getElementById('live-query-error').style.display = 'none';
                    document.getElementById('btn-refresh-query').disabled = true;

                    try {
                        const res  = await fetch(QUERY_URL, { credentials: 'same-origin' });
                        const data = await res.json();

                        if (!data.success) {
                            document.getElementById('live-query-error-msg').textContent = data.error || 'Abfrage fehlgeschlagen';
                            document.getElementById('live-query-error').style.display = '';
                            document.getElementById('live-query-loading').style.display = 'none';
                            return;
                        }

                        // Felder füllen
                        const currentPlayersCount = data.players?.length ?? 0;
                        const maxPlayersCount     = data.maxPlayers ?? 0;
                        document.getElementById('qry-players').textContent =
                            currentPlayersCount + ' / ' + (data.maxPlayers ?? '?');

                        // Spieler-Card oben live aktualisieren
                        const cpEl = document.querySelector('[data-current-players]');
                        if (cpEl) cpEl.textContent = currentPlayersCount + ' / ' + (data.maxPlayers ?? '?');
                        const barEl = document.querySelector('[data-players-bar]');
                        if (barEl && maxPlayersCount > 0) {
                            const pct = Math.round((currentPlayersCount / maxPlayersCount) * 100);
                            barEl.style.width = pct + '%';
                            barEl.textContent = pct + '%';
                        }

                        renderStatusFields(data);

                        // Spiel-spezifische Extras (Badges)
                        const extrasDiv = document.getElementById('qry-extras');
                        const badgesDiv = document.getElementById('qry-extras-badges');
                        const extra = data.extra || {};
                        const badges = [];
                        if (extra.pve) badges.push('<span class="badge bg-success"><i class="fas fa-dove me-1"></i>PvE</span>');
                        if (extra.oxide) badges.push('<span class="badge bg-info"><i class="fas fa-plug me-1"></i>Oxide</span>');
                        if (extra.wipeDate) badges.push('<span class="badge bg-secondary"><i class="fas fa-broom me-1"></i>Wipe: ' + new Date(Number(extra.wipeDate) * 1000).toLocaleDateString('de-DE') + '</span>');
                        if (badges.length > 0) {
                            badgesDiv.innerHTML = badges.join('');
                            extrasDiv.style.display = '';
                        } else {
                            extrasDiv.style.display = 'none';
                        }

                        // Ping-Badge
                        const badge = document.getElementById('query-ping-badge');
                        badge.textContent = data.ping != null ? data.ping + ' ms' : '';
                        badge.style.display = data.ping != null ? '' : 'none';

                        // Spielerliste – Zeilen folgen denselben Spalten wie der Header
                        window.renderQueryPlayers(data.players || []);

                        const stamp = document.getElementById('qry-last-update');
                        if (stamp) stamp.textContent = new Date().toLocaleTimeString('de-DE');

                        document.getElementById('live-query-content').style.display = '';
                        document.getElementById('live-query-loading').style.display = 'none';

                    } catch (e) {
                        document.getElementById('live-query-error-msg').textContent = 'Netzwerkfehler: ' + e.message;
                        document.getElementById('live-query-error').style.display = '';
                        document.getElementById('live-query-loading').style.display = 'none';
                    } finally {
                        document.getElementById('btn-refresh-query').disabled = false;
                    }
                };

                // Automatisch beim Laden ausführen
                refreshLiveQuery();
            })();
            </script>
        <% } %>
    </div>
</div>

<!-- ========================================
     CONFIGURATION (wenn vorhanden)
     ======================================== -->
<% if (server.launch_params || server.auto_restart !== null || server.auto_update !== null) { %>
    <div class="row mt-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-cogs me-2"></i>
                        Konfiguration
                    </h3>
                </div>
                <div class="card-body">
                    <table class="table table-sm">
                        <tbody>
                            <% if (server.launch_params) { %>
                                <tr>
                                    <th style="width: 30%">Start-Parameter:</th>
                                    <td>
                                        <!-- View-Mode -->
                                        <div id="launch-params-view">
                                            <div class="mb-2 d-flex align-items-start">
                                                <code class="d-block p-2 bg-light border rounded flex-grow-1" id="launch-params-display"><%= server.launch_params %></code>
                                                <% if (userPermissions.permissions['GAMESERVER.EDIT']) { %>
                                                    <button class="btn btn-sm btn-primary ms-2" onclick="toggleLaunchParamsEdit(true)" title="Bearbeiten">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                <% } %>
                                            </div>
                                            <small class="text-secondary">
                                                <i class="fas fa-lightbulb me-1"></i>
                                                <strong>Verfügbare Variablen:</strong><br>
                                                <code>{{PORT}}</code> - Game-Port,
                                                <code>{{QUERY_PORT}}</code> - Query-Port,
                                                <code>{{RCON_PORT}}</code> - RCON-Port,
                                                <code>{{MAX_PLAYERS}}</code> - Max. Spieler,
                                                <code>{{SERVER_NAME}}</code> - Server-Name
                                            </small>
                                        </div>
                                        
                                        <!-- Edit-Mode -->
                                        <div id="launch-params-edit" style="display: none;">
                                            <form class="guild-ajax-form" 
                                                  data-form-type="launch-params"
                                                  data-method="PUT"
                                                  action="/guild/<%= guildId %>/plugins/gameserver/servers/<%= server.id %>/launch-params"
                                                  method="POST">
                                                
                                                <textarea class="form-control font-monospace mb-2" 
                                                          name="launch_params" 
                                                          id="launch-params-input"
                                                          rows="3"
                                                          required
                                                          placeholder="z.B. -port {{PORT}} -maxplayers {{MAX_PLAYERS}}"
                                                          style="font-size: 0.9rem;"><%= server.launch_params %></textarea>
                                                
                                                <div class="d-flex gap-2">
                                                    <button type="submit" class="btn btn-sm btn-success">
                                                        <i class="fas fa-save me-1"></i> Speichern
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-secondary" onclick="toggleLaunchParamsEdit(false)">
                                                        <i class="fas fa-times me-1"></i> Abbrechen
                                                    </button>
                                                </div>
                                                
                                                <small class="text-secondary d-block mt-2">
                                                    <i class="fas fa-exclamation-triangle me-1"></i>
                                                    <strong>Wichtig:</strong> Änderungen werden erst nach Neustart des Servers aktiv!
                                                </small>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                            <% if (server.auto_restart !== null) { %>
                                <tr>
                                    <th>Auto-Restart:</th>
                                    <td>
                                        <% if (server.auto_restart) { %>
                                            <span class="badge bg-success">
                                                <i class="fas fa-check me-1"></i> Aktiviert
                                            </span>
                                        <% } else { %>
                                            <span class="badge bg-secondary">
                                                <i class="fas fa-times me-1"></i> Deaktiviert
                                            </span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% } %>
                            <% if (server.auto_update !== null) { %>
                                <tr>
                                    <th>Auto-Update:</th>
                                    <td>
                                        <% if (server.auto_update) { %>
                                            <span class="badge bg-success">
                                                <i class="fas fa-check me-1"></i> Aktiviert
                                            </span>
                                        <% } else { %>
                                            <span class="badge bg-secondary">
                                                <i class="fas fa-times me-1"></i> Deaktiviert
                                            </span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
<% } %>

<!-- ========================================
     SFTP-ZUGANGSDATEN
     ======================================== -->
<div class="row mt-3">
    <div class="col-12">
        <div class="card">
            <div class="card-status-top bg-info"></div>
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-folder-open me-2"></i>
                    SFTP-Zugang
                </h3>
                <div class="card-actions">
                    <% if (userPermissions && userPermissions.permissions && userPermissions.permissions['GAMESERVER.EDIT']) { %>
                    <button type="button"
                            class="btn btn-sm btn-warning"
                            id="sftp-reset-btn"
                            onclick="sftpResetPassword()">
                        <i class="fas fa-sync-alt me-1"></i>
                        Passwort zurücksetzen
                    </button>
                    <% } %>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 col-sm-6 mb-2">
                        <label class="text-secondary small mb-1 d-block">HOST</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control" id="sftp-host" value="<%= server.sftp_host %>" readonly>
                            <button class="btn btn-outline-secondary" onclick="copyToClipboard('<%= server.sftp_host %>')" title="Kopieren">
                            <i class="fas fa-copy"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-1 col-sm-6 mb-2">
                        <label class="text-secondary small mb-1 d-block">PORT</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control" value="<%= server.sftp_port %>" readonly>
                            <button class="btn btn-outline-secondary" onclick="copyToClipboard('<%= server.sftp_port %>')" title="Kopieren">
                            <i class="fas fa-copy"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-4 col-sm-6 mb-2">
                        <label class="text-secondary small mb-1 d-block">BENUTZERNAME</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control font-italic" id="sftp-user" value="<%= server.sftp_username || '' %>" readonly>
                            <button class="btn btn-outline-secondary" onclick="copyToClipboard('<%= server.sftp_username %>')" title="Kopieren">
                            <i class="fas fa-copy"></i>
                            </button>
                        </div>
                    </div>
                    <%#
                      Das Passwort steht hier NICHT.

                      Gespeichert ist nur sein bcrypt-Hash — es liesse sich also
                      gar nicht mehr anzeigen. Frueher stand der Klartext im
                      value-Attribut: Das Feld verbarg ihn nur optisch, im
                      Quelltext jeder Seitenauslieferung stand er lesbar.

                      Sichtbar wird ein Passwort nur einmal, direkt nachdem
                      "Zurücksetzen" ein neues erzeugt hat.
                    %>
                    <div class="col-md-4 col-sm-6 mb-2">
                        <label class="text-secondary small mb-1 d-block">PASSWORT</label>
                        <div class="input-group input-group-sm" id="sftp-pass-gruppe" style="display: none;">
                            <input type="text" class="form-control font-monospace" id="sftp-pass" value="" readonly>
                            <button class="btn btn-outline-secondary" onclick="copyToClipboard(document.getElementById('sftp-pass').value)" title="Kopieren">
                            <i class="fas fa-copy"></i>
                            </button>
                        </div>
                        <div class="form-control form-control-sm bg-transparent text-secondary" id="sftp-pass-hinweis">
<%#
                              Drei Zustaende, nicht zwei. Beim Anlegen wird ein Passwort
                              erzeugt, nur der Hash gespeichert und der Klartext verworfen —
                              "Gesetzt" sah danach aus wie "du hast es", obwohl es nie jemand
                              gesehen hat. Der einzige Weg dorthin ist "Zuruecksetzen".
                            %>
                            <% if (server.sftp_passwort_gesetzt && server.sftp_passwort_gesehen) { %>
                                <i class="fas fa-check-circle text-success me-1"></i>
                                Gesetzt — bei Verlust zurücksetzen
                            <% } else if (server.sftp_passwort_gesetzt) { %>
                                <i class="fas fa-eye-slash text-warning me-1"></i>
                                Vergeben, aber nie angezeigt — zum Verbinden einmal zurücksetzen
                            <% } else { %>
                                <i class="fas fa-triangle-exclamation text-warning me-1"></i>
                                Noch keines vergeben
                            <% } %>
                        </div>
                    </div>
                </div>
                <%#
                  Fingerabdruck des Host-Keys.

                  Beim ersten Verbinden fragt jeder Client "SHA256:… — diesem
                  Host vertrauen?". Ohne Vergleichswert klickt man das weg und
                  hofft; mit ihm wird daraus eine echte Pruefung. Der Wert kommt
                  vom Daemon bei jeder Anmeldung.
                %>
                <div class="mt-2">
                    <label class="text-secondary small mb-1 d-block">FINGERABDRUCK DES SERVERS</label>
                    <% if (server.sftp_fingerprint) { %>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control font-monospace" value="<%= server.sftp_fingerprint %>" readonly>
                            <button class="btn btn-outline-secondary" onclick="copyToClipboard('<%= server.sftp_fingerprint %>')" title="Kopieren">
                                <i class="fas fa-copy"></i>
                            </button>
                        </div>
                        <small class="text-secondary">
                            Beim ersten Verbinden fragt dein Programm danach — stimmt der Wert überein, ist es der richtige Server.
                        </small>
                    <% } else { %>
                        <div class="text-secondary small">
                            <i class="fas fa-circle-question me-1"></i>
                            Noch nicht gemeldet — der Daemon ist älter oder SFTP ist dort abgeschaltet.
                        </div>
                    <% } %>
                </div>

                <small class="text-secondary d-block mt-3">
                    <i class="fas fa-info-circle me-1"></i>
                    Verbindung: <code>sftp://<%= server.sftp_username %>@<%= server.sftp_host %>:<%= server.sftp_port %></code>
                    &nbsp;|&nbsp;
                    Client-Empfehlung: FileZilla, WinSCP
                </small>
            </div>
        </div>
    </div>
</div>

<script>
// Zeigt das frisch erzeugte Passwort. Es kommt nur mit dieser einen Antwort —
// gespeichert ist nur der Hash, ein spaeteres Nachschlagen gibt es nicht.
function zeigeNeuesSftpPasswort(passwort) {
    const gruppe  = document.getElementById('sftp-pass-gruppe');
    const hinweis = document.getElementById('sftp-pass-hinweis');

    document.getElementById('sftp-pass').value = passwort;
    gruppe.style.display = '';
    hinweis.innerHTML = '<i class="fas fa-triangle-exclamation text-warning me-1"></i> '
        + 'Jetzt kopieren — nach dem Neuladen ist es nicht mehr abrufbar.';
}

async function sftpResetPassword() {
    const btn = document.getElementById('sftp-reset-btn');
    if (!confirm('Passwort zurücksetzen? Das alte Passwort wird sofort ungültig.')) return;
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Wird gesetzt...';
    try {
        const resp = await fetch(
            `/guild/<%= guildId %>/plugins/gameserver/servers/<%= server.id %>/sftp/reset-password`,
            { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } }
        );
        const data = await resp.json();
        if (data.success) {
            document.getElementById('sftp-user').value = data.sftp_username;
            zeigeNeuesSftpPasswort(data.sftp_password);
            toastr.success('SFTP-Passwort erfolgreich zurückgesetzt!');
        } else {
            toastr.error(data.message || 'Passwort-Reset fehlgeschlagen.');
        }
    } catch (e) {
        toastr.error('Netzwerkfehler beim SFTP-Passwort-Reset.');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-sync-alt me-1"></i> Passwort zurücksetzen';
    }
}
</script>

<script>
/**
 * Toggle Launch-Params Edit-Mode
 */
function toggleLaunchParamsEdit(edit) {
    const viewMode = document.getElementById('launch-params-view');
    const editMode = document.getElementById('launch-params-edit');
    
    if (edit) {
        viewMode.style.display = 'none';
        editMode.style.display = 'block';
        document.getElementById('launch-params-input').focus();
    } else {
        viewMode.style.display = 'block';
        editMode.style.display = 'none';
    }
}
</script>
