<%#
  Anlegen, Schritt 3: Werte — Entwurf vom 2026-08-18, Artboard 5c.

  Gefragt wird nur, was ein Spieler entscheiden muss. Alles andere bleibt auf
  der Vorgabe des Pakets und wird als Satz gesagt, nicht als Formular vorgelegt.

  Der zweite Teil ist der eigentliche Gewinn: „Was jetzt passiert" sagt VORHER,
  was die Installation tun wird. Bisher klickte man „Erstellen" und wartete auf
  etwas Unbenanntes.
-%>
<div class="fb-seite">

  <div class="fb-seitenkopf">
    <div>
      <div class="fb-titel">Server anlegen</div>
      <div class="fb-muted" style="font-size:13px">
        Schritt 3 von 3 · Werte<%= locals.spielName ? ' · ' + spielName : '' %><%= werte.passiert.maschine ? ' auf ' + werte.passiert.maschine : '' %>
      </div>
    </div>
  </div>

  <form method="post" action="/guild/<%= guildId %>/plugins/gameserver/servers" id="fb-anlegen">
    <input type="hidden" name="addon_slug" value="<%= locals.addonSlug || '' %>">
    <input type="hidden" name="rootserver_id" value="<%= locals.rootserverId || '' %>">

    <div class="fb-raster">
      <div>
        <div class="fb-karte">
          <div class="fb-kopf"><span>Werte</span></div>
          <div style="padding:4px 20px 20px">
            <% werte.felder.forEach(function (f) { %>
              <div class="fb-zeile">
                <div>
                  <div style="font-weight:500">
                    <%= f.name %><% if (f.pflicht) { %> <span style="color:var(--fb-danger)">*</span><% } %>
                  </div>
                  <% if (f.beschreibung) { %>
                    <div class="fb-muted" style="font-size:13px;margin-top:2px;text-wrap:pretty"><%= f.beschreibung %></div>
                  <% } %>
                  <div style="margin-top:6px;display:flex;gap:6px;flex-wrap:wrap">
                    <% if (f.hinweis) { %><span class="fb-pille fb-pille-warn"><%= f.hinweis %></span><% } %>
                    <% if (f.wirkung && !f.hinweis) { %><span class="fb-pille"><%= f.wirkung.text %></span><% } %>
                  </div>
                </div>
                <div>
                  <% if (f.auswahl) { %>
                    <select class="fb-feld" style="width:100%" name="variable_<%= f.schluessel %>">
                      <% f.auswahl.forEach(function (c) { %>
                        <option value="<%= c.wert %>" <%= String(f.vorgabe) === c.wert ? 'selected' : '' %>><%= c.name %></option>
                      <% }); %>
                    </select>
                  <% } else if (f.typ === 'boolean') { %>
                    <select class="fb-feld" style="width:100%" name="variable_<%= f.schluessel %>">
                      <option value="1" <%= String(f.vorgabe) === '1' || f.vorgabe === true ? 'selected' : '' %>>An</option>
                      <option value="0" <%= String(f.vorgabe) === '1' || f.vorgabe === true ? '' : 'selected' %>>Aus</option>
                    </select>
                  <% } else { %>
                    <input class="fb-feld" style="width:100%"
                           type="<%= f.geheim ? 'password' : (f.typ === 'number' ? 'number' : 'text') %>"
                           name="variable_<%= f.schluessel %>"
                           <% if (f.min !== null) { %>min="<%= f.min %>"<% } %>
                           <% if (f.max !== null) { %>max="<%= f.max %>"<% } %>
                           <%= f.pflicht ? 'required' : '' %>
                           value="<%= f.geheim ? '' : (f.vorgabe !== undefined ? f.vorgabe : '') %>">
                  <% } %>
                </div>
              </div>
            <% }); %>

            <% if (werte.aufVorgabe > 0) { %>
              <div class="fb-muted" style="font-size:13px;margin-top:16px">
                <%= werte.aufVorgabe %> weitere Einstellungen bleiben auf ihrer Vorgabe.
                Ändern lassen sie sich danach jederzeit in der fachlichen Höhe.
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <div>
        <div class="fb-karte">
          <div class="fb-kopf"><span>Was jetzt passiert</span></div>
          <div class="fb-koerper" style="font-size:13px">
            <% if (werte.passiert.quelle) { %>
              <div style="padding:6px 0"><%= werte.passiert.quelle %></div>
            <% } %>
            <% if (werte.passiert.depotCache) { %>
              <div class="fb-muted" style="padding:6px 0">
                Geteilter Depot-Zwischenspeicher wird benutzt — beim zweiten Server
                desselben Spiels spart das die Manifeste.
              </div>
            <% } %>
            <% if (werte.passiert.image) { %>
              <div style="padding:6px 0;border-top:1px solid var(--fb-border)">
                <div class="fb-muted" style="font-size:12px">Image</div>
                <div class="fb-mono" style="word-break:break-all"><%= werte.passiert.image %></div>
                <div class="fb-muted" style="font-size:12px">
                  <%= werte.passiert.imageLiegtDa
                        ? 'Liegt auf ' + werte.passiert.maschine + ' — kein Download.'
                        : 'Wird auf die Maschine geholt, falls es dort fehlt.' %>
                </div>
              </div>
            <% } %>
            <% if (werte.passiert.adresse) { %>
              <div style="padding:6px 0;border-top:1px solid var(--fb-border)">
                <div class="fb-muted" style="font-size:12px">Deine Adresse</div>
                <div class="fb-mono"><%= werte.passiert.adresse %></div>
              </div>
            <% } %>
            <%# Keine Dauerangabe. Die Vorlage nennt „3–6 Min."; wir haben keine
                gemessene, und eine geschätzte stünde da wie eine Zusage — die
                erste Installation, die zwanzig Minuten braucht, macht sie zur
                Lüge. Der Fortschritt ist ohnehin live zu sehen. %>
          </div>
        </div>
      </div>
    </div>

    <div class="fb-fuss" style="border:0;margin-top:0">
      <span class="fb-muted">
        <%= werte.felder.filter(function (f) { return f.pflicht; }).length %> Pflichtangaben
      </span>
      <div style="margin-left:auto;display:flex;gap:8px">
        <a class="btn btn-white btn-sm" href="/guild/<%= guildId %>/plugins/gameserver/servers/create?step=2&addon_id=<%= locals.addonId || '' %>">Zurück</a>
        <button type="submit" class="btn btn-primary btn-sm">Anlegen und installieren</button>
      </div>
    </div>
  </form>
</div>
