<%#
  Anlegen, Schritt 3: Werte — Entwurf vom 2026-08-18, Artboard 5c.

  Gefragt wird nur, was ein Spieler entscheiden muss. Alles andere bleibt auf
  der Vorgabe des Pakets und wird als Satz gesagt, nicht als Formular vorgelegt.

  Der zweite Teil ist der eigentliche Gewinn: „Was jetzt passiert" sagt VORHER,
  was die Installation tun wird. Bisher klickte man „Erstellen" und wartete auf
  etwas Unbenanntes.
-%>
<div class="fb-seite">

  <div class="fb-seitenkopf">
    <div>
      <div class="fb-titel">Server anlegen</div>
      <div class="fb-muted" style="font-size:13px">
        Schritt 3 von 3 · Werte<%= locals.spielName ? ' · ' + spielName : '' %><%= werte.passiert.maschine ? ' auf ' + werte.passiert.maschine : '' %>
      </div>
    </div>
  </div>

  <form method="post" action="/guild/<%= guildId %>/plugins/gameserver/servers" id="fb-anlegen">
    <input type="hidden" name="addon_slug" value="<%= locals.addonSlug || '' %>">
    <input type="hidden" name="rootserver_id" value="<%= locals.rootserverId || '' %>">

    <div class="fb-raster">
      <div>
        <div class="fb-karte">
          <div class="fb-kopf"><span>Werte</span></div>
          <div style="padding:4px 20px 20px">
            <% werte.felder.forEach(function (f) { %>
              <div class="fb-zeile">
                <div>
                  <div style="font-weight:500">
                    <%= f.name %><% if (f.pflicht) { %> <span style="color:var(--fb-danger)">*</span><% } %>
                  </div>
                  <% if (f.beschreibung) { %>
                    <div class="fb-muted" style="font-size:13px;margin-top:2px;text-wrap:pretty"><%= f.beschreibung %></div>
                  <% } %>
                  <div style="margin-top:6px;display:flex;gap:6px;flex-wrap:wrap">
                    <% if (f.hinweis) { %><span class="fb-pille fb-pille-warn"><%= f.hinweis %></span><% } %>
                    <% if (f.wirkung && !f.hinweis) { %><span class="fb-pille"><%= f.wirkung.text %></span><% } %>
                  </div>
                </div>
                <div>
                  <% if (f.auswahl) { %>
                    <select class="fb-feld" style="width:100%" name="<%= f.istServerName ? 'server_name' : (f.variable ? 'variable_' + f.variable : 'variable_' + f.schluessel) %>">
                      <% f.auswahl.forEach(function (c) { %>
                        <option value="<%= c.wert %>" <%= String(f.vorgabe) === c.wert ? 'selected' : '' %>><%= c.name %></option>
                      <% }); %>
                    </select>
                  <% } else if (f.typ === 'boolean') { %>
                    <select class="fb-feld" style="width:100%" name="<%= f.istServerName ? 'server_name' : (f.variable ? 'variable_' + f.variable : 'variable_' + f.schluessel) %>">
                      <option value="1" <%= String(f.vorgabe) === '1' || f.vorgabe === true ? 'selected' : '' %>>An</option>
                      <option value="0" <%= String(f.vorgabe) === '1' || f.vorgabe === true ? '' : 'selected' %>>Aus</option>
                    </select>
                  <% } else { %>
                    <input class="fb-feld" style="width:100%"
                           type="<%= f.geheim ? 'password' : (f.typ === 'number' ? 'number' : 'text') %>"
                           name="<%= f.istServerName ? 'server_name' : (f.variable ? 'variable_' + f.variable : 'variable_' + f.schluessel) %>"
                           <% if (f.min !== null) { %>min="<%= f.min %>"<% } %>
                           <% if (f.max !== null) { %>max="<%= f.max %>"<% } %>
                           <%= f.pflicht ? 'required' : '' %>
                           value="<%= f.geheim ? '' : (f.vorgabe !== undefined ? f.vorgabe : '') %>">
                  <% } %>
                </div>
              </div>
            <% }); %>

            <%# ── Was der Server bekommen darf ─────────────────────────────
                Die Anlegeroute verlangt diese drei und rechnet sie gegen die
                Kapazitaet der Maschine. Sie sind ein Wert, den der Betreiber
                setzt — nicht das Paket: Der Bedarf steht dort ausdruecklich als
                „nicht gemessen — nicht geraten". %>
            <div class="fb-abschnitt">Was der Server bekommen darf</div>
            <% [['allocated_ram_mb','Arbeitsspeicher','MB',4096],
                ['allocated_cpu_percent','CPU','%',200],
                ['allocated_disk_gb','Platte','GB',20]].forEach(function (r) { %>
              <div class="fb-zeile">
                <div>
                  <div style="font-weight:500"><%= r[1] %></div>
                  <div class="fb-muted" style="font-size:13px;margin-top:2px">
                    Wird auf der Maschine gebucht, auch wenn der Server gerade weniger braucht.
                  </div>
                </div>
                <div style="display:flex;align-items:center;gap:8px">
                  <input class="fb-feld" style="width:100%" type="number" min="1" required
                         name="<%= r[0] %>" value="<%= r[3] %>">
                  <span class="fb-muted" style="font-size:13px"><%= r[2] %></span>
                </div>
              </div>
            <% }); %>

            <% if (werte.aufVorgabe > 0) { %>
              <div class="fb-muted" style="font-size:13px;margin-top:16px">
                <%= werte.aufVorgabe %> weitere Einstellungen bleiben auf ihrer Vorgabe.
                Ändern lassen sie sich danach jederzeit in der fachlichen Höhe.
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <div>
        <div class="fb-karte">
          <div class="fb-kopf"><span>Was jetzt passiert</span></div>
          <div class="fb-koerper" style="font-size:13px">
            <% if (werte.passiert.quelle) { %>
              <div style="padding:6px 0"><%= werte.passiert.quelle %></div>
            <% } %>
            <% if (werte.passiert.depotCache) { %>
              <div class="fb-muted" style="padding:6px 0">
                Geteilter Depot-Zwischenspeicher wird benutzt — beim zweiten Server
                desselben Spiels spart das die Manifeste.
              </div>
            <% } %>
            <% if (werte.passiert.image) { %>
              <div style="padding:6px 0;border-top:1px solid var(--fb-border)">
                <div class="fb-muted" style="font-size:12px">Image</div>
                <div class="fb-mono" style="word-break:break-all"><%= werte.passiert.image %></div>
                <div class="fb-muted" style="font-size:12px">
                  <%= werte.passiert.imageLiegtDa
                        ? 'Liegt auf ' + werte.passiert.maschine + ' — kein Download.'
                        : 'Wird auf die Maschine geholt, falls es dort fehlt.' %>
                </div>
              </div>
            <% } %>
            <% if (werte.passiert.adresse) { %>
              <div style="padding:6px 0;border-top:1px solid var(--fb-border)">
                <div class="fb-muted" style="font-size:12px">Deine Adresse</div>
                <div class="fb-mono"><%= werte.passiert.adresse %></div>
              </div>
            <% } %>
            <%# Keine Dauerangabe. Die Vorlage nennt „3–6 Min."; wir haben keine
                gemessene, und eine geschätzte stünde da wie eine Zusage — die
                erste Installation, die zwanzig Minuten braucht, macht sie zur
                Lüge. Der Fortschritt ist ohnehin live zu sehen. %>
          </div>
        </div>
      </div>
    </div>

    <div class="fb-fuss" style="border:0;margin-top:0">
      <span class="fb-muted">
        <%= werte.felder.filter(function (f) { return f.pflicht; }).length %> Pflichtangaben
      </span>
      <div style="margin-left:auto;display:flex;gap:8px">
        <a class="btn btn-white btn-sm" href="/guild/<%= guildId %>/plugins/gameserver/servers/create?step=2&addon=<%= locals.addonSlug || '' %>">Zurück</a>
        <button type="submit" class="btn btn-primary btn-sm" id="fb-absenden">Anlegen und installieren</button>
      </div>
    </div>

    <%# Platz für die Antwort — bis 2026-08-22 gab es keinen. -%>
    <div id="fb-fehler" class="fb-karte" style="display:none;border-color:var(--fb-danger);margin-top:12px">
      <div class="fb-koerper">
        <strong>Anlegen fehlgeschlagen</strong>
        <div class="fb-muted" id="fb-fehler-text" style="margin-top:4px;text-wrap:pretty"></div>
      </div>
    </div>
  </form>
</div>

<script>
/*
 * Das Formular schickte bis zum 2026-08-22 ganz normal ab — und die Route
 * antwortet JSON. Der Browser hat also getan, was er tun muss: Er hat den
 * JSON-Text als Seite angezeigt.
 *
 *   {"success":true,"message":"Server \"FireDervil\" wird installiert...",
 *    "serverId":161,"redirectUrl":"/guild/…/servers"}
 *
 * Die Route liefert `redirectUrl` sogar mit — es gab nur niemanden, der ihr
 * folgt. In der ganzen Datei stand keine Zeile JavaScript.
 *
 * Bewusst hier und nicht als Weiterleitung in der Route: Der FEHLERFALL braucht
 * denselben Weg. Eine Route, die bei Erfolg weiterleitet und bei einem Fehler
 * JSON zeigt, hätte die Hälfte des Problems gelassen — und zwar die Hälfte, in
 * der der Betreiber eine Erklärung braucht.
 */
(function () {
  var form  = document.getElementById('fb-anlegen');
  var knopf = document.getElementById('fb-absenden');
  var kasten= document.getElementById('fb-fehler');
  var text  = document.getElementById('fb-fehler-text');
  if (!form || !knopf) return;

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    kasten.style.display = 'none';
    knopf.disabled = true;
    knopf.textContent = 'Wird angelegt…';

    fetch(form.action, {
      method: 'POST',
      headers: { 'Accept': 'application/json' },
      body: new URLSearchParams(new FormData(form)),
    })
      .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
      .then(function (a) {
        if (a.ok && a.d && a.d.success) {
          window.location.href = a.d.redirectUrl ||
            form.action.replace(/\/create.*$/, '');
          return;
        }
        zeige((a.d && a.d.message) || 'Die Antwort des Servers war nicht lesbar.');
      })
      .catch(function (err) {
        // Ein Netzfehler ist etwas anderes als eine Ablehnung, und das gehört
        // gesagt: Der Server kann trotzdem angelegt worden sein.
        zeige('Die Anfrage kam nicht durch (' + err.message + '). ' +
              'Sieh in der Serverliste nach, bevor du es erneut versuchst.');
      });
  });

  function zeige(nachricht) {
    text.textContent = nachricht;
    kasten.style.display = '';
    knopf.disabled = false;
    knopf.textContent = 'Anlegen und installieren';
    kasten.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
})();
</script>
