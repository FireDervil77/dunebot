<!-- Addon Detail Page -->


            <!-- Hero Section -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card">
                        <div class="card-status-top bg-primary"></div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-8">
                                    <!-- Title & Badges -->
                                    <div class="mb-3">
                                        <% if (addon.trust_level === 'official') { %>
                                            <span class="badge bg-danger-lt badge-lg">
                                                <i class="fa-solid fa-crown"></i> OFFICIAL
                                            </span>
                                        <% } else if (addon.trust_level === 'trusted') { %>
                                            <span class="badge bg-success-lt badge-lg">
                                                <i class="fa-solid fa-shield-check"></i> TRUSTED
                                            </span>
                                        <% } else if (addon.trust_level === 'verified') { %>
                                            <span class="badge bg-primary-lt badge-lg">
                                                <i class="fa-solid fa-check-circle"></i> VERIFIED
                                            </span>
                                        <% } %>

                                        <span class="badge bg-info-lt badge-lg ms-2">
                                            <%= addon.category.toUpperCase() %>
                                        </span>

                                        <% if (addon.featured) { %>
                                            <span class="badge bg-warning-lt badge-lg ms-2">
                                                <i class="fa-solid fa-star"></i> FEATURED
                                            </span>
                                        <% } %>
                                    </div>

                                    <!-- Description -->
                                    <p class="lead"><%= addon.description %></p>

                                    <!-- Tags -->
                                    <%# Eine LISTE aus der Tag-Bibliothek. Bis zum 2026-10-07 stand hier
                                        `addon.tags.split(',')` — auf einem Feld, das der Adminbereich als
                                        JSON schrieb: gezeigt wurde `["SCI-FI"` samt Klammer. %>
                                    <% if (Array.isArray(addon.tags) && addon.tags.length) { %>
                                        <div class="mb-3">
                                            <% addon.tags.forEach(tag => { %>
                                                <span class="badge bg-secondary-lt me-1">
                                                    <i class="fa-solid fa-tag"></i> <%= tag %>
                                                </span>
                                            <% }) %>
                                        </div>
                                    <% } %>

                                    <!-- Author -->
                                    <p class="text-secondary">
                                        <i class="fa-solid fa-user"></i> 
                                        <%= tr('gameserver:ADDON.BY') %> <strong><%= addon.author_name || 'Unknown' %></strong>
                                    </p>
                                </div>

                                <div class="col-md-4">
                                    <!-- Stats -->
                                    <div class="card">
                                        <div class="card-body">
                                            <div class="mb-3">
                                                <h5><%= tr('gameserver:ADDON.RATING') %></h5>
                                                <% if (addon.rating_count > 0) { %>
                                                    <div class="h2 mb-0">
                                                        <i class="fa-solid fa-star text-warning"></i>
                                                        <%= addon.rating_avg ? addon.rating_avg.toFixed(1) : 0 %>/5
                                                    </div>
                                                    <small class="text-secondary">
                                                        <%= addon.rating_count %> <%= tr('gameserver:ADDON.REVIEWS') %>
                                                    </small>
                                                <% } else { %>
                                                    <p class="text-secondary">
                                                        <%= tr('gameserver:ADDON.NO_RATINGS_YET') %>
                                                    </p>
                                                <% } %>
                                            </div>

                                            <div class="mb-3">
                                                <h5><%= tr('gameserver:ADDON.DOWNLOADS') %></h5>
                                                <div class="h3 mb-0">
                                                    <i class="fa-solid fa-download text-info"></i>
                                                    <%= addon.downloads || 0 %>
                                                </div>
                                            </div>

                                            <div>
                                                <h5><%= tr('gameserver:ADDON.LAST_UPDATED') %></h5>
                                                <p class="text-secondary">
                                                    <%= new Date(addon.updated_at).toLocaleDateString('de-DE') %>
                                                </p>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- CTA Button -->
                                    <a href="/guild/<%= guildId %>/plugins/gameserver/servers/create?step=1&addon=<%= addon.slug %>" 
                                       class="btn btn-success btn-lg w-100">
                                        <i class="fa-solid fa-plus"></i> <%= tr('gameserver:ADDON.CREATE_SERVER') %>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <!-- Left Column -->
                <div class="col-lg-8">
                    <!-- Reviews -->
                    <% if (ratings && ratings.length > 0) { %>
                        <div class="card mb-4">
                            <div class="card-header">
                                <h3 class="card-title">
                                    <i class="fa-solid fa-star"></i>
                                    <%= tr('gameserver:ADDON.REVIEWS') %>
                                </h3>
                            </div>
                            <div class="card-body">
                                <% ratings.forEach(rating => { %>
                                    <div class="mb-3 pb-3 border-bottom">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div>
                                                <% for (let i = 1; i <= 5; i++) { %>
                                                    <% if (i <= rating.rating) { %>
                                                        <i class="fa-solid fa-star text-warning"></i>
                                                    <% } else { %>
                                                        <i class="fa-regular fa-star text-secondary"></i>
                                                    <% } %>
                                                <% } %>
                                            </div>
                                            <small class="text-secondary">
                                                <%= new Date(rating.created_at).toLocaleDateString('de-DE') %>
                                            </small>
                                        </div>
                                        <% if (rating.review_text) { %>
                                            <p><%= rating.review_text %></p>
                                        <% } %>
                                        <small class="text-secondary">
                                            <i class="fa-solid fa-clock"></i>
                                            <%= rating.usage_hours %> <%= tr('gameserver:ADDON.HOURS_USED') %>
                                            
                                            <% if (rating.helpful_count > 0) { %>
                                                | <i class="fa-solid fa-thumbs-up"></i> <%= rating.helpful_count %> <%= tr('gameserver:ADDON.HELPFUL') %>
                                            <% } %>
                                        </small>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>
                </div>

                <!-- Right Column -->
                <div class="col-lg-4">
                    <!-- Steam Info -->
                    <% if (addon.steam_app_id) { %>
                        <div class="card mb-4">
                            <div class="card-header">
                                <h3 class="card-title">
                                    <i class="fa-brands fa-steam"></i>
                                    Steam
                                </h3>
                            </div>
                            <div class="card-body">
                                <ul class="list-unstyled mb-0">
                                    <li class="mb-2">
                                        <strong><%= tr('gameserver:ADDON.APP_ID') %>:</strong><br>
                                        <%= addon.steam_app_id %>
                                    </li>
                                    <% if (addon.steam_server_app_id) { %>
                                        <li class="mb-2">
                                            <strong><%= tr('gameserver:ADDON.SERVER_APP_ID') %>:</strong><br>
                                            <%= addon.steam_server_app_id %>
                                        </li>
                                    <% } %>
                                </ul>
                                <a href="https://store.steampowered.com/app/<%= addon.steam_app_id %>" 
                                   target="_blank" 
                                   class="btn btn-dark btn-sm w-100 mt-3">
                                    <i class="fa-brands fa-steam"></i> <%= tr('gameserver:ADDON.VIEW_ON_STEAM') %>
                                </a>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>

