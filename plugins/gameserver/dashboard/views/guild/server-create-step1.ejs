<%#
  Anlegen, Schritt 1: Spiel — Entwurf vom 2026-08-18, Artboard 5a.

  Was diese Auswahl ehrlicher macht als eine Kachel mit Bild: Sie zeigt, was das
  Paket über sich selbst NICHT weiss. `status.open` ist genau dafür da und stand
  bisher nirgends.
-%>
<div class="fb-seite">

  <div class="fb-seitenkopf">
    <div>
      <div class="fb-titel">Server anlegen</div>
      <div class="fb-muted" style="font-size:13px">Schritt 1 von 3 · Spiel wählen</div>
    </div>
    <a class="btn btn-white btn-sm" href="/guild/<%= guildId %>/plugins/gameserver/servers">Abbrechen</a>
  </div>

  <form method="get" action="/guild/<%= guildId %>/plugins/gameserver/servers/create" id="fb-schritt1">
    <input type="hidden" name="step" value="2">
    <%# Die Route liest `addon` als SLUG (req.query.addon → WHERE slug = ?).
        Hier stand `addon_id` mit der Zahl — der Weiter-Knopf fuehrte damit auf
        Schritt 1 zurueck, weil `addon` leer war und der Zweig nie griff. %>
    <input type="hidden" name="addon" id="fb-gewaehlt" value="">

    <div class="fb-karte">
      <div class="fb-kopf">
        <span>Spiele mit Paket</span>
        <span class="fb-muted" style="margin-left:auto;font-size:13px;font-weight:400">
          <%= auswahl.pakete.length %> <%= auswahl.pakete.length === 1 ? 'Paket' : 'Pakete' %>
        </span>
      </div>
      <div class="fb-koerper">
        <% if (!auswahl.pakete.length) { %>
          <div class="fb-muted" style="font-size:13px">Noch kein Paket eingeliefert.</div>
        <% } %>
        <% auswahl.pakete.forEach(function (p) { %>
          <label class="fb-spiel" data-fb-wahl="<%= p.slug %>">
            <input type="radio" name="_wahl" value="<%= p.slug %>" hidden>
            <div style="display:flex;gap:12px;align-items:start">
              <div style="flex:1 1 auto">
                <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                  <span style="font-weight:600;font-size:15px"><%= p.name %></span>
                  <% if (p.kategorie) { %><span class="fb-pille"><%= p.kategorie %></span><% } %>
                  <% if (p.version) { %>
                    <span class="fb-pille fb-mono"><%= p.version %><%= p.kanal ? ' · ' + p.kanal : '' %></span>
                  <% } %>
                </div>
                <% if (p.beschreibung) { %>
                  <div class="fb-muted" style="font-size:13px;margin-top:3px;text-wrap:pretty"><%= p.beschreibung %></div>
                <% } %>

                <div style="margin-top:8px;display:flex;gap:14px;flex-wrap:wrap;font-size:13px">
                  <% if (p.bedarf && (p.bedarf.ram || p.bedarf.platte)) { %>
                    <span><%= [p.bedarf.ram, p.bedarf.platte].filter(Boolean).join(' · ') %></span>
                    <% if (p.bedarf.grundlage) { %><span class="fb-muted"><%= p.bedarf.grundlage %></span><% } %>
                  <% } else { %>
                    <%# „nicht geraten" ist der wichtigere Teil des Satzes: Eine
                        geratene Zahl sähe hilfreicher aus und wäre schlechter —
                        wer 2 GB liest, bucht 2 GB, und der Server stirbt beim
                        dritten Spieler. %>
                    <span class="fb-muted">Bedarf nicht gemessen — nicht geraten.</span>
                  <% } %>
                </div>

                <% if (p.offen.length) { %>
                  <details style="margin-top:8px">
                    <summary style="cursor:pointer;font-size:13px;color:#b35309">
                      <%= p.offen.length %> <%= p.offen.length === 1 ? 'Punkt' : 'Punkte' %> an diesem Paket ungeprüft
                    </summary>
                    <ul class="fb-muted" style="font-size:12.25px;margin:6px 0 0;padding-left:18px">
                      <% p.offen.forEach(function (o) { %><li style="margin-bottom:3px"><%= o %></li><% }); %>
                    </ul>
                  </details>
                <% } %>

                <% if (p.quelle) { %>
                  <div class="fb-muted fb-mono" style="font-size:12px;margin-top:6px"><%= p.quelle %></div>
                <% } %>
              </div>
              <span class="fb-haken">✓</span>
            </div>
          </label>
        <% }); %>
      </div>
    </div>

    <% if (auswahl.ohnePaket.length) { %>
      <div class="fb-karte">
        <div class="fb-kopf">
          <span>Spiele ohne Paket</span>
          <span class="fb-muted" style="margin-left:auto;font-size:13px;font-weight:400">
            noch nicht anlegbar
          </span>
        </div>
        <div class="fb-koerper">
          <%# Sie verschwinden NICHT aus der Auswahl. Heute hat eines von acht
              Spielen ein Paket; die anderen wegzulassen hiesse, sieben Spiele
              unanlegbar zu machen, damit eine Liste sauber aussieht. %>
          <%# Nicht waehlbar, und zwar mit Absicht.
              Betreiber am 2026-08-19: „nein wir wollen nix altes mehr."
              Sie ueber den alten Egg-Weg anzulegen hiesse, weiter Server zu
              erzeugen, die genau das mitbringen, was dieser ganze Umbau
              abschafft — Fremd-Image, Skript in die Volume-Wurzel, kein
              fb-init. Sie stehen hier trotzdem, damit sichtbar bleibt, was
              noch fehlt. %>
          <% auswahl.ohnePaket.forEach(function (a) { %>
            <div class="fb-spiel aus">
              <div style="display:flex;gap:12px;align-items:center">
                <div style="flex:1 1 auto">
                  <div style="font-weight:600;font-size:15px"><%= a.name %></div>
                  <div class="fb-muted" style="font-size:13px">
                    Für dieses Spiel gibt es noch kein Paket. Sobald eines eingeliefert ist,
                    lässt es sich hier anlegen.
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>

    <div class="fb-fuss" style="border:0;margin-top:0">
      <span class="fb-muted" id="fb-wahl-text">Noch nichts gewählt</span>
      <div style="margin-left:auto;display:flex;gap:8px">
        <a class="btn btn-white btn-sm" href="/guild/<%= guildId %>/plugins/gameserver/servers">Abbrechen</a>
        <button type="submit" class="btn btn-primary btn-sm" id="fb-weiter" disabled>Weiter zur Maschine</button>
      </div>
    </div>
  </form>

</div>

<script>
(function () {
  var text = document.getElementById('fb-wahl-text');
  var weiter = document.getElementById('fb-weiter');
  var feld = document.getElementById('fb-gewaehlt');
  document.querySelectorAll('.fb-spiel').forEach(function (k) {
    k.addEventListener('click', function () {
      document.querySelectorAll('.fb-spiel').forEach(function (x) { x.classList.remove('an'); });
      k.classList.add('an');
      var name = k.querySelector('span[style*="font-weight:600"], div[style*="font-weight:600"]');
      feld.value = k.getAttribute('data-fb-wahl');
      text.textContent = (name ? name.textContent.trim() : 'Spiel') + ' gewählt';
      weiter.disabled = false;
    });
  });
})();
</script>
