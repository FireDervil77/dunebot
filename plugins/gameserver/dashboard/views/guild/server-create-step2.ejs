<%#
  Anlegen, Schritt 2: Maschine — Entwurf vom 2026-08-18, Artboard 5b.

  Die Karte zeigt GEBUCHTES, nicht Benutztes: Was ein Server gerade braucht,
  schwankt mit den Spielern; was er bekommen darf, steht fest. Wer nach der
  Momentanlast bucht, stellt neun Server auf eine Maschine, weil abends gerade
  keiner spielt.

  Und sie lehnt eine Maschine ab, wenn das Portpaar nicht frei ist — mit Grund,
  bevor jemand durch zwei weitere Schritte klickt.
-%>
<div class="fb-seite">

  <div class="fb-seitenkopf">
    <div>
      <div class="fb-titel">Server anlegen</div>
      <div class="fb-muted" style="font-size:13px">
        Schritt 2 von 3 · Maschine wählen<%= locals.spielName ? ' · ' + spielName : '' %>
      </div>
    </div>
    <a class="btn btn-white btn-sm" href="/guild/<%= guildId %>/plugins/gameserver/servers/create">Zurück</a>
  </div>

  <form method="get" action="/guild/<%= guildId %>/plugins/gameserver/servers/create">
    <input type="hidden" name="step" value="3">
    <input type="hidden" name="addon_id" value="<%= locals.addonId || '' %>">
    <input type="hidden" name="rootserver_id" id="fb-maschine" value="">

    <% maschinen.forEach(function (m) { %>
      <div class="fb-karte fb-maschine<%= m.waehlbar ? '' : ' aus' %>" data-fb-wahl="<%= m.waehlbar ? m.id : '' %>">
        <div class="fb-koerper">
          <div style="display:flex;gap:14px;align-items:start;flex-wrap:wrap">
            <div style="flex:1 1 260px">
              <div style="display:flex;align-items:center;gap:8px">
                <span style="font-weight:600;font-size:15px"><%= m.name %></span>
                <% if (!m.erreichbar) { %><span class="fb-pille">nicht erreichbar</span><% } %>
                <% if (m.server) { %><span class="fb-pille"><%= m.server %> Server</span><% } %>
              </div>
              <% if (m.host) { %><div class="fb-muted fb-mono" style="font-size:12px"><%= m.host %></div><% } %>
            </div>

            <div style="flex:2 1 320px;display:grid;grid-template-columns:repeat(3,1fr);gap:14px">
              <% [['Platte', m.platte, 'GB'], ['RAM gebucht', m.ram, 'GB'], ['CPU gebucht', m.cpu, '%']].forEach(function (z) { %>
                <div>
                  <div class="fb-muted" style="font-size:12px"><%= z[0] %></div>
                  <div class="fb-mono" style="font-size:14px">
                    <%= z[1].gebucht %> / <%= z[1].gesamt !== null ? z[1].gesamt : '?' %> <%= z[2] %>
                  </div>
                  <% if (z[1].gesamt) { %>
                    <div style="height:4px;border-radius:100rem;background:#eef1f5;margin-top:4px;overflow:hidden">
                      <div style="height:4px;width:<%= Math.min(100, Math.round(z[1].gebucht / z[1].gesamt * 100)) %>%;background:<%=
                        z[1].gebucht / z[1].gesamt > .85 ? 'var(--fb-warning)' : 'var(--fb-primary)' %>"></div>
                    </div>
                  <% } %>
                </div>
              <% }); %>
            </div>

            <div style="flex:1 1 220px">
              <% if (m.paar) { %>
                <div class="fb-muted" style="font-size:12px">Ports frei</div>
                <div class="fb-mono" style="font-size:14px">
                  <%= m.paar.spiel %><% m.paar.weitere.forEach(function (w) { %> · <%= w.port %><% }); %>
                </div>
                <div class="fb-muted" style="font-size:12px">
                  Spiel<% m.paar.weitere.forEach(function (w) { %> · <%= w.zweck %><% }); %>
                </div>
              <% } else { %>
                <%# Ausgewichen wird bewusst NICHT auf einen anderen Port: Der
                    Client sucht dann dort, wo nichts lauscht, und der Fehler
                    heisst „Server nicht gefunden" — weit weg von der Ursache. %>
                <span class="fb-pille fb-pille-warn">nicht möglich</span>
                <div class="fb-muted" style="font-size:12px;margin-top:4px;text-wrap:pretty"><%= m.grund %></div>
              <% } %>
            </div>

            <span class="fb-haken" style="align-self:center">✓</span>
          </div>
        </div>
      </div>
    <% }); %>

    <div class="fb-fuss" style="border:0;margin-top:0">
      <span class="fb-muted" id="fb-wahl-text">Noch keine Maschine gewählt</span>
      <div style="margin-left:auto;display:flex;gap:8px">
        <a class="btn btn-white btn-sm" href="/guild/<%= guildId %>/plugins/gameserver/servers/create">Zurück</a>
        <button type="submit" class="btn btn-primary btn-sm" id="fb-weiter" disabled>Weiter zu den Werten</button>
      </div>
    </div>
  </form>
</div>

<script>
(function () {
  var t = document.getElementById('fb-wahl-text'), w = document.getElementById('fb-weiter'),
      f = document.getElementById('fb-maschine');
  document.querySelectorAll('.fb-maschine').forEach(function (k) {
    var id = k.getAttribute('data-fb-wahl');
    if (!id) return;
    k.style.cursor = 'pointer';
    k.addEventListener('click', function () {
      document.querySelectorAll('.fb-maschine').forEach(function (x) { x.classList.remove('an'); });
      k.classList.add('an'); f.value = id;
      var n = k.querySelector('span[style*="font-weight:600"]');
      var p = k.querySelector('.fb-mono');
      t.textContent = (n ? n.textContent.trim() : 'Maschine') + ' gewählt';
      w.disabled = false;
    });
  });
})();
</script>
