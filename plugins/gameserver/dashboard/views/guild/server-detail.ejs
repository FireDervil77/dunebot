<%# 
  * Server-Detail-View mit Tabbed-Interface
  * Zeigt Übersicht, Console, Files, Logs, Backups, Settings
  * @author FireBot Team
  %>

<div class="container-fluid">
    <!-- ========================================
         SERVER HEADER
         ======================================== -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="row align-items-center">
                        <!-- Game Icon & Info -->
                        <div class="col-md-8">
                            <div class="d-flex align-items-center">
                                <!-- Game Icon -->
                                <% if (server.game_icon) { %>
                                    <img src="<%= server.game_icon %>" 
                                         alt="<%= server.game_name %>" 
                                         class="rounded me-3"
                                         style="width: 64px; height: 64px; object-fit: cover;">
                                <% } else { %>
                                    <div class="bg-secondary text-white rounded d-flex align-items-center justify-content-center me-3" 
                                         style="width: 64px; height: 64px;">
                                        <i class="fas fa-gamepad fa-2x"></i>
                                    </div>
                                <% } %>
                                
                                <!-- Server Info -->
                                <div>
                                    <h3 class="mb-1"><%= server.name %></h3>
                                    <p class="text-muted mb-1">
                                        <i class="fas fa-server me-1"></i>
                                        <%= server.game_name || 'Unbekanntes Spiel' %>
                                    </p>
                                    <div>
                                        <% 
                                        // Status-Badge-Mapping (running → online, stopped → offline)
                                        let displayStatus = server.status;
                                        if (displayStatus === 'running') {
                                            displayStatus = 'online';
                                        } else if (displayStatus === 'stopped') {
                                            displayStatus = 'offline';
                                        }
                                        
                                        const statusColors = {
                                            online: 'success',
                                            offline: 'secondary',
                                            starting: 'warning',
                                            stopping: 'warning',
                                            error: 'danger',
                                            installing: 'info',
                                            installed: 'success'
                                        };
                                        const statusIcons = {
                                            online: 'fa-check-circle',
                                            offline: 'fa-circle',
                                            starting: 'fa-spinner fa-spin',
                                            stopping: 'fa-spinner fa-spin',
                                            error: 'fa-exclamation-triangle',
                                            installing: 'fa-download',
                                            installed: 'fa-check-circle'
                                        };
                                        const color = statusColors[displayStatus] || 'secondary';
                                        const icon = statusIcons[displayStatus] || 'fa-circle';
                                        %>
                                        <span class="badge bg-<%= color %>" data-server-status>
                                            <i class="fas <%= icon %> me-1"></i>
                                            <span data-status-text><%= displayStatus %></span>
                                        </span>
                                        
                                        <!-- Connection Info (nur bei online) -->
                                        <% if (server.status === 'online' && server.ip_address && server.port_game) { %>
                                            <span class="badge bg-info ms-2">
                                                <i class="fas fa-plug me-1"></i>
                                                <%= server.ip_address %>:<%= server.port_game %>
                                            </span>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Quick Actions -->
                        <div class="col-md-4 text-end">
                            <div class="btn-group" role="group">
                                <!-- Start Button (immer rendern, Sichtbarkeit via JS) -->
                                <% if (userPermissions.permissions['GAMESERVER.START']) { %>
                                    <button class="btn btn-success" 
                                            onclick="serverAction('<%= server.id %>', 'start')"
                                            title="Server starten"
                                            style="display: <%= (displayStatus === 'offline' || displayStatus === 'error' || displayStatus === 'installed') ? '' : 'none' %>;">
                                        <i class="fas fa-play me-1"></i> Start
                                    </button>
                                <% } %>
                                
                                <!-- Stop Button (immer rendern, Sichtbarkeit via JS) -->
                                <% if (userPermissions.permissions['GAMESERVER.STOP']) { %>
                                    <button class="btn btn-danger" 
                                            onclick="serverAction('<%= server.id %>', 'stop')"
                                            title="Server stoppen"
                                            style="display: <%= (displayStatus === 'online' || displayStatus === 'starting') ? '' : 'none' %>;">
                                        <i class="fas fa-stop me-1"></i> Stop
                                    </button>
                                <% } %>
                                
                                <!-- Restart Button (immer rendern, Sichtbarkeit via JS) -->
                                <% if (userPermissions.permissions['GAMESERVER.RESTART']) { %>
                                    <button class="btn btn-warning" 
                                            onclick="serverAction('<%= server.id %>', 'restart')"
                                            title="Server neu starten"
                                            style="display: <%= displayStatus === 'online' ? '' : 'none' %>;">
                                        <i class="fas fa-redo me-1"></i> Restart
                                    </button>
                                <% } %>
                                
<!-- Reinstall Button -->
                                <% if (userPermissions.permissions['GAMESERVER.CREATE']) { %>
                                    <button class="btn btn-primary" 
                                            onclick="reinstallServer('<%= server.id %>', '<%= server.name %>')" 
                                            title="Server neu installieren">
                                        <i class="fas fa-wrench me-1"></i> Reinstall
                                    </button>
                                <% } %>
                                
<!-- Move Button (Server-Migration) -->
                                <%# Auch bei 'online' sichtbar: Die Migration stoppt den Server
                                    selbst als ersten Schritt (siehe MigrationManager) und das Modal
                                    warnt explizit davor. Nur während laufender Aktionen
                                    (installing/updating/starting/stopping) ausblenden. %>
                                <% if (userPermissions.permissions['GAMESERVER.EDIT']) { %>
                                    <button class="btn btn-info"
                                            data-toggle="modal"
                                            data-target="#migrationModal"
                                            title="Server zu anderem RootServer verschieben"
                                            style="display: <%= ['offline', 'error', 'installed', 'online'].includes(displayStatus) ? '' : 'none' %>;">
                                        <i class="fas fa-exchange-alt me-1"></i> Move
                                    </button>
                                <% } %>
                                
                                <!-- Edit Button -->
                                <% if (userPermissions.permissions['GAMESERVER.EDIT']) { %>
                                    <a href="/guild/<%= guildId %>/plugins/gameserver/servers/<%= server.id %>/edit" 
                                       class="btn btn-secondary"
                                       title="Server bearbeiten">
                                        <i class="fas fa-cog me-1"></i> Einstellungen
                                    </a>
                                <% } %>
                                
                                <!-- Delete/Uninstall Button (nur sichtbar wenn offline/stopped/installed) -->
                                <% if (userPermissions.permissions['GAMESERVER.DELETE']) { %>
                                    <button class="btn btn-danger" 
                                            onclick="deleteServer('<%= server.id %>', '<%= server.name %>')"
                                            title="Server deinstallieren"
                                            style="display: <%= (displayStatus === 'offline' || displayStatus === 'error' || displayStatus === 'installed') ? '' : 'none' %>;">
                                        <i class="fas fa-trash me-1"></i> Löschen
                                    </button>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================
         TABBED INTERFACE
         ======================================== -->
    <div class="row">
        <div class="col-12">
            <div class="card card-primary card-outline card-tabs">
                <!-- Tab Navigation -->
                <div class="card-header p-0 pt-1 border-bottom-0">
                    <ul class="nav nav-tabs" id="server-tabs" role="tablist">
                        <!-- Overview Tab -->
                        <li class="nav-item">
                            <a class="nav-link active" 
                               id="overview-tab" 
                               data-toggle="tab" 
                               href="#overview" 
                               role="tab">
                                <i class="fas fa-info-circle me-1"></i>
                                Übersicht
                            </a>
                        </li>
                        
                        <!-- Console Tab (nur mit Permission) -->
                        <% if (userPermissions.permissions['GAMESERVER.CONSOLE.VIEW']) { %>
                            <li class="nav-item">
                                <a class="nav-link" 
                                   id="console-tab" 
                                   data-toggle="tab" 
                                   href="#console" 
                                   role="tab">
                                    <i class="fas fa-terminal me-1"></i>
                                    Console
                                </a>
                            </li>
                        <% } %>
                        
                        <!-- Files Tab (nur mit Permission) -->
                        <% if (userPermissions.permissions['GAMESERVER.FILES.VIEW']) { %>
                            <li class="nav-item">
                                <a class="nav-link" 
                                   id="files-tab" 
                                   data-toggle="tab" 
                                   href="#files" 
                                   role="tab">
                                    <i class="fas fa-folder me-1"></i>
                                    Dateien
                                </a>
                            </li>
                        <% } %>
                        
                        <!-- Logs Tab (nur mit Permission) -->
                        <% if (userPermissions.permissions['GAMESERVER.LOGS.VIEW']) { %>
                            <li class="nav-item">
                                <a class="nav-link" 
                                   id="logs-tab" 
                                   data-toggle="tab" 
                                   href="#logs" 
                                   role="tab">
                                    <i class="fas fa-file-alt me-1"></i>
                                    Logs
                                </a>
                            </li>
                        <% } %>
                        
                        <!-- Backups Tab (nur mit Permission) -->
                        <% if (userPermissions.permissions['GAMESERVER.BACKUPS.VIEW']) { %>
                            <li class="nav-item">
                                <a class="nav-link" 
                                   id="backups-tab" 
                                   data-toggle="tab" 
                                   href="#backups" 
                                   role="tab">
                                    <i class="fas fa-save me-1"></i>
                                    Backups
                                </a>
                            </li>
                        <% } %>

                        <!-- Cronjobs Tab (nur mit Permission) -->
                        <% if (userPermissions.permissions['GAMESERVER.CRONJOBS.VIEW']) { %>
                            <li class="nav-item">
                                <a class="nav-link"
                                   id="cronjobs-tab"
                                   data-toggle="tab"
                                   href="#cronjobs"
                                   role="tab">
                                    <i class="fas fa-clock me-1"></i>
                                    Cronjobs
                                </a>
                            </li>
                        <% } %>

                        <!-- Variablen Tab (nur mit EDIT-Permission) -->
                        <% if (userPermissions.permissions['GAMESERVER.EDIT'] && gameData && gameData.variables && (Array.isArray(gameData.variables) ? gameData.variables.length > 0 : Object.keys(gameData.variables).length > 0)) { %>
                            <li class="nav-item">
                                <a class="nav-link"
                                   id="variables-tab"
                                   data-toggle="tab"
                                   href="#variables"
                                   role="tab">
                                    <i class="fas fa-sliders-h me-1"></i>
                                    Variablen
                                </a>
                            </li>
                        <% } %>

                        <!-- RCON Tab (nur wenn Egg RCON unterstützt + RCON-Permission) -->
                        <% if (server.rcon_configured && userPermissions.permissions['GAMESERVER.RCON']) { %>
                            <li class="nav-item">
                                <a class="nav-link"
                                   id="rcon-tab"
                                   data-toggle="tab"
                                   href="#rcon"
                                   role="tab">
                                    <i class="fas fa-terminal me-1"></i>
                                    RCON
                                </a>
                            </li>
                        <% } %>

                        <!-- Discord-Panels (Konfiguration ist eine Verwaltungsaufgabe) -->
                        <% if (userPermissions.permissions['GAMESERVER.EDIT']) { %>
                            <li class="nav-item">
                                <a class="nav-link"
                                   id="panels-tab"
                                   data-toggle="tab"
                                   href="#panels"
                                   role="tab">
                                    <i class="fab fa-discord me-1"></i>
                                    Discord
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   id="public-tab"
                                   data-toggle="tab"
                                   href="#public"
                                   role="tab">
                                    <i class="fas fa-globe me-1"></i>
                                    Öffentlich
                                </a>
                            </li>
                        <% } %>
                    </ul>
                </div>

                <!-- Tab Content -->
                <div class="card-body">
                    <div class="tab-content" id="server-tabs-content">
                        <!-- ========================================
                             TAB: OVERVIEW
                             ======================================== -->
                        <div class="tab-pane fade show active" 
                             id="overview" 
                             role="tabpanel">
                            <%- include('partials/server-detail-overview', { server, gameData, guildId, userPermissions }) %>
                        </div>

                        <!-- ========================================
                             TAB: CONSOLE
                             ======================================== -->
                        <% if (userPermissions.permissions['GAMESERVER.CONSOLE.VIEW']) { %>
                            <div class="tab-pane fade" 
                                 id="console" 
                                 role="tabpanel">
                                <%- include('partials/server-detail-console', { server, guildId, userPermissions, consoleTransport: locals.consoleTransport }) %>
                            </div>
                        <% } %>

                        <!-- ========================================
                             TAB: FILES
                             ======================================== -->
                        <% if (userPermissions.permissions['GAMESERVER.FILES.VIEW']) { %>
                            <div class="tab-pane fade" 
                                 id="files" 
                                 role="tabpanel">
                                <%- include('partials/server-detail-files', { server, guildId, userPermissions }) %>
                            </div>
                        <% } %>

                        <!-- ========================================
                             TAB: LOGS
                             ======================================== -->
                        <% if (userPermissions.permissions['GAMESERVER.LOGS.VIEW']) { %>
                            <div class="tab-pane fade" 
                                 id="logs" 
                                 role="tabpanel">
                                <!-- Log Controls -->
                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="fas fa-search"></i></span>
                                            <input type="text" class="form-control" id="log-search" placeholder="Logs durchsuchen...">
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <select class="form-select" id="log-lines">
                                            <option value="100">Letzte 100 Zeilen</option>
                                            <option value="500" selected>Letzte 500 Zeilen</option>
                                            <option value="1000">Letzte 1000 Zeilen</option>
                                            <option value="2000">Letzte 2000 Zeilen</option>
                                        </select>
                                    </div>
                                    <div class="col-md-5 text-end">
                                        <button class="btn btn-primary" id="log-refresh" onclick="loadLogs()">
                                            <i class="fas fa-sync-alt me-1"></i> Aktualisieren
                                        </button>
                                        <button class="btn btn-secondary" id="log-download" onclick="downloadLogs()">
                                            <i class="fas fa-download me-1"></i> Download
                                        </button>
                                    </div>
                                </div>

                                <!-- Log Output -->
                                <div class="card bg-dark">
                                    <div class="card-body p-0">
                                        <div id="log-status" class="text-center text-muted py-3">
                                            <i class="fas fa-info-circle me-1"></i> Klicke "Aktualisieren" um Logs zu laden
                                        </div>
                                        <pre id="log-output" class="mb-0 p-3" style="max-height: 600px; overflow-y: auto; font-size: 13px; line-height: 1.4; color: #e0e0e0; background: #1e1e1e; display: none; white-space: pre-wrap; word-break: break-all;"></pre>
                                    </div>
                                    <div class="card-footer text-muted d-flex justify-content-between">
                                        <span id="log-count">0 Zeilen</span>
                                        <span id="log-filtered" style="display: none;">Gefiltert: <span id="log-filtered-count">0</span> Treffer</span>
                                    </div>
                                </div>

                                <script>
                                let _logLines = [];

                                async function loadLogs() {
                                    const btn = document.getElementById('log-refresh');
                                    const output = document.getElementById('log-output');
                                    const status = document.getElementById('log-status');
                                    const lines = document.getElementById('log-lines').value;

                                    btn.disabled = true;
                                    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Lade...';
                                    status.style.display = 'block';
                                    status.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Logs werden geladen...';
                                    output.style.display = 'none';

                                    try {
                                        const res = await fetch(`/guild/<%= guildId %>/plugins/gameserver/console/<%= server.id %>/logs?lines=${lines}`);
                                        const data = await res.json();

                                        if (data.success && data.lines) {
                                            _logLines = data.lines;
                                            renderLogs(_logLines);
                                            document.getElementById('log-count').textContent = `${data.count} Zeilen`;
                                        } else {
                                            status.style.display = 'block';
                                            status.innerHTML = `<i class="fas fa-exclamation-triangle text-warning me-1"></i> ${data.error || 'Keine Logs verfügbar'}`;
                                            output.style.display = 'none';
                                        }
                                    } catch (err) {
                                        status.style.display = 'block';
                                        status.innerHTML = '<i class="fas fa-times text-danger me-1"></i> Fehler beim Laden der Logs';
                                        output.style.display = 'none';
                                    } finally {
                                        btn.disabled = false;
                                        btn.innerHTML = '<i class="fas fa-sync-alt me-1"></i> Aktualisieren';
                                    }
                                }

                                function renderLogs(lines) {
                                    const output = document.getElementById('log-output');
                                    const status = document.getElementById('log-status');

                                    // HTML-Entities escapen
                                    const escaped = lines.map(l => 
                                        l.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                                    ).join('\n');

                                    output.textContent = '';
                                    output.innerHTML = escaped;
                                    output.style.display = 'block';
                                    status.style.display = 'none';

                                    // Auto-scroll nach unten
                                    output.scrollTop = output.scrollHeight;
                                }

                                function downloadLogs() {
                                    if (!_logLines.length) return;
                                    const blob = new Blob([_logLines.join('\n')], { type: 'text/plain' });
                                    const url = URL.createObjectURL(blob);
                                    const a = document.createElement('a');
                                    a.href = url;
                                    a.download = `server-<%= server.id %>-logs-${new Date().toISOString().slice(0,10)}.log`;
                                    a.click();
                                    URL.revokeObjectURL(url);
                                }

                                // Suchfilter
                                document.getElementById('log-search').addEventListener('input', function() {
                                    const query = this.value.toLowerCase().trim();
                                    const filteredEl = document.getElementById('log-filtered');
                                    const filteredCountEl = document.getElementById('log-filtered-count');

                                    if (!query) {
                                        renderLogs(_logLines);
                                        filteredEl.style.display = 'none';
                                        return;
                                    }

                                    const filtered = _logLines.filter(l => l.toLowerCase().includes(query));
                                    renderLogs(filtered);
                                    filteredEl.style.display = '';
                                    filteredCountEl.textContent = filtered.length;
                                });
                                </script>
                            </div>
                        <% } %>

                        <!-- ========================================
                             TAB: BACKUPS
                             ======================================== -->
                        <% if (userPermissions.permissions['GAMESERVER.BACKUPS.VIEW']) { %>
                            <div class="tab-pane fade"
                                 id="backups"
                                 role="tabpanel">
                                <%- include('partials/server-detail-backups', { server, guildId, userPermissions }) %>
                            </div>
                        <% } %>

                        <!-- ========================================
                             TAB: CRONJOBS
                             ======================================== -->
                        <% if (userPermissions.permissions['GAMESERVER.CRONJOBS.VIEW']) { %>
                            <div class="tab-pane fade"
                                 id="cronjobs"
                                 role="tabpanel">
                                <%- include('partials/server-detail-cronjobs', { server, guildId, userPermissions }) %>
                            </div>
                        <% } %>

                        <!-- ========================================
                             TAB: VARIABLEN
                             ======================================== -->
                        <% if (userPermissions.permissions['GAMESERVER.EDIT'] && gameData && gameData.variables) { %>
                            <div class="tab-pane fade"
                                 id="variables"
                                 role="tabpanel">
                                <%- include('partials/server-detail-variables', { server, gameData, guildId, userPermissions }) %>
                            </div>
                        <% } %>

                        <!-- ========================================
                             TAB: RCON
                             ======================================== -->
                        <% if (server.rcon_configured && userPermissions.permissions['GAMESERVER.RCON']) { %>
                            <div class="tab-pane fade"
                                 id="rcon"
                                 role="tabpanel">
                                <%- include('partials/server-detail-rcon', { server, guildId, userPermissions }) %>
                            </div>
                        <% } %>

                        <!-- ========================================
                             TAB: DISCORD-PANELS
                             ======================================== -->
                        <% if (userPermissions.permissions['GAMESERVER.EDIT']) { %>
                            <div class="tab-pane fade"
                                 id="panels"
                                 role="tabpanel">
                                <%- include('partials/server-detail-panels', { server, guildId, userPermissions }) %>
                            </div>

                            <!-- ========================================
                                 TAB: ÖFFENTLICHER STATUS
                                 ======================================== -->
                            <div class="tab-pane fade"
                                 id="public"
                                 role="tabpanel">
                                <%- include('partials/server-detail-public', { server, guildId, userPermissions }) %>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Scripts (aus dashboard/public/js/) -->
<script src="/assets/plugins/gameserver/js/server-actions.js"></script>
<!-- Hinweis: servers-overview.js bewusst NICHT laden, um SSE-Kollisionen (Pause bei Tab-Inaktivität) auf der Detailseite zu vermeiden -->
<script>
// Guild-ID und Server-ID für Auto-Initialisierung bereitstellen
window.gameserverGuildId = '<%= guildId %>';
window.gameserverServerId = '<%= server.id %>';
</script>

<!-- Leichter SSE-Client nur für Status-Updates der Detailseite -->
<% if (locals.assetManager) { %>
    <% assetManager.enqueueScript('gameserver-sse'); %>
<% } else { %>
    <!-- Fallback für Entwicklung ohne AssetManager -->
    <script src="/assets/plugins/gameserver/js/gameserver-sse.js"></script>
<% } %>

<script>
// Minimaler SSE-Listener für Status-Updates (gefiltert auf diesen Server)
document.addEventListener('DOMContentLoaded', function() {
    if (typeof GameserverSSEClient === 'undefined') {
        console.warn('[Detail] GameserverSSEClient nicht verfügbar – Status-Updates werden nicht live empfangen.');
        return;
    }

    const guildId = window.gameserverGuildId;
    const serverId = window.gameserverServerId;
    const sse = new GameserverSSEClient(guildId, { serverId });

    // Initialen Status vom Server (EJS) tracken, um Übergänge zu erkennen
    let lastKnownStatus = '<%= server.status %>';

    // Helper zum Updaten der Status-Badge und Buttons
    // ✅ Global exponiert, damit server-actions.js Zwischenstatus setzen kann
    window.updateDetailUI = function updateDetailUI(status) {
        // Mapping wie im Overview
        const map = { running: 'online', stopped: 'offline' };
        const normalized = map[status] || status;
        const colors = { online: 'success', offline: 'secondary', starting: 'warning', stopping: 'warning', error: 'danger', installing: 'info', installed: 'success' };
        const icons = { online: 'fa-check-circle', offline: 'fa-circle', starting: 'fa-spinner fa-spin', stopping: 'fa-spinner fa-spin', error: 'fa-exclamation-triangle', installing: 'fa-download', installed: 'fa-check-circle' };

        const badge = document.querySelector('[data-server-status]');
        if (badge) {
            const textEl = badge.querySelector('[data-status-text]');
            const iconEl = badge.querySelector('i.fas');
            badge.className = `badge bg-${colors[normalized] || 'secondary'}`;
            if (textEl) textEl.textContent = normalized;
            if (iconEl) iconEl.className = `fas ${icons[normalized] || 'fa-circle'} me-1`;
        }

        // Alle weiteren [data-server-status] Badges mitaktualisieren (z.B. Overview-Tab)
        document.querySelectorAll('[data-server-status]').forEach(el => {
            if (el === badge) return; // Header-Badge bereits oben behandelt
            const textEl = el.querySelector('[data-status-text]');
            el.className = `badge bg-${colors[normalized] || 'secondary'}`;
            if (textEl) textEl.textContent = normalized;
        });

        // Action-Buttons
        const group = document.querySelector('.btn-group[role="group"]');
        if (group) {
            const startBtn = group.querySelector('button[onclick*="start"]');
            const stopBtn = group.querySelector('button[onclick*="stop"]');
            const restartBtn = group.querySelector('button[onclick*="restart"]');
            const deleteBtn = group.querySelector('button[onclick*="deleteServer"]');
            const reinstallBtn = group.querySelector('button[onclick*="reinstallServer"]');

            if (startBtn) startBtn.style.display = (normalized === 'offline' || normalized === 'error' || normalized === 'installed') ? '' : 'none';
            if (stopBtn) stopBtn.style.display = (normalized === 'online' || normalized === 'starting') ? '' : 'none';
            if (restartBtn) restartBtn.style.display = (normalized === 'online') ? '' : 'none';
            // Reinstall-Button immer anzeigen
            if (reinstallBtn) reinstallBtn.style.display = '';
            if (deleteBtn) deleteBtn.style.display = (normalized === 'offline' || normalized === 'error' || normalized === 'installed') ? '' : 'none';
        }
    };

    // Events binden
    sse.on('status_changed', (msg) => {
        // msg: { action: 'status_changed', server_id, status, ... }
        if (msg.server_id === String(serverId) || msg.server_id === serverId) {
            const newStatus = msg.status;
            const normalized = { running: 'online', stopped: 'offline' }[newStatus] || newStatus;
            const prevNormalized = { running: 'online', stopped: 'offline' }[lastKnownStatus] || lastKnownStatus;

            updateDetailUI(newStatus);

            const justStarted = (normalized === 'online') && (prevNormalized !== 'online');
            const justStopped = (normalized === 'offline') && (prevNormalized !== 'offline' && prevNormalized !== 'error');

            if (justStarted || justStopped) {
                const msg_text = justStarted
                    ? '✅ Server gestartet'
                    : '🔴 Server gestoppt';

                if (typeof Toastify !== 'undefined') {
                    Toastify({
                        text: msg_text,
                        duration: 3000,
                        gravity: 'top',
                        position: 'right',
                        style: {
                            background: justStarted
                                ? 'linear-gradient(to right, #00b09b, #96c93d)'
                                : 'linear-gradient(to right, #555, #888)',
                        },
                    }).showToast();
                }

                // Statische Server-Infos (IP, Ports etc.) per AJAX nachladen statt Seiten-Reload.
                // Die Konsole läuft dabei weiter.
                // ✅ Kleiner Delay damit DB-Status sicher aktualisiert ist
                setTimeout(() => _refreshServerInfoPanel(), 500);
            }

            lastKnownStatus = newStatus;
        }
    });

    // Aktualisiert Infos im Overview-Tab (IP, Ports, Ressourcen) ohne Seiten-Reload.
    async function _refreshServerInfoPanel() {
        try {
            const res = await fetch(window.location.href, {
                headers: { 'X-Partial': '1' }
            });
            if (!res.ok) return;
            const html = await res.text();
            const doc = new DOMParser().parseFromString(html, 'text/html');
            // Nur den Overview-Tab-Inhalt austauschen, nicht die gesamte Seite
            const newOverview = doc.querySelector('#overview');
            const curOverview = document.querySelector('#overview');
            if (newOverview && curOverview) {
                curOverview.innerHTML = newOverview.innerHTML;
                
                // ✅ Scripts nach innerHTML-Swap manuell ausführen
                // (innerHTML führt <script>-Tags nicht automatisch aus)
                curOverview.querySelectorAll('script').forEach(oldScript => {
                    const newScript = document.createElement('script');
                    Array.from(oldScript.attributes).forEach(attr => 
                        newScript.setAttribute(attr.name, attr.value)
                    );
                    newScript.textContent = oldScript.textContent;
                    oldScript.parentNode.replaceChild(newScript, oldScript);
                });
            }
        } catch (e) {
            console.debug('[Detail] _refreshServerInfoPanel fehlgeschlagen (ignoriere):', e?.message);
        }
    }

    // Install-Completion Handler
    sse.on('install_completed', (msg) => {
        if (msg.server_id === String(serverId) || msg.server_id === serverId) {
            console.log('[Detail] Installation abgeschlossen:', msg);
            updateDetailUI('installed'); // Installation fertig → installed (zeigt Start-Button)
            
            // Toast-Benachrichtigung
            if (typeof Toastify !== 'undefined') {
                Toastify({
                    text: `✅ Installation von ${msg.server_name || 'Server'} abgeschlossen!`,
                    duration: 5000,
                    gravity: "top",
                    position: "right",
                    style: {
                        background: "linear-gradient(to right, #00b09b, #96c93d)",
                    },
                }).showToast();
            }
        }
    });

    // Install-Failed Handler
    sse.on('install_failed', (msg) => {
        if (msg.server_id === String(serverId) || msg.server_id === serverId) {
            console.error('[Detail] Installation fehlgeschlagen:', msg);
            updateDetailUI('error');
            
            // Error-Toast
            if (typeof Toastify !== 'undefined') {
                Toastify({
                    text: `❌ Installation fehlgeschlagen: ${msg.error || 'Unbekannter Fehler'}`,
                    duration: 8000,
                    gravity: "top",
                    position: "right",
                    style: {
                        background: "linear-gradient(to right, #ff5f6d, #ffc371)",
                    },
                }).showToast();
            }
        }
    });

    // Resource-Metrics live updaten (CPU, RAM)
    sse.on('server_stats', (msg) => {
        if (msg.server_id !== String(serverId) && msg.server_id !== serverId) return;

        // CPU
        const cpuText = document.querySelector('[data-metric-cpu-text]');
        const cpuBar = document.querySelector('[data-metric-cpu-bar]');
        if (cpuText && msg.cpu_percent != null) {
            const cpu = parseFloat(msg.cpu_percent);
            cpuText.textContent = cpu.toFixed(1) + '%';
            if (cpuBar) {
                cpuBar.style.width = cpu + '%';
                cpuBar.textContent = cpu.toFixed(1) + '%';
                cpuBar.className = 'progress-bar ' + (cpu > 80 ? 'bg-danger' : cpu > 50 ? 'bg-warning' : 'bg-success');
            }
        }

        // RAM
        const ramText = document.querySelector('[data-metric-ram-text]');
        const ramBar = document.querySelector('[data-metric-ram-bar]');
        if (ramText && msg.ram_used_mb != null && msg.ram_total_mb) {
            ramText.textContent = msg.ram_used_mb + ' / ' + msg.ram_total_mb + ' MB';
            if (ramBar) {
                const ramPct = (msg.ram_total_mb > 0) ? (msg.ram_used_mb / msg.ram_total_mb) * 100 : 0;
                ramBar.style.width = ramPct + '%';
                ramBar.textContent = ramPct.toFixed(1) + '%';
                ramBar.className = 'progress-bar ' + (ramPct > 80 ? 'bg-danger' : ramPct > 50 ? 'bg-warning' : 'bg-info');
            }
        }

        // Players (optional, falls im gleichen Event)
        if (msg.current_players != null) {
            const playersEl = document.querySelector('[data-current-players]');
            if (playersEl) {
                playersEl.textContent = msg.current_players + ' / ' + (msg.max_players || '?');
            }
            const playersBar = document.querySelector('[data-players-bar]');
            if (playersBar && msg.max_players > 0) {
                const pct = (msg.current_players / msg.max_players) * 100;
                playersBar.style.width = pct + '%';
                playersBar.textContent = pct.toFixed(0) + '%';
            }
        }

        // Live-Badge anzeigen
        const liveBadge = document.getElementById('metrics-live-badge');
        if (liveBadge) liveBadge.style.display = '';
        const lastUpdate = document.getElementById('metrics-last-update');
        if (lastUpdate) lastUpdate.textContent = new Date().toLocaleTimeString('de-DE');
    });

    // Live-Status vom StatusPoller (Spielerzahl, Map, Ping, Version).
    // Versorgt sowohl die Kacheln oben als auch die "Live-Status"-Karte – die wurde
    // vorher nur beim Seitenaufruf und beim Klick auf "Aktualisieren" gefüllt und
    // zeigte dazwischen einen veralteten Stand.
    sse.on('status', (msg) => {
        if (String(msg.server_id) !== String(serverId)) return;

        const setText = (selectorOrId, value, { byId = false } = {}) => {
            const el = byId ? document.getElementById(selectorOrId) : document.querySelector(selectorOrId);
            if (el && value != null && value !== '') el.textContent = value;
        };

        // Kacheln oben
        if (msg.current_players != null) {
            setText('[data-current-players]', msg.current_players + ' / ' + (msg.max_players || '?'));
        }
        const playersBar = document.querySelector('[data-players-bar]');
        if (playersBar && msg.max_players > 0) {
            const pct = (msg.current_players / msg.max_players) * 100;
            playersBar.style.width = pct + '%';
            playersBar.textContent = pct.toFixed(0) + '%';
        }
        setText('[data-current-map]', msg.map);

        // Live-Status-Karte
        if (msg.current_players != null) {
            setText('qry-players', msg.current_players + ' / ' + (msg.max_players ?? '?'), { byId: true });
        }
        setText('qry-map', msg.map, { byId: true });
        if (msg.ping_ms != null) setText('qry-ping', msg.ping_ms + ' ms', { byId: true });
        if (msg.version) {
            setText('qry-version', msg.version, { byId: true });
            const versionCol = document.getElementById('qry-version-col');
            if (versionCol) versionCol.style.display = '';
        }

        // Spielerliste mitziehen, wenn der Poller sie geliefert hat
        if (Array.isArray(msg.players) && typeof window.renderQueryPlayers === 'function') {
            window.renderQueryPlayers(msg.players);
        }

        const stamp = document.getElementById('qry-last-update');
        if (stamp) stamp.textContent = new Date().toLocaleTimeString('de-DE');
    });

    sse.connect();
    window.addEventListener('beforeunload', () => sse.disconnect());

    // Expose für Debugging
    window.gameserverDetailSSE = sse;
});
</script>

<!-- ========================================
     MIGRATION MODAL
     ======================================== -->
<div class="modal fade" id="migrationModal" tabindex="-1" aria-labelledby="migrationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="migrationModalLabel">
                    <i class="fas fa-exchange-alt me-2"></i>
                    Server verschieben
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Migration Form (Initial) -->
                <div id="migration-form">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Hinweis:</strong> Der Server wird während der Migration gestoppt und ist vorübergehend nicht verfügbar.
                    </div>
                    
                    <div class="mb-3">
                        <label for="target-rootserver" class="form-label">Ziel-RootServer auswählen</label>
                        <select class="form-select" id="target-rootserver" required>
                            <option value="">-- Bitte wählen --</option>
                            <% if (rootServers && rootServers.length > 0) { %>
                                <% rootServers.forEach(rs => { %>
                                    <% if (rs.id !== server.rootserver_id) { %>
                                        <% 
                                        const isOnline = rs.daemon_status === 'online';
                                        const isUnknown = !rs.daemon_status || rs.daemon_status === 'offline';
                                        const icon = isOnline ? '🟢' : isUnknown ? '🟡' : '🔴';
                                        const label = isOnline ? '' : isUnknown ? '(Status unbekannt)' : '(Offline)';
                                        %>
                                        <option value="<%= rs.id %>">
                                            <%= icon %> <%= rs.name %> <%= label %>
                                        </option>
                                    <% } %>
                                <% }); %>
                            <% } else { %>
                                <option disabled>Keine anderen RootServers verfügbar</option>
                            <% } %>
                        </select>
                    </div>
                    
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Wichtig:</strong>
                        <ul class="mb-0 mt-2">
                            <li>Der Server wird automatisch gestoppt</li>
                            <li>Alle Dateien werden kopiert (kann einige Minuten dauern)</li>
                            <li>Ports werden automatisch angepasst falls nötig</li>
                            <li>Der Server startet NICHT automatisch nach der Migration</li>
                        </ul>
                    </div>
                </div>
                
                <!-- Migration Progress (Hidden initially) -->
                <div id="migration-progress" style="display: none;">
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong id="migration-step-text">Initialisierung...</strong>
                            <span id="migration-percentage" class="badge bg-primary">0%</span>
                        </div>
                        <div class="progress" style="height: 30px;">
                            <div id="migration-progress-bar"
                                 class="progress-bar progress-bar-striped progress-bar-animated"
                                 role="progressbar"
                                 style="width: 0%;">
                            </div>
                        </div>
                        <!-- Detailzeile: Laufzeit / übertragene MB, damit lange Schritte nicht eingefroren wirken -->
                        <small id="migration-detail" class="text-muted d-block mt-2">
                            <i class="fas fa-circle-notch fa-spin me-1"></i>Migration wird vorbereitet...
                        </small>
                        <small class="text-muted d-block mt-1">
                            <i class="fas fa-info-circle me-1"></i>
                            Du kannst dieses Fenster schließen – die Migration läuft im Hintergrund weiter.
                        </small>
                    </div>
                    
                    <!-- Phase Indicators -->
                    <div class="row text-center mb-3">
                        <div class="col" data-phase="stopping_server">
                            <i class="fas fa-stop-circle fa-2x text-muted"></i>
                            <p class="small mb-0">Stoppen</p>
                        </div>
                        <div class="col" data-phase="backing_up">
                            <i class="fas fa-archive fa-2x text-muted"></i>
                            <p class="small mb-0">Backup</p>
                        </div>
                        <div class="col" data-phase="transferring">
                            <i class="fas fa-exchange-alt fa-2x text-muted"></i>
                            <p class="small mb-0">Transfer</p>
                        </div>
                        <div class="col" data-phase="restoring">
                            <i class="fas fa-box-open fa-2x text-muted"></i>
                            <p class="small mb-0">Restore</p>
                        </div>
                        <div class="col" data-phase="updating_db">
                            <i class="fas fa-database fa-2x text-muted"></i>
                            <p class="small mb-0">DB-Update</p>
                        </div>
                        <div class="col" data-phase="completed">
                            <i class="fas fa-check-circle fa-2x text-muted"></i>
                            <p class="small mb-0">Fertig</p>
                        </div>
                    </div>
                    
                    <!-- Error Display -->
                    <div id="migration-error" class="alert alert-danger" style="display: none;">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        <strong>Fehler:</strong>
                        <p id="migration-error-message" class="mb-0 mt-2"></p>
                    </div>
                    
                    <!-- Success Display -->
                    <div id="migration-success" class="alert alert-success" style="display: none;">
                        <i class="fas fa-check-circle me-2"></i>
                        <strong>Migration erfolgreich!</strong>
                        <p class="mb-0 mt-2">Der Server wurde erfolgreich verschoben. Du kannst ihn jetzt starten.</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal" id="migration-close-btn">Schließen</button>
                <button type="button" class="btn btn-primary" onclick="startMigration()" id="migration-start-btn">
                    <i class="fas fa-rocket me-1"></i> Migration starten
                </button>
            </div>
        </div>
    </div>
</div>

<script>
// Migration starten
function startMigration() {
    const targetRootServerId = document.getElementById('target-rootserver').value;
    
    if (!targetRootServerId) {
        alert('Bitte wähle einen Ziel-RootServer aus');
        return;
    }
    
    // UI umschalten
    document.getElementById('migration-form').style.display = 'none';
    document.getElementById('migration-progress').style.display = 'block';
    document.getElementById('migration-start-btn').disabled = true;
    // Schließen bleibt erlaubt: Die Migration läuft serverseitig weiter und der
    // Fortschritt wird beim erneuten Öffnen wiederhergestellt.
    document.getElementById('migration-close-btn').disabled = false;

    // API-Call
    fetch(`/guild/<%= guildId %>/plugins/gameserver/servers/<%= server.id %>/migrate`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({
            target_rootserver_id: parseInt(targetRootServerId, 10)
        })
    })
    .then(res => res.json())
    .then(data => {
        if (!data.success) {
            showMigrationError(data.message || 'Unbekannter Fehler');
            return;
        }
        
        // Migration-ID speichern
        window.currentMigrationId = data.migration_id;
        
        // SSE für Updates vorbereiten
        setupMigrationSSE();
    })
    .catch(err => {
        showMigrationError('Netzwerkfehler: ' + err.message);
    });
}

// SSE für Migration-Updates
// WICHTIG: gameserverDetailSSE ist ein GameserverSSEClient (kein EventSource) —
// die API heißt on(action, handler), NICHT addEventListener!
let migrationSSERegistered = false;
function setupMigrationSSE() {
    if (!window.gameserverDetailSSE) return;
    if (migrationSSERegistered) return; // Handler nur einmal registrieren (nicht pro Migration-Start)
    migrationSSERegistered = true;

    window.gameserverDetailSSE.on('gameserver_migration', (data) => {
        console.log('[Migration SSE]', data);

        if (data.type === 'migration_progress') {
            updateMigrationProgress(data.step, data.progress, data.detail);
        } else if (data.type === 'migration_completed') {
            showMigrationSuccess();
        } else if (data.type === 'migration_failed') {
            showMigrationError(data.error || 'Migration fehlgeschlagen');
        }
    });
}

// Reihenfolge der Phasen — bestimmt, welche Icons als "erledigt" markiert werden.
// Die Keys entsprechen den data-phase-Attributen der Indikatoren.
const MIGRATION_PHASES = ['stopping_server', 'backing_up', 'transferring', 'restoring', 'updating_db', 'completed'];

// Backend-Schritte → Phase-Indikator (Backend sendet z.B. 'stopping'/'uploading')
const STEP_TO_PHASE = {
    pending: 'stopping_server',
    stopping: 'stopping_server',
    stopping_server: 'stopping_server',
    backing_up: 'backing_up',
    transferring: 'transferring',
    uploading: 'transferring',
    restoring: 'restoring',
    updating_db: 'updating_db',
    completed: 'completed'
};

// Progress aktualisieren
function updateMigrationProgress(step, progress, detail) {
    const progressBar = document.getElementById('migration-progress-bar');
    const percentage = document.getElementById('migration-percentage');
    const stepText = document.getElementById('migration-step-text');
    const detailEl = document.getElementById('migration-detail');

    // Progress Bar
    progressBar.style.width = progress + '%';
    percentage.textContent = progress + '%';

    // Step-Text
    const stepNames = {
        pending: '⏳ Migration wird vorbereitet...',
        stopping: '⏹ Server wird gestoppt...',
        stopping_server: '⏹ Server wird gestoppt...',
        backing_up: '📦 Backup wird erstellt...',
        transferring: '🔄 Daten werden übertragen...',
        uploading: '🔄 Daten werden übertragen...',
        restoring: '📥 Server wird wiederhergestellt...',
        updating_db: '💾 Datenbank wird aktualisiert...',
        completed: '✅ Migration abgeschlossen'
    };
    stepText.textContent = stepNames[step] || step;

    // Detailzeile (Laufzeit / übertragene MB) — zeigt, dass etwas passiert
    if (detailEl) {
        detailEl.innerHTML = detail
            ? '<i class="fas fa-circle-notch fa-spin me-1"></i>' + detail
            : '<i class="fas fa-circle-notch fa-spin me-1"></i>Bitte warten...';
    }

    // Phase-Indikatoren: erledigte grün, aktuelle blau, kommende grau
    const phase = STEP_TO_PHASE[step] || step;
    const currentIndex = MIGRATION_PHASES.indexOf(phase);

    document.querySelectorAll('[data-phase]').forEach(el => {
        const icon = el.querySelector('i');
        if (!icon) return;
        const elIndex = MIGRATION_PHASES.indexOf(el.dataset.phase);
        icon.classList.remove('text-muted', 'text-primary', 'text-success');

        if (currentIndex >= 0 && elIndex >= 0 && elIndex < currentIndex) {
            icon.classList.add('text-success');   // erledigt
        } else if (elIndex === currentIndex) {
            icon.classList.add('text-primary');   // läuft gerade
        } else {
            icon.classList.add('text-muted');     // steht noch aus
        }
    });
}

// Fehler anzeigen
function showMigrationError(message) {
    document.getElementById('migration-error').style.display = 'block';
    document.getElementById('migration-error-message').textContent = message;
    document.getElementById('migration-start-btn').disabled = true;
    document.getElementById('migration-close-btn').disabled = false;
    
    const progressBar = document.getElementById('migration-progress-bar');
    progressBar.classList.remove('progress-bar-animated');
    progressBar.classList.add('bg-danger');
}

// Erfolg anzeigen
function showMigrationSuccess() {
    document.getElementById('migration-success').style.display = 'block';
    document.getElementById('migration-close-btn').disabled = false;
    
    const progressBar = document.getElementById('migration-progress-bar');
    progressBar.style.width = '100%';
    progressBar.classList.remove('progress-bar-animated');
    progressBar.classList.add('bg-success');
    
    document.getElementById('migration-percentage').textContent = '100%';
    document.getElementById('migration-step-text').textContent = '✅ Migration abgeschlossen';
    
    // Alle Phasen als erfolgreich markieren
    document.querySelectorAll('[data-phase]').forEach(el => {
        el.querySelector('i').classList.remove('text-muted', 'text-primary');
        el.querySelector('i').classList.add('text-success');
    });
    
    // Page reload nach 3 Sekunden
    setTimeout(() => {
        window.location.reload();
    }, 3000);
}

// ============================================================
// Laufende Migration wiederaufnehmen
// Die Migration läuft serverseitig weiter, auch wenn das Modal geschlossen
// oder die Seite neu geladen wird. Beim Öffnen wird deshalb geprüft, ob für
// diesen Server gerade eine Migration läuft — und der Fortschritt wiederhergestellt.
// ============================================================
const MIGRATION_RUNNING_STATES = ['pending', 'stopping_server', 'backing_up', 'transferring', 'restoring', 'updating_db'];

async function fetchMigrationStatus() {
    try {
        const res = await fetch(`/guild/<%= guildId %>/plugins/gameserver/servers/<%= server.id %>/migration/status`);
        if (!res.ok) return null;                 // 404 = noch nie migriert
        const data = await res.json();
        return (data && data.success && data.migration) ? data.migration : null;
    } catch (_) {
        return null;
    }
}

// Modal in den "läuft gerade"-Zustand versetzen
function showMigrationRunningState(migration) {
    document.getElementById('migration-form').style.display = 'none';
    document.getElementById('migration-progress').style.display = 'block';
    document.getElementById('migration-error').style.display = 'none';
    document.getElementById('migration-success').style.display = 'none';
    document.getElementById('migration-start-btn').disabled = true;
    document.getElementById('migration-close-btn').disabled = false; // Schließen erlaubt!

    updateMigrationProgress(
        migration.status,
        migration.progress_percent || 0,
        migration.current_step || 'Migration läuft...'
    );

    setupMigrationSSE(); // Live-Updates ab jetzt wieder empfangen
}

// Beim Öffnen des Modals: läuft gerade eine Migration?
$('#migrationModal').on('shown.bs.modal', async function () {
    const migration = await fetchMigrationStatus();
    if (migration && MIGRATION_RUNNING_STATES.includes(migration.status)) {
        showMigrationRunningState(migration);
    }
});

// Modal-Reset beim Schließen (Bootstrap 4 nutzt jQuery)
// Der Reset ist unkritisch: Läuft die Migration noch, stellt der
// 'shown'-Handler den Fortschritt beim nächsten Öffnen wieder her.
$('#migrationModal').on('hidden.bs.modal', function () {
    document.getElementById('migration-form').style.display = 'block';
    document.getElementById('migration-progress').style.display = 'none';
    document.getElementById('migration-error').style.display = 'none';
    document.getElementById('migration-success').style.display = 'none';
    document.getElementById('migration-start-btn').disabled = false;
    document.getElementById('migration-close-btn').disabled = false;
    document.getElementById('target-rootserver').value = '';
});

// Beim Laden der Seite prüfen: läuft eine Migration? Dann Button kennzeichnen,
// damit der Nutzer sieht, dass im Hintergrund etwas passiert.
async function initMigrationPageState() {
    const migration = await fetchMigrationStatus();
    if (!migration || !MIGRATION_RUNNING_STATES.includes(migration.status)) return;

    const moveBtn = document.querySelector('[data-target="#migrationModal"]');
    if (moveBtn) {
        moveBtn.classList.remove('btn-info');
        moveBtn.classList.add('btn-warning');
        moveBtn.innerHTML = '<i class="fas fa-circle-notch fa-spin me-1"></i> Migration läuft';
        moveBtn.style.display = '';
    }

    // SSE-Handler registrieren, damit auch ohne geöffnetes Modal der Abschluss
    // mitbekommen wird. Der SSE-Client wird in einem früheren DOMContentLoaded
    // aufgebaut — falls er noch nicht bereitsteht, kurz erneut versuchen.
    if (window.gameserverDetailSSE) {
        setupMigrationSSE();
    } else {
        setTimeout(() => { if (window.gameserverDetailSSE) setupMigrationSSE(); }, 1000);
    }
}

// Läuft auch, wenn das DOM zum Zeitpunkt der Skriptausführung schon fertig ist
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMigrationPageState);
} else {
    initMigrationPageState();
}
</script>
