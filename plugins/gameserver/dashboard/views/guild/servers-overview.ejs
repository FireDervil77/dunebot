<%#
  Die Serverübersicht — Entwurf vom 2026-08-18, Artboard 1.

  Der Betreiber über die Vorlage: „das ist doch eine viel bessere Server-
  übersicht wie sie bisher existiert."

  Sie ersetzt die Kachelansicht. Was sie besser macht, ist nicht das Aussehen,
  sondern die Spalte, die es vorher nicht gab: BEREITSCHAFT. „Läuft" beantwortet
  nicht die Frage, die ein Betreiber wirklich hat — nämlich ob jemand rein kann.
-%>
<%# `data-fb-live-guild` haengt `gameserver-live.js` ein (Baustelle 134,
    2026-09-17). Die Route reiht das Skript seit dem 2026-09-08 ein, aber der
    Haken stand NUR in `server-detail.ejs` — diese Seite lud das Modul also und
    liess es beim ersten `if` wieder aussteigen. Sie stand still, ohne Fehler. %>
<div class="fb-seite" data-fb-live-guild="<%= guildId %>">

  <div class="fb-seitenkopf">
    <div>
      <div class="fb-titel">Server</div>
      <div class="fb-muted" style="font-size:13px">
        <%= liste.zahlen.alle %> Server auf
        <%= liste.zahlen.maschinen === 1 ? 'einer Maschine' : liste.zahlen.maschinen + ' Maschinen' %>
        · <%= liste.zahlen.bereit %> bereit
      </div>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <%# Der Knopf zeigte auf eine Route, die es nie gab (Baustelle 107).
          Seit dem 2026-09-08 sammelt das Dashboard den Verlauf; die Seite
          kommt, wenn etwas darin steht. Bis dahin sagt der Knopf das, statt
          ins Leere zu fuehren - ein toter Verweis ist schlimmer als ein
          abgeblendeter Knopf, weil er beim Klicken nichts erklaert. %>
      <span class="btn btn-white btn-sm disabled" aria-disabled="true"
            title="Der Verlauf wird seit dem 2026-09-08 gesammelt. Die Seite kommt, sobald genug Messwerte da sind.">Kennzahlen</span>
      <a class="btn btn-white btn-sm" href="/guild/<%= guildId %>/plugins/gameserver/addons">Spiele durchsuchen</a>
      <a class="btn btn-primary btn-sm" href="/guild/<%= guildId %>/plugins/gameserver/servers/create">Server anlegen</a>
    </div>
  </div>

  <%# ── Kennzahlen (Baustelle 140, 2026-09-19) ────────────────────────────
      Von der alten Dashboard-Seite hierher geholt, die damit entfaellt.

      **Die Zahlen kommen aus DERSELBEN Liste wie die Tabelle darunter.** Die
      alte Seite hatte dafuer eine eigene SQL-Abfrage — zwei Quellen fuer
      dieselbe Zahl, und damit die Aussicht, dass die Kachel „1 Online" sagt,
      waehrend die Zeile darunter „Aus" zeigt.

      `data-fb-live-summe` sagt nur, WO die Zahl steht. Gezaehlt wird in
      `gameserver-live.js:summen()`, sobald Live-Daten da sind; bis dahin gilt,
      was hier steht. Beide Rechnungen haelt `scripts/check-live-zahlen.js`
      gegeneinander. %>
  <div class="fb-kacheln">
    <% [['alle',    liste.zahlen.alle,    'Gesamte Server',  'var(--fb-info)',    'fa-server'],
        ['online',  liste.zahlen.online,  'Online',          'var(--fb-success)', 'fa-circle-check'],
        ['aus',     liste.zahlen.aus,     'Offline',         'var(--fb-warning)', 'fa-circle-xmark'],
        ['spieler', liste.zahlen.spieler, 'Spieler',         'var(--fb-danger)',  'fa-users']
       ].forEach(function (k) { %>
      <div class="fb-kachel">
        <span class="fb-kachel-zeichen" style="background:<%= k[3] %>"><i class="fa-solid <%= k[4] %>"></i></span>
        <div>
          <div class="fb-kachel-zahl" data-fb-live-summe="<%= k[0] %>"><%= k[1] %></div>
          <div class="fb-kachel-wort"><%= k[2] %></div>
        </div>
      </div>
    <% }); %>
  </div>

  <div class="fb-raster">
   <div>
  <div class="fb-karte">
    <div class="fb-kopf">
      <span>Deine Server</span>
      <div style="margin-left:auto;display:flex;gap:6px">
        <% [['alle','Alle',liste.zahlen.alle],['bereit','Bereit',liste.zahlen.bereit],['aus','Aus',liste.zahlen.aus]].forEach(function (f) { %>
          <a href="?f=<%= f[0] %>" class="fb-pille<%= (locals.filter || 'alle') === f[0] ? ' fb-pille-gut' : '' %>"
             style="text-decoration:none"><%= f[1] %> <%= f[2] %></a>
        <% }); %>
      </div>
    </div>

    <div style="overflow-x:auto">
      <table class="fb-tabelle">
        <thead>
          <tr>
            <th>Server</th><th>Bereitschaft</th><th>Zustand</th>
            <th>Spieler</th><th>Adresse</th><th>Maschine</th>
          </tr>
        </thead>
        <tbody>
          <% liste.liste.forEach(function (s) {
               const f = locals.filter || 'alle';
               if (f === 'bereit' && !s.bereit) return;
               if (f === 'aus' && s.zustand.schluessel !== 'offline') return; %>
            <tr onclick="location.href='/guild/<%= guildId %>/plugins/gameserver/servers/<%= s.id %>'" style="cursor:pointer">
              <td>
                <div style="font-weight:600"><%= s.name %></div>
                <div class="fb-muted fb-mono" style="font-size:12px">#<%= s.id %> · <%= s.spiel %></div>
              </td>
              <%# Die Balken zeigen dieselbe Leiter wie die Serverseite (B105).
                  Gelb ist die Stufe, auf die er GERADE wartet — ohne sie sieht
                  „zwei von drei" aus wie „steht", statt wie „ist unterwegs". %>
              <td<% if (s.bereitschaftGrund) { %> title="<%= s.bereitschaftGrund %>"<% } %>>
                <% if (!s.stufen.length) { %>
                  <div class="fb-muted" style="font-size:12px">—</div>
                <% } else { %>
                  <div style="display:flex;gap:3px;margin-bottom:3px">
                    <% s.stufen.forEach(function (st) { %>
                      <span title="<%= st.name %><%= st.titel ? ' — ' + st.titel : '' %>"
                            data-fb-live="stufe-punkt" data-fb-server="<%= s.id %>"
                            data-fb-stufe="<%= st.schluessel %>"
                            data-fb-verlangt="<%= st.verlangt ? 'ja' : 'nein' %>"
                            style="width:22px;height:5px;border-radius:100rem;background:<%=
                        st.erfuellt ? 'var(--fb-success)' : st.wartet ? 'var(--fb-warning)' : '#e6e7e9'
                      %>"></span>
                    <% }); %>
                  </div>
                <% } %>
                <%# Die Wartemarke wie auf der Serverseite: ein drehender Ring
                    heisst "da passiert gerade etwas". Text als eigenes Kind,
                    sonst wirft ihn das Neuschreiben mit weg. %>
                <div class="fb-muted" style="font-size:12px"
                     data-fb-live="bereitschaft-text" data-fb-server="<%= s.id %>"><span
                     class="fb-warte" data-fb-pille="warte"<%= s.wartet ? '' : ' hidden' %>></span><span
                     data-fb-live-text><%= s.bereitschaftText %></span></div>
              </td>
              <td><span class="fb-pille<%= s.zustand.gut ? ' fb-pille-gut' : '' %>"
                        data-fb-live="zustand-pille" data-fb-server="<%= s.id %>"><%= s.zustand.text %></span></td>
              <td class="fb-mono" data-fb-live="spieler-paar" data-fb-server="<%= s.id %>">
                <% if (s.spieler.jetzt !== null) { %>
                  <%= s.spieler.jetzt %> / <%= s.spieler.max !== null ? s.spieler.max : '?' %>
                <% } else { %>
                  <%# „nicht gemessen" ist etwas anderes als „0" — die Legende
                      unten sagt es ausdrücklich. %>
                  <span class="fb-muted" style="font-family:inherit">nicht gemessen</span>
                <% } %>
              </td>
              <%# Dieselben Zeilen wie auf der Serverseite (B93) — sonst haette
                  derselbe Server wieder zwei Wahrheiten, je nachdem wo man
                  hinsieht. Genau das war M-1. %>
              <td style="font-size:13px">
                <% if (!s.adresse) { %>—<% } else { %>
                  <% s.adresse.zeilen.forEach(function (z) { %>
                    <div>
                      <% if (s.adresse.zeilen.length > 1) { %>
                        <span class="fb-muted" style="font-size:11px"><%= z.label %></span>
                      <% } %>
                      <span class="fb-mono"><%= z.text %></span>
                    </div>
                  <% }); %>
                <% } %>
              </td>
              <td><span class="fb-pille"><%= s.maschine || '—' %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <%# Die Legende nennt die drei Balken seit dem Entwurf. Was sie bis zum
        2026-09-08 NICHT sagte: was einer, zwei oder keiner bedeuten — genau
        die Frage des Betreibers. Drei Zeilen statt einer Aufzählung. %>
    <div class="fb-koerper fb-muted" style="font-size:12px;border-top:1px solid var(--fb-border)">
      <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:flex-start">
        <div style="display:flex;flex-direction:column;gap:4px">
          <% [['Prozess','Das Programm läuft.'],
              ['Port','Der Port lauscht — jemand könnte sich verbinden.'],
              ['Abfrage','Das Spiel antwortet auf eine Serverabfrage. Erst hier kommt ein Spieler wirklich rein.']
             ].forEach(function (z, i) { %>
            <div style="display:flex;gap:8px;align-items:center">
              <span style="display:flex;gap:3px">
                <% for (let k=0;k<3;k++) { %><span style="width:22px;height:5px;border-radius:100rem;background:<%=
                  k <= i ? 'var(--fb-success)' : '#e6e7e9' %>"></span><% } %>
              </span>
              <span><strong><%= z[0] %></strong> — <%= z[1] %></span>
            </div>
          <% }); %>
        </div>
        <div style="max-width:420px;display:flex;flex-direction:column;gap:4px">
          <div><span style="display:inline-block;width:22px;height:5px;border-radius:100rem;background:var(--fb-warning);vertical-align:middle"></span>
               Gelb ist die Stufe, auf die er gerade wartet.</div>
          <div>Grau heisst <strong>nicht gemessen</strong>: wir wissen es nicht — nicht, dass es fehlschlug.</div>
          <div>Bei der Spielerzahl heisst <strong>0</strong>: gemessen, niemand da.</div>
          <div>Die Stufen meldet <span class="fb-mono">fb-init</span> aus dem Container. Ein Paket ohne
               <span class="fb-mono">ready_when</span> meldet nichts — dort steht „nicht messbar".</div>
        </div>
      </div>
    </div>
  </div>
   </div>

   <%# ── Rechte Spalte ─────────────────────────────────────────────────────
       Beides von der alten Dashboard-Seite. „Alle Server anzeigen" ist dabei
       weggefallen: Der Verweis zeigte auf DIESE Seite, und sein
       Uebersetzungsschluessel `DASHBOARD.ALL_SERVERS` stand in keiner
       Sprachdatei — im Schnellzugriff las man den rohen Schluessel. %>
   <div>
     <div class="fb-karte">
       <div class="fb-kopf"><i class="fa-solid fa-trophy fb-muted"></i> <span>Top Spiele</span></div>
       <div class="fb-koerper">
         <% if (!liste.spiele.length) { %>
           <div class="fb-muted" style="font-size:13px">Noch kein Server angelegt.</div>
         <% } else { %>
           <% liste.spiele.forEach(function (sp, i) { %>
             <div style="margin-bottom:<%= i === liste.spiele.length - 1 ? '0' : '14px' %>">
               <div style="display:flex;align-items:center;gap:8px;margin-bottom:5px">
                 <span style="font-weight:600">#<%= i + 1 %> <%= sp.name %></span>
                 <span class="fb-pille" style="margin-left:auto"><%= sp.anzahl %><%= sp.anzahl === 1 ? ' Server' : ' Server' %></span>
               </div>
               <%# Der Balken misst gegen das haeufigste Spiel, nicht gegen die
                   Gesamtzahl: Sonst waere der erste Balken bei zwei Spielen
                   halb leer und saehe aus wie eine Warnung. %>
               <div style="height:5px;border-radius:100rem;background:#e6e7e9;overflow:hidden">
                 <div style="height:100%;border-radius:100rem;background:var(--fb-primary);width:<%=
                   Math.round(sp.anzahl / liste.spiele[0].anzahl * 100) %>%"></div>
               </div>
             </div>
           <% }); %>
         <% } %>
       </div>
     </div>

     <div class="fb-karte">
       <div class="fb-kopf"><i class="fa-solid fa-link fb-muted"></i> <span>Schnellzugriff</span></div>
       <div class="fb-koerper">
         <%# **Die Namen sind die der Navigation.** Erst stand hier
             „Addon-Marktplatz" neben „Spiele" — zwei Namen fuer /addons — und
             ein dritter Punkt auf /games, das es gar nicht gibt. Genau der
             tote Verweis, vor dem der Kommentar am Kennzahlen-Knopf warnt. %>
         <% [['Spiele',        'addons',   'fa-gamepad'],
             ['Einstellungen', 'settings', 'fa-gear']
            ].forEach(function (v, i) { %>
           <div style="margin-bottom:<%= i === 1 ? '0' : '10px' %>">
             <a href="/guild/<%= guildId %>/plugins/gameserver/<%= v[1] %>"
                style="display:flex;align-items:center;gap:9px;text-decoration:none;color:var(--fb-primary)">
               <i class="fa-solid <%= v[2] %>" style="width:16px"></i><%= v[0] %>
             </a>
           </div>
         <% }); %>
       </div>
     </div>
   </div>
  </div>

</div>
