{
    "name": "gameserver",
    "displayName": "Gameserver",
    "description": "The Gameserver Plugin - Choose your game. Download the game addon for the game and setup the gameserver",
    "version": "2.6.1",
    "author": "FireBot Team",
    "license": "none",
    "type": "commonjs",
    "peerDependencies": {
        "discord.js": "^14.19.0",
        "express": "^5.1.0",
        "dunebot-core": "*",
        "dunebot-sdk": "*"
    },
    "guildInhalte": {
        "loeschen": [
            "gameserver_backups",
            "gameserver_content",
            "gameserver_cronjobs",
            "gameserver_datenbanken",
            "gameserver_status",
            "gameserver_status_panels",
            "gameservers"
        ],
        "bleiben": {
            "addon_marketplace": "guild_id ist die Guild, die das Paket eingestellt hat; öffentliche Pakete gehören allen, die privaten löscht onGuildDisable"
        }
    },
    "ereignisse": {
        "sendet": [
            "gameserver.gestartet",
            "gameserver.gestoppt",
            "gameserver.abgestuerzt",
            "gameserver.spieler.verbunden",
            "gameserver.spieler.getrennt"
        ],
        "hoert": []
    },
    "mitgliedInhalte": {
        "addon_comments": {
            "user_id": "loeschen",
            "deleted_by": "anonymisieren"
        },
        "addon_favorites": {
            "user_id": "loeschen"
        },
        "addon_ratings": {
            "user_id": "loeschen"
        },
        "addon_image_builds": {
            "admin_user_id": "anonymisieren"
        },
        "addon_marketplace": {
            "author_user_id": "anonymisieren",
            "verified_by": "anonymisieren"
        },
        "packages": {
            "author_user_id": "anonymisieren"
        },
        "package_versions": {
            "published_by": "anonymisieren",
            "released_by": "anonymisieren"
        },
        "gameservers": {
            "user_id": "anonymisieren"
        },
        "gameserver_backups": {
            "created_by": "anonymisieren"
        },
        "gameserver_cronjobs": {
            "created_by": "anonymisieren"
        },
        "gameserver_status_panels": {
            "created_by": "anonymisieren"
        },
        "gameserver_migrations": {
            "initiated_by": "anonymisieren"
        }
    }
}
