{
  "name": "core",
  "version": "6.8.5",
  "displayName": "Firebot Core-Plugin",
  "description": "Das Core-Plugin des FireBots (is in every new guild activiated!).",
  "author": "FireBot Team",
  "main": "dashboard/index.js",
  "bot": "bot/index.js",
  "dashboard": "dashboard/index.js",
  "repository": "https://github.com/firedervil77/dunebot-plugins",
  "dependencies": {
    "dunebot-sdk": "*"
  },
  "guildInhalte": {
    "loeschen": [],
    "bleiben": {
      "guild_groups_permissions_backup": "core lässt sich nicht abschalten",
      "guild_permission_seeds": "core lässt sich nicht abschalten; die Rechte eines Plugins nimmt unregisterPluginPermissions"
    }
  },
  "ereignisse": {
    "sendet": [
      "kern.mitglied.beigetreten",
      "kern.mitglied.verlassen",
      "kern.plugin.eingeschaltet",
      "kern.plugin.abgeschaltet",
      "kern.dashboard.geaendert",
      "kern.dashboard.anmeldung",
      "kern.termin.angelegt",
      "kern.termin.geaendert",
      "kern.termin.abgesagt",
      "kern.termin.anwesenheit",
      "kern.ereignis.probe"
    ],
    "hoert": [
      "kern.ereignis.probe"
    ]
  },
  "mitgliedInhalte": {
    "users": {
      "_id": "loeschen"
    },
    "user_configs": {
      "user_id": "loeschen"
    },
    "user_connections": {
      "user_id": "loeschen"
    },
    "user_feedback": {
      "user_id": {
        "weg": "anonymisieren",
        "mit": [
          "user_tag"
        ]
      },
      "resolved_by": "anonymisieren"
    },
    "user_feedback_votes": {
      "user_id": "loeschen"
    },
    "guild_users": {
      "user_id": "loeschen",
      "invited_by": "anonymisieren"
    },
    "guild_user_groups": {
      "assigned_by": "anonymisieren"
    },
    "guild_staff": {
      "user_id": "loeschen",
      "granted_by": "anonymisieren"
    },
    "guild_toast_logs": {
      "user_id": "loeschen"
    },
    "guild_plugins": {
      "enabled_by": {
        "weg": "anonymisieren",
        "mit": [
          "enabled_by_name"
        ]
      },
      "disabled_by": {
        "weg": "anonymisieren",
        "mit": [
          "disabled_by_name"
        ]
      }
    },
    "guild_media": {
      "uploaded_by": "anonymisieren"
    },
    "guilds": {
      "_id": {
        "weg": "ausgenommen",
        "grund": "die Guild selbst, kein Mitglied"
      },
      "owner_id": {
        "weg": "ausgenommen",
        "grund": "Besitzer der Guild, kommt bei jedem Start neu von Discord; geht mit „Guild löschen“"
      },
      "active_user_id": "anonymisieren"
    },
    "supporter_badges": {
      "user_id": "loeschen"
    },
    "donations": {
      "user_id": {
        "weg": "frist",
        "grund": "Zahlungsbeleg, gesetzliche Aufbewahrung; die Frist legt G-05 fest, Rechtsprüfung beim Betreiber"
      }
    },
    "frontend_pages": {
      "created_by": "anonymisieren"
    },
    "changelogs": {
      "author_id": {
        "weg": "anonymisieren",
        "mit": [
          "author"
        ]
      }
    },
    "ereignisbuch": {
      "akteur": {
        "weg": "frist",
        "grund": "Zustellbuch der Fachereignisse, Frist 7 Tage (G-05); was ein Hörer daraus speichert, erklärt der Hörer"
      },
      "betroffen": {
        "weg": "frist",
        "grund": "wie akteur"
      }
    }
  }
}
