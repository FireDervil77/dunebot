<%#
 * Widget: Server-Infos
 *
 * Auf Tabler-Bauteile gezogen. Farben kommen aus den Design-Tokens, nicht
 * mehr aus festen Bootstrap-Varianten — damit folgt die Karte dem Theme.
 *
 * Vorher: `img-circle elevation-3` (AdminLTE), eine verwaiste `col-md-6` ohne
 * Zeile und `btn-block`, das es in Bootstrap 5 nicht mehr gibt.
%>

<%
  const _belegt  = Math.round(memory.heapUsed  / 1024 / 1024);
  const _gesamt  = Math.round(memory.heapTotal / 1024 / 1024);
  const _prozent = Math.min(100, Math.round(memory.heapUsed / memory.heapTotal * 100));
  const _symbol  = guild.icon || guild.iconURL || null;
%>

<div class="d-flex align-items-center gap-3 mb-3">
  <% if (_symbol) { %>
    <span class="avatar avatar-md rounded" style="background-image: url(<%= _symbol %>)"></span>
  <% } else { %>
    <span class="avatar avatar-md rounded"><%= (guild.guild_name || '?').charAt(0) %></span>
  <% } %>
  <div class="min-w-0">
    <div class="fw-semibold text-truncate"><%= guild.guild_name %></div>
    <div class="text-secondary small">ID: <%= guildId %></div>
  </div>
</div>

<div class="mb-1 d-flex justify-content-between align-items-baseline">
  <span class="text-secondary small"><%= tr('core:WIDGETS.SERVER_INFO.MEMORY_USAGE') %></span>
  <span class="fw-semibold"><%= _belegt %> / <%= _gesamt %> MB</span>
</div>

<div class="progress progress-sm mb-3">
  <div class="progress-bar" style="width: <%= _prozent %>%"
       role="progressbar" aria-valuenow="<%= _prozent %>" aria-valuemin="0" aria-valuemax="100">
    <span class="visually-hidden"><%= _prozent %>%</span>
  </div>
</div>

<a href="/guild/<%= guildId %>/plugins" class="btn btn-primary w-100">
  <i class="fa-solid fa-puzzle-piece me-2"></i><%= tr('core:WIDGETS.SERVER_INFO.BTN_MANAGE_PLUGINS') %>
</a>
