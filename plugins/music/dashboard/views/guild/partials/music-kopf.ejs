<%
/**
 * Seitenkopf der music-Seiten.
 *
 * **Nur noch eine Weiche.** Das Markup steht seit dem 2026-08-29 einmal im
 * Kern (`views/shared/seitenkopf.ejs`, Baustelle 83) — vorher trug jedes
 * Plugin seine eigene Kopie, und die sieben waren bereits
 * auseinandergelaufen.
 *
 * **Die Meldungstexte bleiben hier.** Sie gehoeren diesem Plugin; im Kern
 * waeren sie der Anfang eines Sammelbeckens.
 *
 * Erwartet: guildId, tr, titel, beschreibung, icon
 * Optional:  aktion (HTML rechts im Kopf)
 */
const jsTexte = {
  FEHLER:            tr('music:JS.FEHLER'),
  EINGABE_FEHLT:     tr('music:JS.EINGABE_FEHLT'),
  AUFGENOMMEN:       tr('music:JS.AUFGENOMMEN'),
  ENTFERNT:          tr('music:JS.ENTFERNT'),
  GESPEICHERT:       tr('music:JS.GESPEICHERT'),
  LISTE_LOESCHEN:    tr('music:JS.LISTE_LOESCHEN'),
  LISTE_GELOESCHT:   tr('music:JS.LISTE_GELOESCHT'),
  TITEL_ENTFERNEN:   tr('music:JS.TITEL_ENTFERNEN'),
  LISTE_NAME_FEHLT:  tr('music:JS.LISTE_NAME_FEHLT'),
  STOPPEN_FRAGE:     tr('music:JS.STOPPEN_FRAGE'),
  TRENNEN_FRAGE:     tr('music:JS.TRENNEN_FRAGE'),
  IN_LISTE:          tr('music:JS.IN_LISTE'),
  // Die Ueberschrift der Spielerkarte wechselt beim Pausieren, ohne dass die
  // Seite neu geladen wird - deshalb braucht das Skript beide Formen.
  LAEUFT:            tr('music:DASHBOARD.NOW_PLAYING'),
  PAUSIERT:          tr('music:DASHBOARD.PAUSED'),
  DATEI_LOESCHEN:    tr('music:JS.DATEI_LOESCHEN'),
  DATEI_FEHLT:       tr('music:JS.DATEI_FEHLT'),
  DATEI_ABGELEGT:    tr('music:JS.DATEI_ABGELEGT')
};
%>
<%- include('shared/seitenkopf', {
      plugin:       'music',
      vortitel:     tr('music:TITLE'),
      titel:        titel,
      beschreibung: (typeof beschreibung !== 'undefined' ? beschreibung : null),
      icon:         icon,
      guildId:      guildId,
      texte:        jsTexte,
      aktion:       (typeof aktion !== 'undefined' ? aktion : null)
}) %>
