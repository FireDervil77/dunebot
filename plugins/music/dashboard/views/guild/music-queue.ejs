<%- include('partials/music-kopf', {
  guildId, tr,
  icon: 'fa-solid fa-list-ol',
  titel: tr('music:NAV.QUEUE'),
  beschreibung: tr('music:QUEUE.SUBTITLE')
}) %>

<% const basis = `/guild/${guildId}/plugins/music`; %>

<div class="card">
  <div class="card-header">
    <h3 class="card-title">
      <%= tr('music:NAV.QUEUE') %>
      <span class="badge bg-secondary-lt ms-2"><%= zustand.titelGesamt %></span>
    </h3>
    <div class="card-actions btn-list">
      <button type="button" class="btn btn-sm btn-outline-primary" onclick="musicSteuern('mischen')">
        <i class="fa-solid fa-shuffle me-2"></i><%= tr('music:BTN.SHUFFLE') %>
      </button>
      <button type="button" class="btn btn-sm btn-outline-danger" onclick="musicStoppen()">
        <i class="fa-solid fa-trash me-2"></i><%= tr('music:QUEUE.CLEAR') %>
      </button>
    </div>
  </div>

  <% if (zustand.aktuell) { %>
    <div class="list-group-item bg-primary-lt">
      <%- include('partials/music-titelzeile', {
            t: zustand.aktuell, tr,
            aktionen: `<span class="badge bg-green-lt">${tr('music:DASHBOARD.NOW_PLAYING')}</span>`
          }) %>
    </div>
  <% } %>

  <% if (zustand.warteschlange && zustand.warteschlange.length > 0) { %>
    <div class="list-group list-group-flush" id="music-warteschlange">
      <% zustand.warteschlange.forEach((t, i) => { %>
        <div class="list-group-item" data-position="<%= i %>">
          <%- include('partials/music-titelzeile', {
                t, tr, nummer: i + 1,
                aktionen: `
                  <div class="btn-list flex-nowrap">
                    <button type="button" class="btn btn-sm btn-icon btn-outline-secondary"
                            onclick="musicVerschieben(${i}, 0)" title="${tr('music:QUEUE.TO_TOP')}">
                      <i class="fa-solid fa-angles-up"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-icon btn-outline-danger"
                            onclick="musicEntfernen(${i})" title="${tr('music:QUEUE.REMOVE')}">
                      <i class="fa-solid fa-xmark"></i>
                    </button>
                  </div>`
              }) %>
        </div>
      <% }); %>
    </div>
    <div class="card-footer text-secondary">
      <%= tr('music:DASHBOARD.REMAINING', { zeit: spielzeitText(zustand.restspielzeitSek) }) %>
    </div>
  <% } else if (zustand.aktuell) { %>
    <%# Ein Titel laeuft, es wartet nur keiner mehr. Die Seite darf hier nicht
        "leer" sagen - oben steht sichtbar etwas drin. %>
    <div class="card-footer text-secondary">
      <%= tr('music:QUEUE.ONLY_CURRENT') %>
    </div>
  <% } else { %>
    <div class="card-body">
      <div class="empty">
        <div class="empty-icon"><i class="fa-solid fa-list-ol fs-1 text-secondary"></i></div>
        <p class="empty-title"><%= tr('music:QUEUE.EMPTY') %></p>
        <p class="empty-subtitle text-secondary"><%= tr('music:QUEUE.EMPTY_HINT') %></p>
      </div>
    </div>
  <% } %>
</div>

<% if (listen && listen.length > 0) { %>
  <div class="card mt-3">
    <div class="card-header">
      <h3 class="card-title"><%= tr('music:QUEUE.FROM_PLAYLIST') %></h3>
    </div>
    <div class="list-group list-group-flush">
      <% listen.forEach(l => { %>
        <div class="list-group-item d-flex justify-content-between align-items-center">
          <div>
            <strong><%= l.name %></strong>
            <span class="text-secondary small ms-2">
              <%= tr('music:PLAYLISTS.TRACK_COUNT', { count: l.titel_anzahl }) %>
            </span>
          </div>
          <button type="button" class="btn btn-sm btn-outline-primary" onclick="musicListeAbspielen(<%= l.id %>)">
            <i class="fa-solid fa-play me-2"></i><%= tr('music:PLAYLISTS.PLAY') %>
          </button>
        </div>
      <% }); %>
    </div>
  </div>
<% } %>
