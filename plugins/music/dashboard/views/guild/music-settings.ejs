<%- include('partials/music-kopf', {
  guildId, tr,
  icon: 'fa-solid fa-music',
  titel: tr('music:SETTINGS.TITLE'),
  beschreibung: tr('music:SETTINGS.SUBTITLE')
}) %>

<%
  const basis = `/guild/${guildId}/plugins/music`;
  // Sprachkanaele kommen aus einem eigenen IPC-Handler: der uebliche
  // GET_GUILD_CHANNELS liefert ausdruecklich nur Textkanaele.
  const sprachKanaele = sprachkanaele || [];
  const textKanaele = channels || [];
  const erlaubte = (einstellungen.allowed_voice || []).map(String);
%>

<form class="guild-ajax-form"
      data-music-form
      data-form-type="music-settings"
      data-method="PUT"
      action="<%= basis %>/settings"
      method="POST">

  <div class="row row-cards">
    <div class="col-lg-6">
      <!-- Wer darf steuern -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title"><i class="fa-solid fa-user-shield me-2"></i><%= tr('music:SETTINGS.ACCESS') %></h3>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <label for="dj_role_id" class="form-label"><%= tr('music:SETTINGS.DJ_ROLE') %></label>
            <select name="dj_role_id" id="dj_role_id" class="form-select">
              <option value=""><%= tr('music:SETTINGS.DJ_ROLE_NONE') %></option>
              <% (roles || []).filter(r => r.name !== '@everyone').forEach(r => { %>
                <option value="<%= r.id %>" <%= String(einstellungen.dj_role_id) === String(r.id) ? 'selected' : '' %>>
                  <%= r.name %>
                </option>
              <% }); %>
            </select>
            <div class="form-hint"><%= tr('music:SETTINGS.DJ_ROLE_HELP') %></div>
          </div>

          <label class="form-check form-switch mb-1">
            <input type="hidden" name="vote_skip_enabled" value="0">
            <input type="checkbox" class="form-check-input" name="vote_skip_enabled" value="1"
                   <%= einstellungen.vote_skip_enabled ? 'checked' : '' %>>
            <span class="form-check-label"><%= tr('music:SETTINGS.VOTE_SKIP') %></span>
          </label>
          <div class="text-secondary small mb-3"><%= tr('music:SETTINGS.VOTE_SKIP_HELP') %></div>

          <div class="mb-0">
            <label for="vote_skip_percent" class="form-label"><%= tr('music:SETTINGS.VOTE_PERCENT') %></label>
            <input type="number" class="form-control" id="vote_skip_percent" name="vote_skip_percent"
                   value="<%= einstellungen.vote_skip_percent || 50 %>" min="1" max="100">
          </div>
        </div>
      </div>

      <!-- Quellen -->
      <div class="card mt-3">
        <div class="card-header">
          <h3 class="card-title"><i class="fa-solid fa-tower-broadcast me-2"></i><%= tr('music:SETTINGS.SOURCES') %></h3>
        </div>
        <div class="card-body">
          <%
            const quellen = [
              ['allow_youtube',    einstellungen.allow_youtube,    'YOUTUBE'],
              ['allow_soundcloud', einstellungen.allow_soundcloud, 'SOUNDCLOUD'],
              ['allow_spotify',    einstellungen.allow_spotify,    'SPOTIFY'],
              ['allow_direct',     einstellungen.allow_direct,     'DIRECT']
            ];
          %>
          <% quellen.forEach(([name, wert, schluessel]) => { %>
            <label class="form-check form-switch">
              <input type="hidden" name="<%= name %>" value="0">
              <input type="checkbox" class="form-check-input" name="<%= name %>" value="1" <%= wert ? 'checked' : '' %>>
              <span class="form-check-label"><%= tr('music:SOURCE.' + schluessel) %></span>
            </label>
          <% }); %>

          <div class="alert alert-<%= spotifyEingerichtet ? 'success' : 'info' %> mt-3 mb-0" role="alert">
            <i class="fa-solid fa-<%= spotifyEingerichtet ? 'circle-check' : 'circle-info' %> me-2"></i>
            <%= tr(spotifyEingerichtet ? 'music:SETTINGS.SPOTIFY_OK' : 'music:SETTINGS.SPOTIFY_MISSING') %>
          </div>

          <div class="alert alert-info mt-3 mb-0" role="alert">
            <i class="fa-solid fa-circle-info me-2"></i>
            <%= tr('music:SETTINGS.SPOTIFY_NOTE') %>
          </div>
        </div>
      </div>

      <%#
        Eigene Tondateien: die beiden Riegel gegen ein volllaufendes
        Dateisystem. Der dritte ist das Recht MUSIC.FILES.UPLOAD und steht
        deshalb in der Rechteverwaltung, nicht hier.
      %>
      <div class="card mt-3">
        <div class="card-header">
          <h3 class="card-title"><i class="fa-solid fa-file-audio me-2"></i><%= tr('music:SETTINGS.FILES') %></h3>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <label for="datei_quota_mb" class="form-label"><%= tr('music:SETTINGS.FILE_QUOTA.LABEL') %></label>
            <div class="input-group">
              <input type="number" class="form-control" id="datei_quota_mb" name="datei_quota_mb"
                     min="0" max="20480" value="<%= einstellungen.datei_quota_mb ?? 250 %>">
              <span class="input-group-text">MB</span>
            </div>
            <div class="form-hint"><%= tr('music:SETTINGS.FILE_QUOTA.HELP') %></div>
          </div>

          <div class="mb-0">
            <label for="datei_aufbewahrung_tage" class="form-label"><%= tr('music:SETTINGS.FILE_RETENTION.LABEL') %></label>
            <div class="input-group">
              <input type="number" class="form-control" id="datei_aufbewahrung_tage" name="datei_aufbewahrung_tage"
                     min="0" max="3650" value="<%= einstellungen.datei_aufbewahrung_tage ?? 30 %>">
              <span class="input-group-text"><%= tr('music:SETTINGS.FILE_RETENTION.UNIT') %></span>
            </div>
            <div class="form-hint"><%= tr('music:SETTINGS.FILE_RETENTION.HELP') %></div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <!-- Wiedergabe -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title"><i class="fa-solid fa-sliders me-2"></i><%= tr('music:SETTINGS.PLAYBACK') %></h3>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-sm-6 mb-3">
              <label for="default_volume" class="form-label"><%= tr('music:SETTINGS.DEFAULT_VOLUME') %></label>
              <input type="number" class="form-control" id="default_volume" name="default_volume"
                     value="<%= einstellungen.default_volume ?? 50 %>" min="0" max="200">
              <div class="form-hint"><%= tr('music:SETTINGS.DEFAULT_VOLUME_HELP') %></div>
            </div>
            <div class="col-12 mb-3">
              <label class="form-check form-switch mb-1">
                <input type="hidden" name="normalize_loudness" value="0">
                <input type="checkbox" class="form-check-input" name="normalize_loudness" value="1"
                       <%= (einstellungen.normalize_loudness ?? 1) ? 'checked' : '' %>>
                <span class="form-check-label"><%= tr('music:SETTINGS.NORMALIZE_LOUDNESS') %></span>
              </label>
              <div class="form-hint"><%= tr('music:SETTINGS.NORMALIZE_LOUDNESS_HELP') %></div>
            </div>
            <div class="col-sm-6 mb-3">
              <label for="audio_quality" class="form-label"><%= tr('music:SETTINGS.QUALITY') %></label>
              <select name="audio_quality" id="audio_quality" class="form-select">
                <% [[0, 'QUALITY_LOW'], [1, 'QUALITY_MID'], [2, 'QUALITY_HIGH']].forEach(([w, s]) => { %>
                  <option value="<%= w %>" <%= Number(einstellungen.audio_quality) === w ? 'selected' : '' %>>
                    <%= tr('music:SETTINGS.' + s) %>
                  </option>
                <% }); %>
              </select>
            </div>
          </div>

          <div class="mb-3">
            <label for="audio_filter" class="form-label"><%= tr('music:FILTER') %></label>
            <select name="audio_filter" id="audio_filter" class="form-select">
              <% filter.forEach(f => { %>
                <option value="<%= f.wert %>" <%= einstellungen.audio_filter === f.wert ? 'selected' : '' %>>
                  <%= f.name %>
                </option>
              <% }); %>
            </select>
          </div>

          <div class="row">
            <div class="col-sm-6 mb-3">
              <label for="max_queue_size" class="form-label"><%= tr('music:SETTINGS.MAX_QUEUE') %></label>
              <input type="number" class="form-control" id="max_queue_size" name="max_queue_size"
                     value="<%= einstellungen.max_queue_size ?? 0 %>" min="0" max="10000">
              <div class="form-hint"><%= tr('music:SETTINGS.ZERO_UNLIMITED') %></div>
            </div>
            <div class="col-sm-6 mb-3">
              <label for="max_track_seconds" class="form-label"><%= tr('music:SETTINGS.MAX_TRACK') %></label>
              <input type="number" class="form-control" id="max_track_seconds" name="max_track_seconds"
                     value="<%= einstellungen.max_track_seconds ?? 0 %>" min="0" max="86400">
              <div class="form-hint"><%= tr('music:SETTINGS.ZERO_UNLIMITED') %></div>
            </div>
          </div>

          <label class="form-check form-switch mb-1">
            <input type="hidden" name="mode_247" value="0">
            <input type="checkbox" class="form-check-input" name="mode_247" value="1"
                   <%= einstellungen.mode_247 ? 'checked' : '' %>>
            <span class="form-check-label"><%= tr('music:MODE247') %></span>
          </label>
          <div class="text-secondary small mb-2"><%= tr('music:SETTINGS.MODE247_HELP') %></div>

          <label class="form-check form-switch mb-1">
            <input type="hidden" name="autoplay" value="0">
            <input type="checkbox" class="form-check-input" name="autoplay" value="1"
                   <%= einstellungen.autoplay ? 'checked' : '' %>>
            <span class="form-check-label"><%= tr('music:AUTOPLAY') %></span>
          </label>
          <div class="text-secondary small mb-0"><%= tr('music:SETTINGS.AUTOPLAY_HELP') %></div>
        </div>
      </div>

      <!-- Kanaele und Ansagen -->
      <div class="card mt-3">
        <div class="card-header">
          <h3 class="card-title"><i class="fa-solid fa-hashtag me-2"></i><%= tr('music:SETTINGS.CHANNELS') %></h3>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <label for="allowed_voice" class="form-label"><%= tr('music:SETTINGS.ALLOWED_VOICE') %></label>
            <select name="allowed_voice" id="allowed_voice" class="form-select" multiple size="5">
              <% sprachKanaele.forEach(k => { %>
                <option value="<%= k.id %>" <%= erlaubte.includes(String(k.id)) ? 'selected' : '' %>><%= k.name %></option>
              <% }); %>
            </select>
            <div class="form-hint"><%= tr('music:SETTINGS.ALLOWED_VOICE_HELP') %></div>
          </div>

          <div class="mb-3">
            <label for="announce_channel" class="form-label"><%= tr('music:SETTINGS.ANNOUNCE_CHANNEL') %></label>
            <select name="announce_channel" id="announce_channel" class="form-select">
              <option value=""><%= tr('music:SETTINGS.ANNOUNCE_SAME') %></option>
              <% textKanaele.forEach(k => { %>
                <option value="<%= k.id %>" <%= String(einstellungen.announce_channel) === String(k.id) ? 'selected' : '' %>>
                  #<%= k.name %>
                </option>
              <% }); %>
            </select>
          </div>

          <label class="form-check form-switch mb-1">
            <input type="hidden" name="announce_now_playing" value="0">
            <input type="checkbox" class="form-check-input" name="announce_now_playing" value="1"
                   <%= einstellungen.announce_now_playing ? 'checked' : '' %>>
            <span class="form-check-label"><%= tr('music:SETTINGS.ANNOUNCE') %></span>
          </label>

          <label class="form-check form-switch mb-1 mt-2">
            <input type="hidden" name="leave_when_empty" value="0">
            <input type="checkbox" class="form-check-input" name="leave_when_empty" value="1"
                   <%= einstellungen.leave_when_empty ? 'checked' : '' %>>
            <span class="form-check-label"><%= tr('music:SETTINGS.LEAVE_EMPTY') %></span>
          </label>

          <div class="mt-3 mb-0">
            <label for="leave_after_seconds" class="form-label"><%= tr('music:SETTINGS.LEAVE_AFTER') %></label>
            <input type="number" class="form-control" id="leave_after_seconds" name="leave_after_seconds"
                   value="<%= einstellungen.leave_after_seconds ?? 120 %>" min="10" max="3600">
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-3">
    <button type="submit" class="btn btn-primary">
      <i class="fa-solid fa-floppy-disk me-2"></i><%= tr('music:SETTINGS.SAVE') %>
    </button>
  </div>
</form>
