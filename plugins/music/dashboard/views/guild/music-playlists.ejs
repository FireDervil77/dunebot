<%- include('partials/music-kopf', {
  guildId, tr,
  icon: 'fa-solid fa-rectangle-list',
  titel: tr('music:NAV.PLAYLISTS'),
  beschreibung: tr('music:PLAYLISTS.SUBTITLE'),
  aktion: `<button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#listeAnlegenModal">
             <i class="fa-solid fa-plus me-2"></i>${tr('music:PLAYLISTS.NEW')}
           </button>`
}) %>

<% const basis = `/guild/${guildId}/plugins/music`; %>

<div class="row row-cards">
  <!-- Alle Listen -->
  <div class="col-lg-<%= offen ? '5' : '12' %>">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <%= tr('music:PLAYLISTS.ALL') %>
          <span class="badge bg-secondary-lt ms-2"><%= (listen || []).length %></span>
        </h3>
      </div>

      <% if (listen && listen.length > 0) { %>
        <div class="list-group list-group-flush">
          <% listen.forEach(l => { %>
            <div class="list-group-item <%= offen && offen.id === l.id ? 'active' : '' %>" id="liste-<%= l.id %>">
              <div class="d-flex align-items-center justify-content-between">
                <a href="<%= basis %>/listen?liste=<%= l.id %>" class="flex-grow-1 text-reset text-decoration-none">
                  <div><strong><%= l.name %></strong></div>
                  <div class="text-secondary small">
                    <%= tr('music:PLAYLISTS.TRACK_COUNT', { count: l.titel_anzahl }) %>
                    · <%= spielzeitText(l.spielzeit_sek) %>
                  </div>
                  <% if (l.description) { %>
                    <div class="text-secondary small"><%= l.description %></div>
                  <% } %>
                </a>
                <div class="btn-list flex-nowrap ms-2">
                  <button type="button" class="btn btn-sm btn-icon btn-outline-primary"
                          onclick="musicListeAbspielen(<%= l.id %>)" title="<%= tr('music:PLAYLISTS.PLAY') %>">
                    <i class="fa-solid fa-play"></i>
                  </button>
                  <button type="button" class="btn btn-sm btn-icon btn-outline-danger"
                          onclick="musicListeLoeschen(<%= l.id %>, '<%= l.name.replace(/'/g, "\\'") %>')"
                          title="<%= tr('music:PLAYLISTS.DELETE') %>">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="card-body">
          <div class="empty">
            <div class="empty-icon"><i class="fa-solid fa-rectangle-list fs-1 text-secondary"></i></div>
            <p class="empty-title"><%= tr('music:PLAYLISTS.EMPTY') %></p>
            <p class="empty-subtitle text-secondary"><%= tr('music:PLAYLISTS.EMPTY_HINT') %></p>
            <div class="empty-action">
              <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#listeAnlegenModal">
                <i class="fa-solid fa-plus me-2"></i><%= tr('music:PLAYLISTS.NEW') %>
              </button>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Eine Liste im Detail -->
  <% if (offen) { %>
    <div class="col-lg-7">
      <div class="card" data-liste-id="<%= offen.id %>">
        <div class="card-header">
          <h3 class="card-title"><%= offen.name %></h3>
          <div class="card-actions">
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="musicListeAbspielen(<%= offen.id %>)">
              <i class="fa-solid fa-play me-2"></i><%= tr('music:PLAYLISTS.PLAY') %>
            </button>
          </div>
        </div>

        <div class="card-body border-bottom">
          <div class="input-group">
            <input type="text" class="form-control" id="liste-eingabe"
                   placeholder="<%= tr('music:ADD.PLACEHOLDER') %>">
            <button type="button" class="btn btn-primary" onclick="musicListeTitelHinzufuegen(<%= offen.id %>)">
              <i class="fa-solid fa-plus me-2"></i><%= tr('music:PLAYLISTS.ADD_TRACK') %>
            </button>
          </div>
        </div>

        <% if (offen.tracks && offen.tracks.length > 0) { %>
          <div class="list-group list-group-flush">
            <% offen.tracks.forEach((t, i) => { %>
              <div class="list-group-item" id="listentitel-<%= t.id %>">
                <%- include('partials/music-titelzeile', {
                      t: { title: t.title, url: t.url, source: t.source, durationSec: t.duration_sec, thumbnail: t.thumbnail },
                      tr, nummer: i + 1,
                      aktionen: `<button type="button" class="btn btn-sm btn-icon btn-outline-danger"
                                         onclick="musicListenTitelEntfernen(${offen.id}, ${t.id})"
                                         title="${tr('music:QUEUE.REMOVE')}">
                                   <i class="fa-solid fa-xmark"></i>
                                 </button>`
                    }) %>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="card-body text-secondary"><%= tr('music:PLAYLISTS.NO_TRACKS') %></div>
        <% } %>
      </div>
    </div>
  <% } %>
</div>

<!-- Neue Liste -->
<div class="modal modal-blur fade" id="listeAnlegenModal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><%= tr('music:PLAYLISTS.NEW') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schliessen"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label for="listeName" class="form-label"><%= tr('music:PLAYLISTS.NAME') %></label>
          <input type="text" id="listeName" class="form-control" maxlength="128"
                 placeholder="<%= tr('music:PLAYLISTS.NAME_PLACEHOLDER') %>">
        </div>
        <div class="mb-0">
          <label for="listeBeschreibung" class="form-label"><%= tr('music:PLAYLISTS.DESCRIPTION') %></label>
          <input type="text" id="listeBeschreibung" class="form-control" maxlength="512">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">
          <%= tr('music:PLAYLISTS.CANCEL') %>
        </button>
        <button type="button" class="btn btn-primary ms-auto" onclick="musicListeAnlegen()">
          <i class="fa-solid fa-plus me-2"></i><%= tr('music:PLAYLISTS.CREATE') %>
        </button>
      </div>
    </div>
  </div>
</div>
