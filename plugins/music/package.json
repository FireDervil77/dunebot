{
    "name": "music",
    "displayName": "Musik",
    "description": "Musikwiedergabe aus YouTube, Spotify, SoundCloud und direkten Quellen",
    "version": "1.0.1",
    "author": "FireBot Team",
    "license": "none",
    "type": "commonjs",
    "peerDependencies": {
        "discord.js": "^14.28.1",
        "express": "^5.1.0",
        "dunebot-core": "*",
        "dunebot-sdk": "*",
        "@discordjs/voice": "^0.19.2",
        "play-dl": "^1.9.7",
        "ffmpeg-static": "^5.3.0"
    },
    "guildInhalte": {
        "loeschen": [
            "music_queue",
            "music_sessions",
            "music_playlists",
            "music_history",
            "music_files",
            "music_settings"
        ]
    },
    "mitgliedInhalte": {
        "music_files": {
            "hochgeladen_von": "anonymisieren"
        },
        "music_history": {
            "requested_by": "loeschen"
        },
        "music_playlists": {
            "created_by": "anonymisieren"
        },
        "music_playlist_tracks": {
            "added_by": "anonymisieren"
        },
        "music_queue": {
            "requested_by": "anonymisieren"
        }
    },
    "farben": {
        "recht": "MUSIC.SETTINGS.EDIT",
        "seite": "/settings",
        "rollen": {
            "akzent": "#1db954",
            "warnung": "#f59f00",
            "gefahr": "#d63939"
        }
    }
}
