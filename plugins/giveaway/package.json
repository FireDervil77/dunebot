{
    "name": "giveaway",
    "displayName": "Giveaway",
    "description": "The Giveaway Plugin for FireBot",
    "version": "1.0.0",
    "author": "FireBot Team",
    "license": "none",
    "type": "commonjs",
    "peerDependencies": {
        "discord.js": "^14.19.0",
        "express": "^5.1.0",
        "dunebot-core": "*",
        "dunebot-sdk": "*"
    },
    "guildInhalte": {
        "loeschen": [
            "giveaways",
            "giveaway_templates",
            "giveaway_blacklist"
        ]
    },
    "ereignisse": {
        "sendet": [
            "giveaway.angelegt",
            "giveaway.teilnahme",
            "giveaway.gezogen",
            "giveaway.beendet"
        ],
        "hoert": []
    },
    "mitgliedInhalte": {
        "giveaways": {
            "created_by": "anonymisieren",
            "hosted_by": "anonymisieren"
        },
        "giveaway_entries": {
            "user_id": "loeschen"
        },
        "giveaway_winners": {
            "user_id": "loeschen"
        },
        "giveaway_templates": {
            "created_by": "anonymisieren"
        },
        "giveaway_blacklist": {
            "user_id": {
                "weg": "frist",
                "grund": "Sperre durch die Guild. Moderations- und Sicherheitsfall: bleibt bis zum Ende seiner Frist (G-05), die Auskunft nennt ihn (F-G2 A)"
            },
            "blocked_by": "anonymisieren"
        }
    }
}
