<%
/**
 * Seitenkopf der giveaway-Seiten.
 *
 * **Nur noch eine Weiche.** Das Markup steht seit dem 2026-08-29 einmal im
 * Kern (`views/shared/seitenkopf.ejs`, Baustelle 83) — vorher trug jedes
 * Plugin seine eigene Kopie, und die sieben waren bereits
 * auseinandergelaufen.
 *
 * **Die Meldungstexte bleiben hier.** Sie gehoeren diesem Plugin; im Kern
 * waeren sie der Anfang eines Sammelbeckens.
 *
 * Erwartet: guildId, tr, titel, beschreibung, icon
 * Optional:  aktion (HTML rechts im Kopf)
 */
const jsTexte = {
  FEHLER:              tr('giveaway:JS.FEHLER'),
  VERLOSUNG_BEENDEN:   tr('giveaway:JS.VERLOSUNG_BEENDEN'),
  NEU_ZIEHEN:          tr('giveaway:JS.NEU_ZIEHEN'),
  VERLOSUNG_LOESCHEN:  tr('giveaway:JS.VERLOSUNG_LOESCHEN'),
  VORLAGE_LOESCHEN:    tr('giveaway:JS.VORLAGE_LOESCHEN'),
  VORLAGE_GELOESCHT:   tr('giveaway:JS.VORLAGE_GELOESCHT'),
  SPERRE_AUFHEBEN:     tr('giveaway:JS.SPERRE_AUFHEBEN'),
  SPERRE_AUFGEHOBEN:   tr('giveaway:JS.SPERRE_AUFGEHOBEN'),
  ABGELAUFEN:          tr('giveaway:JS.ABGELAUFEN'),
  ANF_KONTOALTER:      tr('giveaway:JS.ANF_KONTOALTER'),
  ANF_SERVERZEIT:      tr('giveaway:JS.ANF_SERVERZEIT'),
  ANF_ROLLE:           tr('giveaway:JS.ANF_ROLLE'),
  ANF_WERT:            tr('giveaway:JS.ANF_WERT')
};
%>
<%- include('shared/seitenkopf', {
      plugin:       'giveaway',
      vortitel:     tr('giveaway:TITLE'),
      titel:        titel,
      beschreibung: (typeof beschreibung !== 'undefined' ? beschreibung : null),
      icon:         icon,
      guildId:      guildId,
      texte:        jsTexte,
      aktion:       (typeof aktion !== 'undefined' ? aktion : null)
}) %>
