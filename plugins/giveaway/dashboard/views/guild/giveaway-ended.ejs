<%- include('partials/giveaway-kopf', {
  guildId, tr,
  icon: 'fa-solid fa-clock-rotate-left',
  titel: tr('giveaway:NAV.ENDED'),
  beschreibung: tr('giveaway:ENDED.SUBTITLE')
}) %>

<%
  const kanalName = (id) => {
    const k = (channels || []).find(c => String(c.id) === String(id));
    return k ? '#' + k.name : id;
  };
  const zeitpunkt = (w) => w ? new Date(w).toLocaleString('de-DE') : '—';

  /** Farbe je Einloesestand des Gewinns. */
  const claimFarbe = { claimed: 'green', pending: 'orange', expired: 'red' };
%>

<div class="card">
  <div class="card-header">
    <h3 class="card-title">
      <%= tr('giveaway:RECENT_TITLE') %>
      <span class="badge bg-secondary-lt ms-2"><%= (beendete || []).length %></span>
    </h3>
  </div>

  <% if (beendete && beendete.length > 0) { %>
    <div class="table-responsive">
      <table class="table card-table table-vcenter">
        <thead>
          <tr>
            <th><%= tr('giveaway:LIST_PRIZE') %></th>
            <th><%= tr('giveaway:LIST_CHANNEL') %></th>
            <th><%= tr('giveaway:LIST_WINNERS') %></th>
            <th><%= tr('giveaway:LIST_ENDED_AT') %></th>
            <th class="text-end"><%= tr('giveaway:LIST_ACTION') %></th>
          </tr>
        </thead>
        <tbody>
          <% beendete.forEach(v => { %>
            <tr>
              <td><strong><%= v.prize %></strong></td>
              <td class="text-secondary"><%= kanalName(v.channel_id) %></td>
              <td>
                <% if (v.winner_details && v.winner_details.length > 0) { %>
                  <% v.winner_details.forEach(g => { %>
                    <span class="badge bg-<%= claimFarbe[g.claim_status] || 'secondary' %>-lt me-1 mb-1 font-monospace">
                      <%= g.user_id %>
                    </span>
                  <% }); %>
                <% } else { %>
                  <span class="text-secondary"><%= tr('giveaway:ENDED.NO_WINNER') %></span>
                <% } %>
              </td>
              <td class="text-secondary"><%= zeitpunkt(v.ended_at) %></td>
              <td class="text-end">
                <div class="btn-list flex-nowrap justify-content-end">
                  <button type="button" class="btn btn-sm btn-outline-primary"
                          onclick="giveawayAction(<%= v.id %>, 'reroll')"
                          title="<%= tr('giveaway:BTN_REROLL') %>">
                    <i class="fa-solid fa-dice"></i>
                  </button>
                  <button type="button" class="btn btn-sm btn-outline-danger"
                          onclick="giveawayAction(<%= v.id %>, 'delete')"
                          title="<%= tr('giveaway:BTN_DELETE') %>">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <div class="card-footer text-secondary">
      <i class="fa-solid fa-circle-info me-2"></i><%= tr('giveaway:ENDED.CLAIM_LEGEND') %>
    </div>
  <% } else { %>
    <div class="card-body">
      <div class="empty">
        <div class="empty-icon"><i class="fa-solid fa-clock-rotate-left fs-1 text-secondary"></i></div>
        <p class="empty-title"><%= tr('giveaway:RECENT_EMPTY') %></p>
        <p class="empty-subtitle text-secondary"><%= tr('giveaway:ENDED.EMPTY_HINT') %></p>
      </div>
    </div>
  <% } %>
</div>
