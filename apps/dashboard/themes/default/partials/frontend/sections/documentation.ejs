<%#
  Startseiten-Abschnitt „Dokumentation": die Bereiche der Wissensdatenbank als
  Kacheln (Betreiber, 2026-10-11 — per Auswahl: „Bereiche als Kacheln", kein
  eigenes Feld am Artikel).

  Bis dahin standen hier vier feste Zeilen: zwei auf /docs, und „Github" sowie
  „Plugins" mit dem Ziel `https://#` — also ohne Ziel.

  @context {Array} wissensBereiche  Wissen.bereiche(locale); fehlt oder leer →
                                    nur Überschrift und der Verweis auf /kb
%>
<% const kbBereiche = (typeof wissensBereiche !== 'undefined' && Array.isArray(wissensBereiche)) ? wissensBereiche : []; %>

<section id="documentation" class="documentation section dark-background">
  <div class="container section-title" data-aos="fade-up">
    <h2><%= tr('KB.TITLE') %></h2>
    <p><%= tr('KB.HOME_SUBTITLE') %></p>
  </div>

  <div class="container">
    <div class="row g-3" data-aos="fade-up" data-aos-delay="200">
      <% kbBereiche.forEach(function (b) { %>
        <div class="col-sm-6 col-lg-4">
          <a class="kb-kachel" href="/kb/<%= b.kuerzel %>">
            <i class="bi <%= b.symbol %>"></i>
            <span class="kb-kachel-titel"><%= b.titel %></span>
            <% if (b.beschreibung) { %><span class="kb-kachel-text"><%= b.beschreibung %></span><% } %>
            <span class="kb-kachel-zahl"><%= b.artikel === 1 ? tr('KB.ARTICLES_ONE') : tr('KB.ARTICLES_MANY', { n: b.artikel }) %></span>
          </a>
        </div>
      <% }); %>
    </div>
    <p class="text-center mt-4 mb-0">
      <a class="btn btn-outline-light" href="/kb"><i class="bi bi-book me-1"></i><%= tr('KB.HOME_LINK') %></a>
    </p>
  </div>
</section>
