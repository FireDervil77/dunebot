<%#
 * Frontend-Kopfbereich: Favicon und Vorverbindungen.
 *
 * Die Stylesheets selbst kommen aus dem AssetManager — angemeldet in
 * `theme.js` (registerAssets), eingereiht pro Bereich (enqueueAssets).
 * Hier gehört nur noch hin, was kein Asset-Handle ist.
%>
<!-- Favicon -->
<link rel="icon" href="<%= theme.asset('images/kit/logo/web/avatar-64.png') %>" type="image/png">

<!-- Styles: Theme + Plugins (AssetManager) -->
<% if (locals.assetManager) { %>
  <%- assetManager.renderStyles() %>
<% } %>

<%# Design-Tokens aus theme.json — stehen zwischen tokens.css und der Guild-Anpassung %>
<% if (locals.themeTokensCSS) { %>
<style id="theme-tokens">
<%- locals.themeTokensCSS %>
</style>
<% } %>

<!-- Head-Skripte: Theme + Plugins (AssetManager) -->
<% if (locals.assetManager) { %>
  <%- assetManager.renderScripts(false) %>
<% } %>
