<%#
 * Frontend-Fußbereich: Bedienelemente und Skript-Ausgabe.
 *
 * Die Bibliotheken kommen aus dem AssetManager — angemeldet in `theme.js`
 * (registerAssets), eingereiht pro Bereich (enqueueAssets).
%>

<!-- Scroll Top -->
<a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

<!-- Preloader -->
<div id="preloader"></div>

<!-- Skripte: Theme + Plugins (AssetManager, Footer) -->
<% if (locals.assetManager) { %>
  <%- assetManager.renderScripts(true) %>
<% } %>

<%# Zusätzliche View-Skripte, die eine Route über `scripts` mitgibt %>
<% locals.scripts?.forEach(function(script) { %>
<script src="<%= script %>"></script>
<% }); %>

<!-- Language Switcher -->
<%- includePartial('frontend/language_switcher', locals) %>
