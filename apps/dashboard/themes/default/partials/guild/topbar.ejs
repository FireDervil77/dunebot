<%#
 * Obere Leiste — Tabler-Fassung
 *
 * Entspricht `guild/header_topbar` im Standard-Theme und bringt dieselben
 * Bauteile mit, nur mit Tabler-Markup und ohne die 243 Zeilen Wiederholung:
 *
 *   Startseite · Support · Server-Umschalter · Sprachwahl · Toast-Center ·
 *   Systemmeldungen · Vollbild · Nutzermenue
 *
 * Die Kennungen des Toast-Centers (toastNotificationBell/-Badge/-List) sind
 * vorgegeben — `toast-notification-center.js` sucht genau danach.
%>

<%
  const _guildId   = (typeof guild !== 'undefined' && guild?.id) || (typeof guildId !== 'undefined' ? guildId : null);
  const _guildName = (typeof guild !== 'undefined' && guild) ? (guild.name || 'Server') : 'Server';
  const _u         = (typeof locals !== 'undefined' && locals.user) ? locals.user : null;
  const _info      = _u && _u.info ? _u.info : _u;
  const _meldungen = (typeof locals !== 'undefined' && locals.globalNotifications) ? locals.globalNotifications : [];
  const _sprache   = (typeof locals !== 'undefined' && locals.locale) ? locals.locale : 'de-DE';

  // Server, die der Nutzer verwalten darf — dieselbe Regel wie im Standard-Theme:
  // Discord-Recht MANAGE_GUILD oder ADMINISTRATOR.
  const MANAGE_GUILD  = BigInt(0x20);
  const ADMINISTRATOR = BigInt(0x8);

  const _alleServer = (typeof userGuilds !== 'undefined' && Array.isArray(userGuilds)) ? userGuilds : [];
  const _meineServer = _alleServer.filter(g => {
      if (!g || !g.permissions) return false;

      // Server ohne Bot fliegen raus: Dort gibt es bei uns keine Daten, ein
      // Wechsel dorthin liefe ins Leere. `botInGuild` setzt die Basis-Middleware.
      // Fehlt die Angabe (DB nicht erreichbar), lieber zeigen als verstecken.
      if (g.botInGuild === false) return false;

      try {
          const rechte = BigInt(g.permissions);
          return (rechte & MANAGE_GUILD) === MANAGE_GUILD || (rechte & ADMINISTRATOR) === ADMINISTRATOR;
      } catch { return false; }
  });
%>

<%#
 * ── Warum `sticky-lg-top` und nicht `sticky-top` ──────────────────────────
 *
 * Die Leiste soll mitlaufen; unter 992px darf sie es aber NICHT.
 *
 * Grund ist der Umschalter links („navbar-toggler"): Er sitzt hier in der
 * oberen Leiste, sein Ziel `#sidebar-menu` steht aber im <aside> DARUEBER.
 * Ab 992px ist dieses aside `position: fixed` und immer sichtbar — dort gibt
 * es kein Problem. Darunter steht es im Fluss: Waere die Leiste dann klebrig,
 * koennte man weit unten auf der Seite den Umschalter druecken und das Menue
 * klappte ausserhalb des Bildes auf. Ein Knopf, der sichtbar nichts tut.
 *
 * 992px ist genau die Grenze, an der `navbar-expand-lg` am aside umschaltet —
 * also keine gewaehlte Zahl, sondern dieselbe.
 *
 * Die Sidebar liegt bei `z-index: 1030`, `.sticky-lg-top` bei 1020. Sie
 * ueberlappen sich nicht (die eine links, die andere rechts daneben), aber die
 * Reihenfolge stimmt damit auch dann, wenn es einmal anders kommt.
%>
<header class="navbar navbar-expand-md sticky-lg-top d-print-none">
  <div class="container-fluid">

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
            data-bs-target="#sidebar-menu" aria-label="Navigation umschalten">
      <span class="navbar-toggler-icon"></span>
    </button>

    <%# ── Links: Startseite und Support ─────────────────────────────────── %>
    <div class="navbar-nav flex-row order-md-first d-none d-md-flex">
      <div class="nav-item">
        <a class="nav-link" href="/" title="<%= tr('SIDEBAR.HOME') %>">
          <span class="nav-link-icon"><i class="fa-solid fa-house"></i></span>
          <span class="nav-link-title d-none d-lg-inline"><%= tr('SIDEBAR.HOME') %></span>
        </a>
      </div>
      <div class="nav-item">
        <a class="nav-link" href="<%= locals.supportUrl || '#' %>" target="_blank" rel="noopener">
          <span class="nav-link-icon"><i class="fab fa-discord"></i></span>
          <span class="nav-link-title d-none d-lg-inline"><%= tr('SIDEBAR.SUPPORT_DISCORD') %></span>
        </a>
      </div>
    </div>

    <div class="navbar-nav flex-row order-md-last align-items-center">

      <%# ── Server-Umschalter — nur bei mehr als einem Server ───────────── %>
      <% if (_meineServer.length > 1) { %>
        <div class="nav-item dropdown me-2">
          <a href="#" class="nav-link d-flex align-items-center gap-2" data-bs-toggle="dropdown"
             aria-expanded="false" title="<%= tr('GUILD_SWITCHER.TITLE') || 'Server wechseln' %>">
            <i class="fa-solid fa-server"></i>
            <span class="d-none d-lg-inline text-truncate" style="max-width: 12rem;"><%= _guildName %></span>
            <i class="fa-solid fa-angle-down small"></i>
          </a>
          <div class="dropdown-menu dropdown-menu-end" style="max-height: 24rem; overflow-y: auto;">
            <div class="dropdown-header"><%= tr('GUILD_SWITCHER.TITLE') || 'Deine Server' %></div>
            <% _meineServer.forEach(server => { %>
              <a class="dropdown-item d-flex align-items-center gap-2 <%= server.id === _guildId ? 'active' : '' %>"
                 href="/guild/<%= server.id %>/">
                <% if (server.icon) { %>
                  <img src="https://cdn.discordapp.com/icons/<%= server.id %>/<%= server.icon %>.png"
                       alt="" width="24" height="24" class="rounded flex-shrink-0">
                <% } else { %>
                  <span class="avatar avatar-xs rounded flex-shrink-0"><%= (server.name || '?').charAt(0) %></span>
                <% } %>
                <span class="text-truncate"><%= server.name %></span>
                <% if (server.id === _guildId) { %>
                  <i class="fa-solid fa-check text-success ms-auto"></i>
                <% } %>
              </a>
            <% }); %>
            <div class="dropdown-divider"></div>
            <a class="dropdown-item" href="/guild">
              <i class="fa-solid fa-list me-2"></i><%= tr('GUILD_SWITCHER.ALL') || 'Alle Server' %>
            </a>
          </div>
        </div>
      <% } else { %>
        <div class="nav-item d-none d-md-flex align-items-center me-2">
          <span class="text-secondary small me-2">Server</span>
          <span class="fw-semibold"><%= _guildName %></span>
        </div>
      <% } %>

      <%# ── Sprachwahl ──────────────────────────────────────────────────── %>
      <div class="nav-item dropdown me-1">
        <a href="#" class="nav-link px-2" data-bs-toggle="dropdown" aria-expanded="false"
           title="<%= tr('LANDING.LANGUAGE_SELECTOR') || 'Sprache' %>">
          <i class="fa-solid fa-language fs-3"></i>
        </a>
        <div class="dropdown-menu dropdown-menu-end">
          <div class="dropdown-header"><%= tr('LANDING.LANGUAGE_SELECTOR') || 'Sprache' %></div>
          <a href="#" class="dropdown-item lang-switch-link <%= _sprache === 'de-DE' ? 'active' : '' %>" data-lang="de-DE">Deutsch</a>
          <a href="#" class="dropdown-item lang-switch-link <%= _sprache === 'en-GB' ? 'active' : '' %>" data-lang="en-GB">English</a>
        </div>
      </div>

      <%# ── Toast-Center ────────────────────────────────────────────────── %>
      <div class="nav-item dropdown me-1" id="toastNotificationCenter">
        <a href="#" class="nav-link px-2 position-relative" data-bs-toggle="dropdown"
           id="toastNotificationBell" aria-expanded="false" aria-label="Verlauf der Hinweise">
          <i class="fa-regular fa-bell fs-3"></i>
          <span class="badge bg-red position-absolute top-0 end-0 d-none" id="toastNotificationBadge"></span>
        </a>
        <div class="dropdown-menu dropdown-menu-end dropdown-menu-card" style="min-width: 20rem;">
          <div class="card">
            <div class="card-header py-2">
              <h3 class="card-title mb-0"><i class="fa-regular fa-bell me-2"></i>Verlauf</h3>
            </div>
            <div class="list-group list-group-flush" id="toastNotificationList" style="max-height: 20rem; overflow-y: auto;">
              <div class="list-group-item text-secondary small">Wird geladen …</div>
            </div>
            <% if (_guildId) { %>
              <div class="card-footer p-2 text-center">
                <a href="/guild/<%= _guildId %>/feedback/toast-history" class="btn btn-sm btn-link">
                  Ganzen Verlauf ansehen
                </a>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <%# ── Systemmeldungen ─────────────────────────────────────────────── %>
      <div class="nav-item dropdown me-1 d-none d-md-flex">
        <a href="#" class="nav-link px-2 position-relative" data-bs-toggle="dropdown"
           aria-expanded="false" aria-label="Systemmeldungen">
          <i class="fa-solid fa-circle-info fs-3"></i>
          <% if (_meldungen.length > 0) { %>
            <span class="badge bg-orange position-absolute top-0 end-0"><%= _meldungen.length %></span>
          <% } %>
        </a>
        <%#
          **Breite: `width`, nicht `min-width`.** Vorher stand hier
          `min-width: 20rem` — zusammen mit `text-truncate` in einer
          Flex-Spalte ergab das den Fehler, den der Betreiber gemeldet hat:
          "diese nachrichten sind immer derartig breit, das man sie nicht
          lesen kann".

          Der Grund ist eine Flexbox-Eigenheit, die genau andersherum wirkt,
          als der Klassenname verspricht: `text-truncate` setzt
          `white-space: nowrap`. Ein Flex-Element darf aber nicht unter seine
          **min-content**-Breite schrumpfen, und die ist bei `nowrap` die
          ganze Zeile. Die Spalte wuchs also auf die laengste Meldung, das
          Klappmenue mit ihr — `min-width` deckelte nichts. Abgeschnitten
          wurde nie etwas; stattdessen wurde alles zu breit.

          Zwei Auswege: `min-width: 0` setzen (dann kuerzt es wirklich, aber
          man liest weiterhin nur den Anfang) — oder umbrechen lassen. Da die
          Beschwerde "man kann sie nicht lesen" lautet, wird umgebrochen.

          `overflow-wrap: anywhere` steht dabei, weil eine lange Adresse ohne
          Leerzeichen sonst genau dasselbe wieder ausloest.
        %>
        <div class="dropdown-menu dropdown-menu-end dropdown-menu-card"
             style="width: 24rem; max-width: calc(100vw - 1.5rem);">
          <div class="card">
            <div class="card-header py-2">
              <h3 class="card-title mb-0">Systemmeldungen</h3>
            </div>
            <%# Deckel gegen fuenf lange Meldungen, wie ihn die Glocke daneben auch hat. %>
            <div class="list-group list-group-flush" style="max-height: 24rem; overflow-y: auto;">
              <% if (_meldungen.length === 0) { %>
                <div class="list-group-item text-secondary small">Nichts Neues.</div>
              <% } else { %>
                <% _meldungen.slice(0, 5).forEach(m => { %>
                  <div class="list-group-item">
                    <div class="row align-items-start">
                      <div class="col-auto pt-1">
                        <span class="status-dot bg-<%= m.type || 'blue' %> d-block"></span>
                      </div>
                      <%#
                        Titel und Text werden bewusst UNMASKIERT ausgegeben:
                        Diese Meldungen schreibt ausschliesslich der Betreiber
                        im Adminbereich (alle INSERTs stehen in
                        routes/admin/content.router.js). Auf maskierte Ausgabe
                        umzustellen wuerde seine Formatierung als Text zeigen.
                      %>
                      <div class="col" style="min-width: 0; overflow-wrap: anywhere;">
                        <span class="text-reset d-block fw-medium"><%- m.title || '' %></span>
                        <div class="d-block text-secondary small mt-1"><%- m.message || '' %></div>
                      </div>
                    </div>
                  </div>
                <% }); %>
                <% if (_meldungen.length > 5) { %>
                  <div class="list-group-item text-secondary small text-center">
                    … und <%= _meldungen.length - 5 %> weitere
                  </div>
                <% } %>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <%# ── Vollbild ────────────────────────────────────────────────────── %>
      <div class="nav-item d-none d-lg-flex me-1">
        <a href="#" class="nav-link px-2" id="vollbild-umschalter" title="Vollbild" aria-label="Vollbild">
          <i class="fa-solid fa-expand fs-3"></i>
        </a>
      </div>

      <%# ── Nutzermenue ─────────────────────────────────────────────────── %>
      <div class="nav-item dropdown">
        <a href="#" class="nav-link d-flex lh-1 p-0 px-2" data-bs-toggle="dropdown" aria-label="Nutzermenü öffnen">
          <span class="avatar avatar-sm rounded"
                style="background-image: url(<%= typeof getUserAvatar === 'function' ? getUserAvatar(_u, 64) : '' %>)"></span>
          <div class="d-none d-xl-block ps-2">
            <div><%= _info && _info.username ? _info.username : 'Angemeldet' %></div>
            <div class="mt-1 small text-secondary">
              <% if (_u && (_u.isOwner || _u.hasSystemAccess)) { %>System<% } else { %>Mitglied<% } %>
            </div>
          </div>
        </a>
        <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
          <% if (_guildId) { %>
            <a href="/guild/<%= _guildId %>/profile" class="dropdown-item"><i class="fa-regular fa-user me-2"></i>Profil</a>
            <a href="/guild/<%= _guildId %>/settings" class="dropdown-item"><i class="fa-solid fa-sliders me-2"></i>Einstellungen</a>
            <div class="dropdown-divider"></div>
          <% } %>
          <a href="/" class="dropdown-item"><i class="fa-solid fa-globe me-2"></i><%= tr('DASHBOARD_COMMON.TO_FRONTEND') || 'Zur Startseite' %></a>
          <a href="/guild" class="dropdown-item"><i class="fa-solid fa-repeat me-2"></i>Server wechseln</a>
          <div class="dropdown-divider"></div>
          <a href="/auth/logout" class="dropdown-item text-danger"><i class="fa-solid fa-arrow-right-from-bracket me-2"></i>Abmelden</a>
        </div>
      </div>

    </div>
  </div>
</header>

<script>
// Vollbild — Tabler bringt dafuer nichts mit, AdminLTE hatte data-lte-toggle
document.getElementById('vollbild-umschalter')?.addEventListener('click', function (e) {
    e.preventDefault();
    var symbol = this.querySelector('i');
    if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen?.();
        if (symbol) symbol.className = 'fa-solid fa-compress fs-3';
    } else {
        document.exitFullscreen?.();
        if (symbol) symbol.className = 'fa-solid fa-expand fs-3';
    }
});
</script>
