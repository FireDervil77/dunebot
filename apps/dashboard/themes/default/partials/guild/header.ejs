<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<% if (locals.title) { %>
    <title><%= locals.title %></title>
<% } else { %>
    <title><%= tr('DASHBOARD.BOTNAME') %> - <%= tr('DASHBOARD_COMMON.ADMIN_AREA') %></title>
<% } %>
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />

<% if (locals.title) { %>
   <meta name="title" content="<%= locals.title %>" />
<% } else { %>
    <meta name="title" content="<%= tr('DASHBOARD.BOTNAME') %> - <%= tr('DASHBOARD_COMMON.ADMIN_AREA') %>" />
<% } %>
<meta name="author" content="FireDervil" />
<%- locals.csrfMetaTag || '' %>
<meta name="description" content="<%= tr('DASHBOARD_COMMON.DESCRIPTION_META') %>"/>
<meta name="keywords" content="TODO:KEYWORDS"/>

<link rel="icon" href="<%= theme.asset('images/favicon.png') %>" type="image/png">

<%- includePartial('guild/analytics') %>

<!-- Styles: Theme + Plugins (AssetManager) -->
<% if (locals.assetManager) { %>
  <%- assetManager.renderStyles() %>
<% } %>

<%# Design-Tokens aus theme.json — stehen zwischen tokens.css und der Guild-Anpassung %>
<% if (locals.themeTokensCSS) { %>
<style id="theme-tokens">
<%- locals.themeTokensCSS %>
</style>
<% } %>

<!-- Head-Skripte: Theme + Plugins (AssetManager) -->
<% if (locals.assetManager) { %>
  <%- assetManager.renderScripts(false) %>
<% } %>
  
<!-- Hook: dashboard_head -->
<% if (locals.hooks && hooks.getViewHooks) { %>
  <% const headHooks = hooks.getViewHooks('dashboard_head'); %>
  <% if (headHooks && headHooks.length > 0) { %>
    <% headHooks.forEach(hook => { %>
      <%- include(hook.component, { plugin: hook.plugin, context: hook.context || {} }) %>
    <% }); %>
  <% } %>
<% } %>
<!-- Hook:end: dashboard_head -->

<!-- View Styles (express-ejs-layouts) -->
<% if (typeof style !== 'undefined') { %>
  <%- style %>
<% } %>

<!-- Guild Custom CSS (Theme-Editor) -->
<% if (locals.guildCustomCSS) { %>
<style id="guild-custom-css">
<%- locals.guildCustomCSS %>
</style>
<% } %>