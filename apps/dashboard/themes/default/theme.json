{
  "name": "default",
  "displayName": "FireBot Default",
  "version": "2.1.0",
  "description": "Standard-Theme auf Tabler (Bootstrap 5). Der Guild-Bereich laeuft vollstaendig darauf; Anmeldung und oeffentliche Webseite folgen in einem eigenen Durchgang.",
  "author": "FireBot Team",
  "screenshot": "https://dev.firenetworks.de/uploads/media/1403034310172475416/1773746247397-ea467e07cba9879f.png",
  "parent": null,
  "tags": [
    "admin",
    "responsive",
    "tabler"
  ],
  "requires": "1.0.0",
  "supports": {
    "darkMode": true,
    "rtl": false,
    "responsive": true
  },
  "config": {
    "darkMode": true,
    "primaryColor": "#6f4fd0",
    "accentColor": "#f39c12",
    "logo": "images/firebot.png",
    "favicon": "images/favicon.png"
  },
  "tokens": {
    "fb-primary": "#6f4fd0",
    "fb-primary-hover": "#5c3fb8",
    "fb-accent": "#f39c12",
    "fb-link": "#6f4fd0",
    "fb-link-hover": "#5c3fb8",
    "fb-body-bg": "#f6f4fa",
    "fb-surface-bg": "#ffffff",
    "fb-header-bg": "#ffffff",
    "fb-sidebar-bg": "#171423",
    "fb-sidebar-text": "#c9c4d8",
    "fb-sidebar-hover-bg": "#211c33",
    "fb-sidebar-hover-text": "#ffffff",
    "fb-sidebar-active-bg": "#6f4fd0",
    "fb-sidebar-active-text": "#ffffff",
    "fb-text": "#221f2e",
    "fb-text-muted": "#5d5872",
    "fb-border": "#e3dff0",
    "fb-radius": "8px"
  },
  "layouts": {
    "frontend": "layouts/frontend.ejs",
    "guild": "layouts/guild.ejs",
    "auth": "layouts/auth.ejs"
  }
}
