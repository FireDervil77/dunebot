<%#
 * Admin Content Hub — Unified Content Management
 * Vereint: News, Changelogs, Benachrichtigungen, Einstellungen
 *
 * @context {string} activeTab   — 'news' | 'changelogs' | 'notifications' | 'settings'
 * @context {Array}  newsList    — lokalisierte News
 * @context {Array}  changelogsList — lokalisierte Changelogs
 * @context {Array}  notifications — Alle Benachrichtigungen (inkl. Ankündigungen)
 * @context {string} currentLocale
 * @context {Object} channelConfig — Channel-Config pro Kategorie
 * @context {Array}  categories    — Kategorie-Liste
 * @context {string} controlGuildId
%>


<div class="content">
    <div class="container-fluid">

        <%# ====== TAB NAVIGATION ====== %>
        <div class="card">
            <div class="card-status-top bg-primary"></div>
            <div class="card-header p-0 pt-1 border-bottom-0">
                <ul class="nav nav-tabs" id="contentTabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link <%= activeTab === 'news' ? 'active' : '' %>"
                           href="/admin/content?tab=news" data-tab="news">
                            <i class="fas fa-newspaper me-1"></i> News
                            <span class="badge bg-info-lt ms-1"><%= newsList ? newsList.length : 0 %></span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= activeTab === 'blog' ? 'active' : '' %>"
                           href="/admin/content?tab=blog" data-tab="blog">
                            <i class="fas fa-blog me-1"></i> Blog
                            <span class="badge bg-info-lt ms-1"><%= blogPosts ? blogPosts.length : 0 %></span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= activeTab === 'changelogs' ? 'active' : '' %>"
                           href="/admin/content?tab=changelogs" data-tab="changelogs">
                            <i class="fas fa-code-branch me-1"></i> Changelogs
                            <span class="badge bg-info-lt ms-1"><%= changelogsList ? changelogsList.length : 0 %></span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= activeTab === 'notifications' ? 'active' : '' %>"
                           href="/admin/content?tab=notifications" data-tab="notifications">
                            <i class="fas fa-bell me-1"></i> Benachrichtigungen
                            <span class="badge bg-info-lt ms-1"><%= notifications ? notifications.length : 0 %></span>
                        </a>
                    </li>
                    <li class="nav-item ms-auto">
                        <a class="nav-link <%= activeTab === 'analytics' ? 'active' : '' %>"
                           href="/admin/content?tab=analytics" data-tab="analytics">
                            <i class="fas fa-chart-line me-1"></i> Analyse &amp; Cookies
                            <% if (locals.analytics && analytics.aktiv && analytics.gtmId) { %>
                                <span class="badge bg-success-lt ms-1">aktiv</span>
                            <% } else { %>
                                <span class="badge bg-secondary-lt ms-1">aus</span>
                            <% } %>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= activeTab === 'settings' ? 'active' : '' %>"
                           href="/admin/content?tab=settings" data-tab="settings">
                            <i class="fas fa-cog me-1"></i> Einstellungen
                        </a>
                    </li>
                </ul>
            </div>

            <div class="card-body">
                <div class="tab-content" id="contentTabContent">

                    <%# ====== NEWS TAB ====== %>
                    <div class="tab-pane fade <%= activeTab === 'news' ? 'show active' : '' %>" id="tab-news">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h4 class="mb-0">News Verwalten</h4>
                            <a href="/admin/content/news/new" class="btn btn-primary btn-sm">
                                <i class="fas fa-plus me-1"></i> Neue News
                            </a>
                        </div>

                        <% if (newsList && newsList.length > 0) { %>
                        <table class="table table-striped table-hover table-sm">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Titel</th>
                                    <th>Status</th>
                                    <th>Autor</th>
                                    <th>Datum</th>
                                    <th style="width:140px">Aktionen</th>
                                </tr>
                            </thead>
                            <tbody>
                            <% newsList.forEach((n, i) => { %>
                                <tr>
                                    <td><%= i + 1 %></td>
                                    <td>
                                        <strong><%= n.title || 'Ohne Titel' %></strong>
                                        <% if (n.slug) { %>
                                            <br><small class="text-secondary">/news-details/<%= n.slug %></small>
                                        <% } %>
                                    </td>
                                    <td>
                                        <span class="badge bg-<%= n.status === 'published' ? 'success' : 'warning' %>-lt">
                                            <%= n.status || 'draft' %>
                                        </span>
                                    </td>
                                    <td><%= n.author || '—' %></td>
                                    <td><%= n.formattedDate || '—' %></td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a href="/admin/content/news/edit/<%= n._id %>" class="btn btn-info" title="Bearbeiten">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button class="btn btn-success" data-link-type="news" data-link-id="<%= n._id %>" data-link-title="<%= (n.title || '').replace(/"/g, '&quot;') %>" onclick="linkContent(this.dataset.linkType, this.dataset.linkId, this.dataset.linkTitle)" title="Verknüpfen">
                                                <i class="fas fa-link"></i>
                                            </button>
                                            <button class="btn btn-danger" onclick="deleteContent('news', '<%= n._id %>')" title="Löschen">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                            </tbody>
                        </table>
                        <% } else { %>
                        <div class="text-center text-secondary py-5">
                            <i class="fas fa-newspaper fa-3x mb-3"></i>
                            <p>Noch keine News vorhanden.</p>
                            <a href="/admin/content/news/new" class="btn btn-primary">
                                <i class="fas fa-plus me-1"></i> Erste News erstellen
                            </a>
                        </div>
                        <% } %>
                    </div>

                    <%# ====== BLOG TAB ====== %>
                    <div class="tab-pane fade <%= activeTab === 'blog' ? 'show active' : '' %>" id="tab-blog">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h4 class="mb-0">Blog Verwalten</h4>
                            <a href="/admin/content/blog/new" class="btn btn-primary btn-sm">
                                <i class="fas fa-plus me-1"></i> Neuer Blog-Post
                            </a>
                        </div>

                        <% if (blogPosts && blogPosts.length > 0) { %>
                        <table class="table table-striped table-hover table-sm">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Titel</th>
                                    <th>Kategorie</th>
                                    <th>Status</th>
                                    <th>Autor</th>
                                    <th>Datum</th>
                                    <th style="width:100px">Aktionen</th>
                                </tr>
                            </thead>
                            <tbody>
                            <% blogPosts.forEach((p, i) => { %>
                                <tr>
                                    <td><%= i + 1 %></td>
                                    <td>
                                        <strong><%= p.title || 'Ohne Titel' %></strong>
                                        <% if (p.slug) { %>
                                            <br><small class="text-secondary">/blog/<%= p.slug %></small>
                                        <% } %>
                                    </td>
                                    <td><span class="badge bg-secondary-lt"><%= p.category || 'gaming' %></span></td>
                                    <td>
                                        <span class="badge bg-<%= p.status === 'published' ? 'success' : 'warning' %>-lt">
                                            <%= p.status || 'draft' %>
                                        </span>
                                    </td>
                                    <td><%= p.author || '—' %></td>
                                    <td><%= p.formattedDate %></td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a href="/admin/content/blog/edit/<%= p.id %>" class="btn btn-info" title="Bearbeiten">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button class="btn btn-danger" onclick="deleteContent('blog', '<%= p.id %>')" title="Löschen">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                            </tbody>
                        </table>
                        <% } else { %>
                        <div class="text-center text-secondary py-5">
                            <i class="fas fa-blog fa-3x mb-3"></i>
                            <p>Noch keine Blog-Posts vorhanden.</p>
                            <a href="/admin/content/blog/new" class="btn btn-primary">
                                <i class="fas fa-plus me-1"></i> Ersten Blog-Post erstellen
                            </a>
                        </div>
                        <% } %>
                    </div>

                    <%# ====== CHANGELOGS TAB ====== %>
                    <div class="tab-pane fade <%= activeTab === 'changelogs' ? 'show active' : '' %>" id="tab-changelogs">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h4 class="mb-0">Changelogs Verwalten</h4>
                            <a href="/admin/content/changelogs/new" class="btn btn-primary btn-sm">
                                <i class="fas fa-plus me-1"></i> Neuer Changelog
                            </a>
                        </div>

                        <% if (changelogsList && changelogsList.length > 0) { %>
                        <table class="table table-striped table-hover table-sm">
                            <thead>
                                <tr>
                                    <th>Version</th>
                                    <th>Titel</th>
                                    <th>Type</th>
                                    <th>Komponente</th>
                                    <th>Status</th>
                                    <th>Release</th>
                                    <th style="width:140px">Aktionen</th>
                                </tr>
                            </thead>
                            <tbody>
                            <% changelogsList.forEach(c => { %>
                                <tr>
                                    <td><span class="badge bg-<%= c.typeBadge?.color || 'secondary' %>-lt">v<%= c.version %></span></td>
                                    <td><strong><%= c.title || 'Ohne Titel' %></strong></td>
                                    <td><%= c.type || 'minor' %></td>
                                    <td><%= c.component || 'system' %></td>
                                    <td>
                                        <span class="badge bg-<%= c.status === 'published' ? 'success' : 'warning' %>-lt">
                                            <%= c.status || 'draft' %>
                                        </span>
                                    </td>
                                    <td><%= c.formattedDate || '—' %></td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a href="/admin/content/changelogs/edit/<%= c.id %>" class="btn btn-info" title="Bearbeiten">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button class="btn btn-success" data-link-type="changelog" data-link-id="<%= c.id %>" data-link-title="v<%= c.version %>" onclick="linkContent(this.dataset.linkType, this.dataset.linkId, this.dataset.linkTitle)" title="Verknüpfen">
                                                <i class="fas fa-link"></i>
                                            </button>
                                            <button class="btn btn-danger" onclick="deleteContent('changelogs', '<%= c.id %>')" title="Löschen">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                            </tbody>
                        </table>
                        <% } else { %>
                        <div class="text-center text-secondary py-5">
                            <i class="fas fa-code-branch fa-3x mb-3"></i>
                            <p>Noch keine Changelogs vorhanden.</p>
                            <a href="/admin/content/changelogs/new" class="btn btn-primary">
                                <i class="fas fa-plus me-1"></i> Ersten Changelog erstellen
                            </a>
                        </div>
                        <% } %>
                    </div>

                    <%# ====== BENACHRICHTIGUNGEN TAB ====== %>
                    <div class="tab-pane fade <%= activeTab === 'notifications' ? 'show active' : '' %>" id="tab-notifications">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h4 class="mb-0">Benachrichtigungen</h4>
                            <a href="/admin/content/notifications/new" class="btn btn-primary btn-sm">
                                <i class="fas fa-plus me-1"></i> Neue Benachrichtigung
                            </a>
                        </div>

                        <% if (notifications && notifications.length > 0) { %>
                        <table class="table table-striped table-hover table-sm">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Titel</th>
                                    <th>Type</th>
                                    <th>Kategorie</th>
                                    <th>Zustellung</th>
                                    <th>Erstellt</th>
                                    <th style="width:120px">Aktionen</th>
                                </tr>
                            </thead>
                            <tbody>
                            <% notifications.forEach((n, i) => { %>
                                <%
                                const catEmojis = { changelog: '📋', status: '🔔', maintenance: '🔧', other: '📌' };
                                let deliveryBadges = '';
                                try {
                                    const dm = typeof n.delivery_method === 'string' ? JSON.parse(n.delivery_method) : (n.delivery_method || ['dashboard']);
                                    deliveryBadges = dm.map(m => {
                                        const icons = { dashboard: '🖥️', discord_category: '📂', system_channel: '📡', discord_channel: '#️⃣', discord_dm: '✉️' };
                                        return icons[m] || m;
                                    }).join(' ');
                                } catch(e) { deliveryBadges = '🖥️'; }
                                %>
                                <tr>
                                    <td><%= i + 1 %></td>
                                    <td><strong><%= n.title || 'Untitled' %></strong></td>
                                    <td>
                                        <% const tIcons = { info:'info-circle text-info', warning:'exclamation-triangle text-warning', error:'exclamation-circle text-danger', success:'check-circle text-success' }; %>
                                        <i class="fas fa-<%= tIcons[n.type] || 'bell' %>"></i> <%= n.type %>
                                    </td>
                                    <td><%= catEmojis[n.category] || '📌' %> <%= n.category || 'other' %></td>
                                    <td><%= deliveryBadges %></td>
                                    <td><%= new Date(n.created_at).toLocaleDateString(currentLocale) %></td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a href="/admin/content/notifications/edit/<%= n.id %>" class="btn btn-info" title="Bearbeiten">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button class="btn btn-danger" onclick="deleteContent('notifications', '<%= n.id %>')" title="Löschen">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                            </tbody>
                        </table>
                        <% } else { %>
                        <div class="text-center text-secondary py-5">
                            <i class="fas fa-bell fa-3x mb-3"></i>
                            <p>Keine Benachrichtigungen vorhanden.</p>
                            <a href="/admin/content/notifications/new" class="btn btn-primary">
                                <i class="fas fa-plus me-1"></i> Erste Benachrichtigung
                            </a>
                        </div>
                        <% } %>
                    </div>

                    <%# ====== ANALYSE & COOKIES TAB ====== %>
                    <div class="tab-pane fade <%= activeTab === 'analytics' ? 'show active' : '' %>" id="tab-analytics">
                        <% const _an = locals.analytics || { gtmId: '', aktiv: false, version: 1, kategorien: [] }; %>

                        <h4 class="mb-3"><i class="fas fa-chart-line me-2"></i>Google Tag Manager</h4>

                        <div class="alert alert-warning">
                            <h5><i class="fas fa-triangle-exclamation me-1"></i> Was GTM lädt, siehst du hier nicht</h5>
                            <p class="mb-0">
                                Die Tags verwaltest du im GTM-Container bei Google. Ergänzt dort jemand ein
                                Marketing-Tag, ändern sich die gesetzten Cookies &mdash; ohne dass in diesem
                                Dashboard etwas davon steht. <strong>Die Kategorien unten und der Text auf der
                                Datenschutzseite musst du dann von Hand nachziehen.</strong>
                            </p>
                        </div>

                        <form id="analyticsForm">
                            <div class="mb-3">
                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input" id="analytics_aktiv"
                                           name="aktiv" <%= _an.aktiv ? 'checked' : '' %>>
                                    <label class="form-check-label" for="analytics_aktiv">
                                        Tag Manager und Cookie-Abfrage aktiv
                                    </label>
                                </div>
                                <small class="form-text text-secondary">
                                    Aus heißt: kein GTM, kein Banner, keine Cookies außer der Sitzung.
                                    Die Container-ID bleibt dabei gespeichert.
                                </small>
                            </div>

                            <div class="mb-3">
                                <label for="analytics_gtm_id">GTM-Container-ID</label>
                                <input type="text" class="form-control" id="analytics_gtm_id" name="gtmId"
                                       value="<%= _an.gtmId %>" placeholder="GTM-XXXXXXX"
                                       pattern="GTM-[A-Za-z0-9]{4,10}">
                                <small class="form-text text-secondary">
                                    Format <code>GTM-XXXXXXX</code>. Leer lassen schaltet die Einbindung ab &mdash;
                                    eine falsche ID erzeugt keinen Fehler, es passiert dann einfach nichts.
                                </small>
                            </div>

                            <hr>
                            <h5 class="mb-3">Kategorien der Abfrage</h5>
                            <p class="text-secondary">
                                „Notwendig" lässt sich nicht abwählen &mdash; darin stecken die Sitzung und die
                                Speicherung dieser Auswahl selbst. Alles andere ist standardmäßig <strong>aus</strong>.
                            </p>

                            <table class="table table-sm">
                                <thead>
                                    <tr><th style="width:12rem">Kategorie</th><th>Beschreibung für den Besucher</th><th style="width:8rem">Pflicht</th></tr>
                                </thead>
                                <tbody>
                                <% (_an.kategorien || []).forEach(function (k, i) { %>
                                    <tr>
                                        <td>
                                            <input type="hidden" name="kat_key_<%= i %>" value="<%= k.key %>">
                                            <input type="text" class="form-control form-control-sm"
                                                   name="kat_label_<%= i %>" value="<%= k.label %>">
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm"
                                                   name="kat_desc_<%= i %>" value="<%= k.beschreibung %>">
                                        </td>
                                        <td class="text-center align-middle">
                                            <% if (k.pflicht) { %>
                                                <span class="badge bg-secondary-lt">Pflicht</span>
                                            <% } else { %>
                                                <span class="text-secondary">abwählbar</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                                </tbody>
                            </table>

                            <hr>
                            <div class="mb-3">
                                <label for="analytics_version">Fassung des Einwilligungstextes</label>
                                <div class="input-group" style="max-width:22rem">
                                    <input type="number" class="form-control" id="analytics_version"
                                           name="version" value="<%= _an.version %>" min="1" step="1">
                                    <button type="button" class="btn btn-outline-secondary" id="versionHoch">
                                    +1 &amp; erneut fragen
                                    </button>
                                </div>
                                <small class="form-text text-secondary">
                                    Erhöhen, wenn sich der Text wesentlich ändert: Alle bisherigen Einwilligungen
                                    verlieren damit ihre Gültigkeit und die Abfrage erscheint erneut.
                                    <strong>Ohne diesen Schritt gilt eine veraltete Einwilligung weiter.</strong>
                                </small>
                            </div>

                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i> Speichern
                            </button>
                            <span id="analyticsStatus" class="ms-2 small"></span>
                        </form>

                        <hr>
                        <h5><i class="fas fa-clipboard-check me-2"></i>Nachweis</h5>
                        <p class="text-secondary mb-2">
                            Erteilte Einwilligungen werden protokolliert &mdash; die DSGVO verlangt, dass du sie
                            belegen kannst. Gespeichert werden Zeitpunkt, Auswahl und Fassung;
                            <strong>keine IP im Klartext</strong>, nur ein gesalzener Hash.
                        </p>
                        <p>
                            <span class="badge bg-info-lt"><%= locals.consentAnzahl || 0 %></span>
                            Einträge insgesamt<% if (locals.consentLetzter) { %>,
                            zuletzt am <%= new Date(consentLetzter).toLocaleString('de-DE') %><% } %>.
                        </p>

                        <div class="alert alert-danger">
                            <h5><i class="fas fa-scale-balanced me-1"></i> Was ich nicht abnehmen kann</h5>
                            <p class="mb-0">
                                Der Mechanismus hier ist gebaut. <strong>Die Formulierungen im Banner und auf
                                der Datenschutzseite gehören von jemandem geprüft, der dafür haftet</strong> &mdash;
                                sie hängen daran, welche Tags du einsetzt und wohin die Daten fließen.
                            </p>
                        </div>
                    </div>

                    <%# ====== EINSTELLUNGEN TAB ====== %>
                    <div class="tab-pane fade <%= activeTab === 'settings' ? 'show active' : '' %>" id="tab-settings">
                        <h4 class="mb-3"><i class="fas fa-cog me-2"></i>Channel-Konfiguration</h4>

                        <div class="alert alert-info">
                            <h5><i class="fas fa-info-circle me-1"></i> Hinweis</h5>
                            <p class="mb-0">
                                Hier legst du fest, in welchem Discord-Channel Inhalte je nach Kategorie gepostet werden.
                                Die Channels beziehen sich auf den <strong>Control-Server</strong>
                                <% if (controlGuildId) { %>(ID: <code><%= controlGuildId %></code>)<% } %>.
                            </p>
                        </div>

                        <form id="channel-config-form" method="POST">

                            <div class="card">
                                <div class="card-header">
                                    <h3 class="card-title"><i class="fas fa-hashtag me-2"></i>Channel pro Kategorie</h3>
                                </div>
                                <div class="card-body">
                                    <div id="channels-loading" class="text-center py-4">
                                        <i class="fas fa-spinner fa-spin fa-2x"></i>
                                        <p class="mt-2 text-secondary">Lade Discord-Channels...</p>
                                    </div>

                                    <div id="channels-content" style="display: none;">
                                        <%
                                        const settingsCatLabels = {
                                            announcement: '📢 Ankündigungen',
                                            changelog: '📋 Changelogs',
                                            news: '📰 News',
                                            status: '🔔 Status',
                                            maintenance: '🔧 Wartung',
                                            other: '📌 Sonstige'
                                        };
                                        %>
                                        <% for (const cat of categories) { %>
                                            <div class="mb-3 row">
                                                <label class="col-sm-3 col-form-label">
                                                    <%= settingsCatLabels[cat] || cat %>
                                                </label>
                                                <div class="col-sm-7">
                                                    <select class="form-control channel-select"
                                                            id="channel_<%= cat %>"
                                                            name="channel_<%= cat %>"
                                                            data-category="<%= cat %>">
                                                        <option value="">— Kein Channel (deaktiviert) —</option>
                                                    </select>
                                                    <input type="hidden" name="channel_name_<%= cat %>" id="channel_name_<%= cat %>" value="">
                                                </div>
                                                <div class="col-sm-2">
                                                    <span class="channel-status-<%= cat %>">
                                                    <% if (channelConfig[cat]?.channel_id) { %>
                                                        <span class="badge bg-success-lt mt-2 d-inline-block">
                                                            <i class="fas fa-check"></i> Konfiguriert
                                                        </span>
                                                    <% } else { %>
                                                        <span class="badge bg-warning-lt mt-2 d-inline-block">
                                                            <i class="fas fa-exclamation-triangle"></i> Nicht gesetzt
                                                        </span>
                                                    <% } %>
                                                    </span>
                                                </div>
                                            </div>
                                        <% } %>
                                    </div>

                                    <div id="channels-error" class="alert alert-danger" style="display: none;">
                                        <i class="fas fa-exclamation-triangle me-1"></i>
                                        <span id="channels-error-msg">Fehler beim Laden der Channels.</span>
                                    </div>

                                    <div id="channels-save-result" style="display: none;"></div>
                                </div>
                                <div class="card-footer">
                                    <button type="submit" class="btn btn-primary" id="btn-save-channels" disabled>
                                        <i class="fas fa-save me-2"></i>Speichern
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                </div><%# /tab-content %>
            </div><%# /card-body %>
        </div><%# /card %>

    </div>
</div>

<%# ====== VERKNÜPFUNGS-MODAL ====== %>
<div class="modal fade" id="linkModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-link me-2"></i>Inhalt verknüpfen</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
            </div>
            <div class="modal-body">
                <p>Verknüpfe <strong id="link-source-name"></strong> mit:</p>
                <div class="list-group" id="link-targets">
                    <a href="#" class="list-group-item list-group-item-action" data-action="copy-url">
                        <i class="fas fa-clipboard me-2"></i> URL in Zwischenablage kopieren
                    </a>
                    <a href="#" class="list-group-item list-group-item-action" data-action="create-news">
                        <i class="fas fa-newspaper me-2"></i> Neue News mit Verweis erstellen
                    </a>
                    <a href="#" class="list-group-item list-group-item-action" data-action="create-notification">
                        <i class="fas fa-bell me-2"></i> Neue Benachrichtigung mit Verweis erstellen
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
/**
 * Ein Fenster ansprechen — Bootstrap-5-Schnittstelle.
 * jQuery ist unter Tabler geladen, dessen Fenster-Methode aber nicht: Der
 * Aufruf warf, und alles danach im selben Block lief nicht mehr.
 */
function fenster(id) {
    const el = document.getElementById(id);
    return (el && window.bootstrap) ? bootstrap.Modal.getOrCreateInstance(el) : null;
}

document.addEventListener('DOMContentLoaded', function() {

    // ====== ANALYSE & COOKIES: Speichern ======
    const analyticsForm = document.getElementById('analyticsForm');
    if (analyticsForm) {
        const status = document.getElementById('analyticsStatus');

        // "+1 & erneut fragen" - der einzige Weg, eine erteilte Einwilligung
        // ungueltig zu machen. Deshalb ein eigener Knopf und kein stilles Feld.
        document.getElementById('versionHoch')?.addEventListener('click', function () {
            const feld = document.getElementById('analytics_version');
            feld.value = (parseInt(feld.value, 10) || 1) + 1;
        });

        analyticsForm.addEventListener('submit', async function (e) {
            e.preventDefault();
            status.textContent = 'Speichere …';
            status.className = 'ms-2 small text-secondary';

            const kategorien = [];
            analyticsForm.querySelectorAll('input[name^="kat_key_"]').forEach(function (feld) {
                const i = feld.name.replace('kat_key_', '');
                kategorien.push({
                    key:          feld.value,
                    label:        analyticsForm.querySelector('[name="kat_label_' + i + '"]')?.value || feld.value,
                    beschreibung: analyticsForm.querySelector('[name="kat_desc_' + i + '"]')?.value || '',
                    pflicht:      feld.value === 'notwendig'
                });
            });

            try {
                const resp = await fetch('/admin/content/analytics/save', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || ''
                    },
                    body: JSON.stringify({
                        gtmId:   document.getElementById('analytics_gtm_id').value,
                        aktiv:   document.getElementById('analytics_aktiv').checked,
                        version: parseInt(document.getElementById('analytics_version').value, 10) || 1,
                        kategorien: kategorien
                    })
                });
                const result = await resp.json();
                if (result.success) {
                    status.textContent = '✓ ' + (result.message || 'Gespeichert');
                    status.className = 'ms-2 small text-success';
                } else {
                    status.textContent = '✗ ' + (result.message || 'Fehlgeschlagen');
                    status.className = 'ms-2 small text-danger';
                }
            } catch (err) {
                status.textContent = '✗ ' + err.message;
                status.className = 'ms-2 small text-danger';
            }
        });
    }

    // ====== SETTINGS: Channel-Loader ======
    const activeTab = '<%= activeTab %>';
    if (activeTab === 'settings') {
        loadChannelConfig();
    }
    // Auch bei Tab-Wechsel zu Settings laden (falls JS-Tab-Wechsel)
    document.querySelectorAll('[data-tab="settings"]').forEach(el => {
        el.addEventListener('click', () => setTimeout(loadChannelConfig, 100));
    });

    async function loadChannelConfig() {
        const controlGuildId = '<%= controlGuildId %>';
        const savedConfig = <%- JSON.stringify(channelConfig || {}) %>;

        if (!controlGuildId) {
            document.getElementById('channels-loading').style.display = 'none';
            document.getElementById('channels-error').style.display = 'block';
            document.getElementById('channels-error-msg').textContent = 'CONTROL_GUILD_ID nicht gesetzt.';
            return;
        }

        try {
            const resp = await fetch('/api/guild-channels/' + controlGuildId);
            const data = await resp.json();
            if (!data.success || !data.channels) throw new Error(data.error || 'Keine Channels');

            const textChannels = data.channels
                .filter(ch => ch.type === 0 || ch.type === 5)
                .sort((a, b) => a.name.localeCompare(b.name));

            document.querySelectorAll('.channel-select').forEach(select => {
                if (select.options.length > 1) return; // Bereits geladen
                const cat = select.dataset.category;
                textChannels.forEach(ch => {
                    const opt = document.createElement('option');
                    opt.value = ch.id;
                    opt.textContent = '#' + ch.name + (ch.type === 5 ? ' (Announcement)' : '');
                    if (savedConfig[cat]?.channel_id === ch.id) opt.selected = true;
                    select.appendChild(opt);
                });

                select.addEventListener('change', function() {
                    const opt = this.options[this.selectedIndex];
                    document.getElementById('channel_name_' + cat).value = opt.value ? opt.textContent.replace(/^#/, '') : '';
                });

                const currentOpt = select.options[select.selectedIndex];
                if (currentOpt && currentOpt.value) {
                    document.getElementById('channel_name_' + cat).value = currentOpt.textContent.replace(/^#/, '');
                }
            });

            document.getElementById('channels-loading').style.display = 'none';
            document.getElementById('channels-content').style.display = 'block';
            document.getElementById('btn-save-channels').disabled = false;
        } catch (err) {
            console.error('[Content] Channel-Load fehlgeschlagen:', err);
            document.getElementById('channels-loading').style.display = 'none';
            document.getElementById('channels-error').style.display = 'block';
            document.getElementById('channels-error-msg').textContent = 'Fehler: ' + err.message;
        }
    }

    // ====== SETTINGS: Channel-Config SAVE ======
    const channelForm = document.getElementById('channel-config-form');
    if (channelForm) {
        channelForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const btn = document.getElementById('btn-save-channels');
            const resultDiv = document.getElementById('channels-save-result');
            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Speichere...';
            resultDiv.style.display = 'none';

            // Formulardaten sammeln
            const formData = {};
            document.querySelectorAll('.channel-select').forEach(select => {
                const cat = select.dataset.category;
                formData['channel_' + cat] = select.value || '';
                formData['channel_name_' + cat] = document.getElementById('channel_name_' + cat)?.value || '';
            });

            console.log('[Content] Channel-Config speichern:', formData);

            try {
                const resp = await fetch('/admin/content/settings/channels/save', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || ''
                    },
                    body: JSON.stringify(formData)
                });

                console.log('[Content] Save Response Status:', resp.status);

                if (!resp.ok) {
                    const text = await resp.text();
                    console.error('[Content] Save Response Body:', text);
                    throw new Error('HTTP ' + resp.status + ': ' + text.substring(0, 200));
                }

                const result = await resp.json();
                console.log('[Content] Save Result:', result);

                if (result.success) {
                    resultDiv.className = 'alert alert-success';
                    resultDiv.innerHTML = '<i class="fas fa-check me-2"></i>' + (result.message || 'Gespeichert!');
                    resultDiv.style.display = 'block';
                    if (typeof toastr !== 'undefined') toastr.success(result.message || 'Gespeichert!');
                } else {
                    resultDiv.className = 'alert alert-danger';
                    resultDiv.innerHTML = '<i class="fas fa-times me-2"></i>' + (result.message || 'Fehler beim Speichern');
                    resultDiv.style.display = 'block';
                    if (typeof toastr !== 'undefined') toastr.error(result.message || 'Fehler');
                }
            } catch (err) {
                console.error('[Content] Channel-Save fehlgeschlagen:', err);
                resultDiv.className = 'alert alert-danger';
                resultDiv.innerHTML = '<i class="fas fa-exclamation-triangle me-2"></i>Fehler: ' + err.message;
                resultDiv.style.display = 'block';
                if (typeof toastr !== 'undefined') toastr.error('Speichern fehlgeschlagen: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        });
    }
});

// ====== DELETE HANDLER ======
function deleteContent(type, id) {
    if (!confirm('Wirklich löschen?')) return;

    fetch('/admin/content/' + type + '/delete/' + id, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            window.location.reload();
        } else {
            toastr.error(data.message || 'Fehler beim Löschen');
        }
    })
    .catch(err => toastr.error('Fehler: ' + err.message));
}

// ====== VERKNÜPFUNGS-LOGIK ======
let _linkType = '', _linkId = '', _linkTitle = '';

function linkContent(type, id, title) {
    _linkType = type;
    _linkId = id;
    _linkTitle = title;
    document.getElementById('link-source-name').textContent = title;
    fenster('linkModal')?.show();
}

document.querySelectorAll('#link-targets [data-action]').forEach(el => {
    el.addEventListener('click', function(e) {
        e.preventDefault();
        const action = this.dataset.action;

        let url = '';
        if (_linkType === 'news') url = '/news-details/' + _linkId;
        if (_linkType === 'changelog') url = '/changelogs/v' + _linkTitle.replace('v', '');

        if (action === 'copy-url') {
            const fullUrl = window.location.origin + url;
            navigator.clipboard.writeText(fullUrl).then(() => {
                toastr.success('URL kopiert: ' + fullUrl);
                fenster('linkModal')?.hide();
            });
        } else if (action === 'create-news') {
            fenster('linkModal')?.hide();
            window.location.href = '/admin/content/news/new?link_url=' + encodeURIComponent(url) + '&link_title=' + encodeURIComponent(_linkTitle);
        } else if (action === 'create-notification') {
            fenster('linkModal')?.hide();
            window.location.href = '/admin/content/notifications/new?link_url=' + encodeURIComponent(url) + '&link_title=' + encodeURIComponent(_linkTitle);
        }
    });
});
</script>
