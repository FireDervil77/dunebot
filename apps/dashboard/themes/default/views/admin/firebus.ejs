<%# FireBus: Was die Fahrkartenkontrolle nicht mitfahren ließ (Linie V, F9). Die Seite
    zeigt Name, Absender und Grund, Nutzlasten werden nie gespeichert. %>
<div class="container-fluid">
  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h3 class="card-title mb-0"><i class="fa-solid fa-ticket me-2"></i>FireBus: Kontrolle</h3>
      <span class="text-secondary small">Fahrplan Fassung <%= fassung %>, letzte 30 Tage</span>
    </div>
    <div class="card-body">
      <p class="text-secondary mb-3">Jede Nachricht vom Daemon wird an der Tür geprüft. Was durchfällt, fährt nicht mit und steht hier. Eine leere Liste ist der Normalfall.</p>
      <% if (!zeilen.length) { %>
        <div class="alert alert-success mb-0"><i class="fa-solid fa-check me-2"></i>Keine Meldungen.</div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-sm table-vcenter mb-0">
            <thead><tr><th>Zuletzt</th><th>Rootserver</th><th>Nachricht</th><th>Grund</th><th class="text-end">Anzahl</th></tr></thead>
            <tbody>
              <% zeilen.forEach(function (z) { %>
                <tr>
                  <td class="text-nowrap"><%= new Date(z.zuletzt).toLocaleString('de-DE') %></td>
                  <td><%= z.maschine %></td>
                  <td class="font-monospace"><%= z.name %></td>
                  <td><%= gruende[z.grund] || z.grund %></td>
                  <td class="text-end"><%= Number(z.anzahl).toLocaleString('de-DE') %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>
