<%#
  * SuperAdmin-Dashboard
  *
  * Der Inhalt steht nicht mehr hier, sondern kommt als Widgets über den Filter
  * `admin_dashboard_widgets` — genau wie beim Guild-Dashboard. Plugins können
  * sich damit danebenstellen, und die Bereiche gehören dem aktiven Theme.
  *
  * @author FireDervil
  * @context {Object}   stats            - Kennzahlen
  * @context {Array}    widgets          - eingesammelte Widgets
  * @context {Function} renderWidgetArea - Widgets eines Bereichs, sortiert
  * @context {Function} widgetAreasFor   - Bereiche eines Bildschirms
  %>

<%
function _bereich(areaId) {
    if (typeof renderWidgetArea === 'function') return renderWidgetArea(areaId);
    return (locals.widgets || [])
        .filter(w => w.area === areaId && w.visible !== false)
        .sort((a, b) => (a.position || 999) - (b.position || 999));
}

const _bereiche = (typeof widgetAreasFor === 'function' && widgetAreasFor('admin').length)
    ? widgetAreasFor('admin')
    : [
        { id: 'admin-top',     defaultSize: 12 },
        { id: 'admin-stats',   defaultSize: 3  },
        { id: 'admin-primary', defaultSize: 4  },
        { id: 'admin-bottom',  defaultSize: 12 }
      ];

const _bekannt = _bereiche.map(b => b.id);
%>

<div class="app-content">
    <div class="container-fluid">

        <% _bereiche.forEach(bereich => { %>
          <% const _widgets = _bereich(bereich.id); %>
          <% if (Array.isArray(_widgets) && _widgets.length > 0) { %>
            <div class="row g-3 mb-3" data-widget-area="<%= bereich.id %>">
              <% _widgets.forEach(widget => { %>
                <div class="col-md-<%= widget.size || bereich.defaultSize || 12 %>">
                  <%- _widgetCard(widget) %>
                </div>
              <% }); %>
            </div>
          <% } %>
        <% }); %>

        <%# Auffangnetz: Widgets, deren Bereich es nicht (mehr) gibt %>
        <% const _heimatlos = (locals.widgets || []).filter(w =>
              !_bekannt.includes(w.area) && w.visible !== false
           ); %>
        <% if (_heimatlos.length > 0) { %>
          <div class="row g-3 mb-3" data-widget-area="unbekannt">
            <% _heimatlos.forEach(widget => { %>
              <div class="col-md-<%= widget.size || 12 %>" data-widget-id="<%= widget.id %>" data-widget-hidden="0"><%- _widgetCard(widget) %></div>
            <% }); %>
          </div>
        <% } %>

    </div>
</div>

<%
function _widgetCard(widget) {
    // Der Hinweis oben trägt keine Kartenhülle — er ist eine Leiste.
    if (widget.id === 'admin-hinweis') {
        return `<div class="alert alert-info mb-0">${widget.content || ''}</div>`;
    }

    return `<div class="card h-100 ${widget.cardClass || ''}" data-widget-id="${widget.id}">
      <div class="card-header">
        <h3 class="card-title">
          ${widget.icon ? `<i class="${widget.icon} me-2"></i>` : ''}
          ${widget.title || 'Widget'}
        </h3>
      </div>
      <div class="card-body">
        ${widget.content || ''}
      </div>
    </div>`;
}
%>
