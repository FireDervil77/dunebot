<%# Admin: Spiele-Marktplatz - Hauptseite %>

    <div class="content">
        <div class="container-fluid">

            <%#
              Kopfzeile ohne Aktionen. Anlegen, Egg-Import und JSON-Einfügen sind
              seit dem 2026-09-26 weg (Egg-Rückbau B): Sie schrieben FIREBOT_v2,
              und seit dem 2026-09-10 startet der Daemon nur Server mit Paket.
              Neue Spiele entstehen in der Werkbank; ihre Einlieferung legt den
              Anker hier selbst an.
            %>
            <div class="row align-items-center mb-3">
                <div class="col">
                    <h2 class="page-title mb-0">
                        <i class="fa-solid fa-puzzle-piece me-2"></i>
                        Spiele-Marktplatz
                    </h2>
                </div>
            </div>

            <%# Stats-Cards %>
            <div class="row">
                <div class="col-lg-3 col-6">
                    <div class="card card-sm">
                      <div class="card-body">
                        <div class="row align-items-center">
                          <div class="col-auto">
                            <span class="bg-info text-white avatar"><i class="fa-solid fa-puzzle-piece"></i></span>
                          </div>
                          <div class="col">
                            <div class="h2 fw-medium mb-0"><%= stats.total %></div>
                            <div class="text-secondary">Total Addons</div>
                          </div>
                        </div>
                      </div>
                    </div>
                </div>
                
                <div class="col-lg-3 col-6">
                    <div class="card card-sm">
                      <div class="card-body">
                        <div class="row align-items-center">
                          <div class="col-auto">
                            <span class="bg-success text-white avatar"><i class="fa-solid fa-crown"></i></span>
                          </div>
                          <div class="col">
                            <div class="h2 fw-medium mb-0"><%= stats.official %></div>
                            <div class="text-secondary">Official</div>
                          </div>
                        </div>
                      </div>
                    </div>
                </div>
                
                <div class="col-lg-3 col-6">
                    <div class="card card-sm">
                      <div class="card-body">
                        <div class="row align-items-center">
                          <div class="col-auto">
                            <span class="bg-warning text-white avatar"><i class="fa-solid fa-clock"></i></span>
                          </div>
                          <div class="col">
                            <div class="h2 fw-medium mb-0"><%= stats.pending_review %></div>
                            <div class="text-secondary">Pending Review</div>
                          </div>
                        </div>
                      </div>
                    </div>
                </div>
            </div>

            <%# Addon-Tabelle %>
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fa-solid fa-list"></i>
                        Alle Addons
                    </h3>
                    <div class="card-actions">
                        <div class="input-group input-group-sm" style="width: 300px;">
                            <input type="text" id="addonSearch" class="form-control float-end" placeholder="Suchen...">
                            <button type="button" class="btn btn-default">
                            <i class="fa-solid fa-search"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body table-responsive p-0">
                    <table class="table table-hover text-nowrap" id="addonsTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Status</th>
                                <th>Trust Level</th>
                                <th>Visibility</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (addons && addons.length > 0) { %>
                                <% addons.forEach(addon => { %>
                                    <tr>
                                        <td><%= addon.id %></td>
                                        <td>
                                            <strong><%= addon.name %></strong><br>
                                            <small class="text-secondary"><%= addon.slug %></small>
                                        </td>
                                        <td>
                                            <% if (addon.status === 'approved') { %>
                                                <span class="badge bg-success-lt">
                                                    <i class="fa-solid fa-check"></i> Approved
                                                </span>
                                            <% } else if (addon.status === 'pending_review') { %>
                                                <span class="badge bg-warning-lt">
                                                    <i class="fa-solid fa-clock"></i> Pending
                                                </span>
                                            <% } else if (addon.status === 'rejected') { %>
                                                <span class="badge bg-danger-lt">
                                                    <i class="fa-solid fa-times"></i> Rejected
                                                </span>
                                            <% } else if (addon.status === 'draft') { %>
                                                <span class="badge bg-secondary-lt">
                                                    <i class="fa-solid fa-file"></i> Draft
                                                </span>
                                            <% } else { %>
                                                <span class="badge bg-secondary-lt">
                                                    <i class="fa-solid fa-question"></i> <%= addon.status || 'Unknown' %>
                                                </span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (addon.trust_level === 'official') { %>
                                                <span class="badge bg-success-lt">
                                                    <i class="fa-solid fa-crown"></i> Official
                                                </span>
                                            <% } else if (addon.trust_level === 'trusted') { %>
                                                <span class="badge bg-primary-lt">
                                                    <i class="fa-solid fa-shield-check"></i> Trusted
                                                </span>
                                            <% } else if (addon.trust_level === 'verified') { %>
                                                <span class="badge bg-info-lt">
                                                    <i class="fa-solid fa-check-circle"></i> Verified
                                                </span>
                                            <% } else { %>
                                                <span class="badge bg-secondary-lt">
                                                    <i class="fa-solid fa-question-circle"></i> Unverified
                                                </span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (addon.visibility === 'official') { %>
                                                <span class="badge bg-danger-lt">
                                                    <i class="fa-solid fa-crown"></i> Official
                                                </span>
                                            <% } else if (addon.visibility === 'public') { %>
                                                <span class="badge bg-success-lt">
                                                    <i class="fa-solid fa-eye"></i> Public
                                                </span>
                                            <% } else if (addon.visibility === 'unlisted') { %>
                                                <span class="badge bg-info-lt">
                                                    <i class="fa-solid fa-link"></i> Unlisted
                                                </span>
                                            <% } else if (addon.visibility === 'private') { %>
                                                <span class="badge bg-secondary-lt">
                                                    <i class="fa-solid fa-eye-slash"></i> Private
                                                </span>
                                            <% } else { %>
                                                <span class="badge bg-warning-lt">
                                                    <i class="fa-solid fa-question"></i> <%= addon.visibility || 'Unknown' %>
                                                </span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <a href="/admin/addons/<%= addon.id %>" 
                                                   class="btn btn-info" title="Edit">
                                                    <i class="fa-solid fa-edit"></i>
                                                </a>
                                                <button class="btn btn-danger btn-delete-addon" 
                                                        data-addon-id="<%= addon.id %>" 
                                                        data-addon-name="<%= addon.name %>" 
                                                        title="Delete">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center text-secondary">
                                        <i class="fa-solid fa-inbox"></i><br>
                                        Keine Spiele vorhanden — neue entstehen in der Werkbank.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    
    
    // Search-Funktionalität
    document.getElementById('addonSearch').addEventListener('keyup', function() {
        const searchTerm = this.value.toLowerCase();
        const rows = document.querySelectorAll('#addonsTable tbody tr');
        
        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            row.style.display = text.includes(searchTerm) ? '' : 'none';
        });
    });
    
    // Delete-Addon
    document.querySelectorAll('.btn-delete-addon').forEach(btn => {
        btn.addEventListener('click', async function() {
            const addonId = this.dataset.addonId;
            const addonName = this.dataset.addonName || 'dieses Addon';
            
            // ✅ Erste Bestätigung bleibt
            if (!confirm(`Addon "${addonName}" wirklich löschen? Diese Aktion kann nicht rückgängig gemacht werden!`)) return;
            
            try {
                const response = await fetch(`/admin/addons/${addonId}`, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' }
                });
                
                const result = await response.json();
                
                // ✅ Zweite Bestätigung durch Toast ersetzt
                if (result.success) {
                    toastr.success(result.message || 'Addon erfolgreich gelöscht');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    toastr.error(result.message || 'Fehler beim Löschen');
                }
            } catch (error) {
                console.error('Error:', error);
                toastr.error('Netzwerkfehler beim Löschen des Addons');
            }
        });
    });

});
</script>
