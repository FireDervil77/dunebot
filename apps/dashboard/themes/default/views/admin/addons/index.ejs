<%# Admin: Spiele-Marktplatz - Hauptseite %>

    <div class="content">
        <div class="container-fluid">

            <%#
              Kopfzeile ohne Aktionen. Anlegen, Egg-Import und JSON-Einfügen sind
              seit dem 2026-09-26 weg (Egg-Rückbau B): Sie schrieben FIREBOT_v2,
              und seit dem 2026-09-10 startet der Daemon nur Server mit Paket.
              Neue Spiele entstehen in der Werkbank; ihre Einlieferung legt den
              Anker hier selbst an.
            %>
            <div class="row align-items-center mb-3">
                <div class="col">
                    <h2 class="page-title mb-0">
                        <i class="fa-solid fa-puzzle-piece me-2"></i>
                        Spiele-Marktplatz
                    </h2>
                </div>
            </div>

            <%# Stats-Cards. „Freigegeben" und „Entwürfe" kommen aus den Fassungen der
                Spielpakete (Paketfassung.freigabeJePaket). Bis zum 2026-10-08 standen
                hier „Official" und „Pending Review" und in der Tabelle Status, Trust
                Level und Visibility — Spalten am Anker, die bei jedem Spiel gleich
                standen und mit dem Anlegen nichts zu tun hatten. %>
            <% if (locals.freigabeFehler) { %>
                <div class="alert alert-danger">Der Freigabestand ließ sich nicht laden: <%= locals.freigabeFehler %></div>
            <% } %>
            <div class="row">
                <div class="col-lg-3 col-6">
                    <div class="card card-sm">
                      <div class="card-body">
                        <div class="row align-items-center">
                          <div class="col-auto">
                            <span class="bg-info text-white avatar"><i class="fa-solid fa-puzzle-piece"></i></span>
                          </div>
                          <div class="col">
                            <div class="h2 fw-medium mb-0"><%= stats.total %></div>
                            <div class="text-secondary">Total Addons</div>
                          </div>
                        </div>
                      </div>
                    </div>
                </div>
                
                <div class="col-lg-3 col-6">
                    <div class="card card-sm">
                      <div class="card-body">
                        <div class="row align-items-center">
                          <div class="col-auto">
                            <span class="bg-success text-white avatar"><i class="fa-solid fa-check"></i></span>
                          </div>
                          <div class="col">
                            <div class="h2 fw-medium mb-0"><%= stats.freigegeben === null ? '—' : stats.freigegeben %></div>
                            <div class="text-secondary">Freigegeben</div>
                          </div>
                        </div>
                      </div>
                    </div>
                </div>
                
                <div class="col-lg-3 col-6">
                    <div class="card card-sm">
                      <div class="card-body">
                        <div class="row align-items-center">
                          <div class="col-auto">
                            <span class="bg-secondary text-white avatar"><i class="fa-solid fa-file"></i></span>
                          </div>
                          <div class="col">
                            <div class="h2 fw-medium mb-0"><%= stats.entwuerfe === null ? '—' : stats.entwuerfe %></div>
                            <div class="text-secondary">Entwürfe</div>
                          </div>
                        </div>
                      </div>
                    </div>
                </div>
            </div>

            <%# Addon-Tabelle %>
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fa-solid fa-list"></i>
                        Alle Addons
                    </h3>
                    <div class="card-actions">
                        <div class="input-group input-group-sm" style="width: 300px;">
                            <input type="text" id="addonSearch" class="form-control float-end" placeholder="Suchen...">
                            <button type="button" class="btn btn-default">
                            <i class="fa-solid fa-search"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <%#
                  Umzug auf den neuesten Bau (2026-10-10). Erscheint erst, wenn
                  ein Paket zurückliegt oder ein Umzug läuft bzw. auf seine
                  Freigabe wartet — sonst gibt es hier nichts zu tun.
                %>
                <div class="card-body border-bottom py-2 d-none" id="umzugLeiste">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="fw-medium"><i class="fa-solid fa-truck-ramp-box me-1"></i>Umzug auf den neuesten Bau</span>
                        <span class="text-secondary small" id="umzugLage"></span>
                        <span class="ms-auto d-flex flex-wrap align-items-center gap-2">
                            <select class="form-select form-select-sm w-auto d-none" id="umzugMaschine" aria-label="Maschine für die Prüfdurchläufe"></select>
                            <button type="button" class="btn btn-sm btn-primary d-none" id="umzugAlle">
                                <i class="fa-solid fa-play me-1"></i>Alle umziehen <span id="umzugAlleZahl"></span>
                            </button>
                            <button type="button" class="btn btn-sm btn-success d-none" id="umzugFreigeben">
                                <i class="fa-solid fa-check me-1"></i>Umgezogene freigeben <span id="umzugFreigebenZahl"></span>
                            </button>
                        </span>
                    </div>
                    <div class="form-hint mt-1">Je Paket ein Prüfdurchlauf auf leerem Volume, einer nach dem anderen. Bei Grün entsteht eine neue Fassung in „test", die sich nur im Image unterscheidet — freigegeben wird sie erst mit deinem Klick.</div>
                </div>
                <div class="card-body table-responsive p-0">
                    <table class="table table-hover text-nowrap" id="addonsTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Freigabe</th>
                                <th>Fassungen</th>
                                <th>Image <span class="text-secondary small fw-normal" id="imageStandKopf"></span></th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (addons && addons.length > 0) { %>
                                <% addons.forEach(addon => { %>
                                    <tr>
                                        <td><%= addon.id %></td>
                                        <td>
                                            <strong><%= addon.name %></strong><br>
                                            <small class="text-secondary"><%= addon.slug %></small>
                                        </td>
                                        <% const fr = addon.freigabe; %>
                                        <td>
                                            <% if (!fr) { %>
                                                <span class="text-secondary">—</span>
                                            <% } else if (fr.freigegeben) { %>
                                                <span class="badge bg-success-lt">
                                                    <i class="fa-solid fa-check"></i> freigegeben · <%= fr.freigegeben %>
                                                </span>
                                            <% } else if (fr.fassungen) { %>
                                                <span class="badge bg-secondary-lt" title="Keine Fassung freigegeben — nur in deiner Guild anlegbar.">
                                                    <i class="fa-solid fa-file"></i> Entwurf
                                                </span>
                                            <% } else { %>
                                                <span class="badge bg-warning-lt" title="Zu diesem Spiel gibt es kein Spielpaket — es entsteht in der Werkbank.">
                                                    <i class="fa-solid fa-triangle-exclamation"></i> kein Paket
                                                </span>
                                            <% } %>
                                        </td>
                                        <td><%= fr ? fr.fassungen : '—' %></td>
                                        <%# Füllt sich nach dem Laden (GET /admin/addons/imagestand) — die Abfrage
                                            geht an einen Daemon und soll die Liste nicht aufhalten. %>
                                        <td>
                                            <div data-image-stand="<%= addon.id %>"><span class="text-secondary small">…</span></div>
                                            <div data-umzug="<%= addon.id %>" data-umzug-name="<%= addon.name %>" class="mt-1"></div>
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <a href="/admin/addons/<%= addon.id %>" 
                                                   class="btn btn-info" title="Edit">
                                                    <i class="fa-solid fa-edit"></i>
                                                </a>
                                                <button class="btn btn-danger btn-delete-addon" 
                                                        data-addon-id="<%= addon.id %>" 
                                                        data-addon-name="<%= addon.name %>" 
                                                        title="Delete">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center text-secondary">
                                        <i class="fa-solid fa-inbox"></i><br>
                                        Keine Spiele vorhanden — neue entstehen in der Werkbank.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>

<%#
  Rückfrage vor dem Entfernen eines Spielpakets (Baustelle 178).

  Erst stand hier die Eingabezeile des Browsers (prompt). Betreiber, 2026-10-09,
  nach dem ersten echten Entfernen: „die Bestätigung könnte etwas roter und fett
  sein. ist ja wichtig!!!" — eine Eingabezeile des Browsers lässt sich nicht
  färben, und sie sieht aus wie jede andere Frage.

  Der Knopf bleibt gesperrt, bis der Name des Pakets genau dasteht.
%>
<%# Rückfrage vor der Sammelfreigabe: Sie nennt, WAS freigegeben wird. %>
<div class="modal modal-blur fade" id="umzugFreigebenModal" tabindex="-1" aria-labelledby="umzugFreigebenTitel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="umzugFreigebenTitel"><i class="fa-solid fa-check me-2"></i>Umgezogene Fassungen freigeben</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">Diese Fassungen gehen von „test" nach „stable":</p>
                <ul class="mb-3" id="umzugFreigebenListe"></ul>
                <p class="mb-0 text-secondary">Alle Server auf „stable" starten ab dem nächsten Start mit ihnen. Eine Freigabe lässt sich auf der Seite des Spiels zurücknehmen.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link link-secondary me-auto" data-bs-dismiss="modal">Abbrechen</button>
                <button type="button" class="btn btn-success" id="umzugFreigebenKnopf"><i class="fa-solid fa-check me-1"></i>Freigeben</button>
            </div>
        </div>
    </div>
</div>

<div class="modal modal-blur fade" id="paketEntfernenModal" tabindex="-1" aria-labelledby="paketEntfernenTitel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border border-danger border-2">
            <div class="modal-status bg-danger"></div>
            <div class="modal-header bg-danger-lt">
                <h5 class="modal-title text-danger fw-bold" id="paketEntfernenTitel">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>Spielpaket ENDGÜLTIG entfernen
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
            </div>
            <div class="modal-body">
                <p class="text-danger fw-bold fs-3 mb-2">
                    „<span id="paketEntfernenName"></span>" wird ganz entfernt.
                </p>
                <p class="text-danger fw-bold mb-3">Das lässt sich nicht zurücknehmen.</p>
                <div class="fw-bold mb-1">Es gehen mit:</div>
                <ul class="mb-3" id="paketEntfernenListe"></ul>
                <label class="form-label fw-bold" for="paketEntfernenEingabe">
                    Zum Bestätigen den Namen eintippen: <span class="font-monospace text-danger" id="paketEntfernenSoll"></span>
                </label>
                <input type="text" class="form-control font-monospace" id="paketEntfernenEingabe" autocomplete="off" spellcheck="false">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link link-secondary me-auto" data-bs-dismiss="modal">Abbrechen</button>
                <button type="button" class="btn btn-danger fw-bold" id="paketEntfernenKnopf" disabled>
                    <i class="fa-solid fa-trash me-1"></i>Endgültig entfernen
                </button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {

    // ── Image-Stand (Baustelle 177, 2026-10-09) ─────────────────────────────
    // Je Paket: Hängt die neueste Fassung am neuesten Bau ihres Images? Drei
    // Auskünfte, und „unbekannt" ist eine eigene — nie „aktuell", ohne gefragt
    // zu haben. Namen kommen aus Paketen: als Text gesetzt, nie als HTML.
    let imageDaten = null;
    async function ladeImageStand() {
        const zellen = document.querySelectorAll('[data-image-stand]');
        if (!zellen.length) return;
        const kopf = document.getElementById('imageStandKopf');
        const setze = (zelle, klasse, text, titel) => {
            zelle.textContent = '';
            const marke = document.createElement('span');
            marke.className = 'badge ' + klasse;
            marke.textContent = text;
            if (titel) marke.title = titel;
            zelle.appendChild(marke);
            return marke;
        };
        const kurz = (d) => String(d || '').replace(/^sha256:/, '').slice(0, 12);
        let daten;
        try {
            const antwort = await fetch('/admin/addons/imagestand', { headers: { Accept: 'application/json' } });
            daten = await antwort.json();
            if (!antwort.ok || !daten.success) throw new Error(daten.message || ('HTTP ' + antwort.status));
        } catch (fehler) {
            zellen.forEach((z) => setze(z, 'bg-secondary-lt', 'unbekannt', fehler.message));
            if (kopf) kopf.textContent = '· nicht abfragbar';
            if (window.showToast) window.showToast('error', 'Image-Stand: ' + fehler.message);
            return;
        }
        const jePaket = new Map((daten.pakete || []).map((p) => [String(p.paket_id), p]));
        zellen.forEach((zelle) => {
            const p = jePaket.get(zelle.dataset.imageStand);
            if (!p) { zelle.textContent = '—'; return; }   // Spiel ohne Paket
            const worauf = (p.image || '?') + (p.tag ? ' · ' + p.tag : '');
            if (p.stand === 'aktuell') {
                setze(zelle, 'bg-success-lt', 'aktuell', worauf + ' — angeheftet ' + kurz(p.digest) + ', das ist der neueste Bau');
            } else if (p.stand === 'neuer_bau') {
                setze(zelle, 'bg-warning-lt', 'neuer Bau' + (p.neuester && p.neuester.fassung ? ' ' + p.neuester.fassung : ''),
                    worauf + ' — angeheftet ' + kurz(p.digest) + ', neuester Bau ' + kurz(p.neuester && p.neuester.digest)
                    + '. Umziehen: der Knopf darunter — Prüfdurchlauf, bei Grün neue Fassung in test.');
            } else {
                setze(zelle, 'bg-secondary-lt', 'unbekannt', p.grund || '');
            }
            const unter = document.createElement('div');
            unter.className = 'text-secondary small';
            unter.textContent = worauf;
            zelle.appendChild(unter);
        });
        const z = daten.zaehlung || {};
        if (kopf) {
            kopf.textContent = '· ' + (z.neuer_bau || 0) + ' hinter dem neuesten Bau'
                + (z.unbekannt ? ', ' + z.unbekannt + ' unbekannt' : '')
                + (daten.gefragtBei ? ' (gefragt bei ' + daten.gefragtBei + ')' : '');
        }
        if (daten.fehler && window.showToast) window.showToast('warning', 'Image-Stand: ' + daten.fehler);
        imageDaten = daten;
    }

    // ── Umzug auf den neuesten Bau (2026-10-10) ─────────────────────────────
    // Ein Knopf je Paket, einer für alle. Der Server entscheidet, was wirklich
    // zurückliegt; hier wird nur angestoßen und der Stand gezeichnet. Solange
    // etwas wartet oder läuft, wird alle fünf Sekunden nachgefragt.
    const melde = (art, text) => { if (window.showToast) window.showToast(art, text); };
    const leiste = document.getElementById('umzugLeiste');
    const lage = document.getElementById('umzugLage');
    const maschinenWahl = document.getElementById('umzugMaschine');
    const knopfAlle = document.getElementById('umzugAlle');
    const knopfFreigeben = document.getElementById('umzugFreigeben');
    let umzugDaten = null, umzugTakt = null, warBeschaeftigt = false;

    const el = (tag, klasse, text) => {
        const e = document.createElement(tag);
        if (klasse) e.className = klasse;
        if (text !== undefined) e.textContent = text;
        return e;
    };
    const dauer = (seit) => {
        const s = Math.max(0, Math.round((Date.now() - new Date(seit).getTime()) / 1000));
        return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0') + ' min';
    };

    async function sende(weg, nutzlast) {
        const antwort = await fetch(weg, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(nutzlast || {}) });
        const daten = await antwort.json().catch(() => ({}));
        if (!antwort.ok || !daten.success) throw new Error(daten.message || ('HTTP ' + antwort.status));
        return daten;
    }

    async function umziehen(pakete, knopf) {
        if (knopf) knopf.disabled = true;
        try {
            const daten = await sende('/admin/addons/umzug', { pakete, rootserver_id: maschinenWahl.value || undefined });
            melde(daten.abgelehnt && daten.abgelehnt.length ? 'warning' : 'success', daten.message);
        } catch (fehler) {
            melde('error', 'Umzug nicht angestoßen: ' + fehler.message);
        }
        if (knopf) knopf.disabled = false;
        await ladeUmzug();
    }

    function zeichneUmzug() {
        const zurueck = new Map(((imageDaten && imageDaten.pakete) || []).filter((p) => p.stand === 'neuer_bau').map((p) => [String(p.paket_id), p]));
        const jePaket = new Map(((umzugDaten && umzugDaten.umzuege) || []).map((u) => [String(u.paket_id), u]));
        let umziehbar = 0;
        document.querySelectorAll('[data-umzug]').forEach((zelle) => {
            const id = zelle.dataset.umzug;
            const u = jePaket.get(id);
            const liegtZurueck = zurueck.has(id);
            zelle.textContent = '';
            const beschaeftigt = u && (u.stand === 'wartet' || u.stand === 'laeuft');
            if (u && u.stand === 'wartet') {
                zelle.appendChild(el('span', 'badge bg-secondary-lt', 'Umzug wartet · ' + u.von + ' → ' + u.nach));
            } else if (u && u.stand === 'laeuft') {
                const m = el('span', 'badge bg-primary-lt', 'Prüfdurchlauf läuft · ' + (u.begonnen ? dauer(u.begonnen) : ''));
                m.title = u.von + ' → ' + u.nach;
                zelle.appendChild(m);
            } else if (u && u.stand === 'gruen' && !liegtZurueck) {
                // Nur solange das Paket NICHT wieder zurückliegt: Nach dem
                // nächsten Bau ist der grüne Umzug von gestern keine Auskunft mehr.
                zelle.appendChild(el('span', 'badge ' + (u.kanal === 'stable' ? 'bg-success-lt' : 'bg-warning-lt'),
                    'umgezogen · ' + u.nach + (u.kanal === 'stable' ? ' freigegeben' : ' in test')));
                if (u.kanal === 'test' && !u.freigebbar) {
                    const h = el('div', 'text-secondary small', 'Freigabe auf der Seite des Spiels');
                    h.title = 'Die Fassung, aus der umgezogen wurde, war selbst nicht freigegeben — der Sammelknopf gibt sie deshalb nicht frei.';
                    zelle.appendChild(h);
                }
            } else if (u && u.stand === 'rot') {
                const m = el('span', 'badge bg-danger-lt', 'Umzug rot');
                m.title = u.grund || '';
                zelle.appendChild(m);
                const grund = el('div', 'text-danger small text-wrap', u.grund || 'ohne Grund');
                grund.style.maxWidth = '28rem';
                zelle.appendChild(grund);
                if (u.sitzung_offen && umzugDaten.werkbank) {
                    const weg = el('a', 'small', 'Sitzung in der Werkbank ansehen');
                    weg.href = umzugDaten.werkbank + '/' + encodeURIComponent(u.kennung);
                    zelle.appendChild(weg);
                }
            }
            if (beschaeftigt) {
                const ab = el('button', 'btn btn-sm btn-ghost-secondary ms-1 py-0', 'abbrechen');
                ab.type = 'button';
                ab.addEventListener('click', async () => {
                    ab.disabled = true;
                    try { melde('success', (await sende('/admin/addons/umzug/' + encodeURIComponent(u.kennung) + '/abbrechen')).message); }
                    catch (fehler) { melde('error', 'Nicht abgebrochen: ' + fehler.message); }
                    await ladeUmzug();
                });
                zelle.appendChild(ab);
            } else if (liegtZurueck) {
                umziehbar++;
                const k = el('button', 'btn btn-sm btn-outline-primary py-0' + (zelle.childNodes.length ? ' d-block mt-1' : ''), u && u.stand === 'rot' ? 'Noch einmal umziehen' : 'Umziehen');
                k.type = 'button';
                k.title = 'Prüfdurchlauf auf dem neuesten Bau, bei Grün neue Fassung in test';
                k.addEventListener('click', () => umziehen([Number(id)], k));
                zelle.appendChild(k);
            }
        });

        const z = (umzugDaten && umzugDaten.zaehlung) || {};
        const beschaeftigt = (z.wartet || 0) + (z.laeuft || 0);
        leiste.classList.toggle('d-none', !(umziehbar || beschaeftigt || z.freigebbar || z.rot));
        lage.textContent = [
            umziehbar ? umziehbar + ' zurück' : '',
            z.laeuft ? z.laeuft + ' läuft' : '', z.wartet ? z.wartet + ' wartet' : '',
            z.freigebbar ? z.freigebbar + ' warten auf die Freigabe' : '',
        ].filter(Boolean).join(' · ');
        knopfAlle.classList.toggle('d-none', umziehbar < 1);
        document.getElementById('umzugAlleZahl').textContent = '(' + umziehbar + ')';
        knopfFreigeben.classList.toggle('d-none', !z.freigebbar);
        document.getElementById('umzugFreigebenZahl').textContent = '(' + (z.freigebbar || 0) + ')';

        // Maschinen: nur zur Wahl, wenn es mehr als eine erreichbare gibt.
        const maschinen = ((umzugDaten && umzugDaten.maschinen) || []).filter((m) => m.online);
        if (maschinenWahl.options.length !== maschinen.length) {
            const vorher = maschinenWahl.value;
            maschinenWahl.textContent = '';
            maschinen.forEach((m) => { const o = el('option', '', m.name); o.value = m.id; maschinenWahl.appendChild(o); });
            if (vorher) maschinenWahl.value = vorher;
        }
        maschinenWahl.classList.toggle('d-none', maschinen.length < 2 || umziehbar < 1);

        // Fertig geworden: Der Image-Stand hat sich geändert — neu fragen.
        if (warBeschaeftigt && !beschaeftigt) ladeImageStand().then(zeichneUmzug);
        warBeschaeftigt = beschaeftigt > 0;
        clearTimeout(umzugTakt);
        if (beschaeftigt) umzugTakt = setTimeout(ladeUmzug, 5000);
    }

    async function ladeUmzug() {
        try {
            const antwort = await fetch('/admin/addons/umzug', { headers: { Accept: 'application/json' } });
            const daten = await antwort.json();
            if (!antwort.ok || !daten.success) throw new Error(daten.message || ('HTTP ' + antwort.status));
            umzugDaten = daten;
        } catch (fehler) {
            melde('error', 'Umzüge: ' + fehler.message);
            // Weiterfragen, wenn gerade etwas lief — eine Störung ist kein Ende.
            clearTimeout(umzugTakt);
            if (warBeschaeftigt) umzugTakt = setTimeout(ladeUmzug, 5000);
            return;
        }
        zeichneUmzug();
    }

    knopfAlle.addEventListener('click', () => umziehen('alle', knopfAlle));
    knopfFreigeben.addEventListener('click', () => {
        const liste = document.getElementById('umzugFreigebenListe');
        liste.textContent = '';
        ((umzugDaten && umzugDaten.umzuege) || []).filter((u) => u.freigebbar).forEach((u) => {
            const name = document.querySelector('[data-umzug="' + u.paket_id + '"]');
            liste.appendChild(el('li', '', ((name && name.dataset.umzugName) || u.slug) + ' — ' + u.von + ' → ' + u.nach));
        });
        bootstrap.Modal.getOrCreateInstance(document.getElementById('umzugFreigebenModal')).show();
    });
    document.getElementById('umzugFreigebenKnopf').addEventListener('click', async (ereignis) => {
        const knopf = ereignis.currentTarget;
        knopf.disabled = true;
        try {
            const daten = await sende('/admin/addons/umzug/freigeben');
            bootstrap.Modal.getOrCreateInstance(document.getElementById('umzugFreigebenModal')).hide();
            melde(daten.nicht && daten.nicht.length ? 'warning' : 'success', daten.message);
            setTimeout(() => location.reload(), 1500);   // die Spalte „Freigabe" zeichnet der Server
        } catch (fehler) {
            melde('error', 'Nicht freigegeben: ' + fehler.message);
        }
        knopf.disabled = false;
    });

    ladeImageStand().then(ladeUmzug, ladeUmzug);
    
    
    // Search-Funktionalität
    document.getElementById('addonSearch').addEventListener('keyup', function() {
        const searchTerm = this.value.toLowerCase();
        const rows = document.querySelectorAll('#addonsTable tbody tr');
        
        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            row.style.display = text.includes(searchTerm) ? '' : 'none';
        });
    });
    
    // Delete-Addon
    document.querySelectorAll('.btn-delete-addon').forEach(btn => {
        btn.addEventListener('click', async function() {
            const addonId = this.dataset.addonId;
            const addonName = this.dataset.addonName || 'dieses Addon';

            // ── Trägt das Spiel ein Paket? Dann ist es mehr als eine Zeile ──────
            // (Baustelle 178, 2026-10-09.) Der einfache Weg unten weist den Anker
            // eines Spielpakets ab. Hier wird erst GEZEIGT, was mitgeht —
            // Fassungen, Tags, Werkbank-Sitzungen — und dann der Name verlangt.
            const melde = (art, text) => (window.showToast ? window.showToast(art, text) : toastr[art === 'error' ? 'error' : 'success'](text));
            let vorschau;
            try {
                const antwort = await fetch(`/admin/addons/${addonId}/entfernen`, { headers: { Accept: 'application/json' } });
                vorschau = await antwort.json();
                if (!antwort.ok || !vorschau.success) throw new Error(vorschau.message || ('HTTP ' + antwort.status));
            } catch (fehler) {
                melde('error', 'Was an diesem Spiel hängt, ließ sich nicht ermitteln: ' + fehler.message);
                return;
            }
            if (vorschau.paket) {
                const slug = vorschau.paket.slug;
                if (vorschau.server > 0) {
                    melde('error', vorschau.server + ' Server ' + (vorschau.server === 1 ? 'läuft' : 'laufen') + ' mit „' + slug + '" — erst die Server löschen.');
                    return;
                }
                // Namen und Texte kommen aus Paketen und Sitzungen: als Text
                // gesetzt, nie als HTML.
                const punkte = [
                    vorschau.fassungen.length + ' Fassung(en): ' + vorschau.fassungen.map((f) => f.version + (f.channel === 'stable' ? ' (freigegeben)' : '')).join(', '),
                    vorschau.tags.length + ' Tag-Zuordnung(en) — die Tags selbst bleiben',
                    'der Eintrag im Spiele-Marktplatz',
                ];
                if (vorschau.sitzungen.length) {
                    vorschau.sitzungen.forEach((z) => punkte.push('Werkbank-Sitzung „' + z.name + '" (' + z.kennung + ', ' + z.status + ') samt Volume, Schritten und Durchläufen — ' + z.gruende.join(', ')));
                } else {
                    punkte.push('keine Werkbank-Sitzung');
                }
                const dialog = document.getElementById('paketEntfernenModal');
                const liste = document.getElementById('paketEntfernenListe');
                const eingabe = document.getElementById('paketEntfernenEingabe');
                const knopf = document.getElementById('paketEntfernenKnopf');
                document.getElementById('paketEntfernenName').textContent = slug;
                document.getElementById('paketEntfernenSoll').textContent = slug;
                liste.textContent = '';
                punkte.forEach((text) => { const li = document.createElement('li'); li.textContent = text; liste.appendChild(li); });
                eingabe.value = '';
                knopf.disabled = true;
                // Gesperrt, bis der Name GENAU dasteht — ein Klick aus Versehen entfernt nichts.
                eingabe.oninput = () => { knopf.disabled = eingabe.value.trim() !== slug; };
                const fenster = bootstrap.Modal.getOrCreateInstance(dialog);
                knopf.onclick = async () => {
                    if (eingabe.value.trim() !== slug) return;
                    knopf.disabled = true;
                    try {
                        const antwort = await fetch(`/admin/addons/${addonId}/entfernen`, {
                            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ slug }),
                        });
                        const ergebnis = await antwort.json();
                        if (!antwort.ok || !ergebnis.success) throw new Error(ergebnis.message || ('HTTP ' + antwort.status));
                        fenster.hide();
                        melde('success', ergebnis.message);
                        setTimeout(() => location.reload(), 1500);
                    } catch (fehler) {
                        // Der Dialog bleibt offen: Die Meldung sagt, was noch steht
                        // und was schon weg ist — das gehört neben die Liste.
                        knopf.disabled = false;
                        melde('error', fehler.message);
                    }
                };
                fenster.show();
                dialog.addEventListener('shown.bs.modal', () => eingabe.focus(), { once: true });
                return;
            }

            // Ein Spiel OHNE Paket: nur der Eintrag im Marktplatz.
            if (!confirm(`Addon "${addonName}" wirklich löschen? Diese Aktion kann nicht rückgängig gemacht werden!`)) return;
            
            try {
                const response = await fetch(`/admin/addons/${addonId}`, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' }
                });
                
                const result = await response.json();
                
                // ✅ Zweite Bestätigung durch Toast ersetzt
                if (result.success) {
                    toastr.success(result.message || 'Addon erfolgreich gelöscht');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    toastr.error(result.message || 'Fehler beim Löschen');
                }
            } catch (error) {
                console.error('Error:', error);
                toastr.error('Netzwerkfehler beim Löschen des Addons');
            }
        });
    });

});
</script>
