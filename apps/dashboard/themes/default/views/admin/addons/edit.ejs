<%# Admin: Addon Edit/Review %>

    <div class="content">
        <div class="container-fluid">
            
            <%# Status-Badges %>
            <div class="row mb-3">
                <div class="col-md-12">
                    <span class="badge badge-lg <%= addon.trust_level === 'official' ? 'bg-success-lt' : addon.trust_level === 'verified' ? 'bg-info-lt' : 'bg-secondary-lt' %>">
                        Trust: <%= addon.trust_level %>
                    </span>
                    <span class="badge badge-lg <%= addon.visibility === 'public' || addon.visibility === 'official' ? 'bg-success-lt' : addon.visibility === 'unlisted' ? 'bg-warning-lt' : 'bg-secondary-lt' %>">
                        Visibility: <%= addon.visibility %>
                    </span>
                </div>
            </div>

            <div class="row">
                
                <%# Linke Spalte: Metadata %>
                <div class="col-md-6">
                    
                    <%# Basis-Informationen %>
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fa-solid fa-info-circle"></i>
                                Basis-Informationen
                            </h3>
                        </div>
                        <div class="card-body">
                            <form id="metadataForm">
                                <div class="mb-3">
                                    <label>Name</label>
                                    <input type="text" class="form-control" name="name" value="<%= addon.name %>" required>
                                </div>
                                
                                <div class="mb-3">
                                    <label>Slug</label>
                                    <input type="text" class="form-control" name="slug" value="<%= addon.slug %>" readonly>
                                    <small class="form-hint">Fest: Über den Slug findet die Einlieferung ihren Anker. Eine Änderung hier trennte Paket und Anker.</small>
                                </div>
                                
                                <div class="mb-3">
                                    <label>Beschreibung</label>
                                    <textarea class="form-control" name="description" rows="4"><%= addon.description || '' %></textarea>
                                </div>
                                
                                <div class="mb-3">
                                    <%# Tags aus der Tag-Bibliothek (2026-10-07): tippen, Enter uebernimmt.
                                        Vorhandene werden vorgeschlagen und wiederverwendet; ein neues Wort
                                        kommt beim Speichern in die Bibliothek. %>
                                    <label for="tagEingabe">Tags</label>
                                    <% if (locals.tagsFehler) { %>
                                        <div class="alert alert-danger py-2 small">Die Tags ließen sich nicht laden (<%= locals.tagsFehler %>) — sie werden beim Speichern nicht angefasst.</div>
                                    <% } else { %>
                                        <div class="form-control d-flex flex-wrap align-items-center gap-1" id="tagFeld" style="cursor:text"
                                             data-tags="<%= JSON.stringify(addon.tags || []) %>">
                                            <input type="text" id="tagEingabe" list="tagVorschlaege" autocomplete="off" maxlength="40"
                                                   class="border-0 flex-fill bg-transparent" style="outline:none;min-width:140px"
                                                   placeholder="Tag tippen, Enter übernimmt">
                                        </div>
                                        <datalist id="tagVorschlaege">
                                            <% (locals.alleTags || []).forEach(function (t) { %><option value="<%= t.name %>"></option><% }); %>
                                        </datalist>
                                        <div class="form-hint">Vorhandene Tags werden beim Tippen vorgeschlagen. Ein neues Wort kommt beim Speichern in die Bibliothek und steht dann auch anderen Spielen zur Wahl.</div>
                                    <% } %>
                                </div>
                                
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa-solid fa-save"></i> Speichern
                                </button>
                            </form>
                        </div>
                    </div>

                </div>

                <%# Rechte Spalte: Approval-Settings — neben den Basis-Informationen,
                    nicht darunter (Betreiber, 2026-10-07: die rechte Haelfte stand leer). %>
                <div class="col-md-6">

                    <div class="card">
                        <div class="card-header bg-warning">
                            <h3 class="card-title">
                                <i class="fa-solid fa-shield-check"></i>
                                SuperAdmin Approval
                            </h3>
                        </div>
                        <div class="card-body">
                            <form id="approvalForm">
                                <div class="mb-3">
                                    <label>Trust Level</label>
                                    <select class="form-control" name="trust_level">
                                        <option value="unverified" <%= addon.trust_level === 'unverified' ? 'selected' : '' %>>
                                            Unverified (Neu, nicht getestet)
                                        </option>
                                        <option value="verified" <%= addon.trust_level === 'verified' ? 'selected' : '' %>>
                                            Verified (Getestet, funktioniert)
                                        </option>
                                        <option value="trusted" <%= addon.trust_level === 'trusted' ? 'selected' : '' %>>
                                            Trusted (10+ Installs, 4+ Rating)
                                        </option>
                                        <option value="official" <%= addon.trust_level === 'official' ? 'selected' : '' %>>
                                            Official (FireBot Team)
                                        </option>
                                    </select>
                                </div>
                                
                                <div class="mb-3">
                                    <label>Visibility</label>
                                    <select class="form-control" name="visibility">
                                        <option value="unlisted" <%= addon.visibility === 'unlisted' ? 'selected' : '' %>>
                                            Unlisted (Nicht gelistet, über Link erreichbar)
                                        </option>
                                        <option value="public" <%= addon.visibility === 'public' ? 'selected' : '' %>>
                                            Public (Im Marketplace sichtbar)
                                        </option>
                                        <option value="private" <%= addon.visibility === 'private' ? 'selected' : '' %>>
                                            Private (Nur für bestimmte Guilds)
                                        </option>
                                        <option value="official" <%= addon.visibility === 'official' ? 'selected' : '' %>>
                                            Official (Offiziell von FireBot Team)
                                        </option>
                                    </select>
                                </div>
                                
                                <div class="alert alert-info">
                                    <i class="fa-solid fa-info-circle"></i>
                                    <strong>Verified:</strong> <%= addon.verified_at ? new Date(addon.verified_at).toLocaleString('de-DE') : 'Noch nicht verifiziert' %><br>
                                    <strong>Last Tested:</strong> <%= addon.last_tested_at ? new Date(addon.last_tested_at).toLocaleString('de-DE') : 'Nie' %>
                                </div>
                                
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="fa-solid fa-check"></i> Approve & Update
                                </button>
                            </form>
                        </div>
                    </div>

                </div>

            </div>

            <%# ── Fassungen & Freigabe (Baustelle 172, 2026-10-07) ──────────────
                Welche Fassung des Spielpakets Server bekommen. „stable" folgt der
                neuesten FREIGEGEBENEN Fassung, „test" der neuesten ueberhaupt.
                Freigegeben wird nur, was einen gruenen Pruefdurchlauf hat. %>
            <%
              const fListe = locals.fassungen || [];
              const sjk = locals.serverJeKanal || { stable: 0, test: 0 };
              const freigegeben = fListe.filter(function (f) { return f.channel === 'stable'; });
              const zeit = function (t) { return t ? new Date(t).toLocaleString('de-DE', { dateStyle: 'short', timeStyle: 'short' }) : '—'; };
            %>
            <div class="row mt-3">
                <div class="col-12">
                    <div class="card" id="karteFassungen">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fa-solid fa-code-branch"></i> Fassungen &amp; Freigabe</h3>
                            <div class="card-actions text-secondary small">
                                <%= sjk.stable %> Server auf stable · <%= sjk.test %> auf test
                            </div>
                        </div>
                        <div class="card-body">
                            <% if (locals.fassungenFehler) { %>
                                <div class="alert alert-danger">Die Fassungen ließen sich nicht laden: <%= locals.fassungenFehler %></div>
                            <% } else if (!fListe.length) { %>
                                <p class="text-secondary mb-0">Zu diesem Spiel gibt es kein Spielpaket — es entsteht in der Werkbank.</p>
                            <% } else { %>
                                <p class="text-secondary small">
                                    Ein Server auf <strong>stable</strong> startet mit der neuesten freigegebenen Fassung, einer auf <strong>test</strong> mit der neuesten überhaupt.
                                    Freigeben lässt sich nur eine Fassung mit grünem Prüfdurchlauf aus der Werkbank.
                                    Andere Guilds sehen das Spiel beim Anlegen erst, wenn eine Fassung freigegeben ist.
                                </p>
                                <% if (!freigegeben.length) { %>
                                    <div class="alert alert-info py-2 small">
                                        Noch keine Fassung freigegeben — das Spiel ist ein Entwurf und nur in deiner Guild anlegbar.
                                        <% if (sjk.stable) { %><strong><%= sjk.stable %> Server folgen „stable" und haben damit kein Paket.</strong><% } %>
                                    </div>
                                <% } %>
                                <div class="table-responsive">
                                    <table class="table table-sm table-vcenter">
                                        <thead><tr><th>Fassung</th><th>Kanal</th><th>Veröffentlicht</th><th>Prüfdurchlauf</th><th>Freigegeben</th><th class="w-1"></th></tr></thead>
                                        <tbody>
                                            <% fListe.forEach(function (f) { %>
                                                <tr>
                                                    <td class="font-monospace"><%= f.version %></td>
                                                    <td>
                                                        <% if (f.channel === 'stable') { %><span class="badge bg-green-lt">stable</span>
                                                        <% } else { %><span class="badge bg-secondary-lt">test</span><% } %>
                                                    </td>
                                                    <td class="text-nowrap"><%= zeit(f.published_at) %></td>
                                                    <td class="text-nowrap">
                                                        <% if (f.test_passed_at) { %>grün · <%= zeit(f.test_passed_at) %>
                                                        <% } else { %><span class="text-secondary">keiner</span><% } %>
                                                    </td>
                                                    <td class="text-nowrap"><%= zeit(f.released_at) %></td>
                                                    <td class="text-nowrap">
                                                        <% if (f.channel === 'stable') { %>
                                                            <button class="btn btn-sm btn-outline-danger" type="button"
                                                                    data-fassung-zuruecknehmen="<%= f.id %>" data-fassung-version="<%= f.version %>">Freigabe zurücknehmen</button>
                                                        <% } else if (f.test_passed_at) { %>
                                                            <button class="btn btn-sm btn-success" type="button"
                                                                    data-fassung-freigeben="<%= f.id %>" data-fassung-version="<%= f.version %>">Freigeben</button>
                                                        <% } else { %>
                                                            <span class="text-secondary small" title="Freigegeben wird nur, was die Werkbank geprüft hat.">nicht freigebbar</span>
                                                        <% } %>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const addonId = <%= addon.id %>;

    // ── Fassungen freigeben / Freigabe zurücknehmen ─────────────────────────
    const melde = (art, text) => {
        if (window.showToast) window.showToast(art, text);
        else if (window.toastr) (art === 'success' ? toastr.success : toastr.error)(text);
    };
    const fassungsKnopf = (attribut, pfad, frage) => {
        document.querySelectorAll('[' + attribut + ']').forEach((knopf) => {
            knopf.addEventListener('click', async () => {
                if (!confirm(frage(knopf.dataset.fassungVersion))) return;
                knopf.disabled = true;
                try {
                    const antwort = await fetch(`/admin/addons/${addonId}/fassungen/${knopf.getAttribute(attribut)}/${pfad}`, {
                        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}'
                    });
                    const ergebnis = await antwort.json();
                    if (!ergebnis.success) throw new Error(ergebnis.message || 'Hat nicht geklappt');
                    melde('success', ergebnis.message);
                    setTimeout(() => location.reload(), 1500);
                } catch (fehler) {
                    knopf.disabled = false;
                    melde('error', fehler.message);
                }
            });
        });
    };
    fassungsKnopf('data-fassung-freigeben', 'freigeben',
        (v) => `Fassung ${v} freigeben? Alle Server auf „stable" starten ab dem nächsten Start mit ihr.`);
    fassungsKnopf('data-fassung-zuruecknehmen', 'zuruecknehmen',
        (v) => `Freigabe von ${v} zurücknehmen? Server auf „stable" fallen auf die vorige freigegebene Fassung zurück — gibt es keine, lassen sie sich nicht starten.`);
    
    // ── Tags: kleine Marken im Feld, Vorschläge aus der Bibliothek ─────────
    // `tagListe` ist null, wenn die Tags nicht geladen werden konnten — dann
    // schickt das Formular kein `tags` mit, und der Server fasst sie nicht an.
    const tagFeld = document.getElementById('tagFeld');
    const tagEingabe = document.getElementById('tagEingabe');
    let tagListe = tagFeld ? JSON.parse(tagFeld.dataset.tags || '[]') : null;
    const gleich = (a, b) => a.trim().replace(/\s+/g, ' ').toLowerCase() === b.trim().replace(/\s+/g, ' ').toLowerCase();
    const zeichneTags = () => {
        tagFeld.querySelectorAll('[data-tag]').forEach((m) => m.remove());
        tagListe.forEach((name) => {
            const marke = document.createElement('span');
            marke.className = 'badge bg-secondary-lt d-inline-flex align-items-center gap-1';
            marke.dataset.tag = name;
            marke.append(document.createTextNode(name));
            const weg = document.createElement('button');
            weg.type = 'button'; weg.className = 'btn-close'; weg.style.fontSize = '.55rem';
            weg.title = 'Tag entfernen'; weg.setAttribute('aria-label', name + ' entfernen');
            weg.addEventListener('click', () => { tagListe = tagListe.filter((t) => t !== name); zeichneTags(); });
            marke.append(weg);
            tagFeld.insertBefore(marke, tagEingabe);
        });
    };
    const nimmTag = () => {
        const name = tagEingabe.value.trim().replace(/\s+/g, ' ');
        if (!name) return;
        if (/[,<>"]/.test(name)) { melde('error', 'Ein Tag darf kein Komma, <, > oder " enthalten.'); return; }
        if (tagListe.length >= 12 && !tagListe.some((t) => gleich(t, name))) { melde('error', 'Höchstens 12 Tags je Spiel.'); return; }
        if (!tagListe.some((t) => gleich(t, name))) tagListe.push(name);
        tagEingabe.value = '';
        zeichneTags();
    };
    if (tagFeld) {
        zeichneTags();
        tagFeld.addEventListener('click', (e) => { if (e.target === tagFeld) tagEingabe.focus(); });
        tagEingabe.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ',') { e.preventDefault(); nimmTag(); }
            else if (e.key === 'Backspace' && !tagEingabe.value && tagListe.length) { tagListe.pop(); zeichneTags(); }
        });
        // Ein Klick auf einen Vorschlag füllt das Feld, ohne dass Enter fällt.
        tagEingabe.addEventListener('change', nimmTag);
    }

    // Metadata-Form Submit
    document.getElementById('metadataForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        // Was noch im Feld steht, gehört dazu — sonst geht das letzte getippte Tag verloren.
        if (tagFeld) nimmTag();
        
        const formData = new FormData(this);
        const payload = {
            name:        formData.get('name'),
            description: formData.get('description'),
        };
        if (tagListe) payload.tags = tagListe;
        
        try {
            const response = await fetch(`/admin/addons/${addonId}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            
            const result = await response.json();
            
            if (result.success) {
                toastr.success('Metadaten erfolgreich gespeichert!');
            } else {
                toastr.error(result.message || 'Fehler beim Speichern der Metadaten');
            }
        } catch (error) {
            console.error('Error:', error);
            toastr.error('Fehler beim Speichern der Metadaten');
        }
    });
    
    // Approval-Form Submit
    document.getElementById('approvalForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const formData = new FormData(this);
        const payload = Object.fromEntries(formData);
        
        if (!confirm('Addon wirklich mit diesen Einstellungen freigeben?')) return;
        
        try {
            const response = await fetch(`/admin/addons/${addonId}/approve`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            
            const result = await response.json();
            
            if (result.success) {
                toastr.success('Addon erfolgreich freigegeben!');
                setTimeout(() => location.reload(), 1500);
            } else {
                toastr.error(result.message || 'Fehler beim Freigeben des Addons');
            }
        } catch (error) {
            console.error('Error:', error);
            toastr.error('Fehler beim Freigeben des Addons');
        }
    });
});
</script>
