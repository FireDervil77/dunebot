<%# Admin: ein Spiel — Name, Beschreibung, Tags und die Freigabe seiner Fassungen.

    Bis zum 2026-10-08 standen hier oben zwei Marken (Trust, Visibility) und
    rechts eine Karte „SuperAdmin Approval". Sie setzte `status`, `trust_level`
    und `visibility` in `addon_marketplace` — Felder des Marktplatz-Modells, in
    dem Fremde Spiele einreichen. Das gab es nie: Alle Spiele standen von der
    Einlieferung an auf `approved`/`public`. Ob eine Guild ein Spiel anlegen
    kann, entscheidet allein die Freigabe einer Fassung (rechte Karte). %>

    <div class="content">
        <div class="container-fluid">

            <div class="row">

                <%# Linke Spalte: Metadata %>
                <div class="col-lg-5">

                    <%# Basis-Informationen %>
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fa-solid fa-info-circle"></i>
                                Basis-Informationen
                            </h3>
                        </div>
                        <div class="card-body">
                            <form id="metadataForm">
                                <div class="mb-3">
                                    <label>Name</label>
                                    <input type="text" class="form-control" name="name" value="<%= addon.name %>" required>
                                </div>
                                
                                <div class="mb-3">
                                    <label>Slug</label>
                                    <input type="text" class="form-control" name="slug" value="<%= addon.slug %>" readonly>
                                    <small class="form-hint">Fest: Über den Slug findet die Einlieferung ihren Anker. Eine Änderung hier trennte Paket und Anker.</small>
                                </div>
                                
                                <div class="mb-3">
                                    <label>Beschreibung</label>
                                    <textarea class="form-control" name="description" rows="4"><%= addon.description || '' %></textarea>
                                </div>
                                
                                <div class="mb-3">
                                    <%# Tags aus der Tag-Bibliothek (2026-10-07): tippen, Enter uebernimmt.
                                        Vorhandene werden vorgeschlagen und wiederverwendet; ein neues Wort
                                        kommt beim Speichern in die Bibliothek. Das Feld ist seit dem
                                        2026-10-08 ein gemeinsamer Baustein — die Werkbank benutzt dasselbe. %>
                                    <label for="spielTags">Tags</label>
                                    <%- include('../../shared/tagfeld', {
                                        id: 'spielTags', tags: addon.tags || [], alle: locals.alleTags || [], fehler: locals.tagsFehler || null,
                                        hinweis: 'Vorhandene Tags werden beim Tippen vorgeschlagen. Ein neues Wort kommt beim Speichern in die Bibliothek und steht dann auch anderen Spielen zur Wahl.'
                                    }) %>
                                </div>
                                
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa-solid fa-save"></i> Speichern
                                </button>
                            </form>
                        </div>
                    </div>

                </div>

                <%# ── Rechte Spalte: Fassungen & Freigabe (Baustelle 172, 2026-10-07) ──
                    Welche Fassung des Spielpakets Server bekommen. „stable" folgt der
                    neuesten FREIGEGEBENEN Fassung, „test" der neuesten ueberhaupt.
                    Freigegeben wird nur, was einen gruenen Pruefdurchlauf hat. %>
                <%
                  const fListe = locals.fassungen || [];
                  const sjk = locals.serverJeKanal || { stable: 0, test: 0 };
                  const freigegeben = fListe.filter(function (f) { return f.channel === 'stable'; });
                  const zeit = function (t) { return t ? new Date(t).toLocaleString('de-DE', { dateStyle: 'short', timeStyle: 'short' }) : '—'; };
                %>
                <div class="col-lg-7">
                    <div class="card" id="karteFassungen">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fa-solid fa-code-branch"></i> Fassungen &amp; Freigabe</h3>
                            <div class="card-actions text-secondary small">
                                <%= sjk.stable %> Server auf stable · <%= sjk.test %> auf test
                            </div>
                        </div>
                        <div class="card-body">
                            <% if (locals.fassungenFehler) { %>
                                <div class="alert alert-danger">Die Fassungen ließen sich nicht laden: <%= locals.fassungenFehler %></div>
                            <% } else if (!fListe.length) { %>
                                <p class="text-secondary mb-0">Zu diesem Spiel gibt es kein Spielpaket — es entsteht in der Werkbank.</p>
                            <% } else { %>
                                <p class="text-secondary small">
                                    Ein Server auf <strong>stable</strong> startet mit der neuesten freigegebenen Fassung, einer auf <strong>test</strong> mit der neuesten überhaupt.
                                    Freigeben lässt sich nur eine Fassung mit grünem Prüfdurchlauf aus der Werkbank.
                                    Andere Guilds sehen das Spiel beim Anlegen erst, wenn eine Fassung freigegeben ist.
                                </p>
                                <% if (!freigegeben.length) { %>
                                    <div class="alert alert-info py-2 small">
                                        Noch keine Fassung freigegeben — das Spiel ist ein Entwurf und nur in deiner Guild anlegbar.
                                        <% if (sjk.stable) { %><strong><%= sjk.stable %> Server folgen „stable" und haben damit kein Paket.</strong><% } %>
                                    </div>
                                <% } %>
                                <div class="table-responsive">
                                    <table class="table table-sm table-vcenter">
                                        <thead><tr><th>Fassung</th><th>Kanal</th><th>Veröffentlicht</th><th>Prüfdurchlauf</th><th>Freigegeben</th><th class="w-1"></th></tr></thead>
                                        <tbody>
                                            <% fListe.forEach(function (f) { %>
                                                <tr>
                                                    <td class="font-monospace"><%= f.version %></td>
                                                    <td>
                                                        <% if (f.channel === 'stable') { %><span class="badge bg-green-lt">stable</span>
                                                        <% } else { %><span class="badge bg-secondary-lt">test</span><% } %>
                                                    </td>
                                                    <td class="text-nowrap"><%= zeit(f.published_at) %></td>
                                                    <td class="text-nowrap">
                                                        <% if (f.test_passed_at) { %>grün · <%= zeit(f.test_passed_at) %>
                                                        <% } else { %><span class="text-secondary">keiner</span><% } %>
                                                    </td>
                                                    <td class="text-nowrap"><%= zeit(f.released_at) %></td>
                                                    <td class="text-nowrap">
                                                        <% if (f.channel === 'stable') { %>
                                                            <button class="btn btn-sm btn-outline-danger" type="button"
                                                                    data-fassung-zuruecknehmen="<%= f.id %>" data-fassung-version="<%= f.version %>">Freigabe zurücknehmen</button>
                                                        <% } else if (f.test_passed_at) { %>
                                                            <button class="btn btn-sm btn-success" type="button"
                                                                    data-fassung-freigeben="<%= f.id %>" data-fassung-version="<%= f.version %>">Freigeben</button>
                                                        <% } else { %>
                                                            <span class="text-secondary small" title="Freigegeben wird nur, was die Werkbank geprüft hat.">nicht freigebbar</span>
                                                        <% } %>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const addonId = <%= addon.id %>;

    // ── Fassungen freigeben / Freigabe zurücknehmen ─────────────────────────
    const melde = (art, text) => {
        if (window.showToast) window.showToast(art, text);
        else if (window.toastr) (art === 'success' ? toastr.success : toastr.error)(text);
    };
    const fassungsKnopf = (attribut, pfad, frage) => {
        document.querySelectorAll('[' + attribut + ']').forEach((knopf) => {
            knopf.addEventListener('click', async () => {
                if (!confirm(frage(knopf.dataset.fassungVersion))) return;
                knopf.disabled = true;
                try {
                    const antwort = await fetch(`/admin/addons/${addonId}/fassungen/${knopf.getAttribute(attribut)}/${pfad}`, {
                        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}'
                    });
                    const ergebnis = await antwort.json();
                    if (!ergebnis.success) throw new Error(ergebnis.message || 'Hat nicht geklappt');
                    melde('success', ergebnis.message);
                    setTimeout(() => location.reload(), 1500);
                } catch (fehler) {
                    knopf.disabled = false;
                    melde('error', fehler.message);
                }
            });
        });
    };
    fassungsKnopf('data-fassung-freigeben', 'freigeben',
        (v) => `Fassung ${v} freigeben? Alle Server auf „stable" starten ab dem nächsten Start mit ihr.`);
    fassungsKnopf('data-fassung-zuruecknehmen', 'zuruecknehmen',
        (v) => `Freigabe von ${v} zurücknehmen? Server auf „stable" fallen auf die vorige freigegebene Fassung zurück — gibt es keine, lassen sie sich nicht starten.`);
    
    // Metadata-Form Submit
    document.getElementById('metadataForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        const formData = new FormData(this);
        const payload = {
            name:        formData.get('name'),
            description: formData.get('description'),
        };
        // null = die Tags liessen sich nicht laden: nichts mitschicken, der Server fasst sie nicht an.
        const tagListe = window.tagfeld('spielTags');
        if (tagListe) payload.tags = tagListe;
        
        try {
            const response = await fetch(`/admin/addons/${addonId}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            
            const result = await response.json();
            
            if (result.success) {
                toastr.success('Metadaten erfolgreich gespeichert!');
            } else {
                toastr.error(result.message || 'Fehler beim Speichern der Metadaten');
            }
        } catch (error) {
            console.error('Error:', error);
            toastr.error('Fehler beim Speichern der Metadaten');
        }
    });
});
</script>
