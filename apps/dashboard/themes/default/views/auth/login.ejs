<%#
 * Anmeldung — Tabler-Muster `container-tight`
 *
 * Vorher AdminLTEs `login-box`/`login-card-body`. Dabei blieb `card-body`
 * ungeschlossen: Der Browser buegelte es aus, sichtbar war nichts — bis zur
 * naechsten Aenderung am Markup. Jetzt ausgeglichen.
%>
<div class="container container-tight py-4">

    <div class="text-center mb-4">
        <img src="/themes/default/assets/images/firebot.png"
             width="110" height="110" alt="FireBot" class="mb-2">
        <div class="h1 m-0">FireBot</div>
    </div>

    <div class="card card-md">
        <div class="card-body">
            <h2 class="h2 text-center mb-4"><%= tr('AUTH.LOGIN_TITLE') %></h2>

            <a href="<%= discordAuthURL %>" id="discord-login-btn" class="btn btn-primary w-100">
                <i class="fab fa-discord me-2"></i>
                <%= tr('AUTH.LOGIN_BUTTON') %>
            </a>

            <p class="text-secondary text-center mt-3 mb-0">
                <%= tr('AUTH.LOGIN_HINT') %>
            </p>

            <div id="login-loader" class="d-none text-center mt-3">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">…</span>
                </div>
                <p class="mt-2 mb-0"><%= tr('AUTH.LOGIN_WAIT') %></p>
            </div>
        </div>
    </div>

</div>

<script>
document.getElementById('discord-login-btn').addEventListener('click', function () {
    // Knopf ausblenden, Ladeanzeige einblenden
    this.classList.add('d-none');
    document.getElementById('login-loader').classList.remove('d-none');

    // Kommt nach 15 Sekunden keine Weiterleitung, ist etwas schiefgegangen —
    // dann braucht der Nutzer einen Weg zurueck statt eines ewigen Kreisels.
    setTimeout(function () {
        var loader = document.getElementById('login-loader');
        if (!loader.classList.contains('d-none')) {
            loader.innerHTML =
                '<div class="alert alert-warning mb-0">Die Anmeldung dauert laenger als erwartet. ' +
                '<a href="<%= discordAuthURL %>" class="alert-link">Erneut versuchen</a></div>';
        }
    }, 15000);
});
</script>
