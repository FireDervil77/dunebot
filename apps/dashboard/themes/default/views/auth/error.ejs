<%#
 * Anmeldung fehlgeschlagen — Grund nennen und einen Weg zurueck anbieten.
%>
<div class="container container-tight py-4">
    <div class="card card-md">
        <div class="card-body">

            <h2 class="h2 text-center mb-4"><%= tr('AUTH.ERROR_TITLE') %></h2>

            <div class="alert alert-danger" role="alert">
                <%= error %>
            </div>

            <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
                <a href="<%= locals.retry_url || '/auth/login' %>" class="btn btn-primary">
                    <i class="fas fa-redo me-2"></i>
                    <%= tr('AUTH.ERROR_RETRY') %>
                </a>
                <a href="/" class="btn btn-outline-secondary">
                    <i class="fas fa-home me-2"></i>
                    <%= tr('AUTH.ERROR_HOME') %>
                </a>
            </div>

            <hr class="my-4">

            <p class="text-secondary small mb-2">
                <%= tr('AUTH.ERROR_HELP') %>
            </p>
            <ul class="text-secondary small mb-0">
                <li><%= tr('AUTH.ERROR_HELP_CACHE') %></li>
                <li><%= tr('AUTH.ERROR_HELP_DISCORD') %></li>
                <li><%= tr('AUTH.ERROR_HELP_ADMIN') %></li>
            </ul>

        </div>
    </div>
</div>
