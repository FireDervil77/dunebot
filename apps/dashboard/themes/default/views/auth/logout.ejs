<%#
 * Abmeldung — Bestaetigung mit zwei Wegen zurueck.
%>
<div class="container container-tight py-4">

    <div class="text-center mb-4">
        <img src="/themes/default/assets/images/firebot.png"
             width="110" height="110" alt="FireBot" class="mb-2">
        <div class="h1 m-0">FireBot</div>
    </div>

    <div class="card card-md">
        <div class="card-body text-center">

            <h2 class="h2 mb-3"><%= tr('AUTH.LOGOUT_TITLE') %></h2>

            <p class="text-secondary">
                <%= tr('AUTH.LOGOUT_THANKS') %>
            </p>

            <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
                <a href="/" class="btn btn-primary">
                    <%= tr('AUTH.LOGOUT_HOME') %>
                </a>
                <a href="/auth/login" class="btn btn-outline-secondary">
                    <%= tr('AUTH.LOGOUT_AGAIN') %>
                </a>
            </div>

        </div>
    </div>

</div>
