<!-- filepath: /home/firedervil/dunebot_new/apps/dashboard/themes/default/layouts/auth.ejs -->
<!DOCTYPE html>
<html lang="<%= locals.lang || 'de' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.title ? `${title} - FireBot` : 'FireBot - Authentifizierung' %></title>
    <%- locals.csrfMetaTag || '' %>

    <!-- Favicon -->
    <link rel="icon" href="<%= theme.asset('images/favicon.png') %>" type="image/png">

    <!-- Styles: Theme + Plugins (AssetManager) -->
    <% if (locals.assetManager) { %>
      <%- assetManager.renderStyles() %>
    <% } %>

    <%# Design-Tokens aus theme.json — stehen zwischen tokens.css und der Guild-Anpassung %>
<% if (locals.themeTokensCSS) { %>
<style id="theme-tokens">
<%- locals.themeTokensCSS %>
</style>
<% } %>

<!-- Head-Skripte: Theme + Plugins (AssetManager) -->
    <% if (locals.assetManager) { %>
      <%- assetManager.renderScripts(false) %>
    <% } %>

    <!-- Hook: auth_head -->
<%- hookArea('auth_head') %>
</head>
<body class="login-page bg-body-secondary">
                              
<!-- Hook: before_auth_content -->
<%- hookArea('auth_before_content') %>

<!-- Main Content -->
<%- body %>

<!-- Hook: after_auth_content -->
<%- hookArea('auth_after_content') %>

<!-- Footer -->
<p class="mt-3 mb-3 text-body-secondary">
    &copy; <%= new Date().getFullYear() %> FireBot
</p>

</main>

<!-- Skripte: Theme + Plugins (AssetManager, Footer) -->
<% if (locals.assetManager) { %>
  <%- assetManager.renderScripts(true) %>
<% } %>

<!-- Hook: auth_footer_scripts -->
<%- hookArea('auth_footer_scripts') %>
</body>
</html>