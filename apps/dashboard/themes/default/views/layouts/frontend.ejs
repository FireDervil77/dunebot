<!-- filepath: /home/firedervil/dunebot_new/apps/dashboard/themes/default/layouts/frontend.ejs -->
<!doctype html>
<html lang="<%= locals.lang || 'de' %>" class="<%= locals.theme?.info?.darkMode ? 'dark' : '' %>">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.title ? `${title} - ${locals.dashboardLogo?.name || 'FireBot'}` : `${locals.dashboardLogo?.name || 'FireBot'} - Der Discord-Bot für deine Community` %></title>
    
    <!-- Dashboard Logo Config -->
    <script>
      window.DASHBOARD_CONFIG = {
        logoName: '<%= locals.dashboardLogo?.name || "FireBot" %>',
        logoUrl: '<%= locals.dashboardLogo?.url || "/images/firebot.png" %>'
      };
    </script>
    
    <!-- Meta & SEO -->
    <%- includePartial('frontend/header', locals) %>
    <%- locals.csrfMetaTag || '' %>

    <!-- Favicon, Vorverbindungen und die Asset-Ausgabe des AssetManagers -->
    <%- includePartial('frontend/stylesheets', locals) %>

    <!--
      Einwilligung + Tag Manager. Steht bewusst hier im <head> und nicht bei den
      Skripten am Seitenende: Der Consent-Mode-Standard muss vor GTM gesetzt sein,
      sonst laedt GTM seine Tags, bevor jemand gefragt wurde.
    -->
    <%- includePartial('frontend/consent', locals) %>
    
    <!-- Hook: frontend_head -->
<%- hookArea('frontend_head') %>
  </head>

  <body class="landing-page">
    <!-- Navigation -->
    <%- includePartial('frontend/header_nav', { locals }) %>
    
    <!-- Hook: before_frontend_content -->
<%- hookArea('before_frontend_content') %>
    
    <!-- Main Content -->
    <%- body %>
    
    <!-- Hook: after_frontend_content -->
<%- hookArea('after_frontend_content') %>

    <!-- Footer -->
    <%- includePartial('frontend/footer', locals) %>
    
    <!-- Scripts (jQuery + Bootstrap + Vendor) -->
    <%- includePartial('frontend/scripts', locals) %>
    
    <!-- Hook: frontend_footer_scripts -->
<%- hookArea('frontend_footer_scripts') %>
  </body>
</html>