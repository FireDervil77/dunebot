<%#
 * Bug Reports — Liste und Meldeformular
 *
 * Kein eigener Seitenrahmen und keine eigene Titelzeile: beides stellt das
 * Layout des Themes. Der Titel kommt aus `locals.title` (feedback.router.js).
 *
 * @context {Array}   bugs             - Bug Reports, neueste zuerst
 * @context {boolean} istKontrollGuild - sieht auch fremde guild_only-Eintraege
 * @context {string}  ladeFehler       - gesetzt, wenn die Abfrage scheiterte
%>

<%# ── Hinweis ─────────────────────────────────────────────────────────────── %>
<div class="alert alert-info alert-dismissible mb-3" role="alert">
    <div class="d-flex">
        <div class="me-3"><i class="fa-solid fa-circle-info fa-lg"></i></div>
        <div>
            <h4 class="alert-title"><%= tr('BUG_REPORT.INFO_TITLE', 'System Bug Report') %></h4>
            <div class="text-secondary"><%= tr('BUG_REPORT.INFO_TEXT') %></div>
        </div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Schließen"></button>
</div>

<%# ── Kennzahlen ──────────────────────────────────────────────────────────── %>
<%
/**
 * Eine Kennzahl-Karte im Tabler-Zuschnitt.
 * Die alte Kachel war ein durchgefaerbter Klotz mit riesigem Zierbild dahinter;
 * hier traegt die Farbe nur noch das Sinnbild, die Zahl steht in Textfarbe.
 */
function _kennzahl(farbe, symbol, wert, beschriftung) {
    return `<div class="col-sm-6 col-lg-3">
      <div class="card card-sm">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-auto">
              <span class="bg-${farbe} text-white avatar"><i class="fas ${symbol}"></i></span>
            </div>
            <div class="col">
              <div class="h2 fw-medium mb-0">${wert}</div>
              <div class="text-secondary">${beschriftung}</div>
            </div>
          </div>
        </div>
      </div>
    </div>`;
}
%>
<div class="row row-cards mb-3">
    <%- _kennzahl('danger',  'fa-bug',         bugs.length,                                            tr('BUG_REPORT.TOTAL_BUGS', 'Bugs gesamt')) %>
    <%- _kennzahl('warning', 'fa-folder-open', bugs.filter(b => b.status === 'open').length,           tr('BUG_REPORT.OPEN_BUGS', 'Offen')) %>
    <%- _kennzahl('info',    'fa-spinner',     bugs.filter(b => b.status === 'in_progress').length,    tr('BUG_REPORT.IN_PROGRESS', 'In Bearbeitung')) %>
    <%- _kennzahl('success', 'fa-check',       bugs.filter(b => b.status === 'resolved').length,       tr('BUG_REPORT.RESOLVED', 'Gelöst')) %>
</div>

<%# ── Liste ───────────────────────────────────────────────────────────────── %>
<div class="card">
    <div class="card-header">
        <h3 class="card-title"><%= tr('BUG_REPORT.ALL_BUGS', 'Alle Bug Reports') %></h3>
        <div class="card-actions">
            <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#createBugModal">
                <i class="fa-solid fa-bug me-1"></i> <%= tr('BUG_REPORT.CREATE_NEW', 'Bug melden') %>
            </button>
        </div>
    </div>

    <% if (typeof ladeFehler !== 'undefined' && ladeFehler) { %>
        <div class="card-body">
            <div class="alert alert-danger mb-0">
                <i class="fas fa-triangle-exclamation me-2"></i><%= ladeFehler %>
            </div>
        </div>
    <% } else if (bugs.length === 0) { %>
        <div class="card-body">
            <div class="empty">
                <div class="empty-icon"><i class="fa-solid fa-bug fa-3x text-secondary"></i></div>
                <p class="empty-title mt-3"><%= tr('BUG_REPORT.NO_BUGS', 'Keine Bug Reports vorhanden') %></p>
            </div>
        </div>
    <% } else { %>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th><%= tr('BUG_REPORT.TITLE_COL', 'Titel') %></th>
                        <th><%= tr('BUG_REPORT.CATEGORY_COL', 'Kategorie') %></th>
                        <th>Sichtbarkeit</th>
                        <th><%= tr('BUG_REPORT.STATUS_COL', 'Status') %></th>
                        <th><%= tr('BUG_REPORT.PRIORITY_COL', 'Priorität') %></th>
                        <th><%= tr('BUG_REPORT.REPORTER_COL', 'Gemeldet von') %></th>
                        <th><%= tr('BUG_REPORT.DATE_COL', 'Datum') %></th>
                    </tr>
                </thead>
                <tbody>
                    <% bugs.forEach(bug => { %>
                        <tr>
                            <td class="text-secondary"><%= bug.id %></td>
                            <td>
                                <strong><%= bug.title %></strong>
                                <div class="text-secondary small"><%= bug.description.substring(0, 100) %>…</div>
                            </td>
                            <td><span class="badge bg-secondary-lt"><%= bug.category || 'Allgemein' %></span></td>
                            <td>
                                <% if (bug.guild_only) { %>
                                    <% if (typeof istKontrollGuild !== 'undefined' && istKontrollGuild && String(bug.guild_id) !== String(guildId)) { %>
                                        <span class="badge bg-warning-lt"><i class="fas fa-lock me-1"></i>Nur <%= bug.guild_name || bug.guild_id %></span>
                                    <% } else { %>
                                        <span class="badge bg-secondary-lt"><i class="fas fa-lock me-1"></i>Diese Guild</span>
                                    <% } %>
                                <% } else { %>
                                    <span class="badge bg-info-lt"><i class="fas fa-globe me-1"></i>Alle Guilds</span>
                                <% } %>
                            </td>
                            <td>
                                <%
                                const statusFarbe = {
                                    open: 'warning',
                                    in_progress: 'info',
                                    resolved: 'success',
                                    closed: 'secondary',
                                    wontfix: 'dark'
                                };
                                %>
                                <span class="badge bg-<%= statusFarbe[bug.status] || 'secondary' %>-lt">
                                    <%= tr('STATUS.' + bug.status.toUpperCase(), bug.status) %>
                                </span>
                            </td>
                            <td>
                                <%
                                const prioFarbe = {
                                    low: 'secondary',
                                    medium: 'primary',
                                    high: 'warning',
                                    critical: 'danger'
                                };
                                %>
                                <span class="badge bg-<%= prioFarbe[bug.priority] || 'secondary' %>-lt">
                                    <%= tr('PRIORITY.' + bug.priority.toUpperCase(), bug.priority) %>
                                </span>
                            </td>
                            <td><%= bug.user_tag || bug.user_id || 'Unbekannt' %></td>
                            <td class="text-secondary"><%= new Date(bug.created_at).toLocaleDateString('de-DE') %></td>
                        </tr>
                        <% if (bug.admin_response) { %>
                            <tr id="adminResponse<%= bug.id %>">
                                <td colspan="8" class="bg-surface-secondary">
                                    <div class="d-flex align-items-start">
                                        <i class="fas fa-reply text-secondary me-2 mt-1"></i>
                                        <div class="flex-fill">
                                            <div class="d-flex justify-content-between">
                                                <strong>Admin-Antwort</strong>
                                                <% if (bug.resolved_at) { %>
                                                    <small class="text-secondary"><%= new Date(bug.resolved_at).toLocaleString('de-DE') %></small>
                                                <% } %>
                                            </div>
                                            <div><%= bug.admin_response %></div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<%# ── Formular ────────────────────────────────────────────────────────────── %>
<div class="modal fade" id="createBugModal" tabindex="-1">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><%= tr('BUG_REPORT.CREATE_NEW', 'Bug melden') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
            </div>
            <form id="bugReportForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label"><%= tr('BUG_REPORT.TITLE_LABEL', 'Titel') %></label>
                        <input type="text" class="form-control" name="title" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><%= tr('BUG_REPORT.CATEGORY_LABEL', 'Kategorie') %></label>
                        <select class="form-select" name="category">
                            <option value="">Allgemein</option>
                            <option value="commands">Commands</option>
                            <option value="dashboard">Dashboard</option>
                            <option value="performance">Performance</option>
                            <option value="other">Sonstiges</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><%= tr('BUG_REPORT.DESCRIPTION_LABEL', 'Beschreibung') %></label>
                        <textarea class="form-control" name="description" rows="6" required></textarea>
                        <small class="form-hint"><%= tr('BUG_REPORT.DESCRIPTION_HINT', 'Beschreibe den Bug so detailliert wie möglich') %></small>
                    </div>
                    <div class="mb-3">
                        <label class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="guild_only" id="bugGuildOnly" value="on">
                            <span class="form-check-label">
                                <i class="fas fa-lock me-1"></i>Nur in dieser Guild anzeigen
                            </span>
                        </label>
                        <small class="form-hint">Wenn nicht gesetzt, können alle Guilds diesen Bug Report sehen.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal"><%= tr('BTN_CANCEL', 'Abbrechen') %></button>
                    <button type="submit" class="btn btn-danger"><%= tr('BTN_SUBMIT', 'Absenden') %></button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.getElementById('bugReportForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData);

    try {
        const response = await fetch(window.location.pathname, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        const result = await response.json();

        if (result.success) {
            // Kein Schliessen per jQuery mehr: Das ist die
            // jQuery-Schnittstelle von Bootstrap 4, die es unter Tabler nicht
            // gibt — und vor einem Neuladen ist das Schliessen ohnehin umsonst.
            window.location.reload();
        } else {
            alert(result.message);
        }
    } catch (error) {
        alert('Fehler beim Erstellen des Bug Reports');
    }
});
</script>
