<%# Guild Themes-Übersicht — /guild/:guildId/themes %>

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
    <div>
        <div class="h3 mb-1"><i class="fa-solid fa-palette me-2"></i>Themes</div>
        <div class="text-secondary">Wähle und verwalte das Aussehen deines Guild-Dashboards.</div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="/guild/<%= guildId %>/themes/editor" class="btn btn-sm btn-outline-warning">
            <i class="fa-solid fa-paint-roller me-1"></i>Theme-Editor
        </a>
        <span class="badge bg-info-lt"><%= themes.length %> Theme<%= themes.length !== 1 ? 's' : '' %> verfügbar</span>
    </div>
</div>

<div class="row row-cards">
    <% themes.forEach(theme => { %>
        <% const isActive = theme.name === activeThemeName; %>
        <div class="col-xl-4 col-md-6">
            <%#
              Die ganze Karte war anklickbar (`onclick` auf dem Kartenrahmen) und
              trug `cursor:pointer` — dann mussten Knopf und Link im Fuss den Klick
              per `stopPropagation` wieder abfangen. Jetzt fuehrt nur noch der
              Titel zur Detailseite, wie ueberall sonst.
            %>
            <div class="card h-100 <%= isActive ? 'border-success' : '' %>">

                <%# Vorschaubild — aufgeloest in der ThemeRegistry: URL oder null %>
                <div class="card-img-top d-flex align-items-center justify-content-center bg-surface-secondary"
                     style="height: 160px; overflow: hidden; position: relative;">
                    <% if (theme.screenshotUrl) { %>
                        <img src="<%= theme.screenshotUrl %>"
                             alt="Vorschau von <%= theme.displayName %>"
                             style="width:100%; height:100%; object-fit:cover;"
                             onerror="this.style.display='none'; this.nextElementSibling.classList.remove('d-none');">
                    <% } %>
                    <div class="flex-column align-items-center justify-content-center w-100 h-100 text-secondary <%= theme.screenshotUrl ? 'd-none' : 'd-flex' %>">
                        <i class="fa-solid fa-image fa-3x mb-2"></i>
                        <small>Kein Screenshot</small>
                    </div>

                    <div class="position-absolute top-0 end-0 m-2 d-flex gap-1">
                        <% if (isActive) { %>
                            <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>Aktiv</span>
                        <% } %>
                        <% if (theme.parent) { %>
                            <span class="badge bg-secondary"><i class="fa-solid fa-sitemap me-1"></i>Child</span>
                        <% } %>
                    </div>
                </div>

                <div class="card-body">
                    <h3 class="card-title mb-1">
                        <a href="/guild/<%= guildId %>/themes/<%= theme.name %>" class="text-reset">
                            <%= theme.displayName || theme.name %>
                        </a>
                        <small class="text-secondary ms-1">v<%= theme.version || '1.0.0' %></small>
                    </h3>

                    <% if (theme.parent) { %>
                        <div class="text-secondary small mb-1">
                            <i class="fa-solid fa-sitemap me-1"></i>Erbt von <strong><%= theme.parent %></strong>
                        </div>
                    <% } %>

                    <p class="text-secondary small mb-2">
                        <%= theme.description || 'Keine Beschreibung verfügbar' %>
                    </p>

                    <div class="small text-secondary d-flex align-items-center flex-wrap gap-1">
                        <span><i class="fa-solid fa-user me-1"></i><%= theme.author || 'Unbekannt' %></span>
                        <% (theme.tags || []).slice(0, 3).forEach(tag => { %>
                            <span class="badge bg-secondary-lt"><%= tag %></span>
                        <% }); %>
                    </div>
                </div>

                <div class="card-footer d-flex gap-2">
                    <% if (isActive) { %>
                        <button class="btn btn-success btn-sm flex-fill" disabled>
                            <i class="fa-solid fa-check me-1"></i>Aktiv
                        </button>
                    <% } else { %>
                        <button class="btn btn-primary btn-sm flex-fill theme-activate-btn"
                                data-theme="<%= theme.name %>">
                            <i class="fa-solid fa-paint-brush me-1"></i>Aktivieren
                        </button>
                    <% } %>
                    <a href="/guild/<%= guildId %>/themes/<%= theme.name %>"
                       class="btn btn-outline-secondary btn-sm" title="Details">
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    <% }); %>

    <% if (themes.length === 0) { %>
        <div class="col-12">
            <div class="alert alert-warning">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                Keine Themes gefunden. Bitte überprüfe das Themes-Verzeichnis.
            </div>
        </div>
    <% } %>
</div>

<script>
(function() {
    const guildId = '<%= guildId %>';

    document.querySelectorAll('.theme-activate-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
            const themeName = btn.dataset.theme;

            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Wird aktiviert…';

            const zurueck = () => {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-paint-brush me-1"></i>Aktivieren';
            };

            try {
                const res = await fetch(`/guild/${guildId}/themes/activate`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || ''
                    },
                    body: JSON.stringify({ themeName })
                });

                const data = await res.json();

                if (data.success) {
                    window.location.reload();
                } else {
                    alert('Fehler: ' + (data.message || 'Unbekannter Fehler'));
                    zurueck();
                }
            } catch (err) {
                alert('Netzwerkfehler beim Aktivieren des Themes.');
                zurueck();
            }
        });
    });
})();
</script>
