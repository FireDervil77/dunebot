<%#
 * Theme-Detailseite — /guild/:guildId/themes/:name
 *
 * Der Name des Themes steht bereits in der Titelzeile des Layouts (der Router
 * setzt `title`), deshalb wiederholt ihn die Karte nicht mehr.
%>

<div class="mb-3">
    <a href="/guild/<%= guildId %>/themes" class="btn btn-sm btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>Zurück zur Übersicht
    </a>
</div>

<div class="row row-cards">

    <%# ── Vorschau und Aktionen ───────────────────────────────────────────── %>
    <div class="col-lg-8">
        <div class="card">
            <%#
              Der Pfad wurde hier von Hand zusammengesetzt, waehrend die
              Uebersicht `theme.screenshotUrl` aus der ThemeRegistry nimmt — die
              hat vorher geprueft, ob die Datei existiert. Diese Seite zeigte
              deshalb ein kaputtes Bild, wo die Uebersicht "kein Screenshot"
              sagte, und fing das erst per `onerror` wieder ein.
            %>
            <div class="d-flex align-items-center justify-content-center bg-surface-secondary"
                 style="height: 260px; overflow: hidden; border-radius: var(--tblr-border-radius) var(--tblr-border-radius) 0 0;">
                <% if (theme.screenshotUrl) { %>
                    <img src="<%= theme.screenshotUrl %>"
                         alt="Vorschau von <%= theme.displayName || theme.name %>"
                         style="width:100%; height:100%; object-fit:cover;"
                         onerror="this.style.display='none'; this.nextElementSibling.classList.remove('d-none');">
                <% } %>
                <div class="flex-column align-items-center justify-content-center w-100 h-100 text-secondary <%= theme.screenshotUrl ? 'd-none' : 'd-flex' %>">
                    <i class="fa-solid fa-image fa-3x mb-2"></i>
                    <small>Kein Screenshot verfügbar</small>
                </div>
            </div>

            <div class="card-body">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="text-secondary">v<%= theme.version || '1.0.0' %></span>
                    <% if (theme.name === activeThemeName) { %>
                        <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>Aktiv</span>
                    <% } %>
                    <% if (theme.parent) { %>
                        <span class="badge bg-secondary-lt"><i class="fa-solid fa-sitemap me-1"></i>Child-Theme</span>
                    <% } %>
                </div>

                <p class="text-secondary"><%= theme.description || 'Keine Beschreibung verfügbar.' %></p>

                <% if (theme.tags && theme.tags.length > 0) { %>
                    <div class="mb-3 d-flex flex-wrap gap-1">
                        <% theme.tags.forEach(tag => { %>
                            <span class="badge bg-secondary-lt"><%= tag %></span>
                        <% }); %>
                    </div>
                <% } %>

                <div class="d-flex gap-2 flex-wrap">
                    <% if (theme.name !== activeThemeName) { %>
                        <button class="btn btn-primary" id="btn-activate" data-theme="<%= theme.name %>">
                            <i class="fa-solid fa-paint-brush me-1"></i>Aktivieren
                        </button>
                    <% } else { %>
                        <button class="btn btn-success" disabled>
                            <i class="fa-solid fa-check me-1"></i>Aktuell aktiv
                        </button>
                    <% } %>

                    <a href="/guild/<%= guildId %>/themes/editor" class="btn btn-outline-warning">
                        <i class="fa-solid fa-paint-roller me-1"></i>Theme-Editor
                    </a>

                    <% if (!theme.parent) { %>
                        <button class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#cloneModal">
                            <i class="fa-solid fa-clone me-1"></i>Als Child-Theme klonen
                        </button>
                    <% } %>
                </div>
            </div>
        </div>

        <%# ── Abgeleitete Themes ──────────────────────────────────────────── %>
        <% if (childThemes.length > 0) { %>
            <div class="card mt-3">
                <div class="card-header">
                    <h3 class="card-title"><i class="fa-solid fa-sitemap me-2"></i>Child-Themes (<%= childThemes.length %>)</h3>
                </div>
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Version</th>
                                <th>Autor</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% childThemes.forEach(child => { %>
                                <tr>
                                    <td>
                                        <strong><%= child.displayName || child.name %></strong>
                                        <% if (child.name === activeThemeName) { %>
                                            <span class="badge bg-success ms-1">Aktiv</span>
                                        <% } %>
                                    </td>
                                    <td>v<%= child.version || '1.0.0' %></td>
                                    <td class="text-secondary"><%= child.author || '–' %></td>
                                    <td class="text-end">
                                        <a href="/guild/<%= guildId %>/themes/<%= child.name %>"
                                           class="btn btn-sm btn-outline-secondary" title="Öffnen">
                                            <i class="fa-solid fa-arrow-right"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        <% } %>
    </div>

    <%# ── Angaben zum Theme ───────────────────────────────────────────────── %>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fa-solid fa-circle-info me-2"></i>Informationen</h3>
            </div>
            <div class="card-body">
                <dl class="datagrid">
                    <div class="datagrid-item">
                        <div class="datagrid-title">Interner Name</div>
                        <div class="datagrid-content"><code><%= theme.name %></code></div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Version</div>
                        <div class="datagrid-content"><%= theme.version || '1.0.0' %></div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Autor</div>
                        <div class="datagrid-content"><%= theme.author || 'Unbekannt' %></div>
                    </div>
                    <% if (theme.authorUrl) { %>
                        <div class="datagrid-item">
                            <div class="datagrid-title">Website</div>
                            <div class="datagrid-content">
                                <a href="<%= theme.authorUrl %>" target="_blank" rel="noopener"><%= theme.authorUrl %></a>
                            </div>
                        </div>
                    <% } %>
                    <% if (theme.license) { %>
                        <div class="datagrid-item">
                            <div class="datagrid-title">Lizenz</div>
                            <div class="datagrid-content"><%= theme.license %></div>
                        </div>
                    <% } %>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Typ</div>
                        <div class="datagrid-content">
                            <% if (theme.parent) { %>
                                <span class="badge bg-secondary-lt"><i class="fa-solid fa-sitemap me-1"></i>Child-Theme</span>
                            <% } else { %>
                                <span class="badge bg-primary-lt"><i class="fa-solid fa-layer-group me-1"></i>Standalone</span>
                            <% } %>
                        </div>
                    </div>
                    <% if (theme.parent) { %>
                        <div class="datagrid-item">
                            <div class="datagrid-title">Parent-Theme</div>
                            <div class="datagrid-content">
                                <a href="/guild/<%= guildId %>/themes/<%= theme.parent %>">
                                    <i class="fa-solid fa-arrow-up-right-from-square me-1"></i><%= theme.parent %>
                                </a>
                            </div>
                        </div>
                    <% } %>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Child-Themes</div>
                        <div class="datagrid-content"><%= childThemes.length %></div>
                    </div>
                </dl>
            </div>
        </div>

        <% if (theme.config) { %>
            <div class="card mt-3">
                <div class="card-header">
                    <h3 class="card-title"><i class="fa-solid fa-sliders me-2"></i>Theme-Konfiguration</h3>
                </div>
                <div class="card-body">
                    <p class="text-secondary small">
                        <i class="fa-solid fa-circle-info me-1"></i>
                        Farben, Schriften und eigenes CSS kannst du im Theme-Editor anpassen.
                    </p>
                    <a href="/guild/<%= guildId %>/themes/editor" class="btn btn-sm btn-outline-warning">
                        <i class="fa-solid fa-paint-roller me-1"></i>Theme-Editor öffnen
                    </a>
                </div>
            </div>
        <% } %>
    </div>
</div>

<%# ── Klonen ──────────────────────────────────────────────────────────────── %>
<%# Nur wo es auch einen Knopf dazu gibt: Bei einem Child-Theme stand das
    Fenster bisher unerreichbar im Markup. %>
<% if (!theme.parent) { %>
<div class="modal fade" id="cloneModal" tabindex="-1">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-clone me-2"></i>Child-Theme erstellen</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
            </div>
            <div class="modal-body">
                <p class="text-secondary">
                    Erstellt eine Kopie von <strong><%= theme.displayName || theme.name %></strong> als Child-Theme.
                    Das Child-Theme erbt alle Dateien vom Parent, und du kannst einzelne Teile überschreiben.
                </p>
                <div class="mb-3">
                    <label class="form-label" for="clone-name">
                        Interner Name <span class="form-label-description">nur Kleinbuchstaben, Zahlen, Bindestriche</span>
                    </label>
                    <input type="text" class="form-control" id="clone-name"
                           placeholder="z. B. mein-custom-theme" pattern="[a-z0-9][a-z0-9-]*" maxlength="50">
                </div>
                <div class="mb-3">
                    <label class="form-label" for="clone-display-name">
                        Anzeigename <span class="form-label-description">optional</span>
                    </label>
                    <input type="text" class="form-control" id="clone-display-name" placeholder="z. B. Mein Custom Theme">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">Abbrechen</button>
                <button type="button" class="btn btn-info" id="btn-clone">
                    <i class="fa-solid fa-clone me-1"></i>Child-Theme erstellen
                </button>
            </div>
        </div>
    </div>
</div>
<% } %>

<script>
(function() {
    const guildId = '<%= guildId %>';
    const csrf = () => document.querySelector('meta[name="csrf-token"]')?.content || '';

    // Theme aktivieren
    const activateBtn = document.getElementById('btn-activate');
    if (activateBtn) {
        activateBtn.addEventListener('click', async function() {
            const themeName = this.dataset.theme;
            this.disabled = true;
            this.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Wird aktiviert…';

            const zurueck = () => {
                this.disabled = false;
                this.innerHTML = '<i class="fa-solid fa-paint-brush me-1"></i>Aktivieren';
            };

            try {
                const res = await fetch(`/guild/${guildId}/themes/activate`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf() },
                    body: JSON.stringify({ themeName })
                });
                const data = await res.json();

                if (data.success) {
                    window.location.reload();
                } else {
                    alert('Fehler: ' + (data.message || 'Unbekannter Fehler'));
                    zurueck();
                }
            } catch (err) {
                alert('Netzwerkfehler');
                zurueck();
            }
        });
    }

    // Theme klonen — den Knopf gibt es nur bei einem Standalone-Theme
    const cloneBtn = document.getElementById('btn-clone');
    if (cloneBtn) {
        cloneBtn.addEventListener('click', async function() {
            const newName = document.getElementById('clone-name').value.trim();
            const displayName = document.getElementById('clone-display-name').value.trim();

            if (!newName) return alert('Bitte einen internen Namen eingeben.');
            if (!/^[a-z0-9][a-z0-9-]*$/.test(newName)) {
                return alert('Name: nur Kleinbuchstaben, Zahlen und Bindestriche erlaubt.');
            }

            this.disabled = true;
            this.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Wird erstellt…';

            const zurueck = () => {
                this.disabled = false;
                this.innerHTML = '<i class="fa-solid fa-clone me-1"></i>Child-Theme erstellen';
            };

            try {
                const res = await fetch(`/guild/${guildId}/themes/clone`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf() },
                    body: JSON.stringify({
                        sourceTheme: '<%= theme.name %>',
                        newName,
                        displayName: displayName || newName
                    })
                });
                const data = await res.json();

                if (data.success) {
                    if (typeof toastr !== 'undefined') toastr.success(data.message);
                    window.location.href = `/guild/${guildId}/themes/` + newName;
                } else {
                    alert('Fehler: ' + (data.message || 'Unbekannter Fehler'));
                    zurueck();
                }
            } catch (err) {
                alert('Netzwerkfehler');
                zurueck();
            }
        });
    }
})();
</script>
