<%#
 * Theme-Editor — /guild/:guildId/themes/editor
 *
 * Farbvariablen, eigenes CSS und Live-Vorschau nebeneinander.
 *
 * @context {object} variables        - gespeicherte Werte der Guild
 * @context {object} defaultVariables - Werte des Themes, als Rueckfallebene
 * @context {string} customCSS        - gespeichertes eigenes CSS
%>

<style>
/*
 * Zweispaltiges Arbeitsfenster ueber die volle Hoehe — das gibt es in keinem
 * der beiden Geruestbaukaesten. Die Festfarben sind raus: Rahmen und
 * Fokusfarbe folgen den Theme-Tokens, die dieser Editor selbst setzt.
 */
.editor-layout {
    display: flex;
    gap: 15px;
    height: calc(100vh - 180px);
    min-height: 500px;
}
.editor-panel,
.preview-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
}
.preview-frame {
    flex: 1;
    border: 2px solid var(--fb-border, #dee2e6);
    border-radius: var(--fb-radius, .25rem);
    background: #fff;
}
.color-var-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
}
.color-var-row label {
    flex: 1;
    font-size: .85rem;
    margin-bottom: 0;
}
.color-var-row input[type="color"] {
    width: 38px;
    height: 30px;
    border: 1px solid var(--fb-border, #ced4da);
    border-radius: .2rem;
    padding: 2px;
    cursor: pointer;
}
.color-var-row input[type="text"] {
    width: 90px;
    font-size: .8rem;
    font-family: monospace;
}
.css-editor-wrap {
    flex: 1;
    position: relative;
    min-height: 200px;
}
.css-editor-wrap textarea {
    width: 100%;
    height: 100%;
    font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
    font-size: .85rem;
    line-height: 1.5;
    padding: 12px;
    border: 1px solid var(--fb-border, #ced4da);
    border-radius: var(--fb-radius, .25rem);
    background: #1e1e2e;
    color: #cdd6f4;
    resize: none;
    tab-size: 2;
}
.css-editor-wrap textarea:focus {
    outline: none;
    border-color: var(--fb-primary, #3498db);
    box-shadow: 0 0 0 .2rem rgba(var(--fb-primary-rgb, 52,152,219), .25);
}
.var-reset-btn { opacity: 0; transition: opacity .15s; }
.color-var-row:hover .var-reset-btn { opacity: 1; }
.editor-tabs .nav-link { font-size: .85rem; padding: .4rem .8rem; }
.save-indicator { display: none; font-size: .8rem; }
.save-indicator.show { display: inline; }
.var-gruppe-titel { font-size: .7rem; letter-spacing: 1px; }
</style>

<%# ── Kopfzeile ───────────────────────────────────────────────────────────── %>
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <div class="d-flex align-items-center gap-3">
        <a href="/guild/<%= guildId %>/themes" class="btn btn-sm btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i>Zurück
        </a>
        <div>
            <div class="h3 mb-0"><i class="fa-solid fa-paint-roller me-2"></i>Theme-Editor</div>
            <small class="text-secondary">
                Aktiv: <strong><%= activeTheme ? (activeTheme.displayName || activeTheme.name) : activeThemeName %></strong>
                <% if (activeTheme && activeTheme.parent) { %>
                    <span class="badge bg-secondary-lt ms-1"><i class="fa-solid fa-sitemap me-1"></i>Child von <%= activeTheme.parent %></span>
                <% } %>
            </small>
        </div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="save-indicator text-success" id="save-indicator">
            <i class="fa-solid fa-check me-1"></i>Gespeichert
        </span>
        <span class="save-indicator text-warning" id="unsaved-indicator">
            <i class="fa-solid fa-circle-exclamation me-1"></i>Ungespeichert
        </span>
        <button class="btn btn-outline-danger btn-sm" id="btn-reset" title="Alle Anpassungen zurücksetzen">
            <i class="fa-solid fa-rotate-left me-1"></i>Zurücksetzen
        </button>
        <button class="btn btn-primary btn-sm" id="btn-save">
            <i class="fa-solid fa-save me-1"></i>Speichern
            <span class="badge bg-white text-dark ms-1" style="font-size:.65rem;">Strg+S</span>
        </button>
    </div>
</div>

<%
/**
 * Eine Zeile im Farbteil. Stand dreimal wortgleich in der Datei — einmal je
 * Gruppe — und musste bei jeder Aenderung dreimal nachgezogen werden.
 */
function _farbzeile(v) {
    const wert = variables[v.key] || '';
    const vorgabe = defaultVariables[v.key] || '';
    return `<div class="color-var-row" data-var="${v.key}">
      <i class="fa-solid ${v.icon} text-secondary" style="width:16px;"></i>
      <label>${v.label}</label>
      <input type="color" class="var-color-picker" value="${wert || '#000000'}">
      <input type="text" class="form-control form-control-sm var-hex-input" value="${wert}" placeholder="#000000" maxlength="20">
      <button class="btn btn-sm btn-outline-secondary var-reset-btn" title="Auf Standard zurücksetzen" data-default="${vorgabe}">
        <i class="fa-solid fa-rotate-left"></i>
      </button>
    </div>`;
}

const gruppen = [
    { titel: 'Hauptfarben', felder: [
        { key: 'fb-primary', label: 'Primärfarbe', icon: 'fa-droplet' },
        { key: 'fb-accent',  label: 'Akzentfarbe', icon: 'fa-star' },
        { key: 'fb-link',    label: 'Link-Farbe',  icon: 'fa-link' },
    ]},
    { titel: 'Seitenleiste', felder: [
        { key: 'fb-sidebar-bg',       label: 'Hintergrund',       icon: 'fa-square' },
        { key: 'fb-sidebar-text',     label: 'Text',              icon: 'fa-font' },
        { key: 'fb-sidebar-hover-bg', label: 'Hover-Hintergrund', icon: 'fa-hand-pointer' },
    ]},
    { titel: 'Layout', felder: [
        { key: 'fb-header-bg',  label: 'Header-Hintergrund', icon: 'fa-window-maximize' },
        { key: 'fb-body-bg',    label: 'Seiten-Hintergrund', icon: 'fa-expand' },
        { key: 'fb-surface-bg', label: 'Karten-Hintergrund', icon: 'fa-square-full' },
        { key: 'fb-text',       label: 'Textfarbe',          icon: 'fa-font' },
    ]},
];
%>

<div class="editor-layout">

    <%# ── Arbeitsflaeche ──────────────────────────────────────────────────── %>
    <div class="editor-panel">
        <div class="card h-100 mb-0 d-flex flex-column">
            <div class="card-header p-0">
                <ul class="nav nav-tabs editor-tabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" data-bs-toggle="tab" href="#tab-variables" role="tab">
                            <i class="fa-solid fa-palette me-1"></i>Farben &amp; Variablen
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#tab-css" role="tab">
                            <i class="fa-solid fa-code me-1"></i>Eigenes CSS
                        </a>
                    </li>
                </ul>
            </div>
            <div class="card-body p-0 d-flex flex-column" style="overflow:hidden; flex:1; min-height:0;">
                <div class="tab-content flex-fill d-flex flex-column" style="min-height:0;">

                    <div class="tab-pane fade show active p-3" id="tab-variables" role="tabpanel" style="overflow-y:auto; flex:1; min-height:0;">
                        <p class="text-secondary small mb-3">
                            <i class="fa-solid fa-circle-info me-1"></i>
                            Passe die Farben deines Themes an. Änderungen erscheinen sofort in der Vorschau.
                        </p>

                        <% gruppen.forEach((g, i) => { %>
                            <h6 class="text-uppercase text-secondary var-gruppe-titel mb-2 <%= i > 0 ? 'mt-3' : '' %>"><%= g.titel %></h6>
                            <% g.felder.forEach(v => { %><%- _farbzeile(v) %><% }); %>
                        <% }); %>
                    </div>

                    <div class="tab-pane fade d-flex flex-column" id="tab-css" role="tabpanel" style="flex:1; min-height:0;">
                        <div class="p-3 pb-2">
                            <p class="text-secondary small mb-2">
                                <i class="fa-solid fa-circle-info me-1"></i>
                                Eigenes CSS schreiben. Nutze <code>var(--fb-primary)</code> und die übrigen Variablen von nebenan.
                                Die Änderungen überschreiben das aktive Theme, ohne es zu verändern.
                            </p>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-secondary" id="btn-restore-css" title="Zuletzt gespeicherten Stand wiederherstellen">
                                    <i class="fa-solid fa-clock-rotate-left me-1"></i>Letzte Sicherung
                                </button>
                                <button class="btn btn-sm btn-outline-danger" id="btn-clear-css" title="Eigenes CSS leeren (Variablen bleiben erhalten)">
                                    <i class="fa-solid fa-eraser me-1"></i>CSS leeren
                                </button>
                            </div>
                        </div>
                        <div class="css-editor-wrap flex-fill">
                            <textarea id="css-editor" spellcheck="false" placeholder="/* Dein eigenes CSS */&#10;&#10;.navbar-vertical {&#10;  background: var(--fb-sidebar-bg);&#10;}"><%= customCSS %></textarea>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <%# ── Vorschau ────────────────────────────────────────────────────────── %>
    <div class="preview-panel">
        <div class="card h-100 mb-0">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h3 class="card-title mb-0"><i class="fa-solid fa-eye me-1"></i>Live-Vorschau</h3>
                <div class="card-actions d-flex gap-1">
                    <button class="btn btn-sm btn-outline-secondary" id="btn-refresh-preview" title="Vorschau neu laden">
                        <i class="fa-solid fa-rotate"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" id="btn-open-preview" title="In neuem Tab öffnen">
                        <i class="fa-solid fa-up-right-from-square"></i>
                    </button>
                </div>
            </div>
            <div class="card-body p-0 d-flex flex-column" style="overflow:hidden;">
                <iframe id="preview-frame" class="preview-frame" src="/guild/<%= guildId %>" style="width:100%; flex:1; border:none;"></iframe>
            </div>
        </div>
    </div>
</div>

<script>
(function() {
    'use strict';

    const guildId = '<%= guildId %>';
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';
    const defaultVars = <%- JSON.stringify(defaultVariables) %>;

    /*
     * Der gespeicherte Stand beim Laden — Grundlage fuer "Letzte Sicherung".
     *
     * Hier stand `<%%= JSON.stringify(...) %>` mit escapendem Ausgabefeld. In
     * einem Skriptblock werden HTML-Entities nicht zurueckverwandelt: Aus den
     * Anfuehrungszeichen wurde `&#34;`, und der ganze Block war ein
     * Syntaxfehler. Damit lief KEINE Zeile dieses Editors — keine Farbwahl,
     * kein Speichern, kein Strg+S, keine Vorschau. Zwei Zeilen weiter oben und
     * unten stand es bereits richtig mit `<%%-`.
     */
    const savedCSS = <%- JSON.stringify(customCSS || '') %>;
    const savedVariables = <%- JSON.stringify(variables) %>;

    let isDirty = false;
    const saveIndicator = document.getElementById('save-indicator');
    const unsavedIndicator = document.getElementById('unsaved-indicator');

    function markDirty() {
        isDirty = true;
        saveIndicator.classList.remove('show');
        unsavedIndicator.classList.add('show');
    }

    function markClean() {
        isDirty = false;
        unsavedIndicator.classList.remove('show');
        saveIndicator.classList.add('show');
        setTimeout(() => saveIndicator.classList.remove('show'), 2000);
    }

    // ============================
    // Variablen sammeln
    // ============================
    function collectVariables() {
        const vars = {};
        document.querySelectorAll('.color-var-row').forEach(row => {
            const key = row.dataset.var;
            const hexInput = row.querySelector('.var-hex-input');
            if (key && hexInput) {
                vars[key] = hexInput.value.trim();
            }
        });
        return vars;
    }

    // '#3498db' → '52, 152, 219' (Bootstrap-Utilities rechnen mit dem Tripel)
    function hexZuTripel(wert) {
        const treffer = /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.exec((wert || '').trim());
        if (!treffer) return null;
        let hex = treffer[1];
        if (hex.length === 3) hex = hex.split('').map(z => z + z).join('');
        const zahl = parseInt(hex, 16);
        return `${(zahl >> 16) & 255}, ${(zahl >> 8) & 255}, ${zahl & 255}`;
    }

    // Nur Variablen setzen — was sie bewirken, steht in tokens.css, das die
    // Vorschau ohnehin lädt.
    function buildPreviewCSS() {
        const v = collectVariables();
        const zeilen = [];

        for (const [key, value] of Object.entries(v)) {
            if (!value) continue;
            zeilen.push(`  --${key}: ${value};`);
            const tripel = hexZuTripel(value);
            if (tripel) zeilen.push(`  --${key}-rgb: ${tripel};`);
        }

        let css = zeilen.length ? `:root {\n${zeilen.join('\n')}\n}\n` : '';

        const eigenesCSS = document.getElementById('css-editor').value;
        if (eigenesCSS) css += eigenesCSS;

        return css;
    }

    // ============================
    // Vorschau nachziehen
    // ============================
    function updatePreview() {
        const frame = document.getElementById('preview-frame');
        if (!frame.contentDocument) return;

        try {
            let styleEl = frame.contentDocument.getElementById('live-preview-css');
            if (!styleEl) {
                styleEl = frame.contentDocument.createElement('style');
                styleEl.id = 'live-preview-css';
                frame.contentDocument.head.appendChild(styleEl);
            }
            styleEl.textContent = buildPreviewCSS();
        } catch (e) {
            // Fremde Herkunft — ignorieren
        }
    }

    // ============================
    // Farbwaehler und Hex-Feld gleichziehen
    // ============================
    document.querySelectorAll('.color-var-row').forEach(row => {
        const colorPicker = row.querySelector('.var-color-picker');
        const hexInput = row.querySelector('.var-hex-input');

        colorPicker.addEventListener('input', function() {
            hexInput.value = this.value;
            markDirty();
            updatePreview();
        });

        hexInput.addEventListener('input', function() {
            const val = this.value.trim();
            if (/^#[0-9A-Fa-f]{6}$/.test(val)) {
                colorPicker.value = val;
            }
            markDirty();
            updatePreview();
        });

        const resetBtn = row.querySelector('.var-reset-btn');
        if (resetBtn) {
            resetBtn.addEventListener('click', function() {
                const def = this.dataset.default;
                hexInput.value = def;
                if (/^#[0-9A-Fa-f]{6}$/.test(def)) {
                    colorPicker.value = def;
                }
                markDirty();
                updatePreview();
            });
        }
    });

    // ============================
    // CSS-Feld
    // ============================
    const cssEditor = document.getElementById('css-editor');
    cssEditor.addEventListener('input', function() {
        markDirty();
        updatePreview();
    });

    // Tabulator im Feld statt Sprung zum nächsten Element
    cssEditor.addEventListener('keydown', function(e) {
        if (e.key === 'Tab') {
            e.preventDefault();
            const start = this.selectionStart;
            const end = this.selectionEnd;
            this.value = this.value.substring(0, start) + '  ' + this.value.substring(end);
            this.selectionStart = this.selectionEnd = start + 2;
            markDirty();
        }
    });

    // ============================
    // Speichern
    // ============================
    const SPEICHERN_HTML = '<i class="fa-solid fa-save me-1"></i>Speichern <span class="badge bg-white text-dark ms-1" style="font-size:.65rem;">Strg+S</span>';

    async function save() {
        const btn = document.getElementById('btn-save');
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Speichern…';

        try {
            const response = await fetch(`/guild/${guildId}/themes/editor`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': csrfToken
                },
                body: JSON.stringify({
                    custom_css: cssEditor.value,
                    custom_variables: collectVariables()
                })
            });

            const data = await response.json();

            if (data.success) {
                markClean();
                if (typeof toastr !== 'undefined') toastr.success(data.message);
            } else {
                if (typeof toastr !== 'undefined') toastr.error(data.message || 'Fehler beim Speichern');
            }
        } catch (err) {
            if (typeof toastr !== 'undefined') toastr.error('Netzwerkfehler');
        } finally {
            btn.disabled = false;
            btn.innerHTML = SPEICHERN_HTML;
        }
    }

    document.getElementById('btn-save').addEventListener('click', save);

    document.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 's') {
            e.preventDefault();
            save();
        }
    });

    // ============================
    // Alles zurücksetzen
    // ============================
    document.getElementById('btn-reset').addEventListener('click', async function() {
        if (!confirm('Alle Theme-Anpassungen für diese Guild zurücksetzen? Das kann nicht rückgängig gemacht werden.')) return;

        this.disabled = true;

        try {
            const response = await fetch(`/guild/${guildId}/themes/editor`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': csrfToken
                }
            });

            const data = await response.json();

            if (data.success) {
                document.querySelectorAll('.color-var-row').forEach(row => {
                    const key = row.dataset.var;
                    const def = defaultVars[key] || '';
                    row.querySelector('.var-hex-input').value = def;
                    if (/^#[0-9A-Fa-f]{6}$/.test(def)) {
                        row.querySelector('.var-color-picker').value = def;
                    }
                });
                cssEditor.value = '';
                markClean();
                updatePreview();
                if (typeof toastr !== 'undefined') toastr.success(data.message);
            } else {
                if (typeof toastr !== 'undefined') toastr.error(data.message);
            }
        } catch (err) {
            if (typeof toastr !== 'undefined') toastr.error('Netzwerkfehler');
        } finally {
            this.disabled = false;
        }
    });

    // ============================
    // Nur das CSS leeren
    // ============================
    document.getElementById('btn-clear-css').addEventListener('click', function() {
        if (!cssEditor.value.trim()) return;
        if (!confirm('Eigenes CSS komplett leeren? Die Farb-Variablen bleiben erhalten.')) return;
        cssEditor.value = '';
        markDirty();
        updatePreview();
        if (typeof toastr !== 'undefined') toastr.info('CSS geleert — zum Übernehmen auf „Speichern" klicken');
    });

    // ============================
    // Letzte Sicherung wiederherstellen
    // ============================
    document.getElementById('btn-restore-css').addEventListener('click', function() {
        if (cssEditor.value === savedCSS) {
            if (typeof toastr !== 'undefined') toastr.info('Keine Änderungen seit der letzten Speicherung');
            return;
        }
        if (!confirm('CSS und Variablen auf den zuletzt gespeicherten Stand zurücksetzen?')) return;

        cssEditor.value = savedCSS;

        document.querySelectorAll('.color-var-row').forEach(row => {
            const key = row.dataset.var;
            const val = savedVariables[key] || '';
            row.querySelector('.var-hex-input').value = val;
            if (/^#[0-9A-Fa-f]{6}$/.test(val)) {
                row.querySelector('.var-color-picker').value = val;
            }
        });

        markDirty();
        updatePreview();
        if (typeof toastr !== 'undefined') toastr.success('Letzte Sicherung wiederhergestellt — zum Übernehmen auf „Speichern" klicken');
    });

    // ============================
    // Vorschau steuern
    // ============================
    document.getElementById('btn-refresh-preview').addEventListener('click', function() {
        const frame = document.getElementById('preview-frame');
        frame.src = frame.src;
    });

    document.getElementById('btn-open-preview').addEventListener('click', function() {
        window.open(`/guild/${guildId}`, '_blank');
    });

    const previewFrame = document.getElementById('preview-frame');
    previewFrame.addEventListener('load', function() {
        setTimeout(updatePreview, 300);
    });

    // Vor dem Verlassen warnen
    window.addEventListener('beforeunload', function(e) {
        if (isDirty) {
            e.preventDefault();
            e.returnValue = '';
        }
    });
})();
</script>
