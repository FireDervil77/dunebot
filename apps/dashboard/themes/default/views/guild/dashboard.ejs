<%#
  * Server-Dashboard-View
  *
  * Die Widget-Bereiche kommen aus dem aktiven Theme, nicht aus dieser Datei.
  * Ein Theme meldet sie in seiner `theme.js` über `registerWidgetAreas()` an —
  * wie `register_sidebar()` in WordPress. Bringt es keine eigenen mit, gelten
  * die vier Standardbereiche des Kerns.
  *
  * @author FireDervil
  * @context {Object}   guild            - Discord Guild-Objekt
  * @context {Array}    widgets          - Dashboard-Widgets (mit area/position)
  * @context {Array}    widgetAreas      - Bereiche des aktiven Themes
  * @context {Function} renderWidgetArea - Widgets eines Bereichs, sortiert
  * @context {Array}    enabledPlugins   - Aktivierte Plugins dieser Guild
  * @context {Object}   stats            - Server-Statistiken
  %>

<%
/**
 * Widgets eines Bereichs holen.
 * Die Kaskade (Guild-Override > Widget > Registrierung) liegt im
 * WidgetManager; hier wird sie nur abgefragt.
 *
 * @param {string} areaId
 * @returns {Array<object>}
 */
function _bereich(areaId) {
    if (typeof renderWidgetArea === 'function') return renderWidgetArea(areaId);
    return (locals.widgets || [])
        .filter(w => (w.area || 'dashboard-main') === areaId && w.visible !== false)
        .sort((a, b) => (a.position || 999) - (b.position || 999));
}

const _bereiche = (typeof widgetAreasFor === 'function' && widgetAreasFor('guild').length)
    ? widgetAreasFor('guild')
    : [
        { id: 'dashboard-top',       defaultSize: 12 },
        { id: 'dashboard-primary',   defaultSize: 4  },
        { id: 'dashboard-secondary', defaultSize: 6  },
        { id: 'dashboard-bottom',    defaultSize: 12 }
      ];

const _bekannt = _bereiche.map(b => b.id);
%>

<%# Kein eigener Seitenrahmen: den stellt das Layout des Themes %>

        <!-- Hook: before_guild_dashboard -->
<%- hookArea('before_guild_dashboard', { guild, guildId }) %>

        <%# ── Anordnen: Knopf und Leiste ──────────────────────────────────── %>
        <% if (typeof hasPermission !== 'function' || hasPermission('CORE.THEMES.EDIT')) { %>
          <% assetManager && assetManager.enqueueScript('widget-arrange'); %>
          <div data-widget-arrange data-guild-id="<%= guildId %>">
            <div class="d-flex justify-content-end gap-2 mb-2">
              <div class="dropdown">
                <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle"
                        data-bs-toggle="dropdown" aria-expanded="false"
                        title="Welche Karten sollen erscheinen?">
                  <i class="fa-solid fa-sliders me-1"></i>Ansicht anpassen
                </button>
                <div class="dropdown-menu dropdown-menu-end p-3" id="widget-visibility-menu" style="min-width: 16rem;">
                  <div class="text-secondary small mb-2">Karten auf dem Dashboard</div>
                  <% (locals.alleWidgets || []).slice().sort((a,b) => (a.position||0)-(b.position||0)).forEach(w => { %>
                    <div class="form-check">
                      <input class="form-check-input widget-visibility-toggle" type="checkbox"
                             id="sichtbar-<%= w.id %>" data-widget-target="<%= w.id %>"
                             <%= w.visible === false ? '' : 'checked' %>>
                      <label class="form-check-label" for="sichtbar-<%= w.id %>">
                        <%= w.title || w.id %>
                      </label>
                    </div>
                  <% }); %>
                  <div class="text-secondary small mt-2">Änderungen über „Anordnung speichern" sichern.</div>
                </div>
              </div>
              <button type="button" id="widget-arrange-toggle" class="btn btn-sm btn-outline-secondary"
                      aria-pressed="false" title="Karten verschieben und ausblenden">
                <i class="fa-solid fa-table-cells-large me-1"></i>Anordnen
              </button>
            </div>
            <div id="widget-arrange-bar" class="alert alert-info d-none d-flex align-items-center justify-content-between py-2">
              <span>
                <i class="fa-solid fa-hand-pointer me-1"></i>
                Karten am Griff ziehen — auch zwischen den Bereichen. Mit &minus; und + die Breite ändern, das Auge blendet aus.
              </span>
              <span>
                <button type="button" id="widget-arrange-cancel" class="btn btn-sm btn-link text-secondary">Abbrechen</button>
                <button type="button" id="widget-arrange-save" class="btn btn-sm btn-primary">Anordnung speichern</button>
              </span>
            </div>
          </div>
        <% } %>

        <%# ── Bereiche des Themes, in seiner Reihenfolge ─────────────────── %>
        <% _bereiche.forEach(bereich => { %>
          <% const _widgets = _bereich(bereich.id); %>
          <% if (Array.isArray(_widgets) && _widgets.length > 0) { %>
            <div class="row g-3 mb-3" data-widget-area="<%= bereich.id %>">
              <% _widgets.forEach(widget => { %>
                <div class="col-md-<%= widget.size || bereich.defaultSize || 12 %>"
                     data-widget-id="<%= widget.id %>"
                     data-widget-hidden="<%= widget.visible === false ? '1' : '0' %>"
                     <%= widget.visible === false ? 'hidden' : '' %>>
                  <%- _widgetCard(widget) %>
                </div>
              <% }); %>
            </div>
          <% } %>
        <% }); %>

        <%# ── Auffangnetz: Widgets, deren Bereich es nicht (mehr) gibt ────── %>
        <% const _heimatlos = (locals.widgets || []).filter(w =>
              !_bekannt.includes(w.area || 'dashboard-main')
              && w.area !== 'dashboard-main'
              && w.visible !== false
           ); %>
        <% if (_heimatlos.length > 0) { %>
          <%# Heimatlose Karten landen im ersten Bereich des Themes — mit einem
              erfundenen Bereichsnamen liessen sie sich nicht speichern. %>
          <div class="row g-3 mb-3" data-widget-area="<%= _bereiche[0] && _bereiche[0].id %>">
            <% _heimatlos.forEach(widget => { %>
              <div class="col-md-<%= widget.size || 12 %>" data-widget-id="<%= widget.id %>" data-widget-hidden="0">
                <%- _widgetCard(widget) %>
              </div>
            <% }); %>
          </div>
        <% } %>

        <!-- Hook: after_guild_dashboard -->
<%- hookArea('after_guild_dashboard', { guild, guildId }) %>



<%#
 * Hilfsfunktion: Karte eines Widgets erzeugen
%>
<%
function _widgetCard(widget) {
    const actionsHtml = (widget.actions || []).map(action => {
        const attrs = Object.entries(action.attributes || {})
            .map(([k, v]) => `${k}="${v}"`).join(' ');
        return `<button type="button" class="btn btn-action" data-action="${action.id}" ${attrs}>
                  <i class="${action.icon || 'fas fa-wrench'}"></i>
                </button>`;
    }).join('');

    return `<div class="card ${widget.cardClass || ''}" data-widget-id="${widget.id}">
      <div class="card-header">
        <h3 class="card-title">
          ${widget.icon ? `<i class="${widget.icon} me-2"></i>` : ''}
          ${widget.title || 'Widget'}
        </h3>
        ${actionsHtml ? `<div class="card-actions">${actionsHtml}</div>` : ''}
      </div>
      <div class="card-body">
        ${widget.content || ''}
      </div>
    </div>`;
}
%>
