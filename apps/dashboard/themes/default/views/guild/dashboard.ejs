<%#
  * Server-Dashboard-View
  *
  * Die Widget-Bereiche kommen aus dem aktiven Theme, nicht aus dieser Datei.
  * Ein Theme meldet sie in seiner `theme.js` über `registerWidgetAreas()` an —
  * wie `register_sidebar()` in WordPress. Bringt es keine eigenen mit, gelten
  * die vier Standardbereiche des Kerns.
  *
  * @author FireDervil
  * @context {Object}   guild            - Discord Guild-Objekt
  * @context {Array}    widgets          - Dashboard-Widgets (mit area/position)
  * @context {Array}    widgetAreas      - Bereiche des aktiven Themes
  * @context {Function} renderWidgetArea - Widgets eines Bereichs, sortiert
  * @context {Array}    enabledPlugins   - Aktivierte Plugins dieser Guild
  * @context {Object}   stats            - Server-Statistiken
  %>

<%
/**
 * Widgets eines Bereichs holen.
 * Die Kaskade (Guild-Override > Widget > Registrierung) liegt im
 * WidgetManager; hier wird sie nur abgefragt.
 *
 * @param {string} areaId
 * @returns {Array<object>}
 */
function _bereich(areaId) {
    if (typeof renderWidgetArea === 'function') return renderWidgetArea(areaId);
    return (locals.widgets || [])
        .filter(w => (w.area || 'dashboard-main') === areaId && w.visible !== false)
        .sort((a, b) => (a.position || 999) - (b.position || 999));
}

const _bereiche = (locals.widgetAreas && locals.widgetAreas.length)
    ? locals.widgetAreas
    : [
        { id: 'dashboard-top',       defaultSize: 12 },
        { id: 'dashboard-primary',   defaultSize: 4  },
        { id: 'dashboard-secondary', defaultSize: 6  },
        { id: 'dashboard-bottom',    defaultSize: 12 }
      ];

const _bekannt = _bereiche.map(b => b.id);
%>

<!--begin::App Content-->
<div class="app-content">
    <div class="container-fluid">

        <!-- Hook: before_guild_dashboard -->
        <% if (locals.hooks && hooks.getViewHooks) { %>
          <% const beforeHooks = hooks.getViewHooks('before_guild_dashboard'); %>
          <% if (beforeHooks && beforeHooks.length > 0) { %>
            <% beforeHooks.forEach(hook => { %>
              <%- include(hook.component, { plugin: hook.plugin, context: hook.context || {}, guild, guildId }) %>
            <% }); %>
          <% } %>
        <% } %>

        <%# ── Bereiche des Themes, in seiner Reihenfolge ─────────────────── %>
        <% _bereiche.forEach(bereich => { %>
          <% const _widgets = _bereich(bereich.id); %>
          <% if (Array.isArray(_widgets) && _widgets.length > 0) { %>
            <div class="row g-3 mb-3" data-widget-area="<%= bereich.id %>">
              <% _widgets.forEach(widget => { %>
                <div class="col-md-<%= widget.size || bereich.defaultSize || 12 %>">
                  <%- _widgetCard(widget) %>
                </div>
              <% }); %>
            </div>
          <% } %>
        <% }); %>

        <%# ── Auffangnetz: Widgets, deren Bereich es nicht (mehr) gibt ────── %>
        <% const _heimatlos = (locals.widgets || []).filter(w =>
              !_bekannt.includes(w.area || 'dashboard-main')
              && w.area !== 'dashboard-main'
              && w.visible !== false
           ); %>
        <% if (_heimatlos.length > 0) { %>
          <div class="row g-3 mb-3" data-widget-area="unbekannt">
            <% _heimatlos.forEach(widget => { %>
              <div class="col-md-<%= widget.size || 12 %>">
                <%- _widgetCard(widget) %>
              </div>
            <% }); %>
          </div>
        <% } %>

        <!-- Hook: after_guild_dashboard -->
        <% if (locals.hooks && hooks.getViewHooks) { %>
          <% const afterHooks = hooks.getViewHooks('after_guild_dashboard'); %>
          <% if (afterHooks && afterHooks.length > 0) { %>
            <% afterHooks.forEach(hook => { %>
              <%- include(hook.component, { plugin: hook.plugin, context: hook.context || {}, guild, guildId }) %>
            <% }); %>
          <% } %>
        <% } %>

    </div>
</div>
<!--end::App Content-->

<%#
 * Hilfsfunktion: Karte eines Widgets erzeugen
%>
<%
function _widgetCard(widget) {
    const actionsHtml = (widget.actions || []).map(action => {
        const attrs = Object.entries(action.attributes || {})
            .map(([k, v]) => `${k}="${v}"`).join(' ');
        return `<button type="button" class="btn btn-tool" data-action="${action.id}" ${attrs}>
                  <i class="${action.icon || 'fas fa-wrench'}"></i>
                </button>`;
    }).join('');

    return `<div class="card ${widget.cardClass || ''}" data-widget-id="${widget.id}">
      <div class="card-header">
        <h3 class="card-title">
          ${widget.icon ? `<i class="${widget.icon} me-2"></i>` : ''}
          ${widget.title || 'Widget'}
        </h3>
        ${actionsHtml ? `<div class="card-tools">${actionsHtml}</div>` : ''}
      </div>
      <div class="card-body">
        ${widget.content || ''}
      </div>
    </div>`;
}
%>
