<%#
 * Hall of Fame — Bestenliste der Unterstuetzer
 *
 * Kein eigener Seitenrahmen und keine eigene Titelzeile: Titel und Untertitel
 * kommen aus `locals` (donations.router.js). Die Brotkrumen sind entfallen —
 * die Navigation zeigt bereits, wo man ist.
 *
 * @context {Array}  topDonators     - Top 50, absteigend nach Summe
 * @context {object} communityStats  - Gesamtzahlen
 * @context {object} userBadge       - Abzeichen des Betrachters, falls vorhanden
 * @context {number} userRank        - sein Rang, falls vorhanden
%>

<%
/*
 * Die vier Stufen an einer Stelle. Vorher standen sie zweimal: einmal als
 * Farbzuordnung in der Tabelle, einmal als Erklaerkasten am Seitenende — und
 * sie widersprachen sich. Silber war in beiden Faellen auf die helle Variante
 * gesetzt: weisse Schrift auf weissem Grund, also unsichtbar.
 */
const stufen = [
    { name: 'bronze',   anzeige: 'Bronze',   ab: '€5',   farbe: 'orange'    },
    { name: 'silver',   anzeige: 'Silver',   ab: '€20',  farbe: 'secondary' },
    { name: 'gold',     anzeige: 'Gold',     ab: '€50',  farbe: 'yellow'    },
    { name: 'platinum', anzeige: 'Platinum', ab: '€100', farbe: 'azure'     },
];
const stufeVon = (n) => stufen.find(s => s.name === n) || { farbe: 'secondary', anzeige: n };

/** Eine Kennzahl-Karte im Tabler-Zuschnitt. */
function _kennzahl(farbe, symbol, wert, beschriftung) {
    return `<div class="col-sm-6 col-lg-3">
      <div class="card card-sm">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-auto">
              <span class="bg-${farbe} text-white avatar"><i class="fas ${symbol}"></i></span>
            </div>
            <div class="col">
              <div class="h2 fw-medium mb-0">${wert}</div>
              <div class="text-secondary">${beschriftung}</div>
            </div>
          </div>
        </div>
      </div>
    </div>`;
}
%>

<%# ── Gesamtzahlen ────────────────────────────────────────────────────────── %>
<div class="row row-cards mb-4">
    <%- _kennzahl('success', 'fa-euro-sign', '€' + parseFloat(communityStats.total_amount || 0).toFixed(2), 'Gesamt gespendet') %>
    <%- _kennzahl('info',    'fa-users',     communityStats.supporter_count || 0,                           'Supporter') %>
    <%- _kennzahl('warning', 'fa-gift',      communityStats.total_donations || 0,                           'Spenden') %>
    <%- _kennzahl('danger',  'fa-chart-line','€' + parseFloat(communityStats.avg_donation || 0).toFixed(2), 'Ø Spende') %>
</div>

<%# ── Ansprache: eigener Rang oder Einladung ──────────────────────────────── %>
<% if (userBadge) { %>
    <div class="alert alert-success mb-4">
        <div class="row align-items-center">
            <div class="col-auto">
                <i class="fas fa-medal fa-3x text-<%= stufeVon(userBadge.badge_level).farbe %>"></i>
            </div>
            <div class="col">
                <h4 class="alert-title">
                    <i class="fas fa-crown text-yellow me-1"></i>
                    Du bist ein <strong class="text-uppercase"><%= userBadge.badge_level %> Supporter</strong>!
                </h4>
                <div>
                    Gespendet: <strong>€<%= parseFloat(userBadge.total_donated || 0).toFixed(2) %></strong>
                    in <%= userBadge.donation_count || 0 %> Spende(n)
                    <% if (userRank) { %> • Dein Rang: <strong>#<%= userRank %></strong><% } %>
                </div>
            </div>
            <div class="col-auto">
                <a href="/guild/<%= guildId %>/donate" class="btn btn-success">
                    <i class="fas fa-heart me-1"></i>Erneut spenden
                </a>
            </div>
        </div>
    </div>
<% } else { %>
    <div class="alert alert-info mb-4">
        <div class="row align-items-center">
            <div class="col-auto"><i class="fas fa-circle-info fa-3x"></i></div>
            <div class="col">
                <h4 class="alert-title">Werde Teil der Hall of Fame!</h4>
                <div>Unterstütze FireBot mit einer Spende und erhalte exklusive Abzeichen und Discord-Rollen.</div>
            </div>
            <div class="col-auto">
                <a href="/guild/<%= guildId %>/donate" class="btn btn-primary">
                    <i class="fas fa-heart me-1"></i>Jetzt spenden
                </a>
            </div>
        </div>
    </div>
<% } %>

<%# ── Bestenliste ─────────────────────────────────────────────────────────── %>
<div class="card mb-4">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-ranking-star text-yellow me-2"></i>Top 50 Supporter
        </h3>
    </div>

    <% if (topDonators && topDonators.length > 0) { %>
        <div class="table-responsive">
            <table class="table table-vcenter card-table table-striped">
                <thead>
                    <tr>
                        <th style="width: 60px;" class="text-center">Rang</th>
                        <th>Supporter</th>
                        <th style="width: 150px;" class="text-center">Abzeichen</th>
                        <th style="width: 150px;" class="text-end">Gesamt</th>
                        <th style="width: 100px;" class="text-center">Spenden</th>
                        <th style="width: 180px;">Letzte Spende</th>
                    </tr>
                </thead>
                <tbody>
                    <%
                    const eigeneId = (typeof userId !== 'undefined') ? userId : null;
                    const rangSymbole = {
                        1: '<i class="fas fa-trophy text-yellow" title="Platz 1"></i>',
                        2: '<i class="fas fa-medal text-secondary" title="Platz 2"></i>',
                        3: '<i class="fas fa-medal text-orange" title="Platz 3"></i>'
                    };
                    %>
                    <% topDonators.forEach((donator, index) => { %>
                        <%
                        const rang = index + 1;
                        const istIch = eigeneId && donator.user_id === eigeneId;
                        const stufe = stufeVon(donator.badge_level);
                        %>
                        <tr class="<%= istIch ? 'table-success' : '' %>">
                            <td class="text-center">
                                <% if (rangSymbole[rang]) { %>
                                    <%- rangSymbole[rang] %>
                                <% } else { %>
                                    <strong>#<%= rang %></strong>
                                <% } %>
                            </td>
                            <td>
                                <strong><%= donator.username || 'Anonymer Supporter' %></strong>
                                <% if (istIch) { %>
                                    <span class="badge bg-success-lt ms-2">Du</span>
                                <% } %>
                            </td>
                            <td class="text-center">
                                <% if (donator.badge_level && donator.has_active_badge) { %>
                                    <span class="badge bg-<%= stufe.farbe %>-lt text-uppercase">
                                        <i class="fas fa-medal me-1"></i><%= donator.badge_level %>
                                    </span>
                                <% } else { %>
                                    <span class="text-secondary">–</span>
                                <% } %>
                            </td>
                            <td class="text-end">
                                <strong class="text-success">€<%= parseFloat(donator.total_donated || 0).toFixed(2) %></strong>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-info-lt"><%= donator.donation_count || 0 %>×</span>
                            </td>
                            <td class="text-secondary">
                                <%= donator.last_donation ? new Date(donator.last_donation).toLocaleDateString('de-DE') : '–' %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div class="card-body">
            <div class="empty">
                <div class="empty-icon"><i class="fas fa-heart-crack fa-3x text-secondary"></i></div>
                <p class="empty-title mt-3">Noch keine Supporter. Sei der Erste! ❤️</p>
            </div>
        </div>
    <% } %>
</div>

<%# ── Was die Stufen bedeuten ─────────────────────────────────────────────── %>
<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-circle-info text-info me-2"></i>Abzeichen-Stufen</h3>
    </div>
    <div class="card-body">
        <div class="row">
            <% stufen.forEach(s => { %>
                <div class="col-md-3 text-center mb-3">
                    <i class="fas fa-medal fa-3x text-<%= s.farbe %> mb-2"></i>
                    <div class="fw-medium"><%= s.anzeige %></div>
                    <div class="text-secondary">ab <%= s.ab %></div>
                </div>
            <% }); %>
        </div>
        <hr>
        <p class="text-secondary mb-0 text-center">
            <%# `fa-sparkles` gibt es nur in Font Awesome Pro — hier stand ein leerer Platz. %>
            <i class="fas fa-star text-yellow me-1"></i>
            Jeder Supporter erhält ein exklusives Discord-Abzeichen und eine eigene Rolle.
        </p>
    </div>
</div>
