<%#
 * Einstellungen — Übersicht mit Schnellzugriffen
 *
 * Am Kopf der Datei stand ein zerschossener HTML-Kommentar: In die
 * Beschreibung war ein halber Kartenblock hineingerutscht, mitsamt vier
 * `tr()`-Aufrufen. EJS kennt keine HTML-Kommentare — die Aufrufe liefen bei
 * jedem Aufruf der Seite und schrieben ihr Ergebnis in den Kommentar.
 *
 * @context {string} guildId
 * @context {Array}  enabledPlugins - nur fuer die Anzahl im Systemblock
%>

<div class="alert alert-info mb-4">
    <i class="fa-solid fa-circle-info me-2"></i>
    <strong><%= tr('DASHBOARD_COMMON.WELCOME_SETTINGS') %></strong>
    <%= tr('DASHBOARD_COMMON.WELCOME_SETTINGS_DESC') %>
</div>

<%# ── Schnellzugriffe ─────────────────────────────────────────────────────── %>
<%
/*
 * Die vier Karten waren viermal derselbe Block mit vertauschten Texten — rund
 * 130 Zeilen. Als Liste steht die Abweichung da, wo sie hingehoert.
 *
 * `schluessel` ist der gemeinsame Praefix in den Uebersetzungen; ist er nicht
 * gesetzt, stehen Titel und Merkmale wortwoertlich hier (Discord-Channels hat
 * nie welche bekommen).
 */
const bereiche = [
    {
        farbe: 'primary', symbol: 'fa-sliders', schluessel: 'GENERAL',
        merkmale: ['PREFIX', 'LOCALE', 'THEME', 'SLASH'],
        ziel: `/guild/${guildId}/settings/general`, knopf: 'BTN_CONFIGURE'
    },
    {
        farbe: 'success', symbol: 'fa-users', schluessel: 'USER',
        merkmale: ['ROLES', 'ADMIN', 'COMMANDS', 'BLACKLIST'],
        // Diese Karte hatte als einzige keinen Knopf: vier Versprechen, kein Weg
        // dorthin. Das Ziel gibt es laengst, es steht auch in der Navigation.
        ziel: `/guild/${guildId}/permissions/users`, knopf: 'BTN_OPEN'
    },
    // Die Karte "Discord Channels" stand hier bis zum 2026-08-09. Kanaele sind
    // kein Einstellungsthema: die Seite fasst Discord selbst an, nicht unseren
    // Bot. Sie liegt jetzt im Plugin `discord` und hat dort einen eigenen
    // Menuepunkt — eine zweite Tuer von hier waere nur ein Umweg.
    {
        farbe: 'warning', symbol: 'fa-plug', schluessel: 'INTEGRATIONS',
        merkmale: ['WEBHOOKS', 'API_KEYS', 'DISCORD_LOGS', 'EXTERNAL_SERVICES'],
        ziel: `/guild/${guildId}/plugins/core/settings/integrations`, knopf: 'BTN_OPEN'
    },
];

/** Uebersetzung mit gemeinsamem Praefix, oder der wortwoertliche Text. */
const t = (b, feld) => tr(`core:SETTINGS_OVERVIEW.${b.schluessel}_${feld}`);
%>
<div class="row row-cards mb-4">
    <% bereiche.forEach(b => { %>
        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-center mb-3">
                        <span class="avatar avatar-md bg-<%= b.farbe %>-lt me-3">
                            <i class="fa-solid <%= b.symbol %> fs-3"></i>
                        </span>
                        <div>
                            <div class="fw-medium"><%= b.titel || t(b, 'TITLE') %></div>
                            <small class="text-secondary"><%= b.untertitel || t(b, 'SUBTITLE') %></small>
                        </div>
                    </div>

                    <p class="text-secondary"><%= b.beschreibung || t(b, 'DESCRIPTION') %></p>

                    <ul class="list-unstyled small mb-3">
                        <% (b.merkmaleText || b.merkmale.map(m => tr(`core:SETTINGS_OVERVIEW.${b.schluessel}_FEATURES.${m}`))).forEach(m => { %>
                            <li><i class="fa-solid fa-check text-success me-2"></i><%= m %></li>
                        <% }); %>
                    </ul>

                    <a href="<%= b.ziel %>" class="btn btn-<%= b.farbe %> btn-sm w-100 mt-auto">
                        <i class="fa-solid fa-arrow-right me-2"></i><%= b.knopfText || tr(`core:SETTINGS_OVERVIEW.${b.knopf}`) %>
                    </a>
                </div>
            </div>
        </div>
    <% }); %>
</div>

<%# ── Einstellungen der Plugins ───────────────────────────────────────────── %>
<div class="card mb-4">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa-solid fa-puzzle-piece me-2"></i><%= tr('core:SETTINGS_OVERVIEW.PLUGIN_SETTINGS_TITLE') %>
        </h3>
    </div>
    <div class="card-body">
        <p class="text-secondary"><%= tr('core:SETTINGS_OVERVIEW.PLUGIN_SETTINGS_DESC') %></p>

        <div class="alert alert-info mb-0">
            <i class="fa-solid fa-lightbulb me-2"></i>
            <strong><%= tr('core:SETTINGS_OVERVIEW.PLUGIN_SETTINGS_TIP') %>:</strong>
            <%= tr('core:SETTINGS_OVERVIEW.PLUGIN_SETTINGS_TIP_TEXT') %>
        </div>
    </div>
</div>

<%# ── Systemzustand ───────────────────────────────────────────────────────── %>
<%#
  ACHTUNG: Drei der vier Werte sind fester Text — "Bot online", "Datenbank
  verbunden" und "Leistung stabil" stehen hier, seit es die Seite gibt, und
  werden nirgends gemessen. Nur die Anzahl der Plugins ist echt. Beim Umbau
  bewusst unveraendert uebernommen; ob die Kachel gemessene Werte bekommt oder
  verschwindet, ist eine eigene Entscheidung.
%>
<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fa-solid fa-server me-2"></i><%= tr('core:SETTINGS_OVERVIEW.SYSTEM_STATUS_TITLE') %>
        </h3>
    </div>
    <div class="card-body">
        <div class="row text-center">
            <div class="col-md-3 border-end">
                <i class="fa-solid fa-circle-check text-success fs-2 mb-2"></i>
                <div class="text-secondary small"><%= tr('core:SETTINGS_OVERVIEW.STATUS_BOT') %></div>
                <div class="fw-bold"><%= tr('core:SETTINGS_OVERVIEW.STATUS_BOT_ONLINE') %></div>
            </div>
            <div class="col-md-3 border-end">
                <i class="fa-solid fa-database text-primary fs-2 mb-2"></i>
                <div class="text-secondary small"><%= tr('core:SETTINGS_OVERVIEW.STATUS_DATABASE') %></div>
                <div class="fw-bold"><%= tr('core:SETTINGS_OVERVIEW.STATUS_DATABASE_CONNECTED') %></div>
            </div>
            <div class="col-md-3 border-end">
                <i class="fa-solid fa-puzzle-piece text-info fs-2 mb-2"></i>
                <div class="text-secondary small"><%= tr('core:SETTINGS_OVERVIEW.STATUS_PLUGINS') %></div>
                <div class="fw-bold"><%= enabledPlugins?.length || 0 %> <%= tr('core:SETTINGS_OVERVIEW.STATUS_PLUGINS_ACTIVE') %></div>
            </div>
            <div class="col-md-3">
                <i class="fa-solid fa-bolt text-warning fs-2 mb-2"></i>
                <div class="text-secondary small"><%= tr('core:SETTINGS_OVERVIEW.STATUS_PERFORMANCE') %></div>
                <div class="fw-bold"><%= tr('core:SETTINGS_OVERVIEW.STATUS_PERFORMANCE_STABLE') %></div>
            </div>
        </div>
    </div>
</div>
