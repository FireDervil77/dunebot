<%#
 * Bestätigung nach einer Spende
 *
 * Kein eigener Seitenrahmen und keine eigene Titelzeile: beides stellt das
 * Layout des Themes.
 *
 * @context {string} sessionId - Stripe-Vorgang, zur Nachverfolgung
%>

<div class="row justify-content-center">
    <div class="col-md-8">

        <div class="card mb-3">
            <div class="card-status-top bg-success"></div>
            <div class="card-body text-center">

                <div class="mb-3">
                    <i class="fas fa-circle-check text-success fa-3x"></i>
                </div>
                <h2>Vielen Dank für deine Spende!</h2>
                <p class="text-secondary">Deine Zahlung wurde erfolgreich verarbeitet. Du erhältst in Kürze:</p>

                <%
                const gaben = [
                    { farbe: 'success', symbol: 'fas fa-award',    titel: 'Supporter-Abzeichen', wo: 'Im Dashboard' },
                    { farbe: 'info',    symbol: 'fab fa-discord',  titel: 'Discord-Rolle',       wo: 'Auf allen Servern' },
                    { farbe: 'warning', symbol: 'fas fa-trophy',   titel: 'Hall of Fame',        wo: 'Eintrag' },
                ];
                %>
                <div class="row row-cards text-start my-4">
                    <% gaben.forEach(g => { %>
                        <div class="col-md-4">
                            <div class="card card-sm">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-auto">
                                            <span class="bg-<%= g.farbe %> text-white avatar"><i class="<%= g.symbol %>"></i></span>
                                        </div>
                                        <div class="col">
                                            <div class="fw-medium"><%= g.titel %></div>
                                            <div class="text-secondary"><%= g.wo %></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>

                <hr>

                <p class="mb-4">
                    <i class="fas fa-circle-info text-info me-2"></i>
                    Die Aktivierung erfolgt automatisch innerhalb weniger Sekunden.<br>
                    <small class="text-secondary">Vorgang: <code><%= sessionId %></code></small>
                </p>

                <div class="btn-list justify-content-center">
                    <a href="/guild/<%= guildId %>" class="btn btn-primary">
                        <i class="fas fa-home me-2"></i>Zum Dashboard
                    </a>
                    <a href="/guild/<%= guildId %>/plugins/core/donate" class="btn btn-outline-success">
                        <i class="fas fa-heart me-2"></i>Weitere Spende
                    </a>
                </div>

            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-circle-question me-2"></i>Was passiert jetzt?</h3>
            </div>
            <div class="card-body">
                <%#
                  Vorher AdminLTEs `timeline` — die gibt es in Tabler nicht, die
                  Eintraege standen also als lose Absaetze untereinander. Und der
                  vierte Eintrag bestand nur aus einem Sinnbild ohne Text: eine
                  angefangene Zeile, die nie fertig wurde.
                %>
                <ul class="steps steps-vertical">
                    <li class="step-item">
                        <div class="fw-medium">Zahlung bestätigt</div>
                        <div class="text-secondary">Stripe hat deine Zahlung erfolgreich verarbeitet.</div>
                    </li>
                    <li class="step-item">
                        <div class="fw-medium">Abzeichen wird vergeben</div>
                        <div class="text-secondary">Dein Supporter-Abzeichen wird gespeichert.</div>
                    </li>
                    <li class="step-item active">
                        <div class="fw-medium">Discord-Rolle wird vergeben</div>
                        <div class="text-secondary">Der Bot vergibt deine Supporter-Rolle auf allen Servern.</div>
                    </li>
                    <li class="step-item">
                        <div class="fw-medium">Fertig</div>
                        <div class="text-secondary">Alles Weitere siehst du in der Hall of Fame.</div>
                    </li>
                </ul>
            </div>
        </div>

    </div>
</div>
