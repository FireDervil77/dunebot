<%#
 * Feature Requests — Liste mit Upvotes und Vorschlagsformular
 *
 * Kein eigener Seitenrahmen und keine eigene Titelzeile: beides stellt das
 * Layout des Themes. Der Titel kommt aus `locals.title` (feedback.router.js).
 *
 * @context {Array}   features         - Vorschlaege, nach Upvotes sortiert
 * @context {boolean} istKontrollGuild - sieht auch fremde guild_only-Eintraege
 * @context {string}  ladeFehler       - gesetzt, wenn die Abfrage scheiterte
%>

<%# ── Hinweis ─────────────────────────────────────────────────────────────── %>
<div class="alert alert-info alert-dismissible mb-3" role="alert">
    <div class="d-flex">
        <div class="me-3"><i class="fa-solid fa-circle-info fa-lg"></i></div>
        <div>
            <h4 class="alert-title"><%= tr('FEATURE_REQUEST.INFO_TITLE') %></h4>
            <div class="text-secondary"><%= tr('FEATURE_REQUEST.INFO_TEXT') %></div>
        </div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Schließen"></button>
</div>

<%# ── Kennzahlen ──────────────────────────────────────────────────────────── %>
<%
/** Eine Kennzahl-Karte im Tabler-Zuschnitt — wie im Bug Report. */
function _kennzahl(farbe, symbol, wert, beschriftung) {
    return `<div class="col-sm-6 col-lg-4">
      <div class="card card-sm">
        <div class="card-body">
          <div class="row align-items-center">
            <div class="col-auto">
              <span class="bg-${farbe} text-white avatar"><i class="fas ${symbol}"></i></span>
            </div>
            <div class="col">
              <div class="h2 fw-medium mb-0">${wert}</div>
              <div class="text-secondary">${beschriftung}</div>
            </div>
          </div>
        </div>
      </div>
    </div>`;
}
%>
<div class="row row-cards mb-3">
    <%- _kennzahl('primary', 'fa-lightbulb',      features.length,                                          tr('FEATURE_REQUEST.TOTAL_FEATURES')) %>
    <%- _kennzahl('info',    'fa-calendar-check', features.filter(f => f.status === 'planned').length,      tr('FEATURE_REQUEST.PLANNED')) %>
    <%- _kennzahl('success', 'fa-check-circle',   features.filter(f => f.status === 'implemented').length,  tr('FEATURE_REQUEST.IMPLEMENTED')) %>
</div>

<%# ── Liste ───────────────────────────────────────────────────────────────── %>
<div class="card">
    <div class="card-header">
        <h3 class="card-title"><%= tr('FEATURE_REQUEST.ALL_FEATURES', 'Alle Feature Requests') %></h3>
        <div class="card-actions">
            <span class="text-secondary me-3 d-none d-md-inline">
                <i class="fa-solid fa-arrow-up me-1"></i><%= tr('FEATURE_REQUEST.SORTED_BY_VOTES', 'Sortiert nach Upvotes') %>
            </span>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createFeatureModal">
                <i class="fa-solid fa-lightbulb me-1"></i> <%= tr('FEATURE_REQUEST.CREATE_NEW', 'Feature vorschlagen') %>
            </button>
        </div>
    </div>

    <% if (typeof ladeFehler !== 'undefined' && ladeFehler) { %>
        <div class="card-body">
            <div class="alert alert-danger mb-0">
                <i class="fas fa-triangle-exclamation me-2"></i><%= ladeFehler %>
            </div>
        </div>
    <% } else if (features.length === 0) { %>
        <div class="card-body">
            <div class="empty">
                <div class="empty-icon"><i class="fa-solid fa-lightbulb fa-3x text-secondary"></i></div>
                <p class="empty-title mt-3"><%= tr('FEATURE_REQUEST.NO_FEATURES', 'Keine Feature Requests vorhanden') %></p>
            </div>
        </div>
    <% } else { %>
        <div class="list-group list-group-flush">
            <% features.forEach(feature => { %>
                <div class="list-group-item">
                    <div class="row align-items-center">

                        <%# Upvote — die Zahl ist das Wesentliche, das Pfeilchen nur die Handlung %>
                        <div class="col-auto">
                            <button class="btn btn-outline-primary upvote-btn d-flex flex-column align-items-center px-3"
                                    data-feature-id="<%= feature.id %>">
                                <i class="fas fa-arrow-up"></i>
                                <strong><%= feature.upvotes %></strong>
                            </button>
                        </div>

                        <div class="col">
                            <div class="fw-medium"><%= feature.title %></div>
                            <div class="text-secondary mb-2"><%= feature.description %></div>

                            <div class="d-flex gap-2 align-items-center flex-wrap">
                                <% if (feature.category) { %>
                                    <span class="badge bg-secondary-lt"><%= feature.category %></span>
                                <% } %>

                                <%
                                const statusFarbe = {
                                    open: 'warning',
                                    planned: 'info',
                                    in_progress: 'primary',
                                    implemented: 'success',
                                    rejected: 'danger',
                                    closed: 'secondary'
                                };
                                %>
                                <span class="badge bg-<%= statusFarbe[feature.status] || 'secondary' %>-lt">
                                    <%= tr('STATUS.' + feature.status.toUpperCase(), feature.status) %>
                                </span>

                                <%
                                const prioFarbe = {
                                    low: 'secondary',
                                    medium: 'primary',
                                    high: 'warning',
                                    critical: 'danger'
                                };
                                %>
                                <span class="badge bg-<%= prioFarbe[feature.priority] || 'secondary' %>-lt">
                                    <%= tr('PRIORITY.' + feature.priority.toUpperCase(), feature.priority) %>
                                </span>

                                <% if (feature.guild_only) { %>
                                    <% if (typeof istKontrollGuild !== 'undefined' && istKontrollGuild && String(feature.guild_id) !== String(guildId)) { %>
                                        <span class="badge bg-warning-lt"><i class="fas fa-lock me-1"></i>Nur <%= feature.guild_name || feature.guild_id %></span>
                                    <% } else { %>
                                        <span class="badge bg-secondary-lt"><i class="fas fa-lock me-1"></i>Diese Guild</span>
                                    <% } %>
                                <% } else { %>
                                    <span class="badge bg-info-lt"><i class="fas fa-globe me-1"></i>Alle Guilds</span>
                                <% } %>

                                <small class="text-secondary ms-auto">
                                    <i class="fas fa-user me-1"></i><%= feature.user_tag || feature.user_id || 'Unbekannt' %>
                                    <i class="fas fa-calendar ms-2 me-1"></i><%= new Date(feature.created_at).toLocaleDateString('de-DE') %>
                                </small>
                            </div>

                            <% if (feature.admin_response) { %>
                                <div class="mt-3 ps-3 border-start border-2">
                                    <div class="d-flex justify-content-between">
                                        <strong><i class="fas fa-reply text-secondary me-2"></i>Admin-Antwort</strong>
                                        <% if (feature.resolved_at) { %>
                                            <small class="text-secondary"><%= new Date(feature.resolved_at).toLocaleString('de-DE') %></small>
                                        <% } %>
                                    </div>
                                    <div><%= feature.admin_response %></div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } %>
</div>

<%# ── Formular ────────────────────────────────────────────────────────────── %>
<div class="modal fade" id="createFeatureModal" tabindex="-1">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><%= tr('FEATURE_REQUEST.CREATE_NEW', 'Feature vorschlagen') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
            </div>
            <form id="featureRequestForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label"><%= tr('FEATURE_REQUEST.TITLE_LABEL', 'Titel') %></label>
                        <input type="text" class="form-control" name="title" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><%= tr('FEATURE_REQUEST.CATEGORY_LABEL', 'Kategorie') %></label>
                        <select class="form-select" name="category">
                            <option value="">Allgemein</option>
                            <option value="commands">Commands</option>
                            <option value="dashboard">Dashboard</option>
                            <option value="plugins">Plugins</option>
                            <option value="integration">Integration</option>
                            <option value="ui">Benutzeroberfläche</option>
                            <option value="other">Sonstiges</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><%= tr('FEATURE_REQUEST.DESCRIPTION_LABEL', 'Beschreibung') %></label>
                        <textarea class="form-control" name="description" rows="6" required></textarea>
                        <small class="form-hint"><%= tr('FEATURE_REQUEST.DESCRIPTION_HINT', 'Beschreibe das Feature so detailliert wie möglich') %></small>
                    </div>
                    <div class="mb-3">
                        <label class="form-check">
                            <input class="form-check-input" type="checkbox" name="guild_only" id="featureGuildOnly" value="on">
                            <span class="form-check-label">
                                <i class="fas fa-lock me-1"></i>Nur in dieser Guild anzeigen
                            </span>
                        </label>
                        <small class="form-hint">Wenn nicht gesetzt, können alle Guilds diesen Feature Request sehen.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal"><%= tr('BTN_CANCEL', 'Abbrechen') %></button>
                    <button type="submit" class="btn btn-primary"><%= tr('BTN_SUBMIT', 'Absenden') %></button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
// Feature Request erstellen
document.getElementById('featureRequestForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData);

    try {
        const response = await fetch(window.location.pathname, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        const result = await response.json();

        if (result.success) {
            // Kein `$(…).modal('hide')`: Das ist die jQuery-Schnittstelle von
            // Bootstrap 4, die es unter Tabler nicht gibt — und vor einem
            // Neuladen waere das Schliessen ohnehin umsonst.
            window.location.reload();
        } else {
            alert(result.message);
        }
    } catch (error) {
        alert('Fehler beim Erstellen des Feature Requests');
    }
});

// Upvote
document.querySelectorAll('.upvote-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
        const featureId = btn.dataset.featureId;

        try {
            const response = await fetch(`${window.location.pathname}/${featureId}/upvote`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });

            const result = await response.json();

            if (result.success) {
                btn.querySelector('strong').textContent = result.upvotes;
                btn.classList.toggle('btn-primary', result.hasVoted);
                btn.classList.toggle('btn-outline-primary', !result.hasVoted);
            }
        } catch (error) {
            alert('Fehler beim Upvoten');
        }
    });
});
</script>
