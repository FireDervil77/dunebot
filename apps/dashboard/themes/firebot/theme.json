{
    "name": "firebot",
    "displayName": "FireBot Theme",
    "version": "1.0.0",
    "description": "Neues Theme für den FireBot. neue Logos neues Design.",
    "author": "firedervil",
    "screenshot": "screenshot.png",
    "parent": "default",
    "tags": ["admin", "responsive"],
    "requires": "1.0.0",
    "supports": {
        "darkMode": true,
        "rtl": false,
        "responsive": true
    },
    "config": {
        "darkMode": true,
        "logo": "images/firebot-logo.png",
        "favicon": "images/favicon.png"
    },
    "tokens": {
        "fb-primary": "#e74c3c",
        "fb-primary-hover": "#c0392b",
        "fb-accent": "#f39c12",
        "fb-accent-hover": "#d68910",
        "fb-link": "#e74c3c",
        "fb-link-hover": "#c0392b"
    },
    "layouts": {
        "frontend": "layouts/frontend.ejs",
        "guild": "layouts/guild.ejs",
        "auth": "layouts/auth.ejs"
    }
}
