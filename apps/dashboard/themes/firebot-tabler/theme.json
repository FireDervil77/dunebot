{
    "name": "firebot-tabler",
    "displayName": "FireBot Tabler",
    "version": "0.1.0",
    "description": "Neues Gerüst auf Tabler. Bringt Bootstrap 5 mit und braucht kein AdminLTE.",
    "author": "firedervil",
    "parent": null,
    "tags": ["admin", "responsive", "tabler"],
    "requires": "1.0.0",
    "supports": {
        "darkMode": true,
        "rtl": false,
        "responsive": true
    },
    "config": {
        "logo": "images/firebot.png",
        "favicon": "images/favicon.png"
    },
    "tokens": {
        "fb-primary": "#3498db",
        "fb-primary-hover": "#2980b9",
        "fb-accent": "#f39c12",
        "fb-link": "#3498db",
        "fb-link-hover": "#2980b9",
        "fb-body-bg": "#f6f8fb",
        "fb-surface-bg": "#ffffff",
        "fb-header-bg": "#ffffff",
        "fb-sidebar-bg": "#1d273b",
        "fb-sidebar-text": "#adb5bd",
        "fb-sidebar-hover-bg": "#2b3a55",
        "fb-sidebar-hover-text": "#ffffff",
        "fb-sidebar-active-bg": "#2b3a55",
        "fb-sidebar-active-text": "#ffffff",
        "fb-text": "#1e293b",
        "fb-text-muted": "#667382",
        "fb-border": "#e6e7e9"
    },
    "layouts": {
        "guild": "layouts/guild.ejs"
    }
}
